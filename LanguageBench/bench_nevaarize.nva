// Nevaarize Comprehensive Benchmark (Stable JIT Version)
import stdlib time as t

print(">>> Nevaarize Benchmark Suite <<<")
print("  -------------------------------------------------------------")
print("  Benchmark       | Performance           | Time")
print("  -------------------------------------------------------------")

// Integer Add
limit1 = 100000000
start1 = t.nanos()
i1 = 0
while (i1 < limit1) { i1 = i1 + 1 }
end1 = t.nanos()
diff1 = end1 - start1
if (diff1 == 0) { diff1 = 1 }
ops1 = limit1 * 1000000000 / diff1
print("  Integer Add     | ", ops1, " ops/sec | ", diff1, " ns")

// Double Arith
limit2 = 10000000
val2 = 0.0
start2 = t.nanos()
j2 = 0
while (j2 < limit2) { val2 = val2 + 1.1; j2 = j2 + 1 }
end2 = t.nanos()
diff2 = end2 - start2
if (diff2 == 0) { diff2 = 1 }
ops2 = limit2 * 1000000000 / diff2
print("  Double Arith    | ", ops2, " ops/sec | ", diff2, " ns")

print("  -------------------------------------------------------------")
