// Sanarize Comprehensive Benchmark (Formatted Output)
import stdlib time as t;

struct Obj {
    double val
}

// Helper to pad string (manual implementation as no stdlib yet)
function PadRight(string s, double len) :: string {
    // Sanarize string length not exposed in DSL yet? 
    // Assuming we just pass fixed strings for names.
    // Hack: Just adding spaces manually based on known lengths.
    
    if (s == "Integer Add" || s == "Struct Access") { return s + "   "; }  // 11 + 3 = 14
    if (s == "Double Arith") { return s + "    "; } // 12 + 2 = 14
    if (s == "String Concat") { return s + "   "; } // 13 + 1 = 14
    if (s == "Array Push" || s == "Performance") { return s + "    "; }    // 10 + 4 = 14
    if (s == "Benchmark") { return s + "     "; }      // 9 + 5 = 14
    return s;
}

// Helper to print formatted result (CSV style visual mock)
function PrintRow(string name, double ops, double sec) {
    // We don't have comma formatting or precise width padding in Sanarize print yet.
    // We will print raw numbers but try to align.
    
    // name is padded manually above
    string paddedName = PadRight(name, 15);
    
    print("  " + paddedName + " | " + ops + " OPS/sec | " + sec + "s");
}

function PrintHeader() {
    print("  -------------------------------------------------------------");
    print("  Benchmark       | Performance           | Time");
    print("  -------------------------------------------------------------");
}

function BenchInt() {
    double limit = 1000000000;
    double start = t.Now();
    double i = 0;
    while (i < limit) {
        i = i + 1;
    }
    double end = t.Now();
    
    double sec = (end - start) / 1000000000.0;
    double ops = limit / sec;
    PrintRow("Integer Add", ops, sec);
}

function BenchDouble() {
    double limit = 100000000;
    
    double val = 0.0;
    double start = t.Now();
    double i = 0;
    while (i < limit) {
        val = val + 1.1;
        i = i + 1;
    }
    double end = t.Now();
    
    double sec = (end - start) / 1000000000.0;
    double ops = limit / sec;
    PrintRow("Double Arith", ops, sec);
}

function BenchString() {
    double limit = 100000;
    
    double start = t.Now();
    string s = "";
    double i = 0;
    while (i < limit) {
        s = s + "a";
        i = i + 1;
    }
    double end = t.Now();
    
    double sec = (end - start) / 1000000000.0;
    double ops = limit / sec;
    PrintRow("String Concat", ops, sec);
}

function BenchArray() {
    double limit = 100000;
    
    double[] arr = [];
    double start = t.Now();
    double i = 0;
    while (i < limit) {
        arr.push(i);
        i = i + 1;
    }
    double end = t.Now();
    
    double sec = (end - start) / 1000000000.0;
    double ops = limit / sec;
    PrintRow("Array Push", ops, sec);
}

function BenchStruct() {
    double limit = 50000000;
    
    Obj o = { val: 0 };
    
    double start = t.Now();
    double i = 0;
    while (i < limit) {
        o.val = i;
        double x = o.val;
        i = i + 1;
    }
    double end = t.Now();
    
    double sec = (end - start) / 1000000000.0;
    double ops = limit / sec;
    PrintRow("Struct Access", ops, sec);
}

function Main() {
    print(">>> Sanarize Benchmark Suite <<<");
    PrintHeader();
    BenchInt();
    BenchDouble();
    BenchString();
    BenchArray();
    BenchStruct();
    print("  -------------------------------------------------------------");
    print("");
}
