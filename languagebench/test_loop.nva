// Test struct access performance
import stdlib time as t
obj = { val: 0 }
start = t.nanos()
m = 0
while (m < 1000000) { 
    obj.val = m
    x = obj.val
    m = m + 1 
}
end = t.nanos()
diff = end - start
ops = 1000000 * 1000000000 / diff
print("Struct: ", ops, " ops/sec in ", diff / 1000000000, " s")
