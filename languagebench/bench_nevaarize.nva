// Minimal working benchmark - just integer and double
import stdlib time as t

print(">>> Nevaarize Benchmark Suite <<<")
print("  -------------------------------------------------------------")
print("  Benchmark       |     Performance     | Time")
print("  -------------------------------------------------------------")

// Benchmark 1: Integer Addition
limit1 = 100000000
start1 = t.nanos()
i = 0
while (i < limit1) { i = i + 1 }
end1 = t.nanos()
diff1 = end1 - start1
if (diff1 == 0) { diff1 = 1 }
ops1 = limit1 * 1000000000 / diff1
sec1 = diff1 / 1000000000
print("  Integer Add     | ", ops1, " ops/sec | ", sec1, " s")

// Benchmark 2: Double Arithmetic
limit2 = 10000000
val = 0.0
start2 = t.nanos()
j = 0
while (j < limit2) { val = val + 1.1; j = j + 1 }
end2 = t.nanos()
diff2 = end2 - start2
if (diff2 == 0) { diff2 = 1 }
ops2 = limit2 * 1000000000 / diff2
sec2 = diff2 / 1000000000
print("  Double Arith    | ", ops2, " ops/sec | ", sec2, " s")

print("  Array Push      | (disabled)          | N/A")
print("  Struct Access   | (disabled)          | N/A")
print("  -------------------------------------------------------------")
print("")
