// Nevaarize Benchmark Suite
// Matches C++/Node.js benchmark structure

import stdlib time as t

struct Obj { val }

func printHeader() {
    print("  -------------------------------------------------------------")
    print("  Benchmark       |     Performance     | Time")
    print("  -------------------------------------------------------------")
}

func benchInt() {
    limit = 1000000000
    start = t.nanos()
    i = 0
    while (i < limit) {
        i = i + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = (0.0 + diff) / 1000000000.0
    print("  Integer Add     |", ops, "ops/sec |", sec, "s")
}

func benchDouble() {
    limit = 100000000
    val = 0.0
    start = t.nanos()
    j = 0
    while (j < limit) {
        val = val + 1.1
        j = j + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = (0.0 + diff) / 1000000000.0
    print("  Double Arith    |", ops, "ops/sec |", sec, "s")
}

func benchString() {
    limit = 50000
    s = ""
    start = t.nanos()
    i = 0
    while (i < limit) {
        s = s + "a"
        i = i + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = (0.0 + diff) / 1000000000.0
    print("  String Concat   |", ops, "ops/sec |", sec, "s")
}

func benchArray() {
    limit = 1000000
    arr = []
    start = t.nanos()
    k = 0
    while (k < limit) {
        arr.push(k)
        k = k + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = (0.0 + diff) / 1000000000.0
    print("  Array Push      |", ops, "ops/sec |", sec, "s")
}

func benchStruct() {
    limit = 50000000
    o = Obj(0)
    start = t.nanos()
    i = 0
    while (i < limit) {
        o.val = i
        x = o.val
        i = i + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = (0.0 + diff) / 1000000000.0
    print("  Struct Access   |", ops, "ops/sec |", sec, "s")
}

print(">>> Nevaarize Benchmark Suite <<<")
printHeader()
benchInt()
benchDouble()
benchString()
benchArray()
benchStruct()
print("  -------------------------------------------------------------")
print("")
