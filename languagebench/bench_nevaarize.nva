// Nevaarize Benchmark Suite
// Workaround version without string parameters

import stdlib time as t

func benchInt() {
    limit = 100000000
    start = t.nanos()
    i = 0
    while (i < limit) {
        i = i + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = diff / 1000000000
    print("  Integer Add     | ", ops, " ops/sec | ", sec, " s")
    return ops
}

func benchDouble() {
    limit = 10000000
    val = 0.0
    start = t.nanos()
    j = 0
    while (j < limit) {
        val = val + 1.1
        j = j + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = diff / 1000000000
    print("  Double Arith    | ", ops, " ops/sec | ", sec, " s")
    return ops
}

func benchArray() {
    limit = 10000
    arr = []
    start = t.nanos()
    k = 0
    while (k < limit) {
        arr.push(k)
        k = k + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = diff / 1000000000
    print("  Array Push      | ", ops, " ops/sec | ", sec, " s")
    return ops
}

print(">>> Nevaarize Benchmark Suite <<<")
print("  -------------------------------------------------------------")
print("  Benchmark       |     Performance     | Time")
print("  -------------------------------------------------------------")

benchInt()
benchDouble()
benchArray()

print("  Struct Access   | (in progress)       | N/A")
print("  -------------------------------------------------------------")
print("")
