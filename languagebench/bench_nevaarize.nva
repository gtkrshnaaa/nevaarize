// Nevaarize Benchmark Suite
// Clean, function-based structure matching other language benchmarks

import stdlib time as t

func printHeader() {
    print("  -------------------------------------------------------------")
    print("  Benchmark       |     Performance     | Time")
    print("  -------------------------------------------------------------")
}

func printResult(name, ops, sec) {
    print("  ", name, " | ", ops, " ops/sec | ", sec, " s")
}

func benchInt() {
    limit = 100000000
    start = t.nanos()
    i = 0
    while (i < limit) {
        i = i + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = diff / 1000000000
    printResult("Integer Add", ops, sec)
}

func benchDouble() {
    limit = 10000000
    val = 0.0
    start = t.nanos()
    j = 0
    while (j < limit) {
        val = val + 1.1
        j = j + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = diff / 1000000000
    printResult("Double Arith", ops, sec)
}

func benchArray() {
    limit = 1000
    arr = []
    start = t.nanos()
    k = 0
    while (k < limit) {
        arr.push(k)
        k = k + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) {
        diff = 1
    }
    ops = limit * 1000000000 / diff
    sec = diff / 1000000000
    printResult("Array Push", ops, sec)
}

print(">>> Nevaarize Benchmark Suite <<<")
printHeader()
benchInt()
benchDouble()
benchArray()
print("  Struct Access   | (in progress)       | N/A")
print("  -------------------------------------------------------------")
print("")
