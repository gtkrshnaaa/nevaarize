// Nevaarize Safe Benchmark (Reduced Iterations for Testing)
import stdlib time as t

struct Point { x, y }

func benchIntAdd() {
    limit = 10000000  // 10M instead of 100M
    start = t.nanos()
    i = 0
    while (i < limit) { i = i + 1 }
    end = t.nanos()
    diff = end - start
    if (diff == 0) { diff = 1 }
    ops = limit * 1000000000 / diff
    print("  Integer Add     | ", ops, " ops/sec | ", diff, " ns")
}

func benchDoubleArith() {
    limit = 1000000  // 1M instead of 10M
    val = 0.0
    start = t.nanos()
    j = 0
    while (j < limit) {
        val = val + 1.1
        j = j + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) { diff = 1 }
    ops = limit * 1000000000 / diff
    print("  Double Arith    | ", ops, " ops/sec | ", diff, " ns")
}

func benchStringConcat() {
    limit = 100  // Much smaller: 100 instead of 10K
    s = ""
    start = t.nanos()
    m = 0
    while (m < limit) {
        s = s + "a"
        m = m + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) { diff = 1 }
    ops = limit * 1000000000 / diff
    print("  String Concat   | ", ops, " ops/sec | ", diff, " ns")
}

func benchArrayPush() {
    limit = 10000  // CRITICAL: 10K instead of 1M to prevent crash
    arr = []
    start = t.nanos()
    k = 0
    while (k < limit) {
        arr.push(k)
        k = k + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) { diff = 1 }
    ops = limit * 1000000000 / diff
    print("  Array Push      | ", ops, " ops/sec | ", diff, " ns")
}

func benchStructAccess() {
    limit = 1000000  // 1M instead of 10M
    p = Point{10, 20}
    start = t.nanos()
    n = 0
    sum = 0
    while (n < limit) {
        sum = sum + p.x
        n = n + 1
    }
    end = t.nanos()
    diff = end - start
    if (diff == 0) { diff = 1 }
    ops = limit * 1000000000 / diff
    print("  Struct Access   | ", ops, " ops/sec | ", diff, " ns")
}

func main() {
    print(">>> Nevaarize SAFE Benchmark Suite (Reduced Limits) <<<")
    print("  -------------------------------------------------------------")
    print("  Benchmark       | Performance           | Time")
    print("  -------------------------------------------------------------")
    
    benchIntAdd()
    benchDoubleArith()
    benchStringConcat()
    benchArrayPush()
    benchStructAccess()
    
    print("  -------------------------------------------------------------")
}

main()
