// Array Utilities Module
// Common array manipulation functions

// Find index of element
func indexOf(arr, element) {
    for (i in Range(0, len(arr))) {
        if (arr[i] == element) {
            return i
        }
    }
    return -1
}

// Check if array contains element
func contains(arr, element) {
    return indexOf(arr, element) >= 0
}

// Get first element
func first(arr) {
    if (len(arr) > 0) {
        return arr[0]
    }
    return nil
}

// Get last element
func last(arr) {
    if (len(arr) > 0) {
        return arr[len(arr) - 1]
    }
    return nil
}

// Sum all numbers in array
func sum(arr) {
    total = 0
    for (item in arr) {
        total = total + item
    }
    return total
}

// Calculate average
func average(arr) {
    if (len(arr) == 0) {
        return 0
    }
    return sum(arr) / len(arr)
}

// Find minimum value
func min(arr) {
    if (len(arr) == 0) {
        return nil
    }
    minVal = arr[0]
    for (item in arr) {
        if (item < minVal) {
            minVal = item
        }
    }
    return minVal
}

// Find maximum value
func max(arr) {
    if (len(arr) == 0) {
        return nil
    }
    maxVal = arr[0]
    for (item in arr) {
        if (item > maxVal) {
            maxVal = item
        }
    }
    return maxVal
}

// Count occurrences
func count(arr, element) {
    total = 0
    for (item in arr) {
        if (item == element) {
            total = total + 1
        }
    }
    return total
}
