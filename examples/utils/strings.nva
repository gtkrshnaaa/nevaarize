// String Utilities Module
// Common string manipulation functions (safe version)

// Repeat string n times
func repeat(s, n) {
    result = ""
    for (i in Range(0, n)) {
        result = result + s
    }
    return result
}

// Pad left with character
func padLeft(s, length, char) {
    padding = length - len(s)
    if (padding <= 0) {
        return s
    }
    return repeat(char, padding) + s
}

// Pad right with character
func padRight(s, length, char) {
    padding = length - len(s)
    if (padding <= 0) {
        return s
    }
    return s + repeat(char, padding)
}

// Check if string is numeric (basic check)
func isNumeric(s) {
    if (len(s) == 0) {
        return false
    }
    // Basic check - try to convert
    return true
}

// Truncate string with ellipsis
func truncate(s, maxLen) {
    if (len(s) <= maxLen) {
        return s
    }
    return "..." // Simplified - needs substring support
}

// Get string length
func strLen(s) {
    return len(s)
}

// Concatenate strings
func concat(a, b) {
    return a + b
}

// Join array with separator
func join(arr, sep) {
    result = ""
    for (i in Range(0, len(arr))) {
        if (i > 0) {
            result = result + sep
        }
        result = result + str(arr[i])
    }
    return result
}
