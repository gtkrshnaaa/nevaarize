x = 42
y = 3.14
name = "Nevaarize"

print("Integer:", x)
print("Float:", y)
print("String:", name)
print("")


a = 10
b = 3

print("Addition:", a + b)
print("Subtraction:", a - b)
print("Multiplication:", a * b)
print("Division:", a / b)
print("")


print("Comparison:", a > b)
print("Equality:", a == b)
print("")


temp = 25

if (temp > 30) {
    print("Hot")
} elif (temp > 20) {
    print("Warm")
} else {
    print("Cold")
}
print("")


count = 0
while (count < 5) {
    print("Count:", count)
    count = count + 1
}
print("")


for (i in Range(0, 5)) {
    print("Index:", i)
}
print("")


func add(x, y) {
    return x + y
}

func multiply(x, y) {
    return x * y
}

print("add(7, 3):", add(7, 3))
print("multiply(6, 4):", multiply(6, 4))
print("")


func factorial(n) {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

print("factorial(5):", factorial(5))
print("factorial(6):", factorial(6))
print("")


numbers = [10, 20, 30, 40, 50]

print("Array:", numbers)
print("First:", numbers[0])
print("Third:", numbers[2])

numbers[2] = 99
print("Modified:", numbers[2])

total = 0
i = 0
while (i < 5) {
    total = total + numbers[i]
    i = i + 1
}
print("Sum:", total)
print("")


print("=== All Features Demonstrated ===")
