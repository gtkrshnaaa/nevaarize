print("=== Nevaarize Language Fundamentals ===")
print("")


print("1. Variables and Types")
print("----------------------")

x = 42
pi = 3.14159
name = "Nevaarize"
isActive = true
empty = nil

print("Integer:", x)
print("Float:", pi)
print("String:", name)
print("Boolean:", isActive)
print("Nil:", empty)
print("")


print("2. Arithmetic Operations")
print("------------------------")

a = 15
b = 4

print("Addition:", a + b)
print("Subtraction:", a - b)
print("Multiplication:", a * b)
print("Division:", a / b)
print("Modulo:", a % b)
print("")


print("3. Comparison and Logic")
print("-----------------------")

print("15 > 4:", a > b)
print("15 == 4:", a == b)
print("15 != 4:", a != b)

boolA = true
boolB = false

print("true AND false:", boolA and boolB)
print("true OR false:", boolA or boolB)
print("NOT true:", not boolA)
print("")


print("4. Control Flow")
print("---------------")

temperature = 25

if (temperature > 30) {
    print("Hot day")
} elif (temperature > 20) {
    print("Pleasant weather")
} elif (temperature > 10) {
    print("Cool day")
} else {
    print("Cold day")
}
print("")


print("5. Loops")
print("--------")

print("While loop (0 to 4):")
counter = 0
while (counter < 5) {
    print("  Value:", counter)
    counter = counter + 1
}

print("For loop (Range 5 to 9):")
for (i in Range(5, 10)) {
    print("  Index:", i)
}
print("")


print("6. Functions")
print("------------")

func add(x, y) {
    return x + y
}

func multiply(x, y) {
    return x * y
}

func power(base, exp) {
    if (exp == 0) {
        return 1
    }
    result = 1
    i = 0
    while (i < exp) {
        result = result * base
        i = i + 1
    }
    return result
}

print("add(7, 3):", add(7, 3))
print("multiply(6, 7):", multiply(6, 7))
print("power(2, 10):", power(2, 10))
print("")


print("7. Recursion")
print("------------")

func factorial(n) {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

func fibonacci(n) {
    if (n <= 1) {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

print("factorial(7):", factorial(7))
print("fibonacci(8):", fibonacci(8))
print("")


print("8. Arrays")
print("---------")

numbers = [3, 1, 4, 1, 5, 9, 2, 6]

print("Array:", numbers)
print("First element:", numbers[0])
print("Fourth element:", numbers[3])

numbers[3] = 99
print("After modification:", numbers[3])

total = 0
i = 0
while (i < 8) {
    total = total + numbers[i]
    i = i + 1
}
print("Array sum:", total)
print("")


print("9. Nested Structures")
print("--------------------")

matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

print("Matrix[1][2]:", matrix[1][2])

sum = 0
row = 0
while (row < 3) {
    col = 0
    while (col < 3) {
        sum = sum + matrix[row][col]
        col = col + 1
    }
    row = row + 1
}
print("Matrix sum:", sum)
print("")


print("10. Complex Logic")
print("-----------------")

func isPrime(n) {
    if (n <= 1) {
        return false
    }
    if (n == 2) {
        return true
    }
    if (n % 2 == 0) {
        return false
    }
    
    i = 3
    while (i * i <= n) {
        if (n % i == 0) {
            return false
        }
        i = i + 2
    }
    return true
}

func countPrimes(limit) {
    count = 0
    n = 2
    while (n <= limit) {
        if (isPrime(n)) {
            count = count + 1
        }
        n = n + 1
    }
    return count
}

print("isPrime(17):", isPrime(17))
print("isPrime(20):", isPrime(20))
print("Primes up to 50:", countPrimes(50))
print("")


print("=== All Fundamentals Covered ===")
