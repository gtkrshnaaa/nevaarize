// Async with Loops
// Demonstrates async operations inside loops

import stdlib time as t

async func processItem(index) {
    print("  Processing item", index, "...")
    t.sleep(200)
    return index * 2
}

async func batchProcess(count) {
    print("=== Batch Processing", count, "items ===\n")
    
    results = []
    
    for (i in Range(1, count + 1)) {
        result = await processItem(i)
        results.push(result)
        print("  Result:", result)
    }
    
    return results
}

async func parallelBatch(count) {
    print("\n=== Parallel Batch Processing ===\n")
    
    tasks = []
    
    // Launch all tasks
    for (i in Range(1, count + 1)) {
        task = processItem(i)
        tasks.push(task)
    }
    
    // Collect results
    results = []
    for (task in tasks) {
        result = await task
        results.push(result)
    }
    
    return results
}

print("=== Async Loops Demo ===\n")

// Sequential processing
sequential = await batchProcess(5)
print("\nSequential results:", sequential)

// Parallel processing
parallel = await parallelBatch(5)
print("\nParallel results:", parallel)
