// Async Basics
// Demonstrates basic async function and await usage

import stdlib time as t

async func fetchData(id) {
    print("Fetching data for ID:", id)
    t.sleep(500)
    return "Data" + str(id)
}

async func processItem(item) {
    print("Processing:", item)
    t.sleep(300)
    return item + " processed"
}

print("=== Async Basics Demo ===")

// Simple async call
data = await fetchData(1)
print("Received:", data)

// Chain async operations
result = await processItem(data)
print("Result:", result)

print("\nAsync basics complete!")
