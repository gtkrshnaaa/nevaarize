// Async Timeout Pattern
// Demonstrates timeout and retry patterns

import stdlib time as t

async func slowOperation(delay) {
    print("Starting slow operation (", delay, "ms delay)...")
    t.sleep(delay)
    return "Operation completed"
}

async func withTimeout(operation, maxDelay) {
    print("")
    print("=== Operation with timeout ===")
    
    start = t.clock()
    result = await operation
    elapsed = (t.clock() - start) * 1000
    
    print("Elapsed time:", int(elapsed), "ms")
    
    if (elapsed > maxDelay) {
        print("WARNING: Operation exceeded timeout!")
        return "TIMEOUT"
    }
    
    return result
}

async func retryOperation(maxAttempts) {
    print("")
    print("=== Retry Pattern Demo ===")
    print("")
    
    attempts = 0
    
    while (attempts < maxAttempts) {
        attempts = attempts + 1
        print("Attempt", attempts, "of", maxAttempts)
        
        result = await slowOperation(100)
        
        if (result != "ERROR") {
            print("Success on attempt", attempts)
            return result
        }
        
        print("Retrying...")
    }
    
    print("Failed after", maxAttempts, "attempts")
    return "FAILED"
}

print("=== Async Timeout Demo ===")

// Fast operation (should succeed)
task1 = slowOperation(200)
result1 = await withTimeout(task1, 500)
print("Result 1:", result1)

// Slow operation (should timeout)
task2 = slowOperation(400)
result2 = await withTimeout(task2, 300)
print("Result 2:", result2)

// Retry pattern
result3 = await retryOperation(2)
print("")
print("Final result:", result3)
