// Async Parallel Processing
// Demonstrates launching multiple async operations

import stdlib time as t

async func fetchResource(name, delay) {
    print("Starting fetch:", name)
    t.sleep(delay)
    print("Completed fetch:", name)
    return name + " data"
}

async func parallelFetch() {
    print("=== Parallel Fetch Demo ===\n")
    
    // Launch multiple async operations
    // In a real implementation, these would run concurrently
    task1 = fetchResource("API-1", 500)
    task2 = fetchResource("API-2", 300)
    task3 = fetchResource("API-3", 400)
    
    // Await all results
    result1 = await task1
    result2 = await task2
    result3 = await task3
    
    print("\nAll results:")
    print("  -", result1)
    print("  -", result2)
    print("  -", result3)
    
    return [result1, result2, result3]
}

results = await parallelFetch()
print("\nTotal results:", results.length)
