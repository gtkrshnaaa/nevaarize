// Async Composition
// Demonstrates composing multiple async functions

import stdlib time as t
import stdlib math as m

async func fetchNumber(name, value) {
    print("Fetching", name, "...")
    t.sleep(300)
    return value
}

async func computeSquare(x) {
    print("Computing square of", x, "...")
    t.sleep(200)
    return x * x
}

async func computeSqrt(x) {
    print("Computing sqrt of", x, "...")
    t.sleep(200)
    return m.Sqrt(x)
}

async func complexCalculation(a, b) {
    print("\n=== Complex Async Calculation ===\n")
    
    // Fetch inputs
    num1 = await fetchNumber("A", a)
    num2 = await fetchNumber("B", b)
    
    print("\nGot numbers:", num1, "and", num2)
    
    // Compute squares
    square1 = await computeSquare(num1)
    square2 = await computeSquare(num2)
    
    print("Squares:", square1, "and", square2)
    
    // Sum of squares
    sumSquares = square1 + square2
    print("Sum of squares:", sumSquares)
    
    // Final sqrt
    result = await computeSqrt(sumSquares)
    print("Final result:", result)
    
    return result
}

print("=== Async Composition Demo ===")

// Pythagorean theorem: sqrt(3^2 + 4^2) = 5
answer = await complexCalculation(3, 4)
print("\nAnswer:", answer)
