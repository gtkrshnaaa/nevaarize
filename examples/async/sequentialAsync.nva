// Async Sequential Processing
// Demonstrates sequential async operations

import stdlib time as t

async func fetchUser(userId) {
    print("Fetching user", userId, "...")
    t.sleep(400)
    return "User" + str(userId)
}

async func fetchPosts(user) {
    print("Fetching posts for", user, "...")
    t.sleep(300)
    return [user + " Post1", user + " Post2", user + " Post3"]
}

async func fetchComments(post) {
    print("Fetching comments for", post, "...")
    t.sleep(200)
    return [post + " Comment1", post + " Comment2"]
}

async func loadUserData(userId) {
    print("\n=== Loading user data for ID:", userId, "===")
    
    // Sequential async calls
    user = await fetchUser(userId)
    print("Got user:", user)
    
    posts = await fetchPosts(user)
    print("Got posts:", posts)
    
    // Process first post
    if (posts.length > 0) {
        comments = await fetchComments(posts[0])
        print("Got comments:", comments)
    }
    
    return user
}

print("=== Sequential Async Demo ===")

result = await loadUserData(42)
print("\nFinal result:", result)
