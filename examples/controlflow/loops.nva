// Control Flow: Loops
// Demonstrates for and while loops with JIT optimization

// For loop with Range
print("=== For Loop ===")
for (i in Range(1, 6)) {
    print("Iteration:", i)
}

// For loop with array
print("\n=== Array Iteration ===")
fruits = ["apple", "banana", "cherry"]
for (fruit in fruits) {
    print("Fruit:", fruit)
}

// While loop
print("\n=== While Loop ===")
count = 0
while (count < 5) {
    print("Count:", count)
    count = count + 1
}

// Nested loops
print("\n=== Nested Loops ===")
for (i in Range(1, 4)) {
    for (j in Range(1, 4)) {
        print(i, "x", j, "=", i * j)
    }
}
