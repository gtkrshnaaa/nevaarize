import stdlib string as s
import stdlib io as io

io.Println("==== Nevaarize std.string JIT Test ====")

text = "  Hello Nevaarize Native JIT!  "
io.Println("Original:", text)
io.Println("Length:", s.length(text))

trimmed = s.trim(text)
io.Println("Trimmed:", trimmed)
io.Println("Trimmed Length:", s.length(trimmed))

io.Println("Upper:", s.toUpperCase(trimmed))
io.Println("Lower:", s.toLowerCase(trimmed))

containsJit = s.contains(trimmed, "JIT")
io.Println("Contains 'JIT':", containsJit)

idx = s.indexOf(trimmed, "Native")
io.Println("IndexOf 'Native':", idx)

starts = s.startsWith(trimmed, "Hello")
ends = s.endsWith(trimmed, "JIT!")
io.Println("Starts with 'Hello':", starts)
io.Println("Ends with 'JIT!':", ends)

sub = s.substring(trimmed, 6, 9)
io.Println("Substring(6, 9):", sub)

replaced = s.replace(trimmed, "Native", "C++")
io.Println("Replaced:", replaced)

words = s.split(trimmed, " ")
io.Println("Split into Array Size:", words.size())
for (w in words) {
    io.Println("-", w)
}

io.Println("==== String Benchmark / GC Test ====")
bench = "start"
for (i in Range(0, 5000)) {
    bench = s.replace(bench, "start", "start")
}
io.Println("GC Test Complete:", s.length(bench) == 5)

