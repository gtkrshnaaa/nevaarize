import stdlib json as json

data = json.ParseJSONString("{\"a\": 1}")
print("data:")
print(data)

x = 42
print("x:")
print(x)

print("x == 0:")
if (x == 0) {
    print("TRUE")
} else {
    print("FALSE")
}

print("data == nil:")
if (data == nil) {
    print("TRUE (BUG)")
} else {
    print("FALSE (CORRECT)")
}
