import stdlib json as json

jsonString = "{\"user\": \"developer\", \"isActive\": true, \"balance\": 105.5, \"tags\": [\"core\", \"jit\"]}"

data = json.ParseJSONString(jsonString)

print("Map structure loaded:")
print(data)

print("\nMap Access test:")
print(data["user"])
print(data["isActive"])
print(data["tags"])
