// Full JSON Test for Nevaarize Stdlib
import stdlib json as json

print("=== Nevaarize JSON Full Test ===")

// 1. Valid JSON String
jsonString = "{\"user\": \"dev\", \"active\": true, \"score\": 42.5, \"tags\": [\"jit\", \"fast\"], \"null_val\": null}"
print("\nJSON Input String:")
print(jsonString)

data = json.ParseJSONString(jsonString)

print("\nParsed Structure:")
print(data)

print("\nValidating types & nil comparison:")
if (data == nil) {
    print("FAIL: Parsed data is nil!")
} else {
    print("OK: data is not nil.")
}

print("\n=== End of Test ===")
