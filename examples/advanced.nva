function fibIterative(n) {
    if (n <= 1) {
        return n
    }
    
    prev = 0
    curr = 1
    i = 2
    
    while (i <= n) {
        next = prev + curr
        prev = curr
        curr = next
        i = i + 1
    }
    
    return curr
}

print("Fibonacci Iterative:")
print("fibIter(10):", fibIterative(10))
print("fibIter(15):", fibIterative(15))
print("fibIter(20):", fibIterative(20))
print("")


function arraySum(arr, length) {
    total = 0
    i = 0
    while (i < length) {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

function arrayMax(arr, length) {
    max = arr[0]
    i = 1
    while (i < length) {
        if (arr[i] > max) {
            max = arr[i]
        }
        i = i + 1
    }
    return max
}

data = [15, 7, 23, 9, 31, 12, 19]
length = 7

print("Array Operations:")
print("Sum:", arraySum(data, length))
print("Max:", arrayMax(data, length))
print("")


function power(base, exp) {
    result = 1
    i = 0
    while (i < exp) {
        result = result * base
        i = i + 1
    }
    return result
}

print("Power Function:")
print("power(2, 10):", power(2, 10))
print("power(3, 5):", power(3, 5))
print("")


function factorialIter(n) {
    result = 1
    i = 2
    while (i <= n) {
        result = result * i
        i = i + 1
    }
    return result
}

print("Factorial (Iterative):")
print("factorial(5):", factorialIter(5))
print("factorial(10):", factorialIter(10))
print("")


print("=== All Algorithms Complete ===")
