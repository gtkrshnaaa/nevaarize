func fibonacci(n) {
    if (n <= 1) {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

print("Fibonacci Sequence:")
print("fib(0):", fibonacci(0))
print("fib(1):", fibonacci(1))
print("fib(5):", fibonacci(5))
print("fib(8):", fibonacci(8))
print("fib(10):", fibonacci(10))
print("")


func fibIterative(n) {
    if (n <= 1) {
        return n
    }
    
    prev = 0
    curr = 1
    i = 2
    
    while (i <= n) {
        next = prev + curr
        prev = curr
        curr = next
        i = i + 1
    }
    
    return curr
}

print("Fibonacci Iterative:")
print("fibIter(15):", fibIterative(15))
print("fibIter(20):", fibIterative(20))
print("")


func gcd(a, b) {
    while (b != 0) {
        temp = b
        b = a % b
        a = temp
    }
    return a
}

print("Greatest Common Divisor:")
print("gcd(48, 18):", gcd(48, 18))
print("gcd(100, 35):", gcd(100, 35))
print("")


func arraySum(arr, length) {
    total = 0
    i = 0
    while (i < length) {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

func arrayMax(arr, length) {
    if (length == 0) {
        return 0
    }
    
    max = arr[0]
    i = 1
    while (i < length) {
        if (arr[i] > max) {
            max = arr[i]
        }
        i = i + 1
    }
    return max
}

data = [15, 7, 23, 9, 31, 12, 19]
length = 7

print("Array Operations:")
print("Data:", data)
print("Sum:", arraySum(data, length))
print("Max:", arrayMax(data, length))
print("")


func bubbleSort(arr, n) {
    i = 0
    while (i < n) {
        j = 0
        while (j < n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
            j = j + 1
        }
        i = i + 1
    }
    return arr
}

unsorted = [64, 34, 25, 12, 22, 11, 90]
print("Bubble Sort:")
print("Before:", unsorted)
sorted = bubbleSort(unsorted, 7)
print("After:", sorted)
print("")


func isPrime(n) {
    if (n <= 1) {
        return false
    }
    if (n == 2) {
        return true
    }
    if (n % 2 == 0) {
        return false
    }
    
    i = 3
    while (i * i <= n) {
        if (n % i == 0) {
            return false
        }
        i = i + 2
    }
    return true
}

print("Prime Number Check:")
print("isPrime(17):", isPrime(17))
print("isPrime(20):", isPrime(20))
print("isPrime(97):", isPrime(97))
print("")


func power(base, exp) {
    if (exp == 0) {
        return 1
    }
    result = 1
    i = 0
    while (i < exp) {
        result = result * base
        i = i + 1
    }
    return result
}

print("Power Function:")
print("power(2, 10):", power(2, 10))
print("power(3, 5):", power(3, 5))
print("")


print("=== All Algorithms Complete ===")
