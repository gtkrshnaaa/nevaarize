// Prime Number Algorithms — trial division, smallest factor, primality test

print("=== Smallest Prime Factor (inline) ===")

// Find smallest prime factor of 84
n = 84
d = 2
while (d * d <= n) {
    if (n % d == 0) {
        print("Smallest factor of 84:", d)
        d = n + 1
    } else {
        d = d + 1
    }
}

// Find smallest prime factor of 91
n = 91
d = 2
while (d * d <= n) {
    if (n % d == 0) {
        print("Smallest factor of 91:", d)
        d = n + 1
    } else {
        d = d + 1
    }
}

print("")
print("=== Divisor Count (inline) ===")

n = 12
count = 0
i = 1
while (i <= n) {
    if (n % i == 0) {
        count = count + 1
    }
    i = i + 1
}
print("Divisors of 12:", count)

n = 28
count = 0
i = 1
while (i <= n) {
    if (n % i == 0) {
        count = count + 1
    }
    i = i + 1
}
print("Divisors of 28:", count)

print("")
print("=== Prime Check (O(sqrt(n)) Trial Division) ===")

func isPrime(n) {
    if (n <= 1) { return 0 }
    if (n <= 3) { return 1 }
    if (n % 2 == 0) { return 0 }
    if (n % 3 == 0) { return 0 }
    i = 5
    while (i * i <= n) {
        if (n % i == 0) { return 0 }
        if (n % (i + 2) == 0) { return 0 }
        i = i + 6
    }
    return 1
}

print("isPrime(2) =", isPrime(2))
print("isPrime(17) =", isPrime(17))
print("isPrime(97) =", isPrime(97))
print("isPrime(100) =", isPrime(100))
print("isPrime(997) =", isPrime(997))

print("")
print("=== Prime Generation Complete ===")
