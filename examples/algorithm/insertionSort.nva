// Insertion Sort — O(n^2) stable, efficient on small/nearly-sorted data
// Selection Sort — O(n^2) minimizes writes by selecting minimum

print("=== Insertion Sort ===")

func printArray(arr, n) {
    i = 0
    while (i < n) {
        print(" ", arr[i])
        i = i + 1
    }
}

func insertionSort(arr, n) {
    i = 1
    while (i < n) {
        key = arr[i]
        j = i - 1
        moved = 1
        while (j >= 0) {
            if (moved == 1) {
                if (arr[j] > key) {
                    arr[j + 1] = arr[j]
                    j = j - 1
                } else {
                    moved = 0
                }
            } else {
                j = -1
            }
        }
        arr[j + 1] = key
        i = i + 1
    }
}

data1 = [12, 11, 13, 5, 6, 7]
print("Before:")
printArray(data1, 6)

insertionSort(data1, 6)
print("After:")
printArray(data1, 6)

print("")
print("=== Selection Sort ===")

func selectionSort(arr, n) {
    i = 0
    while (i < n - 1) {
        minIdx = i
        j = i + 1
        while (j < n) {
            if (arr[j] < arr[minIdx]) {
                minIdx = j
            }
            j = j + 1
        }
        if (minIdx != i) {
            temp = arr[i]
            arr[i] = arr[minIdx]
            arr[minIdx] = temp
        }
        i = i + 1
    }
}

data2 = [29, 10, 14, 37, 13, 8]
print("Before:")
printArray(data2, 6)

selectionSort(data2, 6)
print("After:")
printArray(data2, 6)

print("")
print("=== Insertion Sort Complete ===")
