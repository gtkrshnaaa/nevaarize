// Linear Search — O(n) sequential scan
// Sentinel Search — O(n) eliminates bounds check per iteration

print("=== Linear Search ===")

function linearSearch(arr, n, target) {
    i = 0
    while (i < n) {
        if (arr[i] == target) {
            return i
        }
        i = i + 1
    }
    return -1
}

data = [10, 23, 45, 70, 11, 15, 90, 55]

idx1 = linearSearch(data, 8, 70)
print("Search 70: found at index", idx1)

idx2 = linearSearch(data, 8, 99)
print("Search 99: found at index", idx2)

idx3 = linearSearch(data, 8, 10)
print("Search 10: found at index", idx3)

idx4 = linearSearch(data, 8, 55)
print("Search 55: found at index", idx4)

print("")
print("=== Sentinel Search ===")

function sentinelSearch(arr, n, target) {
    last = arr[n - 1]
    arr[n - 1] = target

    i = 0
    while (arr[i] != target) {
        i = i + 1
    }

    arr[n - 1] = last

    if (i < n - 1) {
        return i
    }
    if (last == target) {
        return n - 1
    }
    return -1
}

data2 = [4, 8, 15, 16, 23, 42, 7, 1]

idx4 = sentinelSearch(data2, 8, 23)
print("Sentinel search 23: found at index", idx4)

idx5 = sentinelSearch(data2, 8, 100)
print("Sentinel search 100: found at index", idx5)

idx6 = sentinelSearch(data2, 8, 1)
print("Sentinel search 1: found at index", idx6)

print("")
print("=== Count Occurrences ===")

function countOccurrences(arr, n, target) {
    count = 0
    i = 0
    while (i < n) {
        if (arr[i] == target) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

data3 = [1, 3, 5, 3, 7, 3, 9, 3]
print("Occurrences of 3:", countOccurrences(data3, 8, 3))
print("Occurrences of 5:", countOccurrences(data3, 8, 5))
print("Occurrences of 2:", countOccurrences(data3, 8, 2))

print("")
print("=== Linear Search Complete ===")
