// GCD (Euclidean Algorithm) — O(log(min(a,b)))
// LCM — derived from GCD
// Primality Test — O(sqrt(n)) trial division

print("=== GCD (Euclidean Algorithm) ===")

function gcd(a, b) {
    while (b > 0) {
        temp = b
        b = a % b
        a = temp
    }
    return a
}

print("gcd(48, 18) =", gcd(48, 18))
print("gcd(100, 35) =", gcd(100, 35))
print("gcd(270, 192) =", gcd(270, 192))
print("gcd(17, 13) =", gcd(17, 13))

print("")
print("=== LCM ===")

function lcm(a, b) {
    g = gcd(a, b)
    return (a / g) * b
}

print("lcm(4, 6) =", lcm(4, 6))
print("lcm(12, 18) =", lcm(12, 18))
print("lcm(7, 5) =", lcm(7, 5))

print("")
print("=== Primality Test ===")

function isPrime(n) {
    if (n <= 1) { return 0 }
    if (n <= 3) { return 1 }
    if (n % 2 == 0) { return 0 }
    if (n % 3 == 0) { return 0 }

    i = 5
    while (i * i <= n) {
        if (n % i == 0) { return 0 }
        if (n % (i + 2) == 0) { return 0 }
        i = i + 6
    }
    return 1
}

print("isPrime(2) =", isPrime(2))
print("isPrime(17) =", isPrime(17))
print("isPrime(20) =", isPrime(20))
print("isPrime(97) =", isPrime(97))
print("isPrime(100) =", isPrime(100))
print("isPrime(997) =", isPrime(997))

print("")
print("=== Absolute Value ===")

function abs(n) {
    if (n < 0) { return 0 - n }
    return n
}

print("abs(-42) =", abs(-42))
print("abs(42) =", abs(42))
print("abs(0) =", abs(0))

print("")
print("=== Number Theory Complete ===")
