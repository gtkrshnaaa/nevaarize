// Concurrent Stress Test
// Pushes async/await, GC, and exception handling to the limit.

import stdlib time as t

// ---------------------------------------------------------------------------
// Test 1: Async Fan-Out — MASSIVE
// Spawn 10 async tasks, each summing 500 million integers.
// ---------------------------------------------------------------------------

async func asyncSum(n) {
    total = 0
    i = 0
    while (i < n) {
        total = total + i
        i = i + 1
    }
    return total
}

func testAsyncFanOut() {
    print("--- Test 1: Async Fan-Out (10 x 500M iterations) ---")
    s = t.nanos()

    t1  = asyncSum(500000000)
    t2  = asyncSum(500000000)
    t3  = asyncSum(500000000)
    t4  = asyncSum(500000000)
    t5  = asyncSum(500000000)
    t6  = asyncSum(500000000)
    t7  = asyncSum(500000000)
    t8  = asyncSum(500000000)
    t9  = asyncSum(500000000)
    t10 = asyncSum(500000000)

    r1  = await t1
    r2  = await t2
    r3  = await t3
    r4  = await t4
    r5  = await t5
    r6  = await t6
    r7  = await t7
    r8  = await t8
    r9  = await t9
    r10 = await t10

    total = r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10
    e = t.nanos()

    ms = (e - s) / 1000000

    print("  Total across 10 tasks:", total)
    print("  Duration:", ms, "ms")
    print("  PASS")
    print("")
}

// ---------------------------------------------------------------------------
// Test 2: GC Pressure Under Concurrency — BRUTAL
// 8 async tasks, each allocating 1M arrays (8 million total allocs).
// ---------------------------------------------------------------------------

async func asyncAllocator(count) {
    i = 0
    while (i < count) {
        arr = [i, i + 1, i + 2, i + 3, i + 4, i + 5, i + 6, i + 7]
        i = i + 1
    }
    return count
}

func testGCPressure() {
    print("--- Test 2: GC Pressure (8 tasks x 1M allocs = 8M total) ---")
    s = t.nanos()

    g1 = asyncAllocator(1000000)
    g2 = asyncAllocator(1000000)
    g3 = asyncAllocator(1000000)
    g4 = asyncAllocator(1000000)
    g5 = asyncAllocator(1000000)
    g6 = asyncAllocator(1000000)
    g7 = asyncAllocator(1000000)
    g8 = asyncAllocator(1000000)

    r1 = await g1
    r2 = await g2
    r3 = await g3
    r4 = await g4
    r5 = await g5
    r6 = await g6
    r7 = await g7
    r8 = await g8

    total = r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8
    e = t.nanos()

    ms = (e - s) / 1000000

    print("  Total allocations:", total)
    if (total == 8000000) {
        print("  PASS | Duration:", ms, "ms")
    } else {
        print("  FAIL: expected 8000000 got", total)
    }
    print("")
}

// ---------------------------------------------------------------------------
// Test 3: Exception Safety Under Load
// 6 async tasks with 50M ops each.
// ---------------------------------------------------------------------------

async func asyncSafe(n) {
    total = 0
    i = 0
    while (i < n) {
        total = total + 1
        i = i + 1
    }
    return total
}

func testAsyncExceptionSafety() {
    print("--- Test 3: Exception Safety (6 tasks x 50M ops) ---")
    s = t.nanos()

    a1 = asyncSafe(50000000)
    a2 = asyncSafe(50000000)
    a3 = asyncSafe(50000000)
    a4 = asyncSafe(50000000)
    a5 = asyncSafe(50000000)
    a6 = asyncSafe(50000000)

    r1 = await a1
    r2 = await a2
    r3 = await a3
    r4 = await a4
    r5 = await a5
    r6 = await a6

    total = r1 + r2 + r3 + r4 + r5 + r6
    e = t.nanos()

    ms = (e - s) / 1000000

    print("  Safe tasks total:", total)
    if (total == 300000000) {
        print("  PASS | Duration:", ms, "ms")
    } else {
        print("  FAIL: expected 300000000 got", total)
    }
    print("")
}

// ---------------------------------------------------------------------------
// Test 4: Sequential vs Parallel — HEAVY
// 4 tasks x 200M iterations each. Should show clear parallel advantage.
// ---------------------------------------------------------------------------

func syncSum(n) {
    total = 0
    i = 0
    while (i < n) {
        total = total + i
        i = i + 1
    }
    return total
}

func testSpeedComparison() {
    print("--- Test 4: Sequential vs Parallel (4 x 200M) ---")

    // Sequential: run 4 tasks one after another
    s1 = t.nanos()
    seq1 = syncSum(200000000)
    seq2 = syncSum(200000000)
    seq3 = syncSum(200000000)
    seq4 = syncSum(200000000)
    seqTotal = seq1 + seq2 + seq3 + seq4
    e1 = t.nanos()
    seqMs = (e1 - s1) / 1000000

    // Parallel: run 4 async tasks simultaneously
    s2 = t.nanos()
    p1 = asyncSum(200000000)
    p2 = asyncSum(200000000)
    p3 = asyncSum(200000000)
    p4 = asyncSum(200000000)
    pr1 = await p1
    pr2 = await p2
    pr3 = await p3
    pr4 = await p4
    parTotal = pr1 + pr2 + pr3 + pr4
    e2 = t.nanos()
    parMs = (e2 - s2) / 1000000

    print("  Sequential:", seqMs, "ms | Result:", seqTotal)
    print("  Parallel:  ", parMs, "ms | Result:", parTotal)

    if (seqTotal == parTotal) {
        print("  PASS: results match")
    } else {
        print("  FAIL: results differ seq=", seqTotal, "par=", parTotal)
    }

    if (parMs < seqMs) {
        print("  Parallel is FASTER!")
    } else {
        print("  Sequential was faster (may vary per run)")
    }
    print("")
}

// ---------------------------------------------------------------------------
// Test 5: Allocation Storm — INSANE
// 500k nested array pairs hammering the GC.
// ---------------------------------------------------------------------------

func testAllocationStorm() {
    print("--- Test 5: Allocation Storm (500K nested arrays) ---")
    s = t.nanos()

    i = 0
    count = 0
    while (i < 500000) {
        inner = [i, i * 2, i * 3]
        outer = [inner, i + 1, i + 2]
        count = count + 1
        i = i + 1
    }

    e = t.nanos()
    ms = (e - s) / 1000000

    print("  Objects created:", count)
    if (count == 500000) {
        print("  PASS | Duration:", ms, "ms")
    } else {
        print("  FAIL: expected 500000 got", count)
    }
    print("")
}

// ===========================================================================
// Run All Tests
// ===========================================================================

print(">>> Nevaarize Concurrent Stress Test <<<")
print("=========================================")
print("")

totalStart = t.nanos()

testAsyncFanOut()
testGCPressure()
testAsyncExceptionSafety()
testSpeedComparison()
testAllocationStorm()

totalEnd = t.nanos()
totalMs = (totalEnd - totalStart) / 1000000

print("=========================================")
print("  TOTAL TIME:", totalMs, "ms")
print("=== ALL CONCURRENT STRESS TESTS DONE ===")
