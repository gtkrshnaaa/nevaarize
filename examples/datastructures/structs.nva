// Data Structures: Structs
// Demonstrates struct definitions with inline caching

import stdlib math as m

// Struct definition
struct Vector3 {
    x
    y
    z
}

// Constructor helper
func makeVector(x, y, z) {
    v = Vector3()
    v.x = x
    v.y = y
    v.z = z
    return v
}

// Struct methods (functions that operate on structs)
func magnitude(v) {
    return m.Sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
}

func addVectors(v1, v2) {
    return makeVector(v1.x + v2.x, v1.y + v2.y, v1.z + v2.z)
}

func scaleVector(v, scalar) {
    return makeVector(v.x * scalar, v.y * scalar, v.z * scalar)
}

// Usage
v1 = makeVector(3, 4, 0)
v2 = makeVector(1, 2, 3)

print("Vector 1:", v1.x, v1.y, v1.z)
print("Vector 2:", v2.x, v2.y, v2.z)

mag1 = magnitude(v1)
print("Magnitude of v1:", mag1)

sum = addVectors(v1, v2)
print("Sum:", sum.x, sum.y, sum.z)

scaled = scaleVector(v1, 2)
print("Scaled v1:", scaled.x, scaled.y, scaled.z)
