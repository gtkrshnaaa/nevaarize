// Data Structures: Arrays
// Demonstrates array operations with JIT specialization

// Array creation
arr = [1, 2, 3, 4, 5]
print("Array:", arr)
print("Length:", arr.length)

// Element access
print("First element:", arr[0])
print("Third element:", arr[2])

// Array modification
arr[1] = 10
print("After modification:", arr)

// Array methods
arr.push(6)
print("After push(6):", arr)

last = arr.pop()
print("Popped:", last)
print("After pop:", arr)

// Iteration
print("\n=== Array Iteration ===")
for (val in arr) {
    print("Value:", val)
}

// Array of mixed types
mixed = [42, 3.14, "hello", true]
print("\nMixed array:", mixed)

// Nested arrays
matrix = [[1, 2], [3, 4], [5, 6]]
print("\nMatrix:", matrix)
print("Element [1][0]:", matrix[1][0])
