// crawlDemo.nva - Claw Standard Library Crawler Demo
// Demonstrates offline HTML crawling, css selectors, and CSV/JSON output.

import stdlib claw as claw
import stdlib io as io

function loadElements(filePath) {
    print("Crawling '" + filePath + "'...")
    elements = claw.CrawlFile(filePath)
    if (elements == 0) {
        print("Error: Could not crawl file: " + filePath)
        return 0
    }
    print("Successfully parsed offline HTML document.")
    print("Total parsed elements: " + str(elements.size()))
    print("")
    return elements
}

function printHeadings(elements) {
    print("Selecting headings using 'div.card h2.card-title'...")
    headings = claw.Select(elements, "div.card h2.card-title")
    print("Found card titles: " + str(headings.size()))
    
    i = 0
    while (i < headings.size()) {
        el = headings[i]
        print(" - Title tag: " + el["tag"] + " | Text: " + el["text"])
        i = i + 1
    }
    print("")
}

function printFeatured(elements) {
    print("Selecting featured card using attribute selector '[data-category=featured]'...")
    featured = claw.Select(elements, "[data-category=featured]")
    print("Found featured elements: " + str(featured.size()))
    
    i = 0
    while (i < featured.size()) {
        el = featured[i]
        print(" - Tag: " + el["tag"] + " | Text content: " + el["text"])
        i = i + 1
    }
    print("")
}

function transformLinksToRows(links) {
    exportData = []
    i = 0
    while (i < links.size()) {
        el = links[i]
        attrs = el["attrs"]
        
        row = {}
        row["tag"] = el["tag"]
        row["text"] = el["text"]
        row["href"] = attrs["href"]
        
        exportData.push(row)
        i = i + 1
    }
    return exportData
}

function exportResults(exportData) {
    print("Saving crawled links data to 'links_output.csv' and 'links_output.json'...")
    
    csvOk = claw.SaveCSV("links_output.csv", exportData)
    jsonOk = claw.SaveJSON("links_output.json", exportData)
    
    if (csvOk) {
        print("Successfully exported to CSV.")
    } else {
        print("Failed to export to CSV.")
    }
    
    if (jsonOk) {
        print("Successfully exported to JSON.")
    } else {
        print("Failed to export to JSON.")
    }
}

function runCrawlerDemo() {
    print("=== Nevaarize Claw Crawler Demo ===")
    print("")
    
    elements = loadElements("crawler_test.html")
    if (elements == 0) {
        return 0
    }
    
    printHeadings(elements)
    
    print("Selecting links using 'div.card a.link'...")
    links = claw.Select(elements, "div.card a.link")
    print("Found links: " + str(links.size()))
    
    i = 0
    while (i < links.size()) {
        el = links[i]
        attrs = el["attrs"]
        print(" - Tag: " + el["tag"] + " | Text: " + el["text"] + " | Href: " + attrs["href"])
        i = i + 1
    }
    print("")
    
    printFeatured(elements)
    
    exportData = transformLinksToRows(links)
    exportResults(exportData)
    
    print("")
    print("=== Claw Crawler Demo Complete ===")
    return 1
}

runCrawlerDemo()
