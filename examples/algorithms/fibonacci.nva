// Algorithms: Fibonacci
// Demonstrates recursive and iterative approaches

// Recursive fibonacci (slower, demonstrates call overhead)
func fibRecursive(n) {
    if (n <= 1) {
        return n
    }
    return fibRecursive(n - 1) + fibRecursive(n - 2)
}

// Iterative fibonacci (faster, JIT-optimized loop)
func fibIterative(n) {
    if (n <= 1) {
        return n
    }
    
    a = 0
    b = 1
    
    for (i in Range(2, n + 1)) {
        temp = a + b
        a = b
        b = temp
    }
    
    return b
}

// Test both approaches
print("=== Recursive Fibonacci ===")
for (i in Range(0, 11)) {
    print("fib(", i, ") =", fibRecursive(i))
}

print("\n=== Iterative Fibonacci ===")
for (i in Range(0, 21)) {
    print("fib(", i, ") =", fibIterative(i))
}
