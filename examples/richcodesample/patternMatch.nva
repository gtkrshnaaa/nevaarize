import stdlib time as t

// Pattern Matching on Integer Arrays
// Demonstrates naive pattern search, counting, and boundary matching.

print("=== Nevaarize Pattern Matching ===\n")

start = t.millis()

// --- Naive Search ---
print("--- Naive Pattern Search ---")
text = [1, 2, 3, 4, 5, 1, 2, 3, 6, 7]
textLen = 10
pat = [1, 2, 3]
patLen = 3

function naiveSearch(text, tLen, pat, pLen) {
    i = 0
    while (i <= tLen - pLen) {
        match = 1
        j = 0
        while (j < pLen) {
            if (text[i + j] != pat[j]) {
                match = 0
                j = pLen
            } else {
                j = j + 1
            }
        }
        if (match == 1) { return i }
        i = i + 1
    }
    return -1
}

pos = naiveSearch(text, textLen, pat, patLen)
print("First match [1,2,3] at:", pos, "(expected: 0)")

// --- Count Occurrences ---
print("\n--- Count Occurrences ---")
function countPattern(text, tLen, pat, pLen) {
    count = 0
    i = 0
    while (i <= tLen - pLen) {
        match = 1
        j = 0
        while (j < pLen) {
            if (text[i + j] != pat[j]) {
                match = 0
                j = pLen
            } else {
                j = j + 1
            }
        }
        if (match == 1) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

c = countPattern(text, textLen, pat, patLen)
print("Count [1,2,3]:", c, "(expected: 2)")

// --- No Match ---
print("\n--- No Match ---")
noPat = [9, 9, 9]
pos2 = naiveSearch(text, textLen, noPat, 3)
print("Search [9,9,9]:", pos2)

// --- Single Element Pattern ---
print("\n--- Single Element ---")
singlePat = [5]
pos3 = naiveSearch(text, textLen, singlePat, 1)
print("Search [5]:", pos3, "(expected: 4)")

// --- Pattern at End ---
print("\n--- Pattern at End ---")
endPat = [6, 7]
pos4 = naiveSearch(text, textLen, endPat, 2)
print("Search [6,7]:", pos4, "(expected: 8)")

// --- Full Match ---
print("\n--- Full Array Match ---")
fullPat = [1, 2, 3, 4, 5, 1, 2, 3, 6, 7]
pos5 = naiveSearch(text, textLen, fullPat, 10)
print("Full match:", pos5, "(expected: 0)")

// --- Max Subarray (Kadane's Algorithm) ---
print("\n--- Kadane's Max Subarray ---")
function kadane(arr, n) {
    maxEnding = arr[0]
    maxSoFar = arr[0]
    i = 1
    while (i < n) {
        candidate = maxEnding + arr[i]
        if (arr[i] > candidate) {
            maxEnding = arr[i]
        } else {
            maxEnding = candidate
        }
        if (maxEnding > maxSoFar) {
            maxSoFar = maxEnding
        }
        i = i + 1
    }
    return maxSoFar
}

data = [2, 3, 4, 5, 7]
print("Max subarray [2,3,4,5,7]:", kadane(data, 5), "(expected: 21)")

data2 = [1, 2, 3]
print("Max subarray [1,2,3]:", kadane(data2, 3), "(expected: 6)")

// --- Longest Run of Equal Values ---
print("\n--- Longest Run ---")
function longestRun(arr, n) {
    if (n == 0) { return 0 }
    maxRun = 1
    curRun = 1
    i = 1
    while (i < n) {
        if (arr[i] == arr[i - 1]) {
            curRun = curRun + 1
            if (curRun > maxRun) { maxRun = curRun }
        } else {
            curRun = 1
        }
        i = i + 1
    }
    return maxRun
}

runData = [1, 1, 1, 2, 2, 3, 3, 3, 3, 1]
print("Longest run:", longestRun(runData, 10), "(expected: 4)")

runData2 = [5, 5, 5, 5, 5]
print("All same:", longestRun(runData2, 5), "(expected: 5)")

runData3 = [1, 2, 3, 4, 5]
print("All different:", longestRun(runData3, 5), "(expected: 1)")

elapsed = t.millis() - start
print("\nAll pattern match tests completed in", elapsed, "ms")
print("Pattern matching finished.")
