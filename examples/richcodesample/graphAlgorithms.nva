import stdlib time as t

// Graph Algorithms in Nevaarize
// Demonstrates adjacency list representation and traversal using integer node IDs

// Adjacency list as a map of integer arrays
adjList = {}

func addEdge(u, v) {
    if (!adjList.has(u)) {
        adjList[u] = []
    }
    if (!adjList.has(v)) {
        adjList[v] = []
    }
    adjList[u].push(v)
    adjList[v].push(u)
}

func bfs(startNode) {
    print("Starting BFS from node:", startNode)
    visited = {}
    queue = [startNode]
    visited[startNode] = 1

    while (queue.size() > 0) {
        currentNode = queue[0]
        // Manual dequeue
        newQueue = []
        idx = 1
        while (idx < queue.size()) {
            newQueue.push(queue[idx])
            idx = idx + 1
        }
        queue = newQueue

        print("Visited:", currentNode)

        if (adjList.has(currentNode)) {
            neighbors = adjList[currentNode]
            nIdx = 0
            while (nIdx < neighbors.size()) {
                neighbor = neighbors[nIdx]
                if (!visited.has(neighbor)) {
                    visited[neighbor] = 1
                    queue.push(neighbor)
                }
                nIdx = nIdx + 1
            }
        }
    }
}

func dfsIterative(startNode) {
    print("Starting Iterative DFS from node:", startNode)
    visited = {}
    stack = [startNode]

    while (stack.size() > 0) {
        currentNode = stack.pop()

        if (!visited.has(currentNode)) {
            print("Visited:", currentNode)
            visited[currentNode] = 1

            if (adjList.has(currentNode)) {
                neighbors = adjList[currentNode]
                nIdx = 0
                while (nIdx < neighbors.size()) {
                    neighbor = neighbors[nIdx]
                    if (!visited.has(neighbor)) {
                        stack.push(neighbor)
                    }
                    nIdx = nIdx + 1
                }
            }
        }
    }
}

// Main Execution
print("=== Nevaarize Graph Algorithms Demo ===")

// Using integer node IDs: 0=A, 1=B, 2=C, 3=D, 4=E, 5=F
addEdge(0, 1)
addEdge(0, 2)
addEdge(1, 3)
addEdge(2, 4)
addEdge(3, 4)
addEdge(4, 5)

start = t.millis()
bfs(0)
print("BFS completed in:", t.millis() - start, "ms")

print("")

start = t.millis()
dfsIterative(0)
print("DFS completed in:", t.millis() - start, "ms")

print("Graph algorithms demonstration finished.")
