import stdlib time as t

// Graph Algorithms in Nevaarize
// Demonstrates adjacency matrix representation and traversal

// Using adjacency matrix (flat 1D array) for JIT compatibility
// Nodes: 0..5 (6 nodes: A=0, B=1, C=2, D=3, E=4, F=5)
numNodes = 6

// Create adjacency matrix (flat: matrix[i*numNodes + j])
matrix = []
total = numNodes * numNodes
idx = 0
while (idx < total) {
    matrix.push(0)
    idx = idx + 1
}

// Helper: set edge (undirected)
// matrix[u*numNodes + v] = 1, matrix[v*numNodes + u] = 1
// Edges: A-B, A-C, B-D, C-E, D-E, E-F
matrix[0 * 6 + 1] = 1
matrix[1 * 6 + 0] = 1
matrix[0 * 6 + 2] = 1
matrix[2 * 6 + 0] = 1
matrix[1 * 6 + 3] = 1
matrix[3 * 6 + 1] = 1
matrix[2 * 6 + 4] = 1
matrix[4 * 6 + 2] = 1
matrix[3 * 6 + 4] = 1
matrix[4 * 6 + 3] = 1
matrix[4 * 6 + 5] = 1
matrix[5 * 6 + 4] = 1

// BFS using queue
print("=== Nevaarize Graph Algorithms Demo ===")
print("Starting BFS from node 0 (A):")

visited = []
i = 0
while (i < numNodes) {
    visited.push(0)
    i = i + 1
}

queue = [0]
visited[0] = 1

while (queue.size() > 0) {
    current = queue[0]
    // Manual dequeue
    newQueue = []
    qi = 1
    while (qi < queue.size()) {
        newQueue.push(queue[qi])
        qi = qi + 1
    }
    queue = newQueue

    print("Visited:", current)

    // Check all neighbors
    neighbor = 0
    while (neighbor < numNodes) {
        if (matrix[current * numNodes + neighbor] == 1 and visited[neighbor] == 0) {
            visited[neighbor] = 1
            queue.push(neighbor)
        }
        neighbor = neighbor + 1
    }
}

// DFS using stack
print("\nStarting DFS from node 0 (A):")
dfsVisited = []
i = 0
while (i < numNodes) {
    dfsVisited.push(0)
    i = i + 1
}

stack = [0]

while (stack.size() > 0) {
    current = stack.pop()

    if (dfsVisited[current] == 0) {
        print("Visited:", current)
        dfsVisited[current] = 1

        neighbor = numNodes - 1
        while (neighbor >= 0) {
            if (matrix[current * numNodes + neighbor] == 1 and dfsVisited[neighbor] == 0) {
                stack.push(neighbor)
            }
            neighbor = neighbor - 1
        }
    }
}

print("Graph algorithms demonstration finished.")
