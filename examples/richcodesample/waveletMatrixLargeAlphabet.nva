import stdlib time as t

// Wavelet Matrix Data Structure for Large Alphabet Sequences
// Technical characteristics:
// - Compact representation over L bit levels without explicit tree pointer structures
// - Native support for large alphabets (arbitrary 30-bit non-negative integers up to 10^9)
// - Prefix-sum bitvectors at each level for O(1) rank0 and rank1 evaluations
// - Range Quantile (K-th smallest in arbitrary subarray [l, r]) in O(L) time
// - Range Count Less (elements < upperVal in [l, r]) in O(L) time
// - Range Frequency and Interval Counting in O(L) time
// - Select queries (original index of k-th occurrence of value) via bottom-up mapping in O(L log N)
// - Fully sorted bottom-layer array enabling exact occurrence localization
// - High-order deterministic stress validation against brute-force array oracles
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)

print("=== Nevaarize Wavelet Matrix Large Alphabet Suite ===")
suiteStartTime = t.millis()

func minInt(aInt, bInt) {
    if (aInt < bInt) {
        return aInt
    }
    return bInt
}

func maxInt(aInt, bInt) {
    if (aInt > bInt) {
        return aInt
    }
    return bInt
}

func makeIntArray(arrSize, fillVal) {
    arr = []
    arrIdx = 0
    while (arrIdx < arrSize) {
        arr.push(fillVal)
        arrIdx = arrIdx + 1
    }
    return arr
}

func computeBitWidth(maxVal) {
    bits = 1
    temp = 1
    while (temp <= maxVal and bits < 31) {
        temp = temp * 2
        bits = bits + 1
    }
    return bits
}

func buildWaveletMatrix(sourceArr) {
    arrSize = sourceArr.size()
    maxVal = 0
    i = 0
    while (i < arrSize) {
        if (sourceArr[i] > maxVal) {
            maxVal = sourceArr[i]
        }
        i = i + 1
    }

    levels = computeBitWidth(maxVal)
    if (levels < 1) {
        levels = 1
    }

    prefArr = []
    zCountArr = []

    curArr = []
    i = 0
    while (i < arrSize) {
        curArr.push(sourceArr[i])
        i = i + 1
    }

    lvl = levels - 1
    while (lvl >= 0) {
        pref = [0]
        nextZeros = []
        nextOnes = []
        zCount = 0

        idx = 0
        while (idx < arrSize) {
            val = curArr[idx]
            bit = (val >> lvl) & 1
            if (bit == 0) {
                nextZeros.push(val)
                zCount = zCount + 1
            } else {
                nextOnes.push(val)
            }
            pref.push(zCount)
            idx = idx + 1
        }

        prefArr.push(pref)
        zCountArr.push(zCount)

        nextArr = []
        zIdx = 0
        while (zIdx < nextZeros.size()) {
            nextArr.push(nextZeros[zIdx])
            zIdx = zIdx + 1
        }
        oIdx = 0
        while (oIdx < nextOnes.size()) {
            nextArr.push(nextOnes[oIdx])
            oIdx = oIdx + 1
        }

        curArr = nextArr
        lvl = lvl - 1
    }

    // Since levels are built from (levels - 1) down to 0,
    // prefArr[k] corresponds to level (levels - 1 - k).
    // To index easily by level number, reverse prefArr and zCountArr:
    revPref = []
    revZCount = []
    k = levels - 1
    while (k >= 0) {
        revPref.push(prefArr[k])
        revZCount.push(zCountArr[k])
        k = k - 1
    }

    // bottomArr is curArr after level 0, which is fully sorted
    bottomArr = curArr
    return [arrSize, levels, revPref, revZCount, bottomArr]
}

func rangeQuantile(wm, l, r, k) {
    levels = wm[1]
    prefArr = wm[2]
    zCountArr = wm[3]

    res = 0
    curL = l
    curR = r
    curK = k

    lvl = levels - 1
    while (lvl >= 0) {
        pref = prefArr[lvl]
        zCount = zCountArr[lvl]

        zBeforeL = pref[curL]
        zBeforeR1 = pref[curR + 1]
        zerosInRange = zBeforeR1 - zBeforeL

        if (curK <= zerosInRange) {
            curL = zBeforeL
            curR = zBeforeR1 - 1
        } else {
            res = res + (1 << lvl)
            curK = curK - zerosInRange
            onesBeforeL = curL - zBeforeL
            onesBeforeR1 = (curR + 1) - zBeforeR1
            curL = zCount + onesBeforeL
            curR = zCount + onesBeforeR1 - 1
        }
        lvl = lvl - 1
    }
    return res
}

func rangeCountLess(wm, l, r, upperVal) {
    if (l > r) {
        return 0
    }
    levels = wm[1]
    prefArr = wm[2]
    zCountArr = wm[3]

    countLess = 0
    curL = l
    curR = r

    lvl = levels - 1
    while (lvl >= 0 and curL <= curR) {
        pref = prefArr[lvl]
        zCount = zCountArr[lvl]

        bit = (upperVal >> lvl) & 1
        zBeforeL = pref[curL]
        zBeforeR1 = pref[curR + 1]
        zerosInRange = zBeforeR1 - zBeforeL

        if (bit == 1) {
            countLess = countLess + zerosInRange
            onesBeforeL = curL - zBeforeL
            onesBeforeR1 = (curR + 1) - zBeforeR1
            curL = zCount + onesBeforeL
            curR = zCount + onesBeforeR1 - 1
        } else {
            curL = zBeforeL
            curR = zBeforeR1 - 1
        }
        lvl = lvl - 1
    }
    return countLess
}

func rangeFrequency(wm, l, r, targetVal) {
    if (l > r) {
        return 0
    }
    cLessUpper = rangeCountLess(wm, l, r, targetVal + 1)
    cLessTarget = rangeCountLess(wm, l, r, targetVal)
    return cLessUpper - cLessTarget
}

func rangeCountInterval(wm, l, r, lowVal, highVal) {
    if (l > r or lowVal > highVal) {
        return 0
    }
    cLessHigh = rangeCountLess(wm, l, r, highVal + 1)
    cLessLow = rangeCountLess(wm, l, r, lowVal)
    return cLessHigh - cLessLow
}

func selectZero(pref, n, count) {
    low = 0
    high = n - 1
    ans = -1
    while (low <= high) {
        mid = (low + high) / 2
        z = pref[mid + 1]
        if (z >= count) {
            ans = mid
            high = mid - 1
        } else {
            low = mid + 1
        }
    }
    return ans
}

func selectOne(pref, n, count) {
    low = 0
    high = n - 1
    ans = -1
    while (low <= high) {
        mid = (low + high) / 2
        ones = (mid + 1) - pref[mid + 1]
        if (ones >= count) {
            ans = mid
            high = mid - 1
        } else {
            low = mid + 1
        }
    }
    return ans
}

func selectKth(wm, targetVal, k) {
    n = wm[0]
    levels = wm[1]
    prefArr = wm[2]
    zCountArr = wm[3]

    bRange = getBottomRange(wm, targetVal)
    firstIdx = bRange[0]
    lastIdx = bRange[1]
    totalOcc = lastIdx - firstIdx + 1

    if (firstIdx > lastIdx or k < 1 or k > totalOcc) {
        return -1
    }

    curPos = firstIdx + k - 1

    lvl = 0
    while (lvl < levels) {
        pref = prefArr[lvl]
        zCount = zCountArr[lvl]
        bit = (targetVal >> lvl) & 1

        if (bit == 0) {
            curPos = selectZero(pref, n, curPos + 1)
        } else {
            curPos = selectOne(pref, n, curPos - zCount + 1)
        }
        lvl = lvl + 1
    }
    return curPos
}

func getBottomRange(wm, val) {
    n = wm[0]
    levels = wm[1]
    prefArr = wm[2]
    zCountArr = wm[3]

    curL = 0
    curR = n - 1

    lvl = levels - 1
    while (lvl >= 0 and curL <= curR) {
        pref = prefArr[lvl]
        zCount = zCountArr[lvl]

        bit = (val >> lvl) & 1
        zBeforeL = pref[curL]
        zBeforeR1 = pref[curR + 1]

        if (bit == 0) {
            curL = zBeforeL
            curR = zBeforeR1 - 1
        } else {
            onesBeforeL = curL - zBeforeL
            onesBeforeR1 = (curR + 1) - zBeforeR1
            curL = zCount + onesBeforeL
            curR = zCount + onesBeforeR1 - 1
        }
        lvl = lvl - 1
    }
    return [curL, curR]
}

// -----------------------------------------------------------------------------
// Test Case 1: Bitvector Construction, Level Partitioning & Range Quantile
// -----------------------------------------------------------------------------
print("Running Test Case 1: Construction, Level Partitioning and Range Quantile Invariants...")

// Large alphabet dataset with values up to ~990,000,000 and non-trivial scale
tc1Data = [1500000, 420000, 990000000, 1500000, 75000, 31415926, 420000, 888888888, 12, 5000000]
tc1Wm = buildWaveletMatrix(tc1Data)

tc1N = tc1Wm[0]
tc1Levels = tc1Wm[1]
tc1Bottom = tc1Wm[4]

// Assertions on structural dimensions
if (tc1N != 10 or tc1Levels <= 20) {
    print("[FAIL] Wavelet matrix dimensional parameters invalid: N=", tc1N, ", levels=", tc1Levels)
} else {
    print("  Wavelet matrix construction verified: N=10, alphabet bit levels=", tc1Levels)
}

// Verify that identical values map to contiguous intervals in bottom layer
range420k = getBottomRange(tc1Wm, 420000)
range1500k = getBottomRange(tc1Wm, 1500000)
range12 = getBottomRange(tc1Wm, 12)

bottomClusterValid = 1
if (range420k[1] - range420k[0] + 1 != 2) { bottomClusterValid = 0 }
if (tc1Bottom[range420k[0]] != 420000 or tc1Bottom[range420k[1]] != 420000) { bottomClusterValid = 0 }
if (range1500k[1] - range1500k[0] + 1 != 2) { bottomClusterValid = 0 }
if (tc1Bottom[range1500k[0]] != 1500000 or tc1Bottom[range1500k[1]] != 1500000) { bottomClusterValid = 0 }
if (range12[1] - range12[0] + 1 != 1) { bottomClusterValid = 0 }
if (tc1Bottom[range12[0]] != 12) { bottomClusterValid = 0 }

if (bottomClusterValid != 1) {
    print("[FAIL] Wavelet matrix bottom layer contiguous clustering violated")
} else {
    print("  Bottom layer contiguous clustering verified for identical values across alphabet")
}

// Quantile tests on full range [0, 9]
// Expected sorted elements:
// [12, 75000, 420000, 420000, 1500000, 1500000, 5000000, 31415926, 888888888, 990000000]
q1 = rangeQuantile(tc1Wm, 0, 9, 1)   // 1st smallest = 12
q2 = rangeQuantile(tc1Wm, 0, 9, 2)   // 2nd smallest = 75000
q3 = rangeQuantile(tc1Wm, 0, 9, 3)   // 3rd smallest = 420000
q4 = rangeQuantile(tc1Wm, 0, 9, 4)   // 4th smallest = 420000
q5 = rangeQuantile(tc1Wm, 0, 9, 5)   // 5th smallest = 1500000
q6 = rangeQuantile(tc1Wm, 0, 9, 6)   // 6th smallest = 1500000
q7 = rangeQuantile(tc1Wm, 0, 9, 7)   // 7th smallest = 5000000
q8 = rangeQuantile(tc1Wm, 0, 9, 8)   // 8th smallest = 31415926
q9 = rangeQuantile(tc1Wm, 0, 9, 9)   // 9th smallest = 888888888
q10 = rangeQuantile(tc1Wm, 0, 9, 10) // 10th smallest = 990000000

tc1QuantileFail = 0
if (q1 != 12 or q2 != 75000 or q3 != 420000 or q4 != 420000 or q5 != 1500000) { tc1QuantileFail = 1 }
if (q6 != 1500000 or q7 != 5000000 or q8 != 31415926 or q9 != 888888888 or q10 != 990000000) { tc1QuantileFail = 1 }

if (tc1QuantileFail != 0) {
    print("[FAIL] Full-range quantile assertions failed")
} else {
    print("  Full-range quantile queries (k=1..10) verified: min=12, max=990000000, duplicates preserved")
}

// Subarray quantile tests:
// Range [1, 5]: [420000, 990000000, 1500000, 75000, 31415926]
// Sorted subrange: [75000, 420000, 1500000, 31415926, 990000000]
subQ1 = rangeQuantile(tc1Wm, 1, 5, 1) // 75000
subQ2 = rangeQuantile(tc1Wm, 1, 5, 2) // 420000
subQ3 = rangeQuantile(tc1Wm, 1, 5, 3) // 1500000
subQ4 = rangeQuantile(tc1Wm, 1, 5, 4) // 31415926
subQ5 = rangeQuantile(tc1Wm, 1, 5, 5) // 990000000

// Range [6, 8]: [420000, 888888888, 12] -> sorted: [12, 420000, 888888888]
subQ68Min = rangeQuantile(tc1Wm, 6, 8, 1) // 12
subQ68Mid = rangeQuantile(tc1Wm, 6, 8, 2) // 420000
subQ68Max = rangeQuantile(tc1Wm, 6, 8, 3) // 888888888

tc1SubFail = 0
if (subQ1 != 75000 or subQ2 != 420000 or subQ3 != 1500000 or subQ4 != 31415926 or subQ5 != 990000000) { tc1SubFail = 1 }
if (subQ68Min != 12 or subQ68Mid != 420000 or subQ68Max != 888888888) { tc1SubFail = 1 }

if (tc1SubFail != 0) {
    print("[FAIL] Subarray quantile queries failed")
} else {
    print("  Subarray quantile queries verified: range(1..5) median=1500000, range(6..8) median=420000")
    print("  Test Case 1 Passed construction, level partitioning, and quantile invariants")
}

// -----------------------------------------------------------------------------
// Test Case 2: Range Rank, Range Frequency & Range Interval Counting
// -----------------------------------------------------------------------------
print("Running Test Case 2: Range Rank, Range Frequency and Interval Counting...")

// Frequency queries:
// tc1Data = [1500000, 420000, 990000000, 1500000, 75000, 31415926, 420000, 888888888, 12, 5000000]
freq420kTotal = rangeFrequency(tc1Wm, 0, 9, 420000)
freq420kPrefix = rangeFrequency(tc1Wm, 0, 4, 420000)
freq420kMid = rangeFrequency(tc1Wm, 2, 5, 420000)
freq1500kTotal = rangeFrequency(tc1Wm, 0, 9, 1500000)
freq1500kMid = rangeFrequency(tc1Wm, 1, 2, 1500000)
freqNonExistent = rangeFrequency(tc1Wm, 0, 9, 999)

tc2FreqFail = 0
if (freq420kTotal != 2 or freq420kPrefix != 1 or freq420kMid != 0) { tc2FreqFail = 1 }
if (freq1500kTotal != 2 or freq1500kMid != 0 or freqNonExistent != 0) { tc2FreqFail = 1 }

if (tc2FreqFail != 0) {
    print("[FAIL] Range frequency queries failed")
} else {
    print("  Range frequency verified: val 420000 occurs twice in total, once in [0,4], zero in [2,5]")
}

// Count Less queries:
// Elements < 500000 in [0, 9]: [420000, 75000, 420000, 12] -> 4 elements
countLess500k = rangeCountLess(tc1Wm, 0, 9, 500000)
countLess12 = rangeCountLess(tc1Wm, 0, 9, 12)
countLess13 = rangeCountLess(tc1Wm, 0, 9, 13)
countLessBillion = rangeCountLess(tc1Wm, 0, 9, 1000000000)

tc2CountLessFail = 0
if (countLess500k != 4 or countLess12 != 0 or countLess13 != 1 or countLessBillion != 10) { tc2CountLessFail = 1 }

if (tc2CountLessFail != 0) {
    print("[FAIL] Range count less queries failed: countLess500k=", countLess500k, ", countLess13=", countLess13)
} else {
    print("  Range count less verified: 4 elements < 500000, 0 elements < 12, 1 element < 13")
}

// Range Interval Counting:
// [100000, 2000000]: [1500000, 420000, 1500000, 420000] -> 4 elements
// [1, 100]: [12] -> 1 element
// [50000000, 1000000000]: [990000000, 888888888] -> 2 elements
int1 = rangeCountInterval(tc1Wm, 0, 9, 100000, 2000000)
int2 = rangeCountInterval(tc1Wm, 0, 9, 1, 100)
int3 = rangeCountInterval(tc1Wm, 0, 9, 50000000, 1000000000)
intEmpty = rangeCountInterval(tc1Wm, 0, 9, 2000000, 100000)

tc2IntFail = 0
if (int1 != 4 or int2 != 1 or int3 != 2 or intEmpty != 0) { tc2IntFail = 1 }

if (tc2IntFail != 0) {
    print("[FAIL] Range interval counting queries failed: int1=", int1, ", int2=", int2, ", int3=", int3)
} else {
    print("  Range interval counting verified: [100k..2M] count=4, [1..100] count=1, [50M..1B] count=2")
    print("  Test Case 2 Passed range frequency and interval counting verification")
}

// -----------------------------------------------------------------------------
// Test Case 3: Select Queries & Bidirectional Index Mapping
// -----------------------------------------------------------------------------
print("Running Test Case 3: Select Queries and Bidirectional Index Mapping...")

// Exact position lookups via selectKth
sel12 = selectKth(tc1Wm, 12, 1)          // index 8
sel420k1 = selectKth(tc1Wm, 420000, 1)   // index 1
sel420k2 = selectKth(tc1Wm, 420000, 2)   // index 6
sel420k3 = selectKth(tc1Wm, 420000, 3)   // not found -> -1
sel1500k1 = selectKth(tc1Wm, 1500000, 1) // index 0
sel1500k2 = selectKth(tc1Wm, 1500000, 2) // index 3
sel990M = selectKth(tc1Wm, 990000000, 1) // index 2
sel888M = selectKth(tc1Wm, 888888888, 1) // index 7
sel31M = selectKth(tc1Wm, 31415926, 1)   // index 5
sel75k = selectKth(tc1Wm, 75000, 1)      // index 4
sel5M = selectKth(tc1Wm, 5000000, 1)     // index 9
selNone = selectKth(tc1Wm, 999999, 1)    // not found -> -1

tc3SelectFail = 0
if (sel12 != 8 or sel420k1 != 1 or sel420k2 != 6 or sel420k3 != -1) { tc3SelectFail = 1 }
if (sel1500k1 != 0 or sel1500k2 != 3 or sel990M != 2 or sel888M != 7) { tc3SelectFail = 1 }
if (sel31M != 5 or sel75k != 4 or sel5M != 9 or selNone != -1) { tc3SelectFail = 1 }

if (tc3SelectFail != 0) {
    print("[FAIL] Select query assertions failed")
} else {
    print("  Select queries verified: select(420k, 1)=1, select(420k, 2)=6, select(12, 1)=8, select(none)=-1")
}

// Bidirectional consistency check: select(v, freq(0, i, v)) == i for all i
biFail = 0
chkIdx = 0
while (chkIdx < tc1Data.size()) {
    targetV = tc1Data[chkIdx]
    prefixOcc = rangeFrequency(tc1Wm, 0, chkIdx, targetV)
    resolvedIdx = selectKth(tc1Wm, targetV, prefixOcc)
    if (resolvedIdx != chkIdx) {
        biFail = 1
    }
    chkIdx = chkIdx + 1
}

if (biFail != 0) {
    print("[FAIL] Bidirectional index mapping consistency failed")
} else {
    print("  Bidirectional bijection verified across all indices: select(v, rank(v)) identity holds")
    print("  Test Case 3 Passed select queries and bidirectional index mapping")
}

