// Data Structures Demonstration in Nevaarize
// Demonstrates array-based stacks and queues with inline operations

// Stack Demo (inline, no pass-by-ref issues)
print("=== Data Structures Demo ===")

print("--- Stack Demo ---")
stack = []
stack.push(100)
stack.push(200)
stack.push(300)
print("Stack size:", stack.size())
print("Pop:", stack.pop())
print("Pop:", stack.pop())
print("Pop:", stack.pop())
print("Stack size after pops:", stack.size())

// Queue Demo (inline)
print("--- Queue Demo ---")
queue = []
queue.push(10)
queue.push(20)
queue.push(30)
print("Queue size:", queue.size())
// Dequeue: get first, then shift manually
first = queue[0]
print("Dequeue:", first)

// Priority Queue via sorted insert (inline)
print("--- Priority Queue Demo ---")
pq = [50, 10, 30, 20, 40]
print("Before sort:", pq[0], pq[1], pq[2], pq[3], pq[4])

// Bubble sort inline
n = pq.size()
i = 0
while (i < n) {
    j = 0
    while (j < n - 1 - i) {
        if (pq[j] > pq[j + 1]) {
            temp = pq[j]
            pq[j] = pq[j + 1]
            pq[j + 1] = temp
        }
        j = j + 1
    }
    i = i + 1
}

print("Sorted priority queue:")
i = 0
while (i < pq.size()) {
    print("  Priority", i, ":", pq[i])
    i = i + 1
}

// Map as dictionary demo
print("--- Map Demo ---")
dict = {}
dict["apple"] = 3
dict["banana"] = 5
dict["cherry"] = 2

print("Apple count:", dict["apple"])
print("Has banana:", dict.has("banana"))
print("Has grape:", dict.has("grape"))

keys = dict.keys()
print("Number of keys:", keys.size())

print("Data structures demo finished.")
