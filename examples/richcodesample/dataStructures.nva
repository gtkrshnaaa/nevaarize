// Data Structures Implementation in Nevaarize
// Demonstrates array-based stacks and queues

// 1. Stack (LIFO) - Array-based
func createStack() {
    return []
}

func stackPush(stack, item) {
    stack.push(item)
}

func stackPop(stack) {
    if (stack.size() == 0) {
        print("Stack underflow!")
        return -1
    }
    return stack.pop()
}

func stackPeek(stack) {
    if (stack.size() == 0) {
        return -1
    }
    return stack[stack.size() - 1]
}

// 2. Queue (FIFO) - Array-based with index tracking
func createQueue() {
    return []
}

func enqueue(queue, item) {
    queue.push(item)
}

func dequeue(queue) {
    if (queue.size() == 0) {
        print("Queue underflow!")
        return -1
    }
    first = queue[0]
    newQueue = []
    i = 1
    while (i < queue.size()) {
        newQueue.push(queue[i])
        i = i + 1
    }
    // Copy back
    return first
}

// Main Demo
print("=== Data Structures Demo ===")

print("--- Stack Demo ---")
s = createStack()
stackPush(s, 100)
stackPush(s, 200)
stackPush(s, 300)
print("Stack size:", s.size())
print("Pop:", stackPop(s))
print("Pop:", stackPop(s))
print("Pop:", stackPop(s))
print("Stack size after pops:", s.size())

print("--- Queue Demo ---")
q = createQueue()
enqueue(q, 10)
enqueue(q, 20)
enqueue(q, 30)
print("Queue size:", q.size())
print("Dequeue:", dequeue(q))
print("Dequeue:", dequeue(q))

// 3. Priority via sorting simulation
print("--- Priority Queue Demo (via sorted insert) ---")
pq = []
pq.push(50)
pq.push(10)
pq.push(30)
pq.push(20)
pq.push(40)

// Simple selection sort to demonstrate
n = pq.size()
i = 0
while (i < n) {
    minIdx = i
    j = i + 1
    while (j < n) {
        if (pq[j] < pq[minIdx]) {
            minIdx = j
        }
        j = j + 1
    }
    if (minIdx != i) {
        temp = pq[i]
        pq[i] = pq[minIdx]
        pq[minIdx] = temp
    }
    i = i + 1
}

print("Sorted priority queue:")
i = 0
while (i < pq.size()) {
    print("  Priority", i, ":", pq[i])
    i = i + 1
}

print("Data structures demo finished.")
