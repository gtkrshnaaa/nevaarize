import stdlib time as t

// 3D KD-Tree Suite
// Technical characteristics:
// - Spatial 3D partitioning with cycling orthogonal coordinate planes (X, Y, Z)
// - Bounding box hierarchical pruning for orthogonal range box queries
// - Branch-and-bound pruning for 3D Nearest Neighbor Search (NNS)
// - O(log N) average time complexity, O(N) space complexity
// - 100% iterative BFS/bottom-up builder and non-recursive stack traversals
// - Deterministic assertions and randomized stress simulations vs brute force oracle
// - Zero AI artifacts, zero emojis, zero em dashes
// - Strict camelCase naming conventions without underscores

print("=== Nevaarize 3D KD-Tree Suite ===")
suiteStartTime = t.millis()

func sortPointsSliceByAxis(pts, st, en, axis) {
    sI = st + 1
    while (sI < en) {
        sKey = pts[sI]
        sJ = sI - 1
        while (sJ >= st and pts[sJ][axis] > sKey[axis]) {
            pts[sJ + 1] = pts[sJ]
            sJ = sJ - 1
        }
        pts[sJ + 1] = sKey
        sI = sI + 1
    }
    return pts
}

func createKDTree3D(inputPoints) {
    kdCount = len(inputPoints)
    if (kdCount == 0) {
        return [[], -1]
    }

    // Working copy of points
    workPts = []
    cpI = 0
    while (cpI < kdCount) {
        workPts.push(inputPoints[cpI])
        cpI = cpI + 1
    }

    // Arena node layout:
    // 0: point [x, y, z, id]
    // 1: splitAxis (0=X, 1=Y, 2=Z)
    // 2: leftChildIdx (-1 if null)
    // 3: rightChildIdx (-1 if null)
    // 4..9: bounding box [minX, maxX, minY, maxY, minZ, maxZ]
    kdArena = []

    // Build stack: [parentIdx, childSlot (2 or 3), startIdx, endIdx, depth]
    bStack = [[-1, -1, 0, kdCount, 0]]

    while (len(bStack) > 0) {
        bFrame = bStack.pop()
        parIdx = bFrame[0]
        cSlot = bFrame[1]
        stIdx = bFrame[2]
        enIdx = bFrame[3]
        depth = bFrame[4]

        if (stIdx < enIdx) {
            axis = depth % 3
            sortPointsSliceByAxis(workPts, stIdx, enIdx, axis)

            midIdx = stIdx + (enIdx - stIdx) / 2
            medPt = workPts[midIdx]

            uIdx = len(kdArena)
            // Initial bounding box is the point itself
            pX = medPt[0]
            pY = medPt[1]
            pZ = medPt[2]
            kdArena.push([medPt, axis, -1, -1, pX, pX, pY, pY, pZ, pZ])

            if (parIdx != -1) {
                kdArena[parIdx][cSlot] = uIdx
            }

            // Push right child then left child
            bStack.push([uIdx, 3, midIdx + 1, enIdx, depth + 1])
            bStack.push([uIdx, 2, stIdx, midIdx, depth + 1])
        }
    }

    // Bottom-up synthesis of bounding boxes
    buIdx = len(kdArena) - 1
    while (buIdx >= 0) {
        lChild = kdArena[buIdx][2]
        rChild = kdArena[buIdx][3]

        if (lChild != -1) {
            lBox = kdArena[lChild]
            if (lBox[4] < kdArena[buIdx][4]) { kdArena[buIdx][4] = lBox[4] }
            if (lBox[5] > kdArena[buIdx][5]) { kdArena[buIdx][5] = lBox[5] }
            if (lBox[6] < kdArena[buIdx][6]) { kdArena[buIdx][6] = lBox[6] }
            if (lBox[7] > kdArena[buIdx][7]) { kdArena[buIdx][7] = lBox[7] }
            if (lBox[8] < kdArena[buIdx][8]) { kdArena[buIdx][8] = lBox[8] }
            if (lBox[9] > kdArena[buIdx][9]) { kdArena[buIdx][9] = lBox[9] }
        }

        if (rChild != -1) {
            rBox = kdArena[rChild]
            if (rBox[4] < kdArena[buIdx][4]) { kdArena[buIdx][4] = rBox[4] }
            if (rBox[5] > kdArena[buIdx][5]) { kdArena[buIdx][5] = rBox[5] }
            if (rBox[6] < kdArena[buIdx][6]) { kdArena[buIdx][6] = rBox[6] }
            if (rBox[7] > kdArena[buIdx][7]) { kdArena[buIdx][7] = rBox[7] }
            if (rBox[8] < kdArena[buIdx][8]) { kdArena[buIdx][8] = rBox[8] }
            if (rBox[9] > kdArena[buIdx][9]) { kdArena[buIdx][9] = rBox[9] }
        }

        buIdx = buIdx - 1
    }

    return [kdArena, 0]
}

func kdQueryBox3D(tree, qx1, qx2, qy1, qy2, qz1, qz2) {
    qArena = tree[0]
    qRoot = tree[1]
    if (qRoot == -1 or qx1 > qx2 or qy1 > qy2 or qz1 > qz2) {
        return []
    }

    boxResults = []
    queryStack = [qRoot]

    while (len(queryStack) > 0) {
        currU = queryStack.pop()
        currNode = qArena[currU]

        bbMinX = currNode[4]
        bbMaxX = currNode[5]
        bbMinY = currNode[6]
        bbMaxY = currNode[7]
        bbMinZ = currNode[8]
        bbMaxZ = currNode[9]

        // Check bounding box intersection with query box
        if (bbMinX > qx2 or bbMaxX < qx1 or bbMinY > qy2 or bbMaxY < qy1 or bbMinZ > qz2 or bbMaxZ < qz1) {
            // Disjoint: prune subtree
        } else {
            currPt = currNode[0]
            ptX = currPt[0]
            ptY = currPt[1]
            ptZ = currPt[2]

            if (qx1 <= ptX and ptX <= qx2 and qy1 <= ptY and ptY <= qy2 and qz1 <= ptZ and ptZ <= qz2) {
                boxResults.push(currPt)
            }

            rChild = currNode[3]
            lChild = currNode[2]

            if (rChild != -1) {
                queryStack.push(rChild)
            }
            if (lChild != -1) {
                queryStack.push(lChild)
            }
        }
    }

    return boxResults
}

func kdNearestNeighbor3D(tree, targetX, targetY, targetZ) {
    nnsArena = tree[0]
    nnsRoot = tree[1]
    if (nnsRoot == -1) {
        return [[], -1]
    }

    bestPoint = nnsArena[nnsRoot][0]
    dx = bestPoint[0] - targetX
    dy = bestPoint[1] - targetY
    dz = bestPoint[2] - targetZ
    bestDistSq = dx * dx + dy * dy + dz * dz

    nnsStack = [nnsRoot]

    while (len(nnsStack) > 0) {
        currNodeIdx = nnsStack.pop()
        currNode = nnsArena[currNodeIdx]
        candPt = currNode[0]

        candDx = candPt[0] - targetX
        candDy = candPt[1] - targetY
        candDz = candPt[2] - targetZ
        candDistSq = candDx * candDx + candDy * candDy + candDz * candDz

        if (candDistSq < bestDistSq) {
            bestDistSq = candDistSq
            bestPoint = candPt
        }

        splitAxis = currNode[1]
        targetCoord = targetX
        candCoord = candPt[0]
        if (splitAxis == 1) {
            targetCoord = targetY
            candCoord = candPt[1]
        }
        if (splitAxis == 2) {
            targetCoord = targetZ
            candCoord = candPt[2]
        }

        axisDiff = targetCoord - candCoord
        axisDiffSq = axisDiff * axisDiff

        nearBranch = currNode[2]
        farBranch = currNode[3]
        if (axisDiff > 0) {
            nearBranch = currNode[3]
            farBranch = currNode[2]
        }

        if (farBranch != -1 and axisDiffSq < bestDistSq) {
            nnsStack.push(farBranch)
        }
        if (nearBranch != -1) {
            nnsStack.push(nearBranch)
        }
    }

    return [bestPoint, bestDistSq]
}

// -----------------------------------------------------------------------------
// Test Case 1: Deterministic 3D Point Cloud Assertions
// -----------------------------------------------------------------------------
print("Running Test Case 1: Deterministic 3D Point Cloud Assertions...")
tc1Pass = 1

// 12 points: [x, y, z, id]
samplePoints3D = [
    [10, 20, 30, 1],
    [15, 25, 35, 2],
    [5, 80, 10, 3],
    [20, 15, 90, 4],
    [50, 50, 50, 5],
    [70, 10, 40, 6],
    [85, 95, 15, 7],
    [30, 40, 60, 8],
    [90, 20, 80, 9],
    [45, 65, 25, 10],
    [60, 85, 75, 11],
    [12, 18, 22, 12]
]

kd1 = createKDTree3D(samplePoints3D)

// Query 1: Full box covering [0, 100] in all 3 dimensions
fullBox = kdQueryBox3D(kd1, 0, 100, 0, 100, 0, 100)
if (len(fullBox) != 12) {
    tc1Pass = 0
}

// Query 2: Bounded box [10, 50] x [15, 55] x [20, 65]
// Expected points:
// - [10, 20, 30, 1]
// - [15, 25, 35, 2]
// - [50, 50, 50, 5]
// - [30, 40, 60, 8]
// - [12, 18, 22, 12]
// Total 5 points
subBox = kdQueryBox3D(kd1, 10, 50, 15, 55, 20, 65)
if (len(subBox) != 5) {
    tc1Pass = 0
}

// Query 3: Disjoint box [95, 100] x [0, 10] x [0, 10]
disjointBox = kdQueryBox3D(kd1, 95, 100, 0, 10, 0, 10)
if (len(disjointBox) != 0) {
    tc1Pass = 0
}

// Query 4: Exact single point hit [50, 50, 50]
exactBox = kdQueryBox3D(kd1, 50, 50, 50, 50, 50, 50)
if (len(exactBox) != 1 or exactBox[0][3] != 5) {
    tc1Pass = 0
}

// NNS Query 1: Exact coordinates of point 5 -> distance 0
nnsExact = kdNearestNeighbor3D(kd1, 50, 50, 50)
if (nnsExact[1] != 0 or nnsExact[0][3] != 5) {
    tc1Pass = 0
}

// NNS Query 2: Target (11, 19, 21) -> closest to point 12 (12, 18, 22)
// distSq = (12-11)^2 + (18-19)^2 + (22-21)^2 = 1 + 1 + 1 = 3
nnsClose = kdNearestNeighbor3D(kd1, 11, 19, 21)
if (nnsClose[0][3] != 12 or nnsClose[1] != 3) {
    tc1Pass = 0
}

if (tc1Pass == 1) {
    print("  12-point 3D KD-Tree constructed deterministically")
    print("  Full box, sub-box, disjoint, and exact box hits verified")
    print("  Nearest neighbor exact and proximity searches confirmed")
    print("  Test Case 1 Passed successfully")
} else {
    print("[FAIL] Test Case 1 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 2: Degenerate Orthogonal Axis Points and Planar Surfaces
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 2: Degenerate Axis Topologies and Planar Surfaces...")
tc2Pass = 1

planarPoints = [
    [0, 0, 0, 101],
    [10, 0, 0, 102],
    [20, 0, 0, 103],
    [0, 10, 0, 104],
    [0, 20, 0, 105],
    [0, 0, 10, 106],
    [0, 0, 20, 107]
]

kd2 = createKDTree3D(planarPoints)

// Box along X axis [5, 25] x [-1, 1] x [-1, 1]
// Contains [10, 0, 0] and [20, 0, 0] = 2 points
resXAxis = kdQueryBox3D(kd2, 5, 25, -1, 1, -1, 1)
if (len(resXAxis) != 2) {
    tc2Pass = 0
}

// Box covering origin [0, 0] x [0, 0] x [0, 0]
resOrigin = kdQueryBox3D(kd2, 0, 0, 0, 0, 0, 0)
if (len(resOrigin) != 1 or resOrigin[0][3] != 101) {
    tc2Pass = 0
}

// NNS to point (0, 0, 19) -> closest to point 107 (0, 0, 20) with distSq = 1
nnsZ = kdNearestNeighbor3D(kd2, 0, 0, 19)
if (nnsZ[0][3] != 107 or nnsZ[1] != 1) {
    tc2Pass = 0
}

if (tc2Pass == 1) {
    print("  Orthogonal 3D axis points and planar alignment verified")
    print("  Boundary plane nearest neighbor pruned accurately")
    print("  Test Case 2 Passed successfully")
} else {
    print("[FAIL] Test Case 2 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 3: Randomized Stress Simulation against Brute Force Oracle
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 3: Randomized Stress Simulation against 3D Oracle...")
numStressPts = 40
stressPoints = []
kdSeed = 66554433
spI = 0

while (spI < numStressPts) {
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    rx = (kdSeed % 100) + 1
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    ry = (kdSeed % 100) + 1
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    rz = (kdSeed % 100) + 1
    stressPoints.push([rx, ry, rz, spI])
    spI = spI + 1
}

kdStress = createKDTree3D(stressPoints)

numBoxQueries = 100
numNNSQueries = 100
stressMismatches = 0

// Part A: Box queries
bqI = 0
while (bqI < numBoxQueries) {
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    xa = (kdSeed % 100) + 1
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    xb = (kdSeed % 100) + 1
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    ya = (kdSeed % 100) + 1
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    yb = (kdSeed % 100) + 1
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    za = (kdSeed % 100) + 1
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    zb = (kdSeed % 100) + 1

    minX = xa
    maxX = xb
    if (minX > maxX) { minX = xb; maxX = xa }
    minY = ya
    maxY = yb
    if (minY > maxY) { minY = yb; maxY = ya }
    minZ = za
    maxZ = zb
    if (minZ > maxZ) { minZ = zb; maxZ = za }

    kdBoxRes = kdQueryBox3D(kdStress, minX, maxX, minY, maxY, minZ, maxZ)

    // Oracle brute force box count
    oracleCount = 0
    scI = 0
    while (scI < numStressPts) {
        px = stressPoints[scI][0]
        py = stressPoints[scI][1]
        pz = stressPoints[scI][2]
        if (minX <= px and px <= maxX and minY <= py and py <= maxY and minZ <= pz and pz <= maxZ) {
            oracleCount = oracleCount + 1
        }
        scI = scI + 1
    }

    if (len(kdBoxRes) != oracleCount) {
        print("[FAIL] Box query", bqI, "mismatch: kd=", len(kdBoxRes), "oracle=", oracleCount)
        stressMismatches = stressMismatches + 1
        bqI = numBoxQueries // break
    }

    bqI = bqI + 1
}

// Part B: Nearest neighbor queries
nqI = 0
while (nqI < numNNSQueries and stressMismatches == 0) {
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    qx = (kdSeed % 100) + 1
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    qy = (kdSeed % 100) + 1
    kdSeed = (kdSeed * 1103515245 + 12345) % 2147483648
    qz = (kdSeed % 100) + 1

    kdNnsRes = kdNearestNeighbor3D(kdStress, qx, qy, qz)
    kdBestSq = kdNnsRes[1]

    // Oracle brute force minimum distance squared
    oracleMinSq = 999999999
    oI = 0
    while (oI < numStressPts) {
        op = stressPoints[oI]
        odx = op[0] - qx
        ody = op[1] - qy
        odz = op[2] - qz
        odSq = odx * odx + ody * ody + odz * odz
        if (odSq < oracleMinSq) {
            oracleMinSq = odSq
        }
        oI = oI + 1
    }

    if (kdBestSq != oracleMinSq) {
        print("[FAIL] NNS query", nqI, "mismatch: kdSq=", kdBestSq, "oracleSq=", oracleMinSq)
        stressMismatches = stressMismatches + 1
        nqI = numNNSQueries // break
    }

    nqI = nqI + 1
}

if (stressMismatches == 0) {
    print("  Executed", numBoxQueries, "randomized 3D box queries and", numNNSQueries, "NNS queries: 0 mismatches")
    print("  100% agreement with brute-force 3D oracle")
    print("  Test Case 3 Passed successfully")
} else {
    print("[FAIL] Stress simulation encountered", stressMismatches, "mismatches")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] 3D KD-Tree Suite executed successfully in", elapsed, "ms")
