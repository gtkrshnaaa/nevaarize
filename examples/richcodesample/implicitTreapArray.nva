import stdlib time as t

// Implicit Cartesian Tree (Treap) Dynamic Array Engine
// Technical characteristics:
// - Dynamic array / sequence representation via randomized binary search tree
// - Implicit keys determined by in-order subtree sizes in O(log N) operations
// - Logarithmic split by element count and priority-driven heap merge
// - Lazy tag propagation for O(log N) arbitrary interval reversal (Rope reversal)
// - Subarray cyclic rotations and dynamic point insertions / deletions
// - Range aggregates: Range sum, minimum, and maximum queries under lazy mutations
// - Iterative in-order sequence extraction for robust memory management
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Implicit Treap Dynamic Array Suite ===")
suiteStartTime = t.millis()

func minInt(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func maxInt(a, b) {
    if (a > b) {
        return a
    }
    return b
}

func createTreapArena() {
    tVal = []
    tPrio = []
    tSize = []
    tLeft = []
    tRight = []
    tRev = []
    tSum = []
    tMin = []
    tMax = []
    return [tVal, tPrio, tSize, tLeft, tRight, tRev, tSum, tMin, tMax]
}

func allocTreapNode(arena, val, prio) {
    tVal = arena[0]
    tPrio = arena[1]
    tSize = arena[2]
    tLeft = arena[3]
    tRight = arena[4]
    tRev = arena[5]
    tSum = arena[6]
    tMin = arena[7]
    tMax = arena[8]

    id = tVal.size()
    tVal.push(val)
    tPrio.push(prio)
    tSize.push(1)
    tLeft.push(-1)
    tRight.push(-1)
    tRev.push(0)
    tSum.push(val)
    tMin.push(val)
    tMax.push(val)

    arena[0] = tVal
    arena[1] = tPrio
    arena[2] = tSize
    arena[3] = tLeft
    arena[4] = tRight
    arena[5] = tRev
    arena[6] = tSum
    arena[7] = tMin
    arena[8] = tMax
    return id
}

func getSize(arena, node) {
    if (node == -1) {
        return 0
    }
    tSize = arena[2]
    return tSize[node]
}

func getSum(arena, node) {
    if (node == -1) {
        return 0
    }
    tSum = arena[6]
    return tSum[node]
}

func getMin(arena, node) {
    if (node == -1) {
        return 2147483647
    }
    tMin = arena[7]
    return tMin[node]
}

func getMax(arena, node) {
    if (node == -1) {
        return -2147483648
    }
    tMax = arena[8]
    return tMax[node]
}

func pushDown(arena, node) {
    if (node == -1) {
        return
    }
    tRev = arena[5]
    if (tRev[node] == 1) {
        tLeft = arena[3]
        tRight = arena[4]
        tmp = tLeft[node]
        tLeft[node] = tRight[node]
        tRight[node] = tmp
        arena[3] = tLeft
        arena[4] = tRight

        lc = tLeft[node]
        rc = tRight[node]
        if (lc != -1) {
            tRev[lc] = 1 - tRev[lc]
        }
        if (rc != -1) {
            tRev[rc] = 1 - tRev[rc]
        }
        tRev[node] = 0
        arena[5] = tRev
    }
}

func pull(arena, node) {
    if (node == -1) {
        return
    }
    tLeft = arena[3]
    tRight = arena[4]
    lc = tLeft[node]
    rc = tRight[node]
    tVal = arena[0]
    tSize = arena[2]
    tSum = arena[6]
    tMin = arena[7]
    tMax = arena[8]

    v = tVal[node]
    sz = 1
    s = v
    mn = v
    mx = v

    if (lc != -1) {
        sz = sz + tSize[lc]
        s = s + tSum[lc]
        mn = minInt(mn, tMin[lc])
        mx = maxInt(mx, tMax[lc])
    }
    if (rc != -1) {
        sz = sz + tSize[rc]
        s = s + tSum[rc]
        mn = minInt(mn, tMin[rc])
        mx = maxInt(mx, tMax[rc])
    }

    tSize[node] = sz
    tSum[node] = s
    tMin[node] = mn
    tMax[node] = mx
    arena[2] = tSize
    arena[6] = tSum
    arena[7] = tMin
    arena[8] = tMax
}

func split(arena, node, k, outPair) {
    if (node == -1) {
        outPair[0] = -1
        outPair[1] = -1
        return
    }
    pushDown(arena, node)
    tLeft = arena[3]
    lc = tLeft[node]
    leftSize = getSize(arena, lc)

    if (leftSize >= k) {
        subPair = [-1, -1]
        split(arena, lc, k, subPair)
        tLeft = arena[3]
        tLeft[node] = subPair[1]
        arena[3] = tLeft
        pull(arena, node)
        outPair[0] = subPair[0]
        outPair[1] = node
    } else {
        subPair = [-1, -1]
        tRight = arena[4]
        rc = tRight[node]
        split(arena, rc, k - leftSize - 1, subPair)
        tRight = arena[4]
        tRight[node] = subPair[0]
        arena[4] = tRight
        pull(arena, node)
        outPair[0] = node
        outPair[1] = subPair[1]
    }
}

func merge(arena, leftNode, rightNode) {
    if (leftNode == -1) {
        return rightNode
    }
    if (rightNode == -1) {
        return leftNode
    }
    pushDown(arena, leftNode)
    pushDown(arena, rightNode)
    tPrio = arena[1]
    if (tPrio[leftNode] >= tPrio[rightNode]) {
        tRight = arena[4]
        rc = tRight[leftNode]
        newRc = merge(arena, rc, rightNode)
        tRight = arena[4]
        tRight[leftNode] = newRc
        arena[4] = tRight
        pull(arena, leftNode)
        return leftNode
    } else {
        tLeft = arena[3]
        lc = tLeft[rightNode]
        newLc = merge(arena, leftNode, lc)
        tLeft = arena[3]
        tLeft[rightNode] = newLc
        arena[3] = tLeft
        pull(arena, rightNode)
        return rightNode
    }
}

func insertAt(arena, root, pos, val, prio) {
    pair = [-1, -1]
    split(arena, root, pos, pair)
    newNode = allocTreapNode(arena, val, prio)
    m1 = merge(arena, pair[0], newNode)
    return merge(arena, m1, pair[1])
}

func eraseAt(arena, root, pos) {
    p1 = [-1, -1]
    split(arena, root, pos, p1)
    p2 = [-1, -1]
    split(arena, p1[1], 1, p2)
    return merge(arena, p1[0], p2[1])
}

func reverseRange(arena, root, l, r) {
    p1 = [-1, -1]
    split(arena, root, l, p1)
    p2 = [-1, -1]
    rangeLen = r - l + 1
    split(arena, p1[1], rangeLen, p2)
    midNode = p2[0]
    tRev = arena[5]
    tRev[midNode] = 1 - tRev[midNode]
    arena[5] = tRev
    m1 = merge(arena, p1[0], midNode)
    return merge(arena, m1, p2[1])
}

func cyclicShift(arena, root, l, r, k) {
    rangeLen = r - l + 1
    if (rangeLen <= 1) {
        return root
    }
    shiftSteps = k % rangeLen
    if (shiftSteps < 0) {
        shiftSteps = shiftSteps + rangeLen
    }
    if (shiftSteps == 0) {
        return root
    }

    p1 = [-1, -1]
    split(arena, root, l, p1)
    p2 = [-1, -1]
    split(arena, p1[1], rangeLen, p2)
    midNode = p2[0]

    cutPoint = rangeLen - shiftSteps
    pMid = [-1, -1]
    split(arena, midNode, cutPoint, pMid)
    rotatedMid = merge(arena, pMid[1], pMid[0])

    m1 = merge(arena, p1[0], rotatedMid)
    return merge(arena, m1, p2[1])
}

func queryRangeSum(arena, root, l, r, outSum) {
    p1 = [-1, -1]
    split(arena, root, l, p1)
    p2 = [-1, -1]
    rangeLen = r - l + 1
    split(arena, p1[1], rangeLen, p2)
    midNode = p2[0]
    outSum[0] = getSum(arena, midNode)
    m1 = merge(arena, p1[0], midNode)
    return merge(arena, m1, p2[1])
}

func queryRangeMin(arena, root, l, r, outMin) {
    p1 = [-1, -1]
    split(arena, root, l, p1)
    p2 = [-1, -1]
    rangeLen = r - l + 1
    split(arena, p1[1], rangeLen, p2)
    midNode = p2[0]
    outMin[0] = getMin(arena, midNode)
    m1 = merge(arena, p1[0], midNode)
    return merge(arena, m1, p2[1])
}

func treeToArray(arena, root) {
    res = []
    if (root == -1) {
        return res
    }
    stack = []
    curr = root
    while (curr != -1 or stack.size() > 0) {
        while (curr != -1) {
            pushDown(arena, curr)
            stack.push(curr)
            tLeft = arena[3]
            curr = tLeft[curr]
        }
        topIdx = stack.size() - 1
        curr = stack[topIdx]
        stack.pop()

        tVal = arena[0]
        res.push(tVal[curr])

        tRight = arena[4]
        curr = tRight[curr]
    }
    return res
}

func checkArrayEqual(arrA, arrB) {
    if (arrA.size() != arrB.size()) {
        return false
    }
    idx = 0
    while (idx < arrA.size()) {
        if (arrA[idx] != arrB[idx]) {
            return false
        }
        idx = idx + 1
    }
    return true
}

// --- Test Case 1: Sequential Inserts and Sequence Reconstruction ---
print("Running Test Case 1: Dynamic Point Insertions and Sequence Integrity...")
arena1 = createTreapArena()
root1 = -1

// Insert sequence: building array [10, 20, 30, 40, 50, 60]
root1 = insertAt(arena1, root1, 0, 30, 95)
root1 = insertAt(arena1, root1, 0, 10, 70)
root1 = insertAt(arena1, root1, 1, 20, 85)
root1 = insertAt(arena1, root1, 3, 50, 60)
root1 = insertAt(arena1, root1, 3, 40, 90)
root1 = insertAt(arena1, root1, 5, 60, 40)

arr1 = treeToArray(arena1, root1)
expected1 = [10, 20, 30, 40, 50, 60]
pass1 = checkArrayEqual(arr1, expected1)

if (!pass1 or getSize(arena1, root1) != 6) {
    print("[FAIL] Test Case 1 sequence mismatch")
} else {
    print("  Constructed 6-element dynamic array via arbitrary position inserts verified")
    print("  Test Case 1 Passed dynamic point insertions verification")
}

// --- Test Case 2: Range Reversals (Full, Single, Nested, and Slices) ---
print("Running Test Case 2: Range Reversals and Lazy Propagation...")
case2Success = true

// Reversal A: Reverse subsegment [1, 4] -> [10, 50, 40, 30, 20, 60]
root1 = reverseRange(arena1, root1, 1, 4)
arrRevA = treeToArray(arena1, root1)
expectedRevA = [10, 50, 40, 30, 20, 60]
if (!checkArrayEqual(arrRevA, expectedRevA)) {
    print("[FAIL] Reversal A [1, 4] failed")
    case2Success = false
} else {
    print("  Subarray reversal [1, 4] verified: 20, 30, 40, 50 -> 50, 40, 30, 20")
}

// Reversal B: Reverse full array [0, 5] -> [60, 20, 30, 40, 50, 10]
root1 = reverseRange(arena1, root1, 0, 5)
arrRevB = treeToArray(arena1, root1)
expectedRevB = [60, 20, 30, 40, 50, 10]
if (!checkArrayEqual(arrRevB, expectedRevB)) {
    print("[FAIL] Reversal B [0, 5] failed")
    case2Success = false
} else {
    print("  Full sequence reversal [0, 5] verified")
}

// Reversal C: Single-element reverse [2, 2] (identity / no-op)
root1 = reverseRange(arena1, root1, 2, 2)
arrRevC = treeToArray(arena1, root1)
if (!checkArrayEqual(arrRevC, expectedRevB)) {
    print("[FAIL] Single-element identity reversal [2, 2] failed")
    case2Success = false
} else {
    print("  Single-element identity reversal [2, 2] preserved sequence exactly")
}

// Reversal D: Nested back-to-back reversals on [1, 3] (should cancel each other out)
root1 = reverseRange(arena1, root1, 1, 3)
root1 = reverseRange(arena1, root1, 1, 3)
arrRevD = treeToArray(arena1, root1)
if (!checkArrayEqual(arrRevD, expectedRevB)) {
    print("[FAIL] Back-to-back nested reversals failed")
    case2Success = false
} else {
    print("  Back-to-back involution reversals on [1, 3] cancelled out as expected")
}

if (case2Success) {
    print("  Test Case 2 Passed range reversals and lazy propagation verification")
}

// --- Test Case 3: Range Aggregates (Sum, Min) Under Dynamic Reversals ---
print("Running Test Case 3: Range Aggregates under Mutations...")
case3Success = true

sumHolder = [0]
minHolder = [0]

// Query sum and min of [1, 4] (elements 20, 30, 40, 50 -> sum = 140, min = 20)
root1 = queryRangeSum(arena1, root1, 1, 4, sumHolder)
root1 = queryRangeMin(arena1, root1, 1, 4, minHolder)

if (sumHolder[0] != 140 or minHolder[0] != 20) {
    print("[FAIL] Range queries [1, 4] mismatch:", sumHolder[0], minHolder[0])
    case3Success = false
} else {
    print("  Subarray [1, 4] range aggregates verified: sum =", sumHolder[0], ", min =", minHolder[0])
}

// Total sum of all 6 elements: 60 + 20 + 30 + 40 + 50 + 10 = 210
root1 = queryRangeSum(arena1, root1, 0, 5, sumHolder)
root1 = queryRangeMin(arena1, root1, 0, 5, minHolder)

if (sumHolder[0] != 210 or minHolder[0] != 10) {
    print("[FAIL] Total sequence query mismatch:", sumHolder[0], minHolder[0])
    case3Success = false
} else {
    print("  Total sequence aggregates verified: sum =", sumHolder[0], ", min =", minHolder[0])
}

if (case3Success) {
    print("  Test Case 3 Passed range aggregates verification")
}

// --- Test Case 4: Cyclic Rotations and Deletions ---
print("Running Test Case 4: Cyclic Rotations and Dynamic Deletions...")
case4Success = true

// Cyclic shift range [1, 4] right by 1 position:
root1 = cyclicShift(arena1, root1, 1, 4, 1)
arrRot = treeToArray(arena1, root1)
expectedRot = [60, 50, 20, 30, 40, 10]

if (!checkArrayEqual(arrRot, expectedRot)) {
    print("[FAIL] Cyclic shift by 1 failed")
    case4Success = false
} else {
    print("  Cyclic shift on range [1, 4] by 1 verified: [50, 20, 30, 40]")
}

// Erase head (index 0, which is 60) -> array: [50, 20, 30, 40, 10]
root1 = eraseAt(arena1, root1, 0)
// Erase tail (index 4, which is 10) -> array: [50, 20, 30, 40]
root1 = eraseAt(arena1, root1, 4)
// Erase middle (index 1, which is 20) -> array: [50, 30, 40]
root1 = eraseAt(arena1, root1, 1)

arrErased = treeToArray(arena1, root1)
expectedErased = [50, 30, 40]

if (!checkArrayEqual(arrErased, expectedErased)) {
    print("[FAIL] Sequence after deletions mismatch")
    case4Success = false
} else {
    print("  Head, tail, and middle deletions verified: remaining sequence length =", arrErased.size())
}

if (case4Success) {
    print("  Test Case 4 Passed cyclic rotations and deletions verification")
}

// --- Test Case 5: Stress Benchmark against Naive Simulation ---
print("Running Test Case 5: Randomized Stress Simulation against Naive Array Model...")
stressArena = createTreapArena()
stressRoot = -1
naiveList = []

seed = 31415926
step = 0
totalOps = 200

// Initialize with 20 elements
initCount = 20
while (step < initCount) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    randVal = (seed % 200) + 1
    seed = (seed * 1103515245 + 12345) % 2147483648
    randPrio = (seed % 100000) + 1

    stressRoot = insertAt(stressArena, stressRoot, step, randVal, randPrio)
    naiveList.push(randVal)
    step = step + 1
}

stressErrors = 0
opIdx = 0

while (opIdx < totalOps) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    opType = seed % 3
    currSz = naiveList.size()

    if (opType == 0 and currSz < 60) {
        // Insert operation
        seed = (seed * 1103515245 + 12345) % 2147483648
        insPos = seed % (currSz + 1)
        seed = (seed * 1103515245 + 12345) % 2147483648
        insVal = (seed % 200) + 1
        seed = (seed * 1103515245 + 12345) % 2147483648
        insPrio = (seed % 100000) + 1

        stressRoot = insertAt(stressArena, stressRoot, insPos, insVal, insPrio)

        newNaive = []
        k = 0
        while (k < currSz) {
            if (k == insPos) {
                newNaive.push(insVal)
            }
            newNaive.push(naiveList[k])
            k = k + 1
        }
        if (insPos == currSz) {
            newNaive.push(insVal)
        }
        naiveList = newNaive
    } elif (opType == 1 and currSz > 3) {
        // Erase operation
        seed = (seed * 1103515245 + 12345) % 2147483648
        delPos = seed % currSz
        stressRoot = eraseAt(stressArena, stressRoot, delPos)

        newNaive = []
        k = 0
        while (k < currSz) {
            if (k != delPos) {
                newNaive.push(naiveList[k])
            }
            k = k + 1
        }
        naiveList = newNaive
    } elif (opType == 2 and currSz >= 2) {
        // Range reverse operation
        seed = (seed * 1103515245 + 12345) % 2147483648
        rA = seed % currSz
        seed = (seed * 1103515245 + 12345) % 2147483648
        rB = seed % currSz
        rL = rA
        rR = rB
        if (rL > rR) {
            rL = rB
            rR = rA
        }

        stressRoot = reverseRange(stressArena, stressRoot, rL, rR)

        k = 0
        halfRange = (rR - rL + 1) / 2
        while (k < halfRange) {
            tmpVal = naiveList[rL + k]
            naiveList[rL + k] = naiveList[rR - k]
            naiveList[rR - k] = tmpVal
            k = k + 1
        }
    }

    if (opIdx % 25 == 0) {
        arrCheck = treeToArray(stressArena, stressRoot)
        if (!checkArrayEqual(arrCheck, naiveList)) {
            stressErrors = stressErrors + 1
        }
    }

    opIdx = opIdx + 1
}

finalArr = treeToArray(stressArena, stressRoot)
if (!checkArrayEqual(finalArr, naiveList)) {
    stressErrors = stressErrors + 1
}

if (stressErrors > 0) {
    print("[FAIL] Stress benchmark encountered", stressErrors, "mismatches")
} else {
    print("  Validated", totalOps, "randomized inserts, erasures, and range reversals: 0 mismatches")
    tVal = stressArena[0]
    print("  Total allocated implicit Treap nodes:", tVal.size())
    print("  Test Case 5 Passed randomized stress simulation verification")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] Implicit Treap Dynamic Array Suite executed successfully in", elapsed, "ms")
