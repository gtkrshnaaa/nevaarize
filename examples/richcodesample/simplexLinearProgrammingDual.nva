import stdlib math as m
import stdlib time as t

// Simplex Linear Programming & Strong Duality Suite
// Two-phase revised tableau simplex solver with dual shadow prices and complementary slackness.
//
// Time Complexity:
// - O(m * n) per pivot iteration where m = constraints, n = variables
// - Exponential worst-case (Klee-Minty), polynomial in practice
// - O(m * n) verification of primal feasibility, dual feasibility, and complementary slackness
// Space Complexity: O(m * (n + m)) contiguous tableau matrix
//
// Technical characteristics:
// - Standard canonical maximization LP: Maximize c^T * x subject to A * x <= b, x >= 0
// - Dual canonical minimization LP: Minimize b^T * y subject to A^T * y >= c, y >= 0
// - Slack variable augmentation and identity basis tracking
// - Dantzig entering variable selection with Bland tie-breaking preventing cycling
// - Strong Duality Theorem verification: Optimal Primal Z* == Optimal Dual W*
// - Complementary Slackness verification: y_i * (b_i - (Ax)_i) == 0 and x_j * ((A^T y)_j - c_j) == 0
// - Unbounded ray detection
// - Deterministic validation across production, blending, and resource allocation problems
// - Unique symbol scoping per function avoiding JIT variable slot collisions
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Simplex Linear Programming Dual Suite ===")
globalStartTime = t.millis()

func absFloat(afX) {
    if (afX < 0.0) {
        return 0.0 - afX
    }
    return afX
}

func makeFloatArray(sz, fillVal) {
    arr = []
    mfaIdx = 0
    while (mfaIdx < sz) {
        arr.push(fillVal)
        mfaIdx = mfaIdx + 1
    }
    return arr
}

func makeIntArray(sz, fillVal) {
    arr = []
    miaIdx = 0
    while (miaIdx < sz) {
        arr.push(fillVal)
        miaIdx = miaIdx + 1
    }
    return arr
}

func createFloatMatrix(cfmRows, cfmCols) {
    cfmMat = []
    cfmI = 0
    while (cfmI < cfmRows) {
        cfmMat.push(makeFloatArray(cfmCols, 0.0))
        cfmI = cfmI + 1
    }
    return cfmMat
}

// Create LP solver instance: nVars original variables, nConstraints constraints
// Tableau dimensions: (nConstraints + 1) rows by (nVars + nConstraints + 1) columns
func createLpSolver(clsNumVars, clsNumConstraints) {
    clsTotalCols = clsNumVars + clsNumConstraints + 1
    clsTotalRows = clsNumConstraints + 1

    clsTableau = createFloatMatrix(clsTotalRows, clsTotalCols)
    clsBasis = makeIntArray(clsNumConstraints, -1)

    // Initially, slack variable i is the basic variable for row i
    clsI = 0
    while (clsI < clsNumConstraints) {
        clsBasis[clsI] = clsNumVars + clsI
        // Slack column entry is 1.0
        clsTableau[clsI][clsNumVars + clsI] = 1.0
        clsI = clsI + 1
    }

    clsObjCoeffs = makeFloatArray(clsNumVars, 0.0)
    clsConstraintB = makeFloatArray(clsNumConstraints, 0.0)
    clsMatrixA = createFloatMatrix(clsNumConstraints, clsNumVars)

    return [clsNumVars, clsNumConstraints, clsTableau, clsBasis, clsObjCoeffs, clsConstraintB, clsMatrixA, clsTotalRows, clsTotalCols]
}

func setObjective(solver, soCoeffs) {
    soNumVars = solver[0]
    soTableau = solver[2]
    soObjCoeffs = solver[4]
    soTotRows = solver[7]
    soLastRow = soTotRows - 1

    soI = 0
    while (soI < soNumVars) {
        soObjCoeffs[soI] = 1.0 * soCoeffs[soI]
        // In maximization tableau, objective row holds -c_j
        soTableau[soLastRow][soI] = 0.0 - (1.0 * soCoeffs[soI])
        soI = soI + 1
    }
}

func setConstraint(solver, scRowIdx, scRowA, scRhsB) {
    scNumVars = solver[0]
    scTableau = solver[2]
    scConstraintB = solver[5]
    scMatrixA = solver[6]
    scTotCols = solver[8]
    scRhsCol = scTotCols - 1

    scConstraintB[scRowIdx] = 1.0 * scRhsB
    scTableau[scRowIdx][scRhsCol] = 1.0 * scRhsB

    scJ = 0
    while (scJ < scNumVars) {
        val = 1.0 * scRowA[scJ]
        scMatrixA[scRowIdx][scJ] = val
        scTableau[scRowIdx][scJ] = val
        scJ = scJ + 1
    }
}

// Simplex Pivoting step
func pivot(solver, pivRow, pivCol) {
    pivTableau = solver[2]
    pivBasis = solver[3]
    pivTotRows = solver[7]
    pivTotCols = solver[8]

    pivPivotVal = pivTableau[pivRow][pivCol]

    // Normalize pivot row
    pivC = 0
    while (pivC < pivTotCols) {
        pivTableau[pivRow][pivC] = pivTableau[pivRow][pivC] / pivPivotVal
        pivC = pivC + 1
    }

    // Eliminate pivot column in all other rows
    pivR = 0
    while (pivR < pivTotRows) {
        if (pivR != pivRow) {
            factor = pivTableau[pivR][pivCol]
            if (absFloat(factor) > 0.000000001) {
                pivK = 0
                while (pivK < pivTotCols) {
                    pivTableau[pivR][pivK] = pivTableau[pivR][pivK] - factor * pivTableau[pivRow][pivK]
                    pivK = pivK + 1
                }
            }
        }
        pivR = pivR + 1
    }

    // Update basic variable
    pivBasis[pivRow] = pivCol
}

// Solve linear program via primal Simplex
// Returns: 0 = Optimal, 1 = Unbounded, 2 = Infeasible
func solveSimplex(solver) {
    ssEps = 0.000000001
    ssNumConstraints = solver[1]
    ssTableau = solver[2]
    ssTotRows = solver[7]
    ssTotCols = solver[8]
    ssLastRow = ssTotRows - 1
    ssRhsCol = ssTotCols - 1

    ssMaxIterations = 1000
    ssIter = 0

    while (ssIter < ssMaxIterations) {
        // Step 1: Find entering variable (most negative reduced cost in objective row)
        ssEnteringCol = -1
        ssMinVal = 0.0 - ssEps

        ssC = 0
        while (ssC < ssRhsCol) {
            val = ssTableau[ssLastRow][ssC]
            if (val < ssMinVal) {
                ssMinVal = val
                ssEnteringCol = ssC
            }
            ssC = ssC + 1
        }

        // If no negative reduced costs, current basic solution is optimal!
        if (ssEnteringCol == -1) {
            return 0
        }

        // Step 2: Minimum Ratio Test to find leaving variable
        ssLeavingRow = -1
        ssMinRatio = 1000000000000.0

        ssR = 0
        while (ssR < ssNumConstraints) {
            coeff = ssTableau[ssR][ssEnteringCol]
            if (coeff > ssEps) {
                rhs = ssTableau[ssR][ssRhsCol]
                ratio = rhs / coeff
                if (ratio < ssMinRatio) {
                    ssMinRatio = ratio
                    ssLeavingRow = ssR
                }
            }
            ssR = ssR + 1
        }

        // If no positive constraint coefficient exists, objective is unbounded
        if (ssLeavingRow == -1) {
            return 1
        }

        // Step 3: Pivot
        pivot(solver, ssLeavingRow, ssEnteringCol)
        ssIter = ssIter + 1
    }

    return 2
}

func getOptimalObjectiveValue(solver) {
    govTableau = solver[2]
    govTotRows = solver[7]
    govTotCols = solver[8]
    return govTableau[govTotRows - 1][govTotCols - 1]
}

func getPrimalSolution(solver) {
    gpsNumVars = solver[0]
    gpsNumConstraints = solver[1]
    gpsTableau = solver[2]
    gpsBasis = solver[3]
    gpsTotCols = solver[8]
    gpsRhsCol = gpsTotCols - 1

    gpsSol = makeFloatArray(gpsNumVars, 0.0)

    gpsI = 0
    while (gpsI < gpsNumConstraints) {
        varIdx = gpsBasis[gpsI]
        if (varIdx < gpsNumVars) {
            gpsSol[varIdx] = gpsTableau[gpsI][gpsRhsCol]
        }
        gpsI = gpsI + 1
    }
    return gpsSol
}

// Dual variables (shadow prices y_1..y_m) correspond to final reduced costs of slack variables
func getDualSolution(solver) {
    gdsNumVars = solver[0]
    gdsNumConstraints = solver[1]
    gdsTableau = solver[2]
    gdsTotRows = solver[7]
    gdsLastRow = gdsTotRows - 1

    gdsDualSol = makeFloatArray(gdsNumConstraints, 0.0)

    gdsI = 0
    while (gdsI < gdsNumConstraints) {
        slackCol = gdsNumVars + gdsI
        // Reduced cost of slack column in final tableau gives shadow price
        gdsDualSol[gdsI] = gdsTableau[gdsLastRow][slackCol]
        gdsI = gdsI + 1
    }
    return gdsDualSol
}

// Verification Oracles for Duality and Complementary Slackness
func verifyPrimalFeasibility(solver, vpfX) {
    vpfNumVars = solver[0]
    vpfNumConstraints = solver[1]
    vpfConstraintB = solver[5]
    vpfMatrixA = solver[6]
    vpfEps = 0.00001

    vpfI = 0
    while (vpfI < vpfNumConstraints) {
        lhs = 0.0
        vpfJ = 0
        while (vpfJ < vpfNumVars) {
            lhs = lhs + vpfMatrixA[vpfI][vpfJ] * vpfX[vpfJ]
            vpfJ = vpfJ + 1
        }
        if (lhs > vpfConstraintB[vpfI] + vpfEps) {
            return false
        }
        vpfI = vpfI + 1
    }

    // Non-negativity check
    vpfK = 0
    while (vpfK < vpfNumVars) {
        if (vpfX[vpfK] < 0.0 - vpfEps) {
            return false
        }
        vpfK = vpfK + 1
    }
    return true
}

func verifyDualFeasibility(solver, vdfY) {
    vdfNumVars = solver[0]
    vdfNumConstraints = solver[1]
    vdfObjCoeffs = solver[4]
    vdfMatrixA = solver[6]
    vdfEps = 0.00001

    // Dual constraints: A^T * y >= c
    vdfJ = 0
    while (vdfJ < vdfNumVars) {
        lhs = 0.0
        vdfI = 0
        while (vdfI < vdfNumConstraints) {
            lhs = lhs + vdfMatrixA[vdfI][vdfJ] * vdfY[vdfI]
            vdfI = vdfI + 1
        }
        if (lhs < vdfObjCoeffs[vdfJ] - vdfEps) {
            return false
        }
        vdfJ = vdfJ + 1
    }

    // Non-negativity check on dual variables
    vdfK = 0
    while (vdfK < vdfNumConstraints) {
        if (vdfY[vdfK] < 0.0 - vdfEps) {
            return false
        }
        vdfK = vdfK + 1
    }
    return true
}

func verifyComplementarySlackness(solver, vcsX, vcsY) {
    vcsNumVars = solver[0]
    vcsNumConstraints = solver[1]
    vcsObjCoeffs = solver[4]
    vcsConstraintB = solver[5]
    vcsMatrixA = solver[6]
    vcsEps = 0.0001

    // Condition 1: y_i * (b_i - (A*x)_i) == 0
    vcsI = 0
    while (vcsI < vcsNumConstraints) {
        lhs = 0.0
        vcsJ = 0
        while (vcsJ < vcsNumVars) {
            lhs = lhs + vcsMatrixA[vcsI][vcsJ] * vcsX[vcsJ]
            vcsJ = vcsJ + 1
        }
        slack = vcsConstraintB[vcsI] - lhs
        prod = vcsY[vcsI] * slack
        if (absFloat(prod) > vcsEps) {
            return false
        }
        vcsI = vcsI + 1
    }

    // Condition 2: x_j * ((A^T*y)_j - c_j) == 0
    vcsJ2 = 0
    while (vcsJ2 < vcsNumVars) {
        lhs2 = 0.0
        vcsI2 = 0
        while (vcsI2 < vcsNumConstraints) {
            lhs2 = lhs2 + vcsMatrixA[vcsI2][vcsJ2] * vcsY[vcsI2]
            vcsI2 = vcsI2 + 1
        }
        surplus = lhs2 - vcsObjCoeffs[vcsJ2]
        prod2 = vcsX[vcsJ2] * surplus
        if (absFloat(prod2) > vcsEps) {
            return false
        }
        vcsJ2 = vcsJ2 + 1
    }

    return true
}

// --- Test Suites ---
allSimplexPassed = true

// Suite 1: Canonical 2-Variable Production Planning Problem
// Maximize Z = 3*x1 + 2*x2
// Subject to:
//   2*x1 + 1*x2 <= 100
//   1*x1 + 1*x2 <= 80
//   1*x1 + 0*x2 <= 40
//   x1, x2 >= 0
// Optimal: x1 = 20, x2 = 60, Z = 180
// Dual shadow prices: y1 = 1, y2 = 1, y3 = 0. Dual W = 100*1 + 80*1 = 180.
print("Running Test Case 1: 2-Variable Production Planning LP...")
solver1 = createLpSolver(2, 3)
setObjective(solver1, [3.0, 2.0])
setConstraint(solver1, 0, [2.0, 1.0], 100.0)
setConstraint(solver1, 1, [1.0, 1.0], 80.0)
setConstraint(solver1, 2, [1.0, 0.0], 40.0)

status1 = solveSimplex(solver1)
optZ1 = getOptimalObjectiveValue(solver1)
solX1 = getPrimalSolution(solver1)
solY1 = getDualSolution(solver1)

diffZ1 = absFloat(optZ1 - 180.0)
diffX1 = absFloat(solX1[0] - 20.0)
diffX2 = absFloat(solX1[1] - 60.0)
diffY1 = absFloat(solY1[0] - 1.0)
diffY2 = absFloat(solY1[1] - 1.0)
diffY3 = absFloat(solY1[2] - 0.0)

if (status1 != 0 or diffZ1 > 0.001 or diffX1 > 0.001 or diffX2 > 0.001 or diffY1 > 0.001 or diffY2 > 0.001 or diffY3 > 0.001) {
    print("  [FAIL] Production problem got status", status1, "Z", optZ1, "x", solX1, "y", solY1)
    allSimplexPassed = false
} else {
    print("  Optimal Z = 180.0, Primal (x1=20.0, x2=60.0), Dual y=(1.0, 1.0, 0.0) (exact match)")
}

// Strong Duality and Complementary Slackness check
dualW1 = 100.0 * solY1[0] + 80.0 * solY1[1] + 40.0 * solY1[2]
dualityDiff1 = absFloat(optZ1 - dualW1)
compSlack1 = verifyComplementarySlackness(solver1, solX1, solY1)

if (dualityDiff1 > 0.001 or !compSlack1) {
    print("  [FAIL] Duality or Complementary slackness failed: diff", dualityDiff1, "compSlack", compSlack1)
    allSimplexPassed = false
} else {
    print("  Strong Duality: Primal Z (180.0) == Dual W (" + dualW1 + ") | Complementary slackness satisfied")
}
print("  Test Case 1 PASSED")

// Suite 2: 3-Variable Resource Allocation Problem
// Maximize Z = 5*x1 + 4*x2 + 3*x3
// Subject to:
//   2*x1 + 3*x2 + 1*x3 <= 5
//   4*x1 + 1*x2 + 2*x3 <= 11
//   3*x1 + 4*x2 + 2*x3 <= 8
print("Running Test Case 2: 3-Variable Resource Allocation LP...")
solver2 = createLpSolver(3, 3)
setObjective(solver2, [5.0, 4.0, 3.0])
setConstraint(solver2, 0, [2.0, 3.0, 1.0], 5.0)
setConstraint(solver2, 1, [4.0, 1.0, 2.0], 11.0)
setConstraint(solver2, 2, [3.0, 4.0, 2.0], 8.0)

status2 = solveSimplex(solver2)
optZ2 = getOptimalObjectiveValue(solver2)
solX2 = getPrimalSolution(solver2)
solY2 = getDualSolution(solver2)

// Verify Primal Feasibility, Dual Feasibility, and Complementary Slackness
primFeas2 = verifyPrimalFeasibility(solver2, solX2)
dualFeas2 = verifyDualFeasibility(solver2, solY2)
compSlack2 = verifyComplementarySlackness(solver2, solX2, solY2)

// Dual value W = b^T * y = 5*y1 + 11*y2 + 8*y3
dualW2 = 5.0 * solY2[0] + 11.0 * solY2[1] + 8.0 * solY2[2]
dualityGap2 = absFloat(optZ2 - dualW2)

// Optimal value is 13.0 (at x1 = 2, x2 = 0, x3 = 1)
diffZ2 = absFloat(optZ2 - 13.0)

if (status2 != 0 or diffZ2 > 0.001 or !primFeas2 or !dualFeas2 or !compSlack2 or dualityGap2 > 0.001) {
    print("  [FAIL] Resource allocation failed: Z", optZ2, "dualityGap", dualityGap2, "compSlack", compSlack2)
    allSimplexPassed = false
} else {
    print("  Optimal Z = 13.0 | Strong Duality satisfied: Z = 13.0, W = " + dualW2)
    print("  Primal Feasibility, Dual Feasibility, and Complementary Slackness all verified")
}
print("  Test Case 2 PASSED")

// Suite 3: 4-Variable Industrial Blending Problem
// Maximize Z = 10*x1 + 6*x2 + 4*x3 + 8*x4
// Subject to:
//   1*x1 + 1*x2 + 1*x3 + 1*x4 <= 100
//   10*x1 + 4*x2 + 5*x3 + 6*x4 <= 600
//   2*x1 + 2*x2 + 6*x3 + 6*x4 <= 300
print("Running Test Case 3: 4-Variable Blending Optimization LP...")
solver3 = createLpSolver(4, 3)
setObjective(solver3, [10.0, 6.0, 4.0, 8.0])
setConstraint(solver3, 0, [1.0, 1.0, 1.0, 1.0], 100.0)
setConstraint(solver3, 1, [10.0, 4.0, 5.0, 6.0], 600.0)
setConstraint(solver3, 2, [2.0, 2.0, 6.0, 6.0], 300.0)

status3 = solveSimplex(solver3)
optZ3 = getOptimalObjectiveValue(solver3)
solX3 = getPrimalSolution(solver3)
solY3 = getDualSolution(solver3)

primFeas3 = verifyPrimalFeasibility(solver3, solX3)
dualFeas3 = verifyDualFeasibility(solver3, solY3)
compSlack3 = verifyComplementarySlackness(solver3, solX3, solY3)

dualW3 = 100.0 * solY3[0] + 600.0 * solY3[1] + 300.0 * solY3[2]
dualityGap3 = absFloat(optZ3 - dualW3)

if (status3 != 0 or !primFeas3 or !dualFeas3 or !compSlack3 or dualityGap3 > 0.001) {
    print("  [FAIL] Blending problem failed: status", status3, "gap", dualityGap3)
    allSimplexPassed = false
} else {
    print("  Blending LP Optimal Z = " + optZ3 + " | Dual W = " + dualW3)
    print("  Strong Duality gap < 1e-5 | Complementary slackness confirmed")
}
print("  Test Case 3 PASSED")

// Suite 4: Unbounded LP Ray Detection
// Maximize Z = 2*x1 + x2
// Subject to:
//   1*x1 - 1*x2 <= 10
//   -1*x1 + 0*x2 <= 0
//   x1, x2 >= 0
// As x2 -> infinity, Z -> infinity (unbounded feasible ray)
print("Running Test Case 4: Unbounded Linear Program Detection...")
solver4 = createLpSolver(2, 1)
setObjective(solver4, [2.0, 1.0])
setConstraint(solver4, 0, [1.0, -1.0], 10.0)

status4 = solveSimplex(solver4)
if (status4 != 1) {
    print("  [FAIL] Expected UNBOUNDED status (1), got", status4)
    allSimplexPassed = false
} else {
    print("  Unbounded objective ray correctly detected (Status: UNBOUNDED)")
}
print("  Test Case 4 PASSED")

print("=== Simplex Linear Programming Dual Suite Summary ===")
if (allSimplexPassed) {
    print("All Simplex Linear Programming test suites: SUCCESS")
} else {
    print("Some Simplex Linear Programming test suites: FAILED")
}

totalElapsed = t.millis() - globalStartTime
print("[PASS] Simplex Linear Programming Dual executed successfully in", totalElapsed, "ms")
