import stdlib string as str
import stdlib time as t

// Persistent String Trie (Prefix Tree) Engine
// Technical characteristics:
// - Functional persistence via node path copying in O(L) time and O(L) space per insertion
// - Multi-version historical snapshots supporting immutable point queries and rollbacks
// - Prefix counting and exact word occurrence tracking across historical timelines
// - Timeline forking and branching from arbitrary historical versions
// - Comprehensive assertion suites and randomized stress testing against a naive oracle
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Persistent String Trie Suite ===")
suiteStartTime = t.millis()

func minInt(aInt, bInt) {
    if (aInt < bInt) {
        return aInt
    }
    return bInt
}

func maxInt(aInt, bInt) {
    if (aInt > bInt) {
        return aInt
    }
    return bInt
}

func charToIndex(charCode) {
    if (charCode >= 97 and charCode <= 122) {
        return charCode - 97
    }
    if (charCode >= 65 and charCode <= 90) {
        return charCode - 65
    }
    return -1
}

func createPersistentTrie() {
    tChildren = []
    tWordCount = []
    tPrefixCount = []
    tChar = []
    tDepth = []
    alphabetSize = 26
    return [tChildren, tWordCount, tPrefixCount, tChar, tDepth, alphabetSize]
}

func allocNode(trie, charCode, depthVal) {
    tChildren = trie[0]
    tWordCount = trie[1]
    tPrefixCount = trie[2]
    tChar = trie[3]
    tDepth = trie[4]
    alphaSize = trie[5]

    nodeId = tWordCount.size()
    c = 0
    while (c < alphaSize) {
        tChildren.push(-1)
        c = c + 1
    }
    tWordCount.push(0)
    tPrefixCount.push(0)
    tChar.push(charCode)
    tDepth.push(depthVal)

    trie[0] = tChildren
    trie[1] = tWordCount
    trie[2] = tPrefixCount
    trie[3] = tChar
    trie[4] = tDepth
    return nodeId
}

func cloneNode(trie, srcNode) {
    tChildren = trie[0]
    tWordCount = trie[1]
    tPrefixCount = trie[2]
    tChar = trie[3]
    tDepth = trie[4]
    alphaSize = trie[5]

    if (srcNode == -1) {
        return allocNode(trie, -1, 0)
    }

    newNodeId = tWordCount.size()
    srcOffset = srcNode * alphaSize
    c = 0
    while (c < alphaSize) {
        tChildren.push(tChildren[srcOffset + c])
        c = c + 1
    }
    tWordCount.push(tWordCount[srcNode])
    tPrefixCount.push(tPrefixCount[srcNode])
    tChar.push(tChar[srcNode])
    tDepth.push(tDepth[srcNode])

    trie[0] = tChildren
    trie[1] = tWordCount
    trie[2] = tPrefixCount
    trie[3] = tChar
    trie[4] = tDepth
    return newNodeId
}

func insertWord(trie, prevRoot, word) {
    wordLen = str.length(word)
    newRoot = cloneNode(trie, prevRoot)

    tPrefixCount = trie[2]
    tPrefixCount[newRoot] = tPrefixCount[newRoot] + 1
    trie[2] = tPrefixCount

    if (wordLen == 0) {
        tWordCount = trie[1]
        tWordCount[newRoot] = tWordCount[newRoot] + 1
        trie[1] = tWordCount
        return newRoot
    }

    currNode = newRoot
    i = 0
    while (i < wordLen) {
        charCode = str.charCodeAt(word, i)
        cIdx = charToIndex(charCode)
        if (cIdx < 0) {
            i = i + 1
        } else {
            tChildren = trie[0]
            alphaSize = trie[5]
            oldChild = tChildren[currNode * alphaSize + cIdx]

            newChild = cloneNode(trie, oldChild)
            tDepth = trie[4]
            tDepth[newChild] = i + 1
            trie[4] = tDepth

            tChar = trie[3]
            tChar[newChild] = cIdx
            trie[3] = tChar

            tPrefixCount = trie[2]
            tPrefixCount[newChild] = tPrefixCount[newChild] + 1
            trie[2] = tPrefixCount

            tChildren = trie[0]
            tChildren[currNode * alphaSize + cIdx] = newChild
            trie[0] = tChildren

            currNode = newChild
            i = i + 1
        }
    }

    tWordCount = trie[1]
    tWordCount[currNode] = tWordCount[currNode] + 1
    trie[1] = tWordCount

    return newRoot
}

func removeWord(trie, prevRoot, word) {
    if (prevRoot == -1) {
        return -1
    }
    if (containsWord(trie, prevRoot, word) == 0) {
        return prevRoot
    }
    wordLen = str.length(word)
    newRoot = cloneNode(trie, prevRoot)
    tPrefixCount = trie[2]
    tPrefixCount[newRoot] = tPrefixCount[newRoot] - 1
    trie[2] = tPrefixCount

    if (wordLen == 0) {
        tWordCount = trie[1]
        tWordCount[newRoot] = tWordCount[newRoot] - 1
        trie[1] = tWordCount
        return newRoot
    }

    currNode = newRoot
    tChildren = trie[0]
    alphaSize = trie[5]
    pruned = 0
    i = 0
    while (i < wordLen and pruned == 0) {
        charCode = str.charCodeAt(word, i)
        cIdx = charToIndex(charCode)
        if (cIdx < 0) {
            i = i + 1
        } else {
            oldChild = tChildren[currNode * alphaSize + cIdx]
            newChild = cloneNode(trie, oldChild)
            tPrefixCount = trie[2]
            newPref = tPrefixCount[newChild] - 1
            tPrefixCount[newChild] = newPref
            trie[2] = tPrefixCount

            if (newPref == 0) {
                tChildren = trie[0]
                tChildren[currNode * alphaSize + cIdx] = -1
                trie[0] = tChildren
                pruned = 1
            } else {
                tChildren = trie[0]
                tChildren[currNode * alphaSize + cIdx] = newChild
                trie[0] = tChildren
                currNode = newChild
                i = i + 1
            }
        }
    }

    if (pruned == 0) {
        tWordCount = trie[1]
        tWordCount[currNode] = tWordCount[currNode] - 1
        trie[1] = tWordCount
    }

    return newRoot
}

func containsWord(trie, root, word) {
    if (root == -1) {
        return 0
    }
    wordLen = str.length(word)
    if (wordLen == 0) {
        tWordCount = trie[1]
        if (tWordCount[root] > 0) {
            return 1
        }
        return 0
    }

    curr = root
    tChildren = trie[0]
    alphaSize = trie[5]
    i = 0
    while (i < wordLen) {
        charCode = str.charCodeAt(word, i)
        cIdx = charToIndex(charCode)
        if (cIdx < 0) {
            return 0
        }
        nxt = tChildren[curr * alphaSize + cIdx]
        if (nxt == -1) {
            return 0
        }
        curr = nxt
        i = i + 1
    }

    tWordCount = trie[1]
    if (tWordCount[curr] > 0) {
        return 1
    }
    return 0
}

func countWord(trie, root, word) {
    if (root == -1) {
        return 0
    }
    wordLen = str.length(word)
    if (wordLen == 0) {
        tWordCount = trie[1]
        return tWordCount[root]
    }

    curr = root
    tChildren = trie[0]
    alphaSize = trie[5]
    i = 0
    while (i < wordLen) {
        charCode = str.charCodeAt(word, i)
        cIdx = charToIndex(charCode)
        if (cIdx < 0) {
            return 0
        }
        nxt = tChildren[curr * alphaSize + cIdx]
        if (nxt == -1) {
            return 0
        }
        curr = nxt
        i = i + 1
    }

    tWordCount = trie[1]
    return tWordCount[curr]
}

func startsWithPrefix(trie, root, prefix) {
    if (root == -1) {
        return 0
    }
    prefLen = str.length(prefix)
    if (prefLen == 0) {
        tPrefixCount = trie[2]
        if (tPrefixCount[root] > 0) {
            return 1
        }
        return 0
    }

    curr = root
    tChildren = trie[0]
    alphaSize = trie[5]
    i = 0
    while (i < prefLen) {
        charCode = str.charCodeAt(prefix, i)
        cIdx = charToIndex(charCode)
        if (cIdx < 0) {
            return 0
        }
        nxt = tChildren[curr * alphaSize + cIdx]
        if (nxt == -1) {
            return 0
        }
        curr = nxt
        i = i + 1
    }

    tPrefixCount = trie[2]
    if (tPrefixCount[curr] > 0) {
        return 1
    }
    return 0
}

func countPrefix(trie, root, prefix) {
    if (root == -1) {
        return 0
    }
    prefLen = str.length(prefix)
    if (prefLen == 0) {
        tPrefixCount = trie[2]
        return tPrefixCount[root]
    }

    curr = root
    tChildren = trie[0]
    alphaSize = trie[5]
    i = 0
    while (i < prefLen) {
        charCode = str.charCodeAt(prefix, i)
        cIdx = charToIndex(charCode)
        if (cIdx < 0) {
            return 0
        }
        nxt = tChildren[curr * alphaSize + cIdx]
        if (nxt == -1) {
            return 0
        }
        curr = nxt
        i = i + 1
    }

    tPrefixCount = trie[2]
    return tPrefixCount[curr]
}

func countTotalWords(trie, root) {
    if (root == -1) {
        return 0
    }
    tPrefixCount = trie[2]
    return tPrefixCount[root]
}

func findPrefixNode(trie, root, prefix) {
    if (root == -1) {
        return -1
    }
    prefLen = str.length(prefix)
    if (prefLen == 0) {
        return root
    }
    curr = root
    tChildren = trie[0]
    alphaSize = trie[5]
    i = 0
    while (i < prefLen) {
        charCode = str.charCodeAt(prefix, i)
        cIdx = charToIndex(charCode)
        if (cIdx < 0) {
            return -1
        }
        nxt = tChildren[curr * alphaSize + cIdx]
        if (nxt == -1) {
            return -1
        }
        curr = nxt
        i = i + 1
    }
    return curr
}

func longestCommonPrefix(trie, root, word) {
    if (root == -1) {
        return 0
    }
    wordLen = str.length(word)
    if (wordLen == 0) {
        return 0
    }
    curr = root
    tChildren = trie[0]
    alphaSize = trie[5]
    matchedLen = 0
    while (matchedLen < wordLen) {
        charCode = str.charCodeAt(word, matchedLen)
        cIdx = charToIndex(charCode)
        if (cIdx < 0) {
            return matchedLen
        }
        nxt = tChildren[curr * alphaSize + cIdx]
        if (nxt == -1) {
            return matchedLen
        }
        curr = nxt
        matchedLen = matchedLen + 1
    }
    return matchedLen
}

func dfsCollectWords(trie, node, currentWord, charMap, outList, maxLimit) {
    if (outList.size() >= maxLimit) {
        return
    }
    tChildren = trie[0]
    tWordCount = trie[1]
    alphaSize = trie[5]

    c = 0
    while (c < alphaSize and outList.size() < maxLimit) {
        child = tChildren[node * alphaSize + c]
        if (child != -1) {
            nextWord = currentWord + charMap[c]
            if (tWordCount[child] > 0) {
                outList.push(nextWord)
            }
            dfsCollectWords(trie, child, nextWord, charMap, outList, maxLimit)
        }
        c = c + 1
    }
}

func collectWordsWithPrefix(trie, root, prefix, maxLimit) {
    outList = []
    if (root == -1) {
        return outList
    }
    prefNode = findPrefixNode(trie, root, prefix)
    if (prefNode == -1) {
        return outList
    }
    tWordCount = trie[1]
    if (tWordCount[prefNode] > 0) {
        outList.push(prefix)
    }
    charMap = [
        "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m",
        "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"
    ]
    dfsCollectWords(trie, prefNode, prefix, charMap, outList, maxLimit)
    return outList
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Version Updates and Exact Matching
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Version Updates and Exact Matching...")
trie = createPersistentTrie()
versionRoots = []

// Version 0: Empty root
v0 = allocNode(trie, -1, 0)
versionRoots.push(v0)

if (countTotalWords(trie, v0) != 0) {
    print("[FAIL] Version 0 total words expected 0, got", countTotalWords(trie, v0))
}
if (containsWord(trie, v0, "apple") != 0) {
    print("[FAIL] Version 0 should not contain apple")
}
print("  Version 0 baseline verified: total words =", countTotalWords(trie, v0))

// Version 1: Insert "apple"
v1 = insertWord(trie, v0, "apple")
versionRoots.push(v1)

if (containsWord(trie, v1, "apple") != 1) {
    print("[FAIL] Version 1 should contain apple")
}
if (containsWord(trie, v1, "app") != 0) {
    print("[FAIL] Version 1 should not contain exact word app")
}
if (startsWithPrefix(trie, v1, "app") != 1) {
    print("[FAIL] Version 1 prefix app should exist")
}
if (countPrefix(trie, v1, "app") != 1) {
    print("[FAIL] Version 1 prefix app count expected 1, got", countPrefix(trie, v1, "app"))
}
if (countTotalWords(trie, v1) != 1) {
    print("[FAIL] Version 1 total words expected 1, got", countTotalWords(trie, v1))
}
print("  Version 1 verified: apple inserted, total words =", countTotalWords(trie, v1))

// Version 0 immutability check
if (containsWord(trie, v0, "apple") != 0 or countTotalWords(trie, v0) != 0) {
    print("[FAIL] Version 0 was mutated after Version 1 insertion!")
} else {
    print("  Version 0 immutability preserved after Version 1 insertion")
}

// Version 2: Insert "app" into Version 1
v2 = insertWord(trie, v1, "app")
versionRoots.push(v2)

if (containsWord(trie, v2, "app") != 1 or containsWord(trie, v2, "apple") != 1) {
    print("[FAIL] Version 2 should contain both app and apple")
}
if (countPrefix(trie, v2, "app") != 2) {
    print("[FAIL] Version 2 prefix app count expected 2, got", countPrefix(trie, v2, "app"))
}
if (countPrefix(trie, v2, "appl") != 1) {
    print("[FAIL] Version 2 prefix appl count expected 1, got", countPrefix(trie, v2, "appl"))
}
if (countTotalWords(trie, v2) != 2) {
    print("[FAIL] Version 2 total words expected 2, got", countTotalWords(trie, v2))
}
print("  Version 2 verified: app inserted, prefix app count =", countPrefix(trie, v2, "app"))

// Version 1 immutability check
if (containsWord(trie, v1, "app") != 0 or countPrefix(trie, v1, "app") != 1) {
    print("[FAIL] Version 1 was mutated after Version 2 insertion!")
} else {
    print("  Version 1 immutability preserved: app absent, prefix app count = 1")
}

// Version 3: Insert "application" into Version 2
v3 = insertWord(trie, v2, "application")
versionRoots.push(v3)

if (containsWord(trie, v3, "application") != 1) {
    print("[FAIL] Version 3 should contain application")
}
if (countPrefix(trie, v3, "app") != 3) {
    print("[FAIL] Version 3 prefix app count expected 3, got", countPrefix(trie, v3, "app"))
}
if (countPrefix(trie, v3, "applic") != 1) {
    print("[FAIL] Version 3 prefix applic count expected 1, got", countPrefix(trie, v3, "applic"))
}
if (countTotalWords(trie, v3) != 3) {
    print("[FAIL] Version 3 total words expected 3, got", countTotalWords(trie, v3))
}
print("  Version 3 verified: application inserted, prefix app count =", countPrefix(trie, v3, "app"))

// Version 4: Insert "banana" into Version 3
v4 = insertWord(trie, v3, "banana")
versionRoots.push(v4)

if (containsWord(trie, v4, "banana") != 1) {
    print("[FAIL] Version 4 should contain banana")
}
if (countPrefix(trie, v4, "b") != 1) {
    print("[FAIL] Version 4 prefix b count expected 1, got", countPrefix(trie, v4, "b"))
}
if (countPrefix(trie, v4, "app") != 3) {
    print("[FAIL] Version 4 prefix app count expected 3, got", countPrefix(trie, v4, "app"))
}
if (countTotalWords(trie, v4) != 4) {
    print("[FAIL] Version 4 total words expected 4, got", countTotalWords(trie, v4))
}
print("  Version 4 verified: banana inserted, total words =", countTotalWords(trie, v4))

// Version 5: Insert "band" into Version 4
v5 = insertWord(trie, v4, "band")
versionRoots.push(v5)

if (containsWord(trie, v5, "band") != 1) {
    print("[FAIL] Version 5 should contain band")
}
if (countPrefix(trie, v5, "ba") != 2) {
    print("[FAIL] Version 5 prefix ba count expected 2, got", countPrefix(trie, v5, "ba"))
}
if (countPrefix(trie, v5, "ban") != 2) {
    print("[FAIL] Version 5 prefix ban count expected 2, got", countPrefix(trie, v5, "ban"))
}
if (countTotalWords(trie, v5) != 5) {
    print("[FAIL] Version 5 total words expected 5, got", countTotalWords(trie, v5))
}
print("  Version 5 verified: band inserted, prefix ba count =", countPrefix(trie, v5, "ba"))

// Version 6: Insert "bandwidth" into Version 5
v6 = insertWord(trie, v5, "bandwidth")
versionRoots.push(v6)

if (containsWord(trie, v6, "bandwidth") != 1) {
    print("[FAIL] Version 6 should contain bandwidth")
}
if (countPrefix(trie, v6, "band") != 2) {
    print("[FAIL] Version 6 prefix band count expected 2, got", countPrefix(trie, v6, "band"))
}
if (countPrefix(trie, v6, "ban") != 3) {
    print("[FAIL] Version 6 prefix ban count expected 3, got", countPrefix(trie, v6, "ban"))
}
if (countPrefix(trie, v6, "b") != 3) {
    print("[FAIL] Version 6 prefix b count expected 3, got", countPrefix(trie, v6, "b"))
}
if (countTotalWords(trie, v6) != 6) {
    print("[FAIL] Version 6 total words expected 6, got", countTotalWords(trie, v6))
}
print("  Version 6 verified: bandwidth inserted, total words =", countTotalWords(trie, v6))

// Historical validation of all previous versions after Version 6
print("  Validating complete historical chain immutability [V0 .. V5]:")
if (countTotalWords(trie, v0) != 0) { print("[FAIL] V0 corrupted") }
if (countTotalWords(trie, v1) != 1 or containsWord(trie, v1, "apple") != 1 or containsWord(trie, v1, "app") != 0) { print("[FAIL] V1 corrupted") }
if (countTotalWords(trie, v2) != 2 or containsWord(trie, v2, "app") != 1 or containsWord(trie, v2, "application") != 0) { print("[FAIL] V2 corrupted") }
if (countTotalWords(trie, v3) != 3 or containsWord(trie, v3, "banana") != 0) { print("[FAIL] V3 corrupted") }
if (countTotalWords(trie, v4) != 4 or containsWord(trie, v4, "band") != 0) { print("[FAIL] V4 corrupted") }
if (countTotalWords(trie, v5) != 5 or containsWord(trie, v5, "bandwidth") != 0) { print("[FAIL] V5 corrupted") }
print("  Historical chain immutability check PASSED across all 7 versions")

elapsed = t.millis() - suiteStartTime
print("Test Case 1 finished in", elapsed, "ms")

// -----------------------------------------------------------------------------
// Test Case 2: Historical Version Rollback and Non-Chronological Queries
// -----------------------------------------------------------------------------
print("\nRunning Test Case 2: Historical Version Rollback and Non-Chronological Queries...")

// Non-chronological sequence: V4 -> V1 -> V5 -> V2 -> V6 -> V0 -> V3
// Query Version 4
if (containsWord(trie, v4, "banana") != 1 or containsWord(trie, v4, "band") != 0) {
    print("[FAIL] V4 query mismatch: banana should exist, band should not")
}
if (countTotalWords(trie, v4) != 4) {
    print("[FAIL] V4 word count expected 4, got", countTotalWords(trie, v4))
}
v4BanWords = collectWordsWithPrefix(trie, v4, "ban", 10)
if (v4BanWords.size() != 1 or v4BanWords[0] != "banana") {
    print("[FAIL] V4 ban prefix collection mismatch")
}

// Query Version 1
if (containsWord(trie, v1, "apple") != 1 or containsWord(trie, v1, "app") != 0) {
    print("[FAIL] V1 query mismatch: apple should exist, app should not")
}
v1AppWords = collectWordsWithPrefix(trie, v1, "app", 10)
if (v1AppWords.size() != 1 or v1AppWords[0] != "apple") {
    print("[FAIL] V1 app prefix collection mismatch")
}

// Query Version 5
if (containsWord(trie, v5, "band") != 1 or containsWord(trie, v5, "bandwidth") != 0) {
    print("[FAIL] V5 query mismatch: band should exist, bandwidth should not")
}
if (countPrefix(trie, v5, "ba") != 2) {
    print("[FAIL] V5 prefix ba count expected 2, got", countPrefix(trie, v5, "ba"))
}

// Query Version 2
if (containsWord(trie, v2, "app") != 1 or containsWord(trie, v2, "apple") != 1 or containsWord(trie, v2, "application") != 0) {
    print("[FAIL] V2 query mismatch")
}
v2AppWords = collectWordsWithPrefix(trie, v2, "app", 10)
if (v2AppWords.size() != 2 or v2AppWords[0] != "app" or v2AppWords[1] != "apple") {
    print("[FAIL] V2 app prefix collection mismatch, expected [app, apple]")
}

// Query Version 6
if (containsWord(trie, v6, "bandwidth") != 1 or countTotalWords(trie, v6) != 6) {
    print("[FAIL] V6 query mismatch")
}
v6BandWords = collectWordsWithPrefix(trie, v6, "band", 10)
if (v6BandWords.size() != 2 or v6BandWords[0] != "band" or v6BandWords[1] != "bandwidth") {
    print("[FAIL] V6 band prefix collection mismatch, expected [band, bandwidth]")
}

// Query Version 0
if (countTotalWords(trie, v0) != 0) {
    print("[FAIL] V0 word count expected 0, got", countTotalWords(trie, v0))
}
v0Words = collectWordsWithPrefix(trie, v0, "", 10)
if (v0Words.size() != 0) {
    print("[FAIL] V0 word collection expected empty, got size", v0Words.size())
}

// Query Version 3
if (containsWord(trie, v3, "application") != 1 or containsWord(trie, v3, "banana") != 0) {
    print("[FAIL] V3 query mismatch")
}
v3AppWords = collectWordsWithPrefix(trie, v3, "app", 10)
if (v3AppWords.size() != 3 or v3AppWords[0] != "app" or v3AppWords[1] != "apple" or v3AppWords[2] != "application") {
    print("[FAIL] V3 app prefix collection mismatch, expected [app, apple, application]")
}

// Rollback validation: simulate active pointer rollback to Version 2
activeRoot = v2
print("  Active pointer rolled back to Version 2 (total words:", countTotalWords(trie, activeRoot), ")")
if (containsWord(trie, activeRoot, "app") != 1 or containsWord(trie, activeRoot, "apple") != 1) {
    print("[FAIL] Rollback active root missing baseline words")
}
if (containsWord(trie, activeRoot, "application") != 0 or containsWord(trie, activeRoot, "banana") != 0) {
    print("[FAIL] Rollback active root contains future version words")
}
print("  Test Case 2 Passed historical rollback and non-chronological query validation")

// -----------------------------------------------------------------------------
// Test Case 3: Timeline Forking and Branching
// -----------------------------------------------------------------------------
print("\nRunning Test Case 3: Timeline Forking and Branching...")

// Fork A branches from Version 2 (which has: app, apple)
// Insert "apply", then "aptitude"
vForkA1 = insertWord(trie, v2, "apply")
vForkA2 = insertWord(trie, vForkA1, "aptitude")

if (countTotalWords(trie, vForkA2) != 4) {
    print("[FAIL] Fork A2 word count expected 4, got", countTotalWords(trie, vForkA2))
}
if (containsWord(trie, vForkA2, "app") != 1 or containsWord(trie, vForkA2, "apple") != 1) {
    print("[FAIL] Fork A2 missing ancestral words")
}
if (containsWord(trie, vForkA2, "apply") != 1 or containsWord(trie, vForkA2, "aptitude") != 1) {
    print("[FAIL] Fork A2 missing newly branched words")
}
if (containsWord(trie, vForkA2, "application") != 0 or containsWord(trie, vForkA2, "banana") != 0) {
    print("[FAIL] Fork A2 leaked words from main trunk!")
}
forkAWords = collectWordsWithPrefix(trie, vForkA2, "app", 10)
if (forkAWords.size() != 3 or forkAWords[0] != "app" or forkAWords[1] != "apple" or forkAWords[2] != "apply") {
    print("[FAIL] Fork A2 prefix app words expected [app, apple, apply]")
}
print("  Fork A created successfully with 4 words (prefix app count:", countPrefix(trie, vForkA2, "app"), ")")

// Fork B also branches from Version 2 (independent parallel timeline)
// Insert "approach", then "approval"
vForkB1 = insertWord(trie, v2, "approach")
vForkB2 = insertWord(trie, vForkB1, "approval")

if (countTotalWords(trie, vForkB2) != 4) {
    print("[FAIL] Fork B2 word count expected 4, got", countTotalWords(trie, vForkB2))
}
if (containsWord(trie, vForkB2, "approach") != 1 or containsWord(trie, vForkB2, "approval") != 1) {
    print("[FAIL] Fork B2 missing newly branched words")
}
if (containsWord(trie, vForkB2, "apply") != 0 or containsWord(trie, vForkB2, "aptitude") != 0) {
    print("[FAIL] Fork B2 contaminated with words from Fork A!")
}
if (containsWord(trie, vForkB2, "application") != 0 or containsWord(trie, vForkB2, "bandwidth") != 0) {
    print("[FAIL] Fork B2 contaminated with words from trunk!")
}
forkBWords = collectWordsWithPrefix(trie, vForkB2, "app", 10)
if (forkBWords.size() != 4 or forkBWords[0] != "app" or forkBWords[1] != "apple" or forkBWords[2] != "approach" or forkBWords[3] != "approval") {
    print("[FAIL] Fork B2 prefix app words expected [app, apple, approach, approval]")
}
print("  Fork B created successfully with 4 words, zero cross-talk with Fork A")

// Fork C branches from Version 0 (Empty root)
// Completely independent vocabulary: "cat", "caterpillar", "dog"
vForkC1 = insertWord(trie, v0, "cat")
vForkC2 = insertWord(trie, vForkC1, "caterpillar")
vForkC3 = insertWord(trie, vForkC2, "dog")

if (countTotalWords(trie, vForkC3) != 3) {
    print("[FAIL] Fork C3 word count expected 3, got", countTotalWords(trie, vForkC3))
}
if (containsWord(trie, vForkC3, "cat") != 1 or containsWord(trie, vForkC3, "caterpillar") != 1 or containsWord(trie, vForkC3, "dog") != 1) {
    print("[FAIL] Fork C3 missing words")
}
if (containsWord(trie, vForkC3, "apple") != 0 or containsWord(trie, vForkC3, "banana") != 0) {
    print("[FAIL] Fork C3 contaminated with words from other trees!")
}
if (countPrefix(trie, vForkC3, "cat") != 2) {
    print("[FAIL] Fork C3 prefix cat count expected 2, got", countPrefix(trie, vForkC3, "cat"))
}
print("  Fork C created from empty root, 3 isolated words verified")

// Trunk integrity verification: Version 2 and Version 6 MUST remain unaltered
if (countTotalWords(trie, v2) != 2 or containsWord(trie, v2, "apply") != 0 or containsWord(trie, v2, "approach") != 0) {
    print("[FAIL] Trunk Version 2 corrupted by forking branches!")
} else {
    print("  Trunk Version 2 strictly preserved: 2 words, zero branch leakage")
}
if (countTotalWords(trie, v6) != 6 or containsWord(trie, v6, "apply") != 0 or containsWord(trie, v6, "approval") != 0 or containsWord(trie, v6, "cat") != 0) {
    print("[FAIL] Trunk Version 6 corrupted by forking branches!")
} else {
    print("  Trunk Version 6 strictly preserved: 6 words, zero branch leakage")
}
print("  Test Case 3 Passed timeline forking and branching isolation verification")

// -----------------------------------------------------------------------------
// Test Case 4: Boundary Edge Cases, Deletion, and Longest Common Prefix
// -----------------------------------------------------------------------------
print("\nRunning Test Case 4: Boundary Edge Cases, Deletion, and Longest Common Prefix...")

// 4.1 Empty string insertion and deletion
vEmptyBase = allocNode(trie, -1, 0)
if (containsWord(trie, vEmptyBase, "") != 0 or countTotalWords(trie, vEmptyBase) != 0) {
    print("[FAIL] Empty base trie should not contain empty string")
}

vWithEmpty = insertWord(trie, vEmptyBase, "")
if (containsWord(trie, vWithEmpty, "") != 1 or countTotalWords(trie, vWithEmpty) != 1) {
    print("[FAIL] Empty string insertion failed")
}
if (containsWord(trie, vEmptyBase, "") != 0) {
    print("[FAIL] Immutability violated for empty base")
}

vAfterRemoveEmpty = removeWord(trie, vWithEmpty, "")
if (containsWord(trie, vAfterRemoveEmpty, "") != 0 or countTotalWords(trie, vAfterRemoveEmpty) != 0) {
    print("[FAIL] Empty string deletion failed")
}
print("  Edge Case 4.1 Passed empty string insertion, query, and deletion")

// 4.2 Single character strings
vSingleBase = allocNode(trie, -1, 0)
vSingle1 = insertWord(trie, vSingleBase, "a")
vSingle2 = insertWord(trie, vSingle1, "z")
vSingle3 = insertWord(trie, vSingle2, "m")

if (containsWord(trie, vSingle3, "a") != 1 or containsWord(trie, vSingle3, "z") != 1 or containsWord(trie, vSingle3, "m") != 1) {
    print("[FAIL] Single character word lookup failed")
}
if (containsWord(trie, vSingle3, "b") != 0 or containsWord(trie, vSingle3, "y") != 0) {
    print("[FAIL] Non-existent single character word falsely reported")
}
if (countPrefix(trie, vSingle3, "a") != 1 or countPrefix(trie, vSingle3, "z") != 1) {
    print("[FAIL] Single character prefix count mismatch")
}
print("  Edge Case 4.2 Passed single-character boundaries")

// 4.3 Deep repeated prefix chain
vChain0 = allocNode(trie, -1, 0)
vChain1 = insertWord(trie, vChain0, "a")
vChain2 = insertWord(trie, vChain1, "aa")
vChain3 = insertWord(trie, vChain2, "aaa")
vChain4 = insertWord(trie, vChain3, "aaaa")
vChain5 = insertWord(trie, vChain4, "aaaaa")

if (countTotalWords(trie, vChain5) != 5) {
    print("[FAIL] Repeated chain word count expected 5, got", countTotalWords(trie, vChain5))
}
if (countPrefix(trie, vChain5, "a") != 5 or countPrefix(trie, vChain5, "aa") != 4 or countPrefix(trie, vChain5, "aaa") != 3) {
    print("[FAIL] Repeated prefix chain count mismatch")
}
if (countPrefix(trie, vChain5, "aaaa") != 2 or countPrefix(trie, vChain5, "aaaaa") != 1) {
    print("[FAIL] Repeated prefix chain tail count mismatch")
}
chainWords = collectWordsWithPrefix(trie, vChain5, "aa", 10)
if (chainWords.size() != 4 or chainWords[0] != "aa" or chainWords[1] != "aaa" or chainWords[2] != "aaaa" or chainWords[3] != "aaaaa") {
    print("[FAIL] Repeated prefix chain collection mismatch")
}
print("  Edge Case 4.3 Passed deep repeated prefix chain verification")

// 4.4 Longest Common Prefix (LCP) evaluation
vLcp0 = allocNode(trie, -1, 0)
vLcp1 = insertWord(trie, vLcp0, "internationalization")
vLcp2 = insertWord(trie, vLcp1, "international")
vLcp3 = insertWord(trie, vLcp2, "internet")
vLcp4 = insertWord(trie, vLcp3, "internal")

if (longestCommonPrefix(trie, vLcp4, "internationalization") != 20) {
    print("[FAIL] LCP internationalization expected 20, got", longestCommonPrefix(trie, vLcp4, "internationalization"))
}
if (longestCommonPrefix(trie, vLcp4, "internationalize") != 15) {
    print("[FAIL] LCP internationalize expected 15, got", longestCommonPrefix(trie, vLcp4, "internationalize"))
}
if (longestCommonPrefix(trie, vLcp4, "internetworking") != 8) {
    print("[FAIL] LCP internetworking expected 8, got", longestCommonPrefix(trie, vLcp4, "internetworking"))
}
if (longestCommonPrefix(trie, vLcp4, "internalize") != 8) {
    print("[FAIL] LCP internalize expected 8, got", longestCommonPrefix(trie, vLcp4, "internalize"))
}
if (longestCommonPrefix(trie, vLcp4, "interpret") != 5) {
    print("[FAIL] LCP interpret expected 5, got", longestCommonPrefix(trie, vLcp4, "interpret"))
}
if (longestCommonPrefix(trie, vLcp4, "quantum") != 0) {
    print("[FAIL] LCP quantum expected 0, got", longestCommonPrefix(trie, vLcp4, "quantum"))
}
print("  Edge Case 4.4 Passed Longest Common Prefix (LCP) assertions")

// 4.5 Duplicate word insertions and frequency counting
vDup0 = allocNode(trie, -1, 0)
vDup1 = insertWord(trie, vDup0, "echo")
vDup2 = insertWord(trie, vDup1, "echo")
vDup3 = insertWord(trie, vDup2, "echo")

if (countWord(trie, vDup3, "echo") != 3) {
    print("[FAIL] Duplicate word count expected 3, got", countWord(trie, vDup3, "echo"))
}
if (countPrefix(trie, vDup3, "ec") != 3) {
    print("[FAIL] Duplicate word prefix count expected 3, got", countPrefix(trie, vDup3, "ec"))
}
if (countTotalWords(trie, vDup3) != 3) {
    print("[FAIL] Duplicate word total count expected 3, got", countTotalWords(trie, vDup3))
}

// Remove 1 occurrence of duplicate word
vDupRem1 = removeWord(trie, vDup3, "echo")
if (countWord(trie, vDupRem1, "echo") != 2 or countTotalWords(trie, vDupRem1) != 2) {
    print("[FAIL] After 1st deletion expected word count 2, got", countWord(trie, vDupRem1, "echo"))
}
if (countWord(trie, vDup3, "echo") != 3) {
    print("[FAIL] Ancestral snapshot corrupted after deletion")
}

// Remove non-existent word (No-op validation)
vNoOp = removeWord(trie, vDupRem1, "phantom")
if (vNoOp != vDupRem1 or countWord(trie, vNoOp, "echo") != 2) {
    print("[FAIL] Deletion of non-existent word failed to return unchanged root")
}
print("  Edge Case 4.5 Passed duplicate frequency and no-op deletion handling")

// 4.6 Persistent Deletion from Trunk Version 6
// Remove "band" from Version 6 (which contains: apple, app, application, banana, band, bandwidth)
v6DelBand = removeWord(trie, v6, "band")

if (containsWord(trie, v6DelBand, "band") != 0) {
    print("[FAIL] v6DelBand should no longer contain exact word band")
}
if (containsWord(trie, v6DelBand, "bandwidth") != 1) {
    print("[FAIL] v6DelBand must preserve bandwidth")
}
if (countPrefix(trie, v6DelBand, "band") != 1) {
    print("[FAIL] v6DelBand prefix band count expected 1 (bandwidth), got", countPrefix(trie, v6DelBand, "band"))
}
if (countPrefix(trie, v6DelBand, "ban") != 2) {
    print("[FAIL] v6DelBand prefix ban count expected 2 (banana, bandwidth), got", countPrefix(trie, v6DelBand, "ban"))
}
if (countTotalWords(trie, v6DelBand) != 5) {
    print("[FAIL] v6DelBand total words expected 5, got", countTotalWords(trie, v6DelBand))
}

// Immutability of Version 6 confirmed
if (containsWord(trie, v6, "band") != 1 or countPrefix(trie, v6, "band") != 2 or countTotalWords(trie, v6) != 6) {
    print("[FAIL] Version 6 was mutated by deletion branch!")
} else {
    print("  Version 6 immutability strictly confirmed: band still present with count 6")
}
print("  Edge Case 4.6 Passed persistent deletion and branch isolation")
print("  Test Case 4 Passed all boundary edge case assertions")

