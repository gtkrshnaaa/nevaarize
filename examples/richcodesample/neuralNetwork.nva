import stdlib ai as ai
import stdlib math as m
import stdlib time as t

// Neural Network Simulation for XOR-like problem
// Demonstrates Nevaarize's JIT-accelerated AI module without struct wrapping

print("Starting AI Training Simulation...")
start = t.millis()

// Layer dimensions
inputDim = 2
hiddenDim = 4
outputDim = 2

// Layer 1 weights and biases (no struct)
w1 = ai.RandN(inputDim, hiddenDim)
limit1 = m.Sqrt(2.0 / (inputDim + hiddenDim))
ai.Scale(w1, limit1)
b1 = ai.Zeros(1, hiddenDim)

// Layer 2 weights and biases
w2 = ai.RandN(hiddenDim, outputDim)
limit2 = m.Sqrt(2.0 / (hiddenDim + outputDim))
ai.Scale(w2, limit2)
b2 = ai.Zeros(1, outputDim)

// Mock data (4 samples of 2 inputs)
x = ai.RandN(4, inputDim)
y = ai.Zeros(4, outputDim)

// Training loop (synchronous, no async struct returns)
epoch = 0
while (epoch < 5) {
    // Forward Layer 1
    z1 = ai.MatMul(x, w1)
    ai.Add(z1, b1)
    a1 = ai.ReLU(z1)

    // Forward Layer 2
    z2 = ai.MatMul(a1, w2)
    ai.Add(z2, b2)
    output = ai.Softmax(z2)

    // Loss
    loss = ai.CrossEntropyLoss(output, y)
    print("Epoch", epoch, "- Loss:", loss)

    epoch = epoch + 1
}

elapsed = t.millis() - start
print("Training simulation finished in", elapsed, "ms")
print("Final weights initialized and forward passes completed.")
