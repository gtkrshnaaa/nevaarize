import stdlib string as s
import stdlib time as t

// Aho-Corasick Multi-Pattern Dictionary Matching Automaton Suite
// Linear-time simultaneous multi-keyword search with failure and output links
//
// Time Complexity:
// - O(sum(|P_i| * Sigma)) trie and BFS automaton construction
// - O(|Text| + TotalMatches) linear text stream processing
// Space Complexity: O(sum(|P_i|) * Sigma) compact state transitions
//
// Technical characteristics:
// - Prefix trie with root at node 0
// - Breadth-First Search (BFS) failure link calculation (longest matching suffix)
// - Dictionary/output link shortcut chain to accelerate reporting overlapping patterns
// - Complete DFA transition table construction avoiding runtime fail-pointer traversal loops
// - Match recovery with exact start positions, end positions, and pattern identity indices
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Aho-Corasick Multi-Pattern Matching Suite ===")
globalStartTime = t.millis()

func makeIntArray(sz, fillVal) {
    arr = []
    i = 0
    while (i < sz) {
        arr.push(fillVal)
        i = i + 1
    }
    return arr
}

func createAhoCorasick(maxNodes) {
    nextTable = makeIntArray(maxNodes * 128, -1)
    failLink = makeIntArray(maxNodes, 0)
    dictLink = makeIntArray(maxNodes, 0)
    patMatch = makeIntArray(maxNodes, -1)
    nodeDepth = makeIntArray(maxNodes, 0)

    return [1, nextTable, failLink, dictLink, patMatch, nodeDepth, maxNodes]
}

func insertPattern(ac, patternStr, patternId) {
    nextTable = ac[1]
    patMatch = ac[4]
    nodeDepth = ac[5]

    patLen = s.length(patternStr)
    cur = 0
    idx = 0

    while (idx < patLen) {
        c = s.charCodeAt(patternStr, idx)
        nxt = nextTable[cur * 128 + c]
        if (nxt == -1) {
            sz = ac[0]
            nxt = sz
            ac[0] = sz + 1
            nextTable[cur * 128 + c] = nxt
            nodeDepth[nxt] = nodeDepth[cur] + 1
        }
        cur = nxt
        idx = idx + 1
    }

    patMatch[cur] = patternId
    return cur
}

func buildAhoCorasickAutomaton(ac) {
    sz = ac[0]
    nextTable = ac[1]
    failLink = ac[2]
    dictLink = ac[3]
    patMatch = ac[4]

    queue = []
    qHead = 0

    // Initialize root children (depth 1)
    c = 0
    while (c < 128) {
        child = nextTable[0 * 128 + c]
        if (child != -1) {
            failLink[child] = 0
            dictLink[child] = 0
            queue.push(child)
        } else {
            nextTable[0 * 128 + c] = 0
        }
        c = c + 1
    }

    // BFS order traversal
    while (qHead < queue.size()) {
        u = queue[qHead]
        qHead = qHead + 1

        c = 0
        while (c < 128) {
            child = nextTable[u * 128 + c]
            if (child != -1) {
                // Failure link is transition c from failLink[u]
                uFail = failLink[u]
                failTarget = nextTable[uFail * 128 + c]
                failLink[child] = failTarget

                // Dictionary link: shortcut to nearest ancestor matching pattern
                if (patMatch[failTarget] != -1) {
                    dictLink[child] = failTarget
                } else {
                    dictLink[child] = dictLink[failTarget]
                }

                queue.push(child)
            } else {
                // Complete DFA edge redirection: missing transitions point to fail state
                uFail = failLink[u]
                nextTable[u * 128 + c] = nextTable[uFail * 128 + c]
            }
            c = c + 1
        }
    }
}

func searchAhoCorasick(ac, text, patternList) {
    nextTable = ac[1]
    dictLink = ac[3]
    patMatch = ac[4]

    textLen = s.length(text)
    cur = 0
    matches = []

    idx = 0
    while (idx < textLen) {
        c = s.charCodeAt(text, idx)
        cur = nextTable[cur * 128 + c]

        // Check if current node is a pattern match
        checkNode = cur
        while (checkNode > 0) {
            pId = patMatch[checkNode]
            if (pId != -1) {
                pStr = patternList[pId]
                pLen = s.length(pStr)
                startPos = idx - pLen + 1
                // Record: [patternId, startPos, endPos]
                matches.push(pId)
                matches.push(startPos)
                matches.push(idx)
            }
            checkNode = dictLink[checkNode]
        }

        idx = idx + 1
    }

    return matches
}

func runAhoCorasickTestCase(testNum, testName, patternList, text, expectedMatchCount, verifySamples) {
    print("Running Test Case " + testNum + ": " + testName + "...")

    // Calculate maximum states needed: sum of pattern lengths + 10
    totalChars = 0
    i = 0
    while (i < patternList.size()) {
        totalChars = totalChars + s.length(patternList[i])
        i = i + 1
    }

    ac = createAhoCorasick(totalChars + 20)
    pIdx = 0
    while (pIdx < patternList.size()) {
        insertPattern(ac, patternList[pIdx], pIdx)
        pIdx = pIdx + 1
    }

    buildAhoCorasickAutomaton(ac)
    totalStates = ac[0]

    matchesFlat = searchAhoCorasick(ac, text, patternList)
    matchCount = matchesFlat.size() / 3

    print("  Pattern Count     :", patternList.size(), "Total Characters:", totalChars)
    print("  Trie DFA States   :", totalStates)
    print("  Text Length       :", s.length(text))
    print("  Total Matches     :", matchCount, "(Expected:", expectedMatchCount, ")")

    if (matchCount != expectedMatchCount) {
        print("  [FAIL] Match count mismatch: got", matchCount, "expected", expectedMatchCount)
        return false
    }

    // Verify deterministic matches
    vIdx = 0
    while (vIdx < verifySamples.size()) {
        reqPatId = verifySamples[vIdx]
        reqStartPos = verifySamples[vIdx + 1]

        foundReq = false
        mIdx = 0
        while (mIdx < matchesFlat.size() and !foundReq) {
            mPatId = matchesFlat[mIdx]
            mStart = matchesFlat[mIdx + 1]
            if (mPatId == reqPatId and mStart == reqStartPos) {
                foundReq = true
            }
            mIdx = mIdx + 3
        }

        if (!foundReq) {
            print("  [FAIL] Required match sample not found: patternId", reqPatId, "(" + patternList[reqPatId] + ") at start", reqStartPos)
            return false
        }
        vIdx = vIdx + 2
    }

    print("  Match Sample Checks: ALL VERIFIED (" + (verifySamples.size() / 2) + " checks)")
    print("  Test Case " + testNum + " PASSED")
    return true
}

allAcPassed = true

// --- Test Case 1: Classic Overlapping Keywords ---
// Patterns: 0:"he", 1:"she", 2:"his", 3:"hers"
// Text: "ushers"
// Matches: "she" at 1, "he" at 2, "hers" at 2. Total 3 matches.
p1 = ["he", "she", "his", "hers"]
samples1 = [
    1, 1, // "she" at 1
    0, 2, // "he" at 2
    3, 2  // "hers" at 2
]
if (!runAhoCorasickTestCase(1, "Classic Overlapping Keywords", p1, "ushers", 3, samples1)) {
    allAcPassed = false
}

// --- Test Case 2: DNA Genomic Subsequence Multi-Target ---
// Patterns: 0:"AG", 1:"GA", 2:"AGC", 3:"GCA", 4:"CAG", 5:"TC"
// Text: "AGCAGTC"
// Expected matches:
// idx 0..1: "AG" (pos 0)
// idx 0..2: "AGC" (pos 0)
// idx 1..3: "GCA" (pos 1)
// idx 2..4: "CAG" (pos 2)
// idx 3..4: "AG" (pos 3)
// idx 5..6: "TC" (pos 5)
// Total matches: 6
p2 = ["AG", "GA", "AGC", "GCA", "CAG", "TC"]
samples2 = [
    0, 0, // "AG" at 0
    2, 0, // "AGC" at 0
    3, 1, // "GCA" at 1
    4, 2, // "CAG" at 2
    0, 3, // "AG" at 3
    5, 5  // "TC" at 5
]
if (!runAhoCorasickTestCase(2, "Genomic DNA Subsequences", p2, "AGCAGTC", 6, samples2)) {
    allAcPassed = false
}

// --- Test Case 3: Embedded Suffix-Prefix Repetitions ---
// Patterns: 0:"a", 1:"aa", 2:"aaa", 3:"aaaa"
// Text: "aaaa"
// Total matches = 1 + 2 + 3 + 4 = 10
p3 = ["a", "aa", "aaa", "aaaa"]
samples3 = [
    0, 0, // "a" at 0
    1, 0, // "aa" at 0
    2, 0, // "aaa" at 0
    3, 0  // "aaaa" at 0
]
if (!runAhoCorasickTestCase(3, "Embedded Repeated Character Hierarchies", p3, "aaaa", 10, samples3)) {
    allAcPassed = false
}

// --- Test Case 4: Zero Match Disjoint Alphabet Boundary ---
p4 = ["xyz", "uvw", "rst"]
samples4 = []
if (!runAhoCorasickTestCase(4, "Zero Match Disjoint Alphabet Boundary", p4, "abcdefghijklmnop", 0, samples4)) {
    allAcPassed = false
}

// --- Test Case 5: Complex NLP Sentence Keyword Extraction ---
p5 = ["network", "flow", "automata", "string", "graph", "match", "advanced"]
text5 = "the advanced graph network flows and string automata pattern match suite"
samples5 = [
    6, 4,   // "advanced" at 4
    4, 13,  // "graph" at 13
    0, 19,  // "network" at 19
    1, 27,  // "flow" at 27
    3, 37,  // "string" at 37
    2, 44,  // "automata" at 44
    5, 61   // "match" at 61
]
if (!runAhoCorasickTestCase(5, "NLP Multi-Keyword Extraction", p5, text5, 7, samples5)) {
    allAcPassed = false
}

// --- Final Suite Summary ---
print("=== Aho-Corasick Multi-Pattern Matching Suite Summary ===")
if (allAcPassed) {
    print("All Aho-Corasick test suites: SUCCESS")
} else {
    print("Some Aho-Corasick test suites: FAILED")
}

totalElapsed = t.millis() - globalStartTime
print("[PASS] Aho-Corasick Multi-Pattern Matching executed successfully in", totalElapsed, "ms")
