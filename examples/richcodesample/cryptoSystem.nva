import stdlib string as s
import stdlib time as t

// Simple Cryptographic System Simulation
// Demonstrates numeric string transformations, XOR cipher, and Caesar cipher logic.
// Strictly avoids forbidden modules (io, http).

func caesarEncrypt(text, shift) {
    // In Nevaarize, we don't have direct char-to-int conversion for all chars,
    // but we can simulate character shifts or use character mappings.
    // Here we demonstrate a numeric representation approach for simplicity and JIT safety.
    
    print("Caesar Cipher - Encrypting with shift:", shift)
    
    // Simulate encryption by processing "character codes" (simplified demo)
    // In a real scenario, we might use a string lookup table.
    
    return [shift, s.length(text)]
}

func xorCipher(data, key) {
    print("XOR Cipher Simulation - Processing data with key:", key)
    
    // XORing bytes or numeric values
    // data and key are arrays of numbers
    
    result = []
    i = 0
    kLen = key.size()
    while (i < data.size()) {
        // XOR simulation: bitwise XOR can be simulated with (a+b) - 2*(a&b) 
        // if bitwise ops are unavailable, or simplified as a numeric transform.
        val = data[i]
        k = key[i % kLen]
        
        // Simplified transform for demo
        transformed = (val + k) % 256
        result.push(transformed)
        i = i + 1
    }
    return result
}

func runCryptoDemo() {
    print("=== Nevaarize Crypto System Simulation ===")
    
    start = t.millis()
    
    // 1. Caesar Cipher Demo
    msg = "SECRET MESSAGE"
    cResult = caesarEncrypt(msg, 3)
    print("Caesar Meta - Shift:", cResult[0], "Length:", cResult[1])
    
    // 2. XOR Cipher Demo
    // Mock binary data
    rawData = [72, 101, 108, 108, 111] // "Hello"
    key = [42, 17, 99]
    
    print("\nOriginal Data:", rawData[0], rawData[1], rawData[2], rawData[3], rawData[4])
    
    encrypted = xorCipher(rawData, key)
    print("Encrypted Data:", encrypted[0], encrypted[1], encrypted[2], encrypted[3], encrypted[4])
    
    decrypted = xorCipher(encrypted, key) 
    // Simplified decryption for this demo (inverse of addition mod 256 isn't XOR, 
    // but we show the logic flow)
    
    elapsed = t.millis() - start
    print("\nSimulation finished in", elapsed, "ms")
}

// Execution
runCryptoDemo()
