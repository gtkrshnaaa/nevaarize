import stdlib string as s
import stdlib time as t

// Simple Cryptographic System Simulation
// Demonstrates numeric string transformations and XOR-like cipher logic.

// Simplified Caesar Cipher Demo
func caesarDemo(shift) {
    print("Caesar Cipher Simulation - Shift:", shift)
    
    // S=18, E=4, C=2, R=17, E=4, T=19
    msg = [18, 4, 2, 17, 4, 19]
    n = 6
    
    enc = [0, 0, 0, 0, 0, 0]
    i = 0
    while (i < n) {
        val = msg[i]
        c = (val + shift) % 26
        enc[i] = c
        i = i + 1
    }
    
    print("Encrypted codes:", enc[0], enc[1], enc[2], enc[3], enc[4], enc[5])
    
    dec = [0, 0, 0, 0, 0, 0]
    i = 0
    while (i < n) {
        val = enc[i]
        o = (val - shift + 26) % 26
        dec[i] = o
        i = i + 1
    }
    print("Decrypted codes:", dec[0], dec[1], dec[2], dec[3], dec[4], dec[5])
}

// Cipher using pre-allocated arrays and simplified indexing
func xorDemo() {
    print("\nSimplistic Cipher Simulation")
    
    // "Hello"
    data = [72, 101, 108, 108, 111]
    n = 5
    key = [42, 17, 99]
    
    print("Original Data:", data[0], data[1], data[2], data[3], data[4])
    
    e = [0, 0, 0, 0, 0]
    j = 0
    while (j < n) {
        kIdx = j % 3
        kv = key[kIdx]
        dv = data[j]
        tr = (dv + kv) % 256
        e[j] = tr
        j = j + 1
    }
    
    print("Encrypted Data:", e[0], e[1], e[2], e[3], e[4])
    
    d = [0, 0, 0, 0, 0]
    k = 0
    while (k < n) {
        ki = k % 3
        kv = key[ki]
        ev = e[k]
        origVal = (ev - kv + 256) % 256
        d[k] = origVal
        k = k + 1
    }
    
    print("Decrypted Data:", d[0], d[1], d[2], d[3], d[4])
}

func runCryptoDemo() {
    print("=== Nevaarize Crypto System Simulation ===")
    start = t.millis()
    caesarDemo(3)
    xorDemo()
    print("\nSimulation finished.")
}

// Execution
runCryptoDemo()
