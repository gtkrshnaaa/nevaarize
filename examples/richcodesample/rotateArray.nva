print("=== Array Rotation ===")
arr = [1, 2, 3, 4, 5, 6, 7]
n = 7
k = 3
temp = [0,0,0,0,0,0,0]
i = 0
while (i < n) { idx = (i + k) % n
temp[i] = arr[idx]
i = i + 1 }
i = 0
while (i < n) { arr[i] = temp[i]
i = i + 1 }
print("Left rotate 3:", arr[0], arr[1], arr[2], arr[3], arr[4], arr[5], arr[6])
print("(expected: 4 5 6 7 1 2 3)")
arr2 = [10, 20, 30, 40, 50]
first = arr2[0]
i = 0
while (i < 4) { arr2[i] = arr2[i + 1]
i = i + 1 }
arr2[4] = first
print("Left by 1:", arr2[0], arr2[1], arr2[2], arr2[3], arr2[4], "(expected: 20 30 40 50 10)")
print("Array rotation finished.")
