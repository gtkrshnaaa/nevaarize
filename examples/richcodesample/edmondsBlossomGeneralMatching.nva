import stdlib time as t

// Edmonds' Blossom Algorithm for Maximum General (Non-Bipartite) Graph Matching
// Time Complexity: O(V * E) with BFS alternating forest and blossom contraction
// Space Complexity: O(V + E) bounded memory representation
// Technical characteristics:
// - Alternating BFS forest explores augmenting paths across arbitrary non-bipartite topologies
// - Least Common Ancestor (LCA) detection identifies odd-length alternating cycles (blossoms)
// - Blossom contraction collapses odd cycles into pseudo-vertices, preserving augmenting paths
// - Path expansion and cross-parent relinking for flawless alternating path recovery
// - Berge's Lemma verification: matching is maximum iff no augmenting paths exist
// - Verification of matching validity, symmetry, edge inclusion, and perfection
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Edmonds' Blossom General Graph Matching Suite ===")
suiteStartTime = t.millis()

func makeIntArray(sz, fillVal) {
    arr = []
    i = 0
    while (i < sz) {
        arr.push(fillVal)
        i = i + 1
    }
    return arr
}

func minInt(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func createGraph(n) {
    adj = []
    i = 0
    while (i < n) {
        adj.push([])
        i = i + 1
    }
    return [n, adj]
}

func addEdge(graph, u, v) {
    adj = graph[1]
    adj[u].push(v)
    adj[v].push(u)
}

func findLca(u, v, base, parent, match, n) {
    inPath = makeIntArray(n, 0)
    currU = u
    doneU = false
    while (!doneU) {
        currU = base[currU]
        inPath[currU] = 1
        if (match[currU] == -1) {
            doneU = true
        } else {
            currU = parent[match[currU]]
        }
    }

    currV = v
    searchingV = true
    while (searchingV) {
        currV = base[currV]
        if (inPath[currV] == 1) {
            return currV
        }
        if (match[currV] == -1) {
            searchingV = false
        } else {
            currV = parent[match[currV]]
        }
    }

    return -1
}

func markPath(v, b, children, base, parent, match, blossom) {
    currV = v
    currChildren = children
    while (base[currV] != b) {
        blossom[base[currV]] = 1
        blossom[base[match[currV]]] = 1
        parent[currV] = currChildren
        currChildren = match[currV]
        currV = parent[match[currV]]
    }
}

func findAugmentingPath(graph, root, match, parent, base) {
    n = graph[0]
    adj = graph[1]

    used = makeIntArray(n, 0)
    i = 0
    while (i < n) {
        parent[i] = -1
        base[i] = i
        i = i + 1
    }

    queue = []
    qHead = 0

    used[root] = 1
    queue.push(root)

    blossom = makeIntArray(n, 0)

    while (qHead < queue.size()) {
        v = queue[qHead]
        qHead = qHead + 1

        edges = adj[v]
        eIdx = 0
        while (eIdx < edges.size()) {
            to = edges[eIdx]
            if (base[v] != base[to] and match[v] != to) {
                if (to == root or (match[to] != -1 and parent[match[to]] != -1)) {
                    curBase = findLca(v, to, base, parent, match, n)
                    bIdx = 0
                    while (bIdx < n) {
                        blossom[bIdx] = 0
                        bIdx = bIdx + 1
                    }
                    markPath(v, curBase, to, base, parent, match, blossom)
                    markPath(to, curBase, v, base, parent, match, blossom)
                    nodeIdx = 0
                    while (nodeIdx < n) {
                        if (blossom[base[nodeIdx]] == 1) {
                            base[nodeIdx] = curBase
                            if (used[nodeIdx] == 0) {
                                used[nodeIdx] = 1
                                queue.push(nodeIdx)
                            }
                        }
                        nodeIdx = nodeIdx + 1
                    }
                } elif (parent[to] == -1) {
                    parent[to] = v
                    if (match[to] == -1) {
                        return to
                    }
                    toMatched = match[to]
                    used[toMatched] = 1
                    queue.push(toMatched)
                }
            }
            eIdx = eIdx + 1
        }
    }

    return -1
}

func maxMatchingEdmonds(graph) {
    n = graph[0]
    match = makeIntArray(n, -1)
    parent = makeIntArray(n, -1)
    base = makeIntArray(n, 0)

    matchingSize = 0
    u = 0
    while (u < n) {
        if (match[u] == -1) {
            endpoint = findAugmentingPath(graph, u, match, parent, base)
            if (endpoint != -1) {
                curr = endpoint
                while (curr != -1) {
                    p = parent[curr]
                    pp = match[p]
                    match[curr] = p
                    match[p] = curr
                    curr = pp
                }
                matchingSize = matchingSize + 1
            }
        }
        u = u + 1
    }

    return [matchingSize, match]
}

func verifyMatching(graph, match, expectedSize) {
    n = graph[0]
    adj = graph[1]

    countMatched = 0
    u = 0
    while (u < n) {
        v = match[u]
        if (v != -1) {
            if (v < 0 or v >= n) {
                return false
            }
            if (u == v) {
                return false
            }
            if (match[v] != u) {
                return false
            }
            // Verify edge (u, v) exists in adj[u]
            edges = adj[u]
            foundEdge = false
            e = 0
            while (e < edges.size()) {
                if (edges[e] == v) {
                    foundEdge = true
                }
                e = e + 1
            }
            if (!foundEdge) {
                return false
            }
            countMatched = countMatched + 1
        }
        u = u + 1
    }

    return countMatched == expectedSize * 2
}

func verifyBergeOptimality(graph, match) {
    n = graph[0]
    parent = makeIntArray(n, -1)
    base = makeIntArray(n, 0)

    u = 0
    while (u < n) {
        if (match[u] == -1) {
            endpoint = findAugmentingPath(graph, u, match, parent, base)
            if (endpoint != -1) {
                return false
            }
        }
        u = u + 1
    }
    return true
}

allBlossomPassed = true

// --- Test Case 1: Canonical Non-Bipartite Odd Cycles ---
print("Running Test Case 1: Canonical Non-Bipartite Odd Cycles...")
// K3 (Triangle): 3 nodes, max matching = 1
gK3 = createGraph(3)
addEdge(gK3, 0, 1)
addEdge(gK3, 1, 2)
addEdge(gK3, 2, 0)
resK3 = maxMatchingEdmonds(gK3)
validK3 = verifyMatching(gK3, resK3[1], 1)
bergeK3 = verifyBergeOptimality(gK3, resK3[1])
print("  K3 Triangle Matching Size:", resK3[0], "(Expected: 1)")
if (resK3[0] == 1 and validK3 and bergeK3) {
    print("  K3 Triangle PASSED")
} else {
    print("[FAIL] K3 Triangle failed")
    allBlossomPassed = false
}

// C5 (Pentagon): 5 nodes, max matching = 2
gC5 = createGraph(5)
addEdge(gC5, 0, 1)
addEdge(gC5, 1, 2)
addEdge(gC5, 2, 3)
addEdge(gC5, 3, 4)
addEdge(gC5, 4, 0)
resC5 = maxMatchingEdmonds(gC5)
validC5 = verifyMatching(gC5, resC5[1], 2)
bergeC5 = verifyBergeOptimality(gC5, resC5[1])
print("  C5 Pentagon Matching Size:", resC5[0], "(Expected: 2)")
if (resC5[0] == 2 and validC5 and bergeC5) {
    print("  C5 Pentagon PASSED")
} else {
    print("[FAIL] C5 Pentagon failed")
    allBlossomPassed = false
}

// K5 (Complete 5-vertex graph): max matching = 2
gK5 = createGraph(5)
kI = 0
while (kI < 5) {
    kJ = kI + 1
    while (kJ < 5) {
        addEdge(gK5, kI, kJ)
        kJ = kJ + 1
    }
    kI = kI + 1
}
resK5 = maxMatchingEdmonds(gK5)
validK5 = verifyMatching(gK5, resK5[1], 2)
bergeK5 = verifyBergeOptimality(gK5, resK5[1])
print("  K5 Complete Matching Size:", resK5[0], "(Expected: 2)")
if (resK5[0] == 2 and validK5 and bergeK5) {
    print("  K5 Complete PASSED")
} else {
    print("[FAIL] K5 Complete failed")
    allBlossomPassed = false
}

// C7 (7-vertex cycle): max matching = 3
gC7 = createGraph(7)
i = 0
while (i < 7) {
    addEdge(gC7, i, (i + 1) % 7)
    i = i + 1
}
resC7 = maxMatchingEdmonds(gC7)
validC7 = verifyMatching(gC7, resC7[1], 3)
bergeC7 = verifyBergeOptimality(gC7, resC7[1])
print("  C7 Heptagon Matching Size:", resC7[0], "(Expected: 3)")
if (resC7[0] == 3 and validC7 and bergeC7) {
    print("  C7 Heptagon PASSED")
} else {
    print("[FAIL] C7 Heptagon failed")
    allBlossomPassed = false
}

// --- Test Case 2: Blossom with Stem and Alternating Path ---
print("Running Test Case 2: Blossom with Stem and Alternating Path...")
// Stem 0-1, Blossom 1-2-3-1, Stem extension 3-4
// Vertices: 0, 1, 2, 3, 4, 5
// Edges: (0, 1), (1, 2), (2, 3), (3, 1), (3, 4), (4, 5)
gStem = createGraph(6)
addEdge(gStem, 0, 1)
addEdge(gStem, 1, 2)
addEdge(gStem, 2, 3)
addEdge(gStem, 3, 1)
addEdge(gStem, 3, 4)
addEdge(gStem, 4, 5)
resStem = maxMatchingEdmonds(gStem)
validStem = verifyMatching(gStem, resStem[1], 3)
bergeStem = verifyBergeOptimality(gStem, resStem[1])
print("  Blossom Stem Matching Size:", resStem[0], "(Expected: 3)")
if (resStem[0] == 3 and validStem and bergeStem) {
