// --- Test Case 3: The Famous Petersen Graph (10 Vertices, 15 Edges) ---
print("Running Test Case 3: Petersen Graph Perfect Matching...")
// 10 nodes: 0-4 outer pentagon, 5-9 inner pentagram
// Outer: (0,1), (1,2), (2,3), (3,4), (4,0)
// Spokes: (0,5), (1,6), (2,7), (3,8), (4,9)
// Inner: (5,7), (7,9), (9,6), (6,8), (8,5)
gPet = createGraph(10)
// Outer pentagon
addEdge(gPet, 0, 1)
addEdge(gPet, 1, 2)
addEdge(gPet, 2, 3)
addEdge(gPet, 3, 4)
addEdge(gPet, 4, 0)
// Spokes
addEdge(gPet, 0, 5)
addEdge(gPet, 1, 6)
addEdge(gPet, 2, 7)
addEdge(gPet, 3, 8)
addEdge(gPet, 4, 9)
// Inner pentagram
addEdge(gPet, 5, 7)
addEdge(gPet, 7, 9)
addEdge(gPet, 9, 6)
addEdge(gPet, 6, 8)
addEdge(gPet, 8, 5)

resPet = maxMatchingEdmonds(gPet)
validPet = verifyMatching(gPet, resPet[1], 5)
bergePet = verifyBergeOptimality(gPet, resPet[1])
print("  Petersen Matching Size:", resPet[0], "(Expected: 5)")
if (resPet[0] == 5 and validPet and bergePet) {
    print("  Test Case 3 PASSED (Petersen graph has perfect matching of size 5)")
} else {
    print("[FAIL] Test Case 3 failed Petersen graph verification")
    allBlossomPassed = false
}

