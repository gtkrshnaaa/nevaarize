// --- Test Case 6: Dense Pseudo-Random Non-Bipartite Stress Network ---
print("Running Test Case 6: Dense Pseudo-Random Stress Graph (30 Vertices)...")
stressN = 30
gStress = createGraph(stressN)
seed = 987654321
edgeCount = 0

u = 0
while (u < stressN) {
    v = u + 1
    while (v < stressN) {
        seed = (seed * 1103515245 + 12345) % 2147483648
        if (seed % 3 == 0) {
            addEdge(gStress, u, v)
            edgeCount = edgeCount + 1
        }
        v = v + 1
    }
    u = u + 1
}

print("  Constructed random stress graph with", edgeCount, "edges on 30 vertices")
resStress = maxMatchingEdmonds(gStress)
validStress = verifyMatching(gStress, resStress[1], resStress[0])
bergeStress = verifyBergeOptimality(gStress, resStress[1])
print("  Stress Matching Cardinality:", resStress[0])
print("  Matching Validity Check    :", validStress)
print("  Berge Optimality Check     :", bergeStress)

if (validStress and bergeStress and resStress[0] > 0) {
    print("  Test Case 6 PASSED (Stress graph satisfies matching invariants and Berge optimality)")
} else {
    print("[FAIL] Test Case 6 failed stress graph verification")
    allBlossomPassed = false
}

