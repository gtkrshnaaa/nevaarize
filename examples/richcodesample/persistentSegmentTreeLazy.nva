import stdlib time as t

// Persistent Segment Tree with Lazy Propagation and Historical Queries
// Technical characteristics:
// - Functional persistence via node path copying in O(log N) time and space
// - Lazy tag propagation with copy-on-write immutability across versions
// - Range addition updates across historical timelines
// - Range sum, range minimum, range maximum, and point queries
// - Parallel arena allocation for cache locality and minimal runtime overhead
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Persistent Segment Tree with Lazy Propagation Suite ===")
suiteStartTime = t.millis()

func minInt(aInt, bInt) {
    if (aInt < bInt) {
        return aInt
    }
    return bInt
}

func maxInt(aInt, bInt) {
    if (aInt > bInt) {
        return aInt
    }
    return bInt
}

func createPersistentTreeLazy() {
    treeLeft = []
    treeRight = []
    treeSum = []
    treeMin = []
    treeMax = []
    treeLazy = []
    return [treeLeft, treeRight, treeSum, treeMin, treeMax, treeLazy]
}

func allocNode(tree, leftChild, rightChild, sumVal, minVal, maxVal, lazyVal) {
    tLeft = tree[0]
    tRight = tree[1]
    tSum = tree[2]
    tMin = tree[3]
    tMax = tree[4]
    tLazy = tree[5]

    nodeId = tLeft.size()
    tLeft.push(leftChild)
    tRight.push(rightChild)
    tSum.push(sumVal)
    tMin.push(minVal)
    tMax.push(maxVal)
    tLazy.push(lazyVal)

    tree[0] = tLeft
    tree[1] = tRight
    tree[2] = tSum
    tree[3] = tMin
    tree[4] = tMax
    tree[5] = tLazy
    return nodeId
}

func cloneNode(tree, srcId) {
    if (srcId == -1) {
        return -1
    }
    tLeft = tree[0]
    tRight = tree[1]
    tSum = tree[2]
    tMin = tree[3]
    tMax = tree[4]
    tLazy = tree[5]

    return allocNode(tree, tLeft[srcId], tRight[srcId], tSum[srcId], tMin[srcId], tMax[srcId], tLazy[srcId])
}

func pushUp(tree, node) {
    if (node == -1) {
        return
    }
    tLeft = tree[0]
    tRight = tree[1]
    lc = tLeft[node]
    rc = tRight[node]

    tSum = tree[2]
    tMin = tree[3]
    tMax = tree[4]

    sVal = 0
    minVal = 2147483647
    maxVal = -2147483648

    if (lc != -1) {
        sVal = sVal + tSum[lc]
        minVal = minInt(minVal, tMin[lc])
        maxVal = maxInt(maxVal, tMax[lc])
    }
    if (rc != -1) {
        sVal = sVal + tSum[rc]
        minVal = minInt(minVal, tMin[rc])
        maxVal = maxInt(maxVal, tMax[rc])
    }

    tSum[node] = sVal
    tMin[node] = minVal
    tMax[node] = maxVal

    tree[2] = tSum
    tree[3] = tMin
    tree[4] = tMax
}

func pushDown(tree, node, l, r) {
    if (node == -1 or l == r) {
        return
    }
    tLazy = tree[5]
    lazyVal = tLazy[node]
    if (lazyVal == 0) {
        return
    }

    mid = (l + r) / 2
    tLeft = tree[0]
    tRight = tree[1]
    lc = tLeft[node]
    rc = tRight[node]

    newLc = cloneNode(tree, lc)
    newRc = cloneNode(tree, rc)

    tSum = tree[2]
    tMin = tree[3]
    tMax = tree[4]
    tLazy = tree[5]

    leftSpan = mid - l + 1
    tSum[newLc] = tSum[newLc] + lazyVal * leftSpan
    tMin[newLc] = tMin[newLc] + lazyVal
    tMax[newLc] = tMax[newLc] + lazyVal
    tLazy[newLc] = tLazy[newLc] + lazyVal

    rightSpan = r - mid
    tSum[newRc] = tSum[newRc] + lazyVal * rightSpan
    tMin[newRc] = tMin[newRc] + lazyVal
    tMax[newRc] = tMax[newRc] + lazyVal
    tLazy[newRc] = tLazy[newRc] + lazyVal

    tLazy[node] = 0

    tLeft = tree[0]
    tRight = tree[1]
    tLeft[node] = newLc
    tRight[node] = newRc

    tree[0] = tLeft
    tree[1] = tRight
    tree[2] = tSum
    tree[3] = tMin
    tree[4] = tMax
    tree[5] = tLazy
}

func buildTree(tree, arr, l, r) {
    if (l == r) {
        val = arr[l]
        return allocNode(tree, -1, -1, val, val, val, 0)
    }
    mid = (l + r) / 2
    lc = buildTree(tree, arr, l, mid)
    rc = buildTree(tree, arr, mid + 1, r)

    tSum = tree[2]
    tMin = tree[3]
    tMax = tree[4]

    sVal = tSum[lc] + tSum[rc]
    minVal = minInt(tMin[lc], tMin[rc])
    maxVal = maxInt(tMax[lc], tMax[rc])
    return allocNode(tree, lc, rc, sVal, minVal, maxVal, 0)
}

func updateRangeAdd(tree, prevNode, l, r, ql, qr, addVal) {
    if (prevNode == -1 or ql > r or qr < l or ql > qr) {
        return prevNode
    }
    if (ql <= l and r <= qr) {
        newNode = cloneNode(tree, prevNode)
        tSum = tree[2]
        tMin = tree[3]
        tMax = tree[4]
        tLazy = tree[5]

        span = r - l + 1
        tSum[newNode] = tSum[newNode] + addVal * span
        tMin[newNode] = tMin[newNode] + addVal
        tMax[newNode] = tMax[newNode] + addVal
        tLazy[newNode] = tLazy[newNode] + addVal

        tree[2] = tSum
        tree[3] = tMin
        tree[4] = tMax
        tree[5] = tLazy
        return newNode
    }

    mid = (l + r) / 2
    newNode = cloneNode(tree, prevNode)
    pushDown(tree, newNode, l, r)

    tLeft = tree[0]
    tRight = tree[1]
    curLeft = tLeft[newNode]
    curRight = tRight[newNode]

    if (ql <= mid) {
        curLeft = updateRangeAdd(tree, curLeft, l, mid, ql, qr, addVal)
    }
    if (qr > mid) {
        curRight = updateRangeAdd(tree, curRight, mid + 1, r, ql, qr, addVal)
    }

    tLeft = tree[0]
    tRight = tree[1]
    tLeft[newNode] = curLeft
    tRight[newNode] = curRight
    tree[0] = tLeft
    tree[1] = tRight

    pushUp(tree, newNode)
    return newNode
}

func updatePointAdd(tree, prevNode, l, r, idx, addVal) {
    return updateRangeAdd(tree, prevNode, l, r, idx, idx, addVal)
}

func queryRangeSum(tree, node, l, r, ql, qr, accLazy) {
    if (node == -1 or ql > r or qr < l or ql > qr) {
        return 0
    }
    if (ql <= l and r <= qr) {
        tSum = tree[2]
        span = r - l + 1
        return tSum[node] + accLazy * span
    }
    mid = (l + r) / 2
    tLeft = tree[0]
    tRight = tree[1]
    tLazy = tree[5]
    nextLazy = accLazy + tLazy[node]
    leftSum = queryRangeSum(tree, tLeft[node], l, mid, ql, qr, nextLazy)
    rightSum = queryRangeSum(tree, tRight[node], mid + 1, r, ql, qr, nextLazy)
    return leftSum + rightSum
}

func queryRangeMin(tree, node, l, r, ql, qr, accLazy) {
    if (node == -1 or ql > r or qr < l or ql > qr) {
        return 2147483647
    }
    if (ql <= l and r <= qr) {
        tMin = tree[3]
        return tMin[node] + accLazy
    }
    mid = (l + r) / 2
    tLeft = tree[0]
    tRight = tree[1]
    tLazy = tree[5]
    nextLazy = accLazy + tLazy[node]
    leftMin = queryRangeMin(tree, tLeft[node], l, mid, ql, qr, nextLazy)
    rightMin = queryRangeMin(tree, tRight[node], mid + 1, r, ql, qr, nextLazy)
    return minInt(leftMin, rightMin)
}

func queryRangeMax(tree, node, l, r, ql, qr, accLazy) {
    if (node == -1 or ql > r or qr < l or ql > qr) {
        return -2147483648
    }
    if (ql <= l and r <= qr) {
        tMax = tree[4]
        return tMax[node] + accLazy
    }
    mid = (l + r) / 2
    tLeft = tree[0]
    tRight = tree[1]
    tLazy = tree[5]
    nextLazy = accLazy + tLazy[node]
    leftMax = queryRangeMax(tree, tLeft[node], l, mid, ql, qr, nextLazy)
    rightMax = queryRangeMax(tree, tRight[node], mid + 1, r, ql, qr, nextLazy)
    return maxInt(leftMax, rightMax)
}

func queryPoint(tree, node, l, r, idx, accLazy) {
    return queryRangeSum(tree, node, l, r, idx, idx, accLazy)
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Version Updates and Range Queries
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Version Updates and Range Queries...")
pst = createPersistentTreeLazy()
initialData = [3, 8, 15, 1, 9, 24, 7, 12, 5, 18]
n = initialData.size()

versionRoots = []
v0 = buildTree(pst, initialData, 0, n - 1)
versionRoots.push(v0)

// Verify version 0 aggregates
sumV0 = queryRangeSum(pst, v0, 0, n - 1, 0, n - 1, 0)
minV0 = queryRangeMin(pst, v0, 0, n - 1, 0, n - 1, 0)
maxV0 = queryRangeMax(pst, v0, 0, n - 1, 0, n - 1, 0)

if (sumV0 != 102) {
    print("[FAIL] Version 0 initial sum expected 102, got", sumV0)
}
if (minV0 != 1) {
    print("[FAIL] Version 0 initial min expected 1, got", minV0)
}
if (maxV0 != 24) {
    print("[FAIL] Version 0 initial max expected 24, got", maxV0)
}
print("  Version 0 baseline verified: sum =", sumV0, ", min =", minV0, ", max =", maxV0)

// Version 1: Add +10 to range [2, 6] (indices 2, 3, 4, 5, 6)
// Elements become: [3, 8, 25, 11, 19, 34, 17, 12, 5, 18]
v1 = updateRangeAdd(pst, v0, 0, n - 1, 2, 6, 10)
versionRoots.push(v1)

sumV1 = queryRangeSum(pst, v1, 0, n - 1, 0, n - 1, 0)
minV1 = queryRangeMin(pst, v1, 0, n - 1, 0, n - 1, 0)
maxV1 = queryRangeMax(pst, v1, 0, n - 1, 0, n - 1, 0)
sumV1Range = queryRangeSum(pst, v1, 0, n - 1, 2, 6, 0)

if (sumV1 != 152) {
    print("[FAIL] Version 1 sum expected 152, got", sumV1)
}
if (sumV1Range != 106) {
    print("[FAIL] Version 1 range [2, 6] sum expected 106, got", sumV1Range)
}
if (maxV1 != 34) {
    print("[FAIL] Version 1 max expected 34, got", maxV1)
}
if (minV1 != 3) {
    print("[FAIL] Version 1 min expected 3, got", minV1)
}
print("  Version 1 range addition verified: sum =", sumV1, ", min =", minV1, ", max =", maxV1)

// Immutability check on Version 0 after Version 1 creation
sumV0AfterV1 = queryRangeSum(pst, v0, 0, n - 1, 0, n - 1, 0)
if (sumV0AfterV1 != 102) {
    print("[FAIL] Version 0 mutated after Version 1 update! Expected 102, got", sumV0AfterV1)
} else {
    print("  Version 0 immutability preserved after Version 1 range addition")
}

// Version 2: Add +5 to range [0, 4] on Version 1
// Elements become: [8, 13, 30, 16, 24, 34, 17, 12, 5, 18]
v2 = updateRangeAdd(pst, v1, 0, n - 1, 0, 4, 5)
versionRoots.push(v2)

sumV2 = queryRangeSum(pst, v2, 0, n - 1, 0, n - 1, 0)
minV2 = queryRangeMin(pst, v2, 0, n - 1, 0, n - 1, 0)
maxV2 = queryRangeMax(pst, v2, 0, n - 1, 0, n - 1, 0)
minV2Prefix = queryRangeMin(pst, v2, 0, n - 1, 0, 4, 0)

if (sumV2 != 177) {
    print("[FAIL] Version 2 sum expected 177, got", sumV2)
}
if (minV2Prefix != 8) {
    print("[FAIL] Version 2 prefix [0, 4] min expected 8, got", minV2Prefix)
}
print("  Version 2 prefix addition verified: sum =", sumV2, ", prefix min =", minV2Prefix)

// Version 3: Add -7 (subtraction) to range [5, 9] on Version 2
// Elements become: [8, 13, 30, 16, 24, 27, 10, 5, -2, 11]
v3 = updateRangeAdd(pst, v2, 0, n - 1, 5, 9, -7)
versionRoots.push(v3)

sumV3 = queryRangeSum(pst, v3, 0, n - 1, 0, n - 1, 0)
minV3 = queryRangeMin(pst, v3, 0, n - 1, 0, n - 1, 0)
maxV3 = queryRangeMax(pst, v3, 0, n - 1, 0, n - 1, 0)
minV3Suffix = queryRangeMin(pst, v3, 0, n - 1, 5, 9, 0)

if (sumV3 != 142) {
    print("[FAIL] Version 3 sum expected 142, got", sumV3)
}
if (minV3 != -2) {
    print("[FAIL] Version 3 min expected -2, got", minV3)
}
if (maxV3 != 30) {
    print("[FAIL] Version 3 max expected 30, got", maxV3)
}
print("  Version 3 negative addition verified: sum =", sumV3, ", min =", minV3, ", max =", maxV3)

// Version 4: Point update adding +50 at index 8 on Version 3
// Elements become: [8, 13, 30, 16, 24, 27, 10, 5, 48, 11]
v4 = updatePointAdd(pst, v3, 0, n - 1, 8, 50)
versionRoots.push(v4)

sumV4 = queryRangeSum(pst, v4, 0, n - 1, 0, n - 1, 0)
ptValV4 = queryPoint(pst, v4, 0, n - 1, 8, 0)
ptValV3 = queryPoint(pst, v3, 0, n - 1, 8, 0)
ptValV0 = queryPoint(pst, v0, 0, n - 1, 8, 0)

if (sumV4 != 192) {
    print("[FAIL] Version 4 sum expected 192, got", sumV4)
}
if (ptValV4 != 48) {
    print("[FAIL] Version 4 point query at 8 expected 48, got", ptValV4)
}
if (ptValV3 != -2) {
    print("[FAIL] Version 3 point query at 8 expected -2, got", ptValV3)
}
if (ptValV0 != 5) {
    print("[FAIL] Version 0 point query at 8 expected 5, got", ptValV0)
}
print("  Version 4 point addition verified: sum =", sumV4, ", point 8 =", ptValV4)
print("  Historical index 8 across versions: v0 =", ptValV0, ", v3 =", ptValV3, ", v4 =", ptValV4)
print("  Test Case 1 Passed sequential updates and immutability verification")

// -----------------------------------------------------------------------------
// Test Case 2: Timeline Forking and Tree Branching
// -----------------------------------------------------------------------------
print("Running Test Case 2: Timeline Forking and Tree Branching...")

// Branch A forks from Version 2: add +100 to range [1, 7]
// v2 sum was 177, range [1, 7] has 7 elements, adding 700 -> expected sum 877
vBranchA = updateRangeAdd(pst, v2, 0, n - 1, 1, 7, 100)

// Branch B forks independently from Version 2: add -20 to range [0, 3]
// v2 sum was 177, range [0, 3] has 4 elements, adding -80 -> expected sum 97
// min of [0, 3] in v2 was 8, after -20 becomes -12
vBranchB = updateRangeAdd(pst, v2, 0, n - 1, 0, 3, -20)

// Branch C forks from Branch A: add +50 to range [8, 9]
// Branch A sum was 877, range [8, 9] has 2 elements, adding 100 -> expected sum 977
vBranchC = updateRangeAdd(pst, vBranchA, 0, n - 1, 8, 9, 50)

sumBranchA = queryRangeSum(pst, vBranchA, 0, n - 1, 0, n - 1, 0)
maxBranchA = queryRangeMax(pst, vBranchA, 0, n - 1, 0, n - 1, 0)
sumBranchB = queryRangeSum(pst, vBranchB, 0, n - 1, 0, n - 1, 0)
minBranchB = queryRangeMin(pst, vBranchB, 0, n - 1, 0, n - 1, 0)
sumBranchC = queryRangeSum(pst, vBranchC, 0, n - 1, 0, n - 1, 0)

// Check parent and ancestor stability
sumParentV2 = queryRangeSum(pst, v2, 0, n - 1, 0, n - 1, 0)
sumAncestorV0 = queryRangeSum(pst, v0, 0, n - 1, 0, n - 1, 0)

if (sumBranchA != 877 or maxBranchA != 134) {
    print("[FAIL] Branch A expected sum 877 max 134, got sum", sumBranchA, "max", maxBranchA)
}
if (sumBranchB != 97 or minBranchB != -12) {
    print("[FAIL] Branch B expected sum 97 min -12, got sum", sumBranchB, "min", minBranchB)
}
if (sumBranchC != 977) {
    print("[FAIL] Branch C expected sum 977, got", sumBranchC)
}
if (sumParentV2 != 177) {
    print("[FAIL] Parent Version 2 mutated after branching! Expected 177, got", sumParentV2)
}
if (sumAncestorV0 != 102) {
    print("[FAIL] Ancestor Version 0 mutated after branching! Expected 102, got", sumAncestorV0)
}

print("  Branch A (sum:", sumBranchA, ", max:", maxBranchA, ") verified independently")
print("  Branch B (sum:", sumBranchB, ", min:", minBranchB, ") verified independently")
print("  Branch C (sum:", sumBranchC, ") derived from Branch A verified")
print("  Parent Version 2 preserved immutability (sum:", sumParentV2, ")")
print("  Test Case 2 Passed timeline forking verification")

// -----------------------------------------------------------------------------
// Test Case 3: Boundary and Edge Cases
// -----------------------------------------------------------------------------
print("Running Test Case 3: Boundary and Edge Cases...")

// Subcase 3.1: Single-element segment tree
singlePst = createPersistentTreeLazy()
singleArr = [42]
s0 = buildTree(singlePst, singleArr, 0, 0)

sSum0 = queryRangeSum(singlePst, s0, 0, 0, 0, 0, 0)
sMin0 = queryRangeMin(singlePst, s0, 0, 0, 0, 0, 0)
sMax0 = queryRangeMax(singlePst, s0, 0, 0, 0, 0, 0)

if (sSum0 != 42 or sMin0 != 42 or sMax0 != 42) {
    print("[FAIL] Single element v0 expected 42, got sum", sSum0, "min", sMin0, "max", sMax0)
}

s1 = updateRangeAdd(singlePst, s0, 0, 0, 0, 0, 58)
sSum1 = queryRangeSum(singlePst, s1, 0, 0, 0, 0, 0)
sSum0After = queryRangeSum(singlePst, s0, 0, 0, 0, 0, 0)

if (sSum1 != 100 or sSum0After != 42) {
    print("[FAIL] Single element v1 expected 100 and v0 expected 42, got v1", sSum1, "v0", sSum0After)
}

s2 = updateRangeAdd(singlePst, s1, 0, 0, 0, 0, -200)
sSum2 = queryRangeSum(singlePst, s2, 0, 0, 0, 0, 0)
sMin2 = queryRangeMin(singlePst, s2, 0, 0, 0, 0, 0)
sMax2 = queryRangeMax(singlePst, s2, 0, 0, 0, 0, 0)

if (sSum2 != -100 or sMin2 != -100 or sMax2 != -100) {
    print("[FAIL] Single element v2 expected -100, got sum", sSum2, "min", sMin2, "max", sMax2)
}
print("  Single-element segment tree verified across 3 versions (42 -> 100 -> -100)")

// Subcase 3.2: Two-element segment tree
twoPst = createPersistentTreeLazy()
twoArr = [10, 20]
t0 = buildTree(twoPst, twoArr, 0, 1)

t1 = updateRangeAdd(twoPst, t0, 0, 1, 0, 0, 5)
t2 = updateRangeAdd(twoPst, t1, 0, 1, 1, 1, 10)
t3 = updateRangeAdd(twoPst, t2, 0, 1, 0, 1, -5)

tSum0 = queryRangeSum(twoPst, t0, 0, 1, 0, 1, 0)
tSum1 = queryRangeSum(twoPst, t1, 0, 1, 0, 1, 0)
tSum2 = queryRangeSum(twoPst, t2, 0, 1, 0, 1, 0)
tSum3 = queryRangeSum(twoPst, t3, 0, 1, 0, 1, 0)

if (tSum0 != 30 or tSum1 != 35 or tSum2 != 45 or tSum3 != 35) {
    print("[FAIL] Two-element tree sums expected [30, 35, 45, 35], got", tSum0, tSum1, tSum2, tSum3)
}
print("  Two-element segment tree verified across 4 versions")

// Subcase 3.3: Out-of-bounds and disjoint queries
oobSum = queryRangeSum(pst, v0, 0, n - 1, 20, 25, 0)
oobMin = queryRangeMin(pst, v0, 0, n - 1, 20, 25, 0)
oobMax = queryRangeMax(pst, v0, 0, n - 1, 20, 25, 0)
invSum = queryRangeSum(pst, v0, 0, n - 1, 7, 3, 0)

if (oobSum != 0 or oobMin != 2147483647 or oobMax != -2147483648 or invSum != 0) {
    print("[FAIL] Disjoint query identity elements mismatched")
}
print("  Disjoint and out-of-bounds queries gracefully returned identity neutral values")

// Subcase 3.4: Repeated updates to identical interval
repeatPst = createPersistentTreeLazy()
zeroArr = [0, 0, 0, 0, 0]
repRoots = []
rep0 = buildTree(repeatPst, zeroArr, 0, 4)
repRoots.push(rep0)

repIter = 0
while (repIter < 5) {
    lastRoot = repRoots[repIter]
    nextRoot = updateRangeAdd(repeatPst, lastRoot, 0, 4, 1, 3, 10)
    repRoots.push(nextRoot)
    repIter = repIter + 1
}

repIdx = 0
repErrors = 0
while (repIdx <= 5) {
    expectedRepSum = repIdx * 30
    actualRepSum = queryRangeSum(repeatPst, repRoots[repIdx], 0, 4, 0, 4, 0)
    if (actualRepSum != expectedRepSum) {
        repErrors = repErrors + 1
    }
    repIdx = repIdx + 1
}

if (repErrors > 0) {
    print("[FAIL] Repeated updates had", repErrors, "sum mismatches")
} else {
    print("  Repeated identical range updates verified across 5 versions with cumulative lazy tags")
}
print("  Test Case 3 Passed boundary and edge case verification")

// -----------------------------------------------------------------------------
// Test Case 4: Deep Lazy Propagation and Cascading Overlapping Intervals
// -----------------------------------------------------------------------------
print("Running Test Case 4: Deep Lazy Propagation and Cascading Overlapping Intervals...")

deepPst = createPersistentTreeLazy()
deepArr = [1, 2, 3, 4, 5, 6, 7, 8]
deepLen = deepArr.size()
deepRoots = []

d0 = buildTree(deepPst, deepArr, 0, deepLen - 1)
deepRoots.push(d0)

// Update 1: add +10 to [0, 7] -> [11, 12, 13, 14, 15, 16, 17, 18]
d1 = updateRangeAdd(deepPst, d0, 0, deepLen - 1, 0, 7, 10)
deepRoots.push(d1)

// Update 2: add +20 to [2, 5] -> [11, 12, 33, 34, 35, 36, 17, 18]
d2 = updateRangeAdd(deepPst, d1, 0, deepLen - 1, 2, 5, 20)
deepRoots.push(d2)

// Update 3: add +30 to [1, 3] -> [11, 42, 63, 64, 35, 36, 17, 18]
d3 = updateRangeAdd(deepPst, d2, 0, deepLen - 1, 1, 3, 30)
deepRoots.push(d3)

// Update 4: add -15 to [3, 6] -> [11, 42, 63, 49, 20, 21, 2, 18]
d4 = updateRangeAdd(deepPst, d3, 0, deepLen - 1, 3, 6, -15)
deepRoots.push(d4)

expectedD4 = [11, 42, 63, 49, 20, 21, 2, 18]
deepErrors = 0
chkIdx = 0
while (chkIdx < deepLen) {
    ptVal = queryPoint(deepPst, d4, 0, deepLen - 1, chkIdx, 0)
    if (ptVal != expectedD4[chkIdx]) {
        deepErrors = deepErrors + 1
    }
    chkIdx = chkIdx + 1
}

sumD4Full = queryRangeSum(deepPst, d4, 0, deepLen - 1, 0, deepLen - 1, 0)
minD4Full = queryRangeMin(deepPst, d4, 0, deepLen - 1, 0, deepLen - 1, 0)
maxD4Full = queryRangeMax(deepPst, d4, 0, deepLen - 1, 0, deepLen - 1, 0)
sumD4Sub = queryRangeSum(deepPst, d4, 0, deepLen - 1, 2, 4, 0)

if (sumD4Full != 226 or minD4Full != 2 or maxD4Full != 63 or sumD4Sub != 132 or deepErrors > 0) {
    print("[FAIL] Cascading lazy updates had mismatches in Version 4")
} else {
    print("  Version 4 verified with cascading lazy tags across overlapping intervals (sum:", sumD4Full, ", min:", minD4Full, ", max:", maxD4Full, ")")
}

// Immutability checks across earlier historical stages
sumD0 = queryRangeSum(deepPst, d0, 0, deepLen - 1, 0, deepLen - 1, 0)
sumD1 = queryRangeSum(deepPst, d1, 0, deepLen - 1, 0, deepLen - 1, 0)
sumD2 = queryRangeSum(deepPst, d2, 0, deepLen - 1, 0, deepLen - 1, 0)
sumD3 = queryRangeSum(deepPst, d3, 0, deepLen - 1, 0, deepLen - 1, 0)

if (sumD0 != 36 or sumD1 != 116 or sumD2 != 196 or sumD3 != 286) {
    print("[FAIL] Historical cascading versions corrupted! Got sums:", sumD0, sumD1, sumD2, sumD3)
} else {
    print("  Historical versions d0..d3 verified strictly immutable: sums [36, 116, 196, 286]")
}
print("  Test Case 4 Passed deep cascading lazy propagation verification")

// -----------------------------------------------------------------------------
// Test Case 5: Randomized Stress Benchmark against Naive Historical Oracle
// -----------------------------------------------------------------------------
print("Running Test Case 5: Randomized Stress Benchmark against Naive Historical Matrix...")

stressPst = createPersistentTreeLazy()
stressLen = 20
numVersions = 40

stressInit = []
lSeed = 987654321
initI = 0
while (initI < stressLen) {
    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    elemVal = (lSeed % 100) - 20
    stressInit.push(elemVal)
    initI = initI + 1
}

stressRoots = []
naiveHistory = []

sRoot0 = buildTree(stressPst, stressInit, 0, stressLen - 1)
stressRoots.push(sRoot0)

v0Copy = []
cI = 0
while (cI < stressLen) {
    v0Copy.push(stressInit[cI])
    cI = cI + 1
}
naiveHistory.push(v0Copy)

verIdx = 1
while (verIdx <= numVersions) {
    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    qLeft = lSeed % stressLen
    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    qRight = lSeed % stressLen
    if (qLeft > qRight) {
        temp = qLeft
        qLeft = qRight
        qRight = temp
    }

    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    delta = (lSeed % 61) - 25

    prevR = stressRoots[verIdx - 1]
    newR = updateRangeAdd(stressPst, prevR, 0, stressLen - 1, qLeft, qRight, delta)
    stressRoots.push(newR)

    newClone = []
    prevClone = naiveHistory[verIdx - 1]
    scanI = 0
    while (scanI < stressLen) {
        valCur = prevClone[scanI]
        if (scanI >= qLeft and scanI <= qRight) {
            valCur = valCur + delta
        }
        newClone.push(valCur)
        scanI = scanI + 1
    }
    naiveHistory.push(newClone)
    verIdx = verIdx + 1
}

testQueries = 120
qI = 0
stressErrors = 0

while (qI < testQueries) {
    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    chosenVer = lSeed % (numVersions + 1)
    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    qLeft = lSeed % stressLen
    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    qRight = lSeed % stressLen
    if (qLeft > qRight) {
        temp = qLeft
        qLeft = qRight
        qRight = temp
    }

    expectedSum = 0
    expectedMin = 2147483647
    expectedMax = -2147483648
    verArr = naiveHistory[chosenVer]
    scanIdx = qLeft
    while (scanIdx <= qRight) {
        curItem = verArr[scanIdx]
        expectedSum = expectedSum + curItem
        if (curItem < expectedMin) {
            expectedMin = curItem
        }
        if (curItem > expectedMax) {
            expectedMax = curItem
        }
        scanIdx = scanIdx + 1
    }

    actSum = queryRangeSum(stressPst, stressRoots[chosenVer], 0, stressLen - 1, qLeft, qRight, 0)
    actMin = queryRangeMin(stressPst, stressRoots[chosenVer], 0, stressLen - 1, qLeft, qRight, 0)
    actMax = queryRangeMax(stressPst, stressRoots[chosenVer], 0, stressLen - 1, qLeft, qRight, 0)

    if (actSum != expectedSum or actMin != expectedMin or actMax != expectedMax) {
        stressErrors = stressErrors + 1
    }
    qI = qI + 1
}

if (stressErrors > 0) {
    print("[FAIL] Stress queries had", stressErrors, "mismatches against naive oracle")
} else {
    print("  Validated", testQueries, "random historical queries across", numVersions, "versions: 0 mismatches")
    tAlloc = stressPst[0]
    print("  Total allocated persistent lazy arena nodes:", tAlloc.size())
    print("  Test Case 5 Passed stress benchmark verification")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] Persistent Segment Tree with Lazy Propagation Suite executed successfully in", elapsed, "ms")
