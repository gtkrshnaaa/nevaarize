import stdlib time as t

// 3D Fenwick Tree (Binary Indexed Tree) Suite
// Technical characteristics:
// - Orthogonal 3D volumetric point updates and cuboid sub-volume range sum queries
// - O(log X * log Y * log Z) point update and range query
// - 3D Inclusion-Exclusion principle with 8 distinct terms:
//   Sum(x1..x2, y1..y2, z1..z2) =
//     + P(x2, y2, z2)
//     - P(x1-1, y2, z2) - P(x2, y1-1, z2) - P(x2, y2, z1-1)
//     + P(x1-1, y1-1, z2) + P(x1-1, y2, z1-1) + P(x2, y1-1, z1-1)
//     - P(x1-1, y1-1, z1-1)
// - 3D nested array representation with 1-based indexing
// - Point set operation via delta difference tracking
// - Comprehensive deterministic volumetric assertions and randomized 3D oracle benchmark
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize 3D Fenwick Tree Suite ===")
suiteStartTime = t.millis()

func lowbit(x) {
    return x & (0 - x)
}

func createFenwick3D(dimX, dimY, dimZ) {
    c3Tree = []
    c3Matrix = []
    cx = 0
    while (cx <= dimX) {
        cxRowTree = []
        cxRowMat = []
        cy = 0
        while (cy <= dimY) {
            cyColTree = []
            cyColMat = []
            cz = 0
            while (cz <= dimZ) {
                cyColTree.push(0)
                cyColMat.push(0)
                cz = cz + 1
            }
            cxRowTree.push(cyColTree)
            cxRowMat.push(cyColMat)
            cy = cy + 1
        }
        c3Tree.push(cxRowTree)
        c3Matrix.push(cxRowMat)
        cx = cx + 1
    }
    c3Meta = [dimX, dimY, dimZ]
    return [c3Tree, c3Matrix, c3Meta]
}

func fenwickUpdate3D(ft, posX, posY, posZ, delta) {
    u3Tree = ft[0]
    u3Matrix = ft[1]
    u3Meta = ft[2]
    u3MaxX = u3Meta[0]
    u3MaxY = u3Meta[1]
    u3MaxZ = u3Meta[2]

    if (posX < 1 or posX > u3MaxX or posY < 1 or posY > u3MaxY or posZ < 1 or posZ > u3MaxZ) {
        return 0
    }

    u3Matrix[posX][posY][posZ] = u3Matrix[posX][posY][posZ] + delta

    ux = posX
    while (ux <= u3MaxX) {
        uy = posY
        while (uy <= u3MaxY) {
            uz = posZ
            while (uz <= u3MaxZ) {
                u3Tree[ux][uy][uz] = u3Tree[ux][uy][uz] + delta
                uz = uz + lowbit(uz)
            }
            uy = uy + lowbit(uy)
        }
        ux = ux + lowbit(ux)
    }
    return 1
}

func fenwickPointSet3D(ft, posX, posY, posZ, newVal) {
    ps3Matrix = ft[1]
    ps3CurrVal = ps3Matrix[posX][posY][posZ]
    ps3Delta = newVal - ps3CurrVal
    return fenwickUpdate3D(ft, posX, posY, posZ, ps3Delta)
}

func fenwickQueryPrefix3D(ft, posX, posY, posZ) {
    qp3Tree = ft[0]
    qp3Meta = ft[2]
    qp3MaxX = qp3Meta[0]
    qp3MaxY = qp3Meta[1]
    qp3MaxZ = qp3Meta[2]

    qp3LimitX = posX
    if (qp3LimitX > qp3MaxX) {
        qp3LimitX = qp3MaxX
    }
    qp3LimitY = posY
    if (qp3LimitY > qp3MaxY) {
        qp3LimitY = qp3MaxY
    }
    qp3LimitZ = posZ
    if (qp3LimitZ > qp3MaxZ) {
        qp3LimitZ = qp3MaxZ
    }

    qp3Sum = 0
    qpx = qp3LimitX
    while (qpx > 0) {
        qpy = qp3LimitY
        while (qpy > 0) {
            qpz = qp3LimitZ
            while (qpz > 0) {
                qp3Sum = qp3Sum + qp3Tree[qpx][qpy][qpz]
                qpz = qpz - lowbit(qpz)
            }
            qpy = qpy - lowbit(qpy)
        }
        qpx = qpx - lowbit(qpx)
    }
    return qp3Sum
}

func fenwickQueryRange3D(ft, x1, y1, z1, x2, y2, z2) {
    if (x1 > x2 or y1 > y2 or z1 > z2) {
        return 0
    }

    vPPP = fenwickQueryPrefix3D(ft, x2, y2, z2)

    vMPP = fenwickQueryPrefix3D(ft, x1 - 1, y2, z2)
    vPMP = fenwickQueryPrefix3D(ft, x2, y1 - 1, z2)
    vPPM = fenwickQueryPrefix3D(ft, x2, y2, z1 - 1)

    vMMP = fenwickQueryPrefix3D(ft, x1 - 1, y1 - 1, z2)
    vMPM = fenwickQueryPrefix3D(ft, x1 - 1, y2, z1 - 1)
    vPMM = fenwickQueryPrefix3D(ft, x2, y1 - 1, z1 - 1)

    vMMM = fenwickQueryPrefix3D(ft, x1 - 1, y1 - 1, z1 - 1)

    posTerms = vPPP + vMMP + vMPM + vPMM
    negTerms = vMPP + vPMP + vPPM + vMMM

    return posTerms - negTerms
}

// -----------------------------------------------------------------------------
// Test Case 1: Deterministic 3x3x3 Volumetric Grid Assertions
// -----------------------------------------------------------------------------
print("Running Test Case 1: Deterministic 3x3x3 Volumetric Grid Assertions...")
tc1Pass = 1
ft1 = createFenwick3D(3, 3, 3)

// Populate 3x3x3 grid with formula: x * 100 + y * 10 + z
// e.g. (1,1,1) = 111, (2,3,1) = 231, (3,3,3) = 333
initX = 1
while (initX <= 3) {
    initY = 1
    while (initY <= 3) {
        initZ = 1
        while (initZ <= 3) {
            initVal = initX * 100 + initY * 10 + initZ
            fenwickUpdate3D(ft1, initX, initY, initZ, initVal)
            initZ = initZ + 1
        }
        initY = initY + 1
    }
    initX = initX + 1
}

// Single corner prefix: (1,1,1) = 111
if (fenwickQueryPrefix3D(ft1, 1, 1, 1) != 111) {
    tc1Pass = 0
}

// Prefix(2, 2, 2) = sum of 8 cells:
// (1,1,1)=111, (1,1,2)=112, (1,2,1)=121, (1,2,2)=122
// (2,1,1)=211, (2,1,2)=212, (2,2,1)=221, (2,2,2)=222
// sum = 466 + 866 = 1332
if (fenwickQueryPrefix3D(ft1, 2, 2, 2) != 1332) {
    tc1Pass = 0
}

// Sub-cuboid range query: (2,2,2) to (3,3,3) = 8 cells:
// (2,2,2)=222, (2,2,3)=223, (2,3,2)=232, (2,3,3)=233
// (3,2,2)=322, (3,2,3)=323, (3,3,2)=332, (3,3,3)=333
// sum = 910 + 1310 = 2220
range2to3 = fenwickQueryRange3D(ft1, 2, 2, 2, 3, 3, 3)
if (range2to3 != 2220) {
    tc1Pass = 0
}

// Full volume range query: (1,1,1) to (3,3,3)
// total elements = 27
// sum of x * 100 for each x in 1..3 (9 times each) = 9 * 100 * (1+2+3) = 5400
// sum of y * 10 for each y in 1..3 (9 times each) = 9 * 10 * (1+2+3) = 540
// sum of z for each z in 1..3 (9 times each) = 9 * (1+2+3) = 54
// total sum = 5994
fullVol = fenwickQueryRange3D(ft1, 1, 1, 1, 3, 3, 3)
if (fullVol != 5994) {
    tc1Pass = 0
}

// 1D line slice query: (1, 2, 1) to (3, 2, 1) = (1,2,1) + (2,2,1) + (3,2,1) = 121 + 221 + 321 = 663
lineSlice = fenwickQueryRange3D(ft1, 1, 2, 1, 3, 2, 1)
if (lineSlice != 663) {
    tc1Pass = 0
}

if (tc1Pass == 1) {
    print("  3x3x3 volumetric grid populated deterministically")
    print("  Prefix sums and 8-term inclusion-exclusion sub-cuboids verified")
    print("  Test Case 1 Passed successfully")
} else {
    print("[FAIL] Test Case 1 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 2: Volumetric Point Sets, Negative Deltas, and Corner Boundaries
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 2: Point Sets, Negative Deltas, and Boundary Topologies...")
tc2Pass = 1
ft2 = createFenwick3D(4, 4, 4)

// Single cell update at (1, 1, 1)
fenwickUpdate3D(ft2, 1, 1, 1, 200)
if (fenwickQueryRange3D(ft2, 1, 1, 1, 1, 1, 1) != 200) {
    tc2Pass = 0
}

// Point set at (1, 1, 1) from 200 to 50
fenwickPointSet3D(ft2, 1, 1, 1, 50)
if (fenwickQueryRange3D(ft2, 1, 1, 1, 1, 1, 1) != 50) {
    tc2Pass = 0
}

// Negative updates at (2, 2, 2)
fenwickUpdate3D(ft2, 2, 2, 2, -120)
if (fenwickQueryRange3D(ft2, 2, 2, 2, 2, 2, 2) != -120) {
    tc2Pass = 0
}

// Range covering (1,1,1) and (2,2,2) = 50 - 120 = -70
if (fenwickQueryRange3D(ft2, 1, 1, 1, 2, 2, 2) != -70) {
    tc2Pass = 0
}

// Boundary (4, 4, 4) update
fenwickUpdate3D(ft2, 4, 4, 4, 300)
if (fenwickQueryRange3D(ft2, 4, 4, 4, 4, 4, 4) != 300) {
    tc2Pass = 0
}

// Total volume sum = 50 - 120 + 300 = 230
if (fenwickQueryRange3D(ft2, 1, 1, 1, 4, 4, 4) != 230) {
    tc2Pass = 0
}

// Invalid empty query range
if (fenwickQueryRange3D(ft2, 3, 3, 3, 2, 2, 2) != 0) {
    tc2Pass = 0
}

if (tc2Pass == 1) {
    print("  Volumetric point sets and delta tracking verified")
    print("  Negative values and zero cancellation across 3D cuboids confirmed")
    print("  Corner boundaries (1,1,1) and (4,4,4) accurately computed")
    print("  Test Case 2 Passed successfully")
} else {
    print("[FAIL] Test Case 2 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 3: Randomized 3D Volumetric Simulation against 3D Array Oracle
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 3: Randomized 3D Simulation against Volumetric Oracle...")
gridSize = 5
ftStress3D = createFenwick3D(gridSize, gridSize, gridSize)

// Oracle 3D array (1-based, (gridSize+1)^3)
oracleVol = []
oxI = 0
while (oxI <= gridSize) {
    oxRow = []
    oyI = 0
    while (oyI <= gridSize) {
        ozRow = []
        ozI = 0
        while (ozI <= gridSize) {
            ozRow.push(0)
            ozI = ozI + 1
        }
        oxRow.push(ozRow)
        oyI = oyI + 1
    }
    oracleVol.push(oxRow)
    oxI = oxI + 1
}

s3Seed = 99887766
s3Ops = 200
s3OpI = 0
s3Mismatches = 0
s3TotalUpdates = 0
s3TotalQueries = 0

while (s3OpI < s3Ops) {
    s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
    s3OpType = (s3Seed / 65536) % 3

    if (s3OpType == 0) {
        // Point update
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        randX = (s3Seed % gridSize) + 1
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        randY = (s3Seed % gridSize) + 1
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        randZ = (s3Seed % gridSize) + 1
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        randDelta = (s3Seed % 60) - 25

        fenwickUpdate3D(ftStress3D, randX, randY, randZ, randDelta)
        oracleVol[randX][randY][randZ] = oracleVol[randX][randY][randZ] + randDelta
        s3TotalUpdates = s3TotalUpdates + 1
    }

    if (s3OpType == 1 or s3OpType == 2) {
        // Sub-cuboid range query
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        rxA = (s3Seed % gridSize) + 1
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        rxB = (s3Seed % gridSize) + 1
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        ryA = (s3Seed % gridSize) + 1
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        ryB = (s3Seed % gridSize) + 1
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        rzA = (s3Seed % gridSize) + 1
        s3Seed = (s3Seed * 1103515245 + 12345) % 2147483648
        rzB = (s3Seed % gridSize) + 1

        minX = rxA
        maxX = rxB
        if (minX > maxX) {
            minX = rxB
            maxX = rxA
        }

        minY = ryA
        maxY = ryB
        if (minY > maxY) {
            minY = ryB
            maxY = ryA
        }

        minZ = rzA
        maxZ = rzB
        if (minZ > maxZ) {
            minZ = rzB
            maxZ = rzA
        }

        ftVal = fenwickQueryRange3D(ftStress3D, minX, minY, minZ, maxX, maxY, maxZ)

        // Oracle 3D volume summation
        oracleVal = 0
        oX = minX
        while (oX <= maxX) {
            oY = minY
            while (oY <= maxY) {
                oZ = minZ
                while (oZ <= maxZ) {
                    oracleVal = oracleVal + oracleVol[oX][oY][oZ]
                    oZ = oZ + 1
                }
                oY = oY + 1
            }
            oX = oX + 1
        }

        if (ftVal != oracleVal) {
            print("[FAIL] Mismatch for box (", minX, ",", minY, ",", minZ, ") to (", maxX, ",", maxY, ",", maxZ, "): ft=", ftVal, ", oracle=", oracleVal)
            s3Mismatches = s3Mismatches + 1
            s3OpI = s3Ops // break
        }
        s3TotalQueries = s3TotalQueries + 1
    }

    s3OpI = s3OpI + 1
}

if (s3Mismatches == 0) {
    print("  Executed", s3Ops, "randomized volumetric operations (", s3TotalUpdates, "updates,", s3TotalQueries, "sub-cuboid queries): 0 mismatches")
    print("  100% agreement with 3D array oracle")
    print("  Test Case 3 Passed successfully")
} else {
    print("[FAIL] Stress simulation encountered", s3Mismatches, "mismatches")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] 3D Fenwick Tree Suite executed successfully in", elapsed, "ms")
