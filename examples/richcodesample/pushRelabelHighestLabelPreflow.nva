import stdlib time as t

// Highest-Label Push-Relabel (HLPP) Preflow-Push Maximum Flow Algorithm Suite
// Time Complexity: O(V^2 * sqrt(E)) with highest-label selection and gap relabeling heuristic
// Space Complexity: O(V + E) compact forward-star residual representation
// Technical characteristics:
// - Preflow initialization saturating all source-incident edges
// - Highest-label selection via bucket priority queues
// - Backward BFS global relabeling heuristic establishing exact residual distance labels
// - Gap relabeling heuristic detecting unreachable components when label levels empty
// - Current-arc work pointers avoiding redundant residual edge scans
// - Active excess discharge with flow return to source
// - Duality verification via Max-Flow Min-Cut Theorem (Max Flow == Min Cut Capacity)
// - Formal invariant assertions: Flow conservation at all internal nodes and capacity bounds
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Highest-Label Push-Relabel (HLPP) Algorithm Suite ===")
globalStartTime = t.millis()

func makeIntArray(sz, fillVal) {
    arr = []
    i = 0
    while (i < sz) {
        arr.push(fillVal)
        i = i + 1
    }
    return arr
}

func minInt(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func maxInt(a, b) {
    if (a > b) {
        return a
    }
    return b
}

func createHLPPNetwork(numNodes) {
    head = makeIntArray(numNodes, -1)
    edgeTo = []
    edgeCap = []
    edgeFlow = []
    edgeRev = []
    edgeNext = []
    return [numNodes, head, edgeTo, edgeCap, edgeFlow, edgeRev, edgeNext]
}

func addHLPPEdge(net, u, v, cap) {
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    forwardIdx = edgeTo.size()
    reverseIdx = forwardIdx + 1

    // Forward edge u -> v
    edgeTo.push(v)
    edgeCap.push(cap)
    edgeFlow.push(0)
    edgeRev.push(reverseIdx)
    edgeNext.push(head[u])
    head[u] = forwardIdx

    // Residual backward edge v -> u
    edgeTo.push(u)
    edgeCap.push(0)
    edgeFlow.push(0)
    edgeRev.push(forwardIdx)
    edgeNext.push(head[v])
    head[v] = reverseIdx

    net[1] = head
    net[2] = edgeTo
    net[3] = edgeCap
    net[4] = edgeFlow
    net[5] = edgeRev
    net[6] = edgeNext
}

func globalRelabel(net, src, snk, height, count) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    i = 0
    while (i < numNodes) {
        height[i] = numNodes
        i = i + 1
    }

    maxHeightBound = 2 * numNodes + 2
    i = 0
    while (i < maxHeightBound) {
        count[i] = 0
        i = i + 1
    }

    height[snk] = 0
    queue = []
    qHead = 0
    queue.push(snk)

    while (qHead < queue.size()) {
        v = queue[qHead]
        qHead = qHead + 1

        e = head[v]
        while (e != -1) {
            rev = edgeRev[e]
            u = edgeTo[e]
            remCap = edgeCap[rev] - edgeFlow[rev]
            if (remCap > 0 and height[u] == numNodes and u != src) {
                height[u] = height[v] + 1
                queue.push(u)
            }
            e = edgeNext[e]
        }
    }

    height[src] = numNodes

    u = 0
    while (u < numNodes) {
        h = height[u]
        if (h < maxHeightBound) {
            count[h] = count[h] + 1
        }
        u = u + 1
    }
}

func executeHLPPMaxFlow(net, src, snk) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    if (src == snk or numNodes <= 1) {
        return [0, 0, 0]
    }

    excess = makeIntArray(numNodes, 0)
    height = makeIntArray(numNodes, 0)
    maxHeightBound = 2 * numNodes + 4
    count = makeIntArray(maxHeightBound, 0)
    currentArc = makeIntArray(numNodes, -1)
    inBucket = makeIntArray(numNodes, 0)

    buckets = []
    i = 0
    while (i < maxHeightBound) {
        buckets.push([])
        i = i + 1
    }

    globalRelabel(net, src, snk, height, count)

    i = 0
    while (i < numNodes) {
        currentArc[i] = head[i]
        i = i + 1
    }

    maxHeight = 0
    relabelOps = 0
    pushOps = 0

    // Initial preflow push from source
    e = head[src]
    while (e != -1) {
        cap = edgeCap[e]
        if (cap > 0) {
            v = edgeTo[e]
            edgeFlow[e] = cap
            rev = edgeRev[e]
            edgeFlow[rev] = 0 - cap
            excess[src] = excess[src] - cap
            excess[v] = excess[v] + cap
            pushOps = pushOps + 1

            if (v != src and v != snk and inBucket[v] == 0 and excess[v] > 0) {
                h = height[v]
                buckets[h].push(v)
                inBucket[v] = 1
                if (h > maxHeight) {
                    maxHeight = h
                }
            }
        }
        e = edgeNext[e]
    }

    // Main highest-label preflow-push discharge loop
    while (maxHeight >= 0) {
        if (buckets[maxHeight].size() == 0) {
            maxHeight = maxHeight - 1
        } else {
            u = buckets[maxHeight].pop()
            inBucket[u] = 0

            // Discharge active vertex u
            while (excess[u] > 0) {
                arc = currentArc[u]
                while (arc != -1 and excess[u] > 0) {
                    v = edgeTo[arc]
                    remCap = edgeCap[arc] - edgeFlow[arc]
                    if (remCap > 0 and height[u] == height[v] + 1) {
                        pushAmount = minInt(excess[u], remCap)
                        edgeFlow[arc] = edgeFlow[arc] + pushAmount
                        revArc = edgeRev[arc]
                        edgeFlow[revArc] = edgeFlow[revArc] - pushAmount
                        excess[u] = excess[u] - pushAmount
                        excess[v] = excess[v] + pushAmount
                        pushOps = pushOps + 1

                        if (v != src and v != snk and inBucket[v] == 0 and excess[v] > 0) {
                            hv = height[v]
                            buckets[hv].push(v)
                            inBucket[v] = 1
                            if (hv > maxHeight) {
                                maxHeight = hv
                            }
                        }
                    }
                    if (excess[u] > 0) {
                        arc = edgeNext[arc]
                    }
                }
                currentArc[u] = arc

                if (excess[u] > 0) {
                    // Relabel vertex u
                    oldHeight = height[u]
                    relabelOps = relabelOps + 1

                    if (oldHeight < maxHeightBound) {
                        count[oldHeight] = count[oldHeight] - 1
                    }

                    // Gap relabeling heuristic
                    if (oldHeight < numNodes and count[oldHeight] == 0) {
                        w = 0
                        while (w < numNodes) {
                            hw = height[w]
                            if (hw > oldHeight and hw < numNodes and w != src and w != snk) {
                                count[hw] = count[hw] - 1
                                height[w] = numNodes + 1
                                count[numNodes + 1] = count[numNodes + 1] + 1
                            }
                            w = w + 1
                        }
                    }

                    minNeighborH = 2 * numNodes + 10
                    eCheck = head[u]
                    while (eCheck != -1) {
                        remCapCheck = edgeCap[eCheck] - edgeFlow[eCheck]
                        if (remCapCheck > 0) {
                            vCheck = edgeTo[eCheck]
                            if (height[vCheck] < minNeighborH) {
                                minNeighborH = height[vCheck]
                            }
                        }
                        eCheck = edgeNext[eCheck]
                    }

                    newHeight = minNeighborH + 1
                    height[u] = newHeight
                    if (newHeight < maxHeightBound) {
                        count[newHeight] = count[newHeight] + 1
                    }
                    currentArc[u] = head[u]

                    if (height[u] < 2 * numNodes) {
                        buckets[height[u]].push(u)
                        inBucket[u] = 1
                        maxHeight = height[u]
                    }
                    // Break discharge loop to re-evaluate highest active label
                    break
                }
            }
        }
    }

    totalMaxFlow = excess[snk]
    return [totalMaxFlow, pushOps, relabelOps]
}

func computeMinCutPartition(net, src) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeNext = net[6]

    visited = makeIntArray(numNodes, 0)
    visited[src] = 1
    queue = []
    qHead = 0
    queue.push(src)

    while (qHead < queue.size()) {
        u = queue[qHead]
        qHead = qHead + 1

        e = head[u]
        while (e != -1) {
            remCap = edgeCap[e] - edgeFlow[e]
            v = edgeTo[e]
            if (remCap > 0 and visited[v] == 0) {
                visited[v] = 1
                queue.push(v)
            }
            e = edgeNext[e]
        }
    }

    cutCapacity = 0
    u = 0
    while (u < numNodes) {
        if (visited[u] == 1) {
            e = head[u]
            while (e != -1) {
                // Forward edges in original graph have even indices
                if (e % 2 == 0) {
                    v = edgeTo[e]
                    if (visited[v] == 0) {
                        cutCapacity = cutCapacity + edgeCap[e]
                    }
                }
                e = edgeNext[e]
            }
        }
        u = u + 1
    }

    return [cutCapacity, visited]
}

func verifyFlowInvariants(net, src, snk, totalMaxFlow) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    // Verify capacity constraints and skew symmetry
    e = 0
    while (e < edgeTo.size()) {
        if (e % 2 == 0) {
            cap = edgeCap[e]
            flw = edgeFlow[e]
            rev = edgeRev[e]
            revFlw = edgeFlow[rev]

            if (flw < 0 or flw > cap) {
                return false
            }
            if (flw != (0 - revFlw)) {
                return false
            }
        }
        e = e + 1
    }

    // Verify node flow conservation
    u = 0
    while (u < numNodes) {
        netOutflow = 0
        e = head[u]
        while (e != -1) {
            netOutflow = netOutflow + edgeFlow[e]
            e = edgeNext[e]
        }

        if (u == src) {
            if (netOutflow != totalMaxFlow) {
                return false
            }
        } elif (u == snk) {
            if (netOutflow != (0 - totalMaxFlow)) {
                return false
            }
        } else {
            if (netOutflow != 0) {
                return false
            }
        }
        u = u + 1
    }

    return true
}

func runHLPPTestCase(caseId, description, numNodes, edgesList, src, snk, expectedFlow) {
    print("Running Test Case " + caseId + ": " + description + "...")
    edgeCount = edgesList.size() / 3
    print("  Nodes: " + numNodes + ", Directed Edges: " + edgeCount + ", Source: " + src + ", Sink: " + snk)

    net = createHLPPNetwork(numNodes)
    i = 0
    while (i < edgesList.size()) {
        u = edgesList[i]
        v = edgesList[i + 1]
        cap = edgesList[i + 2]
        addHLPPEdge(net, u, v, cap)
        i = i + 3
    }

    flowResult = executeHLPPMaxFlow(net, src, snk)
    computedFlow = flowResult[0]
    pushOps = flowResult[1]
    relabelOps = flowResult[2]

    cutResult = computeMinCutPartition(net, src)
    minCutCapacity = cutResult[0]

    invariantsHold = verifyFlowInvariants(net, src, snk, computedFlow)

    print("  Max Flow Computed   : " + computedFlow + " (Expected: " + expectedFlow + ")")
    print("  Min Cut Capacity    : " + minCutCapacity)
    print("  Push Operations     : " + pushOps)
    print("  Relabel Operations  : " + relabelOps)
    invariantsText = "INVALID"
    if (invariantsHold) {
        invariantsText = "VALID"
    }
    print("  Flow Invariants     : " + invariantsText)

    if (computedFlow == expectedFlow and computedFlow == minCutCapacity and invariantsHold) {
        print("  Test Case " + caseId + " PASSED (Max-Flow Min-Cut Duality verified)")
        return true
    }

    print("[FAIL] Test Case " + caseId + " failed verification")
    return false
}

allHLPPPassed = true

