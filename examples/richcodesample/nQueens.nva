import stdlib time as t

// N-Queens Problem Solver
// Solves the N-Queens constraint satisfaction problem using recursive backtracking.
// Demonstrates deep recursion, diagonal conflict detection, and solution counting.

func isSafe(queens, row, col) {
    i = 0
    while (i < row) {
        qCol = queens[i]
        // Same column check
        if (qCol == col) { return 0 }
        // Diagonal conflict: |row - i| == |col - qCol|
        rowDiff = row - i
        colDiff = col - qCol
        if (colDiff < 0) { colDiff = 0 - colDiff }
        if (rowDiff == colDiff) { return 0 }
        i = i + 1
    }
    return 1
}

func solveNQueens(queens, n, row, solutions) {
    if (row == n) {
        solutions[0] = solutions[0] + 1
        return 1
    }

    col = 0
    while (col < n) {
        if (isSafe(queens, row, col) == 1) {
            queens[row] = col
            solveNQueens(queens, n, row + 1, solutions)
            queens[row] = -1
        }
        col = col + 1
    }
    return 0
}

func printSolution(queens, n) {
    r = 0
    while (r < n) {
        row = ""
        c = 0
        while (c < n) {
            if (queens[r] == c) {
                print("Q", " ")
            } else {
                print(".", " ")
            }
            c = c + 1
        }
        r = r + 1
    }
}

// Main Execution
print("=== Nevaarize N-Queens Solver ===")

// Solve for N=8 (classic problem)
n = 8
queens = [-1, -1, -1, -1, -1, -1, -1, -1]
solutions = [0]

print("Solving", n, "-Queens problem...")
start = t.millis()
solveNQueens(queens, n, 0, solutions)
elapsed = t.millis() - start

print("Total solutions found:", solutions[0])
print("Expected: 92")
print("Time:", elapsed, "ms")

// Edge case: N=1 (trivial)
print("\n--- Edge Case: N=1 ---")
q1 = [-1]
s1 = [0]
solveNQueens(q1, 1, 0, s1)
print("N=1 solutions:", s1[0], "(expected: 1)")

// Edge case: N=2 (impossible)
print("\n--- Edge Case: N=2 ---")
q2 = [-1, -1]
s2 = [0]
solveNQueens(q2, 2, 0, s2)
print("N=2 solutions:", s2[0], "(expected: 0)")

// Edge case: N=3 (impossible)
print("\n--- Edge Case: N=3 ---")
q3 = [-1, -1, -1]
s3 = [0]
solveNQueens(q3, 3, 0, s3)
print("N=3 solutions:", s3[0], "(expected: 0)")

print("\nN-Queens solver finished.")
