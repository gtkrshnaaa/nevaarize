import stdlib time as t

// N-Queens Problem Solver (Iterative Backtracking)
// Uses iterative approach with manual backtracking to avoid recursion limits.
// Demonstrates constraint satisfaction, conflict detection, and solution counting.

function isSafe(queens, row, col, n) {
    i = 0
    while (i < row) {
        qCol = queens[i]
        if (qCol == col) { return 0 }
        rowDiff = row - i
        colDiff = col - qCol
        if (colDiff < 0) { colDiff = 0 - colDiff }
        if (rowDiff == colDiff) { return 0 }
        i = i + 1
    }
    return 1
}

function solveNQueens(n) {
    queens = []
    i = 0
    while (i < n) {
        queens.push(0)
        i = i + 1
    }

    solutions = 0
    row = 0
    queens[0] = -1

    while (row >= 0) {
        queens[row] = queens[row] + 1

        // Find a valid column for this row
        while (queens[row] < n and isSafe(queens, row, queens[row], n) == 0) {
            queens[row] = queens[row] + 1
        }

        if (queens[row] < n) {
            if (row == n - 1) {
                solutions = solutions + 1
            } else {
                row = row + 1
                queens[row] = -1
            }
        } else {
            row = row - 1
        }
    }

    return solutions
}

// Main Execution
print("=== Nevaarize N-Queens Solver (Iterative) ===")

// Edge case: N=1 (trivial, single cell)
print("--- N=1 (trivial) ---")
s1 = solveNQueens(1)
print("Solutions:", s1, "(expected: 1)")

// Edge case: N=2 (impossible, no valid placement)
print("\n--- N=2 (impossible) ---")
s2 = solveNQueens(2)
print("Solutions:", s2, "(expected: 0)")

// Edge case: N=3 (impossible)
print("\n--- N=3 (impossible) ---")
s3 = solveNQueens(3)
print("Solutions:", s3, "(expected: 0)")

// N=4 (smallest non-trivial solvable case)
print("\n--- N=4 ---")
start = t.millis()
s4 = solveNQueens(4)
elapsed = t.millis() - start
print("Solutions:", s4, "(expected: 2)")
print("Time:", elapsed, "ms")

// N=5 (10 solutions)
print("\n--- N=5 ---")
start = t.millis()
s5 = solveNQueens(5)
elapsed = t.millis() - start
print("Solutions:", s5, "(expected: 10)")
print("Time:", elapsed, "ms")

print("\nN-Queens solver finished.")
