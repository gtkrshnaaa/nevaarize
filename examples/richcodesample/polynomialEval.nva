print("=== Polynomial Evaluation ===")
c = [2, 3, 0, 7]
r0 = c[0]
i = 1
while (i < 4) { r0 = r0 * 0 + c[i]
i = i + 1 }
print("P(0):", r0, "(expected: 7)")
r1 = c[0]
i = 1
while (i < 4) { r1 = r1 * 1 + c[i]
i = i + 1 }
print("P(1):", r1, "(expected: 12)")
r2 = c[0]
i = 1
while (i < 4) { r2 = r2 * 2 + c[i]
i = i + 1 }
print("P(2):", r2, "(expected: 35)")
r10 = c[0]
i = 1
while (i < 4) { r10 = r10 * 10 + c[i]
i = i + 1 }
print("P(10):", r10, "(expected: 2307)")
print("Polynomial finished.")
