import stdlib time as t

// Dinic Algorithm with Capacity Scaling for Maximum Network Flow
// Time Complexity: O(V * E * log(U)) with capacity scaling and current-arc DFS
// Space Complexity: O(V + E) compact forward-star residual representation
// Technical characteristics:
// - Capacity scaling parameter Delta starts at highest power of 2 <= max capacity
// - Filtered BFS level graph traversal enforces residual capacity >= Delta
// - Blocking flow DFS with current-arc pointer optimization (work pointers)
// - Flow conservation and capacity bound invariants verified across all nodes
// - Max-Flow Min-Cut duality verification: Max Flow == Min Cut Capacity
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Dinic Capacity Scaling Max-Flow Algorithm Suite ===")
globalStartTime = t.millis()

func makeIntArray(sz, fillVal) {
    arr = []
    i = 0
    while (i < sz) {
        arr.push(fillVal)
        i = i + 1
    }
    return arr
}

func minInt(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func maxInt(a, b) {
    if (a > b) {
        return a
    }
    return b
}

func createDinicNetwork(numNodes) {
    head = makeIntArray(numNodes, -1)
    edgeTo = []
    edgeCap = []
    edgeFlow = []
    edgeRev = []
    edgeNext = []
    return [numNodes, head, edgeTo, edgeCap, edgeFlow, edgeRev, edgeNext]
}

func addDinicEdge(net, u, v, cap) {
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    forwardIdx = edgeTo.size()
    reverseIdx = forwardIdx + 1

    // Forward edge u -> v
    edgeTo.push(v)
    edgeCap.push(cap)
    edgeFlow.push(0)
    edgeRev.push(reverseIdx)
    edgeNext.push(head[u])
    head[u] = forwardIdx

    // Residual reverse edge v -> u
    edgeTo.push(u)
    edgeCap.push(0)
    edgeFlow.push(0)
    edgeRev.push(forwardIdx)
    edgeNext.push(head[v])
    head[v] = reverseIdx

    net[1] = head
    net[2] = edgeTo
    net[3] = edgeCap
    net[4] = edgeFlow
    net[5] = edgeRev
    net[6] = edgeNext
}

func dinicBfs(net, s, tNode, level, delta) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeNext = net[6]

    i = 0
    while (i < numNodes) {
        level[i] = -1
        i = i + 1
    }

    queue = []
    qHead = 0

    level[s] = 0
    queue.push(s)

    while (qHead < queue.size()) {
        u = queue[qHead]
        qHead = qHead + 1

        e = head[u]
        while (e != -1) {
            v = edgeTo[e]
            resCap = edgeCap[e] - edgeFlow[e]
            if (resCap >= delta && level[v] == -1) {
                level[v] = level[u] + 1
                queue.push(v)
            }
            e = edgeNext[e]
        }
    }

    if (level[tNode] != -1) {
        return true
    }
    return false
}

func dinicDfs(net, u, tNode, pushed, level, ptr, delta) {
    if (pushed == 0 || u == tNode) {
        return pushed
    }

    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    e = ptr[u]
    while (e != -1) {
        v = edgeTo[e]
        resCap = edgeCap[e] - edgeFlow[e]

        if (level[v] == level[u] + 1 && resCap >= delta) {
            pushLimit = minInt(pushed, resCap)
            tr = dinicDfs(net, v, tNode, pushLimit, level, ptr, delta)
            if (tr > 0) {
                edgeFlow[e] = edgeFlow[e] + tr
                revE = edgeRev[e]
                edgeFlow[revE] = edgeFlow[revE] - tr
                return tr
            }
        }

        e = edgeNext[e]
        ptr[u] = e
    }

    return 0
}

func computeDinicScalingMaxFlow(net, s, tNode) {
    numNodes = net[0]
    head = net[1]
    edgeCap = net[3]

    // Determine initial scaling factor Delta (highest power of 2 <= max capacity)
    maxC = 0
    eIdx = 0
    totalEdges = edgeCap.size()
    while (eIdx < totalEdges) {
        if (edgeCap[eIdx] > maxC) {
            maxC = edgeCap[eIdx]
        }
        eIdx = eIdx + 1
    }

    delta = 1
    while (delta <= maxC / 2) {
        delta = delta * 2
    }

    level = makeIntArray(numNodes, -1)
    ptr = makeIntArray(numNodes, 0)
    totalFlow = 0
    bfsPhases = 0
    dfsPushes = 0

    while (delta >= 1) {
        while (dinicBfs(net, s, tNode, level, delta)) {
            bfsPhases = bfsPhases + 1
            // Reset work pointers to current adjacency heads
            i = 0
            while (i < numNodes) {
                ptr[i] = head[i]
                i = i + 1
            }

            pushed = dinicDfs(net, s, tNode, 1000000000, level, ptr, delta)
            while (pushed > 0) {
                totalFlow = totalFlow + pushed
                dfsPushes = dfsPushes + 1
                pushed = dinicDfs(net, s, tNode, 1000000000, level, ptr, delta)
            }
        }
        delta = delta / 2
    }

    return [totalFlow, bfsPhases, dfsPushes]
}

func computeMinCutCapacity(net, s) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeNext = net[6]

    visited = makeIntArray(numNodes, 0)
    queue = []
    qHead = 0

    visited[s] = 1
    queue.push(s)

    while (qHead < queue.size()) {
        u = queue[qHead]
        qHead = qHead + 1

        e = head[u]
        while (e != -1) {
            v = edgeTo[e]
            resCap = edgeCap[e] - edgeFlow[e]
            if (resCap > 0 && visited[v] == 0) {
                visited[v] = 1
                queue.push(v)
            }
            e = edgeNext[e]
        }
    }

    cutCap = 0
    u = 0
    while (u < numNodes) {
        if (visited[u] == 1) {
            e = head[u]
            while (e != -1) {
                v = edgeTo[e]
                // Only count original forward edges crossing the cut
                if (visited[v] == 0 && edgeCap[e] > 0) {
                    cutCap = cutCap + edgeCap[e]
                }
                e = edgeNext[e]
            }
        }
        u = u + 1
    }

    return cutCap
}

func verifyFlowInvariants(net, s, tNode, expectedFlow) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    // 1. Capacity bounds check & skew symmetry
    totalEdges = edgeTo.size()
    e = 0
    while (e < totalEdges) {
        if (edgeFlow[e] > edgeCap[e]) {
            return false
        }
        revE = edgeRev[e]
        if (edgeFlow[e] + edgeFlow[revE] != 0) {
            return false
        }
        e = e + 1
    }

    // 2. Flow conservation at internal nodes
    u = 0
    while (u < numNodes) {
        if (u != s && u != tNode) {
            netFlow = 0
            currE = head[u]
            while (currE != -1) {
                netFlow = netFlow + edgeFlow[currE]
                currE = edgeNext[currE]
            }
            if (netFlow != 0) {
                return false
            }
        }
        u = u + 1
    }

    // 3. Source net outgoing flow must match total flow
    sourceOutFlow = 0
    currE = head[s]
    while (currE != -1) {
        sourceOutFlow = sourceOutFlow + edgeFlow[currE]
        currE = edgeNext[currE]
    }
    if (sourceOutFlow != expectedFlow) {
        return false
    }

    return true
}

func runDinicTestCase(testNum, testName, numNodes, edgesFlat, s, tNode, expectedMaxFlow) {
    print("Running Test Case " + testNum + ": " + testName + "...")
    net = createDinicNetwork(numNodes)

    idx = 0
    edgeCount = edgesFlat.size() / 3
    while (idx < edgesFlat.size()) {
        u = edgesFlat[idx]
        v = edgesFlat[idx + 1]
        cap = edgesFlat[idx + 2]
        addDinicEdge(net, u, v, cap)
        idx = idx + 3
    }

    res = computeDinicScalingMaxFlow(net, s, tNode)
    actualFlow = res[0]
    bfsPhases = res[1]
    dfsPushes = res[2]

    minCut = computeMinCutCapacity(net, s)
    invariantsOk = verifyFlowInvariants(net, s, tNode, actualFlow)

    print("  Nodes:", numNodes, "Directed Edges:", edgeCount, "Source:", s, "Sink:", tNode)
    print("  Max Flow Computed   :", actualFlow, "(Expected:", expectedMaxFlow, ")")
    print("  Min Cut Capacity    :", minCut)
    print("  BFS Phases Count    :", bfsPhases)
    print("  DFS Pushes Count    :", dfsPushes)
    if (invariantsOk) {
        print("  Flow Invariants     : VALID")
    } else {
        print("  Flow Invariants     : INVALID")
        return false
    }

    if (actualFlow != expectedMaxFlow) {
        print("  [FAIL] Flow mismatch: got", actualFlow, "expected", expectedMaxFlow)
        return false
    }

    if (actualFlow != minCut) {
        print("  [FAIL] Max-Flow Min-Cut duality broken: flow", actualFlow, "cut", minCut)
        return false
    }

    print("  Test Case " + testNum + " PASSED (Max-Flow Min-Cut Duality verified)")
    return true
}

allDinicPassed = true

// --- Test Case 1: Textbook 6-Node Flow Network ---
e1 = [
    0, 1, 10,
