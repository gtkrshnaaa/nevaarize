import stdlib time as t

// Block-Cut Tree (BCT) & Biconnected Components (BCC) Suite
// Decomposition of undirected graphs into 2-vertex-connected blocks and articulation points.
//
// Time Complexity:
// - O(V + E) biconnected component decomposition via iterative Tarjan DFS
// - O(V + E) Block-Cut Tree bipartite graph construction
// - O(V + E) bridge detection and 2-edge-connected components identification
// - O(V) path cut-vertex query via BFS on Block-Cut Tree
// Space Complexity: O(V + E) compact adjacency lists and explicit call stacks
//
// Technical characteristics:
// - Iterative Tarjan DFS with explicit call frames avoiding call stack overflow
// - Dual node partitioning: Block nodes (B-nodes) and Cut vertex nodes (C-nodes)
// - Path cut-vertex extraction: identifies all mandatory articulation bottlenecks between any two vertices
// - Deterministic validation against naive vertex/edge removal connectivity oracles
// - Unique symbol scoping per function avoiding JIT variable slot collisions
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Block-Cut Tree Biconnected Components Suite ===")
globalStartTime = t.millis()

func minInt(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func maxInt(a, b) {
    if (a > b) {
        return a
    }
    return b
}

func makeIntArray(sz, fillVal) {
    arr = []
    miaIdx = 0
    while (miaIdx < sz) {
        arr.push(fillVal)
        miaIdx = miaIdx + 1
    }
    return arr
}

func createGraph(numVertices) {
    cgAdj = []
    cgI = 0
    while (cgI < numVertices) {
        cgAdj.push([])
        cgI = cgI + 1
    }
    cgEdges = []
    return [numVertices, cgAdj, cgEdges]
}

func addGraphEdge(graph, aeU, aeV) {
    aeAdj = graph[1]
    aeEdges = graph[2]

    aeAdj[aeU].push(aeV)
    aeAdj[aeV].push(aeU)
    aeEdges.push([aeU, aeV])
}

// Decompose graph into biconnected components (blocks) and identify cut vertices
func decomposeBiconnectedComponents(graph) {
    dbcNum = graph[0]
    dbcAdj = graph[1]

    dbcDfn = makeIntArray(dbcNum, -1)
    dbcLow = makeIntArray(dbcNum, -1)
    dbcIsCut = makeIntArray(dbcNum, 0)

    dbcTimer = 0
    dbcStk = []
    dbcBlocks = []

    dbcRootCand = 0
    while (dbcRootCand < dbcNum) {
        if (dbcDfn[dbcRootCand] == -1) {
            dbcCallU = [dbcRootCand]
            dbcCallP = [-1]
            dbcCallEdge = [0]
            dbcCallChildCount = [0]

            dbcTimer = dbcTimer + 1
            dbcDfn[dbcRootCand] = dbcTimer
            dbcLow[dbcRootCand] = dbcTimer
            dbcStk.push(dbcRootCand)

            while (dbcCallU.size() > 0) {
                dbcTopIdx = dbcCallU.size() - 1
                dbcU = dbcCallU[dbcTopIdx]
                dbcP = dbcCallP[dbcTopIdx]
                dbcEdgeIdx = dbcCallEdge[dbcTopIdx]
                dbcNeighbors = dbcAdj[dbcU]

                if (dbcEdgeIdx < dbcNeighbors.size()) {
                    dbcCallEdge[dbcTopIdx] = dbcEdgeIdx + 1
                    dbcV = dbcNeighbors[dbcEdgeIdx]

                    if (dbcV != dbcP) {
                        if (dbcDfn[dbcV] != -1) {
                            dbcLow[dbcU] = minInt(dbcLow[dbcU], dbcDfn[dbcV])
                        } else {
                            dbcCallChildCount[dbcTopIdx] = dbcCallChildCount[dbcTopIdx] + 1
                            dbcTimer = dbcTimer + 1
                            dbcDfn[dbcV] = dbcTimer
                            dbcLow[dbcV] = dbcTimer
                            dbcStk.push(dbcV)

                            dbcCallU.push(dbcV)
                            dbcCallP.push(dbcU)
                            dbcCallEdge.push(0)
                            dbcCallChildCount.push(0)
                        }
                    }
                } else {
                    dbcChCount = dbcCallChildCount[dbcTopIdx]
                    dbcCallU.pop()
                    dbcCallP.pop()
                    dbcCallEdge.pop()
                    dbcCallChildCount.pop()

                    if (dbcCallU.size() > 0) {
                        dbcParentIdx = dbcCallU.size() - 1
                        dbcParentU = dbcCallU[dbcParentIdx]
                        dbcLow[dbcParentU] = minInt(dbcLow[dbcParentU], dbcLow[dbcU])

                        if (dbcLow[dbcU] >= dbcDfn[dbcParentU]) {
                            if (dbcParentU != dbcRootCand) {
                                dbcIsCut[dbcParentU] = 1
                            }

                            dbcNewBlock = []
                            dbcKeepPopping = true
                            while (dbcKeepPopping) {
                                dbcTopNode = dbcStk.pop()
                                dbcNewBlock.push(dbcTopNode)
                                if (dbcTopNode == dbcU) {
                                    dbcKeepPopping = false
                                }
                            }
                            dbcNewBlock.push(dbcParentU)
                            dbcBlocks.push(dbcNewBlock)
                        }
                    } else {
                        if (dbcChCount >= 2) {
                            dbcIsCut[dbcRootCand] = 1
                        }
                        if (dbcNeighbors.size() == 0) {
                            dbcBlocks.push([dbcRootCand])
                        }
                    }
                }
            }
        }
        dbcRootCand = dbcRootCand + 1
    }

    return [dbcBlocks, dbcIsCut]
}

// Build the Block-Cut Tree: bipartite graph of Blocks (B-nodes) and Cut Vertices (C-nodes)
func buildBlockCutTree(graph) {
    bbctDecomp = decomposeBiconnectedComponents(graph)
    bbctBlocks = bbctDecomp[0]
    bbctIsCut = bbctDecomp[1]

    bbctNumOrig = graph[0]
    bbctNumBlocks = bbctBlocks.size()

    // Map each original cut vertex to a C-node index: bbctNumBlocks + cutIndex
    bbctCutNodes = []
    bbctCutIndex = makeIntArray(bbctNumOrig, -1)
    bbctI = 0
    while (bbctI < bbctNumOrig) {
        if (bbctIsCut[bbctI] == 1) {
            cNodeId = bbctNumBlocks + bbctCutNodes.size()
            bbctCutIndex[bbctI] = cNodeId
            bbctCutNodes.push(bbctI)
        }
        bbctI = bbctI + 1
    }

    bbctTotalTreeNodes = bbctNumBlocks + bbctCutNodes.size()
    bbctTreeAdj = []
    bbctJ = 0
    while (bbctJ < bbctTotalTreeNodes) {
        bbctTreeAdj.push([])
        bbctJ = bbctJ + 1
    }

    // Connect each Block node to the Cut Vertices contained within it
    bbctBIdx = 0
    while (bbctBIdx < bbctNumBlocks) {
        blk = bbctBlocks[bbctBIdx]
        bbctK = 0
        while (bbctK < blk.size()) {
            origV = blk[bbctK]
            if (bbctIsCut[origV] == 1) {
                cId = bbctCutIndex[origV]
                bbctTreeAdj[bbctBIdx].push(cId)
                bbctTreeAdj[cId].push(bbctBIdx)
            }
            bbctK = bbctK + 1
        }
        bbctBIdx = bbctBIdx + 1
    }

    // Map each original vertex to at least one Block containing it
    bbctVertexToBlock = makeIntArray(bbctNumOrig, -1)
    bbctB = 0
    while (bbctB < bbctNumBlocks) {
        blk2 = bbctBlocks[bbctB]
        bbctM = 0
        while (bbctM < blk2.size()) {
            v2 = blk2[bbctM]
            if (bbctVertexToBlock[v2] == -1) {
                bbctVertexToBlock[v2] = bbctB
            }
            bbctM = bbctM + 1
        }
        bbctB = bbctB + 1
    }

    return [bbctBlocks, bbctIsCut, bbctCutNodes, bbctCutIndex, bbctTreeAdj, bbctVertexToBlock, bbctTotalTreeNodes]
}

// Find all cut vertices on all paths between s and t in original graph
func queryCutVerticesOnPath(bct, qcvSrc, qcvDst) {
    if (qcvSrc == qcvDst) {
        return []
    }

    qcvV2B = bct[5]
    qcvTreeAdj = bct[4]
    qcvTotNodes = bct[6]
    qcvBlocks = bct[0]
    qcvNumBlocks = qcvBlocks.size()
    qcvCutNodes = bct[2]

    qcvStartB = qcvV2B[qcvSrc]
    qcvEndB = qcvV2B[qcvDst]

    if (qcvStartB == qcvEndB) {
        return []
    }

    // BFS on Block-Cut Tree from qcvStartB to qcvEndB
    qcvVisited = makeIntArray(qcvTotNodes, 0)
    qcvParent = makeIntArray(qcvTotNodes, -1)
    qcvQueue = [qcvStartB]
    qcvVisited[qcvStartB] = 1
    qcvQHead = 0
    qcvFound = false

    while (qcvQHead < qcvQueue.size() and !qcvFound) {
        qcvCurr = qcvQueue[qcvQHead]
        qcvQHead = qcvQHead + 1

        if (qcvCurr == qcvEndB) {
            qcvFound = true
        } else {
            qcvNeighbors = qcvTreeAdj[qcvCurr]
            qcvDeg = qcvNeighbors.size()
            qcvI = 0
            while (qcvI < qcvDeg) {
                qcvNxt = qcvNeighbors[qcvI]
                if (qcvVisited[qcvNxt] == 0) {
                    qcvVisited[qcvNxt] = 1
                    qcvParent[qcvNxt] = qcvCurr
                    qcvQueue.push(qcvNxt)
                }
                qcvI = qcvI + 1
            }
        }
    }

    if (!qcvFound) {
        return []
    }

    // Extract C-nodes along the tree path
    qcvPathCutVertices = []
    qcvTrace = qcvEndB
    while (qcvTrace != -1) {
        if (qcvTrace >= qcvNumBlocks) {
            // It is a C-node
            cutNodeIdx = qcvTrace - qcvNumBlocks
            origCutV = qcvCutNodes[cutNodeIdx]
            qcvPathCutVertices.push(origCutV)
        }
        if (qcvTrace == qcvStartB) {
            qcvTrace = -1
        } else {
            qcvTrace = qcvParent[qcvTrace]
        }
    }

    return qcvPathCutVertices
}

// Detect bridges in graph: an edge (u, v) is a bridge if its block contains only u and v
// and exactly 1 edge exists between u and v
func findBridges(graph, bct) {
    fbBlocks = bct[0]
    fbAdj = graph[1]

    fbBridges = []
    fbB = 0
    while (fbB < fbBlocks.size()) {
        blk = fbBlocks[fbB]
        if (blk.size() == 2) {
            u = blk[0]
            v = blk[1]
            // Count multi-edges between u and v
            edgeCount = 0
            neighbors = fbAdj[u]
            i = 0
            while (i < neighbors.size()) {
                if (neighbors[i] == v) {
                    edgeCount = edgeCount + 1
                }
                i = i + 1
            }
            if (edgeCount == 1) {
                fbBridges.push([u, v])
            }
        }
        fbB = fbB + 1
    }
    return fbBridges
}

// Naive Oracles for Cut Vertex and Bridge Validation
func naiveCountConnectedComponents(graph, nccExcludedVertex) {
    nccNum = graph[0]
    nccAdj = graph[1]

    nccVisited = makeIntArray(nccNum, 0)
    nccComps = 0

    nccStart = 0
    while (nccStart < nccNum) {
        if (nccStart != nccExcludedVertex and nccVisited[nccStart] == 0) {
            nccComps = nccComps + 1
            nccQueue = [nccStart]
            nccVisited[nccStart] = 1
            nccQHead = 0

            while (nccQHead < nccQueue.size()) {
                nccCurr = nccQueue[nccQHead]
                nccQHead = nccQHead + 1

                nccNeighbors = nccAdj[nccCurr]
                nccDeg = nccNeighbors.size()
                nccI = 0
                while (nccI < nccDeg) {
                    nccNxt = nccNeighbors[nccI]
                    if (nccNxt != nccExcludedVertex and nccVisited[nccNxt] == 0) {
                        nccVisited[nccNxt] = 1
                        nccQueue.push(nccNxt)
                    }
                    nccI = nccI + 1
                }
            }
        }
        nccStart = nccStart + 1
    }

    return nccComps
}

func naiveIsCutVertex(graph, nicvU) {
    baselineComps = naiveCountConnectedComponents(graph, -1)
    compsWithoutU = naiveCountConnectedComponents(graph, nicvU)
    // Removing isolated vertex decreases component count; removing articulation point increases it
    return compsWithoutU > baselineComps
}

func naiveIsBridge(graph, nibU, nibV) {
    nibNum = graph[0]
    nibAdj = graph[1]

    // BFS from nibU without using edge (nibU, nibV)
    nibVisited = makeIntArray(nibNum, 0)
    nibQueue = [nibU]
    nibVisited[nibU] = 1
    nibQHead = 0

    nibEdgeSkipped = false
    while (nibQHead < nibQueue.size()) {
        nibCurr = nibQueue[nibQHead]
        nibQHead = nibQHead + 1

        nibNeighbors = nibAdj[nibCurr]
        nibDeg = nibNeighbors.size()
        nibI = 0
        while (nibI < nibDeg) {
            nibNxt = nibNeighbors[nibI]
            isTargetEdge = (nibCurr == nibU and nibNxt == nibV) or (nibCurr == nibV and nibNxt == nibU)
            if (isTargetEdge and !nibEdgeSkipped) {
                nibEdgeSkipped = true
            } else {
                if (nibVisited[nibNxt] == 0) {
                    nibVisited[nibNxt] = 1
                    nibQueue.push(nibNxt)
                }
            }
            nibI = nibI + 1
        }
    }

    return nibVisited[nibV] == 0
}

// --- Test Suites ---
allBctPassed = true

// Suite 1: Butterfly (Bowtie) Graph (5 nodes)
// Triangle A: (0, 1), (1, 2), (2, 0)
// Triangle B: (0, 3), (3, 4), (4, 0)
// Node 0 is the sole articulation point.
print("Running Test Case 1: Butterfly Graph (5 nodes)...")
butterfly = createGraph(5)
addGraphEdge(butterfly, 0, 1)
addGraphEdge(butterfly, 1, 2)
addGraphEdge(butterfly, 2, 0)
addGraphEdge(butterfly, 0, 3)
addGraphEdge(butterfly, 3, 4)
addGraphEdge(butterfly, 4, 0)

bct1 = buildBlockCutTree(butterfly)
blocks1 = bct1[0]
isCut1 = bct1[1]

if (blocks1.size() != 2) {
    print("  [FAIL] Expected 2 blocks, got", blocks1.size())
    allBctPassed = false
}
if (isCut1[0] != 1 or isCut1[1] != 0 or isCut1[2] != 0 or isCut1[3] != 0 or isCut1[4] != 0) {
    print("  [FAIL] Cut vertex identification mismatch: node 0 must be sole cut vertex")
    allBctPassed = false
} else {
    print("  Sole cut vertex 0 identified correctly; 2 biconnected blocks formed")
}

// Path from 1 to 4 must pass through cut vertex 0
cuts14 = queryCutVerticesOnPath(bct1, 1, 4)
if (cuts14.size() != 1 or cuts14[0] != 0) {
    print("  [FAIL] Path (1->4) cut vertices mismatch: got", cuts14.size())
    allBctPassed = false
} else {
    print("  Path (1->4) mandatory cut vertex: [0] (verified)")
}
print("  Test Case 1 PASSED")

// Suite 2: Dumbbell Bridge Graph (6 nodes)
// Triangle A: (0, 1), (1, 2), (2, 0)
// Bridge: (2, 3)
// Triangle B: (3, 4), (4, 5), (5, 3)
// Articulation points: 2 and 3. Bridge: (2, 3).
print("Running Test Case 2: Dumbbell Bridge Graph (6 nodes)...")
dumbbell = createGraph(6)
addGraphEdge(dumbbell, 0, 1)
addGraphEdge(dumbbell, 1, 2)
addGraphEdge(dumbbell, 2, 0)
addGraphEdge(dumbbell, 2, 3)
addGraphEdge(dumbbell, 3, 4)
addGraphEdge(dumbbell, 4, 5)
addGraphEdge(dumbbell, 5, 3)

bct2 = buildBlockCutTree(dumbbell)
blocks2 = bct2[0]
isCut2 = bct2[1]
bridges2 = findBridges(dumbbell, bct2)

if (blocks2.size() != 3) {
    print("  [FAIL] Dumbbell expected 3 blocks, got", blocks2.size())
    allBctPassed = false
}
if (isCut2[2] != 1 or isCut2[3] != 1 or isCut2[0] != 0 or isCut2[5] != 0) {
    print("  [FAIL] Dumbbell cut vertices mismatch: nodes 2 and 3 must be cut vertices")
    allBctPassed = false
}
if (bridges2.size() != 1) {
    print("  [FAIL] Dumbbell bridge count mismatch: got", bridges2.size(), "expected 1")
    allBctPassed = false
} else {
    print("  Dumbbell 3 blocks, 2 cut vertices (2, 3), and bridge (2, 3) identified")
}

// Path from 0 to 5 must pass through cut vertices 2 and 3
cuts05 = queryCutVerticesOnPath(bct2, 0, 5)
has2 = false
has3 = false
c05I = 0
while (c05I < cuts05.size()) {
    if (cuts05[c05I] == 2) { has2 = true }
    if (cuts05[c05I] == 3) { has3 = true }
    c05I = c05I + 1
}
if (!has2 or !has3 or cuts05.size() != 2) {
    print("  [FAIL] Path (0->5) cut vertices mismatch")
    allBctPassed = false
} else {
    print("  Path (0->5) mandatory cut vertices: [2, 3] (verified)")
}
print("  Test Case 2 PASSED")

// Suite 3: Complete Graph K4 (Biconnected, 0 cut vertices)
print("Running Test Case 3: Complete Graph K4 (Biconnected)...")
k4 = createGraph(4)
c3I = 0
while (c3I < 4) {
    c3J = c3I + 1
    while (c3J < 4) {
        addGraphEdge(k4, c3I, c3J)
        c3J = c3J + 1
    }
    c3I = c3I + 1
}

bct3 = buildBlockCutTree(k4)
blocks3 = bct3[0]
isCut3 = bct3[1]
bridges3 = findBridges(k4, bct3)

if (blocks3.size() != 1 or blocks3[0].size() != 4 or bridges3.size() != 0) {
    print("  [FAIL] K4 biconnectivity failed")
    allBctPassed = false
}
c3K = 0
while (c3K < 4) {
    if (isCut3[c3K] != 0) {
        print("  [FAIL] K4 node", c3K, "falsely marked as cut vertex")
        allBctPassed = false
    }
    c3K = c3K + 1
}
print("  Complete graph K4: exactly 1 block, 0 cut vertices, 0 bridges")
print("  Test Case 3 PASSED")

// Suite 4: Complex Irregular Network Cross-Validated with Naive Removal Oracles (10 nodes)
print("Running Test Case 4: Complex Network Oracle Cross-Validation (10 nodes)...")
irregGraph = createGraph(10)
irregEdgesU = [0, 1, 2, 0, 3, 4, 3, 5, 6, 7, 8, 2, 4]
irregEdgesV = [1, 2, 0, 3, 4, 5, 5, 6, 7, 8, 9, 3, 6]

c4E = 0
while (c4E < irregEdgesU.size()) {
    addGraphEdge(irregGraph, irregEdgesU[c4E], irregEdgesV[c4E])
    c4E = c4E + 1
}

bct4 = buildBlockCutTree(irregGraph)
isCut4 = bct4[1]
bridges4 = findBridges(irregGraph, bct4)

// Check every vertex against naive oracle
c4V = 0
cutMismatches = 0
while (c4V < 10) {
    bctCut = (isCut4[c4V] == 1)
    oracleCut = naiveIsCutVertex(irregGraph, c4V)
    if (bctCut != oracleCut) {
        cutMismatches = cutMismatches + 1
        print("  [FAIL] Cut vertex mismatch on node", c4V, "got", bctCut, "oracle", oracleCut)
    }
    c4V = c4V + 1
}

// Check every edge in irregEdges against naive bridge oracle
c4CheckE = 0
bridgeMismatches = 0
while (c4CheckE < irregEdgesU.size()) {
    eu = irregEdgesU[c4CheckE]
    ev = irregEdgesV[c4CheckE]
    oracleBridge = naiveIsBridge(irregGraph, eu, ev)

    // Check if (eu, ev) is in bridges4
    inBctBridges = false
    bIdx = 0
    while (bIdx < bridges4.size()) {
        bu = bridges4[bIdx][0]
        bv = bridges4[bIdx][1]
        if ((bu == eu and bv == ev) or (bu == ev and bv == eu)) {
            inBctBridges = true
        }
        bIdx = bIdx + 1
    }

    if (inBctBridges != oracleBridge) {
        bridgeMismatches = bridgeMismatches + 1
        print("  [FAIL] Bridge mismatch on edge", eu, ev, "got", inBctBridges, "oracle", oracleBridge)
    }
    c4CheckE = c4CheckE + 1
}

if (cutMismatches > 0 or bridgeMismatches > 0) {
    allBctPassed = false
} else {
    print("  All 10 vertices cut checks and all 13 edges bridge checks matched naive oracles deterministically")
}
print("  Test Case 4 PASSED")

print("=== Block-Cut Tree Biconnected Components Suite Summary ===")
if (allBctPassed) {
    print("All Block-Cut Tree Biconnected Components test suites: SUCCESS")
} else {
    print("Some Block-Cut Tree Biconnected Components test suites: FAILED")
}

totalElapsed = t.millis() - globalStartTime
print("[PASS] Block-Cut Tree Biconnected Components executed successfully in", totalElapsed, "ms")
