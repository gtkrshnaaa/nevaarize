import stdlib math as m
import stdlib time as t

// 2D Collision Detection System
// AABB and circle collision tests using integer arithmetic
// to avoid known JIT issues with float comparisons.

print("=== Nevaarize 2D Collision Detection ===\n")

start = t.millis()

// --- AABB Collision Tests using integer coordinates ---
print("--- AABB Collision Tests ---")

// Test 1: Overlapping (0,0,10,10) vs (5,5,10,10)
r1 = 1
if (0 + 10 < 5 or 0 + 10 == 5) { r1 = 0 }
if (5 + 10 < 0 or 5 + 10 == 0) { r1 = 0 }
if (0 + 10 < 5 or 0 + 10 == 5) { r1 = 0 }
if (5 + 10 < 0 or 5 + 10 == 0) { r1 = 0 }
print("Overlapping:", r1, "(expected: 1)")

// Test 2: Gap right (0,0,5,5) vs (10,0,5,5) -> 5 < 10, so no overlap
r2 = 1
if (5 < 10) { r2 = 0 }
print("Gap right:", r2, "(expected: 0)")

// Test 3: Touching edges (0,0,5,5) vs (5,0,5,5)
r3 = 1
if (0 + 5 < 5 or 0 + 5 == 5) { r3 = 0 }
print("Touching:", r3, "(expected: 0)")

// Test 4: Nested (0,0,20,20) vs (5,5,3,3)
r4 = 1
if (0 + 20 < 5 or 0 + 20 == 5) { r4 = 0 }
if (5 + 3 < 0 or 5 + 3 == 0) { r4 = 0 }
if (0 + 20 < 5 or 0 + 20 == 5) { r4 = 0 }
if (5 + 3 < 0 or 5 + 3 == 0) { r4 = 0 }
print("Nested:", r4, "(expected: 1)")

// --- Circle Collision Tests ---
print("\n--- Circle Collision Tests ---")

// Test 5: Overlapping (0,0,r=5) vs (3,0,r=5) -> dist²=9, (r1+r2)²=100
dx5 = 0 - 3
dy5 = 0
distSq5 = dx5 * dx5 + dy5 * dy5
radSumSq5 = 10 * 10
c5 = 0
if (distSq5 < radSumSq5) { c5 = 1 }
if (distSq5 == radSumSq5) { c5 = 1 }
print("Overlapping circles:", c5, "(expected: 1)")

// Test 6: Separated (0,0,r=2) vs (10,0,r=2) -> dist²=100, (r1+r2)²=16
dx6 = 0 - 10
distSq6 = dx6 * dx6
radSumSq6 = 4 * 4
c6 = 0
if (distSq6 < radSumSq6) { c6 = 1 }
if (distSq6 == radSumSq6) { c6 = 1 }
print("Separated circles:", c6, "(expected: 0)")

// Test 7: Touching (0,0,r=5) vs (10,0,r=5) -> dist²=100, (r1+r2)²=100
dx7 = 0 - 10
distSq7 = dx7 * dx7
radSumSq7 = 10 * 10
c7 = 0
if (distSq7 < radSumSq7) { c7 = 1 }
if (distSq7 == radSumSq7) { c7 = 1 }
print("Touching circles:", c7, "(expected: 1)")

// Test 8: Concentric (5,5,r=10) vs (5,5,r=3) -> dist²=0, (r1+r2)²=169
c8 = 0
distSq8 = 0
radSumSq8 = 13 * 13
if (distSq8 < radSumSq8) { c8 = 1 }
print("Concentric:", c8, "(expected: 1)")

// --- Point in Rectangle Tests ---
print("\n--- Point Containment Tests ---")

// Point (5,5) in rect (0,0,10,10)
p1 = 0
if (5 >= 0 and 5 < 11 and 5 >= 0 and 5 < 11) { p1 = 1 }
print("Point in rect:", p1, "(expected: 1)")

// Point (15,5) outside rect (0,0,10,10)
p2 = 0
if (15 >= 0 and 15 < 11 and 5 >= 0 and 5 < 11) { p2 = 1 }
print("Point outside:", p2, "(expected: 0)")

// Point (10,5) on edge
p3 = 0
if (10 >= 0 and 10 < 11 and 5 >= 0 and 5 < 11) { p3 = 1 }
print("Point on edge:", p3, "(expected: 1)")

// Point (1,1) in circle (0,0,r=5) -> dist²=2, r²=25
distP4 = 1 * 1 + 1 * 1
p4 = 0
if (distP4 < 25) { p4 = 1 }
if (distP4 == 25) { p4 = 1 }
print("Point in circle:", p4, "(expected: 1)")

// Point (10,10) outside circle (0,0,r=5) -> dist²=200, r²=25
distP5 = 10 * 10 + 10 * 10
p5 = 0
if (distP5 < 25) { p5 = 1 }
if (distP5 == 25) { p5 = 1 }
print("Point outside circle:", p5, "(expected: 0)")

// Point (5,0) on boundary (0,0,r=5) -> dist²=25, r²=25
distP6 = 5 * 5 + 0 * 0
p6 = 0
if (distP6 < 25) { p6 = 1 }
if (distP6 == 25) { p6 = 1 }
print("Point on boundary:", p6, "(expected: 1)")

elapsed = t.millis() - start
print("\nAll tests completed in", elapsed, "ms")
print("Collision detection demo finished.")
