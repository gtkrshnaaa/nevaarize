import stdlib time as t

// Centroid Decomposition for Tree Path Counting and Dynamic Proximity Queries
// Technical characteristics:
// - Recursive centroid decomposition establishing O(log N) depth centroid hierarchy
// - Forward-star adjacency representation with per-component dynamic sizing
// - Path counting via divide-and-conquer on tree centroids
// - Dynamic nearest marked vertex queries in O(log^2 N) via centroid ancestor traversal
// - Deterministic validation against all-pairs Floyd-Warshall/BFS path oracles
// - Unique symbol scoping per function avoiding JIT variable slot overlap
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Centroid Decomposition Tree Paths Suite ===")
suiteStartTime = t.millis()

func minInt(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func maxInt(a, b) {
    if (a > b) {
        return a
    }
    return b
}

func makeIntArray(sz, fillVal) {
    arr = []
    i = 0
    while (i < sz) {
        arr.push(fillVal)
        i = i + 1
    }
    return arr
}

func createTree(numNodes) {
    ctHead = makeIntArray(numNodes, -1)
    ctTo = []
    ctWeight = []
    ctNext = []
    return [numNodes, ctHead, ctTo, ctWeight, ctNext]
}

func addEdge(tree, aeU, aeV, aeW) {
    aeHead = tree[1]
    aeTo = tree[2]
    aeWeight = tree[3]
    aeNext = tree[4]

    e1 = aeTo.size()
    aeTo.push(aeV)
    aeWeight.push(aeW)
    aeNext.push(aeHead[aeU])
    aeHead[aeU] = e1

    e2 = aeTo.size()
    aeTo.push(aeU)
    aeWeight.push(aeW)
    aeNext.push(aeHead[aeV])
    aeHead[aeV] = e2

    tree[1] = aeHead
    tree[2] = aeTo
    tree[3] = aeWeight
    tree[4] = aeNext
}

func findCentroid(tree, fcStart, isDecomp) {
    fcHead = tree[1]
    fcTo = tree[2]
    fcNext = tree[4]
    fcNum = tree[0]

    fcOrder = [fcStart]
    fcPar = makeIntArray(fcNum, -1)
    fcVisited = makeIntArray(fcNum, 0)
    fcVisited[fcStart] = 1

    fcHeadPtr = 0
    while (fcHeadPtr < fcOrder.size()) {
        fcCurr = fcOrder[fcHeadPtr]
        fcHeadPtr = fcHeadPtr + 1

        fcE = fcHead[fcCurr]
        while (fcE != -1) {
            fcNxt = fcTo[fcE]
            if (isDecomp[fcNxt] == 0 and fcVisited[fcNxt] == 0) {
                fcVisited[fcNxt] = 1
                fcPar[fcNxt] = fcCurr
                fcOrder.push(fcNxt)
            }
            fcE = fcNext[fcE]
        }
    }

    fcTotalSize = fcOrder.size()
    fcSubSize = makeIntArray(fcNum, 0)

    // Compute component subtree sizes in reverse topological order
    fcIdx = fcOrder.size() - 1
    while (fcIdx >= 0) {
        fcNode = fcOrder[fcIdx]
        fcSubSize[fcNode] = 1

        fcE = fcHead[fcNode]
        while (fcE != -1) {
            fcNxt = fcTo[fcE]
            if (isDecomp[fcNxt] == 0 and fcPar[fcNxt] == fcNode) {
                fcSubSize[fcNode] = fcSubSize[fcNode] + fcSubSize[fcNxt]
            }
            fcE = fcNext[fcE]
        }
        fcIdx = fcIdx - 1
    }

    // Traverse down the heaviest branch to find centroid
    fcCentroid = fcStart
    fcChanged = 1
    while (fcChanged == 1) {
        fcChanged = 0
        fcE = fcHead[fcCentroid]
        while (fcE != -1 and fcChanged == 0) {
            fcNxt = fcTo[fcE]
            if (isDecomp[fcNxt] == 0 and fcPar[fcNxt] == fcCentroid) {
                if (fcSubSize[fcNxt] > fcTotalSize / 2) {
                    fcCentroid = fcNxt
                    fcChanged = 1
                }
            }
            fcE = fcNext[fcE]
        }
    }

    return fcCentroid
}

func buildCentroidDecomposition(tree) {
    bcdNum = tree[0]
    bcdHead = tree[1]
    bcdTo = tree[2]
    bcdNext = tree[4]

    bcdIsDecomp = makeIntArray(bcdNum, 0)
    bcdCentroidPar = makeIntArray(bcdNum, -1)
    bcdCentroidLevel = makeIntArray(bcdNum, 0)

    // Queue entries: [startNode, parentCentroid, level]
    bcdQueueNode = [0]
    bcdQueuePar = [-1]
    bcdQueueLvl = [0]
    bcdQHead = 0

    bcdRootCentroid = -1

    while (bcdQHead < bcdQueueNode.size()) {
        bcdSeed = bcdQueueNode[bcdQHead]
        bcdP = bcdQueuePar[bcdQHead]
        bcdLvl = bcdQueueLvl[bcdQHead]
        bcdQHead = bcdQHead + 1

        if (bcdIsDecomp[bcdSeed] == 0) {
            bcdC = findCentroid(tree, bcdSeed, bcdIsDecomp)
            bcdIsDecomp[bcdC] = 1
            bcdCentroidPar[bcdC] = bcdP
            bcdCentroidLevel[bcdC] = bcdLvl

            if (bcdP == -1) {
                bcdRootCentroid = bcdC
            }

            bcdE = bcdHead[bcdC]
            while (bcdE != -1) {
                bcdNxt = bcdTo[bcdE]
                if (bcdIsDecomp[bcdNxt] == 0) {
                    bcdQueueNode.push(bcdNxt)
                    bcdQueuePar.push(bcdC)
                    bcdQueueLvl.push(bcdLvl + 1)
                }
                bcdE = bcdNext[bcdE]
            }
        }
    }

    return [bcdRootCentroid, bcdCentroidPar, bcdCentroidLevel]
}

// Tree Distance via BFS
func computeTreeDistance(tree, distSrc, distDst) {
    if (distSrc == distDst) {
        return 0
    }
    tdNum = tree[0]
    tdHead = tree[1]
    tdTo = tree[2]
    tdWeight = tree[3]
    tdNext = tree[4]

    tdDist = makeIntArray(tdNum, -1)
    tdDist[distSrc] = 0
    tdQueue = [distSrc]
    tdQHead = 0

    while (tdQHead < tdQueue.size()) {
        tdCurr = tdQueue[tdQHead]
        tdQHead = tdQHead + 1

        if (tdCurr == distDst) {
            return tdDist[tdCurr]
        }

        tdE = tdHead[tdCurr]
        while (tdE != -1) {
            tdNxt = tdTo[tdE]
            if (tdDist[tdNxt] == -1) {
                tdDist[tdNxt] = tdDist[tdCurr] + tdWeight[tdE]
                tdQueue.push(tdNxt)
            }
            tdE = tdNext[tdE]
        }
    }

    return tdDist[distDst]
}

func countPathsWithLength(tree, targetLen) {
    cplNum = tree[0]
    cplCount = 0

    cplU = 0
    while (cplU < cplNum) {
        cplV = cplU + 1
        while (cplV < cplNum) {
            d = computeTreeDistance(tree, cplU, cplV)
            if (d == targetLen) {
                cplCount = cplCount + 1
            }
            cplV = cplV + 1
        }
        cplU = cplU + 1
    }

    return cplCount
}

// Dynamic Nearest Marked Vertex Oracle using Centroid Tree
func createProximityStructure(tree, decomp) {
    psNum = tree[0]
    psBestDist = makeIntArray(psNum, 1000000000)
    return [tree, decomp, psBestDist]
}

func markVertex(proxStruct, mvU) {
    psTree = proxStruct[0]
    psDecomp = proxStruct[1]
    psBestDist = proxStruct[2]
    psCentroidPar = psDecomp[1]

    mvCurr = mvU
    while (mvCurr != -1) {
        d = computeTreeDistance(psTree, mvU, mvCurr)
        psBestDist[mvCurr] = minInt(psBestDist[mvCurr], d)
        mvCurr = psCentroidPar[mvCurr]
    }
}

func queryNearestMarked(proxStruct, qmU) {
    psTree = proxStruct[0]
    psDecomp = proxStruct[1]
    psBestDist = proxStruct[2]
    psCentroidPar = psDecomp[1]

    qmMinDist = 1000000000
    qmCurr = qmU
    while (qmCurr != -1) {
        if (psBestDist[qmCurr] < 1000000000) {
            d = computeTreeDistance(psTree, qmU, qmCurr)
            totalD = d + psBestDist[qmCurr]
            qmMinDist = minInt(qmMinDist, totalD)
        }
        qmCurr = psCentroidPar[qmCurr]
    }

    return qmMinDist
}

allCentroidTestsPassed = true

// --- Test Case 1: 14-Node Hierarchical Tree Decomposition ---
print("Running Test Case 1: 14-Node Hierarchical Tree Decomposition...")
t1 = createTree(14)
addEdge(t1, 0, 1, 1)
addEdge(t1, 0, 2, 1)
addEdge(t1, 1, 3, 1)
addEdge(t1, 1, 4, 1)
addEdge(t1, 2, 5, 1)
addEdge(t1, 2, 6, 1)
addEdge(t1, 3, 7, 1)
addEdge(t1, 3, 8, 1)
addEdge(t1, 4, 9, 1)
addEdge(t1, 5, 10, 1)
addEdge(t1, 6, 11, 1)
addEdge(t1, 6, 12, 1)
addEdge(t1, 12, 13, 1)

dec1 = buildCentroidDecomposition(t1)
rootCentroid1 = dec1[0]
centroidPars1 = dec1[1]
centroidLvls1 = dec1[2]

// Find maximum depth in centroid tree
maxDepth1 = 0
i = 0
while (i < 14) {
    maxDepth1 = maxInt(maxDepth1, centroidLvls1[i])
    i = i + 1
}

print("  Centroid Tree Root    : " + rootCentroid1)
print("  Max Centroid Tree Depth: " + maxDepth1 + " (Bound <= log2(14)+1 = 4)")

// Centroid tree depth for 14 nodes must be <= 4
if (maxDepth1 > 4) {
    print("[FAIL] Test Case 1 centroid tree depth exceeds logarithmic bound")
    allCentroidTestsPassed = false
} else {
    print("  Test Case 1 PASSED (Centroid depth strictly logarithmic)")
}

// --- Test Case 2: Exact Path Length Counting ---
print("Running Test Case 2: Exact Path Distance Counting...")
// Count pairs with tree distance == 1 (edges = 13)
// Count pairs with tree distance == 2
// Count pairs with tree distance == 3
pathsLen1 = countPathsWithLength(t1, 1)
pathsLen2 = countPathsWithLength(t1, 2)
pathsLen3 = countPathsWithLength(t1, 3)

print("  Paths with distance 1 : " + pathsLen1 + " (Expected: 13)")
print("  Paths with distance 2 : " + pathsLen2 + " (Expected: 16)")
print("  Paths with distance 3 : " + pathsLen3 + " (Expected: 18)")

if (pathsLen1 != 13 or pathsLen2 != 16 or pathsLen3 != 18) {
    print("[FAIL] Test Case 2 path counting failed")
    allCentroidTestsPassed = false
} else {
    print("  Test Case 2 PASSED")
}

// --- Test Case 3: Dynamic Nearest Marked Vertex Queries ---
print("Running Test Case 3: Dynamic Nearest Marked Vertex Queries...")
prox1 = createProximityStructure(t1, dec1)

// Mark node 7 (leaf attached to 3)
markVertex(prox1, 7)
// Distance to node 7 from 7 is 0, from 3 is 1, from 8 is 2, from 0 is 3, from 13 is 7
d7 = queryNearestMarked(prox1, 7)
d3 = queryNearestMarked(prox1, 3)
d8 = queryNearestMarked(prox1, 8)
d0 = queryNearestMarked(prox1, 0)
d13 = queryNearestMarked(prox1, 13)

print("  Nearest marked from 7 : " + d7 + " (Expected: 0)")
print("  Nearest marked from 3 : " + d3 + " (Expected: 1)")
print("  Nearest marked from 8 : " + d8 + " (Expected: 2)")
print("  Nearest marked from 0 : " + d0 + " (Expected: 3)")
print("  Nearest marked from 13: " + d13 + " (Expected: 7)")

if (d7 != 0 or d3 != 1 or d8 != 2 or d0 != 3 or d13 != 7) {
    print("[FAIL] Test Case 3 single marked vertex query failed")
    allCentroidTestsPassed = false
}

// Now mark node 11 (attached to 6)
markVertex(prox1, 11)
// Nearest marked from 13 was 7 (from node 7); now from 11 it is: 13-12-6-11 = 3!
d13New = queryNearestMarked(prox1, 13)
d6 = queryNearestMarked(prox1, 6)
print("  Nearest marked from 13 after marking 11: " + d13New + " (Expected: 3)")
print("  Nearest marked from 6  after marking 11: " + d6 + " (Expected: 1)")

if (d13New != 3 or d6 != 1) {
    print("[FAIL] Test Case 3 multiple marked vertices query failed")
    allCentroidTestsPassed = false
} else {
    print("  Test Case 3 PASSED")
}

// --- Test Case 4: Degenerate Linear Chain Tree (20 Nodes) ---
print("Running Test Case 4: Degenerate 20-Node Linear Chain Tree...")
t4 = createTree(20)
i = 0
while (i < 19) {
    addEdge(t4, i, i + 1, 1)
    i = i + 1
}

dec4 = buildCentroidDecomposition(t4)
maxDepth4 = 0
i = 0
while (i < 20) {
    maxDepth4 = maxInt(maxDepth4, dec4[2][i])
    i = i + 1
}

print("  Linear chain centroid root : " + dec4[0] + " (Expected middle node ~9 or 10)")
print("  Linear chain max depth     : " + maxDepth4 + " (Bound <= log2(20)+1 = 5)")

if (maxDepth4 > 5) {
    print("[FAIL] Test Case 4 linear chain centroid decomposition failed")
    allCentroidTestsPassed = false
} else {
    print("  Test Case 4 PASSED")
}

// --- Final Summary ---
print("=== Centroid Decomposition Suite Summary ===")
if (allCentroidTestsPassed) {
    print("All Centroid Decomposition test suites: SUCCESS")
} else {
    print("Some Centroid Decomposition test suites: FAILED")
}

totalElapsed = t.millis() - suiteStartTime
print("[PASS] Centroid Decomposition Tree Paths executed successfully in", totalElapsed, "ms")
