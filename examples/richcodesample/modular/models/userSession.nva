// User Session Model
import stdlib time as t
// Demonstrates struct usage and cross-file import potentials

struct UserSession {
    id,
    username,
    startTime,
    isActive
}

func createSession(userId, name) {
    now = t.millis()
    return UserSession(userId, name, now, true)
}

func endSession(session) {
    session.isActive = false
}

func getSessionDuration(session) {
    return t.millis() - session.startTime
}
