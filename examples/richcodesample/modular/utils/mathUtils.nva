import stdlib math as m

// Math Utilities Module
// Demonstrates custom function exporting and camelCase enforcement

function calculateMean(arr) {
    if (arr.size() == 0) {
        return 0.0
    }
    
    sum = 0.0
    for (val in arr) {
        sum = sum + (0.0 + val)
    }
    return sum / arr.size()
}

function calculateStandardDeviation(arr) {
    mean = calculateMean(arr)
    sumSqDiff = 0.0
    
    for (val in arr) {
        diff = (0.0 + val) - mean
        sumSqDiff = sumSqDiff + (diff * diff)
    }
    
    variance = sumSqDiff / arr.size()
    return m.Sqrt(variance)
}

function isEvenNumber(n) {
    return (n % 2) == 0
}
