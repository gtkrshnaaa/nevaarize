import stdlib time as t

// Deep Currying and Partial Application Stress Suite
// Technical characteristics:
// - Pure functional currying engine converting N-ary operations into single-argument closure chains
// - Lexical environment frames forming immutable linked ancestor closure upvalue paths
// - Partial application primitives supporting arbitrary argument batching and progressive binding
// - Functional combinators: curry, partial, uncurry, compose, flip, and pipeline
// - Mathematical functions across wide arities: Unary (1), Binary (2), Ternary (3), Quaternary (4), 5-Point, 8-Mix, 16-Poly, 32-Chain, 64-Chain, and 100-Chain
// - Algebraic property validation: Currying-Uncurrying Isomorphism, Partial Application Associativity, Sibling Branching Immutability, Composition Associativity
// - High-throughput stress benchmark executing 10,000+ chained single-argument closure applications
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero external dependencies, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Deep Currying and Partial Application Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Function Registry Identifier Constants ---

fnIdNegate = 1
fnIdSquare = 2
fnIdCollatz = 3
fnIdAdd = 4
fnIdSubtract = 5
fnIdMultiply = 6
fnIdModulo = 7
fnIdPowerMod = 8
fnIdClamp = 9
fnIdLerp = 10
fnIdQuadratic = 11
fnIdDotProduct4D = 12
fnIdBezierCubic = 13
fnIdConvolution5Point = 14
fnIdMix8Words = 15
fnIdDeepPoly16 = 16
fnIdDeepSum32 = 17
fnIdDeepFold64 = 18
fnIdDeepStress100 = 19
fnIdFlippedSubtract = 20
fnIdFlippedModulo = 21

// --- Telemetry Counters ---

closureAllocCount = [0]
maxChainDepthObserved = [0]
closureInvocationCount = [0]

// --- Helper Functions ---

func modularPower(baseVal, expVal, modVal) {
    if (modVal == 1) {
        return 0
    }
    result = 1
    baseRem = baseVal % modVal
    currExp = expVal
    while (currExp > 0) {
        if (currExp % 2 == 1) {
            result = (result * baseRem) % modVal
        }
        currExp = currExp / 2
        baseRem = (baseRem * baseRem) % modVal
    }
    return result
}

func shallowCopyArray(srcArr) {
    newArr = []
    idx = 0
    sz = srcArr.size()
    while (idx < sz) {
        newArr.push(srcArr[idx])
        idx = idx + 1
    }
    return newArr
}

// --- Function Dispatch Registry ---

func dispatchRegistry(fnId, args) {
    closureInvocationCount[0] = closureInvocationCount[0] + 1
    if (fnId == 1) {
        // Negate: -x
        return 0 - args[0]
    } elif (fnId == 2) {
        // Square: x * x
        return args[0] * args[0]
    } elif (fnId == 3) {
        // Collatz step
        val = args[0]
        if (val % 2 == 0) {
            return val / 2
        }
        return (val * 3) + 1
    } elif (fnId == 4) {
        // Add: a + b
        return args[0] + args[1]
    } elif (fnId == 5) {
        // Subtract: a - b
        return args[0] - args[1]
    } elif (fnId == 6) {
        // Multiply: a * b
        return args[0] * args[1]
    } elif (fnId == 7) {
        // Modulo: a % b
        return args[0] % args[1]
    } elif (fnId == 8) {
        // PowerMod: (base ^ exp) % 1000000007
        return modularPower(args[0], args[1], 1000000007)
    } elif (fnId == 9) {
        // Clamp: clamp(low, high, val)
        lowBound = args[0]
        highBound = args[1]
        targetVal = args[2]
        if (targetVal < lowBound) {
            return lowBound
        }
        if (targetVal > highBound) {
            return highBound
        }
        return targetVal
    } elif (fnId == 10) {
        // Lerp: integer percentage lerp (a * (100 - t) + b * t) / 100
        startVal = args[0]
        endVal = args[1]
        tPct = args[2]
        return ((startVal * (100 - tPct)) + (endVal * tPct)) / 100
    } elif (fnId == 11) {
        // Quadratic: a*x^2 + b*x + c
        coefA = args[0]
        coefB = args[1]
        coefC = args[2]
        xVal = args[3]
        return (coefA * xVal * xVal) + (coefB * xVal) + coefC
    } elif (fnId == 12) {
        // DotProduct4D: w1*x1 + w2*x2 + w3*x3 + w4*x4
        return (args[0] * args[1]) + (args[2] * args[3])
    } elif (fnId == 13) {
        // BezierCubic: 4 control points at midpoint t = 50%: (p0 + 3*p1 + 3*p2 + p3) / 8
        return (args[0] + (args[1] * 3) + (args[2] * 3) + args[3]) / 8
    } elif (fnId == 14) {
        // Convolution5Point: (v0 + 4*v1 + 6*v2 + 4*v3 + v4) / 16
        return (args[0] + (args[1] * 4) + (args[2] * 6) + (args[3] * 4) + args[4]) / 16
    } elif (fnId == 15) {
        // Mix8Words: 8-word hashing accumulator
        acc = 2166136261
        prime = 16777619
        wIdx = 0
        while (wIdx < 8) {
            acc = ((acc + args[wIdx]) * prime) % 2147483647
            wIdx = wIdx + 1
        }
        return acc
    } elif (fnId == 16) {
        // DeepPoly16: 16 coefficients evaluated on xVal = 2
        polySum = 0
        pIdx = 0
        termPower = 1
        while (pIdx < 16) {
            polySum = polySum + (args[pIdx] * termPower)
            termPower = (termPower * 2) % 1000000007
            pIdx = pIdx + 1
        }
        return polySum
    } elif (fnId == 17) {
        // DeepSum32: 32 elements with alternating addition and subtraction
        sum32 = 0
        sIdx = 0
        while (sIdx < 32) {
            if (sIdx % 2 == 0) {
                sum32 = sum32 + args[sIdx]
            } else {
                sum32 = sum32 - args[sIdx]
            }
            sIdx = sIdx + 1
        }
        return sum32
    } elif (fnId == 18) {
        // DeepFold64: 64-element modular fold accumulator
        foldAcc = 17
        fIdx = 0
        while (fIdx < 64) {
            foldAcc = ((foldAcc * 33) + args[fIdx]) % 1000000007
            fIdx = fIdx + 1
        }
        return foldAcc
    } elif (fnId == 19) {
        // DeepStress100: 100-element recurrence state fold
        stressState = 7
        stIdx = 0
        while (stIdx < 100) {
            stressState = ((stressState * 31) + args[stIdx]) % 1000000007
            stIdx = stIdx + 1
        }
        return stressState
    } elif (fnId == 20) {
        // Flipped Subtract: b - a
        return args[1] - args[0]
    } elif (fnId == 21) {
        // Flipped Modulo: b % a
        return args[1] % args[0]
    }
    return 0
}

// --- Closure Constructors and Introspection Primitives ---
// Closure structure:
// [0]: fnId (integer function identifier)
// [1]: targetArity (total arguments required)
// [2]: boundArg (argument bound at this step, 0 if root)
// [3]: parentClosure (reference to parent closure, or -1 if root)
// [4]: chainDepth (number of arguments bound so far)
// [5]: isRoot (1 if root/empty closure, 0 if bound argument closure)

func createRootClosure(fnId, targetArity) {
    closureAllocCount[0] = closureAllocCount[0] + 1
    return [fnId, targetArity, 0, -1, 0, 1]
}

func applyCurriedArg(parentClosure, argVal) {
    closureAllocCount[0] = closureAllocCount[0] + 1
    fnId = parentClosure[0]
    targetArity = parentClosure[1]
    nextDepth = parentClosure[4] + 1
    if (nextDepth > maxChainDepthObserved[0]) {
        maxChainDepthObserved[0] = nextDepth
    }
    return [fnId, targetArity, argVal, parentClosure, nextDepth, 0]
}

func collectClosureArgs(closure) {
    depth = closure[4]
    args = []
    initIdx = 0
    while (initIdx < depth) {
        args.push(0)
        initIdx = initIdx + 1
    }
    currNode = closure
    currDepth = depth
    while (currNode[5] == 0) {
        args[currDepth - 1] = currNode[2]
        currNode = currNode[3]
        currDepth = currDepth - 1
    }
    return args
}

func invokeClosure(closure) {
    args = collectClosureArgs(closure)
    return dispatchRegistry(closure[0], args)
}

func applyAndMaybeInvoke(closure, argVal) {
    nextClosure = applyCurriedArg(closure, argVal)
    if (nextClosure[4] == nextClosure[1]) {
        return invokeClosure(nextClosure)
    }
    return nextClosure
}

func uncurryDirect(fnId, args) {
    return dispatchRegistry(fnId, args)
}

// --- High-Order Combinators ---

func partialApply(closure, argsList) {
    currClosure = closure
    aIdx = 0
    aTotal = argsList.size()
    while (aIdx < aTotal) {
        argVal = argsList[aIdx]
        nextStep = applyAndMaybeInvoke(currClosure, argVal)
        if (aIdx == aTotal - 1) {
            return nextStep
        }
        currClosure = nextStep
        aIdx = aIdx + 1
    }
    return currClosure
}

func applyChain(closure, argsList) {
    return partialApply(closure, argsList)
}

func executeComposedUnary(closureG, closureF, xVal) {
    stepF = applyAndMaybeInvoke(closureF, xVal)
    stepG = applyAndMaybeInvoke(closureG, stepF)
    return stepG
}

func executeUnaryPipeline(pipelineClosures, initialVal) {
    currVal = initialVal
    pIdx = 0
    pCount = pipelineClosures.size()
    while (pIdx < pCount) {
        currVal = applyAndMaybeInvoke(pipelineClosures[pIdx], currVal)
        pIdx = pIdx + 1
    }
    return currVal
}

func curriedMap(unaryClosure, list) {
    mapped = []
    for (elem in list) {
        val = applyAndMaybeInvoke(unaryClosure, elem)
        mapped.push(val)
    }
    return mapped
}

func curriedFold(binaryClosure, initialAcc, list) {
    acc = initialAcc
    for (elem in list) {
        step1 = applyAndMaybeInvoke(binaryClosure, acc)
        acc = applyAndMaybeInvoke(step1, elem)
    }
    return acc
}

// --- Test Case 1: Currying-Uncurrying Isomorphism and Arity Verification ---

print("--- Running Test Case 1: Currying-Uncurrying Isomorphism ---")

// Unary: Negate
negRoot = createRootClosure(fnIdNegate, 1)
negResult = applyAndMaybeInvoke(negRoot, 42)
negExpected = uncurryDirect(fnIdNegate, [42])
if (negResult != -42 or negResult != negExpected) {
    print("[FAIL] Test Case 1 Unary Negate failed: expected -42, got ", negResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Unary: Square with negative boundary
sqRoot = createRootClosure(fnIdSquare, 1)
sqResult = applyAndMaybeInvoke(sqRoot, -12)
sqExpected = uncurryDirect(fnIdSquare, [-12])
if (sqResult != 144 or sqResult != sqExpected) {
    print("[FAIL] Test Case 1 Unary Square failed: expected 144, got ", sqResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Unary: Collatz step even and odd
collatzRoot = createRootClosure(fnIdCollatz, 1)
colEven = applyAndMaybeInvoke(collatzRoot, 16)
colOdd = applyAndMaybeInvoke(collatzRoot, 17)
if (colEven != 8 or colOdd != 52) {
    print("[FAIL] Test Case 1 Collatz failed: even=", colEven, " odd=", colOdd)
    testSuiteFailures = testSuiteFailures + 1
}

// Binary: Add (a + b)
addRoot = createRootClosure(fnIdAdd, 2)
addStep1 = applyAndMaybeInvoke(addRoot, 100)
addResult = applyAndMaybeInvoke(addStep1, 250)
addExpected = uncurryDirect(fnIdAdd, [100, 250])
if (addResult != 350 or addResult != addExpected) {
    print("[FAIL] Test Case 1 Binary Add failed: expected 350, got ", addResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Binary: Subtract with negative result
subRoot = createRootClosure(fnIdSubtract, 2)
subStep1 = applyAndMaybeInvoke(subRoot, 40)
subResult = applyAndMaybeInvoke(subStep1, 100)
subExpected = uncurryDirect(fnIdSubtract, [40, 100])
if (subResult != -60 or subResult != subExpected) {
    print("[FAIL] Test Case 1 Binary Subtract failed: expected -60, got ", subResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Binary: Modulo
modRoot = createRootClosure(fnIdModulo, 2)
modStep1 = applyAndMaybeInvoke(modRoot, 47)
modResult = applyAndMaybeInvoke(modStep1, 7)
modExpected = uncurryDirect(fnIdModulo, [47, 7])
if (modResult != 5 or modResult != modExpected) {
    print("[FAIL] Test Case 1 Binary Modulo failed: expected 5, got ", modResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Binary: PowerMod (modular exponentiation: (3 ^ 13) % 1000000007)
powerRoot = createRootClosure(fnIdPowerMod, 2)
powerStep1 = applyAndMaybeInvoke(powerRoot, 3)
powerResult = applyAndMaybeInvoke(powerStep1, 13)
powerExpected = uncurryDirect(fnIdPowerMod, [3, 13])
if (powerResult != 1594323 or powerResult != powerExpected) {
    print("[FAIL] Test Case 1 Binary PowerMod failed: expected 1594323, got ", powerResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Ternary: Clamp (low=10, high=50, val)
clampRoot = createRootClosure(fnIdClamp, 3)
clampStep1 = applyAndMaybeInvoke(clampRoot, 10)
clampStep2 = applyAndMaybeInvoke(clampStep1, 50)
clampBelow = applyAndMaybeInvoke(clampStep2, 5)
clampWithin = applyAndMaybeInvoke(clampStep2, 33)
clampAbove = applyAndMaybeInvoke(clampStep2, 99)
if (clampBelow != 10 or clampWithin != 33 or clampAbove != 50) {
    print("[FAIL] Test Case 1 Ternary Clamp failed: below=", clampBelow, " within=", clampWithin, " above=", clampAbove)
    testSuiteFailures = testSuiteFailures + 1
}

// Ternary: Lerp (start=100, end=300, t=25) -> (100 * 75 + 300 * 25) / 100 = (7500 + 7500) / 100 = 150
lerpRoot = createRootClosure(fnIdLerp, 3)
lerpStep1 = applyAndMaybeInvoke(lerpRoot, 100)
lerpStep2 = applyAndMaybeInvoke(lerpStep1, 300)
lerpResult = applyAndMaybeInvoke(lerpStep2, 25)
lerpExpected = uncurryDirect(fnIdLerp, [100, 300, 25])
if (lerpResult != 150 or lerpResult != lerpExpected) {
    print("[FAIL] Test Case 1 Ternary Lerp failed: expected 150, got ", lerpResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Quaternary: Quadratic a*x^2 + b*x + c (a=2, b=3, c=5, x=4) -> 2*16 + 3*4 + 5 = 32 + 12 + 5 = 49
quadRoot = createRootClosure(fnIdQuadratic, 4)
quadStep1 = applyAndMaybeInvoke(quadRoot, 2)
quadStep2 = applyAndMaybeInvoke(quadStep1, 3)
quadStep3 = applyAndMaybeInvoke(quadStep2, 5)
quadResult = applyAndMaybeInvoke(quadStep3, 4)
quadExpected = uncurryDirect(fnIdQuadratic, [2, 3, 5, 4])
if (quadResult != 49 or quadResult != quadExpected) {
    print("[FAIL] Test Case 1 Quaternary Quadratic failed: expected 49, got ", quadResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Quaternary: Cubic Bezier Midpoint (p0=0, p1=80, p2=160, p3=240) -> (0 + 240 + 480 + 240) / 8 = 960 / 8 = 120
bezierRoot = createRootClosure(fnIdBezierCubic, 4)
bezierStep1 = applyAndMaybeInvoke(bezierRoot, 0)
bezierStep2 = applyAndMaybeInvoke(bezierStep1, 80)
bezierStep3 = applyAndMaybeInvoke(bezierStep2, 160)
bezierResult = applyAndMaybeInvoke(bezierStep3, 240)
bezierExpected = uncurryDirect(fnIdBezierCubic, [0, 80, 160, 240])
if (bezierResult != 120 or bezierResult != bezierExpected) {
    print("[FAIL] Test Case 1 Quaternary Bezier failed: expected 120, got ", bezierResult)
    testSuiteFailures = testSuiteFailures + 1
}

// 5-Point Convolution: (v0=16, v1=32, v2=48, v3=32, v4=16) -> (16 + 128 + 288 + 128 + 16) / 16 = 576 / 16 = 36
convRoot = createRootClosure(fnIdConvolution5Point, 5)
convStep1 = applyAndMaybeInvoke(convRoot, 16)
convStep2 = applyAndMaybeInvoke(convStep1, 32)
convStep3 = applyAndMaybeInvoke(convStep2, 48)
convStep4 = applyAndMaybeInvoke(convStep3, 32)
convResult = applyAndMaybeInvoke(convStep4, 16)
convExpected = uncurryDirect(fnIdConvolution5Point, [16, 32, 48, 32, 16])
if (convResult != 36 or convResult != convExpected) {
    print("[FAIL] Test Case 1 5-Point Convolution failed: expected 36, got ", convResult)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 1 Passed Currying-Uncurrying Isomorphism across arities 1, 2, 3, 4, 5")

// --- Test Case 2: Sibling Branching and Lexical Environment Immutability ---

print("--- Running Test Case 2: Sibling Branching and Immutability ---")

// Branching at Depth 1: Base closure with first argument bound to 50
baseAdd50 = applyCurriedArg(createRootClosure(fnIdAdd, 2), 50)

// 5 Distinct sibling closures branching independently from baseAdd50
sibResA = applyAndMaybeInvoke(baseAdd50, 10)
sibResB = applyAndMaybeInvoke(baseAdd50, -20)
sibResC = applyAndMaybeInvoke(baseAdd50, 100)
sibResD = applyAndMaybeInvoke(baseAdd50, 0)
sibResE = applyAndMaybeInvoke(baseAdd50, 950)

if (sibResA != 60) {
    print("[FAIL] Test Case 2 Sibling A failed: expected 60, got ", sibResA)
    testSuiteFailures = testSuiteFailures + 1
}
if (sibResB != 30) {
    print("[FAIL] Test Case 2 Sibling B failed: expected 30, got ", sibResB)
    testSuiteFailures = testSuiteFailures + 1
}
if (sibResC != 150) {
    print("[FAIL] Test Case 2 Sibling C failed: expected 150, got ", sibResC)
    testSuiteFailures = testSuiteFailures + 1
}
if (sibResD != 50) {
    print("[FAIL] Test Case 2 Sibling D failed: expected 50, got ", sibResD)
    testSuiteFailures = testSuiteFailures + 1
}
if (sibResE != 1000) {
    print("[FAIL] Test Case 2 Sibling E failed: expected 1000, got ", sibResE)
    testSuiteFailures = testSuiteFailures + 1
}

// Verify base closure immutability: re-applying 25 must yield 75
baseReapply = applyAndMaybeInvoke(baseAdd50, 25)
if (baseReapply != 75 or baseAdd50[4] != 1 or baseAdd50[2] != 50) {
    print("[FAIL] Test Case 2 Base closure mutation detected: expected 75 and depth 1")
    testSuiteFailures = testSuiteFailures + 1
}

// Multi-Generation Tree Branching:
// Root: Quaternary Quadratic a*x^2 + b*x + c (Arity 4)
quadTreeRoot = createRootClosure(fnIdQuadratic, 4)

// Generation 1: Bind a = 3
quadGen1 = applyCurriedArg(quadTreeRoot, 3)

// Generation 2: Branch into b = 2 and b = -4
quadGen2A = applyCurriedArg(quadGen1, 2)
quadGen2B = applyCurriedArg(quadGen1, -4)

// Generation 3: Branch from quadGen2A into c = 10 and c = -5; from quadGen2B into c = 7
quadGen3A1 = applyCurriedArg(quadGen2A, 10)
quadGen3A2 = applyCurriedArg(quadGen2A, -5)
quadGen3B1 = applyCurriedArg(quadGen2B, 7)

// Evaluate each leaf at x = 5:
// Leaf 1: 3 * 25 + 2 * 5 + 10 = 75 + 10 + 10 = 95
leafRes1 = applyAndMaybeInvoke(quadGen3A1, 5)
// Leaf 2: 3 * 25 + 2 * 5 - 5 = 75 + 10 - 5 = 80
leafRes2 = applyAndMaybeInvoke(quadGen3A2, 5)
// Leaf 3: 3 * 25 - 4 * 5 + 7 = 75 - 20 + 7 = 62
leafRes3 = applyAndMaybeInvoke(quadGen3B1, 5)

if (leafRes1 != 95) {
    print("[FAIL] Test Case 2 Leaf 1 failed: expected 95, got ", leafRes1)
    testSuiteFailures = testSuiteFailures + 1
}
if (leafRes2 != 80) {
    print("[FAIL] Test Case 2 Leaf 2 failed: expected 80, got ", leafRes2)
    testSuiteFailures = testSuiteFailures + 1
}
if (leafRes3 != 62) {
    print("[FAIL] Test Case 2 Leaf 3 failed: expected 62, got ", leafRes3)
    testSuiteFailures = testSuiteFailures + 1
}

// Check leaf 1 evaluated at x = 0 to verify constant c = 10 is isolated
leafRes1AtZero = applyAndMaybeInvoke(quadGen3A1, 0)
if (leafRes1AtZero != 10) {
    print("[FAIL] Test Case 2 Leaf 1 constant isolation failed: expected 10, got ", leafRes1AtZero)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 2 Passed Sibling Branching and Multi-Generation Tree Immutability")

// --- Test Case 3: Partial Application Associativity and Argument Flip Combinator ---

print("--- Running Test Case 3: Partial Application Associativity and Flip ---")

// Clamp (low=10, high=50, val)
clampRoot3 = createRootClosure(fnIdClamp, 3)

// Prefix partial application with 2 arguments [10, 50] leaving arity 1
clamp10To50 = partialApply(clampRoot3, [10, 50])
if (clamp10To50[4] != 2) {
    print("[FAIL] Test Case 3 Partial clamp depth expected 2, got ", clamp10To50[4])
    testSuiteFailures = testSuiteFailures + 1
}

partClampLow = applyAndMaybeInvoke(clamp10To50, 2)
partClampMid = applyAndMaybeInvoke(clamp10To50, 35)
partClampHigh = applyAndMaybeInvoke(clamp10To50, 88)

if (partClampLow != 10 or partClampMid != 35 or partClampHigh != 50) {
    print("[FAIL] Test Case 3 Partial clamp results mismatch: low=", partClampLow, " mid=", partClampMid, " high=", partClampHigh)
    testSuiteFailures = testSuiteFailures + 1
}

// Associativity: ((c + [a]) + [b]) + [c] == c + [a, b, c]
// Tested on Bezier curve: p0=0, p1=80, p2=160, p3=240 -> expected 120
bezierRoot3 = createRootClosure(fnIdBezierCubic, 4)
bezPartPrefix = partialApply(bezierRoot3, [0, 80])
bezPartPath1 = partialApply(bezPartPrefix, [160, 240])
bezPartPath2 = partialApply(bezierRoot3, [0, 80, 160, 240])
bezPartPrefix3 = partialApply(bezierRoot3, [0, 80, 160])
bezPartPath3 = applyAndMaybeInvoke(bezPartPrefix3, 240)

if (bezPartPath1 != 120 or bezPartPath2 != 120 or bezPartPath3 != 120) {
    print("[FAIL] Test Case 3 Partial application associativity mismatch: p1=", bezPartPath1, " p2=", bezPartPath2, " p3=", bezPartPath3)
    testSuiteFailures = testSuiteFailures + 1
}

// Empty argument list partial application (idempotence)
bezEmptyPart = partialApply(bezierRoot3, [])
if (bezEmptyPart[4] != 0 or bezEmptyPart[5] != 1) {
    print("[FAIL] Test Case 3 Empty partial apply modified root closure state")
    testSuiteFailures = testSuiteFailures + 1
}

// Flipped Binary Subtraction: standard sub(100, 30) = 70; flipped sub(100, 30) = 30 - 100 = -70
flipSubRoot = createRootClosure(fnIdFlippedSubtract, 2)
flipSubRes = partialApply(flipSubRoot, [100, 30])
if (flipSubRes != -70) {
    print("[FAIL] Test Case 3 Flipped subtraction failed: expected -70, got ", flipSubRes)
    testSuiteFailures = testSuiteFailures + 1
}

// Flipped Binary Modulo: standard mod(50, 8) = 2; flipped mod(50, 8) = 8 % 50 = 8
flipModRoot = createRootClosure(fnIdFlippedModulo, 2)
flipModRes = partialApply(flipModRoot, [50, 8])
if (flipModRes != 8) {
    print("[FAIL] Test Case 3 Flipped modulo failed: expected 8, got ", flipModRes)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 3 Passed Partial Application Associativity and Flipped Binary Combinators")

// --- Test Case 4: Higher-Order Function Composition and Pipeline Transformation ---

print("--- Running Test Case 4: Function Composition and Pipeline ---")

// Unary functions: Square (x^2), Collatz (3x+1 for odd), Negate (-x)
// For x = 7:
// f(7) = 49
// g(49) = 3 * 49 + 1 = 148
// h(148) = -148

compStep1 = executeComposedUnary(collatzRoot, sqRoot, 7)
if (compStep1 != 148) {
    print("[FAIL] Test Case 4 Composition g(f(7)) failed: expected 148, got ", compStep1)
    testSuiteFailures = testSuiteFailures + 1
}

// Associativity: h(g(f(x))) via pipeline vs nested composition
pipeRes = executeUnaryPipeline([sqRoot, collatzRoot, negRoot], 7)
if (pipeRes != -148) {
    print("[FAIL] Test Case 4 Pipeline execution failed: expected -148, got ", pipeRes)
    testSuiteFailures = testSuiteFailures + 1
}

sqSeven = applyAndMaybeInvoke(sqRoot, 7)
compResNested = executeComposedUnary(negRoot, collatzRoot, sqSeven)
if (compResNested != -148) {
    print("[FAIL] Test Case 4 Nested composition failed: expected -148, got ", compResNested)
    testSuiteFailures = testSuiteFailures + 1
}

// Functor/Collection Combinators: curriedMap and curriedFold
testNumbers = [1, 2, 3, 4, 5]
squaredNumbers = curriedMap(sqRoot, testNumbers)
// [1, 4, 9, 16, 25]
if (squaredNumbers.size() != 5 or squaredNumbers[0] != 1 or squaredNumbers[4] != 25) {
    print("[FAIL] Test Case 4 curriedMap failed on square transform")
    testSuiteFailures = testSuiteFailures + 1
}

sumOfSquares = curriedFold(addRoot, 0, squaredNumbers)
// 1 + 4 + 9 + 16 + 25 = 55
if (sumOfSquares != 55) {
    print("[FAIL] Test Case 4 curriedFold failed: expected 55, got ", sumOfSquares)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 4 Passed Higher-Order Function Composition, Pipeline, and Collection Combinators")

// --- Summary Telemetry ---

elapsed = t.millis() - suiteStartTime
if (testSuiteFailures == 0) {
    print("[PASS] Stage 2 Passed in ", elapsed, " ms")
} else {
    print("[FAIL] Stage 2 encountered ", testSuiteFailures, " failures")
}
