print("  Test Case 2 Passed Boundary Edge Cases and Extreme Sparse Distribution")

// --- Test Case 3: Handler Mathematical Invariants & Reversibility ---

print("--- Running Test Case 3: Handler Mathematical Invariants ---")

testAcc = 7
testKey = 42

// Test handlerIdNegateAbs
valNeg = dispatchAction(handlerIdNegateAbs, -125, testKey)
if (valNeg != 125 and valNeg != -125) {
    testSuiteFailures = testSuiteFailures + 1
}

// Test handlerIdResetZero
valZero = dispatchAction(handlerIdResetZero, 9999, testKey)
if (valZero != 0) {
    print("[FAIL] Test Case 3 handlerIdResetZero expected 0, got ", valZero)
    testSuiteFailures = testSuiteFailures + 1
}

// Test handlerIdCube: 7^3 = 343
valCube = dispatchAction(handlerIdCube, 7, testKey)
if (valCube != 343) {
    print("[FAIL] Test Case 3 handlerIdCube expected 343, got ", valCube)
    testSuiteFailures = testSuiteFailures + 1
}

// Test handlerIdCollatzStep: even 10 -> 5, odd 7 -> 22
collatzEven = dispatchAction(handlerIdCollatzStep, 10, testKey)
collatzOdd = dispatchAction(handlerIdCollatzStep, 7, testKey)
if (collatzEven != 5 or collatzOdd != 22) {
    print("[FAIL] Test Case 3 handlerIdCollatzStep failed: even=", collatzEven, " odd=", collatzOdd)
    testSuiteFailures = testSuiteFailures + 1
}

// Test handlerIdMultiply13: 10 * 13 = 130
valMul13 = dispatchAction(handlerIdMultiply13, 10, testKey)
if (valMul13 != 130) {
    print("[FAIL] Test Case 3 handlerIdMultiply13 expected 130, got ", valMul13)
    testSuiteFailures = testSuiteFailures + 1
}

// Test handlerIdClamp1000: clamp bounds [-1000, 1000]
valClampHigh = dispatchAction(handlerIdClamp1000, 2500, testKey)
valClampLow = dispatchAction(handlerIdClamp1000, -2500, testKey)
valClampMid = dispatchAction(handlerIdClamp1000, 450, testKey)
if (valClampHigh != 1000 or valClampLow != -1000 or valClampMid != 450) {
    print("[FAIL] Test Case 3 handlerIdClamp1000 failed: high=", valClampHigh, " low=", valClampLow, " mid=", valClampMid)
    testSuiteFailures = testSuiteFailures + 1
}

// Test handlerIdShiftRight2: 64 >> 2 = 16
valShr2 = dispatchAction(handlerIdShiftRight2, 64, testKey)
if (valShr2 != 16) {
    print("[FAIL] Test Case 3 handlerIdShiftRight2 expected 16, got ", valShr2)
    testSuiteFailures = testSuiteFailures + 1
}

// Test handlerIdDefault fallback deterministic behavior
valDef1 = dispatchAction(handlerIdDefault, 100, 55)
valDef2 = dispatchAction(handlerIdDefault, 100, 55)
if (valDef1 != valDef2 or valDef1 != (((100 ^ 55) + 42) % 1000007)) {
    print("[FAIL] Test Case 3 handlerIdDefault non-deterministic or mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 3 Passed Handler Mathematical Invariants")
