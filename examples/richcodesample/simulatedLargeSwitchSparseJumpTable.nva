]
clusteredTable2 = createClusteredJumpTable(clusterSpecs2, outliersKeys2, outliersHandlers2, handlerIdDefault)

// Verify exact match across all models for all 16 sparse cases
sIdx2 = 0
while (sIdx2 < sparseKeys2.size()) {
    targetKey2 = sparseKeys2[sIdx2]
    expectedH2 = sparseHandlers2[sIdx2]
    linH2 = dispatchLinear(sparseKeys2, sparseHandlers2, targetKey2, handlerIdDefault)
    bstH2 = dispatchBinarySearch(bstTable2, targetKey2, handlerIdDefault)
    hashH2 = dispatchHashJumpTable(hashTable2, targetKey2, handlerIdDefault)
    clusH2 = dispatchClusteredJumpTable(clusteredTable2, targetKey2, handlerIdDefault)
    if (linH2 != expectedH2 or bstH2 != expectedH2 or hashH2 != expectedH2 or clusH2 != expectedH2) {
        print("[FAIL] Test Case 2 Mismatch on sparse key ", targetKey2, ": expected=", expectedH2, " lin=", linH2, " bst=", bstH2, " hash=", hashH2, " clus=", clusH2)
        testSuiteFailures = testSuiteFailures + 1
    }
    sIdx2 = sIdx2 + 1
}

// Verify off-by-one boundary holes & extreme out-of-range keys
holeKeys2 = [
    -501, -499,
    -1, 1, 2, 4,
    16, 18,
    41, 43,
    99, 106,
    499, 501,
    1023, 1025,
    8191, 8193,
    65535, 65537,
    999999, 1000001,
    -9999999, 99999999
]
hIdx2 = 0
while (hIdx2 < holeKeys2.size()) {
    holeK2 = holeKeys2[hIdx2]
    linH2 = dispatchLinear(sparseKeys2, sparseHandlers2, holeK2, handlerIdDefault)
    bstH2 = dispatchBinarySearch(bstTable2, holeK2, handlerIdDefault)
    hashH2 = dispatchHashJumpTable(hashTable2, holeK2, handlerIdDefault)
    clusH2 = dispatchClusteredJumpTable(clusteredTable2, holeK2, handlerIdDefault)
    if (linH2 != handlerIdDefault or bstH2 != handlerIdDefault or hashH2 != handlerIdDefault or clusH2 != handlerIdDefault) {
