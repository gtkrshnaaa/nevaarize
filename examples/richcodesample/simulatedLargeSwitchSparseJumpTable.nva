import stdlib time as t

// Simulated Large Switch with Sparse Non-Contiguous Cases & Jump Table Suite
// Technical characteristics:
// - Lowering compiler simulation for switch statements with non-contiguous sparse case labels
// - Direct Dense Jump Table for high-density clustered sub-ranges
// - Balanced Binary Search Decision Tree Jump Table achieving O(log N) branch depth
// - Open-Addressing Hash Jump Table with multiplicative hashing achieving O(1) expected dispatch
// - Clustered Two-Level Segmented Jump Table combining dense array windows with sparse outliers
// - Equivalence cross-verification across Linear, Binary Search, Hash, and Clustered dispatchers
// - Sparse Opcode Virtual Machine executing programs on non-contiguous bytecode instruction sets
// - Comprehensive boundary testing: negative keys, zero, contiguous clusters, large prime gaps, out-of-table keys
// - High-throughput stress benchmark executing 30,000+ sparse case dispatches with deterministic checksums
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero external dependencies, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Simulated Large Switch Sparse Jump Table Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Action Handler Identifiers ---

handlerIdDefault = 0
handlerIdNegateAbs = 1
handlerIdResetZero = 2
handlerIdCube = 3
handlerIdCollatzStep = 4
handlerIdMultiply13 = 5
handlerIdBitRotateLeft = 6
handlerIdBitXorMask = 7
handlerIdModAdd53 = 8
handlerIdSquare = 9
handlerIdIncrement = 10
handlerIdFibonacciStep = 11
handlerIdClamp1000 = 12
handlerIdShiftRight2 = 13
handlerIdPolynomialStep = 14
handlerIdHypotSquared = 15
handlerIdGoldenRatioStep = 16

// --- Telemetry Counters ---

totalDispatches = [0]
sparseCaseHits = [0]
defaultCaseHits = [0]
linearScanProbes = [0]
binarySearchProbes = [0]
hashTableProbes = [0]
clusteredTableProbes = [0]
vmInstructionsExecuted = [0]

// --- Action Handler Dispatcher ---

func dispatchAction(actionHandlerId, actionAcc, actionKey) {
    totalDispatches[0] = totalDispatches[0] + 1
    if (actionHandlerId == 1) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        if (actionAcc < 0) {
            return -actionAcc
        }
        return -actionAcc
    } elif (actionHandlerId == 2) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        return 0
    } elif (actionHandlerId == 3) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        return (actionAcc * actionAcc * actionAcc) % 1000007
    } elif (actionHandlerId == 4) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        if (actionAcc % 2 == 0) {
            return actionAcc / 2
        }
        return actionAcc * 3 + 1
    } elif (actionHandlerId == 5) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        return (actionAcc * 13) % 1000007
    } elif (actionHandlerId == 6) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        lowPart = (actionAcc << 3) & 16777215
        highPart = (actionAcc >> 21) & 7
        return lowPart | highPart
    } elif (actionHandlerId == 7) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        return actionAcc ^ 1048575
    } elif (actionHandlerId == 8) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        return (actionAcc + 53) % 1000007
    } elif (actionHandlerId == 9) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        return (actionAcc * actionAcc) % 1000007
    } elif (actionHandlerId == 10) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        return actionAcc + 1
    } elif (actionHandlerId == 11) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        return (actionAcc * 2 + 1) % 1000007
    } elif (actionHandlerId == 12) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        if (actionAcc < -1000) {
            return -1000
        }
        if (actionAcc > 1000) {
            return 1000
        }
        return actionAcc
    } elif (actionHandlerId == 13) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        return actionAcc >> 2
    } elif (actionHandlerId == 14) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        sq = (actionAcc * actionAcc) % 1000007
        term2 = (3 * sq) % 1000007
        term1 = (5 * actionAcc) % 1000007
        return (term2 + term1 + 7) % 1000007
    } elif (actionHandlerId == 15) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        keyMod = (actionKey % 1000007 + 1000007) % 1000007
        accMod = (actionAcc % 1000007 + 1000007) % 1000007
        return ((accMod * accMod) + (keyMod * keyMod)) % 1000007
    } elif (actionHandlerId == 16) {
        sparseCaseHits[0] = sparseCaseHits[0] + 1
        normKey = (actionKey % 1000007 + 1000007) % 1000007
        return (actionAcc * 26544 + normKey) % 1000007
    } else {
        defaultCaseHits[0] = defaultCaseHits[0] + 1
        keyAbs = actionKey
        if (keyAbs < 0) {
            keyAbs = -keyAbs
        }
        return ((actionAcc ^ keyAbs) + 42) % 1000007
    }
}

// --- Linear Scan Reference Dispatcher ---

func dispatchLinear(sourceKeys, sourceHandlers, targetKey, defaultHandler) {
    linIdx = 0
    linSz = sourceKeys.size()
    while (linIdx < linSz) {
        linearScanProbes[0] = linearScanProbes[0] + 1
        if (sourceKeys[linIdx] == targetKey) {
            return sourceHandlers[linIdx]
        }
        linIdx = linIdx + 1
    }
    return defaultHandler
}

// --- Direct Dense Jump Table Dispatcher ---

func createDenseJumpTable(denseKeys, denseHandlers, defaultHandler) {
    if (denseKeys.size() == 0) {
        return [0, -1, []]
    }
    dMinKey = denseKeys[0]
    dMaxKey = denseKeys[0]
    dScanIdx = 1
    dScanSz = denseKeys.size()
    while (dScanIdx < dScanSz) {
        kVal = denseKeys[dScanIdx]
        if (kVal < dMinKey) {
            dMinKey = kVal
        }
        if (kVal > dMaxKey) {
            dMaxKey = kVal
        }
        dScanIdx = dScanIdx + 1
    }
    rangeLen = dMaxKey - dMinKey + 1
    denseTableArray = []
    dTIdx = 0
    while (dTIdx < rangeLen) {
        denseTableArray.push(-1)
        dTIdx = dTIdx + 1
    }
    dPopIdx = 0
    while (dPopIdx < dScanSz) {
        offset = denseKeys[dPopIdx] - dMinKey
        denseTableArray[offset] = denseHandlers[dPopIdx]
        dPopIdx = dPopIdx + 1
    }
    return [dMinKey, dMaxKey, denseTableArray]
}

func dispatchDenseJumpTable(denseTableRef, targetKey, defaultHandler) {
    tableMinKey = denseTableRef[0]
    tableMaxKey = denseTableRef[1]
    if (targetKey < tableMinKey or targetKey > tableMaxKey) {
        return defaultHandler
    }
    tableSlots = denseTableRef[2]
    slotOffset = targetKey - tableMinKey
    foundHandler = tableSlots[slotOffset]
    if (foundHandler == -1) {
        return defaultHandler
    }
    return foundHandler
}

// --- Binary Search Decision Tree Jump Table ---

func sortKeyHandlerPairs(unsortedKeys, unsortedHandlers) {
    pairSz = unsortedKeys.size()
    sortedKeysArr = []
    sortedHandlersArr = []
    sortInitIdx = 0
    while (sortInitIdx < pairSz) {
        sortedKeysArr.push(unsortedKeys[sortInitIdx])
        sortedHandlersArr.push(unsortedHandlers[sortInitIdx])
        sortInitIdx = sortInitIdx + 1
    }
    sortOuter = 1
    while (sortOuter < pairSz) {
        insKey = sortedKeysArr[sortOuter]
        insHandler = sortedHandlersArr[sortOuter]
        sortInner = sortOuter - 1
        isShifting = 1
        while (sortInner >= 0 and isShifting == 1) {
            if (sortedKeysArr[sortInner] > insKey) {
                sortedKeysArr[sortInner + 1] = sortedKeysArr[sortInner]
                sortedHandlersArr[sortInner + 1] = sortedHandlersArr[sortInner]
                sortInner = sortInner - 1
            } else {
                isShifting = 0
            }
        }
        sortedKeysArr[sortInner + 1] = insKey
        sortedHandlersArr[sortInner + 1] = insHandler
        sortOuter = sortOuter + 1
    }
    return [sortedKeysArr, sortedHandlersArr]
}

func createBinarySearchJumpTable(sourceKeys, sourceHandlers) {
    return sortKeyHandlerPairs(sourceKeys, sourceHandlers)
}

func dispatchBinarySearch(bstTableRef, targetKey, defaultHandler) {
    bstKeys = bstTableRef[0]
    bstHandlers = bstTableRef[1]
    bstLow = 0
    bstHigh = bstKeys.size() - 1
    while (bstLow <= bstHigh) {
        binarySearchProbes[0] = binarySearchProbes[0] + 1
        bstMid = bstLow + (bstHigh - bstLow) / 2
        midKey = bstKeys[bstMid]
        if (midKey == targetKey) {
            return bstHandlers[bstMid]
        }
        if (targetKey < midKey) {
            bstHigh = bstMid - 1
        } else {
            bstLow = bstMid + 1
        }
    }
    return defaultHandler
}

// --- Open-Addressing Hash Jump Table ---

func createHashJumpTable(inputKeys, inputHandlers, defaultHandler) {
    htSz = inputKeys.size()
    htCap = htSz * 2 + 11
    htKeys = []
    htHandlers = []
    htOccupied = []
    htInitIdx = 0
    while (htInitIdx < htCap) {
        htKeys.push(0)
        htHandlers.push(defaultHandler)
        htOccupied.push(false)
        htInitIdx = htInitIdx + 1
    }
    htInsertIdx = 0
    while (htInsertIdx < htSz) {
        insKey = inputKeys[htInsertIdx]
        insHandler = inputHandlers[htInsertIdx]
        normKey = insKey
        if (normKey < 0) {
            normKey = (-normKey) * 31 + 7
        }
        slot = ((normKey * 26544 + 1013904223) % htCap + htCap) % htCap
        while (htOccupied[slot]) {
            slot = (slot + 1) % htCap
        }
        htKeys[slot] = insKey
        htHandlers[slot] = insHandler
        htOccupied[slot] = true
        htInsertIdx = htInsertIdx + 1
    }
    return [htCap, htKeys, htHandlers, htOccupied]
}

func dispatchHashJumpTable(hashTableRef, targetKey, defaultHandler) {
    htCap = hashTableRef[0]
    htKeys = hashTableRef[1]
    htHandlers = hashTableRef[2]
    htOccupied = hashTableRef[3]
    normKey = targetKey
    if (normKey < 0) {
        normKey = (-normKey) * 31 + 7
    }
    slot = ((normKey * 26544 + 1013904223) % htCap + htCap) % htCap
    probeCount = 0
    while (htOccupied[slot] and probeCount < htCap) {
        hashTableProbes[0] = hashTableProbes[0] + 1
        if (htKeys[slot] == targetKey) {
            return htHandlers[slot]
        }
        slot = (slot + 1) % htCap
        probeCount = probeCount + 1
    }
    return defaultHandler
}

// --- Clustered Two-Level Segmented Jump Table ---

func createClusteredJumpTable(clusterSpecs, outlierKeys, outlierHandlers, defaultHandler) {
    compiledClusters = []
    cSpecIdx = 0
    while (cSpecIdx < clusterSpecs.size()) {
        spec = clusterSpecs[cSpecIdx]
        cMin = spec[0]
        cMax = spec[1]
        cKeys = spec[2]
        cHandlers = spec[3]
        cLen = cMax - cMin + 1
        cArray = []
        cFillIdx = 0
        while (cFillIdx < cLen) {
            cArray.push(-1)
            cFillIdx = cFillIdx + 1
        }
        cPopIdx = 0
        while (cPopIdx < cKeys.size()) {
            offset = cKeys[cPopIdx] - cMin
            cArray[offset] = cHandlers[cPopIdx]
            cPopIdx = cPopIdx + 1
        }
        compiledClusters.push([cMin, cMax, cArray])
        cSpecIdx = cSpecIdx + 1
    }
    compiledOutliers = createBinarySearchJumpTable(outlierKeys, outlierHandlers)
    return [compiledClusters, compiledOutliers]
}

func dispatchClusteredJumpTable(clusteredTableRef, targetKey, defaultHandler) {
    clusteredTableProbes[0] = clusteredTableProbes[0] + 1
    clClusters = clusteredTableRef[0]
    clOutliers = clusteredTableRef[1]
    clIdx = 0
    while (clIdx < clClusters.size()) {
        clusterItem = clClusters[clIdx]
        if (targetKey >= clusterItem[0] and targetKey <= clusterItem[1]) {
            clOffset = targetKey - clusterItem[0]
            clH = clusterItem[2][clOffset]
            if (clH != -1) {
                return clH
            }
            return defaultHandler
        }
        clIdx = clIdx + 1
    }
    return dispatchBinarySearch(clOutliers, targetKey, defaultHandler)
}

// --- Test Case 1: Core Dispatch Models & Default Fallback Validation ---

print("--- Running Test Case 1: Core Dispatch Models and Default Fallbacks ---")

caseKeys1 = [100, 101, 102, 103, 104, 105]
caseHandlers1 = [
    handlerIdBitRotateLeft,
    handlerIdBitXorMask,
    handlerIdModAdd53,
    handlerIdSquare,
    handlerIdIncrement,
    handlerIdFibonacciStep
]

denseTable1 = createDenseJumpTable(caseKeys1, caseHandlers1, handlerIdDefault)
bstTable1 = createBinarySearchJumpTable(caseKeys1, caseHandlers1)
hashTable1 = createHashJumpTable(caseKeys1, caseHandlers1, handlerIdDefault)

// Verify exact matches on dense, bst, and hash tables
cIdx1 = 0
while (cIdx1 < caseKeys1.size()) {
    targetK1 = caseKeys1[cIdx1]
    expectedH1 = caseHandlers1[cIdx1]
    linearH1 = dispatchLinear(caseKeys1, caseHandlers1, targetK1, handlerIdDefault)
    denseH1 = dispatchDenseJumpTable(denseTable1, targetK1, handlerIdDefault)
    bstH1 = dispatchBinarySearch(bstTable1, targetK1, handlerIdDefault)
    hashH1 = dispatchHashJumpTable(hashTable1, targetK1, handlerIdDefault)
    if (linearH1 != expectedH1 or denseH1 != expectedH1 or bstH1 != expectedH1 or hashH1 != expectedH1) {
        print("[FAIL] Test Case 1 Mismatch for key ", targetK1, ": lin=", linearH1, " dense=", denseH1, " bst=", bstH1, " hash=", hashH1)
        testSuiteFailures = testSuiteFailures + 1
    }
    cIdx1 = cIdx1 + 1
}

// Verify unmapped holes and boundary fallbacks
outsideKeys1 = [99, 106, 0, 50, 200, -1]
oIdx1 = 0
while (oIdx1 < outsideKeys1.size()) {
    outK1 = outsideKeys1[oIdx1]
    linearH1 = dispatchLinear(caseKeys1, caseHandlers1, outK1, handlerIdDefault)
    denseH1 = dispatchDenseJumpTable(denseTable1, outK1, handlerIdDefault)
    bstH1 = dispatchBinarySearch(bstTable1, outK1, handlerIdDefault)
    hashH1 = dispatchHashJumpTable(hashTable1, outK1, handlerIdDefault)
    if (linearH1 != handlerIdDefault or denseH1 != handlerIdDefault or bstH1 != handlerIdDefault or hashH1 != handlerIdDefault) {
        print("[FAIL] Test Case 1 Expected default for key ", outK1, ": lin=", linearH1, " dense=", denseH1, " bst=", bstH1, " hash=", hashH1)
        testSuiteFailures = testSuiteFailures + 1
    }
    oIdx1 = oIdx1 + 1
}

print("  Test Case 1 Passed Core Dispatch Models and Default Fallbacks")

// --- Test Case 2: Boundary Edge Cases and Extreme Sparse Distribution ---

print("--- Running Test Case 2: Boundary Edge Cases and Extreme Sparse Distribution ---")

sparseKeys2 = [-500, 0, 3, 17, 42, 100, 101, 102, 103, 104, 105, 500, 1024, 8192, 65536, 1000000]
sparseHandlers2 = [
    handlerIdNegateAbs,
    handlerIdResetZero,
    handlerIdCube,
    handlerIdCollatzStep,
    handlerIdMultiply13,
    handlerIdBitRotateLeft,
    handlerIdBitXorMask,
    handlerIdModAdd53,
    handlerIdSquare,
    handlerIdIncrement,
    handlerIdFibonacciStep,
    handlerIdClamp1000,
    handlerIdShiftRight2,
    handlerIdPolynomialStep,
    handlerIdHypotSquared,
    handlerIdGoldenRatioStep
]

bstTable2 = createBinarySearchJumpTable(sparseKeys2, sparseHandlers2)
hashTable2 = createHashJumpTable(sparseKeys2, sparseHandlers2, handlerIdDefault)

clusterDenseKeys = [100, 101, 102, 103, 104, 105]
clusterDenseHandlers = [
    handlerIdBitRotateLeft,
    handlerIdBitXorMask,
    handlerIdModAdd53,
    handlerIdSquare,
    handlerIdIncrement,
    handlerIdFibonacciStep
]
clusterSpecs2 = [
    [100, 105, clusterDenseKeys, clusterDenseHandlers]
]
outliersKeys2 = [-500, 0, 3, 17, 42, 500, 1024, 8192, 65536, 1000000]
outliersHandlers2 = [
    handlerIdNegateAbs,
    handlerIdResetZero,
    handlerIdCube,
    handlerIdCollatzStep,
    handlerIdMultiply13,
    handlerIdClamp1000,
