import stdlib string as s
import stdlib time as t

// Suffix Automaton (SAM / Directed Acyclic Word Graph - DAWG) Algorithm Suite
// Linear-Time Online String Processing & Topological Suffix Structure
//
// Time Complexity: O(N) online construction, O(|P|) exact pattern matching and frequency
// Space Complexity: O(N) linear state and transition space bounds
//
// Technical characteristics:
// - Online state machine construction with suffix link maintenance and cloned state branching
// - Theoretical upper bounds: at most 2N - 1 states and 3N - 4 transitions for string length N
// - Exact distinct substring summation via equivalence class length span: sum(len[u] - len[link[u]])
// - O(|P|) pattern existence testing and exact occurrence frequency via endpos counting sort DP
// - First occurrence position localization and endpos span verification
// - Linear-time Longest Common Substring (LCS) across arbitrary query strings
// - Lexicographically minimal cyclic shift computation via doubled string SAM traversal
// - Comprehensive invariant assertions ensuring topological and DAG validity
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Suffix Automaton Linear Construction Algorithm Suite ===")
globalStartTime = t.millis()

func makeIntArray(sz, fillVal) {
    arr = []
    i = 0
    while (i < sz) {
        arr.push(fillVal)
        i = i + 1
    }
    return arr
}

func createSuffixAutomaton(maxStates) {
    samLen = makeIntArray(maxStates, 0)
    samLink = makeIntArray(maxStates, -1)
    samNext = makeIntArray(maxStates * 128, -1)
    samEndpos = makeIntArray(maxStates, 0)
    firstPos = makeIntArray(maxStates, 0)
    isClone = makeIntArray(maxStates, 0)

    samLink[0] = -1
    samLen[0] = 0

    return [1, 0, samLen, samLink, samNext, samEndpos, firstPos, isClone, maxStates]
}

func extendSuffixAutomaton(sam, charCode, charIdx) {
    samSz = sam[0]
    last = sam[1]
    samLen = sam[2]
    samLink = sam[3]
    samNext = sam[4]
    samEndpos = sam[5]
    firstPos = sam[6]
    isClone = sam[7]

    cur = samSz
    samSz = samSz + 1
    samLen[cur] = samLen[last] + 1
    samEndpos[cur] = 1
    firstPos[cur] = charIdx
    isClone[cur] = 0

    p = last
    while (p != -1 and samNext[p * 128 + charCode] == -1) {
        samNext[p * 128 + charCode] = cur
        p = samLink[p]
    }

    if (p == -1) {
        samLink[cur] = 0
    } else {
        q = samNext[p * 128 + charCode]
        if (samLen[p] + 1 == samLen[q]) {
            samLink[cur] = q
        } else {
            clone = samSz
            samSz = samSz + 1
            samLen[clone] = samLen[p] + 1
            samLink[clone] = samLink[q]
            firstPos[clone] = firstPos[q]
            isClone[clone] = 1
            samEndpos[clone] = 0

            ci = 0
            while (ci < 128) {
                samNext[clone * 128 + ci] = samNext[q * 128 + ci]
                ci = ci + 1
            }

            while (p != -1 and samNext[p * 128 + charCode] == q) {
                samNext[p * 128 + charCode] = clone
                p = samLink[p]
            }

            samLink[q] = clone
            samLink[cur] = clone
        }
    }

    sam[0] = samSz
    sam[1] = cur
}

func computeEndposCounts(sam, maxLen) {
    samSz = sam[0]
    samLen = sam[2]
    samLink = sam[3]
    samEndpos = sam[5]

    cnt = makeIntArray(maxLen + 1, 0)
    i = 0
    while (i < samSz) {
        cnt[samLen[i]] = cnt[samLen[i]] + 1
        i = i + 1
    }

    lenIdx = 1
    while (lenIdx <= maxLen) {
        cnt[lenIdx] = cnt[lenIdx] + cnt[lenIdx - 1]
        lenIdx = lenIdx + 1
    }

    order = makeIntArray(samSz, 0)
    st = 0
    while (st < samSz) {
        pos = cnt[samLen[st]] - 1
        cnt[samLen[st]] = cnt[samLen[st]] - 1
        order[pos] = st
        st = st + 1
    }

    revIdx = samSz - 1
    while (revIdx >= 0) {
        state = order[revIdx]
        parent = samLink[state]
        if (parent != -1) {
            samEndpos[parent] = samEndpos[parent] + samEndpos[state]
        }
        revIdx = revIdx - 1
    }
}

func buildSuffixAutomaton(inputStr) {
    buildStrLen = s.length(inputStr)
    maxCap = buildStrLen * 2 + 10
    sam = createSuffixAutomaton(maxCap)

    idx = 0
    while (idx < buildStrLen) {
        chCode = s.charCodeAt(inputStr, idx)
        extendSuffixAutomaton(sam, chCode, idx)
        idx = idx + 1
    }

    computeEndposCounts(sam, buildStrLen)
    return sam
}

func countTransitions(sam) {
    samSz = sam[0]
    samNext = sam[4]
    edgeCount = 0

    st = 0
    while (st < samSz) {
        ci = 0
        while (ci < 128) {
            if (samNext[st * 128 + ci] != -1) {
                edgeCount = edgeCount + 1
            }
            ci = ci + 1
        }
        st = st + 1
    }
    return edgeCount
}

func countDistinctSubstrings(sam) {
    samSz = sam[0]
    samLen = sam[2]
    samLink = sam[3]

    totalDistinct = 0
    st = 1
    while (st < samSz) {
        parent = samLink[st]
        totalDistinct = totalDistinct + (samLen[st] - samLen[parent])
        st = st + 1
    }
    return totalDistinct
}

func containsSubstring(sam, pattern) {
    samNext = sam[4]
    patLen = s.length(pattern)
    curr = 0
    i = 0
    while (i < patLen) {
        chCode = s.charCodeAt(pattern, i)
        nxt = samNext[curr * 128 + chCode]
        if (nxt == -1) {
            return false
        }
        curr = nxt
        i = i + 1
    }
    return true
}

func countOccurrences(sam, pattern) {
    samNext = sam[4]
    samEndpos = sam[5]
    patLen = s.length(pattern)
    curr = 0
    i = 0
    while (i < patLen) {
        chCode = s.charCodeAt(pattern, i)
        nxt = samNext[curr * 128 + chCode]
        if (nxt == -1) {
            return 0
        }
        curr = nxt
        i = i + 1
    }
    return samEndpos[curr]
}

func findFirstOccurrence(sam, pattern) {
    samNext = sam[4]
    firstPos = sam[6]
    patLen = s.length(pattern)
    curr = 0
    i = 0
    while (i < patLen) {
        chCode = s.charCodeAt(pattern, i)
        nxt = samNext[curr * 128 + chCode]
        if (nxt == -1) {
            return -1
        }
        curr = nxt
        i = i + 1
    }
    return firstPos[curr] - patLen + 1
}

func findLongestCommonSubstring(sam, targetStr) {
    samLen = sam[2]
    samLink = sam[3]
    samNext = sam[4]

    targetLen = s.length(targetStr)
    curr = 0
    curLen = 0
    bestLen = 0
    bestPos = 0

    ti = 0
    while (ti < targetLen) {
        chCode = s.charCodeAt(targetStr, ti)

        while (curr != -1 and samNext[curr * 128 + chCode] == -1) {
            curr = samLink[curr]
            if (curr != -1) {
                curLen = samLen[curr]
            }
        }

        if (curr == -1) {
            curr = 0
            curLen = 0
        } else {
            curr = samNext[curr * 128 + chCode]
            curLen = curLen + 1
        }

        if (curLen > bestLen) {
            bestLen = curLen
            bestPos = ti - curLen + 1
        }
        ti = ti + 1
    }

    if (bestLen == 0) {
        return ""
    }
    return s.substring(targetStr, bestPos, bestLen)
}

func findMinimalCyclicShift(origStr) {
    shiftTargetLen = s.length(origStr)
    if (shiftTargetLen <= 1) {
        return origStr
    }

    doubledStr = origStr + origStr
    sam = buildSuffixAutomaton(doubledStr)
    samNext = sam[4]
    firstPos = sam[6]

    res = ""
    curr = 0
    step = 0
    while (step < shiftTargetLen) {
        ci = 0
        found = false
        while (ci < 128 and !found) {
            nxt = samNext[curr * 128 + ci]
            if (nxt != -1) {
                found = true
                curr = nxt
                ch = s.substring(doubledStr, firstPos[curr], 1)
                res = res + ch
            }
            ci = ci + 1
        }
        step = step + 1
    }
    return res
}

func verifySuffixAutomatonInvariants(sam, inputStr) {
    verifyStrLen = s.length(inputStr)
    samSz = sam[0]
    samLen = sam[2]
    samLink = sam[3]
    samNext = sam[4]

    // Invariant 1: State space upper bound
    if (verifyStrLen == 1) {
        if (samSz > 2) {
            print("FAIL: State space bound exceeded for length 1:", samSz)
            return false
        }
    } elif (verifyStrLen >= 2) {
        maxExpectedStates = 2 * verifyStrLen - 1
        if (samSz > maxExpectedStates) {
            print("FAIL: State space bound exceeded:", samSz, ">", maxExpectedStates)
            return false
        }
    }

    // Invariant 2: Transition upper bound <= 3N - 4 (for N >= 3)
    edgeCount = countTransitions(sam)
    if (verifyStrLen >= 3) {
        maxExpectedEdges = 3 * verifyStrLen - 4
        if (edgeCount > maxExpectedEdges) {
            print("FAIL: Transition bound exceeded:", edgeCount, ">", maxExpectedEdges)
            return false
        }
    }

    // Invariant 3: Root state properties
    if (samLen[0] != 0 or samLink[0] != -1) {
        print("FAIL: Root state invariant violated")
        return false
    }

    // Invariant 4: Suffix link tree monotonicity & acyclicity
    st = 1
    while (st < samSz) {
        parent = samLink[st]
        if (parent < 0 or parent >= samSz) {
            print("FAIL: Suffix link out of range for state:", st)
            return false
        }
        if (samLen[parent] >= samLen[st]) {
            print("FAIL: Length monotonicity violated in link:", st, "->", parent)
            return false
        }

        // Trace to root to guarantee tree acyclicity
        curr = st
        hops = 0
        while (curr != 0 and hops < samSz) {
            curr = samLink[curr]
            hops = hops + 1
        }
        if (curr != 0) {
            print("FAIL: Cycle detected in suffix link tree from state:", st)
            return false
        }

        st = st + 1
    }

    // Invariant 5: Transition DAG length monotonicity (Acyclicity)
    u = 0
    while (u < samSz) {
        ci = 0
        while (ci < 128) {
            v = samNext[u * 128 + ci]
            if (v != -1) {
                if (samLen[v] <= samLen[u]) {
                    print("FAIL: Transition DAG monotonicity violated:", u, "->", v)
                    return false
                }
            }
            ci = ci + 1
        }
        u = u + 1
    }

    return true
}

func runAutomatonTestCase(testId, testName, inputStr, expectedDistinct) {
    print("Running Test Case", testId, ":", testName)
    caseStrLen = s.length(inputStr)
    sam = buildSuffixAutomaton(inputStr)

    samSz = sam[0]
    edgeCount = countTransitions(sam)
    distinctCount = countDistinctSubstrings(sam)

    print("  String Length:", caseStrLen, "| States:", samSz, "| Transitions:", edgeCount, "| Distinct Substrings:", distinctCount)

    if (distinctCount != expectedDistinct) {
        print("  FAIL: Distinct substring count mismatch. Got:", distinctCount, "Expected:", expectedDistinct)
        return false
    }

    invariantsValid = verifySuffixAutomatonInvariants(sam, inputStr)
    if (!invariantsValid) {
        print("  FAIL: Mathematical invariants failed")
        return false
    }

    print("  Topology Invariants: VALID | DAG Monotonicity: VALID")
    print("  Test Case", testId, "PASSED")
    return true
}

allSamPassed = true

// --- Test Case 1: Textbook String "banana" ---
// Distinct substrings of "banana" = 15
if (!runAutomatonTestCase(1, "Textbook String 'banana'", "banana", 15)) {
    allSamPassed = false
}

// --- Test Case 2: Highly Repetitive String "mississippi" ---
// Distinct substrings of "mississippi" = 53
if (!runAutomatonTestCase(2, "Repetitive String 'mississippi'", "mississippi", 53)) {
    allSamPassed = false
}

// --- Test Case 3: Monochromatic / Unary String "aaaaa" ---
// Distinct substrings of "aaaaa" = 5 ("a", "aa", "aaa", "aaaa", "aaaaa")
if (!runAutomatonTestCase(3, "Unary Monochromatic String 'aaaaa'", "aaaaa", 5)) {
    allSamPassed = false
}

// --- Test Case 4: Alternating Periodic String "abababab" ---
// Length 8: Distinct substrings = 15
if (!runAutomatonTestCase(4, "Alternating Periodic String 'abababab'", "abababab", 15)) {
    allSamPassed = false
}

// --- Test Case 5: Classic String "abracadabra" ---
// Length 11: Distinct substrings = 54
if (!runAutomatonTestCase(5, "Classic String 'abracadabra'", "abracadabra", 54)) {
    allSamPassed = false
}

// --- Test Case 6: De Bruijn Pattern "aababacaab" ---
// Length 10: Distinct substrings = 42
if (!runAutomatonTestCase(6, "De Bruijn Style Pattern 'aababacaab'", "aababacaab", 42)) {
    allSamPassed = false
}

// --- Test Case 7: Single Character Boundary String "z" ---
// Length 1: Distinct substrings = 1
if (!runAutomatonTestCase(7, "Single Character Boundary String 'z'", "z", 1)) {
    allSamPassed = false
}

// --- Verification Suite 8: Pattern Existence and Occurrence Counting ---
print("Running Query Suite 8: Pattern Matching and Endpos Frequency")
samMiss = buildSuffixAutomaton("mississippi")
matchPatterns = ["s", "i", "p", "m", "ss", "iss", "issip", "pp", "mississippi"]
matchExpFreq = [4, 4, 2, 1, 2, 2, 1, 1, 1]
matchExpFirst = [2, 1, 8, 0, 2, 1, 4, 8, 0]

querySuccess = true
qi = 0
while (qi < matchPatterns.size()) {
    pat = matchPatterns[qi]
    expFreq = matchExpFreq[qi]
    expFirst = matchExpFirst[qi]

    if (!containsSubstring(samMiss, pat)) {
        print("  FAIL: Pattern not recognized:", pat)
        querySuccess = false
    }

    freq = countOccurrences(samMiss, pat)
    if (freq != expFreq) {
        print("  FAIL: Frequency mismatch for pattern:", pat, "Got:", freq, "Expected:", expFreq)
        querySuccess = false
    }

    firstIdx = findFirstOccurrence(samMiss, pat)
    if (firstIdx != expFirst) {
        print("  FAIL: First position mismatch for pattern:", pat, "Got:", firstIdx, "Expected:", expFirst)
        querySuccess = false
    }
    qi = qi + 1
}

// Non-existent pattern verification
if (containsSubstring(samMiss, "misz") or countOccurrences(samMiss, "xyz") != 0 or findFirstOccurrence(samMiss, "abc") != -1) {
    print("  FAIL: False positive on non-existent patterns")
    querySuccess = false
}

if (querySuccess) {
    print("  Endpos Occurrence Frequencies: VALID | Position Localization: VALID")
    print("  Query Suite 8 PASSED")
} else {
    allSamPassed = false
}

// --- Verification Suite 9: Linear-Time Longest Common Substring (LCS) ---
print("Running Query Suite 9: Longest Common Substring (LCS)")
samA = buildSuffixAutomaton("structuralengineering")
lcs1 = findLongestCommonSubstring(samA, "reverseengineering")
if (lcs1 != "engineering") {
    print("  FAIL: LCS mismatch. Got:", lcs1, "Expected: engineering")
    allSamPassed = false
} else {
    print("  LCS('structuralengineering', 'reverseengineering') =", lcs1, ": VALID")
}

samB = buildSuffixAutomaton("abacaba")
lcs2 = findLongestCommonSubstring(samB, "bacad")
if (lcs2 != "baca") {
    print("  FAIL: LCS mismatch. Got:", lcs2, "Expected: baca")
    allSamPassed = false
} else {
    print("  LCS('abacaba', 'bacad') =", lcs2, ": VALID")
}

samC = buildSuffixAutomaton("abcdef")
lcs3 = findLongestCommonSubstring(samC, "uvwxyz")
if (lcs3 != "") {
    print("  FAIL: Disjoint LCS mismatch. Got:", lcs3, "Expected: empty string")
    allSamPassed = false
} else {
    print("  LCS('abcdef', 'uvwxyz') = [empty string] : VALID")
}
print("  Query Suite 9 PASSED")

// --- Verification Suite 10: Lexicographically Minimal Cyclic Shift ---
print("Running Query Suite 10: Lexicographically Minimal Cyclic Shift")
minShift1 = findMinimalCyclicShift("bbaacaab")
if (minShift1 != "aabbbaac") {
    print("  FAIL: Minimal cyclic shift mismatch. Got:", minShift1, "Expected: aabbbaac")
    allSamPassed = false
} else {
    print("  MinimalCyclicShift('bbaacaab') =", minShift1, ": VALID")
}

minShift2 = findMinimalCyclicShift("cba")
if (minShift2 != "acb") {
    print("  FAIL: Minimal cyclic shift mismatch. Got:", minShift2, "Expected: acb")
    allSamPassed = false
} else {
    print("  MinimalCyclicShift('cba') =", minShift2, ": VALID")
}

minShift3 = findMinimalCyclicShift("aaaa")
if (minShift3 != "aaaa") {
    print("  FAIL: Minimal cyclic shift mismatch. Got:", minShift3, "Expected: aaaa")
    allSamPassed = false
} else {
    print("  MinimalCyclicShift('aaaa') =", minShift3, ": VALID")
}
print("  Query Suite 10 PASSED")

// --- Final Suite Summary ---
print("=== Suffix Automaton Linear Construction Algorithm Suite Summary ===")
if (allSamPassed) {
    print("All Suffix Automaton test suites: SUCCESS")
} else {
    print("Some Suffix Automaton test suites: FAILED")
}

totalElapsed = t.millis() - globalStartTime
print("[PASS] Suffix Automaton Linear Construction executed successfully in", totalElapsed, "ms")
