import stdlib time as t

// Dinic's Algorithm for Maximum Network Flow with Layered Level Graphs
// Time Complexity: O(V^2 * E) for general networks, O(E * sqrt(V)) for unit capacity networks
// Space Complexity: O(V + E) forward-star residual representation
// Technical characteristics:
// - Breadth-First Search (BFS) establishes layered level graph from source to sink
// - Depth-First Search (DFS) with current-edge work pointers pushes blocking flow
// - Forward-star adjacency representation with paired reciprocal back-edges
// - Iterative path stack traversal eliminates deep call recursion overhead
// - Duality verification via Max-Flow Min-Cut Theorem: Total Flow == Min Cut Capacity
// - Invariant assertions: Flow conservation at internal nodes and capacity bounds
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Dinic Network Flow & Blocking Flow Algorithm Suite ===")
globalStartTime = t.millis()

func makeIntArray(sz, fillVal) {
    arr = []
    i = 0
    while (i < sz) {
        arr.push(fillVal)
        i = i + 1
    }
    return arr
}

func minInt(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func createFlowNetwork(numNodes) {
    head = makeIntArray(numNodes, -1)
    edgeTo = []
    edgeCap = []
    edgeFlow = []
    edgeRev = []
    edgeNext = []
    return [numNodes, head, edgeTo, edgeCap, edgeFlow, edgeRev, edgeNext]
}

func addFlowEdge(net, u, v, cap) {
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    forwardIdx = edgeTo.size()
    reverseIdx = forwardIdx + 1

    // Forward edge u -> v with forward capacity
    edgeTo.push(v)
    edgeCap.push(cap)
    edgeFlow.push(0)
    edgeRev.push(reverseIdx)
    edgeNext.push(head[u])
    head[u] = forwardIdx

    // Residual backward edge v -> u with initial capacity 0
    edgeTo.push(u)
    edgeCap.push(0)
    edgeFlow.push(0)
    edgeRev.push(forwardIdx)
    edgeNext.push(head[v])
    head[v] = reverseIdx

    net[1] = head
    net[2] = edgeTo
    net[3] = edgeCap
    net[4] = edgeFlow
    net[5] = edgeRev
    net[6] = edgeNext
}

func buildLevelGraphBfs(net, src, snk) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeNext = net[6]

    level = makeIntArray(numNodes, -1)
    level[src] = 0

    queue = [src]
    qHead = 0

    while (qHead < queue.size()) {
        curr = queue[qHead]
        qHead = qHead + 1

        e = head[curr]
        while (e != -1) {
            nxt = edgeTo[e]
            residual = edgeCap[e] - edgeFlow[e]
            if (residual > 0 and level[nxt] == -1) {
                level[nxt] = level[curr] + 1
                queue.push(nxt)
            }
            e = edgeNext[e]
        }
    }

    return level
}

func executeDinicBlockingFlow(net, src, snk) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    totalMaxFlow = 0
    phaseCount = 0

    level = buildLevelGraphBfs(net, src, snk)
    while (level[snk] != -1) {
        phaseCount = phaseCount + 1

        // Initialize work pointers pointing to each vertex head
        workPtr = makeIntArray(numNodes, 0)
        i = 0
        while (i < numNodes) {
            workPtr[i] = head[i]
            i = i + 1
        }

        pathNodes = [src]
        pathEdges = []

        while (pathNodes.size() > 0) {
            currNode = pathNodes[pathNodes.size() - 1]

            if (currNode == snk) {
                // Find bottleneck residual along current augmenting path
                bottleneck = edgeCap[pathEdges[0]] - edgeFlow[pathEdges[0]]
                pIdx = 1
                while (pIdx < pathEdges.size()) {
                    pe = pathEdges[pIdx]
                    res = edgeCap[pe] - edgeFlow[pe]
                    bottleneck = minInt(bottleneck, res)
                    pIdx = pIdx + 1
                }

                // Augment flow along path and reciprocal back-edges
                pIdx = 0
                while (pIdx < pathEdges.size()) {
                    pe = pathEdges[pIdx]
                    re = edgeRev[pe]
                    edgeFlow[pe] = edgeFlow[pe] + bottleneck
                    edgeFlow[re] = edgeFlow[re] - bottleneck
                    pIdx = pIdx + 1
                }

                totalMaxFlow = totalMaxFlow + bottleneck

                // Locate the earliest saturated edge on the path to backtrack
                firstSaturated = -1
                pIdx = 0
                while (pIdx < pathEdges.size() and firstSaturated == -1) {
                    pe = pathEdges[pIdx]
                    if (edgeCap[pe] - edgeFlow[pe] == 0) {
                        firstSaturated = pIdx
                    }
                    pIdx = pIdx + 1
                }

                // Pop stack to the saturated node
                discardEdge = -1
                while (pathEdges.size() > firstSaturated) {
                    discardEdge = pathEdges.pop()
                    discardNode = pathNodes.pop()
                }

                satVertex = pathNodes[pathNodes.size() - 1]
                workPtr[satVertex] = edgeNext[discardEdge]
            } else {
                admissibleEdge = -1
                while (workPtr[currNode] != -1 and admissibleEdge == -1) {
                    candidateEdge = workPtr[currNode]
                    nxt = edgeTo[candidateEdge]
                    residual = edgeCap[candidateEdge] - edgeFlow[candidateEdge]
                    if (residual > 0 and level[nxt] == level[currNode] + 1) {
                        admissibleEdge = candidateEdge
                    } else {
                        workPtr[currNode] = edgeNext[candidateEdge]
                    }
                }

                if (admissibleEdge != -1) {
                    pathEdges.push(admissibleEdge)
                    pathNodes.push(edgeTo[admissibleEdge])
                } else {
                    // Mark dead end in current level phase
                    level[currNode] = -1
                    pathNodes.pop()
                    if (pathEdges.size() > 0) {
                        prevEdge = pathEdges.pop()
                        prevVertex = pathNodes[pathNodes.size() - 1]
                        workPtr[prevVertex] = edgeNext[prevEdge]
                    }
                }
            }
        }

        level = buildLevelGraphBfs(net, src, snk)
    }

    return [totalMaxFlow, phaseCount]
}

func computeMinCutPartition(net, src) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeNext = net[6]

    inSourceSet = makeIntArray(numNodes, 0)
    inSourceSet[src] = 1

    queue = [src]
    qHead = 0

    while (qHead < queue.size()) {
        curr = queue[qHead]
        qHead = qHead + 1

        e = head[curr]
        while (e != -1) {
            nxt = edgeTo[e]
            residual = edgeCap[e] - edgeFlow[e]
            if (inSourceSet[nxt] == 0 and residual > 0) {
                inSourceSet[nxt] = 1
                queue.push(nxt)
            }
            e = edgeNext[e]
        }
    }

    cutCapacity = 0
    u = 0
    while (u < numNodes) {
        if (inSourceSet[u] == 1) {
            e = head[u]
            while (e != -1) {
                nxt = edgeTo[e]
                if (inSourceSet[nxt] == 0 and edgeCap[e] > 0) {
                    cutCapacity = cutCapacity + edgeCap[e]
                }
                e = edgeNext[e]
            }
        }
        u = u + 1
    }

    return [cutCapacity, inSourceSet]
}

func verifyFlowInvariants(net, src, snk, totalMaxFlow) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeRev = net[5]
    edgeNext = net[6]

    // 1. Check capacity constraints and skew symmetry
    totalEdges = edgeTo.size()
    e = 0
    while (e < totalEdges) {
        flow = edgeFlow[e]
        cap = edgeCap[e]
        rev = edgeRev[e]

        if (cap > 0) {
            if (flow < 0 or flow > cap) {
                return false
            }
        }
        if (flow != (0 - edgeFlow[rev])) {
            return false
        }
        e = e + 1
    }

    // 2. Check flow conservation for all nodes except source and sink
    u = 0
    while (u < numNodes) {
        netOutflow = 0
        e = head[u]
        while (e != -1) {
            netOutflow = netOutflow + edgeFlow[e]
            e = edgeNext[e]
        }

        if (u == src) {
            if (netOutflow != totalMaxFlow) {
                return false
            }
        } elif (u == snk) {
            if (netOutflow != (0 - totalMaxFlow)) {
                return false
            }
        } else {
            if (netOutflow != 0) {
                return false
            }
        }
        u = u + 1
    }

    return true
}

func runDinicTestCase(caseId, description, numNodes, edgesList, src, snk, expectedFlow) {
    print("Running Test Case " + caseId + ": " + description + "...")
    edgeCount = edgesList.size() / 3
    print("  Nodes: " + numNodes + ", Directed Edges: " + edgeCount + ", Source: " + src + ", Sink: " + snk)

    net = createFlowNetwork(numNodes)
    i = 0
    while (i < edgesList.size()) {
        u = edgesList[i]
        v = edgesList[i + 1]
        cap = edgesList[i + 2]
        addFlowEdge(net, u, v, cap)
        i = i + 3
    }

    flowResult = executeDinicBlockingFlow(net, src, snk)
    computedFlow = flowResult[0]
    phases = flowResult[1]

    cutResult = computeMinCutPartition(net, src)
    minCutCapacity = cutResult[0]
    sourceSet = cutResult[1]

    invariantsHold = verifyFlowInvariants(net, src, snk, computedFlow)

    print("  Max Flow Computed   : " + computedFlow + " (Expected: " + expectedFlow + ")")
    print("  Min Cut Capacity    : " + minCutCapacity)
    print("  Blocking Phases     : " + phases)
    invariantsText = "INVALID"
    if (invariantsHold) {
        invariantsText = "VALID"
    }
    print("  Flow Invariants     : " + invariantsText)

    if (computedFlow == expectedFlow and computedFlow == minCutCapacity and invariantsHold) {
        print("  Test Case " + caseId + " PASSED (Max-Flow Min-Cut Duality verified)")
        return true
    }

    print("[FAIL] Test Case " + caseId + " failed verification")
    return false
}

allDinicPassed = true

// --- Test Case 1: Canonical 6-Node Flow Network ---
e1 = [
    0, 1, 10,
