import stdlib time as t

// Binomial Heap Priority Queue Forest Suite
// Technical characteristics:
// - Forest of binomial trees satisfying min-heap property
// - At most one tree of each order (binary representation of size N)
// - O(log N) union, insert, extractMin, and decreaseKey
// - Flat parallel array arena allocation for cache locality and zero GC overhead
// - Reverse child list reconstruction on extractMin
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Binomial Heap Forest Suite ===")
suiteStartTime = t.millis()

func createBinomialHeapArena() {
    bKey = []
    bVal = []
    bDegree = []
    bParent = []
    bChild = []
    bSibling = []
    return [bKey, bVal, bDegree, bParent, bChild, bSibling]
}

func allocBinomialNode(arena, key, val) {
    nodeId = arena[0].size()
    arena[0].push(key)
    arena[1].push(val)
    arena[2].push(0)
    arena[3].push(-1)
    arena[4].push(-1)
    arena[5].push(-1)
    return nodeId
}

// Links tree y as child of tree z (assumes key[z] <= key[y])
func linkBinomialTrees(arena, y, z) {
    bDegree = arena[2]
    bParent = arena[3]
    bChild = arena[4]
    bSibling = arena[5]

    bParent[y] = z
    bSibling[y] = bChild[z]
    bChild[z] = y
    bDegree[z] = bDegree[z] + 1
}

// Merges two root lists into single list sorted by degree in non-decreasing order
func mergeRootLists(arena, h1, h2) {
    if (h1 == -1) {
        return h2
    }
    if (h2 == -1) {
        return h1
    }

    bDegree = arena[2]
    bSibling = arena[5]

    head = -1
    tail = -1
    p1 = h1
    p2 = h2

    if (bDegree[p1] <= bDegree[p2]) {
        head = p1
        tail = p1
        p1 = bSibling[p1]
    } else {
        head = p2
        tail = p2
        p2 = bSibling[p2]
    }

    while (p1 != -1 and p2 != -1) {
        if (bDegree[p1] <= bDegree[p2]) {
            bSibling[tail] = p1
            tail = p1
            p1 = bSibling[p1]
        } else {
            bSibling[tail] = p2
            tail = p2
            p2 = bSibling[p2]
        }
    }

    if (p1 != -1) {
        bSibling[tail] = p1
    } else {
        bSibling[tail] = p2
    }

    return head
}

// Unions two binomial heaps
func unionBinomialHeaps(arena, h1, h2) {
    newHead = mergeRootLists(arena, h1, h2)
    if (newHead == -1) {
        return -1
    }

    bKey = arena[0]
    bDegree = arena[2]
    bParent = arena[3]
    bSibling = arena[5]

    prevX = -1
    x = newHead
    nextX = bSibling[x]

    while (nextX != -1) {
        nextNext = bSibling[nextX]
        needAdvance = 0

        if (bDegree[x] != bDegree[nextX]) {
            needAdvance = 1
        } else {
            if (nextNext != -1 and bDegree[nextNext] == bDegree[x]) {
                needAdvance = 1
            }
        }

        if (needAdvance == 1) {
            prevX = x
            x = nextX
        } else {
            if (bKey[x] <= bKey[nextX]) {
                bSibling[x] = bSibling[nextX]
                linkBinomialTrees(arena, nextX, x)
            } else {
                if (prevX == -1) {
                    newHead = nextX
                } else {
                    bSibling[prevX] = nextX
                }
                linkBinomialTrees(arena, x, nextX)
                x = nextX
            }
        }
        nextX = bSibling[x]
    }

    return newHead
}

func insertBinomialNode(arena, heapRoot, key, val) {
    newNode = allocBinomialNode(arena, key, val)
    return unionBinomialHeaps(arena, heapRoot, newNode)
}

func findMinBinomial(arena, heapRoot) {
    if (heapRoot == -1) {
        return [-1, -1, -1]
    }

    bKey = arena[0]
    bVal = arena[1]
    bSibling = arena[5]

    minNode = heapRoot
    minKey = bKey[heapRoot]
    curr = bSibling[heapRoot]

    while (curr != -1) {
        if (bKey[curr] < minKey) {
            minKey = bKey[curr]
            minNode = curr
        }
        curr = bSibling[curr]
    }

    return [minKey, bVal[minNode], minNode]
}

func extractMinBinomial(arena, heapRoot) {
    if (heapRoot == -1) {
        return [-1, -1, -1]
    }

    bKey = arena[0]
    bVal = arena[1]
    bParent = arena[3]
    bChild = arena[4]
    bSibling = arena[5]

    // Find min node and its predecessor in root list
    prevMin = -1
    minNode = heapRoot
    minKey = bKey[heapRoot]

    prev = heapRoot
    curr = bSibling[heapRoot]
    while (curr != -1) {
        if (bKey[curr] < minKey) {
            minKey = bKey[curr]
            minNode = curr
            prevMin = prev
        }
        prev = curr
        curr = bSibling[curr]
    }

    // Remove minNode from root list
    if (prevMin == -1) {
        heapRoot = bSibling[minNode]
    } else {
        bSibling[prevMin] = bSibling[minNode]
    }

    // Reverse the child list of minNode to build second heap
    childHead = bChild[minNode]
    revHead = -1
    cCurr = childHead
    while (cCurr != -1) {
        cNext = bSibling[cCurr]
        bParent[cCurr] = -1
        bSibling[cCurr] = revHead
        revHead = cCurr
        cCurr = cNext
    }

    resRoot = unionBinomialHeaps(arena, heapRoot, revHead)
    return [minKey, bVal[minNode], resRoot]
}

func decreaseKeyBinomial(arena, node, newKey) {
    bKey = arena[0]
    bVal = arena[1]
    bParent = arena[3]

    if (newKey > bKey[node]) {
        return 0
    }
    bKey[node] = newKey

    curr = node
    p = bParent[curr]
    while (p != -1 and bKey[curr] < bKey[p]) {
        // Swap keys and values
        tempK = bKey[curr]
        tempV = bVal[curr]
        bKey[curr] = bKey[p]
        bVal[curr] = bVal[p]
        bKey[p] = tempK
        bVal[p] = tempV

        curr = p
        p = bParent[curr]
    }
    return 1
}

func countHeapNodes(arena, heapRoot) {
    if (heapRoot == -1) {
        return 0
    }
    bChild = arena[4]
    bSibling = arena[5]

    total = 0
    stack = [heapRoot]
    while (stack.size() > 0) {
        n = stack.pop()
        total = total + 1
        c = bChild[n]
        while (c != -1) {
            stack.push(c)
            c = bSibling[c]
        }
        if (stack.size() == 0 and bSibling[n] != -1 and n == heapRoot) {
            // not child traversal, but root list traversal handled separately below
        }
    }
    return total
}

func getBinomialHeapTotalSize(arena, heapRoot) {
    if (heapRoot == -1) {
        return 0
    }
    bChild = arena[4]
    bSibling = arena[5]

    total = 0
    r = heapRoot
    while (r != -1) {
        st = [r]
        while (st.size() > 0) {
            curr = st.pop()
            total = total + 1
            ch = bChild[curr]
            while (ch != -1) {
                st.push(ch)
                ch = bSibling[ch]
            }
        }
        r = bSibling[r]
    }
    return total
}

func verifyBinomialHeapInvariants(arena, heapRoot) {
    if (heapRoot == -1) {
        return 1
    }

    bKey = arena[0]
    bDegree = arena[2]
    bParent = arena[3]
    bChild = arena[4]
    bSibling = arena[5]

    // Verify root degrees strictly increase
    currRoot = heapRoot
    prevDeg = -1
    while (currRoot != -1) {
        d = bDegree[currRoot]
        if (d <= prevDeg) {
            print("[FAIL] Root degree invariant violated: currDeg=", d, ", prevDeg=", prevDeg)
            return 0
        }
        prevDeg = d

        // Verify min-heap property and degree of children
        treeStack = [currRoot]
        while (treeStack.size() > 0) {
            node = treeStack.pop()
            nKey = bKey[node]
            nDeg = bDegree[node]

            childCount = 0
            c = bChild[node]
            while (c != -1) {
                if (bKey[c] < nKey) {
                    print("[FAIL] Heap property violated: parent=", nKey, ", child=", bKey[c])
                    return 0
                }
                if (bParent[c] != node) {
                    print("[FAIL] Parent pointer corrupted")
                    return 0
                }
                treeStack.push(c)
                childCount = childCount + 1
                c = bSibling[c]
            }
            if (childCount != nDeg) {
                print("[FAIL] Node degree does not match child count: degree=", nDeg, ", children=", childCount)
                return 0
            }
        }

        currRoot = bSibling[currRoot]
    }
    return 1
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Inserts and Monotonic Extraction
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Inserts and Monotonic Extraction...")
tc1Pass = 1
tc1Arena = createBinomialHeapArena()
tc1Root = -1

rawKeys = [45, 12, 89, 5, 23, 67, 1, 99, 34, 17, 28, 55, 3]
rawVals = [450, 120, 890, 50, 230, 670, 10, 990, 340, 170, 280, 550, 30]

idx1 = 0
while (idx1 < rawKeys.size()) {
    tc1Root = insertBinomialNode(tc1Arena, tc1Root, rawKeys[idx1], rawVals[idx1])
    if (verifyBinomialHeapInvariants(tc1Arena, tc1Root) != 1) {
        tc1Pass = 0
    }
    idx1 = idx1 + 1
}

if (getBinomialHeapTotalSize(tc1Arena, tc1Root) != rawKeys.size()) {
    tc1Pass = 0
}

minRes = findMinBinomial(tc1Arena, tc1Root)
if (minRes[0] != 1 or minRes[1] != 10) {
    tc1Pass = 0
}

sortedKeys = [1, 3, 5, 12, 17, 23, 28, 34, 45, 55, 67, 89, 99]
extIdx = 0
while (extIdx < sortedKeys.size()) {
    ext = extractMinBinomial(tc1Arena, tc1Root)
    tc1Root = ext[2]
    if (ext[0] != sortedKeys[extIdx]) {
        tc1Pass = 0
    }
    if (verifyBinomialHeapInvariants(tc1Arena, tc1Root) != 1) {
        tc1Pass = 0
    }
    extIdx = extIdx + 1
}

if (tc1Root != -1 or getBinomialHeapTotalSize(tc1Arena, tc1Root) != 0) {
    tc1Pass = 0
}

if (tc1Pass == 1) {
    print("  Sequential insertions maintain strictly increasing root degrees")
    print("  Global min element (1) retrieved correctly")
    print("  All 13 elements extracted in strictly ascending order")
    print("  Test Case 1 Passed successfully")
} else {
    print("[FAIL] Test Case 1 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 2: Forest Union of Disjoint Heaps
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 2: Forest Union of Disjoint Heaps...")
tc2Pass = 1
tc2Arena = createBinomialHeapArena()

hA = -1
keysA = [10, 30, 20, 50, 40, 70, 60] // 7 nodes => binary 111 => B2, B1, B0
idxA = 0
while (idxA < keysA.size()) {
    hA = insertBinomialNode(tc2Arena, hA, keysA[idxA], keysA[idxA] * 10)
    idxA = idxA + 1
}

hB = -1
keysB = [15, 25, 35, 45, 5] // 5 nodes => binary 101 => B2, B0
idxB = 0
while (idxB < keysB.size()) {
    hB = insertBinomialNode(tc2Arena, hB, keysB[idxB], keysB[idxB] * 10)
    idxB = idxB + 1
}

if (getBinomialHeapTotalSize(tc2Arena, hA) != 7 or getBinomialHeapTotalSize(tc2Arena, hB) != 5) {
    tc2Pass = 0
}

// 7 + 5 = 12 nodes => binary 1100 => B3 (8) and B2 (4)
hUnion = unionBinomialHeaps(tc2Arena, hA, hB)

if (getBinomialHeapTotalSize(tc2Arena, hUnion) != 12) {
    tc2Pass = 0
}
if (verifyBinomialHeapInvariants(tc2Arena, hUnion) != 1) {
    tc2Pass = 0
}

// Verify degrees of roots are 2 and 3
degArr = []
bDeg = tc2Arena[2]
bSib = tc2Arena[5]
curU = hUnion
while (curU != -1) {
    degArr.push(bDeg[curU])
    curU = bSib[curU]
}

if (degArr.size() != 2 or degArr[0] != 2 or degArr[1] != 3) {
    tc2Pass = 0
}

expectedUnionSorted = [5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 60, 70]
uIdx = 0
while (uIdx < expectedUnionSorted.size()) {
    extU = extractMinBinomial(tc2Arena, hUnion)
    hUnion = extU[2]
    if (extU[0] != expectedUnionSorted[uIdx]) {
        tc2Pass = 0
    }
    uIdx = uIdx + 1
}

if (tc2Pass == 1) {
    print("  Heap A (7 nodes, B0+B1+B2) and Heap B (5 nodes, B0+B2) merged successfully")
    print("  Resulting union contains exactly 12 nodes with binary decomposition B2+B3")
    print("  All 12 elements extracted in perfect sorted order")
    print("  Test Case 2 Passed successfully")
} else {
    print("[FAIL] Test Case 2 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 3: DecreaseKey and Edge Cases
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 3: DecreaseKey and Edge Cases...")
tc3Pass = 1
tc3Arena = createBinomialHeapArena()

// Edge cases: empty heap
if (findMinBinomial(tc3Arena, -1)[0] != -1) {
    tc3Pass = 0
}
if (extractMinBinomial(tc3Arena, -1)[0] != -1) {
    tc3Pass = 0
}

// Single node
hSingle = insertBinomialNode(tc3Arena, -1, 42, 420)
if (getBinomialHeapTotalSize(tc3Arena, hSingle) != 1) {
    tc3Pass = 0
}
extS = extractMinBinomial(tc3Arena, hSingle)
if (extS[0] != 42 or extS[2] != -1) {
    tc3Pass = 0
}

// Decrease key
hDec = -1
nodeRef = -1
decKeys = [50, 60, 70, 80, 90]
dIdx = 0
while (dIdx < decKeys.size()) {
    newNode = allocBinomialNode(tc3Arena, decKeys[dIdx], dIdx)
    if (decKeys[dIdx] == 80) {
        nodeRef = newNode
    }
    hDec = unionBinomialHeaps(tc3Arena, hDec, newNode)
    dIdx = dIdx + 1
}

// Decrease key of nodeRef (80 -> 15)
resDec = decreaseKeyBinomial(tc3Arena, nodeRef, 15)
if (resDec != 1 or verifyBinomialHeapInvariants(tc3Arena, hDec) != 1) {
    tc3Pass = 0
}

minDec = findMinBinomial(tc3Arena, hDec)
if (minDec[0] != 15) {
    tc3Pass = 0
}

if (tc3Pass == 1) {
    print("  Empty and single-element boundaries handled safely")
    print("  decreaseKey bubbled up node from 80 to 15 correctly")
    print("  Invariants maintained after key reduction")
    print("  Test Case 3 Passed successfully")
} else {
    print("[FAIL] Test Case 3 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 4: Randomized Stress Simulation against Priority Queue Oracle
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 4: Randomized Stress Simulation against Priority Queue Oracle...")
tc4Arena = createBinomialHeapArena()

activeHeaps = [-1, -1, -1]
oracleLists = [[], [], []]

stressSeed = 135792468
stressOps = 200
stressOpI = 0
stressMismatches = 0
totalInserts = 0
totalExtracts = 0
totalUnions = 0

while (stressOpI < stressOps) {
    stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
    opType = stressSeed % 3

    if (opType == 0) {
        stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
        targetQ = stressSeed % 3
        stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
        rKey = (stressSeed % 3000) - 1000
        rVal = rKey * 2

        activeHeaps[targetQ] = insertBinomialNode(tc4Arena, activeHeaps[targetQ], rKey, rVal)
        oracleLists[targetQ].push(rKey)
        totalInserts = totalInserts + 1
    }

    if (opType == 1) {
        stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
        targetQ = stressSeed % 3
        curH = activeHeaps[targetQ]

        if (curH != -1) {
            extRes = extractMinBinomial(tc4Arena, curH)
            hMin = extRes[0]
            activeHeaps[targetQ] = extRes[2]

            oList = oracleLists[targetQ]
            minIdx = 0
            bestMin = oList[0]
            sI = 1
            while (sI < oList.size()) {
                if (oList[sI] < bestMin) {
                    bestMin = oList[sI]
                    minIdx = sI
                }
                sI = sI + 1
            }

            newOList = []
            sJ = 0
            while (sJ < oList.size()) {
                if (sJ != minIdx) {
                    newOList.push(oList[sJ])
                }
                sJ = sJ + 1
            }
            oracleLists[targetQ] = newOList

            if (hMin != bestMin) {
                print("[FAIL] Mismatch: heapMin=", hMin, ", oracleMin=", bestMin)
                stressMismatches = stressMismatches + 1
            }
            totalExtracts = totalExtracts + 1
        }
    }

    if (opType == 2) {
        stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
        hIdxA = stressSeed % 3
        hIdxB = (hIdxA + 1 + (stressSeed % 2)) % 3

        if (activeHeaps[hIdxB] != -1) {
            activeHeaps[hIdxA] = unionBinomialHeaps(tc4Arena, activeHeaps[hIdxA], activeHeaps[hIdxB])
            activeHeaps[hIdxB] = -1

            listA = oracleLists[hIdxA]
            listB = oracleLists[hIdxB]
            cI = 0
            while (cI < listB.size()) {
                listA.push(listB[cI])
                cI = cI + 1
            }
            oracleLists[hIdxA] = listA
            oracleLists[hIdxB] = []
            totalUnions = totalUnions + 1
        }
    }

    stressOpI = stressOpI + 1
}

// Drain remaining elements
qScan = 0
while (qScan < 3) {
    remH = activeHeaps[qScan]
    remO = oracleLists[qScan]

    while (remH != -1) {
        finInfo = extractMinBinomial(tc4Arena, remH)
        finKey = finInfo[0]
        remH = finInfo[2]

        mIdx = 0
        bMin = remO[0]
        fI = 1
        while (fI < remO.size()) {
            if (remO[fI] < bMin) {
                bMin = remO[fI]
                mIdx = fI
            }
            fI = fI + 1
        }

        freshO = []
        fJ = 0
        while (fJ < remO.size()) {
            if (fJ != mIdx) {
                freshO.push(remO[fJ])
            }
            fJ = fJ + 1
        }
        remO = freshO

        if (finKey != bMin) {
            print("[FAIL] Drain mismatch on queue", qScan, ": heap=", finKey, ", oracle=", bMin)
            stressMismatches = stressMismatches + 1
        }
    }
    qScan = qScan + 1
}

if (stressMismatches == 0) {
    print("  Executed", stressOps, "randomized ops (", totalInserts, "inserts,", totalExtracts, "extracts,", totalUnions, "unions): 0 mismatches")
    print("  Test Case 4 Passed randomized stress benchmark")
} else {
    print("[FAIL] Stress benchmark encountered", stressMismatches, "mismatches")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] Binomial Heap Forest Suite executed successfully in", elapsed, "ms")
