// --- Test Case 1: Exhaustive 100-Branch Linear Sweep and Boundary Conditions ---

print("--- Running Test Case 1: Exhaustive 100-Branch Linear Sweep ---")

sweepKey = 1
accumulatedState = 42
while (sweepKey <= 100) {
    res = dispatchFlatLadder100(sweepKey, accumulatedState)
    expected = computeExpectedBranchValue(sweepKey, accumulatedState)
    if (res != expected) {
        print("[FAIL] Test Case 1 Branch ", sweepKey, " mismatch: expected ", expected, " got ", res)
        testSuiteFailures = testSuiteFailures + 1
    }
    accumulatedState = (accumulatedState + res) % 1000000007
    sweepKey = sweepKey + 1
}

// Verify every branch 1..100 was hit exactly once
verifyBranchIdx = 1
while (verifyBranchIdx <= 100) {
    if (branchHitCount[verifyBranchIdx] != 1) {
        print("[FAIL] Test Case 1 Branch hit count mismatch for key ", verifyBranchIdx, ": expected 1, got ", branchHitCount[verifyBranchIdx])
        testSuiteFailures = testSuiteFailures + 1
    }
    verifyBranchIdx = verifyBranchIdx + 1
}

// Boundary & Fallthrough Cases: Below range, negative, above range
fallthroughKeys = [0, -1, -50, -999, 101, 102, 250, 99999]
fIdx = 0
fCount = fallthroughKeys.size()
while (fIdx < fCount) {
    fKey = fallthroughKeys[fIdx]
    fRes = dispatchFlatLadder100(fKey, 100)
    fExpected = computeExpectedBranchValue(fKey, 100)
    if (fRes != fExpected) {
        print("[FAIL] Test Case 1 Fallthrough failed for key ", fKey, ": expected ", fExpected, " got ", fRes)
        testSuiteFailures = testSuiteFailures + 1
    }
    fIdx = fIdx + 1
}

if (branchHitCount[0] != fCount) {
    print("[FAIL] Test Case 1 Default branch hit count mismatch: expected ", fCount, " got ", branchHitCount[0])
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 1 Passed Exhaustive 100-Branch Linear Sweep and Boundary Conditions (100 branch hits, ", fCount, " fallthroughs)")

// --- Summary Telemetry ---

elapsed = t.millis() - suiteStartTime
if (testSuiteFailures == 0) {
    print("[PASS] Initial Stage 1 Passed in ", elapsed, " ms")
} else {
    print("[FAIL] Initial Stage 1 encountered ", testSuiteFailures, " failures")
}
