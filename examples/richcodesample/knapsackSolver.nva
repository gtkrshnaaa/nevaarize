import stdlib time as t

// 0/1 Knapsack Problem Solver
// Classic dynamic programming with flat 2D array.
// Demonstrates DP table construction, optimal value computation,
// and item backtracking for solution reconstruction.

func knapsack(weights, values, n, capacity) {
    // DP table: (n+1) x (capacity+1) flat array
    rows = n + 1
    cols = capacity + 1
    dp = []
    total = rows * cols
    idx = 0
    while (idx < total) {
        dp.push(0)
        idx = idx + 1
    }

    // Fill DP table
    i = 1
    while (i <= n) {
        w = 0
        while (w <= capacity) {
            // Exclude current item
            exclude = dp[(i - 1) * cols + w]

            if (weights[i - 1] <= w) {
                // Include current item
                include = values[i - 1] + dp[(i - 1) * cols + (w - weights[i - 1])]
                if (include > exclude) {
                    dp[i * cols + w] = include
                } else {
                    dp[i * cols + w] = exclude
                }
            } else {
                dp[i * cols + w] = exclude
            }
            w = w + 1
        }
        i = i + 1
    }

    return dp
}

func backtrackItems(dp, weights, values, n, capacity) {
    cols = capacity + 1
    selected = []
    totalSelected = 0

    i = n
    w = capacity
    while (i > 0 and w > 0) {
        if (dp[i * cols + w] != dp[(i - 1) * cols + w]) {
            selected.push(i - 1)
            totalSelected = totalSelected + 1
            w = w - weights[i - 1]
        }
        i = i - 1
    }

    return selected
}

// Main Execution
print("=== Nevaarize 0/1 Knapsack Solver ===")

// Standard test case
weights = [2, 3, 4, 5]
values =  [3, 4, 5, 6]
n = 4
capacity = 8

print("Items (weight, value):")
i = 0
while (i < n) {
    print("  Item", i, ": weight =", weights[i], ", value =", values[i])
    i = i + 1
}
print("Knapsack capacity:", capacity)

start = t.millis()
dp = knapsack(weights, values, n, capacity)
cols = capacity + 1
optimalValue = dp[n * cols + capacity]
selected = backtrackItems(dp, weights, values, n, capacity)
elapsed = t.millis() - start

print("Optimal value:", optimalValue)
print("Selected items:", selected.size())
for (idx in selected) {
    print("  -> Item", idx, "(w:", weights[idx], ", v:", values[idx], ")")
}
print("Time:", elapsed, "ms")

// Edge case: capacity = 0
print("\n--- Edge Case: Zero Capacity ---")
dp0 = knapsack(weights, values, n, 0)
print("Optimal value with 0 capacity:", dp0[n * 1 + 0], "(expected: 0)")

// Edge case: single item that fits
print("\n--- Edge Case: Single Item ---")
sw = [3]
sv = [10]
dpSingle = knapsack(sw, sv, 1, 5)
print("Single item (w=3, v=10), cap=5:", dpSingle[1 * 6 + 5], "(expected: 10)")

// Edge case: single item too heavy
print("\n--- Edge Case: Item Too Heavy ---")
dpHeavy = knapsack(sw, sv, 1, 2)
print("Single item (w=3, v=10), cap=2:", dpHeavy[1 * 3 + 2], "(expected: 0)")

// Edge case: all items fit
print("\n--- Edge Case: All Items Fit ---")
allW = [1, 1, 1]
allV = [5, 5, 5]
dpAll = knapsack(allW, allV, 3, 10)
print("All fit (w=1+1+1, cap=10):", dpAll[3 * 11 + 10], "(expected: 15)")

print("\nKnapsack solver finished.")
