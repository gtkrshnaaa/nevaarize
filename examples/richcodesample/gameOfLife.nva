import stdlib math as m
import stdlib time as t

// Conway's Game of Life
// Uses flat 1D array representation for JIT compatibility

function createGrid(w, h) {
    cells = []
    total = w * h
    i = 0
    while (i < total) {
        cells.push(0)
        i = i + 1
    }
    return cells
}

function getCell(cells, w, x, y) {
    return cells[y * w + x]
}

function setCell(cells, w, x, y, val) {
    cells[y * w + x] = val
}

function countNeighbors(cells, w, h, x, y) {
    count = 0
    dy = -1
    while (dy <= 1) {
        dx = -1
        while (dx <= 1) {
            if (dx != 0 or dy != 0) {
                nx = x + dx
                ny = y + dy
                if (nx >= 0 and nx < w and ny >= 0 and ny < h) {
                    count = count + cells[ny * w + nx]
                }
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    return count
}

function tick(cells, w, h) {
    newCells = createGrid(w, h)
    y = 0
    while (y < h) {
        x = 0
        while (x < w) {
            alive = cells[y * w + x]
            neighbors = countNeighbors(cells, w, h, x, y)
            if (alive == 1) {
                if (neighbors == 2 or neighbors == 3) {
                    newCells[y * w + x] = 1
                }
            } else {
                if (neighbors == 3) {
                    newCells[y * w + x] = 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    return newCells
}

function countAlive(cells, total) {
    count = 0
    i = 0
    while (i < total) {
        count = count + cells[i]
        i = i + 1
    }
    return count
}

// Main Execution
print("=== Nevaarize Game of Life Demo ===")
width = 10
height = 10
cells = createGrid(width, height)

// Glider pattern
setCell(cells, width, 2, 1, 1)
setCell(cells, width, 3, 2, 1)
setCell(cells, width, 1, 3, 1)
setCell(cells, width, 2, 3, 1)
setCell(cells, width, 3, 3, 1)

print("Generation 0 - Alive:", countAlive(cells, width * height))

gen = 1
while (gen <= 5) {
    start = t.micros()
    cells = tick(cells, width, height)
    elapsed = t.micros() - start
    alive = countAlive(cells, width * height)
    print("Generation", gen, "- Alive:", alive, "- Time:", elapsed, "us")
    gen = gen + 1
}

print("Game of Life demo finished.")
