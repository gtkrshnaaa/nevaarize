    2, 0,
    2, 3,
    3, 4,
    4, 5,
    5, 3,
    5, 6,
    6, 7,
    7, 6
]
expSizes1 = [3, 3, 2]
if (!runTarjanTestCase(1, "Textbook 8-Node 3-SCC Benchmark", 8, edges1, 3, expSizes1)) {
    allTarjanPassed = false
}

// --- Test Case 2: Pure Directed Acyclic Graph (6 Nodes) ---
