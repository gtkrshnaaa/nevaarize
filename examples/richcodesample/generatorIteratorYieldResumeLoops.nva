    print("[FAIL] Test Case 4.1 pair 5 left expected 5, got ", pairFive[0])
    testSuiteFailures = testSuiteFailures + 1
}
if (pairFive[1] != 15) {
    print("[FAIL] Test Case 4.1 pair 5 right expected 15, got ", pairFive[1])
    testSuiteFailures = testSuiteFailures + 1
}

pairSeven = zipPairs[7]
if (pairSeven[0] != 13) {
    print("[FAIL] Test Case 4.1 pair 7 left expected 13, got ", pairSeven[0])
    testSuiteFailures = testSuiteFailures + 1
}
if (pairSeven[1] != 17) {
    print("[FAIL] Test Case 4.1 pair 7 right expected 17, got ", pairSeven[1])
    testSuiteFailures = testSuiteFailures + 1
}

// Subtest 4.2: Merge sorted streams
genMul3 = createGenerator(genTypeRange, 3, 18, 3, 0, 0, 0, 0)
genMul5 = createGenerator(genTypeRange, 5, 26, 5, 0, 0, 0, 0)
initMergeA = getGeneratorYieldCount(genMul3)
initMergeB = getGeneratorYieldCount(genMul5)
mergedList = mergeSortedGenerators(genMul3, genMul5, 50)
mergedCount = (getGeneratorYieldCount(genMul3) - initMergeA) + (getGeneratorYieldCount(genMul5) - initMergeB)

if (mergedCount != 10) {
    print("[FAIL] Test Case 4.2 merge count expected 10, got ", mergedCount)
    testSuiteFailures = testSuiteFailures + 1
}

if (mergedList[0] != 3) {
    print("[FAIL] Test Case 4.2 first item expected 3, got ", mergedList[0])
    testSuiteFailures = testSuiteFailures + 1
}

if (mergedList[9] != 25) {
    print("[FAIL] Test Case 4.2 last item expected 25, got ", mergedList[9])
    testSuiteFailures = testSuiteFailures + 1
}

sortedViolations = 0
checkIdx = 1
while (checkIdx < mergedCount) {
    prevVal = mergedList[checkIdx - 1]
    currVal = mergedList[checkIdx]
    if (currVal < prevVal) {
        sortedViolations = sortedViolations + 1
    }
    checkIdx = checkIdx + 1
}

if (sortedViolations != 0) {
    print("[FAIL] Test Case 4.2 merged stream is not monotonically sorted, violations: ", sortedViolations)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 4 Passed interleaved ping-pong co-routine pipeline (zip and sorted merge)")

// --- Test Case 5: Hierarchical Sub-Generator Delegation (yield from) ---

print("--- Running Test Case 5: Hierarchical Sub-Generator Delegation (yield from) ---")

// compId 1 delegates through 3 segments: [1, 4, 1], [10, 40, 10], [100, 300, 100]
delegator = createGenerator(genTypeDelegator, 1, 0, 3, 0, 0, 0, 0)
initDel = getGeneratorYieldCount(delegator)
delValues = drainGenerator(delegator, 50)
delCount = getGeneratorYieldCount(delegator) - initDel

if (delCount != 8) {
    print("[FAIL] Test Case 5 delegator count expected 8, got ", delCount)
    testSuiteFailures = testSuiteFailures + 1
}

if (delValues[0] != 1) {
    print("[FAIL] Test Case 5 item 0 expected 1, got ", delValues[0])
    testSuiteFailures = testSuiteFailures + 1
}

if (delValues[2] != 3) {
    print("[FAIL] Test Case 5 item 2 expected 3, got ", delValues[2])
    testSuiteFailures = testSuiteFailures + 1
}

if (delValues[3] != 10) {
    print("[FAIL] Test Case 5 item 3 expected 10, got ", delValues[3])
    testSuiteFailures = testSuiteFailures + 1
}

if (delValues[5] != 30) {
    print("[FAIL] Test Case 5 item 5 expected 30, got ", delValues[5])
    testSuiteFailures = testSuiteFailures + 1
}

if (delValues[6] != 100) {
    print("[FAIL] Test Case 5 item 6 expected 100, got ", delValues[6])
    testSuiteFailures = testSuiteFailures + 1
}

if (delValues[7] != 200) {
    print("[FAIL] Test Case 5 item 7 expected 200, got ", delValues[7])
    testSuiteFailures = testSuiteFailures + 1
}

if (isGeneratorDone(delegator) != true) {
    print("[FAIL] Test Case 5 delegator should be completed")
    testSuiteFailures = testSuiteFailures + 1
}

if (getGeneratorYieldCount(delegator) != 8) {
    print("[FAIL] Test Case 5 delegator yieldCount expected 8, got ", getGeneratorYieldCount(delegator))
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 5 Passed hierarchical sub-generator delegation (yield from) with stack frames")

// --- Test Case 6: Infinite / Stateful Collatz Trajectory with Windowing (Take & Skip) ---

print("--- Running Test Case 6: Infinite / Stateful Collatz Trajectory with Windowing (Take & Skip) ---")

collatzGen = createGenerator(genTypeCollatz, 27, 200, 0, 0, 0, 0, 0)

// Take first 10 steps of seed 27:
// 27 is odd: 3*27 + 1 = 82
// 82 / 2 = 41
// 3*41 + 1 = 124
// 124 / 2 = 62
// 62 / 2 = 31
// 3*31 + 1 = 94
// 94 / 2 = 47
// 3*47 + 1 = 142
// 142 / 2 = 71
// 3*71 + 1 = 214
// Yielded sequence starts with: 27, 82, 41, 124, 62, 31, 94, 47, 142, 71
takeTen = takeGenerator(collatzGen, 10)

if (takeTen[0] != 27) {
    print("[FAIL] Test Case 6 take 0 expected 27, got ", takeTen[0])
    testSuiteFailures = testSuiteFailures + 1
}

if (takeTen[1] != 82) {
    print("[FAIL] Test Case 6 take 1 expected 82, got ", takeTen[1])
    testSuiteFailures = testSuiteFailures + 1
}

if (takeTen[2] != 41) {
    print("[FAIL] Test Case 6 take 2 expected 41, got ", takeTen[2])
    testSuiteFailures = testSuiteFailures + 1
}

if (takeTen[9] != 71) {
    print("[FAIL] Test Case 6 take 9 expected 71, got ", takeTen[9])
    testSuiteFailures = testSuiteFailures + 1
}

// Skip next 5 elements: 214, 107, 322, 161, 484
skipped = skipGenerator(collatzGen, 5)
if (skipped != 5) {
    print("[FAIL] Test Case 6 skip expected 5, got ", skipped)
    testSuiteFailures = testSuiteFailures + 1
}

// Next element should be 242 (from 484 / 2)
nextStepRes = stepGenerator(collatzGen)
if (nextStepRes != 1) {
    print("[FAIL] Test Case 6 step after skip failed")
    testSuiteFailures = testSuiteFailures + 1
}

if (getGeneratorValue(collatzGen) != 242) {
    print("[FAIL] Test Case 6 value after skip expected 242, got ", getGeneratorValue(collatzGen))
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 6 Passed Collatz trajectory state machine with take and skip windowing")

// --- Test Case 7: Extreme VM Limit Stress Benchmark (100,000+ Steps) ---

print("--- Running Test Case 7: Extreme VM Limit Stress Benchmark (100,000+ Steps) ---")

stressBenchmarkStart = t.millis()

stressStepLimit = 100000
stressGen = createGenerator(genTypeRange, 0, stressStepLimit, 1, 0, 0, 0, 0)
stressAccumulator = 0
stressStepCount = 0
stressHasMore = 1

while (stressHasMore == 1) {
    stepResult = stepGenerator(stressGen)
    if (stepResult == 1) {
        stressAccumulator = stressAccumulator + getGeneratorValue(stressGen)
        stressStepCount = stressStepCount + 1
    } else {
        stressHasMore = 0
    }
}

expectedStressSum = 4999950000
if (stressAccumulator != expectedStressSum) {
    print("[FAIL] Test Case 7 extreme stress sum expected 4999950000, got ", stressAccumulator)
    testSuiteFailures = testSuiteFailures + 1
}

if (stressStepCount != stressStepLimit) {
    print("[FAIL] Test Case 7 step count expected 100000, got ", stressStepCount)
    testSuiteFailures = testSuiteFailures + 1
}

if (getGeneratorYieldCount(stressGen) != stressStepLimit) {
    print("[FAIL] Test Case 7 yieldCount expected 100000, got ", getGeneratorYieldCount(stressGen))
    testSuiteFailures = testSuiteFailures + 1
}

if (getGeneratorStepCount(stressGen) != (stressStepLimit + 1)) {
    print("[FAIL] Test Case 7 stepCount expected 100001, got ", getGeneratorStepCount(stressGen))
    testSuiteFailures = testSuiteFailures + 1
}

if (isGeneratorDone(stressGen) != true) {
    print("[FAIL] Test Case 7 stressGen should be completed")
    testSuiteFailures = testSuiteFailures + 1
}

stressBenchmarkDuration = t.millis() - stressBenchmarkStart
print("  Test Case 7 Passed extreme VM limit benchmark (100,000 steps in ", stressBenchmarkDuration, " ms with O(1) stack frames)")

// --- Benchmark Timings and Final Assertion ---

suiteElapsedTime = t.millis() - suiteStartTime

if (testSuiteFailures == 0) {
    print("[PASS] Generator Iterator State Machine Suite executed successfully in ", suiteElapsedTime, " ms")
} else {
    print("[FAIL] Suite encountered ", testSuiteFailures, " failures")
}
