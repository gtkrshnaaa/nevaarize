import stdlib time as t

// Generator and Iterator State Machine Suite with Complex Loop Resumption
// Technical characteristics:
// - Explicit stackless generator state machine yielding and resuming across complex loops
// - Program counter (pc) driven resumption architecture supporting multi-yield cycles
// - Preserves multi-dimensional loop counters across yields in nested grid and tensor traversals
// - Bi-directional co-routine zip and merge pipelines interleaving independent generators
// - Sub-generator delegation (yield from) with explicit call frame stack management
// - Infinite sequence generation with dynamic windowing and zero memory leakage
// - High-throughput stress benchmark executing 100,000+ yield-resume transitions in O(1) stack frames
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero external dependencies, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Generator Iterator State Machine Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Generator Status and Type Constants ---

statusCreated = 0
statusRunning = 1
statusSuspendedYield = 2
statusCompleted = 3

genTypeRange = 1
genTypeMultiPhase = 2
genTypeGrid2D = 3
genTypeTensor3D = 4
genTypeFibonacci = 5
genTypeDelegator = 6
genTypeCollatz = 7

// --- Core Generator Construction and Access Primitives ---
// Generator layout:
// [0]: status (0: created, 1: running, 2: suspendedYield, 3: completed)
// [1]: pc (program counter / resume step index)
// [2]: genType (generator type identifier)
// [3]: r0 (general register 0: loop variable or current value)
// [4]: r1 (general register 1: limit or upper bound)
// [5]: r2 (general register 2: step size or parameter)
// [6]: r3 (general register 3: secondary loop variable or filter flag)
// [7]: r4 (general register 4: tertiary loop variable or inner state)
// [8]: r5 (general register 5: extra state or accumulator)
// [9]: r6 (general register 6: flag or extra status)
// [10]: currentValue (last yielded value)
// [11]: done (0: false, 1: true)
// [12]: yieldCount (total number of yields emitted)
// [13]: stepCount (total number of step/resume invocations)

func createGenerator(genType, r0, r1, r2, r3, r4, r5, r6) {
    return [statusCreated, 0, genType, r0, r1, r2, r3, r4, r5, r6, 0, 0, 0, 0]
}

func isGeneratorDone(gen) {
    if (gen[11] == 1) {
        return true
    }
    return false
}

func getGeneratorValue(gen) {
    return gen[10]
}

func getGeneratorYieldCount(gen) {
    return gen[12]
}

func getGeneratorStepCount(gen) {
    return gen[13]
}

// --- Multi-Segment Delegation Registry ---

func getDelegatorSegment(compId, segIdx) {
    if (compId == 1) {
        if (segIdx == 0) {
            return [1, 4, 1]
        }
        if (segIdx == 1) {
            return [10, 40, 10]
        }
        if (segIdx == 2) {
            return [100, 300, 100]
        }
    }
    return [0, 0, 1]
}

// --- Generator Step Dispatch Engine ---

func stepRange(gen) {
    // r0: current, r1: stop, r2: step, r3: filterMode (0: all, 1: evenOnly, 2: oddOnly)
    curr = gen[3]
    stop = gen[4]
    stepVal = gen[5]
    filterMode = gen[6]

    keepLooping = 1
    while (keepLooping == 1) {
        if (curr >= stop) {
            gen[0] = statusCompleted
            gen[11] = 1
            gen[1] = 99
            return 0
        }

        meetsFilter = 1
        if (filterMode == 1) {
            // Even numbers only
            modTwo = curr - ((curr / 2) * 2)
            if (modTwo != 0) {
                meetsFilter = 0
            }
        } elif (filterMode == 2) {
            // Odd numbers only
            modTwo = curr - ((curr / 2) * 2)
            if (modTwo == 0) {
                meetsFilter = 0
            }
        }

        nextCurr = curr + stepVal
        gen[3] = nextCurr

        if (meetsFilter == 1) {
            gen[0] = statusSuspendedYield
            gen[1] = 1
            gen[10] = curr
            gen[12] = gen[12] + 1
            return 1
        }

        curr = nextCurr
    }

    return 0
}

func stepMultiPhase(gen) {
    // r0: current batch k
    // r1: total batches maxK
    // pc: 0 (phase 1 header), 1 (phase 2 payload), 2 (phase 3 checksum)
    k = gen[3]
    maxK = gen[4]
    currentPc = gen[1]

    if (k > maxK) {
        gen[0] = statusCompleted
        gen[11] = 1
        return 0
    }

    if (currentPc == 0) {
        headerVal = (k * 1000) + 1
        gen[0] = statusSuspendedYield
        gen[1] = 1
        gen[10] = headerVal
        gen[12] = gen[12] + 1
        return 1
    } elif (currentPc == 1) {
        payloadVal = (k * 1000) + 2
        gen[0] = statusSuspendedYield
        gen[1] = 2
        gen[10] = payloadVal
        gen[12] = gen[12] + 1
        return 1
    } elif (currentPc == 2) {
        payloadVal = (k * 1000) + 2
        checksumVal = (payloadVal * 7) + 3
        gen[0] = statusSuspendedYield
        gen[3] = k + 1
        gen[1] = 0
        gen[10] = checksumVal
        gen[12] = gen[12] + 1
        return 1
    }

    gen[0] = statusCompleted
    gen[11] = 1
    return 0
}

func stepGrid2D(gen) {
    // r0: currentRow, r1: maxRows, r2: currentCol, r3: maxCols
    row = gen[3]
    maxRows = gen[4]
    col = gen[5]
    maxCols = gen[6]

    if (row >= maxRows) {
        gen[0] = statusCompleted
        gen[11] = 1
        return 0
    }

    cellVal = (row * 100) + col

    nextCol = col + 1
    nextRow = row
    if (nextCol >= maxCols) {
        nextCol = 0
        nextRow = row + 1
    }

    gen[3] = nextRow
    gen[5] = nextCol
    gen[0] = statusSuspendedYield
    gen[1] = 1
    gen[10] = cellVal
    gen[12] = gen[12] + 1
    return 1
}

func stepTensor3D(gen) {
    // r0: curD, r1: maxD, r2: curR, r3: maxR, r4: curC, r5: maxC
    curD = gen[3]
    maxD = gen[4]
    curR = gen[5]
    maxR = gen[6]
    curC = gen[7]
    maxC = gen[8]

    if (curD >= maxD) {
        gen[0] = statusCompleted
        gen[11] = 1
        return 0
    }

    tensorVal = (curD * 10000) + (curR * 100) + curC

    nextC = curC + 1
    nextR = curR
    nextD = curD

    if (nextC >= maxC) {
        nextC = 0
        nextR = curR + 1
        if (nextR >= maxR) {
            nextR = 0
            nextD = curD + 1
        }
    }

    gen[3] = nextD
    gen[5] = nextR
    gen[7] = nextC
    gen[0] = statusSuspendedYield
    gen[1] = 1
    gen[10] = tensorVal
    gen[12] = gen[12] + 1
    return 1
}

func stepFibonacci(gen) {
    // r0: a, r1: b, r2: currentCount, r3: maxCount
    fibA = gen[3]
    fibB = gen[4]
    currentCount = gen[5]
    maxCount = gen[6]

    if (currentCount >= maxCount) {
        gen[0] = statusCompleted
        gen[11] = 1
        return 0
    }

    nextA = fibB
    nextB = fibA + fibB
    gen[3] = nextA
    gen[4] = nextB
    gen[5] = currentCount + 1

    gen[0] = statusSuspendedYield
    gen[1] = 1
    gen[10] = fibA
    gen[12] = gen[12] + 1
    return 1
}

func stepDelegator(gen) {
    // r0: compId, r1: segIdx, r2: totalSegs, r3: curr, r4: stop, r5: stepVal, r6: isInit
    compId = gen[3]
    segIdx = gen[4]
    totalSegs = gen[5]
    curr = gen[6]
    stop = gen[7]
    stepVal = gen[8]
    isInit = gen[9]

    keepSearching = 1
    while (keepSearching == 1) {
        if (isInit == 0) {
            if (segIdx >= totalSegs) {
                gen[0] = statusCompleted
                gen[11] = 1
                return 0
            }
            seg = getDelegatorSegment(compId, segIdx)
            curr = seg[0]
            stop = seg[1]
            stepVal = seg[2]
            isInit = 1
        }

        if (curr >= stop) {
            segIdx = segIdx + 1
            isInit = 0
        } else {
            yieldedVal = curr
            nextCurr = curr + stepVal

            gen[4] = segIdx
            gen[6] = nextCurr
            gen[7] = stop
            gen[8] = stepVal
            gen[9] = 1

            gen[0] = statusSuspendedYield
            gen[1] = 1
            gen[10] = yieldedVal
            gen[12] = gen[12] + 1
            return 1
        }
    }

    return 0
}

func stepCollatz(gen) {
    currentN = gen[3]
    stepLimit = gen[4]
    stepCounter = gen[5]

    if (stepCounter >= stepLimit) {
        gen[0] = statusCompleted
        gen[11] = 1
        return 0
    }

    if (currentN <= 1) {
        gen[0] = statusCompleted
        gen[11] = 1
        return 0
    }

    modTwo = currentN - ((currentN / 2) * 2)
    nextN = 0
    if (modTwo == 0) {
        nextN = currentN / 2
    } else {
        nextN = (3 * currentN) + 1
    }

    gen[3] = nextN
    gen[5] = stepCounter + 1
    gen[0] = statusSuspendedYield
    gen[1] = 1
    gen[10] = currentN
    gen[12] = gen[12] + 1
    return 1
}

func stepGenerator(gen) {
    if (gen[11] == 1) {
        return 0
    }

    gen[13] = gen[13] + 1
    gen[0] = statusRunning

    targetType = gen[2]
    if (targetType == 1) {
        return stepRange(gen)
    } elif (targetType == 2) {
        return stepMultiPhase(gen)
    } elif (targetType == 3) {
        return stepGrid2D(gen)
    } elif (targetType == 4) {
        return stepTensor3D(gen)
    } elif (targetType == 5) {
        return stepFibonacci(gen)
    } elif (targetType == 6) {
        return stepDelegator(gen)
    } elif (targetType == 7) {
        return stepCollatz(gen)
    }

    gen[0] = statusCompleted
    gen[11] = 1
    return 0
}

func drainGenerator(gen, maxItems) {
    collected = []
    hasMore = 1
    itemsCount = 0

    while (hasMore == 1) {
        if (itemsCount >= maxItems) {
            hasMore = 0
        } else {
            stepRes = stepGenerator(gen)
            if (stepRes == 1) {
                collected.push(getGeneratorValue(gen))
                itemsCount = itemsCount + 1
            } else {
                hasMore = 0
            }
        }
    }

    return collected
}

func zipGenerators(genA, genB, maxPairs) {
    pairs = []
    pairsCount = 0
    continueZipping = 1

    while (continueZipping == 1) {
        if (pairsCount >= maxPairs) {
            continueZipping = 0
        } else {
            stepA = stepGenerator(genA)
            stepB = stepGenerator(genB)
            if (stepA == 1) {
                if (stepB == 1) {
                    valA = getGeneratorValue(genA)
                    valB = getGeneratorValue(genB)
                    pairs.push([valA, valB])
                    pairsCount = pairsCount + 1
                } else {
                    continueZipping = 0
                }
            } else {
                continueZipping = 0
            }
        }
    }

    return pairs
}

func mergeSortedGenerators(genA, genB, maxItems) {
    merged = []
    mergedCount = 0

    hasA = stepGenerator(genA)
    hasB = stepGenerator(genB)
    valA = 0
    valB = 0
    if (hasA == 1) {
        valA = getGeneratorValue(genA)
    }
    if (hasB == 1) {
        valB = getGeneratorValue(genB)
    }

    keepMerging = 1
    while (keepMerging == 1) {
        if (mergedCount >= maxItems) {
            keepMerging = 0
        } elif (hasA == 0) {
            if (hasB == 0) {
                keepMerging = 0
            } else {
                merged.push(valB)
                mergedCount = mergedCount + 1
                hasB = stepGenerator(genB)
                if (hasB == 1) {
                    valB = getGeneratorValue(genB)
                }
            }
        } elif (hasB == 0) {
            merged.push(valA)
            mergedCount = mergedCount + 1
            hasA = stepGenerator(genA)
            if (hasA == 1) {
                valA = getGeneratorValue(genA)
            }
        } else {
            if (valA <= valB) {
                merged.push(valA)
                mergedCount = mergedCount + 1
                hasA = stepGenerator(genA)
                if (hasA == 1) {
                    valA = getGeneratorValue(genA)
                }
            } else {
                merged.push(valB)
                mergedCount = mergedCount + 1
                hasB = stepGenerator(genB)
                if (hasB == 1) {
                    valB = getGeneratorValue(genB)
                }
            }
        }
    }

    return merged
}

func takeGenerator(gen, count) {
    taken = []
    takenCount = 0
    keepTaking = 1

    while (keepTaking == 1) {
        if (takenCount >= count) {
            keepTaking = 0
        } else {
            stepRes = stepGenerator(gen)
            if (stepRes == 1) {
                taken.push(getGeneratorValue(gen))
                takenCount = takenCount + 1
            } else {
                keepTaking = 0
            }
        }
    }

    return taken
}

func skipGenerator(gen, count) {
    skippedCount = 0
    keepSkipping = 1

    while (keepSkipping == 1) {
        if (skippedCount >= count) {
            keepSkipping = 0
        } else {
            stepRes = stepGenerator(gen)
            if (stepRes == 1) {
                skippedCount = skippedCount + 1
            } else {
                keepSkipping = 0
            }
        }
    }

    return skippedCount
}

// --- Test Case 1: Linear Bounded Range Generator with Step and Parity Filter ---

print("--- Running Test Case 1: Linear Bounded Range Generator with Step and Parity Filter ---")

// Subtest 1.1: Range from 10 to 25 with step 3
rangeGenA = createGenerator(genTypeRange, 10, 25, 3, 0, 0, 0, 0)
initA = getGeneratorYieldCount(rangeGenA)
valuesA = drainGenerator(rangeGenA, 100)
countA = getGeneratorYieldCount(rangeGenA) - initA

expectedLengthA = 5
if (countA != expectedLengthA) {
    print("[FAIL] Test Case 1.1 length mismatch: expected ", expectedLengthA, ", got ", countA)
    testSuiteFailures = testSuiteFailures + 1
}

if (valuesA[0] != 10) {
    print("[FAIL] Test Case 1.1 first item mismatch: expected 10, got ", valuesA[0])
    testSuiteFailures = testSuiteFailures + 1
}

if (valuesA[4] != 22) {
    print("[FAIL] Test Case 1.1 last item mismatch: expected 22, got ", valuesA[4])
    testSuiteFailures = testSuiteFailures + 1
}

if (isGeneratorDone(rangeGenA) != true) {
    print("[FAIL] Test Case 1.1 generator should be done")
    testSuiteFailures = testSuiteFailures + 1
}

if (getGeneratorYieldCount(rangeGenA) != 5) {
    print("[FAIL] Test Case 1.1 yieldCount mismatch: expected 5, got ", getGeneratorYieldCount(rangeGenA))
    testSuiteFailures = testSuiteFailures + 1
}

if (getGeneratorStepCount(rangeGenA) != 6) {
    print("[FAIL] Test Case 1.1 stepCount mismatch: expected 6, got ", getGeneratorStepCount(rangeGenA))
    testSuiteFailures = testSuiteFailures + 1
}

// Subtest 1.2: Range with even-only filter (0 to 20 with step 1, even numbers)
rangeGenEven = createGenerator(genTypeRange, 0, 20, 1, 1, 0, 0, 0)
initEven = getGeneratorYieldCount(rangeGenEven)
valuesEven = drainGenerator(rangeGenEven, 100)
countEven = getGeneratorYieldCount(rangeGenEven) - initEven

if (countEven != 10) {
    print("[FAIL] Test Case 1.2 even count mismatch: expected 10, got ", countEven)
    testSuiteFailures = testSuiteFailures + 1
}

sumEvens = 0
evenIdx = 0
while (evenIdx < countEven) {
    sumEvens = sumEvens + valuesEven[evenIdx]
    evenIdx = evenIdx + 1
}

expectedEvenSum = 90
if (sumEvens != expectedEvenSum) {
    print("[FAIL] Test Case 1.2 even sum mismatch: expected 90, got ", sumEvens)
    testSuiteFailures = testSuiteFailures + 1
}

// Subtest 1.3: Empty range boundary condition (start >= stop)
emptyGen = createGenerator(genTypeRange, 50, 50, 1, 0, 0, 0, 0)
initEmpty = getGeneratorYieldCount(emptyGen)
emptyValues = drainGenerator(emptyGen, 10)
countEmpty = getGeneratorYieldCount(emptyGen) - initEmpty

if (countEmpty != 0) {
    print("[FAIL] Test Case 1.3 empty range should yield 0 items, got ", countEmpty)
    testSuiteFailures = testSuiteFailures + 1
}

if (countEmpty > 0) {
    if (emptyValues[0] != 0) {
        testSuiteFailures = testSuiteFailures + 1
    }
}

if (isGeneratorDone(emptyGen) != true) {
    print("[FAIL] Test Case 1.3 empty generator should be immediately done")
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 1 Passed linear bounded range generator and parity filter state machine")

