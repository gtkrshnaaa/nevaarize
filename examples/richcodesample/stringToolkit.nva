import stdlib string as s
import stdlib time as t

// String Toolkit Demonstration
// Demonstrates string operations that return numeric values (JIT compatible)

func demonstrateStringInfo(text) {
    print("Original Text: Nevaarize is a high-performance JIT-compiled language.")
    
    // Numeric returns from string stdlib (safe in JIT)
    print("- Length:", s.length(text))
    print("- Contains 'Nevaarize':", s.contains(text, "Nevaarize"))
    print("- Contains 'Python':", s.contains(text, "Python"))
    print("- Index of 'high':", s.indexOf(text, "high"))
    print("- Index of 'JIT':", s.indexOf(text, "JIT"))
    print("- Starts with 'Nevaarize':", s.startsWith(text, "Nevaarize"))
    print("- Ends with 'language.':", s.endsWith(text, "language."))
}

func benchmarkStringOps(text, iterations) {
    print("Benchmarking", iterations, "string operations...")
    start = t.millis()
    
    total = 0
    i = 0
    while (i < iterations) {
        total = total + s.length(text)
        total = total + s.indexOf(text, "JIT")
        total = total + s.contains(text, "Nevaarize")
        i = i + 1
    }
    
    elapsed = t.millis() - start
    print("Completed", iterations, "iterations in", elapsed, "ms")
    print("Accumulated result:", total)
}

// Main Execution
print("=== Nevaarize String Toolkit Demo ===")

sampleText = "Nevaarize is a high-performance JIT-compiled language."
demonstrateStringInfo(sampleText)

// CSV field analysis (numeric only)
csvRow = "101, John Doe, Engineering, 95000.50"
print("\nCSV Row Analysis:")
print("- Full length:", s.length(csvRow))
print("- Contains comma:", s.contains(csvRow, ","))
print("- First comma at:", s.indexOf(csvRow, ","))

// Performance benchmark
print("")
benchmarkStringOps(sampleText, 5000)

print("\nString toolkit demo finished.")
