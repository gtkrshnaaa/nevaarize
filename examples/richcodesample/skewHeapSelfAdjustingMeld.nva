import stdlib time as t

// Ephemeral Meldable Skew Heap Priority Queue Suite
// Technical characteristics:
// - Self-adjusting meldable priority queue without balance or structural metadata
// - Unconditional child swap on every meld operation yielding O(log N) amortized complexity
// - Heap order invariant: key(parent) <= key(child) for every node
// - Subtree size tracking for O(1) size queries and tournament meld scheduling
// - Flat parallel array arena allocation for high cache locality and zero GC overhead
// - Multi-heap tournament meld for consolidating forests of priority queues
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)

print("=== Nevaarize Skew Heap Self-Adjusting Meld Suite ===")
suiteStartTime = t.millis()

func createSkewHeapArena() {
    hKey = []
    hVal = []
    hLeft = []
    hRight = []
    hSize = []
    return [hKey, hVal, hLeft, hRight, hSize]
}

func allocHeapNode(arena, key, val) {
    aKey = arena[0]
    aVal = arena[1]
    aLeft = arena[2]
    aRight = arena[3]
    aSize = arena[4]

    nodeId = aKey.size()
    aKey.push(key)
    aVal.push(val)
    aLeft.push(-1)
    aRight.push(-1)
    aSize.push(1)

    arena[0] = aKey
    arena[1] = aVal
    arena[2] = aLeft
    arena[3] = aRight
    arena[4] = aSize
    return nodeId
}

func getHeapSize(arena, root) {
    if (root == -1) {
        return 0
    }
    aSize = arena[4]
    return aSize[root]
}

func isEmptyHeap(root) {
    return root == -1
}

func findMin(arena, root) {
    if (root == -1) {
        return [-1, -1]
    }
    fKey = arena[0]
    fVal = arena[1]
    return [fKey[root], fVal[root]]
}

func meldSkewHeaps(arena, h1, h2) {
    if (h1 == -1) {
        return h2
    }
    if (h2 == -1) {
        return h1
    }

    mKey = arena[0]
    mLeft = arena[2]
    mRight = arena[3]
    mSize = arena[4]

    // Phase 1: Walk right spines comparing keys
    mPath = []
    p1 = h1
    p2 = h2
    while (p1 != -1 and p2 != -1) {
        if (mKey[p1] <= mKey[p2]) {
            mPath.push(p1)
            p1 = mRight[p1]
        } else {
            mPath.push(p2)
            p2 = mRight[p2]
        }
    }

    tailNode = -1
    if (p1 != -1) {
        tailNode = p1
    } else {
        tailNode = p2
    }

    // Phase 2: Bottom-up unconditional child swapping
    currNode = tailNode
    pIdx = mPath.size() - 1
    while (pIdx >= 0) {
        node = mPath[pIdx]
        prevLeft = mLeft[node]

        // Unconditional swap: melded right child becomes left, former left becomes right
        mLeft[node] = currNode
        mRight[node] = prevLeft

        newNodeSize = 1
        if (mLeft[node] != -1) {
            newNodeSize = newNodeSize + mSize[mLeft[node]]
        }
        if (mRight[node] != -1) {
            newNodeSize = newNodeSize + mSize[mRight[node]]
        }
        mSize[node] = newNodeSize

        currNode = node
        pIdx = pIdx - 1
    }

    arena[2] = mLeft
    arena[3] = mRight
    arena[4] = mSize
    return currNode
}

func insertHeapNode(arena, root, key, val) {
    newNode = allocHeapNode(arena, key, val)
    return meldSkewHeaps(arena, root, newNode)
}

func extractMin(arena, root) {
    if (root == -1) {
        return [-1, -1, -1]
    }
    eKey = arena[0]
    eVal = arena[1]
    eLeft = arena[2]
    eRight = arena[3]

    minKey = eKey[root]
    minVal = eVal[root]
    leftChild = eLeft[root]
    rightChild = eRight[root]

    newRoot = meldSkewHeaps(arena, leftChild, rightChild)
    return [minKey, minVal, newRoot]
}

func verifySkewHeapInvariants(arena, root) {
    if (root == -1) {
        return 1
    }

    vKey = arena[0]
    vLeft = arena[2]
    vRight = arena[3]
    vSize = arena[4]

    vStack = [root]
    while (vStack.size() > 0) {
        curr = vStack.pop()
        cKey = vKey[curr]
        cL = vLeft[curr]
        cR = vRight[curr]
        cS = vSize[curr]

        cLSize = 0
        if (cL != -1) {
            if (vKey[cL] < cKey) {
                print("[FAIL] Min-heap property violated: parent=", cKey, ", leftChild=", vKey[cL])
                return 0
            }
            cLSize = vSize[cL]
            vStack.push(cL)
        }

        cRSize = 0
        if (cR != -1) {
            if (vKey[cR] < cKey) {
                print("[FAIL] Min-heap property violated: parent=", cKey, ", rightChild=", vKey[cR])
                return 0
            }
            cRSize = vSize[cR]
            vStack.push(cR)
        }

        // Subtree size invariant
        if (cS != cLSize + cRSize + 1) {
            print("[FAIL] Subtree size invariant violated at node=", curr, ": size=", cS, ", expected=", cLSize + cRSize + 1)
            return 0
        }
    }
    return 1
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Inserts, Priority Order Extraction, and Min-Heap Invariants
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Inserts and Priority Order Extraction...")
tc1Arena = createSkewHeapArena()
tc1Root = -1

tc1Keys = [42, 17, 89, 5, 23, 67, 1, 99, 34, 12]
tc1Vals = [100, 200, 300, 400, 500, 600, 700, 800, 900, 1000]

tc1Idx = 0
tc1Pass = 1
while (tc1Idx < tc1Keys.size()) {
    tc1Root = insertHeapNode(tc1Arena, tc1Root, tc1Keys[tc1Idx], tc1Vals[tc1Idx])
    expectedSize = tc1Idx + 1
    actSize = getHeapSize(tc1Arena, tc1Root)
    if (actSize != expectedSize) {
        tc1Pass = 0
    }
    if (verifySkewHeapInvariants(tc1Arena, tc1Root) != 1) {
        tc1Pass = 0
    }
    tc1Idx = tc1Idx + 1
}

minPair = findMin(tc1Arena, tc1Root)
if (minPair[0] != 1 or minPair[1] != 700) {
    tc1Pass = 0
}

expectedExtracted = [1, 5, 12, 17, 23, 34, 42, 67, 89, 99]
extIdx = 0
prevKey = -1
while (extIdx < expectedExtracted.size()) {
    extRes = extractMin(tc1Arena, tc1Root)
    kExt = extRes[0]
    tc1Root = extRes[2]

    if (kExt != expectedExtracted[extIdx]) {
        tc1Pass = 0
    }
    if (extIdx > 0 and kExt < prevKey) {
        tc1Pass = 0
    }
    prevKey = kExt

    remExpected = expectedExtracted.size() - extIdx - 1
    if (getHeapSize(tc1Arena, tc1Root) != remExpected) {
        tc1Pass = 0
    }
    if (verifySkewHeapInvariants(tc1Arena, tc1Root) != 1) {
        tc1Pass = 0
    }
    extIdx = extIdx + 1
}

if (!isEmptyHeap(tc1Root)) {
    tc1Pass = 0
}

if (tc1Pass == 1) {
    print("  Heap size grew deterministically from 0 to 10 with verified min-heap invariants")
    print("  findMin correctly identified global minimum key (1)")
    print("  All 10 elements extracted in monotonic ascending order: 1 -> 5 -> 12 -> ... -> 99")
    print("  Heap size cleanly reached 0 and isEmptyHeap returned 1")
    print("  Test Case 1 Passed successfully")
} else {
    print("[FAIL] Test Case 1 encountered assertion mismatches")
}
