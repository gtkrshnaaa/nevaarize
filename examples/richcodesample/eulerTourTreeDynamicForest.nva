import stdlib time as t

// Euler Tour Tree (ETT) Data Structure for Dynamic Forest Representation
// Technical characteristics:
// - Self-balancing randomized Treap backing with explicit parent pointers
// - Logarithmic time dynamic edge links, cuts, and component rerooting
// - Maintenance of dynamic tree components across arbitrary forest topologies
// - O(log N) tree-level and subtree-level aggregate queries (sum and size)
// - Point weight updates with bottom-up ancestor propagation in O(log N)
// - Deterministic validation against naive graph traversal oracles
// - Strict camelCase naming conventions enforced across all symbols

print("=== Nevaarize Euler Tour Tree Dynamic Forest Suite ===")
suiteStartTime = t.millis()

func minInt(aInt, bInt) {
    if (aInt < bInt) { return aInt }
    return bInt
}

func maxInt(aInt, bInt) {
    if (aInt > bInt) { return aInt }
    return bInt
}

func makeIntArray(arrSize, fillVal) {
    arr = []
    arrIdx = 0
    while (arrIdx < arrSize) {
        arr.push(fillVal)
        arrIdx = arrIdx + 1
    }
    return arr
}

func createEtt(totalVerts) {
    tVal = []
    tPrio = []
    tSize = []
    tLeft = []
    tRight = []
    tParent = []
    tSum = []
    tMin = []
    tMax = []
    arena = [tVal, tPrio, tSize, tLeft, tRight, tParent, tSum, tMin, tMax]

    firstOcc = makeIntArray(totalVerts, -1)
    edgeMap = makeIntArray(totalVerts * totalVerts, -1)
    randSeed = [123456789]

    return [arena, firstOcc, edgeMap, totalVerts, randSeed]
}

func nextPrio(ett) {
    seedArr = ett[4]
    nextSeed = (seedArr[0] * 1103515245 + 12345) % 2147483648
    seedArr[0] = nextSeed
    return nextSeed % 10000000 + 1
}

func allocNode(ett, nodeWeight) {
    arena = ett[0]
    prio = nextPrio(ett)

    tVal = arena[0]
    tPrio = arena[1]
    tSize = arena[2]
    tLeft = arena[3]
    tRight = arena[4]
    tParent = arena[5]
    tSum = arena[6]
    tMin = arena[7]
    tMax = arena[8]

    allocId = tVal.size()
    tVal.push(nodeWeight)
    tPrio.push(prio)
    tSize.push(1)
    tLeft.push(-1)
    tRight.push(-1)
    tParent.push(-1)
    tSum.push(nodeWeight)
    tMin.push(nodeWeight)
    tMax.push(nodeWeight)

    arena[0] = tVal
    arena[1] = tPrio
    arena[2] = tSize
    arena[3] = tLeft
    arena[4] = tRight
    arena[5] = tParent
    arena[6] = tSum
    arena[7] = tMin
    arena[8] = tMax
    ett[0] = arena
    return allocId
}

func getSize(arena, targetNode) {
    if (targetNode == -1) { return 0 }
    return arena[2][targetNode]
}

func getSum(arena, targetNode) {
    if (targetNode == -1) { return 0 }
    return arena[6][targetNode]
}

func pull(arena, pNode) {
    if (pNode == -1) { return }
    pLeft = arena[3]
    pRight = arena[4]
    pParent = arena[5]
    pVal = arena[0]
    pSize = arena[2]
    pSum = arena[6]
    pMin = arena[7]
    pMax = arena[8]

    lc = pLeft[pNode]
    rc = pRight[pNode]
    valItem = pVal[pNode]
    totSz = 1
    totSum = valItem
    totMin = valItem
    totMax = valItem

    if (lc != -1) {
        pParent[lc] = pNode
        totSz = totSz + pSize[lc]
        totSum = totSum + pSum[lc]
        totMin = minInt(totMin, pMin[lc])
        totMax = maxInt(totMax, pMax[lc])
    }
    if (rc != -1) {
        pParent[rc] = pNode
        totSz = totSz + pSize[rc]
        totSum = totSum + pSum[rc]
        totMin = minInt(totMin, pMin[rc])
        totMax = maxInt(totMax, pMax[rc])
    }

    pSize[pNode] = totSz
    pSum[pNode] = totSum
    pMin[pNode] = totMin
    pMax[pNode] = totMax
}

func splitInternal(arena, sNode, splitK, outPair) {
    if (sNode == -1) {
        outPair[0] = -1
        outPair[1] = -1
        return
    }
    pLeft = arena[3]
    lc = pLeft[sNode]
    leftSz = getSize(arena, lc)

    if (leftSz >= splitK) {
        subPair = [-1, -1]
        splitInternal(arena, lc, splitK, subPair)
        pLeft = arena[3]
        pLeft[sNode] = subPair[1]
        pull(arena, sNode)
        outPair[0] = subPair[0]
        outPair[1] = sNode
    } else {
        subPair = [-1, -1]
        pRight = arena[4]
        rc = pRight[sNode]
        splitInternal(arena, rc, splitK - leftSz - 1, subPair)
        pRight = arena[4]
        pRight[sNode] = subPair[0]
        pull(arena, sNode)
        outPair[0] = sNode
        outPair[1] = subPair[1]
    }
}

func split(arena, sNode, splitK, outPair) {
    splitInternal(arena, sNode, splitK, outPair)
    pParent = arena[5]
    if (outPair[0] != -1) {
        pParent[outPair[0]] = -1
    }
    if (outPair[1] != -1) {
        pParent[outPair[1]] = -1
    }
}

func mergeInternal(arena, leftNode, rightNode) {
    if (leftNode == -1) { return rightNode }
    if (rightNode == -1) { return leftNode }
    pPrio = arena[1]
    if (pPrio[leftNode] >= pPrio[rightNode]) {
        pRight = arena[4]
        rc = pRight[leftNode]
        newRc = mergeInternal(arena, rc, rightNode)
        pRight = arena[4]
        pRight[leftNode] = newRc
        pull(arena, leftNode)
        return leftNode
    } else {
        pLeft = arena[3]
        lc = pLeft[rightNode]
        newLc = mergeInternal(arena, leftNode, lc)
        pLeft = arena[3]
        pLeft[rightNode] = newLc
        pull(arena, rightNode)
        return rightNode
    }
}

func merge(arena, leftNode, rightNode) {
    mergedRes = mergeInternal(arena, leftNode, rightNode)
    if (mergedRes != -1) {
        pParent = arena[5]
        pParent[mergedRes] = -1
    }
    return mergedRes
}

func getBstRoot(arena, startNode) {
    if (startNode == -1) { return -1 }
    currNode = startNode
    pParent = arena[5]
    while (pParent[currNode] != -1) {
        currNode = pParent[currNode]
    }
    return currNode
}

func getNodeIndex(arena, targetNode) {
    if (targetNode == -1) { return -1 }
    pLeft = arena[3]
    pRight = arena[4]
    pParent = arena[5]
    calcIdx = getSize(arena, pLeft[targetNode])
    currWalker = targetNode
    while (pParent[currWalker] != -1) {
        parentWalker = pParent[currWalker]
        if (currWalker == pRight[parentWalker]) {
            calcIdx = calcIdx + 1 + getSize(arena, pLeft[parentWalker])
        }
        currWalker = parentWalker
    }
    return calcIdx
}

func initVertices(ett, vertWeights) {
    firstOcc = ett[1]
    vertIdx = 0
    while (vertIdx < vertWeights.size()) {
        nodeId = allocNode(ett, vertWeights[vertIdx])
        firstOcc[vertIdx] = nodeId
        vertIdx = vertIdx + 1
    }
}

func reroot(ett, rootVert) {
    arena = ett[0]
    firstOcc = ett[1]
    uNode = firstOcc[rootVert]
    treapRoot = getBstRoot(arena, uNode)
    splitK = getNodeIndex(arena, uNode)
    if (splitK <= 0) {
        return
    }
    pairOut = [-1, -1]
    split(arena, treapRoot, splitK, pairOut)
    merge(arena, pairOut[1], pairOut[0])
}

func isConnected(ett, vertU, vertV) {
    arena = ett[0]
    firstOcc = ett[1]
    rootU = getBstRoot(arena, firstOcc[vertU])
    rootV = getBstRoot(arena, firstOcc[vertV])
    if (rootU == -1 or rootV == -1) {
        return false
    }
    return (rootU == rootV)
}

func link(ett, linkU, linkV) {
    if (isConnected(ett, linkU, linkV)) {
        return false
    }
    reroot(ett, linkU)
    reroot(ett, linkV)

    arena = ett[0]
    firstOcc = ett[1]
    numTotal = ett[3]

    rU = getBstRoot(arena, firstOcc[linkU])
    rV = getBstRoot(arena, firstOcc[linkV])

    eUV = allocNode(ett, 0)
    eVU = allocNode(ett, 0)
    arena = ett[0]

    edgeMap = ett[2]
    edgeMap[linkU * numTotal + linkV] = eUV
    edgeMap[linkV * numTotal + linkU] = eVU

    m1 = merge(arena, rU, eUV)
    m2 = merge(arena, m1, rV)
    merge(arena, m2, eVU)
    return true
}

func cut(ett, cutU, cutV) {
    edgeMap = ett[2]
    numTotal = ett[3]
    eUV = edgeMap[cutU * numTotal + cutV]
    eVU = edgeMap[cutV * numTotal + cutU]
    if (eUV == -1 or eVU == -1) {
        return false
    }
    edgeMap[cutU * numTotal + cutV] = -1
    edgeMap[cutV * numTotal + cutU] = -1

    arena = ett[0]
    pos1 = getNodeIndex(arena, eUV)
    pos2 = getNodeIndex(arena, eVU)
    if (pos1 > pos2) {
        tmpPos = pos1
        pos1 = pos2
        pos2 = tmpPos
        tmpE = eUV
        eUV = eVU
        eVU = tmpE
    }

    cutRoot = getBstRoot(arena, eUV)

    p1 = [-1, -1]
    split(arena, cutRoot, pos2 + 1, p1)

    p2 = [-1, -1]
    split(arena, p1[0], pos2, p2)

    p3 = [-1, -1]
    split(arena, p2[0], pos1 + 1, p3)

    p4 = [-1, -1]
    split(arena, p3[0], pos1, p4)

    merge(arena, p4[0], p1[1])
    return true
}

func queryTreeSum(ett, queryVert) {
    arena = ett[0]
    firstOcc = ett[1]
    treapRoot = getBstRoot(arena, firstOcc[queryVert])
    return getSum(arena, treapRoot)
}

func queryTreeSize(ett, queryVert) {
    arena = ett[0]
    firstOcc = ett[1]
    treapRoot = getBstRoot(arena, firstOcc[queryVert])
    totNodes = getSize(arena, treapRoot)
    return (totNodes + 2) / 3
}

func setVertexWeight(ett, updateVert, newWeight) {
    arena = ett[0]
    firstOcc = ett[1]
    targetNode = firstOcc[updateVert]
    arena[0][targetNode] = newWeight
    currNode = targetNode
    while (currNode != -1) {
        pull(arena, currNode)
        currNode = arena[5][currNode]
    }
}

func getVertexWeight(ett, queryVert) {
    arena = ett[0]
    firstOcc = ett[1]
    targetNode = firstOcc[queryVert]
    return arena[0][targetNode]
}

func querySubtreeSum(ett, rootVert, subVert) {
    if (rootVert == subVert) {
        return queryTreeSum(ett, rootVert)
    }
    reroot(ett, rootVert)
    edgeMap = ett[2]
    numTotal = ett[3]
    arena = ett[0]

    parentCand = 0
    foundParent = -1
    while (parentCand < numTotal) {
        candEdgePV = edgeMap[parentCand * numTotal + subVert]
        if (candEdgePV != -1) {
            if (getBstRoot(arena, candEdgePV) == getBstRoot(arena, ett[1][rootVert])) {
                candEdgeVP = edgeMap[subVert * numTotal + parentCand]
                candIdxPV = getNodeIndex(arena, candEdgePV)
                candIdxVP = getNodeIndex(arena, candEdgeVP)
                if (candIdxPV < candIdxVP) {
                    foundParent = parentCand
                    parentCand = numTotal
                }
            }
        }
        parentCand = parentCand + 1
    }

    if (foundParent == -1) {
        return 0
    }

    inEdge = edgeMap[foundParent * numTotal + subVert]
    outEdge = edgeMap[subVert * numTotal + foundParent]
    posIn = getNodeIndex(arena, inEdge)
    posOut = getNodeIndex(arena, outEdge)

    subTreapRoot = getBstRoot(arena, inEdge)
    rangeCount = posOut - posIn + 1

    part1 = [-1, -1]
    split(arena, subTreapRoot, posIn, part1)
    part2 = [-1, -1]
    split(arena, part1[1], rangeCount, part2)

    subResult = getSum(arena, part2[0])

    rem1 = merge(arena, part1[0], part2[0])
    merge(arena, rem1, part2[1])
    return subResult
}

func querySubtreeSize(ett, rootVert, subVert) {
    if (rootVert == subVert) {
        return queryTreeSize(ett, rootVert)
    }
    reroot(ett, rootVert)
    edgeMap = ett[2]
    numTotal = ett[3]
    arena = ett[0]

    parentCand = 0
    foundParent = -1
    while (parentCand < numTotal) {
        candEdgePV = edgeMap[parentCand * numTotal + subVert]
        if (candEdgePV != -1) {
            if (getBstRoot(arena, candEdgePV) == getBstRoot(arena, ett[1][rootVert])) {
                candEdgeVP = edgeMap[subVert * numTotal + parentCand]
                candIdxPV = getNodeIndex(arena, candEdgePV)
                candIdxVP = getNodeIndex(arena, candEdgeVP)
                if (candIdxPV < candIdxVP) {
                    foundParent = parentCand
                    parentCand = numTotal
                }
            }
        }
        parentCand = parentCand + 1
    }

    if (foundParent == -1) {
        return 0
    }

    inEdge = edgeMap[foundParent * numTotal + subVert]
    outEdge = edgeMap[subVert * numTotal + foundParent]
    posIn = getNodeIndex(arena, inEdge)
    posOut = getNodeIndex(arena, outEdge)

    subTreapRoot = getBstRoot(arena, inEdge)
    rangeCount = posOut - posIn + 1

    part1 = [-1, -1]
    split(arena, subTreapRoot, posIn, part1)
    part2 = [-1, -1]
    split(arena, part1[1], rangeCount, part2)

    subSz = getSize(arena, part2[0]) / 3

    rem1 = merge(arena, part1[0], part2[0])
    merge(arena, rem1, part2[1])
    return subSz
}

// -----------------------------------------------------------------------------
// Test Case 1: Initial Forest Isolation and Dynamic Tree Linking
// -----------------------------------------------------------------------------
print("Running Test Case 1: Initial Forest Isolation and Dynamic Linking...")
c1Ett = createEtt(8)
c1Weights = [10, 20, 30, 40, 50, 60, 70, 80]
initVertices(c1Ett, c1Weights)

c1Pass = 1
uScan = 0
while (uScan < 8) {
    vScan = uScan + 1
    while (vScan < 8) {
        if (isConnected(c1Ett, uScan, vScan)) {
            c1Pass = 0
        }
        vScan = vScan + 1
    }
    if (queryTreeSum(c1Ett, uScan) != c1Weights[uScan]) {
        c1Pass = 0
    }
    if (queryTreeSize(c1Ett, uScan) != 1) {
        c1Pass = 0
    }
    uScan = uScan + 1
}

// Build Tree A: 0 - 1 - 2 - 3 (Line tree)
link(c1Ett, 0, 1)
link(c1Ett, 1, 2)
link(c1Ett, 2, 3)

// Build Tree B: 4 is center of star with 5, 6, 7
link(c1Ett, 4, 5)
link(c1Ett, 4, 6)
link(c1Ett, 4, 7)

if (!isConnected(c1Ett, 0, 3) or !isConnected(c1Ett, 1, 2) or isConnected(c1Ett, 0, 4)) {
    c1Pass = 0
}
if (!isConnected(c1Ett, 5, 7) or !isConnected(c1Ett, 6, 4) or isConnected(c1Ett, 2, 6)) {
    c1Pass = 0
}

// Sum of Tree A: 10 + 20 + 30 + 40 = 100
if (queryTreeSum(c1Ett, 0) != 100 or queryTreeSize(c1Ett, 0) != 4) {
    c1Pass = 0
}
// Sum of Tree B: 50 + 60 + 70 + 80 = 260
if (queryTreeSum(c1Ett, 4) != 260 or queryTreeSize(c1Ett, 7) != 4) {
    c1Pass = 0
}

if (c1Pass == 1) {
    print("  Isolated 8 vertices verified: 0 spurious connections")
    print("  Dynamic links constructed Line Tree A (sum 100) and Star Tree B (sum 260)")
    print("  Component isolation between Tree A and Tree B verified")
    print("  Test Case 1 Passed successfully")
} else {
    print("[FAIL] Test Case 1 encountered assertion mismatches")
}

// -----------------------------------------------------------------------------
// Test Case 2: Dynamic Cuts and Component Partition Invariants
// -----------------------------------------------------------------------------
print("Running Test Case 2: Dynamic Cuts and Component Partition Invariants...")
c2Pass = 1

// Cut edge (1, 2) in Tree A -> separates into {0, 1} and {2, 3}
cut(c1Ett, 1, 2)

if (isConnected(c1Ett, 0, 2) or isConnected(c1Ett, 1, 3)) {
    c2Pass = 0
}
if (!isConnected(c1Ett, 0, 1) or !isConnected(c1Ett, 2, 3)) {
    c2Pass = 0
}

// Subcomponent sums: {0, 1} = 30, {2, 3} = 70
if (queryTreeSum(c1Ett, 0) != 30 or queryTreeSize(c1Ett, 0) != 2) {
    c2Pass = 0
}
if (queryTreeSum(c1Ett, 3) != 70 or queryTreeSize(c1Ett, 3) != 2) {
    c2Pass = 0
}

// Cut edge (4, 6) from Tree B -> separates node 6 from star {4, 5, 7}
cut(c1Ett, 4, 6)

if (isConnected(c1Ett, 4, 6) or isConnected(c1Ett, 5, 6)) {
    c2Pass = 0
}
if (!isConnected(c1Ett, 4, 5) or !isConnected(c1Ett, 5, 7)) {
    c2Pass = 0
}
if (queryTreeSum(c1Ett, 6) != 70 or queryTreeSize(c1Ett, 6) != 1) {
    c2Pass = 0
}
if (queryTreeSum(c1Ett, 4) != 190 or queryTreeSize(c1Ett, 4) != 3) {
    c2Pass = 0
}

// Bridge linking: connect {0, 1} to {4, 5, 7} via edge (1, 4)
link(c1Ett, 1, 4)
if (!isConnected(c1Ett, 0, 7) or !isConnected(c1Ett, 1, 5)) {
    c2Pass = 0
}
// Combined sum: 30 + 190 = 220, size: 2 + 3 = 5
if (queryTreeSum(c1Ett, 0) != 220 or queryTreeSize(c1Ett, 7) != 5) {
    c2Pass = 0
}

if (c2Pass == 1) {
    print("  Topological cut (1, 2) split component into {0, 1} and {2, 3}")
    print("  Isolated leaf cut (4, 6) detached singleton vertex 6")
    print("  Bridge link (1, 4) created united 5-node component with sum 220")
    print("  Test Case 2 Passed successfully")
} else {
    print("[FAIL] Test Case 2 encountered assertion mismatches")
}

// -----------------------------------------------------------------------------
// Test Case 3: Subtree Aggregate Queries and Reroot Invariance
// -----------------------------------------------------------------------------
print("Running Test Case 3: Subtree Aggregate Queries and Reroot Invariance...")
c3Pass = 1

// We have component {0, 1, 4, 5, 7}
// Topology: 0 - 1 - 4 with 4 having children 5, 7
// Root at 0:
// - Subtree of 0 is full component: sum 220, size 5
// - Subtree of 1: nodes {1, 4, 5, 7}: 20 + 50 + 60 + 80 = 210, size 4
// - Subtree of 4: nodes {4, 5, 7}: 50 + 60 + 80 = 190, size 3
// - Subtree of 5: node 5: 60, size 1
// - Subtree of 7: node 7: 80, size 1

if (querySubtreeSum(c1Ett, 0, 0) != 220 or querySubtreeSize(c1Ett, 0, 0) != 5) {
    c3Pass = 0
}
if (querySubtreeSum(c1Ett, 0, 1) != 210 or querySubtreeSize(c1Ett, 0, 1) != 4) {
    c3Pass = 0
}
if (querySubtreeSum(c1Ett, 0, 4) != 190 or querySubtreeSize(c1Ett, 0, 4) != 3) {
    c3Pass = 0
}
if (querySubtreeSum(c1Ett, 0, 5) != 60 or querySubtreeSize(c1Ett, 0, 5) != 1) {
    c3Pass = 0
}
if (querySubtreeSum(c1Ett, 0, 7) != 80 or querySubtreeSize(c1Ett, 0, 7) != 1) {
    c3Pass = 0
}

// Now reroot at 4:
// Topology from root 4: children are 1, 5, 7; 1 has child 0
// - Subtree of 4 is full component: sum 220, size 5
// - Subtree of 1: nodes {1, 0}: 20 + 10 = 30, size 2
// - Subtree of 0: node 0: 10, size 1
// - Subtree of 5: node 5: 60, size 1
// - Subtree of 7: node 7: 80, size 1

if (querySubtreeSum(c1Ett, 4, 4) != 220 or querySubtreeSize(c1Ett, 4, 4) != 5) {
    c3Pass = 0
}
if (querySubtreeSum(c1Ett, 4, 1) != 30 or querySubtreeSize(c1Ett, 4, 1) != 2) {
    c3Pass = 0
}
if (querySubtreeSum(c1Ett, 4, 0) != 10 or querySubtreeSize(c1Ett, 4, 0) != 1) {
    c3Pass = 0
}
if (querySubtreeSum(c1Ett, 4, 5) != 60 or querySubtreeSize(c1Ett, 4, 5) != 1) {
    c3Pass = 0
}

// Now reroot at 5:
// Topology from root 5: 5 - 4, 4 has children 7 and 1, 1 has child 0
// - Subtree of 4: nodes {4, 7, 1, 0}: 50 + 80 + 20 + 10 = 160, size 4
if (querySubtreeSum(c1Ett, 5, 4) != 160 or querySubtreeSize(c1Ett, 5, 4) != 4) {
    c3Pass = 0
}

if (c3Pass == 1) {
    print("  Subtree queries from Root 0 verified accurately (sizes 5, 4, 3, 1, 1)")
    print("  Subtree queries from Root 4 verified correctly (sizes 5, 2, 1, 1, 1)")
    print("  Subtree queries from Root 5 verified inverted orientation (size 4, sum 160)")
    print("  Test Case 3 Passed successfully")
} else {
    print("[FAIL] Test Case 3 encountered assertion mismatches")
}

// -----------------------------------------------------------------------------
// Test Case 4: Vertex Weight Point Updates & Dynamic Re-aggregates
// -----------------------------------------------------------------------------
print("Running Test Case 4: Vertex Weight Point Updates & Propagation...")
c4Pass = 1

// Update vertex 4 from 50 to 500
setVertexWeight(c1Ett, 4, 500)
if (getVertexWeight(c1Ett, 4) != 500) {
    c4Pass = 0
}

// Total tree sum was 220, now 220 - 50 + 500 = 670
if (queryTreeSum(c1Ett, 0) != 670 or queryTreeSum(c1Ett, 4) != 670) {
    c4Pass = 0
}

// Subtree of 4 rooted at 0 was 190, now 190 - 50 + 500 = 640
if (querySubtreeSum(c1Ett, 0, 4) != 640) {
    c4Pass = 0
}

// Subtree of 1 rooted at 4 does NOT contain 4, so it remains 30
if (querySubtreeSum(c1Ett, 4, 1) != 30) {
    c4Pass = 0
}

// Update vertex 0 from 10 to -25 (negative weights supported)
setVertexWeight(c1Ett, 0, -25)
// Total sum: 670 - 10 + (-25) = 635
if (queryTreeSum(c1Ett, 7) != 635) {
    c4Pass = 0
}
// Subtree of 1 rooted at 4 now has nodes 1 and 0: 20 + (-25) = -5
if (querySubtreeSum(c1Ett, 4, 1) != -5) {
    c4Pass = 0
}

if (c4Pass == 1) {
    print("  Vertex weight updated from 50 to 500 with O(log N) tree sum propagation")
    print("  Subtree query (root 0, v 4) accurately updated to 640")
    print("  Negative weights supported: vertex 0 set to -25, subtree sum evaluates to -5")
    print("  Test Case 4 Passed successfully")
} else {
    print("[FAIL] Test Case 4 encountered assertion mismatches")
}

// -----------------------------------------------------------------------------
// Test Case 5: Randomized Stress Simulation against Adjacency List Oracle
// -----------------------------------------------------------------------------
print("Running Test Case 5: Randomized Stress Simulation against Naive Oracle...")

func createOracle(nodeCount) {
    adj = []
    oracleWeights = []
    nodeIdx = 0
    while (nodeIdx < nodeCount) {
        adj.push([])
        oracleWeights.push(nodeIdx * 10 + 5)
        nodeIdx = nodeIdx + 1
    }
    return [adj, oracleWeights, nodeCount]
}

func oracleIsConnected(oracle, uNode, vNode) {
    if (uNode == vNode) { return true }
    adj = oracle[0]
    numN = oracle[2]
    visited = makeIntArray(numN, 0)
    queue = [uNode]
    visited[uNode] = 1
    head = 0

    foundTarget = false
    while (head < queue.size() and !foundTarget) {
        curr = queue[head]
        head = head + 1
        neighbors = adj[curr]
        nIdx = 0
        while (nIdx < neighbors.size() and !foundTarget) {
            nxt = neighbors[nIdx]
            if (nxt == vNode) {
                foundTarget = true
            }
            if (!foundTarget and visited[nxt] == 0) {
                visited[nxt] = 1
                queue.push(nxt)
            }
            nIdx = nIdx + 1
        }
    }
    return foundTarget
}

func oracleLink(oracle, uNode, vNode) {
    if (oracleIsConnected(oracle, uNode, vNode)) {
        return false
    }
    adj = oracle[0]
    adj[uNode].push(vNode)
    adj[vNode].push(uNode)
    return true
}

func oracleCut(oracle, uNode, vNode) {
    adj = oracle[0]
    uNeighbors = adj[uNode]
    newUNeighbors = []
    foundEdge = false
    idx = 0
    while (idx < uNeighbors.size()) {
        if (uNeighbors[idx] == vNode and !foundEdge) {
            foundEdge = true
        } else {
            newUNeighbors.push(uNeighbors[idx])
        }
        idx = idx + 1
    }
    if (!foundEdge) {
        return false
    }
    adj[uNode] = newUNeighbors

    vNeighbors = adj[vNode]
    newVNeighbors = []
    idx = 0
    while (idx < vNeighbors.size()) {
        if (vNeighbors[idx] == uNode) {
            // skip edge
        } else {
            newVNeighbors.push(vNeighbors[idx])
        }
        idx = idx + 1
    }
    adj[vNode] = newVNeighbors
    return true
}

func oracleTreeSum(oracle, startNode) {
    adj = oracle[0]
    weights = oracle[1]
    numN = oracle[2]
    visited = makeIntArray(numN, 0)
    queue = [startNode]
    visited[startNode] = 1
    head = 0
    totSum = 0

    while (head < queue.size()) {
        curr = queue[head]
        head = head + 1
        totSum = totSum + weights[curr]
        neighbors = adj[curr]
        nIdx = 0
        while (nIdx < neighbors.size()) {
            nxt = neighbors[nIdx]
            if (visited[nxt] == 0) {
                visited[nxt] = 1
                queue.push(nxt)
            }
            nIdx = nIdx + 1
        }
    }
    return totSum
}

func oracleSubtreeSum(oracle, rootNode, subNode) {
    if (rootNode == subNode) {
        return oracleTreeSum(oracle, rootNode)
    }
    if (!oracleIsConnected(oracle, rootNode, subNode)) {
        return 0
    }
    adj = oracle[0]
    weights = oracle[1]
    numN = oracle[2]

    visited = makeIntArray(numN, 0)
    parentArr = makeIntArray(numN, -1)
    queue = [rootNode]
    visited[rootNode] = 1
    head = 0

    while (head < queue.size()) {
        curr = queue[head]
        head = head + 1
        neighbors = adj[curr]
        nIdx = 0
        while (nIdx < neighbors.size()) {
            nxt = neighbors[nIdx]
            if (visited[nxt] == 0) {
                visited[nxt] = 1
                parentArr[nxt] = curr
                queue.push(nxt)
            }
            nIdx = nIdx + 1
        }
    }

    pOfSub = parentArr[subNode]
    subVisited = makeIntArray(numN, 0)
    subVisited[pOfSub] = 1
    subQueue = [subNode]
    subVisited[subNode] = 1
    subHead = 0
    subSum = 0

    while (subHead < subQueue.size()) {
        curr = subQueue[subHead]
        subHead = subHead + 1
        subSum = subSum + weights[curr]
        neighbors = adj[curr]
        nIdx = 0
        while (nIdx < neighbors.size()) {
            nxt = neighbors[nIdx]
            if (subVisited[nxt] == 0) {
                subVisited[nxt] = 1
                subQueue.push(nxt)
            }
            nIdx = nIdx + 1
        }
    }
    return subSum
}

stressVertCount = 14
stressEtt = createEtt(stressVertCount)
stressOracle = createOracle(stressVertCount)
initVertices(stressEtt, stressOracle[1])

stressSeed = 998244353
stressOps = 160
stressOpIdx = 0
stressMismatches = 0

while (stressOpIdx < stressOps) {
    stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
    opType = stressSeed % 5

    stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
    randU = stressSeed % stressVertCount
    stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
    randV = stressSeed % stressVertCount

    if (randU == randV) {
        randV = (randU + 1) % stressVertCount
    }

    if (opType == 0) {
        ettConn = isConnected(stressEtt, randU, randV)
        orcConn = oracleIsConnected(stressOracle, randU, randV)
        if (ettConn != orcConn) {
            stressMismatches = stressMismatches + 1
        }
        if (!ettConn) {
            link(stressEtt, randU, randV)
            oracleLink(stressOracle, randU, randV)
        }
    }

    if (opType == 1) {
        edgeMapArr = stressEtt[2]
        totalNum = stressEtt[3]
        if (edgeMapArr[randU * totalNum + randV] != -1) {
            cut(stressEtt, randU, randV)
            oracleCut(stressOracle, randU, randV)
        }
    }

    if (opType == 2) {
        ettConn = isConnected(stressEtt, randU, randV)
        orcConn = oracleIsConnected(stressOracle, randU, randV)
        if (ettConn != orcConn) {
            stressMismatches = stressMismatches + 1
        }
    }

    if (opType == 3) {
        ettSum = queryTreeSum(stressEtt, randU)
        orcSum = oracleTreeSum(stressOracle, randU)
        if (ettSum != orcSum) {
            stressMismatches = stressMismatches + 1
        }
    }

    if (opType == 4) {
        if (isConnected(stressEtt, randU, randV)) {
            ettSub = querySubtreeSum(stressEtt, randU, randV)
            orcSub = oracleSubtreeSum(stressOracle, randU, randV)
            if (ettSub != orcSub) {
                stressMismatches = stressMismatches + 1
            }
        }
    }

    stressOpIdx = stressOpIdx + 1
}

if (stressMismatches == 0) {
    print("  Validated", stressOps, "randomized dynamic links, cuts, and subtree queries against Oracle")
    print("  Total mismatches across all operations: 0")
    print("  Test Case 5 Passed randomized stress simulation")
} else {
    print("[FAIL] Stress simulation encountered", stressMismatches, "mismatches against oracle")
}

elapsedTime = t.millis() - suiteStartTime
print("[PASS] Euler Tour Tree Dynamic Forest Suite executed successfully in", elapsedTime, "ms")
