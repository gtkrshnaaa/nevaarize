import stdlib time as t

// Higher-Order Function Pipeline Suite: Map, Filter, Fold, and Zip Transforms
// Technical characteristics:
// - Composable higher-order functional pipeline engine processing structured list streams
// - Dynamic stage transformation pipeline chaining map, filter, fold, scan, flatMap, and zip transforms
// - Functor, Monad, and Fold algebraic property and duality verification
// - Pairwise stream combinators (zip, unzip, zipWith) with boundary truncation handling
// - Fold left and fold right directional accumulator evaluation and non-associative operator duality
// - Single-pass pipeline fusion optimization compared against multi-pass staged evaluation
// - Domain simulation pipelines: Moving-average signal conditioning, Collatz orbit analytics, and vector kinematics
// - High-throughput stress benchmark executing 25,000+ element multi-stage pipeline transformations
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero external dependencies, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Higher-Order Function Pipeline Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Function Registry Identifier Constants ---

// Unary Function Identifiers
fnIdIdentity = 1
fnIdNegate = 2
fnIdSquare = 3
fnIdDouble = 4
fnIdIncrement = 5
fnIdDecrement = 6
fnIdCollatzStep = 7
fnIdAbs = 8
fnIdMod10 = 9
fnIdModularHash = 10
fnIdCube = 11
fnIdMultiplyByK = 12
fnIdAddConst = 13
fnIdClamp = 14

// Predicate Identifiers
predIdIsEven = 20
predIdIsOdd = 21
predIdIsPositive = 22
predIdIsNegative = 23
predIdIsDivisibleBy3 = 24
predIdIsDivisibleBy5 = 25
predIdIsPrime = 26
predIdGreaterThanThreshold = 27
predIdLessThanThreshold = 28
predIdInRange = 29

// Binary Combinator Identifiers
binIdAdd = 40
binIdSubtract = 41
binIdMultiply = 42
binIdMax = 43
binIdMin = 44
binIdXor = 45
binIdHypotSquared = 46
binIdModAdd = 47
binIdModMul = 48
binIdDotProductPair = 49
binIdWeightedSum = 50
binIdEuclideanDistanceSquared = 51

// --- Telemetry Counters ---

transformCount = [0]
predicateCount = [0]
foldCount = [0]
zipCount = [0]
itemsProcessed = [0]

// --- Helper Functions ---

func isPrime(n) {
    if (n <= 1) {
        return false
    }
    if (n <= 3) {
        return true
    }
    if (n % 2 == 0 or n % 3 == 0) {
        return false
    }
    d = 5
    while (d * d <= n) {
        if (n % d == 0 or n % (d + 2) == 0) {
            return false
        }
        d = d + 6
    }
    return true
}

func compareArrays(arr1, arr2) {
    sz1 = arr1.size()
    sz2 = arr2.size()
    if (sz1 != sz2) {
        return false
    }
    idx = 0
    while (idx < sz1) {
        if (arr1[idx] != arr2[idx]) {
            return false
        }
        idx = idx + 1
    }
    return true
}

func shallowCopyArray(srcArr) {
    newArr = []
    for (elem in srcArr) {
        newArr.push(elem)
    }
    return newArr
}

// --- Dispatch Registries ---

func dispatchUnary(fnId, x, param1, param2) {
    transformCount[0] = transformCount[0] + 1
    if (fnId == 1) {
        // fnIdIdentity
        return x
    } elif (fnId == 2) {
        // fnIdNegate
        return 0 - x
    } elif (fnId == 3) {
        // fnIdSquare
        return x * x
    } elif (fnId == 4) {
        // fnIdDouble
        return x * 2
    } elif (fnId == 5) {
        // fnIdIncrement
        return x + 1
    } elif (fnId == 6) {
        // fnIdDecrement
        return x - 1
    } elif (fnId == 7) {
        // fnIdCollatzStep
        if (x % 2 == 0) {
            return x / 2
        }
        return (x * 3) + 1
    } elif (fnId == 8) {
        // fnIdAbs
        if (x < 0) {
            return 0 - x
        }
        return x
    } elif (fnId == 9) {
        // fnIdMod10
        rem = x % 10
        if (rem < 0) {
            return rem + 10
        }
        return rem
    } elif (fnId == 10) {
        // fnIdModularHash
        return (x * 16777619) % 2147483647
    } elif (fnId == 11) {
        // fnIdCube
        return x * x * x
    } elif (fnId == 12) {
        // fnIdMultiplyByK
        return x * param1
    } elif (fnId == 13) {
        // fnIdAddConst
        return x + param1
    } elif (fnId == 14) {
        // fnIdClamp (low = param1, high = param2)
        if (x < param1) {
            return param1
        }
        if (x > param2) {
            return param2
        }
        return x
    }
    return x
}

func dispatchPredicate(predId, x, param1, param2) {
    predicateCount[0] = predicateCount[0] + 1
    if (predId == 20) {
        // predIdIsEven
        return (x % 2 == 0)
    } elif (predId == 21) {
        // predIdIsOdd
        return (x % 2 != 0)
    } elif (predId == 22) {
        // predIdIsPositive
        return (x > 0)
    } elif (predId == 23) {
        // predIdIsNegative
        return (x < 0)
    } elif (predId == 24) {
        // predIdIsDivisibleBy3
        return (x % 3 == 0)
    } elif (predId == 25) {
        // predIdIsDivisibleBy5
        return (x % 5 == 0)
    } elif (predId == 26) {
        // predIdIsPrime
        return isPrime(x)
    } elif (predId == 27) {
        // predIdGreaterThanThreshold
        return (x > param1)
    } elif (predId == 28) {
        // predIdLessThanThreshold
        return (x < param1)
    } elif (predId == 29) {
        // predIdInRange
        return (x >= param1 and x <= param2)
    }
    return true
}

func dispatchBinary(binId, a, b, param1) {
    foldCount[0] = foldCount[0] + 1
    if (binId == 40) {
        // binIdAdd
        return a + b
    } elif (binId == 41) {
        // binIdSubtract
        return a - b
    } elif (binId == 42) {
        // binIdMultiply
        return a * b
    } elif (binId == 43) {
        // binIdMax
        if (a > b) {
            return a
        }
        return b
    } elif (binId == 44) {
        // binIdMin
        if (a < b) {
            return a
        }
        return b
    } elif (binId == 45) {
        // binIdXor
        return a ^ b
    } elif (binId == 46) {
        // binIdHypotSquared
        return (a * a) + (b * b)
    } elif (binId == 47) {
        // binIdModAdd
        return (a + b) % 1000000007
    } elif (binId == 48) {
        // binIdModMul
        return (a * b) % 1000000007
    } elif (binId == 49) {
        // binIdDotProductPair
        return a * b
    } elif (binId == 50) {
        // binIdWeightedSum
        return a + (b * param1)
    } elif (binId == 51) {
        // binIdEuclideanDistanceSquared
        diff = a - b
        return diff * diff
    }
    return a
}

// --- Core List Combinators ---

func mapList(fnId, list, param1, param2) {
    result = []
    for (elem in list) {
        itemsProcessed[0] = itemsProcessed[0] + 1
        transformed = dispatchUnary(fnId, elem, param1, param2)
        result.push(transformed)
    }
    return result
}

func filterList(predId, list, param1, param2) {
    result = []
    for (elem in list) {
        itemsProcessed[0] = itemsProcessed[0] + 1
        matches = dispatchPredicate(predId, elem, param1, param2)
        if (matches) {
            result.push(elem)
        }
    }
    return result
}

func foldList(binId, initialAcc, list, param1) {
    acc = initialAcc
    for (elem in list) {
        itemsProcessed[0] = itemsProcessed[0] + 1
        acc = dispatchBinary(binId, acc, elem, param1)
    }
    return acc
}
