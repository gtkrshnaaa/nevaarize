import stdlib time as t

// Functional Lens Deep Immutable Field Updates Suite
// Technical characteristics:
// - Composable bidirectional functional lenses (getters, setters, modifiers)
// - Pure immutability: deep record updates without in-place mutation
// - Path copying with fine-grained structural sharing on untouched subtrees
// - Support for heterogeneous nesting (records inside records, records inside arrays)
// - Compositional lens combinators (binary composeLens and n-ary composeLensList)
// - Deterministic verification of canonical Lens Laws (Get-Put, Put-Get, Put-Put)
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero AI artifacts, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Functional Lens Deep Immutable Field Updates Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Shallow Copy and Structural Utilities ---

func shallowCopyMap(srcMap) {
    newMap = {}
    for (k in srcMap.keys()) {
        newMap[k] = srcMap[k]
    }
    return newMap
}

func shallowCopyArray(srcArr) {
    newArr = []
    idx = 0
    sz = srcArr.size()
    while (idx < sz) {
        newArr.push(srcArr[idx])
        idx = idx + 1
    }
    return newArr
}

func applyLensModifier(opCode, operand, currentVal) {
    if (opCode == "add") {
        return currentVal + operand
    }
    if (opCode == "sub") {
        return currentVal - operand
    }
    if (opCode == "mul") {
        return currentVal * operand
    }
    if (opCode == "concat") {
        return currentVal + operand
    }
    if (opCode == "toggle") {
        if (currentVal == 1) {
            return 0
        }
        return 1
    }
    if (opCode == "replace") {
        return operand
    }
    return currentVal
}

// --- Deep Structural Equality Comparators ---

func deepMapEquals(firstMap, secondMap) {
    keysFirst = firstMap.keys()
    keysSecond = secondMap.keys()
    if (keysFirst.size() != keysSecond.size()) {
        return 0
    }
    for (k in keysFirst) {
        if (secondMap.has(k) == 0) {
            return 0
        }
        valFirst = firstMap[k]
        valSecond = secondMap[k]
        if (valFirst != valSecond) {
            return 0
        }
    }
    return 1
}

func deepArrayEquals(firstArr, secondArr) {
    szFirst = firstArr.size()
    szSecond = secondArr.size()
    if (szFirst != szSecond) {
        return 0
    }
    idx = 0
    while (idx < szFirst) {
        if (firstArr[idx] != secondArr[idx]) {
            return 0
        }
        idx = idx + 1
    }
    return 1
}

// --- Primitive Lens Constructors ---

func createIdentityLens() {
    return {"kind": "identity"}
}

func createPropLens(propName) {
    return {"kind": "prop", "prop": propName}
}

func createIndexLens(targetIndex) {
    return {"kind": "index", "index": targetIndex}
}

func createComposeLens(outerLens, innerLens) {
    return {"kind": "compose", "outer": outerLens, "inner": innerLens}
}

func composeLensList(lensesList) {
    totalLenses = lensesList.size()
    if (totalLenses == 0) {
        return createIdentityLens()
    }
    compositeLens = lensesList[totalLenses - 1]
    stepIdx = totalLenses - 2
    while (stepIdx >= 0) {
        currentLens = lensesList[stepIdx]
        compositeLens = createComposeLens(currentLens, compositeLens)
        stepIdx = stepIdx - 1
    }
    return compositeLens
}

// --- Core Lens Evaluation Engine ---

func lensView(targetLens, dataStructure) {
    lensKind = targetLens["kind"]
    if (lensKind == "identity") {
        return dataStructure
    }
    if (lensKind == "prop") {
        propKey = targetLens["prop"]
        return dataStructure[propKey]
    }
    if (lensKind == "index") {
        elemIdx = targetLens["index"]
        return dataStructure[elemIdx]
    }
    if (lensKind == "compose") {
        outerLens = targetLens["outer"]
        innerLens = targetLens["inner"]
        intermediateData = lensView(outerLens, dataStructure)
        return lensView(innerLens, intermediateData)
    }
    return dataStructure
}

func lensSet(targetLens, newValue, dataStructure) {
    lensKind = targetLens["kind"]
    if (lensKind == "identity") {
        return newValue
    }
    if (lensKind == "prop") {
        propKey = targetLens["prop"]
        copiedRecord = shallowCopyMap(dataStructure)
        copiedRecord[propKey] = newValue
        return copiedRecord
    }
    if (lensKind == "index") {
        elemIdx = targetLens["index"]
        copiedSequence = shallowCopyArray(dataStructure)
        copiedSequence[elemIdx] = newValue
        return copiedSequence
    }
    if (lensKind == "compose") {
        outerLens = targetLens["outer"]
        innerLens = targetLens["inner"]
        subStructure = lensView(outerLens, dataStructure)
        updatedSubStructure = lensSet(innerLens, newValue, subStructure)
        return lensSet(outerLens, updatedSubStructure, dataStructure)
    }
    return dataStructure
}

func lensModify(targetLens, opCode, operand, dataStructure) {
    currentFocus = lensView(targetLens, dataStructure)
    computedFocus = applyLensModifier(opCode, operand, currentFocus)
    return lensSet(targetLens, computedFocus, dataStructure)
}

// --- Test Case 1: Primitive Prop and Index Lenses ---

print("--- Running Test Case 1: Primitive Prop and Index Lenses ---")

initialUserRecord = {
    "userName": "aurum",
    "role": "lead",
    "accessLevel": 9
}

nameLens = createPropLens("userName")
levelLens = createPropLens("accessLevel")

viewedName = lensView(nameLens, initialUserRecord)
viewedLevel = lensView(levelLens, initialUserRecord)

if (viewedName != "aurum" or viewedLevel != 9) {
    print("[FAIL] Test Case 1 Primitive prop lens view failed: name=", viewedName, " level=", viewedLevel)
    testSuiteFailures = testSuiteFailures + 1
}

updatedUserRecord = lensSet(nameLens, "pyroxene", initialUserRecord)
updatedLevelRecord = lensModify(levelLens, "add", 3, updatedUserRecord)

if (lensView(nameLens, updatedUserRecord) != "pyroxene") {
    print("[FAIL] Test Case 1 Updated record userName mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

if (lensView(levelLens, updatedLevelRecord) != 12) {
    print("[FAIL] Test Case 1 Modified record accessLevel mismatch: expected 12, got ", lensView(levelLens, updatedLevelRecord))
    testSuiteFailures = testSuiteFailures + 1
}

// Verify original record was never mutated in-place
if (initialUserRecord["userName"] != "aurum" or initialUserRecord["accessLevel"] != 9) {
    print("[FAIL] Test Case 1 Immutability violated on initialUserRecord")
    testSuiteFailures = testSuiteFailures + 1
}

// Verify array index lens primitives
initialArray = [100, 200, 300, 400]
firstSlotLens = createIndexLens(0)
thirdSlotLens = createIndexLens(2)

if (lensView(firstSlotLens, initialArray) != 100 or lensView(thirdSlotLens, initialArray) != 300) {
    print("[FAIL] Test Case 1 Index lens view mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

updatedArray = lensSet(thirdSlotLens, 777, initialArray)
modifiedArray = lensModify(firstSlotLens, "mul", 5, updatedArray)

if (lensView(thirdSlotLens, updatedArray) != 777 or lensView(firstSlotLens, modifiedArray) != 500) {
    print("[FAIL] Test Case 1 Array index set or modify failed")
    testSuiteFailures = testSuiteFailures + 1
}

if (initialArray[0] != 100 or initialArray[2] != 300) {
    print("[FAIL] Test Case 1 Array immutability violated on initialArray")
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 1 Passed primitive prop and index lens verification")

// --- Test Case 2: Canonical Lens Laws Verification ---

print("--- Running Test Case 2: Canonical Lens Laws Verification ---")

// Law 1: Get-Put (Identity) -> lensSet(l, lensView(l, s), s) == s
testRecordAlpha = {
    "moduleName": "nevaarizeJit",
    "targetArch": "x86_64",
    "optLevel": 3
}

optLevelLens = createPropLens("optLevel")
currentOptVal = lensView(optLevelLens, testRecordAlpha)
identityReconstructed = lensSet(optLevelLens, currentOptVal, testRecordAlpha)

if (deepMapEquals(identityReconstructed, testRecordAlpha) == 0) {
    print("[FAIL] Test Case 2 Law 1 (Get-Put) violated on map record")
    testSuiteFailures = testSuiteFailures + 1
}

// Verify Law 1 on Array index lens
testSequenceAlpha = [10, 20, 30, 40, 50]
seqLens = createIndexLens(2)
currSeqVal = lensView(seqLens, testSequenceAlpha)
identitySeqReconstructed = lensSet(seqLens, currSeqVal, testSequenceAlpha)

if (deepArrayEquals(identitySeqReconstructed, testSequenceAlpha) == 0) {
    print("[FAIL] Test Case 2 Law 1 (Get-Put) violated on array sequence")
    testSuiteFailures = testSuiteFailures + 1
}

// Law 2: Put-Get (Retention) -> lensView(l, lensSet(l, v, s)) == v
targetNewOptVal = 4
putGetRecord = lensSet(optLevelLens, targetNewOptVal, testRecordAlpha)
retrievedOptVal = lensView(optLevelLens, putGetRecord)

if (retrievedOptVal != targetNewOptVal) {
    print("[FAIL] Test Case 2 Law 2 (Put-Get) violated on map record: expected ", targetNewOptVal, " got ", retrievedOptVal)
    testSuiteFailures = testSuiteFailures + 1
}

targetNewSeqVal = 99
putGetSequence = lensSet(seqLens, targetNewSeqVal, testSequenceAlpha)
retrievedSeqVal = lensView(seqLens, putGetSequence)

if (retrievedSeqVal != targetNewSeqVal) {
    print("[FAIL] Test Case 2 Law 2 (Put-Get) violated on array sequence: expected ", targetNewSeqVal, " got ", retrievedSeqVal)
    testSuiteFailures = testSuiteFailures + 1
}

// Law 3: Put-Put (Idempotence / Overwrite) -> lensSet(l, v2, lensSet(l, v1, s)) == lensSet(l, v2, s)
firstCandidateVal = 1
finalCandidateVal = 5

intermediatePutRecord = lensSet(optLevelLens, firstCandidateVal, testRecordAlpha)
doublePutRecord = lensSet(optLevelLens, finalCandidateVal, intermediatePutRecord)
directPutRecord = lensSet(optLevelLens, finalCandidateVal, testRecordAlpha)

if (deepMapEquals(doublePutRecord, directPutRecord) == 0) {
    print("[FAIL] Test Case 2 Law 3 (Put-Put) violated on map record")
    testSuiteFailures = testSuiteFailures + 1
}

firstCandidateSeqVal = 77
finalCandidateSeqVal = 88

intermediatePutSeq = lensSet(seqLens, firstCandidateSeqVal, testSequenceAlpha)
doublePutSeq = lensSet(seqLens, finalCandidateSeqVal, intermediatePutSeq)
directPutSeq = lensSet(seqLens, finalCandidateSeqVal, testSequenceAlpha)

if (deepArrayEquals(doublePutSeq, directPutSeq) == 0) {
    print("[FAIL] Test Case 2 Law 3 (Put-Put) violated on array sequence")
    testSuiteFailures = testSuiteFailures + 1
}

// Canonical Lens Laws on Composed Nested Structure
nestedGeoRecord = {
    "location": {
        "city": "Tokyo",
        "zipCode": 1000001
    }
}

locationLens = createPropLens("location")
cityLens = createPropLens("city")
composedCityLens = createComposeLens(locationLens, cityLens)

// Nested Law 1: Get-Put
currentCityVal = lensView(composedCityLens, nestedGeoRecord)
nestedIdentityRecord = lensSet(composedCityLens, currentCityVal, nestedGeoRecord)
if (deepMapEquals(nestedIdentityRecord["location"], nestedGeoRecord["location"]) == 0) {
    print("[FAIL] Test Case 2 Nested Law 1 (Get-Put) violated")
    testSuiteFailures = testSuiteFailures + 1
}

// Nested Law 2: Put-Get
nestedPutGetRecord = lensSet(composedCityLens, "Kyoto", nestedGeoRecord)
if (lensView(composedCityLens, nestedPutGetRecord) != "Kyoto") {
    print("[FAIL] Test Case 2 Nested Law 2 (Put-Get) violated")
    testSuiteFailures = testSuiteFailures + 1
}

// Nested Law 3: Put-Put
nestedDoublePutRecord = lensSet(composedCityLens, "Osaka", nestedPutGetRecord)
nestedDirectPutRecord = lensSet(composedCityLens, "Osaka", nestedGeoRecord)
if (deepMapEquals(nestedDoublePutRecord["location"], nestedDirectPutRecord["location"]) == 0) {
    print("[FAIL] Test Case 2 Nested Law 3 (Put-Put) violated")
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 2 Passed canonical lens laws (Get-Put, Put-Get, Put-Put) verification")

// --- Test Case 3: Binary & Multi-Lens Composition with Heterogeneous Structures ---

print("--- Running Test Case 3: Multi-Lens Composition with Heterogeneous Structures ---")

svcOneA = {"serviceName": "httpGateway", "port": 8080, "protocol": "tcp"}
svcOneB = {"serviceName": "metricsExporter", "port": 9100, "protocol": "http"}
nodeOneServices = [svcOneA, svcOneB]
nodeOne = {"nodeId": "worker-1", "services": nodeOneServices, "healthy": 1}

svcZeroA = {"serviceName": "dnsProxy", "port": 53, "protocol": "udp"}
nodeZeroServices = [svcZeroA]
nodeZero = {"nodeId": "worker-0", "services": nodeZeroServices, "healthy": 1}

clusterNodes = [nodeZero, nodeOne]
clusterRecord = {
    "clusterId": "stellarum-cluster-alpha",
    "region": "ap-southeast-1",
    "nodes": clusterNodes
}

// Compose multi-step lens: cluster -> nodes -> index 1 -> services -> index 0 -> port
multiLensChain = [
    createPropLens("nodes"),
    createIndexLens(1),
    createPropLens("services"),
    createIndexLens(0),
    createPropLens("port")
]
clusterServicePortLens = composeLensList(multiLensChain)

initialPort = lensView(clusterServicePortLens, clusterRecord)
if (initialPort != 8080) {
    print("[FAIL] Test Case 3 Initial port view mismatch: expected 8080, got ", initialPort)
    testSuiteFailures = testSuiteFailures + 1
}

updatedCluster = lensSet(clusterServicePortLens, 8443, clusterRecord)
modifiedCluster = lensModify(clusterServicePortLens, "add", 10, updatedCluster)

if (lensView(clusterServicePortLens, updatedCluster) != 8443) {
    print("[FAIL] Test Case 3 Updated cluster port mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

if (lensView(clusterServicePortLens, modifiedCluster) != 8453) {
    print("[FAIL] Test Case 3 Modified cluster port mismatch: expected 8453, got ", lensView(clusterServicePortLens, modifiedCluster))
    testSuiteFailures = testSuiteFailures + 1
}

// Invariance & Immutability checks: original clusterRecord remains unchanged
if (clusterRecord["nodes"][1]["services"][0]["port"] != 8080) {
    print("[FAIL] Test Case 3 Original clusterRecord mutated in-place")
    testSuiteFailures = testSuiteFailures + 1
}

// Sibling data integrity checks
if (updatedCluster["region"] != "ap-southeast-1" or updatedCluster["clusterId"] != "stellarum-cluster-alpha") {
    print("[FAIL] Test Case 3 Root sibling fields corrupted")
    testSuiteFailures = testSuiteFailures + 1
}

if (updatedCluster["nodes"][0]["services"][0]["port"] != 53) {
    print("[FAIL] Test Case 3 Sibling node 0 corrupted")
    testSuiteFailures = testSuiteFailures + 1
}

if (updatedCluster["nodes"][1]["services"][1]["port"] != 9100) {
    print("[FAIL] Test Case 3 Sibling service 1 on node 1 corrupted")
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 3 Passed multi-lens composition with heterogeneous structures verification")

suiteElapsedTime = t.millis() - suiteStartTime
print("Progress elapsed time: ", suiteElapsedTime, " ms")
