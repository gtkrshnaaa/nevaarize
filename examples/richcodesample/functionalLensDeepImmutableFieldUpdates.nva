import stdlib time as t

// Functional Lens Deep Immutable Field Updates Suite
// Technical characteristics:
// - Composable bidirectional functional lenses (getters, setters, modifiers)
// - Pure immutability: deep record updates without in-place mutation
// - Path copying with fine-grained structural sharing on untouched subtrees
// - Support for heterogeneous nesting (records inside records, records inside arrays)
// - Compositional lens combinators (binary composeLens and n-ary composeLensList)
// - Deterministic verification of canonical Lens Laws (Get-Put, Put-Get, Put-Put)
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero AI artifacts, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Functional Lens Deep Immutable Field Updates Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Shallow Copy and Structural Utilities ---

func shallowCopyMap(srcMap) {
    newMap = {}
    for (k in srcMap.keys()) {
        newMap[k] = srcMap[k]
    }
    return newMap
}

func shallowCopyArray(srcArr) {
    newArr = []
    idx = 0
    sz = srcArr.size()
    while (idx < sz) {
        newArr.push(srcArr[idx])
        idx = idx + 1
    }
    return newArr
}

func applyLensModifier(opCode, operand, currentVal) {
    if (opCode == "add") {
        return currentVal + operand
    }
    if (opCode == "sub") {
        return currentVal - operand
    }
    if (opCode == "mul") {
        return currentVal * operand
    }
    if (opCode == "concat") {
        return currentVal + operand
    }
    if (opCode == "toggle") {
        if (currentVal == 1) {
            return 0
        }
        return 1
    }
    if (opCode == "replace") {
        return operand
    }
    return currentVal
}

// --- Deep Structural Equality Comparators ---

func deepMapEquals(firstMap, secondMap) {
    keysFirst = firstMap.keys()
    keysSecond = secondMap.keys()
    if (keysFirst.size() != keysSecond.size()) {
        return 0
    }
    for (k in keysFirst) {
        if (secondMap.has(k) == 0) {
            return 0
        }
        valFirst = firstMap[k]
        valSecond = secondMap[k]
        if (valFirst != valSecond) {
            return 0
        }
    }
    return 1
}

func deepArrayEquals(firstArr, secondArr) {
    szFirst = firstArr.size()
    szSecond = secondArr.size()
    if (szFirst != szSecond) {
        return 0
    }
    idx = 0
    while (idx < szFirst) {
        if (firstArr[idx] != secondArr[idx]) {
            return 0
        }
        idx = idx + 1
    }
    return 1
}

// --- Primitive Lens Constructors ---

func createIdentityLens() {
    return {"kind": "identity"}
}

func createPropLens(propName) {
    return {"kind": "prop", "prop": propName}
}

func createIndexLens(targetIndex) {
    return {"kind": "index", "index": targetIndex}
}

func createComposeLens(outerLens, innerLens) {
    return {"kind": "compose", "outer": outerLens, "inner": innerLens}
}

func composeLensList(lensesList) {
    totalLenses = lensesList.size()
    if (totalLenses == 0) {
        return createIdentityLens()
    }
    compositeLens = lensesList[totalLenses - 1]
    stepIdx = totalLenses - 2
    while (stepIdx >= 0) {
        currentLens = lensesList[stepIdx]
        compositeLens = createComposeLens(currentLens, compositeLens)
        stepIdx = stepIdx - 1
    }
    return compositeLens
}

// --- Core Lens Evaluation Engine ---

func lensView(targetLens, dataStructure) {
    lensKind = targetLens["kind"]
    if (lensKind == "identity") {
        return dataStructure
    }
    if (lensKind == "prop") {
        propKey = targetLens["prop"]
        return dataStructure[propKey]
    }
    if (lensKind == "index") {
        elemIdx = targetLens["index"]
        return dataStructure[elemIdx]
    }
    if (lensKind == "compose") {
        outerLens = targetLens["outer"]
        innerLens = targetLens["inner"]
        intermediateData = lensView(outerLens, dataStructure)
        return lensView(innerLens, intermediateData)
    }
    return dataStructure
}

func lensSet(targetLens, newValue, dataStructure) {
    lensKind = targetLens["kind"]
    if (lensKind == "identity") {
        return newValue
    }
    if (lensKind == "prop") {
        propKey = targetLens["prop"]
        copiedRecord = shallowCopyMap(dataStructure)
        copiedRecord[propKey] = newValue
        return copiedRecord
    }
    if (lensKind == "index") {
        elemIdx = targetLens["index"]
        copiedSequence = shallowCopyArray(dataStructure)
        copiedSequence[elemIdx] = newValue
        return copiedSequence
    }
    if (lensKind == "compose") {
        outerLens = targetLens["outer"]
        innerLens = targetLens["inner"]
        subStructure = lensView(outerLens, dataStructure)
        updatedSubStructure = lensSet(innerLens, newValue, subStructure)
        return lensSet(outerLens, updatedSubStructure, dataStructure)
    }
    return dataStructure
}

func lensModify(targetLens, opCode, operand, dataStructure) {
    currentFocus = lensView(targetLens, dataStructure)
    computedFocus = applyLensModifier(opCode, operand, currentFocus)
    return lensSet(targetLens, computedFocus, dataStructure)
}

// --- Test Case 1: Primitive Prop and Index Lenses ---

print("--- Running Test Case 1: Primitive Prop and Index Lenses ---")

initialUserRecord = {
    "userName": "aurum",
    "role": "lead",
    "accessLevel": 9
}

nameLens = createPropLens("userName")
levelLens = createPropLens("accessLevel")

viewedName = lensView(nameLens, initialUserRecord)
viewedLevel = lensView(levelLens, initialUserRecord)

if (viewedName != "aurum" or viewedLevel != 9) {
    print("[FAIL] Test Case 1 Primitive prop lens view failed: name=", viewedName, " level=", viewedLevel)
    testSuiteFailures = testSuiteFailures + 1
}

updatedUserRecord = lensSet(nameLens, "pyroxene", initialUserRecord)
updatedLevelRecord = lensModify(levelLens, "add", 3, updatedUserRecord)

if (lensView(nameLens, updatedUserRecord) != "pyroxene") {
    print("[FAIL] Test Case 1 Updated record userName mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

if (lensView(levelLens, updatedLevelRecord) != 12) {
    print("[FAIL] Test Case 1 Modified record accessLevel mismatch: expected 12, got ", lensView(levelLens, updatedLevelRecord))
    testSuiteFailures = testSuiteFailures + 1
}

// Verify original record was never mutated in-place
if (initialUserRecord["userName"] != "aurum" or initialUserRecord["accessLevel"] != 9) {
    print("[FAIL] Test Case 1 Immutability violated on initialUserRecord")
    testSuiteFailures = testSuiteFailures + 1
}

// Verify array index lens primitives
initialArray = [100, 200, 300, 400]
firstSlotLens = createIndexLens(0)
thirdSlotLens = createIndexLens(2)

if (lensView(firstSlotLens, initialArray) != 100 or lensView(thirdSlotLens, initialArray) != 300) {
    print("[FAIL] Test Case 1 Index lens view mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

updatedArray = lensSet(thirdSlotLens, 777, initialArray)
modifiedArray = lensModify(firstSlotLens, "mul", 5, updatedArray)

if (lensView(thirdSlotLens, updatedArray) != 777 or lensView(firstSlotLens, modifiedArray) != 500) {
    print("[FAIL] Test Case 1 Array index set or modify failed")
    testSuiteFailures = testSuiteFailures + 1
}

if (initialArray[0] != 100 or initialArray[2] != 300) {
    print("[FAIL] Test Case 1 Array immutability violated on initialArray")
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 1 Passed primitive prop and index lens verification")

suiteElapsedTime = t.millis() - suiteStartTime
print("Progress elapsed time: ", suiteElapsedTime, " ms")
