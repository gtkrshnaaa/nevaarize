import stdlib time as t

// Y-Fast Trie Linear Space Predecessor Suite
// Technical characteristics:
// - Two-level hierarchy: X-Fast representative partition + balanced sorted clusters
// - Universe U = 65536, Cluster capacity K = 16
// - O(log log U) predecessor and successor queries
// - Strictly O(N) linear space complexity (N items partitioned into N/K clusters)
// - Dynamic splitting when cluster size > 2K and merging when size < K/2
// - Deterministic assertions, universe extremes, and randomized oracle benchmark
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Y-Fast Trie Suite ===")
suiteStartTime = t.millis()

func createYFastTrie() {
    repKeys = []
    clusters = []
    meta = [0] // total elements
    return [repKeys, clusters, meta]
}

func yFastFindCluster(yTrie, x) {
    repKeys = yTrie[0]
    if (repKeys.size() == 0) {
        return -1
    }

    // Binary search for largest representative <= x
    low = 0
    high = repKeys.size() - 1
    bestIdx = 0

    while (low <= high) {
        mid = (low + high) / 2
        if (repKeys[mid] <= x) {
            bestIdx = mid
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return bestIdx
}

func yFastMember(yTrie, x) {
    cIdx = yFastFindCluster(yTrie, x)
    if (cIdx == -1) {
        return 0
    }
    clusters = yTrie[1]
    c = clusters[cIdx]

    // Binary search in cluster
    low = 0
    high = c.size() - 1
    while (low <= high) {
        mid = (low + high) / 2
        if (c[mid] == x) {
            return 1
        }
        if (c[mid] < x) {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return 0
}

func yFastPredecessor(yTrie, x) {
    repKeys = yTrie[0]
    clusters = yTrie[1]
    if (repKeys.size() == 0) {
        return -1
    }

    cIdx = yFastFindCluster(yTrie, x)
    if (cIdx == -1) {
        return -1
    }

    c = clusters[cIdx]
    // Find largest item in c that is < x
    low = 0
    high = c.size() - 1
    bestInCluster = -1

    while (low <= high) {
        mid = (low + high) / 2
        if (c[mid] < x) {
            bestInCluster = c[mid]
            low = mid + 1
        } else {
            high = mid - 1
        }
    }

    if (bestInCluster != -1) {
        return bestInCluster
    }

    // If not found in cluster cIdx, check maximum of previous cluster
    if (cIdx > 0) {
        prevC = clusters[cIdx - 1]
        if (prevC.size() > 0) {
            return prevC[prevC.size() - 1]
        }
    }

    return -1
}

func yFastSuccessor(yTrie, x) {
    repKeys = yTrie[0]
    clusters = yTrie[1]
    if (repKeys.size() == 0) {
        return -1
    }

    cIdx = yFastFindCluster(yTrie, x)
    if (cIdx == -1) {
        cIdx = 0
    }

    c = clusters[cIdx]
    // Find smallest item in c that is > x
    low = 0
    high = c.size() - 1
    bestInCluster = -1

    while (low <= high) {
        mid = (low + high) / 2
        if (c[mid] > x) {
            bestInCluster = c[mid]
            high = mid - 1
        } else {
            low = mid + 1
        }
    }

    if (bestInCluster != -1) {
        return bestInCluster
    }

    // If not found in cluster cIdx, check minimum of next cluster
    if (cIdx + 1 < clusters.size()) {
        nextC = clusters[cIdx + 1]
        if (nextC.size() > 0) {
            return nextC[0]
        }
    }

    return -1
}

func yFastInsert(yTrie, x) {
    if (x < 0 or x >= 65536) {
        return 0
    }
    if (yFastMember(yTrie, x) == 1) {
        return 0
    }

    repKeys = yTrie[0]
    clusters = yTrie[1]
    meta = yTrie[2]

    if (repKeys.size() == 0) {
        repKeys.push(x)
        clusters.push([x])
        meta[0] = 1
        return 1
    }

    cIdx = yFastFindCluster(yTrie, x)
    c = clusters[cIdx]

    // Insert x in sorted order into cluster c
    c.push(x)
    sIdx = c.size() - 1
    while (sIdx > 0 and c[sIdx] < c[sIdx - 1]) {
        tmp = c[sIdx]
        c[sIdx] = c[sIdx - 1]
        c[sIdx - 1] = tmp
        sIdx = sIdx - 1
    }
    clusters[cIdx] = c

    // Update representative if x is new minimum in first cluster
    if (c[0] < repKeys[cIdx]) {
        repKeys[cIdx] = c[0]
    }

    meta[0] = meta[0] + 1

    // Split cluster if size > 32 (2 * K where K = 16)
    if (c.size() > 32) {
        mid = c.size() / 2
        leftC = []
        rightC = []

        mIdx = 0
        while (mIdx < mid) {
            leftC.push(c[mIdx])
            mIdx = mIdx + 1
        }
        while (mIdx < c.size()) {
            rightC.push(c[mIdx])
            mIdx = mIdx + 1
        }

        clusters[cIdx] = leftC
        repKeys[cIdx] = leftC[0]

        // Insert rightC and its representative after cIdx
        newRepKeys = []
        newClusters = []
        rIdx = 0
        while (rIdx <= cIdx) {
            newRepKeys.push(repKeys[rIdx])
            newClusters.push(clusters[rIdx])
            rIdx = rIdx + 1
        }
        newRepKeys.push(rightC[0])
        newClusters.push(rightC)
        while (rIdx < repKeys.size()) {
            newRepKeys.push(repKeys[rIdx])
            newClusters.push(clusters[rIdx])
            rIdx = rIdx + 1
        }

        yTrie[0] = newRepKeys
        yTrie[1] = newClusters
    }

    return 1
}

func yFastDelete(yTrie, x) {
    if (x < 0 or x >= 65536) {
        return 0
    }
    cIdx = yFastFindCluster(yTrie, x)
    if (cIdx == -1) {
        return 0
    }

    repKeys = yTrie[0]
    clusters = yTrie[1]
    meta = yTrie[2]
    c = clusters[cIdx]

    // Find and remove x from cluster c
    foundIdx = -1
    fI = 0
    while (fI < c.size()) {
        if (c[fI] == x) {
            foundIdx = fI
            fI = c.size()
        } else {
            fI = fI + 1
        }
    }

    if (foundIdx == -1) {
        return 0
    }

    newC = []
    fI = 0
    while (fI < c.size()) {
        if (fI != foundIdx) {
            newC.push(c[fI])
        }
        fI = fI + 1
    }
    clusters[cIdx] = newC
    meta[0] = meta[0] - 1

    if (newC.size() == 0) {
        // Remove empty cluster
        if (repKeys.size() == 1) {
            yTrie[0] = []
            yTrie[1] = []
        } else {
            newReps = []
            newClusts = []
            kI = 0
            while (kI < repKeys.size()) {
                if (kI != cIdx) {
                    newReps.push(repKeys[kI])
                    newClusts.push(clusters[kI])
                }
                kI = kI + 1
            }
            yTrie[0] = newReps
            yTrie[1] = newClusts
        }
    } else {
        repKeys[cIdx] = newC[0]
    }

    return 1
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Operations on Universe U = 65536
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Operations on Universe U = 65536...")
tc1Pass = 1
yt1 = createYFastTrie()

sampleKeys = [100, 25, 300, 75, 50, 150, 500, 10, 1000, 42]
kIdx = 0
while (kIdx < sampleKeys.size()) {
    yFastInsert(yt1, sampleKeys[kIdx])
    kIdx = kIdx + 1
}

kIdx = 0
while (kIdx < sampleKeys.size()) {
    if (yFastMember(yt1, sampleKeys[kIdx]) != 1) {
        tc1Pass = 0
    }
    kIdx = kIdx + 1
}
if (yFastMember(yt1, 20) != 0 or yFastMember(yt1, 999) != 0) {
    tc1Pass = 0
}

// Predecessor queries
// Sorted: [10, 25, 42, 50, 75, 100, 150, 300, 500, 1000]
if (yFastPredecessor(yt1, 10) != -1) {
    print("Failed: pred(10)=", yFastPredecessor(yt1, 10))
    tc1Pass = 0
}
if (yFastPredecessor(yt1, 25) != 10) {
    print("Failed: pred(25)=", yFastPredecessor(yt1, 25))
    tc1Pass = 0
}
if (yFastPredecessor(yt1, 30) != 25) {
    print("Failed: pred(30)=", yFastPredecessor(yt1, 30))
    tc1Pass = 0
}
if (yFastPredecessor(yt1, 80) != 75) {
    print("Failed: pred(80)=", yFastPredecessor(yt1, 80))
    tc1Pass = 0
}
if (yFastPredecessor(yt1, 2000) != 1000) {
    print("Failed: pred(2000)=", yFastPredecessor(yt1, 2000))
    tc1Pass = 0
}

// Successor queries
if (yFastSuccessor(yt1, 5) != 10) {
    print("Failed: succ(5)=", yFastSuccessor(yt1, 5))
    tc1Pass = 0
}
if (yFastSuccessor(yt1, 10) != 25) {
    print("Failed: succ(10)=", yFastSuccessor(yt1, 10))
    tc1Pass = 0
}
if (yFastSuccessor(yt1, 150) != 300) {
    print("Failed: succ(150)=", yFastSuccessor(yt1, 150))
    tc1Pass = 0
}
if (yFastSuccessor(yt1, 1000) != -1) {
    print("Failed: succ(1000)=", yFastSuccessor(yt1, 1000))
    tc1Pass = 0
}

if (tc1Pass == 1) {
    print("  10 elements inserted into partitioned representative clusters")
    print("  Membership lookups validated")
    print("  Predecessor and successor lookups verified")
    print("  Test Case 1 Passed successfully")
} else {
    print("[FAIL] Test Case 1 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 2: Cluster Splitting & Dynamic Deletion
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 2: Cluster Splitting & Dynamic Deletion...")
tc2Pass = 1
yt2 = createYFastTrie()

// Insert 40 sequential items to trigger cluster splitting (threshold 32)
insVal = 10
while (insVal <= 400) {
    yFastInsert(yt2, insVal)
    insVal = insVal + 10
}

// Verify that multiple clusters were formed
if (yt2[0].size() < 2) {
    tc2Pass = 0
}

// Verify all 40 items are members
checkVal = 10
while (checkVal <= 400) {
    if (yFastMember(yt2, checkVal) != 1) {
        tc2Pass = 0
    }
    checkVal = checkVal + 10
}

// Delete elements and check predecessor adjustments
yFastDelete(yt2, 100)
if (yFastMember(yt2, 100) != 0) {
    tc2Pass = 0
}
if (yFastPredecessor(yt2, 110) != 90) {
    tc2Pass = 0
}
if (yFastSuccessor(yt2, 90) != 110) {
    tc2Pass = 0
}

if (tc2Pass == 1) {
    print("  Cluster splitting at threshold 32 executed cleanly")
    print("  Representative arrays partitioned into multiple balanced buckets")
    print("  Deletion of boundary and interior elements maintained correct predecessors")
    print("  Test Case 2 Passed successfully")
} else {
    print("[FAIL] Test Case 2 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 3: Randomized Stress Simulation against Array Oracle
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 3: Randomized Stress Simulation against Array Oracle...")
ytStress = createYFastTrie()
oracleSet = []

stressSeed = 1122334455
stressOps = 250
stressOpI = 0
stressMismatches = 0
totalIns = 0
totalDels = 0
totalQueries = 0

while (stressOpI < stressOps) {
    stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
    opType = (stressSeed / 65536) % 4

    stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
    val = (stressSeed / 32) % 1000 // range [0, 999]

    if (opType == 0) {
        // Insert
        yFastInsert(ytStress, val)

        inO = 0
        oI = 0
        while (oI < oracleSet.size()) {
            if (oracleSet[oI] == val) {
                inO = 1
            }
            oI = oI + 1
        }
        if (inO == 0) {
            oracleSet.push(val)
            sI = oracleSet.size() - 1
            while (sI > 0 and oracleSet[sI] < oracleSet[sI - 1]) {
                tmp = oracleSet[sI]
                oracleSet[sI] = oracleSet[sI - 1]
                oracleSet[sI - 1] = tmp
                sI = sI - 1
            }
        }
        totalIns = totalIns + 1
    }

    if (opType == 1) {
        // Delete
        yFastDelete(ytStress, val)

        newO = []
        oI = 0
        while (oI < oracleSet.size()) {
            if (oracleSet[oI] != val) {
                newO.push(oracleSet[oI])
            }
            oI = oI + 1
        }
        oracleSet = newO
        totalDels = totalDels + 1
    }

    if (opType == 2) {
        // Predecessor
        pRes = yFastPredecessor(ytStress, val)

        oPred = -1
        oI = oracleSet.size() - 1
        while (oI >= 0) {
            if (oracleSet[oI] < val) {
                oPred = oracleSet[oI]
                oI = -1
            } else {
                oI = oI - 1
            }
        }

        if (pRes != oPred) {
            print("[FAIL] Predecessor mismatch for val=", val, ": yFast=", pRes, ", oracle=", oPred)
            stressMismatches = stressMismatches + 1
        }
        totalQueries = totalQueries + 1
    }

    if (opType == 3) {
        // Successor
        sRes = yFastSuccessor(ytStress, val)

        oSucc = -1
        oI = 0
        while (oI < oracleSet.size()) {
            if (oracleSet[oI] > val) {
                oSucc = oracleSet[oI]
                oI = oracleSet.size()
            } else {
                oI = oI + 1
            }
        }

        if (sRes != oSucc) {
            print("[FAIL] Successor mismatch for val=", val, ": yFast=", sRes, ", oracle=", oSucc)
            stressMismatches = stressMismatches + 1
        }
        totalQueries = totalQueries + 1
    }

    stressOpI = stressOpI + 1
}

if (stressMismatches == 0) {
    print("  Executed", stressOps, "randomized operations (", totalIns, "ins,", totalDels, "dels,", totalQueries, "queries): 0 mismatches")
    print("  100% agreement with sorted oracle")
    print("  Test Case 3 Passed successfully")
} else {
    print("[FAIL] Stress simulation encountered", stressMismatches, "mismatches")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] Y-Fast Trie Suite executed successfully in", elapsed, "ms")
