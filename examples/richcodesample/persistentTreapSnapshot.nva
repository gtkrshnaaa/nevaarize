import stdlib time as t

// Persistent Cartesian Tree (Treap) Dynamic Snapshot Engine
// Technical characteristics:
// - Functional persistence via node path copying in O(log N) time and space
// - Logarithmic split and merge primitives preserving immutable historical snapshots
// - Max-heap priority ordering with deterministic pseudo-random generator
// - Binary search tree key invariant with dynamic range aggregates (sum, min, max, count)
// - Subtree order statistics: k-th smallest element and rank determination in O(log N)
// - Parallel arena allocation for cache locality and zero reference overhead
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Persistent Treap Snapshot Suite ===")
suiteStartTime = t.millis()

func minInt(aInt, bInt) {
    if (aInt < bInt) {
        return aInt
    }
    return bInt
}

func maxInt(aInt, bInt) {
    if (aInt > bInt) {
        return aInt
    }
    return bInt
}

func createTreapArena() {
    tKey = []
    tVal = []
    tPrio = []
    tSize = []
    tLeft = []
    tRight = []
    tSum = []
    tMin = []
    tMax = []
    return [tKey, tVal, tPrio, tSize, tLeft, tRight, tSum, tMin, tMax]
}

func getSize(arena, node) {
    if (node == -1) {
        return 0
    }
    tSize = arena[3]
    return tSize[node]
}

func getSum(arena, node) {
    if (node == -1) {
        return 0
    }
    tSum = arena[6]
    return tSum[node]
}

func getMin(arena, node) {
    if (node == -1) {
        return 2147483647
    }
    tMin = arena[7]
    return tMin[node]
}

func getMax(arena, node) {
    if (node == -1) {
        return -2147483648
    }
    tMax = arena[8]
    return tMax[node]
}

func allocTreapNode(arena, key, val, prio, leftChild, rightChild) {
    tKey = arena[0]
    tVal = arena[1]
    tPrio = arena[2]
    tSize = arena[3]
    tLeft = arena[4]
    tRight = arena[5]
    tSum = arena[6]
    tMin = arena[7]
    tMax = arena[8]

    sz = 1
    s = val
    mn = val
    mx = val

    if (leftChild != -1) {
        sz = sz + tSize[leftChild]
        s = s + tSum[leftChild]
        mn = minInt(mn, tMin[leftChild])
        mx = maxInt(mx, tMax[leftChild])
    }
    if (rightChild != -1) {
        sz = sz + tSize[rightChild]
        s = s + tSum[rightChild]
        mn = minInt(mn, tMin[rightChild])
        mx = maxInt(mx, tMax[rightChild])
    }

    nodeId = tKey.size()
    tKey.push(key)
    tVal.push(val)
    tPrio.push(prio)
    tSize.push(sz)
    tLeft.push(leftChild)
    tRight.push(rightChild)
    tSum.push(s)
    tMin.push(mn)
    tMax.push(mx)

    arena[0] = tKey
    arena[1] = tVal
    arena[2] = tPrio
    arena[3] = tSize
    arena[4] = tLeft
    arena[5] = tRight
    arena[6] = tSum
    arena[7] = tMin
    arena[8] = tMax
    return nodeId
}

func cloneNode(arena, srcId, newLeft, newRight) {
    if (srcId == -1) {
        return -1
    }
    tKey = arena[0]
    tVal = arena[1]
    tPrio = arena[2]
    return allocTreapNode(arena, tKey[srcId], tVal[srcId], tPrio[srcId], newLeft, newRight)
}

func split(arena, root, splitKey, outPair) {
    if (root == -1) {
        outPair[0] = -1
        outPair[1] = -1
        return
    }
    tKey = arena[0]
    tLeft = arena[4]
    tRight = arena[5]

    nodeKey = tKey[root]
    lc = tLeft[root]
    rc = tRight[root]

    if (nodeKey <= splitKey) {
        subPair = [-1, -1]
        split(arena, rc, splitKey, subPair)
        newRoot = cloneNode(arena, root, lc, subPair[0])
        outPair[0] = newRoot
        outPair[1] = subPair[1]
    } else {
        subPair = [-1, -1]
        split(arena, lc, splitKey, subPair)
        newRoot = cloneNode(arena, root, subPair[1], rc)
        outPair[0] = subPair[0]
        outPair[1] = newRoot
    }
}

func merge(arena, leftRoot, rightRoot) {
    if (leftRoot == -1) {
        return rightRoot
    }
    if (rightRoot == -1) {
        return leftRoot
    }
    tPrio = arena[2]
    tLeft = arena[4]
    tRight = arena[5]

    prioL = tPrio[leftRoot]
    prioR = tPrio[rightRoot]

    if (prioL >= prioR) {
        newRc = merge(arena, tRight[leftRoot], rightRoot)
        return cloneNode(arena, leftRoot, tLeft[leftRoot], newRc)
    } else {
        newLc = merge(arena, leftRoot, tLeft[rightRoot])
        return cloneNode(arena, rightRoot, newLc, tRight[rightRoot])
    }
}

func insertKey(arena, root, key, val, prio) {
    p1 = [-1, -1]
    split(arena, root, key - 1, p1)
    p2 = [-1, -1]
    split(arena, p1[1], key, p2)

    newNode = allocTreapNode(arena, key, val, prio, -1, -1)
    m1 = merge(arena, p1[0], newNode)
    return merge(arena, m1, p2[1])
}

func deleteKey(arena, root, key) {
    p1 = [-1, -1]
    split(arena, root, key - 1, p1)
    p2 = [-1, -1]
    split(arena, p1[1], key, p2)
    return merge(arena, p1[0], p2[1])
}

func lookupKey(arena, root, key) {
    curr = root
    tKey = arena[0]
    tVal = arena[1]
    tLeft = arena[4]
    tRight = arena[5]
    while (curr != -1) {
        k = tKey[curr]
        if (key == k) {
            return tVal[curr]
        }
        if (key < k) {
            curr = tLeft[curr]
        } else {
            curr = tRight[curr]
        }
    }
    return -1
}

func containsKey(arena, root, key) {
    curr = root
    tKey = arena[0]
    tLeft = arena[4]
    tRight = arena[5]
    while (curr != -1) {
        k = tKey[curr]
        if (key == k) {
            return 1
        }
        if (key < k) {
            curr = tLeft[curr]
        } else {
            curr = tRight[curr]
        }
    }
    return 0
}

func treeToKeys(arena, root) {
    res = []
    if (root == -1) {
        return res
    }
    stack = []
    curr = root
    tLeft = arena[4]
    tRight = arena[5]
    tKey = arena[0]
    while (curr != -1 or stack.size() > 0) {
        while (curr != -1) {
            stack.push(curr)
            curr = tLeft[curr]
        }
        topIdx = stack.size() - 1
        curr = stack[topIdx]
        stack.pop()
        res.push(tKey[curr])
        curr = tRight[curr]
    }
    return res
}

func treeToValues(arena, root) {
    res = []
    if (root == -1) {
        return res
    }
    stack = []
    curr = root
    tLeft = arena[4]
    tRight = arena[5]
    tVal = arena[1]
    while (curr != -1 or stack.size() > 0) {
        while (curr != -1) {
            stack.push(curr)
            curr = tLeft[curr]
        }
        topIdx = stack.size() - 1
        curr = stack[topIdx]
        stack.pop()
        res.push(tVal[curr])
        curr = tRight[curr]
    }
    return res
}

func nextRand(state) {
    s = state[0]
    s = (s * 1103515245 + 12345) % 2147483648
    if (s < 0) {
        s = 0 - s
    }
    state[0] = s
    return s
}

func splitRange(arena, root, lowKey, highKey, outTriple) {
    p1 = [-1, -1]
    split(arena, root, lowKey - 1, p1)
    p2 = [-1, -1]
    split(arena, p1[1], highKey, p2)
    outTriple[0] = p1[0]
    outTriple[1] = p2[0]
    outTriple[2] = p2[1]
}

func queryRangeSum(arena, root, lowKey, highKey) {
    if (root == -1 or lowKey > highKey) {
        return 0
    }
    tKey = arena[0]
    tVal = arena[1]
    tLeft = arena[4]
    tRight = arena[5]
    nodeKey = tKey[root]
    s = 0
    if (nodeKey >= lowKey and nodeKey <= highKey) {
        s = s + tVal[root]
    }
    if (nodeKey > lowKey and tLeft[root] != -1) {
        s = s + queryRangeSum(arena, tLeft[root], lowKey, highKey)
    }
    if (nodeKey < highKey and tRight[root] != -1) {
        s = s + queryRangeSum(arena, tRight[root], lowKey, highKey)
    }
    return s
}

func queryRangeMin(arena, root, lowKey, highKey) {
    if (root == -1 or lowKey > highKey) {
        return 2147483647
    }
    tKey = arena[0]
    tVal = arena[1]
    tLeft = arena[4]
    tRight = arena[5]
    nodeKey = tKey[root]
    mn = 2147483647
    if (nodeKey >= lowKey and nodeKey <= highKey) {
        mn = tVal[root]
    }
    if (nodeKey > lowKey and tLeft[root] != -1) {
        leftMin = queryRangeMin(arena, tLeft[root], lowKey, highKey)
        mn = minInt(mn, leftMin)
    }
    if (nodeKey < highKey and tRight[root] != -1) {
        rightMin = queryRangeMin(arena, tRight[root], lowKey, highKey)
        mn = minInt(mn, rightMin)
    }
    return mn
}

func queryRangeMax(arena, root, lowKey, highKey) {
    if (root == -1 or lowKey > highKey) {
        return -2147483648
    }
    tKey = arena[0]
    tVal = arena[1]
    tLeft = arena[4]
    tRight = arena[5]
    nodeKey = tKey[root]
    mx = -2147483648
    if (nodeKey >= lowKey and nodeKey <= highKey) {
        mx = tVal[root]
    }
    if (nodeKey > lowKey and tLeft[root] != -1) {
        leftMax = queryRangeMax(arena, tLeft[root], lowKey, highKey)
        mx = maxInt(mx, leftMax)
    }
    if (nodeKey < highKey and tRight[root] != -1) {
        rightMax = queryRangeMax(arena, tRight[root], lowKey, highKey)
        mx = maxInt(mx, rightMax)
    }
    return mx
}

func queryRangeCount(arena, root, lowKey, highKey) {
    if (root == -1 or lowKey > highKey) {
        return 0
    }
    tKey = arena[0]
    tLeft = arena[4]
    tRight = arena[5]
    nodeKey = tKey[root]
    cnt = 0
    if (nodeKey >= lowKey and nodeKey <= highKey) {
        cnt = 1
    }
    if (nodeKey > lowKey and tLeft[root] != -1) {
        cnt = cnt + queryRangeCount(arena, tLeft[root], lowKey, highKey)
    }
    if (nodeKey < highKey and tRight[root] != -1) {
        cnt = cnt + queryRangeCount(arena, tRight[root], lowKey, highKey)
    }
    return cnt
}

func findKthSmallest(arena, root, k, outPair) {
    if (root == -1 or k <= 0 or k > getSize(arena, root)) {
        outPair[0] = -1
        outPair[1] = -1
        return
    }
    tKey = arena[0]
    tVal = arena[1]
    tLeft = arena[4]
    tRight = arena[5]
    lc = tLeft[root]
    leftSize = getSize(arena, lc)
    if (k <= leftSize) {
        findKthSmallest(arena, lc, k, outPair)
        return
    }
    if (k == leftSize + 1) {
        outPair[0] = tKey[root]
        outPair[1] = tVal[root]
        return
    }
    rc = tRight[root]
    findKthSmallest(arena, rc, k - leftSize - 1, outPair)
}

func findRank(arena, root, key) {
    if (root == -1) {
        return 1
    }
    tKey = arena[0]
    tLeft = arena[4]
    tRight = arena[5]
    nodeKey = tKey[root]
    if (key <= nodeKey) {
        return findRank(arena, tLeft[root], key)
    } else {
        leftSize = getSize(arena, tLeft[root])
        return leftSize + 1 + findRank(arena, tRight[root], key)
    }
}

func verifyTreapInvariants(arena, root) {
    if (root == -1) {
        return 1
    }
    // Verify strict in-order key monotonicity (BST Invariant)
    keys = treeToKeys(arena, root)
    kIdx = 1
    kLen = keys.size()
    while (kIdx < kLen) {
        if (keys[kIdx - 1] >= keys[kIdx]) {
            return 0
        }
        kIdx = kIdx + 1
    }

    // Verify heap property, size consistency, and range aggregates
    stack = []
    stack.push(root)

    tKey = arena[0]
    tVal = arena[1]
    tPrio = arena[2]
    tSize = arena[3]
    tLeft = arena[4]
    tRight = arena[5]
    tSum = arena[6]
    tMin = arena[7]
    tMax = arena[8]

    while (stack.size() > 0) {
        topIdx = stack.size() - 1
        curr = stack[topIdx]
        stack.pop()

        v = tVal[curr]
        p = tPrio[curr]
        sz = tSize[curr]
        s = tSum[curr]
        mn = tMin[curr]
        mx = tMax[curr]
        lc = tLeft[curr]
        rc = tRight[curr]

        expectedSz = 1
        expectedSum = v
        expectedMin = v
        expectedMax = v

        if (lc != -1) {
            // Max-Heap priority invariant
            if (p < tPrio[lc]) {
                return 0
            }
            expectedSz = expectedSz + tSize[lc]
            expectedSum = expectedSum + tSum[lc]
            expectedMin = minInt(expectedMin, tMin[lc])
            expectedMax = maxInt(expectedMax, tMax[lc])
            stack.push(lc)
        }

        if (rc != -1) {
            // Max-Heap priority invariant
            if (p < tPrio[rc]) {
                return 0
            }
            expectedSz = expectedSz + tSize[rc]
            expectedSum = expectedSum + tSum[rc]
            expectedMin = minInt(expectedMin, tMin[rc])
            expectedMax = maxInt(expectedMax, tMax[rc])
            stack.push(rc)
        }

        if (sz != expectedSz or s != expectedSum or mn != expectedMin or mx != expectedMax) {
            return 0
        }
    }
    return 1
}

func naiveInsert(kList, vList, key, val) {
    idx = 0
    sz = kList.size()
    found = 0
    while (idx < sz) {
        if (kList[idx] == key) {
            vList[idx] = val
            found = 1
            idx = sz
        } else {
            idx = idx + 1
        }
    }
    if (found == 0) {
        insertPos = 0
        while (insertPos < sz and kList[insertPos] < key) {
            insertPos = insertPos + 1
        }
        newK = []
        newV = []
        i = 0
        while (i < insertPos) {
            newK.push(kList[i])
            newV.push(vList[i])
            i = i + 1
        }
        newK.push(key)
        newV.push(val)
        while (i < sz) {
            newK.push(kList[i])
            newV.push(vList[i])
            i = i + 1
        }
        return [newK, newV]
    }
    return [kList, vList]
}

func naiveDelete(kList, vList, key) {
    newK = []
    newV = []
    idx = 0
    sz = kList.size()
    while (idx < sz) {
        if (kList[idx] != key) {
            newK.push(kList[idx])
            newV.push(vList[idx])
        }
        idx = idx + 1
    }
    return [newK, newV]
}

func cloneArray(src) {
    dst = []
    idx = 0
    sz = src.size()
    while (idx < sz) {
        dst.push(src[idx])
        idx = idx + 1
    }
    return dst
}



// -----------------------------------------------------------------------------
// Test Case 1: Sequential Version Updates and Historical Immutability
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Version Updates and Immutability...")
arena1 = createTreapArena()
rng1 = [42]

historyRoots = []
historyRoots.push(-1) // Version 0: Empty tree

// Version 1: Insert (15, 150)
v1 = insertKey(arena1, historyRoots[0], 15, 150, nextRand(rng1) % 100000)
historyRoots.push(v1)

// Version 2: Insert (10, 100)
v2 = insertKey(arena1, historyRoots[1], 10, 100, nextRand(rng1) % 100000)
historyRoots.push(v2)

// Version 3: Insert (25, 250)
v3 = insertKey(arena1, historyRoots[2], 25, 250, nextRand(rng1) % 100000)
historyRoots.push(v3)

// Version 4: Insert (5, 50)
v4 = insertKey(arena1, historyRoots[3], 5, 50, nextRand(rng1) % 100000)
historyRoots.push(v4)

// Version 5: Insert (20, 200)
v5 = insertKey(arena1, historyRoots[4], 20, 200, nextRand(rng1) % 100000)
historyRoots.push(v5)

// Version 6: Insert (30, 300)
v6 = insertKey(arena1, historyRoots[5], 30, 300, nextRand(rng1) % 100000)
historyRoots.push(v6)

// Version 7: Update key 15 with value 999
v7 = insertKey(arena1, historyRoots[6], 15, 999, nextRand(rng1) % 100000)
historyRoots.push(v7)

// Version 8: Delete key 10
v8 = deleteKey(arena1, historyRoots[7], 10)
historyRoots.push(v8)

// Version 9: Delete key 5
v9 = deleteKey(arena1, historyRoots[8], 5)
historyRoots.push(v9)

// Verify Version 0: Empty
if (getSize(arena1, historyRoots[0]) != 0) {
    print("[FAIL] Version 0 size mismatch")
}

// Verify Version 1
k1 = treeToKeys(arena1, historyRoots[1])
if (k1.size() != 1 or k1[0] != 15 or lookupKey(arena1, historyRoots[1], 15) != 150) {
    print("[FAIL] Version 1 validation mismatch")
} else {
    print("  Version 1 verified: size =", getSize(arena1, historyRoots[1]), ", sum =", getSum(arena1, historyRoots[1]))
}

// Verify Version 2
k2 = treeToKeys(arena1, historyRoots[2])
if (k2.size() != 2 or k2[0] != 10 or k2[1] != 15 or getSum(arena1, historyRoots[2]) != 250) {
    print("[FAIL] Version 2 validation mismatch")
} else {
    print("  Version 2 verified: keys [10, 15], sum = 250")
}

// Verify Version 5
k5 = treeToKeys(arena1, historyRoots[5])
if (k5.size() != 5 or getSum(arena1, historyRoots[5]) != 750 or getMin(arena1, historyRoots[5]) != 50 or getMax(arena1, historyRoots[5]) != 250) {
    print("[FAIL] Version 5 validation mismatch")
} else {
    print("  Version 5 verified: size = 5, sum = 750, min = 50, max = 250")
}

// Verify Version 6
if (getSize(arena1, historyRoots[6]) != 6 or getSum(arena1, historyRoots[6]) != 1050) {
    print("[FAIL] Version 6 validation mismatch")
} else {
    print("  Version 6 verified: size = 6, sum = 1050")
}

// Verify Version 7 updated key 15
if (lookupKey(arena1, historyRoots[7], 15) != 999 or getSum(arena1, historyRoots[7]) != 1899) {
    print("[FAIL] Version 7 update mismatch")
} else {
    print("  Version 7 update verified: key 15 value = 999, sum = 1899")
}

// Verify Historical Immutability on Version 6 (key 15 must still be 150)
if (lookupKey(arena1, historyRoots[6], 15) != 150 or getSum(arena1, historyRoots[6]) != 1050) {
    print("[FAIL] Version 6 corrupted after Version 7 update")
} else {
    print("  Version 6 historical immutability verified: key 15 remains 150")
}

// Verify Version 8 deletion of key 10
if (containsKey(arena1, historyRoots[8], 10) != 0 or getSize(arena1, historyRoots[8]) != 5) {
    print("[FAIL] Version 8 deletion mismatch")
} else {
    print("  Version 8 verified: key 10 deleted, size = 5")
}

// Verify Version 7 still has key 10
if (containsKey(arena1, historyRoots[7], 10) != 1 or getSize(arena1, historyRoots[7]) != 6) {
    print("[FAIL] Version 7 corrupted after Version 8 deletion")
} else {
    print("  Version 7 historical immutability verified: key 10 still present")
}

// Verify Version 9 deletion of key 5
if (containsKey(arena1, historyRoots[9], 5) != 0 or getSize(arena1, historyRoots[9]) != 4) {
    print("[FAIL] Version 9 deletion mismatch")
} else {
    print("  Version 9 verified: key 5 deleted, size = 4")
}

// Verify Version 8 still has key 5
if (containsKey(arena1, historyRoots[8], 5) != 1 or getSize(arena1, historyRoots[8]) != 5) {
    print("[FAIL] Version 8 corrupted after Version 9 deletion")
} else {
    print("  Version 8 historical immutability verified: key 5 still present")
}

print("  Test Case 1 Passed sequential updates and immutability verification")

// -----------------------------------------------------------------------------
// Test Case 2: Timeline Forking and Snapshot Branching
// -----------------------------------------------------------------------------
print("Running Test Case 2: Timeline Forking and Snapshot Branching...")

// Fork from Version 5 of historyRoots (keys: [5, 10, 15, 20, 25], sum = 750)
baseVer5 = historyRoots[5]
baseSize = getSize(arena1, baseVer5)
baseSum = getSum(arena1, baseVer5)

// Branch A: Add keys 12 (120) and 18 (180), then delete key 10
rngA = [101]
branchA1 = insertKey(arena1, baseVer5, 12, 120, nextRand(rngA) % 100000)
branchA2 = insertKey(arena1, branchA1, 18, 180, nextRand(rngA) % 100000)
branchA3 = deleteKey(arena1, branchA2, 10)

// Branch B: Add keys 2 (20) and 100 (1000), then delete key 25
rngB = [202]
branchB1 = insertKey(arena1, baseVer5, 2, 20, nextRand(rngB) % 100000)
branchB2 = insertKey(arena1, branchB1, 100, 1000, nextRand(rngB) % 100000)
branchB3 = deleteKey(arena1, branchB2, 25)

// Branch C: Fork from Branch A3, add key 99 (990)
rngC = [303]
branchC1 = insertKey(arena1, branchA3, 99, 990, nextRand(rngC) % 100000)

// Verify Base Version 5 immutability
if (getSize(arena1, baseVer5) != baseSize or getSum(arena1, baseVer5) != baseSum) {
    print("[FAIL] Base Version 5 corrupted during branching")
} else {
    print("  Parent Version 5 preserved immutability: size = 5, sum = 750")
}

// Verify Branch A3
keysA = treeToKeys(arena1, branchA3)
sumA = getSum(arena1, branchA3)
if (keysA.size() != 6 or sumA != 950 or containsKey(arena1, branchA3, 10) != 0 or containsKey(arena1, branchA3, 12) != 1 or containsKey(arena1, branchA3, 18) != 1) {
    print("[FAIL] Branch A3 validation mismatch")
} else {
    print("  Branch A independently verified: keys [5, 12, 15, 18, 20, 25], sum = 950")
}

// Verify Branch B3
keysB = treeToKeys(arena1, branchB3)
sumB = getSum(arena1, branchB3)
if (keysB.size() != 6 or sumB != 1520 or containsKey(arena1, branchB3, 25) != 0 or containsKey(arena1, branchB3, 2) != 1 or containsKey(arena1, branchB3, 100) != 1) {
    print("[FAIL] Branch B3 validation mismatch")
} else {
    print("  Branch B independently verified: keys [2, 5, 10, 15, 20, 100], sum = 1520")
}

// Verify Branch C1
sumC = getSum(arena1, branchC1)
if (getSize(arena1, branchC1) != 7 or sumC != 1940 or containsKey(arena1, branchC1, 99) != 1) {
    print("[FAIL] Branch C1 validation mismatch")
} else {
    print("  Branch C (derived from Branch A) verified: size = 7, sum = 1940")
}

// Cross-isolation checks
if (containsKey(arena1, branchA3, 2) != 0 or containsKey(arena1, branchA3, 100) != 0 or containsKey(arena1, branchB3, 12) != 0 or containsKey(arena1, branchB3, 18) != 0 or containsKey(arena1, branchA3, 99) != 0) {
    print("[FAIL] Cross-branch isolation leak detected")
} else {
    print("  Cross-branch isolation verified between Branch A, Branch B, and Branch C")
}

print("  Test Case 2 Passed timeline forking and branching verification")

// -----------------------------------------------------------------------------
// Test Case 3: Range Aggregates and Order Statistics Verification
// -----------------------------------------------------------------------------
print("Running Test Case 3: Range Aggregates and Order Statistics...")
arena3 = createTreapArena()
rng3 = [777]
root3 = -1

// Insert 15 items: keys [10, 20, 30, ..., 150] with vals [1, 2, 3, ..., 15]
itemCount = 15
idx = 1
while (idx <= itemCount) {
    k = idx * 10
    v = idx
    p = nextRand(rng3) % 100000
    root3 = insertKey(arena3, root3, k, v, p)
    idx = idx + 1
}

if (getSize(arena3, root3) != 15 or getSum(arena3, root3) != 120) {
    print("[FAIL] Range test dataset build mismatch")
}

// Subtest 3.1: Range [30, 90] -> keys 30, 40, 50, 60, 70, 80, 90
// Values: 3, 4, 5, 6, 7, 8, 9 -> count: 7, sum: 42, min: 3, max: 9
trip1 = [-1, -1, -1]
splitRange(arena3, root3, 30, 90, trip1)
subTreap1 = trip1[1]

qSum1 = queryRangeSum(arena3, root3, 30, 90)
qMin1 = queryRangeMin(arena3, root3, 30, 90)
qMax1 = queryRangeMax(arena3, root3, 30, 90)
qCnt1 = queryRangeCount(arena3, root3, 30, 90)

if (getSize(arena3, subTreap1) != 7 or getSum(arena3, subTreap1) != 42 or getMin(arena3, subTreap1) != 3 or getMax(arena3, subTreap1) != 9) {
    print("[FAIL] splitRange [30, 90] subtreap aggregate mismatch")
}
if (qSum1 != 42 or qMin1 != 3 or qMax1 != 9 or qCnt1 != 7) {
    print("[FAIL] Direct queryRange [30, 90] mismatch")
}
print("  Range [30, 90] verified: count = 7, sum = 42, min = 3, max = 9")

// Subtest 3.2: Edge range [5, 25] -> keys 10, 20 -> count: 2, sum: 3, min: 1, max: 2
trip2 = [-1, -1, -1]
splitRange(arena3, root3, 5, 25, trip2)
subTreap2 = trip2[1]
if (getSize(arena3, subTreap2) != 2 or getSum(arena3, subTreap2) != 3 or getMin(arena3, subTreap2) != 1 or getMax(arena3, subTreap2) != 2) {
    print("[FAIL] splitRange [5, 25] mismatch")
}
if (queryRangeSum(arena3, root3, 5, 25) != 3 or queryRangeCount(arena3, root3, 5, 25) != 2) {
    print("[FAIL] Direct queryRange [5, 25] mismatch")
}
print("  Prefix Range [5, 25] verified: count = 2, sum = 3, min = 1, max = 2")

// Subtest 3.3: Empty range between keys [52, 58]
trip3 = [-1, -1, -1]
splitRange(arena3, root3, 52, 58, trip3)
subTreap3 = trip3[1]
if (subTreap3 != -1 or getSize(arena3, subTreap3) != 0 or getSum(arena3, subTreap3) != 0) {
    print("[FAIL] Empty subtreap range mismatch")
}
if (queryRangeSum(arena3, root3, 52, 58) != 0 or queryRangeCount(arena3, root3, 52, 58) != 0) {
    print("[FAIL] Direct empty range query mismatch")
}
print("  Empty Range [52, 58] correctly evaluated to neutral identity")

// Subtest 3.4: Disjoint out-of-bounds range [200, 300]
trip4 = [-1, -1, -1]
splitRange(arena3, root3, 200, 300, trip4)
if (trip4[1] != -1 or queryRangeSum(arena3, root3, 200, 300) != 0) {
    print("[FAIL] Out of bounds range query mismatch")
}
print("  Out-of-bounds Range [200, 300] verified: count = 0, sum = 0")

// Subtest 3.5: Order Statistics: findKthSmallest
pairKth = [-1, -1]
findKthSmallest(arena3, root3, 1, pairKth)
if (pairKth[0] != 10 or pairKth[1] != 1) {
    print("[FAIL] 1st smallest element mismatch")
}
findKthSmallest(arena3, root3, 5, pairKth)
if (pairKth[0] != 50 or pairKth[1] != 5) {
    print("[FAIL] 5th smallest element mismatch")
}
findKthSmallest(arena3, root3, 15, pairKth)
if (pairKth[0] != 150 or pairKth[1] != 15) {
    print("[FAIL] 15th smallest element mismatch")
}
print("  Order Statistics findKthSmallest verified: k=1 -> 10, k=5 -> 50, k=15 -> 150")

// Subtest 3.6: Order Statistics: findRank
if (findRank(arena3, root3, 10) != 1) {
    print("[FAIL] Rank of key 10 mismatch")
}
if (findRank(arena3, root3, 50) != 5) {
    print("[FAIL] Rank of key 50 mismatch")
}
if (findRank(arena3, root3, 150) != 15) {
    print("[FAIL] Rank of key 150 mismatch")
}
if (findRank(arena3, root3, 45) != 5) {
    print("[FAIL] Rank of non-existent key 45 mismatch")
}
if (findRank(arena3, root3, 5) != 1) {
    print("[FAIL] Rank of non-existent key 5 mismatch")
}
if (findRank(arena3, root3, 200) != 16) {
    print("[FAIL] Rank of non-existent key 200 mismatch")
}
print("  Order Statistics findRank verified for boundary and non-existent keys")

print("  Test Case 3 Passed range aggregates and order statistics verification")

// -----------------------------------------------------------------------------
// Test Case 4: Treap Invariant In-Depth Verification
// -----------------------------------------------------------------------------
print("Running Test Case 4: Comprehensive Invariant Verification...")

// Verify all history roots from Test Case 1
hIdx = 0
hTotal = historyRoots.size()
hErrors = 0
while (hIdx < hTotal) {
    r = historyRoots[hIdx]
    if (verifyTreapInvariants(arena1, r) != 1) {
        hErrors = hErrors + 1
    }
    hIdx = hIdx + 1
}

// Verify branches from Test Case 2
if (verifyTreapInvariants(arena1, branchA3) != 1) {
    hErrors = hErrors + 1
}
if (verifyTreapInvariants(arena1, branchB3) != 1) {
    hErrors = hErrors + 1
}
if (verifyTreapInvariants(arena1, branchC1) != 1) {
    hErrors = hErrors + 1
}

// Verify range test dataset from Test Case 3
if (verifyTreapInvariants(arena3, root3) != 1) {
    hErrors = hErrors + 1
}
if (verifyTreapInvariants(arena3, subTreap1) != 1) {
    hErrors = hErrors + 1
}
if (verifyTreapInvariants(arena3, subTreap2) != 1) {
    hErrors = hErrors + 1
}

if (hErrors > 0) {
    print("[FAIL] Invariant verification failed on", hErrors, "treap roots")
} else {
    print("  All historical versions (v0..v9) verified: 100% BST, heap, and aggregate invariants satisfied")
    print("  Forked branches A, B, and C verified: heap priority integrity intact")
    print("  Isolated range subtreaps verified: independent tree invariant validity confirmed")
    print("  Test Case 4 Passed comprehensive invariant verification")
}

// -----------------------------------------------------------------------------
// Test Case 5: Randomized Stress Benchmark against Naive Historical Matrix
// -----------------------------------------------------------------------------
print("Running Test Case 5: Randomized Stress Benchmark against Historical Oracle...")
stressArena = createTreapArena()
stressRng = [1337]

stressRoots = []
stressNaiveK = []
stressNaiveV = []

// Version 0: Empty tree
stressRoots.push(-1)
stressNaiveK.push([])
stressNaiveV.push([])

numVersions = 40
verIdx = 1
stressAllocErrors = 0

while (verIdx <= numVersions) {
    // Pick base version: either previous version or random branch from history
    randBranch = nextRand(stressRng) % 100
    baseVersion = verIdx - 1
    if (randBranch < 30 and verIdx > 3) {
        baseVersion = nextRand(stressRng) % verIdx
    }

    baseRoot = stressRoots[baseVersion]
    baseKList = cloneArray(stressNaiveK[baseVersion])
    baseVList = cloneArray(stressNaiveV[baseVersion])

    randOp = nextRand(stressRng) % 100
    newRoot = -1
    newKList = []
    newVList = []

    if (randOp < 70 or baseKList.size() == 0) {
        // Insert or update operation
        genKey = (nextRand(stressRng) % 150) + 1
        genVal = (nextRand(stressRng) % 1000) + 1
        genPrio = nextRand(stressRng) % 1000000

        newRoot = insertKey(stressArena, baseRoot, genKey, genVal, genPrio)
        naiveRes = naiveInsert(baseKList, baseVList, genKey, genVal)
        newKList = naiveRes[0]
        newVList = naiveRes[1]
    } else {
        // Delete operation
        delIdx = nextRand(stressRng) % baseKList.size()
        delKey = baseKList[delIdx]

        newRoot = deleteKey(stressArena, baseRoot, delKey)
        naiveRes = naiveDelete(baseKList, baseVList, delKey)
        newKList = naiveRes[0]
        newVList = naiveRes[1]
    }

    if (verifyTreapInvariants(stressArena, newRoot) != 1) {
        stressAllocErrors = stressAllocErrors + 1
    }

    stressRoots.push(newRoot)
    stressNaiveK.push(newKList)
    stressNaiveV.push(newVList)

    verIdx = verIdx + 1
}

// Perform 120 randomized queries across all versions
numQueries = 120
qIdx = 0
stressQueryErrors = 0

while (qIdx < numQueries) {
    chosenVer = nextRand(stressRng) % (numVersions + 1)
    qRoot = stressRoots[chosenVer]
    curK = stressNaiveK[chosenVer]
    curV = stressNaiveV[chosenVer]
    kSize = curK.size()

    qType = nextRand(stressRng) % 4

    if (qType == 0) {
        // Range query test
        k1 = (nextRand(stressRng) % 160) + 1
        k2 = (nextRand(stressRng) % 160) + 1
        lowK = minInt(k1, k2)
        highK = maxInt(k1, k2)

        expSum = 0
        expMin = 2147483647
        expMax = -2147483648
        expCnt = 0

        sIdx = 0
        while (sIdx < kSize) {
            kItem = curK[sIdx]
            if (kItem >= lowK and kItem <= highK) {
                vItem = curV[sIdx]
                expCnt = expCnt + 1
                expSum = expSum + vItem
                expMin = minInt(expMin, vItem)
                expMax = maxInt(expMax, vItem)
            }
            sIdx = sIdx + 1
        }

        actSum = queryRangeSum(stressArena, qRoot, lowK, highK)
        actMin = queryRangeMin(stressArena, qRoot, lowK, highK)
        actMax = queryRangeMax(stressArena, qRoot, lowK, highK)
        actCnt = queryRangeCount(stressArena, qRoot, lowK, highK)

        sTrip = [-1, -1, -1]
        splitRange(stressArena, qRoot, lowK, highK, sTrip)
        splitMid = sTrip[1]

        if (actSum != expSum or actMin != expMin or actMax != expMax or actCnt != expCnt) {
            stressQueryErrors = stressQueryErrors + 1
        }
        if (getSize(stressArena, splitMid) != expCnt or getSum(stressArena, splitMid) != expSum) {
            stressQueryErrors = stressQueryErrors + 1
        }
    } else {
        if (qType == 1) {
            // Point lookup test
            searchKey = (nextRand(stressRng) % 160) + 1
            expVal = -1
            sIdx = 0
            while (sIdx < kSize) {
                if (curK[sIdx] == searchKey) {
                    expVal = curV[sIdx]
                    sIdx = kSize
                } else {
                    sIdx = sIdx + 1
                }
            }

            actVal = lookupKey(stressArena, qRoot, searchKey)
            if (actVal != expVal) {
                stressQueryErrors = stressQueryErrors + 1
            }
        } else {
            if (qType == 2 and kSize > 0) {
                // Order statistics: findKthSmallest
                pickK = (nextRand(stressRng) % kSize) + 1
                expKthKey = curK[pickK - 1]
                expKthVal = curV[pickK - 1]

                actPair = [-1, -1]
                findKthSmallest(stressArena, qRoot, pickK, actPair)
                if (actPair[0] != expKthKey or actPair[1] != expKthVal) {
                    stressQueryErrors = stressQueryErrors + 1
                }
            } else {
                // Order statistics: findRank
                queryRankKey = (nextRand(stressRng) % 160) + 1
                expRank = 1
                sIdx = 0
                while (sIdx < kSize) {
                    if (curK[sIdx] < queryRankKey) {
                        expRank = expRank + 1
                    }
                    sIdx = sIdx + 1
                }

                actRank = findRank(stressArena, qRoot, queryRankKey)
                if (actRank != expRank) {
                    stressQueryErrors = stressQueryErrors + 1
                }
            }
        }
    }

    qIdx = qIdx + 1
}

if (stressAllocErrors > 0 or stressQueryErrors > 0) {
    print("[FAIL] Stress test had", stressAllocErrors, "invariant errors and", stressQueryErrors, "query mismatches")
} else {
    print("  Validated", numQueries, "random historical queries across", numVersions, "versions: 0 mismatches")
    tAlloc = stressArena[0]
    print("  Total allocated persistent treap arena nodes:", tAlloc.size())
    print("  Test Case 5 Passed stress benchmark verification")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] Persistent Treap Snapshot Suite executed successfully in", elapsed, "ms")
