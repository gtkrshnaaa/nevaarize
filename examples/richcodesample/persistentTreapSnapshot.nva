import stdlib time as t

// Persistent Cartesian Tree (Treap) Dynamic Snapshot Engine
// Technical characteristics:
// - Functional persistence via node path copying in O(log N) time and space
// - Logarithmic split and merge primitives preserving immutable historical snapshots
// - Max-heap priority ordering with deterministic pseudo-random generator
// - Binary search tree key invariant with dynamic range aggregates (sum, min, max, count)
// - Subtree order statistics: k-th smallest element and rank determination in O(log N)
// - Parallel arena allocation for cache locality and zero reference overhead
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Persistent Treap Snapshot Suite ===")
suiteStartTime = t.millis()

func minInt(aInt, bInt) {
    if (aInt < bInt) {
        return aInt
    }
    return bInt
}

func maxInt(aInt, bInt) {
    if (aInt > bInt) {
        return aInt
    }
    return bInt
}

func createTreapArena() {
    tKey = []
    tVal = []
    tPrio = []
    tSize = []
    tLeft = []
    tRight = []
    tSum = []
    tMin = []
    tMax = []
    return [tKey, tVal, tPrio, tSize, tLeft, tRight, tSum, tMin, tMax]
}

func getSize(arena, node) {
    if (node == -1) {
        return 0
    }
    tSize = arena[3]
    return tSize[node]
}

func getSum(arena, node) {
    if (node == -1) {
        return 0
    }
    tSum = arena[6]
    return tSum[node]
}

func getMin(arena, node) {
    if (node == -1) {
        return 2147483647
    }
    tMin = arena[7]
    return tMin[node]
}

func getMax(arena, node) {
    if (node == -1) {
        return -2147483648
    }
    tMax = arena[8]
    return tMax[node]
}

func allocTreapNode(arena, key, val, prio, leftChild, rightChild) {
    tKey = arena[0]
    tVal = arena[1]
    tPrio = arena[2]
    tSize = arena[3]
    tLeft = arena[4]
    tRight = arena[5]
    tSum = arena[6]
    tMin = arena[7]
    tMax = arena[8]

    sz = 1
    s = val
    mn = val
    mx = val

    if (leftChild != -1) {
        sz = sz + tSize[leftChild]
        s = s + tSum[leftChild]
        mn = minInt(mn, tMin[leftChild])
        mx = maxInt(mx, tMax[leftChild])
    }
    if (rightChild != -1) {
        sz = sz + tSize[rightChild]
        s = s + tSum[rightChild]
        mn = minInt(mn, tMin[rightChild])
        mx = maxInt(mx, tMax[rightChild])
    }

    nodeId = tKey.size()
    tKey.push(key)
    tVal.push(val)
    tPrio.push(prio)
    tSize.push(sz)
    tLeft.push(leftChild)
    tRight.push(rightChild)
    tSum.push(s)
    tMin.push(mn)
    tMax.push(mx)

    arena[0] = tKey
    arena[1] = tVal
    arena[2] = tPrio
    arena[3] = tSize
    arena[4] = tLeft
    arena[5] = tRight
    arena[6] = tSum
    arena[7] = tMin
    arena[8] = tMax
    return nodeId
}

func cloneNode(arena, srcId, newLeft, newRight) {
    if (srcId == -1) {
        return -1
    }
    tKey = arena[0]
    tVal = arena[1]
    tPrio = arena[2]
    return allocTreapNode(arena, tKey[srcId], tVal[srcId], tPrio[srcId], newLeft, newRight)
}

func split(arena, root, splitKey, outPair) {
    if (root == -1) {
        outPair[0] = -1
        outPair[1] = -1
        return
    }
    tKey = arena[0]
    tLeft = arena[4]
    tRight = arena[5]

    nodeKey = tKey[root]
    lc = tLeft[root]
    rc = tRight[root]

    if (nodeKey <= splitKey) {
        subPair = [-1, -1]
        split(arena, rc, splitKey, subPair)
        newRoot = cloneNode(arena, root, lc, subPair[0])
        outPair[0] = newRoot
        outPair[1] = subPair[1]
    } else {
        subPair = [-1, -1]
        split(arena, lc, splitKey, subPair)
        newRoot = cloneNode(arena, root, subPair[1], rc)
        outPair[0] = subPair[0]
        outPair[1] = newRoot
    }
}

func merge(arena, leftRoot, rightRoot) {
    if (leftRoot == -1) {
        return rightRoot
    }
    if (rightRoot == -1) {
        return leftRoot
    }
    tPrio = arena[2]
    tLeft = arena[4]
    tRight = arena[5]

    prioL = tPrio[leftRoot]
    prioR = tPrio[rightRoot]

    if (prioL >= prioR) {
        newRc = merge(arena, tRight[leftRoot], rightRoot)
        return cloneNode(arena, leftRoot, tLeft[leftRoot], newRc)
    } else {
        newLc = merge(arena, leftRoot, tLeft[rightRoot])
        return cloneNode(arena, rightRoot, newLc, tRight[rightRoot])
    }
}

func insertKey(arena, root, key, val, prio) {
    p1 = [-1, -1]
    split(arena, root, key - 1, p1)
    p2 = [-1, -1]
    split(arena, p1[1], key, p2)

    newNode = allocTreapNode(arena, key, val, prio, -1, -1)
    m1 = merge(arena, p1[0], newNode)
    return merge(arena, m1, p2[1])
}

func deleteKey(arena, root, key) {
    p1 = [-1, -1]
    split(arena, root, key - 1, p1)
    p2 = [-1, -1]
    split(arena, p1[1], key, p2)
    return merge(arena, p1[0], p2[1])
}

func lookupKey(arena, root, key) {
    curr = root
    tKey = arena[0]
    tVal = arena[1]
    tLeft = arena[4]
    tRight = arena[5]
    while (curr != -1) {
        k = tKey[curr]
        if (key == k) {
            return tVal[curr]
        }
        if (key < k) {
            curr = tLeft[curr]
        } else {
            curr = tRight[curr]
        }
    }
    return -1
}

func containsKey(arena, root, key) {
    curr = root
    tKey = arena[0]
    tLeft = arena[4]
    tRight = arena[5]
    while (curr != -1) {
        k = tKey[curr]
        if (key == k) {
            return 1
        }
        if (key < k) {
            curr = tLeft[curr]
        } else {
            curr = tRight[curr]
        }
    }
    return 0
}

func treeToKeys(arena, root) {
    res = []
    if (root == -1) {
        return res
    }
    stack = []
    curr = root
    tLeft = arena[4]
    tRight = arena[5]
    tKey = arena[0]
    while (curr != -1 or stack.size() > 0) {
        while (curr != -1) {
            stack.push(curr)
            curr = tLeft[curr]
        }
        topIdx = stack.size() - 1
        curr = stack[topIdx]
        stack.pop()
        res.push(tKey[curr])
        curr = tRight[curr]
    }
    return res
}

func treeToValues(arena, root) {
    res = []
    if (root == -1) {
        return res
    }
    stack = []
    curr = root
    tLeft = arena[4]
    tRight = arena[5]
    tVal = arena[1]
    while (curr != -1 or stack.size() > 0) {
        while (curr != -1) {
            stack.push(curr)
            curr = tLeft[curr]
        }
        topIdx = stack.size() - 1
        curr = stack[topIdx]
        stack.pop()
        res.push(tVal[curr])
        curr = tRight[curr]
    }
    return res
}

func nextRand(state) {
    s = state[0]
    s = (s * 1103515245 + 12345) % 2147483648
    if (s < 0) {
        s = 0 - s
    }
    state[0] = s
    return s
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Version Updates and Historical Immutability
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Version Updates and Immutability...")
arena1 = createTreapArena()
rng1 = [42]

historyRoots = []
historyRoots.push(-1) // Version 0: Empty tree

// Version 1: Insert (15, 150)
v1 = insertKey(arena1, historyRoots[0], 15, 150, nextRand(rng1) % 100000)
historyRoots.push(v1)

// Version 2: Insert (10, 100)
v2 = insertKey(arena1, historyRoots[1], 10, 100, nextRand(rng1) % 100000)
historyRoots.push(v2)

// Version 3: Insert (25, 250)
v3 = insertKey(arena1, historyRoots[2], 25, 250, nextRand(rng1) % 100000)
historyRoots.push(v3)

// Version 4: Insert (5, 50)
v4 = insertKey(arena1, historyRoots[3], 5, 50, nextRand(rng1) % 100000)
historyRoots.push(v4)

// Version 5: Insert (20, 200)
v5 = insertKey(arena1, historyRoots[4], 20, 200, nextRand(rng1) % 100000)
historyRoots.push(v5)

// Version 6: Insert (30, 300)
v6 = insertKey(arena1, historyRoots[5], 30, 300, nextRand(rng1) % 100000)
historyRoots.push(v6)

// Version 7: Update key 15 with value 999
v7 = insertKey(arena1, historyRoots[6], 15, 999, nextRand(rng1) % 100000)
historyRoots.push(v7)

// Version 8: Delete key 10
v8 = deleteKey(arena1, historyRoots[7], 10)
historyRoots.push(v8)

// Version 9: Delete key 5
v9 = deleteKey(arena1, historyRoots[8], 5)
historyRoots.push(v9)

// Verify Version 0: Empty
if (getSize(arena1, historyRoots[0]) != 0) {
    print("[FAIL] Version 0 size mismatch")
}

// Verify Version 1
k1 = treeToKeys(arena1, historyRoots[1])
if (k1.size() != 1 or k1[0] != 15 or lookupKey(arena1, historyRoots[1], 15) != 150) {
    print("[FAIL] Version 1 validation mismatch")
} else {
    print("  Version 1 verified: size =", getSize(arena1, historyRoots[1]), ", sum =", getSum(arena1, historyRoots[1]))
}

// Verify Version 2
k2 = treeToKeys(arena1, historyRoots[2])
if (k2.size() != 2 or k2[0] != 10 or k2[1] != 15 or getSum(arena1, historyRoots[2]) != 250) {
    print("[FAIL] Version 2 validation mismatch")
} else {
    print("  Version 2 verified: keys [10, 15], sum = 250")
}

// Verify Version 5
k5 = treeToKeys(arena1, historyRoots[5])
if (k5.size() != 5 or getSum(arena1, historyRoots[5]) != 750 or getMin(arena1, historyRoots[5]) != 50 or getMax(arena1, historyRoots[5]) != 250) {
    print("[FAIL] Version 5 validation mismatch")
} else {
    print("  Version 5 verified: size = 5, sum = 750, min = 50, max = 250")
}

// Verify Version 6
if (getSize(arena1, historyRoots[6]) != 6 or getSum(arena1, historyRoots[6]) != 1050) {
    print("[FAIL] Version 6 validation mismatch")
} else {
    print("  Version 6 verified: size = 6, sum = 1050")
}

// Verify Version 7 updated key 15
if (lookupKey(arena1, historyRoots[7], 15) != 999 or getSum(arena1, historyRoots[7]) != 1899) {
    print("[FAIL] Version 7 update mismatch")
} else {
    print("  Version 7 update verified: key 15 value = 999, sum = 1899")
}

// Verify Historical Immutability on Version 6 (key 15 must still be 150)
if (lookupKey(arena1, historyRoots[6], 15) != 150 or getSum(arena1, historyRoots[6]) != 1050) {
    print("[FAIL] Version 6 corrupted after Version 7 update")
} else {
    print("  Version 6 historical immutability verified: key 15 remains 150")
}

// Verify Version 8 deletion of key 10
if (containsKey(arena1, historyRoots[8], 10) != 0 or getSize(arena1, historyRoots[8]) != 5) {
    print("[FAIL] Version 8 deletion mismatch")
} else {
    print("  Version 8 verified: key 10 deleted, size = 5")
}

// Verify Version 7 still has key 10
if (containsKey(arena1, historyRoots[7], 10) != 1 or getSize(arena1, historyRoots[7]) != 6) {
    print("[FAIL] Version 7 corrupted after Version 8 deletion")
} else {
    print("  Version 7 historical immutability verified: key 10 still present")
}

// Verify Version 9 deletion of key 5
if (containsKey(arena1, historyRoots[9], 5) != 0 or getSize(arena1, historyRoots[9]) != 4) {
    print("[FAIL] Version 9 deletion mismatch")
} else {
    print("  Version 9 verified: key 5 deleted, size = 4")
}

// Verify Version 8 still has key 5
if (containsKey(arena1, historyRoots[8], 5) != 1 or getSize(arena1, historyRoots[8]) != 5) {
    print("[FAIL] Version 8 corrupted after Version 9 deletion")
} else {
    print("  Version 8 historical immutability verified: key 5 still present")
}

print("  Test Case 1 Passed sequential updates and immutability verification")

elapsed = t.millis() - suiteStartTime
print("[PASS] Persistent Treap Snapshot Suite executed successfully in", elapsed, "ms")
