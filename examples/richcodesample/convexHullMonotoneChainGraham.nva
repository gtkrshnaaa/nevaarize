import stdlib math as m
import stdlib time as tm

// Monotone Chain (Andrew) and Graham Scan 2D Convex Hull Suite
// Technical characteristics:
// - Andrew's Monotone Chain 2D convex hull via lexicographical sorting in O(N log N) / O(N^2) time
// - Graham Scan 2D convex hull via pivot selection and cross-product polar ordering
// - Exact integer cross-product arithmetic avoiding floating-point trigonometry instability
// - Collinear point filtering and boundary validation
// - Polygon area via Shoelace formula, perimeter, and centroid calculations
// - Linear-time Rotating Calipers algorithm for antipodal pairs and polygon diameter
// - O(N) / O(log N) point-in-convex-polygon inclusion queries (interior, boundary, exterior)
// - Equivalence assertion ensuring Monotone Chain and Graham Scan produce identical hulls
// - Verification against brute-force diameter and bounding oracle
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize 2D Convex Hull: Monotone Chain & Graham Scan Suite ===")
hullSuiteStartTime = tm.millis()

struct Point2D {
    x,
    y
}

struct HullMetrics {
    vertexCount,
    doubleArea,
    area,
    perimeter,
    diameterSq,
    diameter
}

func createPoint(px, py) {
    return Point2D(px, py)
}

func crossProductPoints(pOrigin, pA, pB) {
    return (pA.x - pOrigin.x) * (pB.y - pOrigin.y) - (pA.y - pOrigin.y) * (pB.x - pOrigin.x)
}

func distSquaredPoints(pA, pB) {
    dx = pB.x - pA.x
    dy = pB.y - pA.y
    return dx * dx + dy * dy
}

func euclideanDistPoints(pA, pB) {
    return m.Sqrt(distSquaredPoints(pA, pB))
}

func compareLexicographical(pA, pB) {
    if (pA.x < pB.x) {
        return -1
    } elif (pA.x > pB.x) {
        return 1
    } elif (pA.y < pB.y) {
        return -1
    } elif (pA.y > pB.y) {
        return 1
    }
    return 0
}

func sortPointsLexicographical(pts) {
    sPts = []
    sI = 0
    sN = pts.size()
    while (sI < sN) {
        sPts.push(pts[sI])
        sI = sI + 1
    }
    sI = 1
    while (sI < sN) {
        sKey = sPts[sI]
        sJ = sI - 1
        sortRunning = 1
        while (sJ >= 0 && sortRunning == 1) {
            sCmp = compareLexicographical(sPts[sJ], sKey)
            if (sCmp > 0) {
                sPts[sJ + 1] = sPts[sJ]
                sJ = sJ - 1
            } else {
                sortRunning = 0
            }
        }
        sPts[sJ + 1] = sKey
        sI = sI + 1
    }
    return sPts
}

func deduplicateSortedPoints(sortedPts) {
    dNum = sortedPts.size()
    if (dNum <= 1) {
        return sortedPts
    }
    dUniq = []
    dUniq.push(sortedPts[0])
    dIdx = 1
    while (dIdx < dNum) {
        dPrev = dUniq[dUniq.size() - 1]
        dCurr = sortedPts[dIdx]
        if (dPrev.x != dCurr.x || dPrev.y != dCurr.y) {
            dUniq.push(dCurr)
        }
        dIdx = dIdx + 1
    }
    return dUniq
}

func monotoneChainConvexHull(rawPoints) {
    mcSorted = sortPointsLexicographical(rawPoints)
    mcPts = deduplicateSortedPoints(mcSorted)
    mcCount = mcPts.size()
    if (mcCount <= 2) {
        return mcPts
    }

    // Lower hull construction
    lowerHull = []
    lowIdx = 0
    while (lowIdx < mcCount) {
        pt = mcPts[lowIdx]
        lowerRunning = 1
        while (lowerHull.size() >= 2 && lowerRunning == 1) {
            szL = lowerHull.size()
            cpL = crossProductPoints(lowerHull[szL - 2], lowerHull[szL - 1], pt)
            if (cpL <= 0) {
                lowerHull.pop()
            } else {
                lowerRunning = 0
            }
        }
        lowerHull.push(pt)
        lowIdx = lowIdx + 1
    }

    // Upper hull construction
    upperHull = []
    upIdx = mcCount - 1
    while (upIdx >= 0) {
        pt = mcPts[upIdx]
        upperRunning = 1
        while (upperHull.size() >= 2 && upperRunning == 1) {
            szU = upperHull.size()
            cpU = crossProductPoints(upperHull[szU - 2], upperHull[szU - 1], pt)
            if (cpU <= 0) {
                upperHull.pop()
            } else {
                upperRunning = 0
            }
        }
        upperHull.push(pt)
        upIdx = upIdx - 1
    }

    // Combine lower and upper hulls (excluding duplicate anchor vertices)
    resultHull = []
    rIdx = 0
    lLimit = lowerHull.size() - 1
    while (rIdx < lLimit) {
        resultHull.push(lowerHull[rIdx])
        rIdx = rIdx + 1
    }

    uIdx = 0
    uLimit = upperHull.size() - 1
    while (uIdx < uLimit) {
        resultHull.push(upperHull[uIdx])
        uIdx = uIdx + 1
    }

    return resultHull
}

func comparePolar(pivot, pA, pB) {
    cp = crossProductPoints(pivot, pA, pB)
    if (cp > 0) {
        return -1
    } elif (cp < 0) {
        return 1
    } else {
        dA = distSquaredPoints(pivot, pA)
        dB = distSquaredPoints(pivot, pB)
        if (dA < dB) {
            return -1
        } elif (dA > dB) {
            return 1
        }
        return 0
    }
}

func sortPointsPolar(pivot, pts) {
    pPts = []
    pI = 0
    pN = pts.size()
    while (pI < pN) {
        pPts.push(pts[pI])
        pI = pI + 1
    }
    pI = 1
    while (pI < pN) {
        pKey = pPts[pI]
        pJ = pI - 1
        polarRunning = 1
        while (pJ >= 0 && polarRunning == 1) {
            pCmp = comparePolar(pivot, pPts[pJ], pKey)
            if (pCmp > 0) {
                pPts[pJ + 1] = pPts[pJ]
                pJ = pJ - 1
            } else {
                polarRunning = 0
            }
        }
        pPts[pJ + 1] = pKey
        pI = pI + 1
    }
    return pPts
}

func grahamScanConvexHull(rawPoints) {
    gsSorted = sortPointsLexicographical(rawPoints)
    gsPts = deduplicateSortedPoints(gsSorted)
    gsCount = gsPts.size()
    if (gsCount <= 2) {
        return gsPts
    }

    // Step 1: Find pivot point (lowest Y, then leftmost X)
    pivotIdx = 0
    gIdx = 1
    while (gIdx < gsCount) {
        if (gsPts[gIdx].y < gsPts[pivotIdx].y) {
            pivotIdx = gIdx
        } elif (gsPts[gIdx].y == gsPts[pivotIdx].y && gsPts[gIdx].x < gsPts[pivotIdx].x) {
            pivotIdx = gIdx
        }
        gIdx = gIdx + 1
    }

    pivot = gsPts[pivotIdx]
    remaining = []
    gIdx = 0
    while (gIdx < gsCount) {
        if (gIdx != pivotIdx) {
            remaining.push(gsPts[gIdx])
        }
        gIdx = gIdx + 1
    }

    // Step 2: Sort remaining points by polar angle with respect to pivot
    sortedRemaining = sortPointsPolar(pivot, remaining)
    remSize = sortedRemaining.size()

    // Step 3: Filter collinear points along the same angle, retaining only the furthest point
    filtered = []
    filtered.push(pivot)
    fIdx = 0
    while (fIdx < remSize) {
        collinearRunning = 1
        while (fIdx + 1 < remSize && collinearRunning == 1) {
            cp = crossProductPoints(pivot, sortedRemaining[fIdx], sortedRemaining[fIdx + 1])
            if (cp == 0) {
                fIdx = fIdx + 1
            } else {
                collinearRunning = 0
            }
        }
        filtered.push(sortedRemaining[fIdx])
        fIdx = fIdx + 1
    }

    fSize = filtered.size()
    if (fSize <= 2) {
        return filtered
    }

    // Step 4: Scan with stack ensuring strict CCW turns
    stack = []
    stack.push(filtered[0])
    stack.push(filtered[1])

    sIdx = 2
    while (sIdx < fSize) {
        pt = filtered[sIdx]
        stackRunning = 1
        while (stack.size() >= 2 && stackRunning == 1) {
            stkSz = stack.size()
            cp = crossProductPoints(stack[stkSz - 2], stack[stkSz - 1], pt)
            if (cp <= 0) {
                stack.pop()
            } else {
                stackRunning = 0
            }
        }
        stack.push(pt)
        sIdx = sIdx + 1
    }

    return stack
}

func computePolygonDoubleArea(hull) {
    hSize = hull.size()
    if (hSize < 3) {
        return 0
    }
    doubleArea = 0
    shIdx = 0
    while (shIdx < hSize) {
        nxt = (shIdx + 1) % hSize
        doubleArea = doubleArea + (hull[shIdx].x * hull[nxt].y - hull[nxt].x * hull[shIdx].y)
        shIdx = shIdx + 1
    }
    if (doubleArea < 0) {
        doubleArea = 0 - doubleArea
    }
    return doubleArea
}

func computePolygonArea(hull) {
    dA = computePolygonDoubleArea(hull)
    return dA * 0.5
}

func computePolygonPerimeter(hull) {
    hSize = hull.size()
    if (hSize < 2) {
        return 0.0
    }
    perim = 0.0
    prIdx = 0
    while (prIdx < hSize) {
        nxt = (prIdx + 1) % hSize
        perim = perim + euclideanDistPoints(hull[prIdx], hull[nxt])
        prIdx = prIdx + 1
    }
    return perim
}

func computePolygonCentroid(hull) {
    hSize = hull.size()
    if (hSize == 0) {
        return Point2D(0.0, 0.0)
    } elif (hSize == 1) {
        return Point2D(hull[0].x * 1.0, hull[0].y * 1.0)
    } elif (hSize == 2) {
        return Point2D((hull[0].x + hull[1].x) * 0.5, (hull[0].y + hull[1].y) * 0.5)
    }

    signedAreaSum = 0
    cxSum = 0.0
    cySum = 0.0
    cIdx = 0
    while (cIdx < hSize) {
        nxt = (cIdx + 1) % hSize
        term = (hull[cIdx].x * hull[nxt].y - hull[nxt].x * hull[cIdx].y)
        signedAreaSum = signedAreaSum + term
        cxSum = cxSum + (hull[cIdx].x + hull[nxt].x) * 1.0 * term
        cySum = cySum + (hull[cIdx].y + hull[nxt].y) * 1.0 * term
        cIdx = cIdx + 1
    }

    if (signedAreaSum == 0) {
        return Point2D(hull[0].x * 1.0, hull[0].y * 1.0)
    }

    denom = 3.0 * signedAreaSum
    return Point2D(cxSum / denom, cySum / denom)
}

func rotatingCalipersDiameterSq(hull) {
    hSize = hull.size()
    if (hSize <= 1) {
        return 0
    } elif (hSize == 2) {
        return distSquaredPoints(hull[0], hull[1])
    }

    maxDistSq = 0
    caliperK = 1
    rcI = 0
    while (rcI < hSize) {
        nxt = (rcI + 1) % hSize
        caliperSearching = 1
        while (caliperSearching == 1) {
            nextK = (caliperK + 1) % hSize
            curArea = crossProductPoints(hull[rcI], hull[nxt], hull[caliperK])
            if (curArea < 0) {
                curArea = 0 - curArea
            }
            nextArea = crossProductPoints(hull[rcI], hull[nxt], hull[nextK])
            if (nextArea < 0) {
                nextArea = 0 - nextArea
            }
            if (nextArea > curArea) {
                caliperK = nextK
            } else {
                caliperSearching = 0
            }
        }

        d1 = distSquaredPoints(hull[rcI], hull[caliperK])
        d2 = distSquaredPoints(hull[nxt], hull[caliperK])
        if (d1 > maxDistSq) {
            maxDistSq = d1
        }
        if (d2 > maxDistSq) {
            maxDistSq = d2
        }

        rcI = rcI + 1
    }

    return maxDistSq
}

func bruteForceDiameterSq(points) {
    n = points.size()
    if (n <= 1) {
        return 0
    }
    bMax = 0
    bI = 0
    while (bI < n) {
        bJ = bI + 1
        while (bJ < n) {
            d = distSquaredPoints(points[bI], points[bJ])
            if (d > bMax) {
                bMax = d
            }
            bJ = bJ + 1
        }
        bI = bI + 1
    }
    return bMax
}

func pointInConvexPolygon(hull, testPt) {
    hSize = hull.size()
    if (hSize == 0) {
        return 0
    } elif (hSize == 1) {
        if (hull[0].x == testPt.x && hull[0].y == testPt.y) {
            return 2
        }
        return 0
    } elif (hSize == 2) {
        cp = crossProductPoints(hull[0], hull[1], testPt)
        if (cp == 0) {
            minX = hull[0].x
            maxX = hull[1].x
            if (minX > maxX) {
                temp = minX
                minX = maxX
                maxX = temp
            }
            minY = hull[0].y
            maxY = hull[1].y
            if (minY > maxY) {
                temp = minY
                minY = maxY
                maxY = temp
            }
            if (testPt.x >= minX && testPt.x <= maxX && testPt.y >= minY && testPt.y <= maxY) {
                return 2
            }
        }
        return 0
    }

    hasBoundary = 0
    pipIdx = 0
    while (pipIdx < hSize) {
        nxt = (pipIdx + 1) % hSize
        cp = crossProductPoints(hull[pipIdx], hull[nxt], testPt)
        if (cp < 0) {
            return 0
        } elif (cp == 0) {
            hasBoundary = 1
        }
        pipIdx = pipIdx + 1
    }

    if (hasBoundary == 1) {
        return 2
    }
    return 1
}

func areHullsEquivalent(hullA, hullB) {
    sA = hullA.size()
    sB = hullB.size()
    if (sA != sB) {
        return 0
    }
    if (sA == 0) {
        return 1
    }

    firstA = hullA[0]
    matchIdx = -1
    bI = 0
    while (bI < sB && matchIdx == -1) {
        if (hullB[bI].x == firstA.x && hullB[bI].y == firstA.y) {
            matchIdx = bI
        }
        bI = bI + 1
    }

    if (matchIdx == -1) {
        return 0
    }

    matches = 1
    k = 0
    while (k < sA && matches == 1) {
        curB = (matchIdx + k) % sB
        if (hullA[k].x != hullB[curB].x || hullA[k].y != hullB[curB].y) {
            matches = 0
        }
        k = k + 1
    }

    return matches
}

func computeHullMetrics(hull) {
    vCount = hull.size()
    dArea = computePolygonDoubleArea(hull)
    fArea = dArea * 0.5
    perim = computePolygonPerimeter(hull)
    dDiamSq = rotatingCalipersDiameterSq(hull)
    fDiam = m.Sqrt(dDiamSq)
    return HullMetrics(vCount, dArea, fArea, perim, dDiamSq, fDiam)
}

// -----------------------------------------------------------------------------
// Test Suites & Invariant Audits
// -----------------------------------------------------------------------------

print("Running Test Case 1: Collinear Points and Minimal Degeneracy...")
testPts1 = [
    Point2D(0, 0),
    Point2D(1, 1),
    Point2D(2, 2),
    Point2D(3, 3),
    Point2D(4, 4)
]
hullMC1 = monotoneChainConvexHull(testPts1)
hullGS1 = grahamScanConvexHull(testPts1)
if (hullMC1.size() != 2) {
    print("Assertion Failed: Collinear points should yield 2 extreme vertices in Monotone Chain, got:", hullMC1.size())
}
if (hullGS1.size() != 2) {
    print("Assertion Failed: Collinear points should yield 2 extreme vertices in Graham Scan, got:", hullGS1.size())
}
d1MC = rotatingCalipersDiameterSq(hullMC1)
bfD1 = bruteForceDiameterSq(testPts1)
if (d1MC != bfD1 || d1MC != 32) {
    print("Assertion Failed: Collinear line segment diameter squared must be 32, got:", d1MC)
}
print("  Collinear segment extreme points: (", hullMC1[0].x, ",", hullMC1[0].y, ") to (", hullMC1[1].x, ",", hullMC1[1].y, ")")
print("  Test Case 1 PASSED")

print("Running Test Case 2: Standard Unit Square Grid with Interior Points...")
testPts2 = [
    Point2D(0, 0),
    Point2D(10, 0),
    Point2D(10, 10),
    Point2D(0, 10),
    Point2D(5, 5),
    Point2D(2, 3),
    Point2D(7, 8),
    Point2D(5, 0),
    Point2D(10, 5),
    Point2D(0, 5)
]
hullMC2 = monotoneChainConvexHull(testPts2)
hullGS2 = grahamScanConvexHull(testPts2)
if (hullMC2.size() != 4) {
    print("Assertion Failed: Square convex hull must have 4 vertices, got:", hullMC2.size())
}
if (areHullsEquivalent(hullMC2, hullGS2) != 1) {
    print("Assertion Failed: Monotone Chain and Graham Scan hulls must be cyclically identical")
}
m2 = computeHullMetrics(hullMC2)
if (m2.doubleArea != 200 || m2.area != 100.0) {
    print("Assertion Failed: Square area must be 100, got:", m2.area)
}
if (m2.diameterSq != 200) {
    print("Assertion Failed: Square diagonal diameter squared must be 200, got:", m2.diameterSq)
}
print("  Square 10x10 verified: vertices =", m2.vertexCount, "| area =", m2.area, "| perimeter =", m2.perimeter, "| diamSq =", m2.diameterSq)
print("  Test Case 2 PASSED")

print("Running Test Case 3: Concave Star Polygon Interior Vertex Filtering...")
testPts3 = [
    Point2D(0, 50),
    Point2D(20, 20),
    Point2D(50, 0),
    Point2D(20, -20),
    Point2D(0, -50),
    Point2D(-20, -20),
    Point2D(-50, 0),
    Point2D(-20, 20),
    Point2D(0, 0)
]
hullMC3 = monotoneChainConvexHull(testPts3)
hullGS3 = grahamScanConvexHull(testPts3)
if (hullMC3.size() != 4) {
    print("Assertion Failed: Star polygon hull must retain only 4 outer tip vertices, got:", hullMC3.size())
}
if (areHullsEquivalent(hullMC3, hullGS3) != 1) {
    print("Assertion Failed: Star outer hull equivalence mismatch")
}
m3 = computeHullMetrics(hullMC3)
if (m3.doubleArea != 10000 || m3.area != 5000.0) {
    print("Assertion Failed: Diamond area must be 5000, got:", m3.area)
}
print("  Star outer diamond hull: vertices =", m3.vertexCount, "| area =", m3.area, "| diameterSq =", m3.diameterSq)
print("  Test Case 3 PASSED")

print("Running Test Case 4: Polygon Centroid and Invariant Center of Mass...")
testPts4 = [
    Point2D(0, 0),
    Point2D(6, 0),
    Point2D(6, 6),
    Point2D(0, 6)
]
hullMC4 = monotoneChainConvexHull(testPts4)
centroid4 = computePolygonCentroid(hullMC4)
if (centroid4.x != 3.0 || centroid4.y != 3.0) {
    print("Assertion Failed: Centroid of 6x6 square must be (3, 3), got:", centroid4.x, centroid4.y)
}
print("  6x6 Square Centroid correctly identified at: (", centroid4.x, ",", centroid4.y, ")")
print("  Test Case 4 PASSED")

print("Running Test Case 5: Point-In-Convex-Polygon Query Evaluation...")
testPts5 = [
    Point2D(0, 0),
    Point2D(8, 0),
    Point2D(8, 6),
    Point2D(0, 6)
]
hull5 = monotoneChainConvexHull(testPts5)
queryInside = Point2D(4, 3)
queryEdge = Point2D(8, 3)
queryVertex = Point2D(0, 6)
queryOutside = Point2D(9, 3)
queryCornerOutside = Point2D(-1, -1)

resInside = pointInConvexPolygon(hull5, queryInside)
resEdge = pointInConvexPolygon(hull5, queryEdge)
resVertex = pointInConvexPolygon(hull5, queryVertex)
resOutside = pointInConvexPolygon(hull5, queryOutside)
resCorner = pointInConvexPolygon(hull5, queryCornerOutside)

if (resInside != 1) {
    print("Assertion Failed: Point (4, 3) must be strictly interior (1), got:", resInside)
}
if (resEdge != 2) {
    print("Assertion Failed: Point (8, 3) must be on boundary (2), got:", resEdge)
}
if (resVertex != 2) {
    print("Assertion Failed: Point (0, 6) must be on boundary (2), got:", resVertex)
}
if (resOutside != 0 || resCorner != 0) {
    print("Assertion Failed: Exterior points must evaluate to 0, got:", resOutside, resCorner)
}
print("  Point queries: interior = 1, edge = 2, vertex = 2, exterior = 0: VALID")
print("  Test Case 5 PASSED")

print("Running Test Case 6: Rotating Calipers Diameter vs Brute Force Oracle...")
testPts6 = [
    Point2D(1, 2),
    Point2D(5, 8),
    Point2D(9, 3),
    Point2D(4, 1),
    Point2D(12, 6),
    Point2D(3, 10),
    Point2D(7, 7),
    Point2D(2, 5)
]
hull6 = monotoneChainConvexHull(testPts6)
rcDiamSq = rotatingCalipersDiameterSq(hull6)
bfDiamSq = bruteForceDiameterSq(testPts6)
if (rcDiamSq != bfDiamSq) {
    print("Assertion Failed: Rotating calipers diameter mismatch. RC:", rcDiamSq, "BF:", bfDiamSq)
}
print("  Rotating Calipers (", rcDiamSq, ") matched brute-force distance (", bfDiamSq, "): VALID")
print("  Test Case 6 PASSED")

print("Running Test Case 7: Convex Polygon with All Points on Hull...")
testPts7 = [
    Point2D(10, 0),
    Point2D(7, 7),
    Point2D(0, 10),
    Point2D(-7, 7),
    Point2D(-10, 0),
    Point2D(-7, -7),
    Point2D(0, -10),
    Point2D(7, -7)
]
hullMC7 = monotoneChainConvexHull(testPts7)
hullGS7 = grahamScanConvexHull(testPts7)
if (hullMC7.size() != 8 || hullGS7.size() != 8) {
    print("Assertion Failed: Octagon must preserve all 8 vertices, got MC:", hullMC7.size(), "GS:", hullGS7.size())
}
if (areHullsEquivalent(hullMC7, hullGS7) != 1) {
    print("Assertion Failed: Octagon hull equivalence mismatch")
}
m7 = computeHullMetrics(hullMC7)
bfD7 = bruteForceDiameterSq(testPts7)
if (m7.diameterSq != bfD7 || m7.diameterSq != 400) {
    print("Assertion Failed: Regular octagon diameter squared must be 400, got:", m7.diameterSq)
}
print("  Octagon perimeter =", m7.perimeter, "| doubleArea =", m7.doubleArea, "| diameterSq =", m7.diameterSq)
print("  Test Case 7 PASSED")

print("Running Test Case 8: Randomized 100-Point Cloud Stress Audit...")
randPts = []
rIdx = 0
rSeed = 1337
while (rIdx < 100) {
    rSeed = (rSeed * 1103515245 + 12345) % 2147483647
    rx = (rSeed % 200) - 100
    rSeed = (rSeed * 1103515245 + 12345) % 2147483647
    ry = (rSeed % 200) - 100
    randPts.push(Point2D(rx, ry))
    rIdx = rIdx + 1
}

hullMCRand = monotoneChainConvexHull(randPts)
hullGSRand = grahamScanConvexHull(randPts)

if (areHullsEquivalent(hullMCRand, hullGSRand) != 1) {
    print("Assertion Failed: Randomized 100-point cloud hull equivalence mismatch")
}

rcDiamRand = rotatingCalipersDiameterSq(hullMCRand)
bfDiamRand = bruteForceDiameterSq(randPts)
if (rcDiamRand != bfDiamRand) {
    print("Assertion Failed: Calipers diameter mismatch on random cloud. RC:", rcDiamRand, "BF:", bfDiamRand)
}

chkIdx = 0
allContained = 1
while (chkIdx < 100 && allContained == 1) {
    resContained = pointInConvexPolygon(hullMCRand, randPts[chkIdx])
    if (resContained == 0) {
        allContained = 0
        print("Assertion Failed: Point", chkIdx, "(", randPts[chkIdx].x, ",", randPts[chkIdx].y, ") is outside computed convex hull!")
    }
    chkIdx = chkIdx + 1
}
if (allContained != 1) {
    print("Assertion Failed: Convex hull containment violation")
}

mRand = computeHullMetrics(hullMCRand)
print("  Randomized cloud (100 points): Hull vertices =", mRand.vertexCount, "| DiameterSq =", mRand.diameterSq, "| Area =", mRand.area)
print("  All 100 points verified strictly inside/on hull boundary: VALID")
print("  Rotating Calipers diameter matched brute force exactly: VALID")
print("  Test Case 8 PASSED")

suiteElapsed = tm.millis() - hullSuiteStartTime
print("=== Monotone Chain & Graham Scan 2D Convex Hull Suite Summary ===")
print("All 8 Convex Hull test suites: SUCCESS in", suiteElapsed, "ms")
