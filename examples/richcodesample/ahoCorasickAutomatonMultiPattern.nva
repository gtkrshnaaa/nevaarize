print("=== Aho-Corasick Automaton Multi-Pattern Suite Summary ===")
if (allAhoCorasickPassed) {
    print("All Aho-Corasick test suites: SUCCESS")
} else {
    print("Some Aho-Corasick test suites: FAILED")
}

totalElapsed = t.millis() - suiteStartTime
print("[PASS] Aho-Corasick Automaton Multi-Pattern executed successfully in", totalElapsed, "ms")
