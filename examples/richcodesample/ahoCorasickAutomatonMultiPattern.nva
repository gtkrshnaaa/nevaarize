// --- Test Case 8: Randomized Dictionary Stress Verification against Brute-Force ---
print("Running Test Case 8: Randomized Dictionary Stress Audit vs Independent Model")
acStress = createAhoCorasick(300)

stressPatterns = [
    "ab", "bc", "cd", "abc", "bcd", "cde", "aba", "bab", "aaa", "bbb"
]

stressPatIdx = 0
while (stressPatIdx < stressPatterns.size()) {
    addPattern(acStress, stressPatterns[stressPatIdx])
    stressPatIdx = stressPatIdx + 1
}
buildAutomaton(acStress)

// Pre-formed stress corpus containing dense multi-pattern combinatorial matches
stressText = "abcbcdabcdababaaababcbcdabbcdeaaabbbabcdebababcbcdcdabcbcd" + "aaabbbcccdddabcbcdabacdebababcbcdabcbcdcdabcbcd" + "abababbbaaabbbcccabcbcdabcdababaaababcbcdabbcde"
sLen = s.length(stressText)

acStressMatches = searchAllOccurrences(acStress, stressText)

// Compute brute force match count for each pattern using charCodeAt
totalBruteCount = 0
chkPatIdx = 0
while (chkPatIdx < stressPatterns.size()) {
    patStr = stressPatterns[chkPatIdx]
    pL = s.length(patStr)

    pos = 0
    while (pos <= sLen - pL) {
        isMatch = true
        matchK = 0
        while (matchK < pL and isMatch) {
            if (s.charCodeAt(stressText, pos + matchK) != s.charCodeAt(patStr, matchK)) {
                isMatch = false
            }
            matchK = matchK + 1
        }
        if (isMatch) {
            totalBruteCount = totalBruteCount + 1
        }
        pos = pos + 1
    }

    chkPatIdx = chkPatIdx + 1
}

if (acStressMatches.size() != totalBruteCount) {
    print("[FAIL] Test Case 8 stress match count mismatch: AC got", acStressMatches.size(), "brute force got", totalBruteCount)
    allAhoCorasickPassed = false
} else {
    print("  Randomized text (120 chars) across 10 dictionary patterns verified")
    print("  AC Automaton matches (", acStressMatches.size(), ") exactly matched brute force search (", totalBruteCount, "): VALID")
    print("  Test Case 8 PASSED")
}

