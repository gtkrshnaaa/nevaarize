import stdlib math as m
import stdlib time as t

// Mandelbrot Set Visualization Simulation
// This script calculates the escape time for points in the complex plane
// and "visualizes" it by printing different characters to the console.

function mandelbrot(real, imag, maxIter) {
    zReal = real
    zImag = imag
    
    n = 0
    while (n < maxIter) {
        r2 = zReal * zReal
        i2 = zImag * zImag
        
        if (r2 + i2 > 4.0) {
            return n
        }
        
        zImag = 2.0 * zReal * zImag + imag
        zReal = r2 - i2 + real
        n = n + 1
    }
    return maxIter
}

function visualizeMandelbrot() {
    print("=== Nevaarize Mandelbrot Fractal Simulation ===")
    start = t.millis()
    
    // Define bounds for the complex plane
    minReal = -2.0
    maxReal = 1.0
    minImag = -1.2
    maxImag = 1.2
    
    // Resolution
    width = 60
    height = 30
    
    maxIterations = 50
    
    y = 0
    while (y < height) {
        imag = minImag + (y * (maxImag - minImag) / height)
        
        x = 0
        while (x < width) {
            real = minReal + (x * (maxReal - minReal) / width)
            
            iterCount = mandelbrot(real, imag, maxIterations)
            
            if (iterCount == maxIterations) {
                // Point inside the set
                // print("#") // Character-by-character printing might be slow in JIT output
            } else {
                // Point outside
                // print(".")
            }
            x = x + 1
        }
        y = y + 1
    }
    
    elapsed = t.millis() - start
    print("Calculation finished in:", elapsed, "ms")
    print("Mandelbrot fractal simulation complete.")
}

// Global Execution
visualizeMandelbrot()
