print("=== Roman Numeral ===")
romVals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
func romanValue(n) {
    total = 0
    i = 0
    while (i < 13) {
        while (n > romVals[i] - 1) {
            total = total + romVals[i]
            n = n - romVals[i]
        }
        i = i + 1
    }
    return total
}
print("42:", romanValue(42), "(expected: 42)")
print("100:", romanValue(100), "(expected: 100)")
print("1999:", romanValue(1999), "(expected: 1999)")
print("3999:", romanValue(3999), "(expected: 3999)")
rom = [10, 1, 5]
total = 0
i = 0
while (i < 3) {
    if (i + 1 < 3) {
        if (rom[i] < rom[i+1]) {
            total = total + rom[i+1] - rom[i]
            i = i + 2
        }
        else {
            total = total + rom[i]
            i = i + 1
        }
    } else { total = total + rom[i]
    i = i + 1 }
}
print("XIV:", total, "(expected: 14)")
print("Roman numeral finished.")
