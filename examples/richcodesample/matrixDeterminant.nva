print("=== Matrix Determinant ===")
det2 = 3 * 6 - 8 * 4
print("|3 8; 4 6| =", det2, "(expected: -14)")
detI = 1 * 1 - 0 * 0
print("|I2| =", detI, "(expected: 1)")
m = [1,2,3, 4,5,6, 7,8,9]
det3 = m[0] * (m[4]*m[8] - m[5]*m[7]) - m[1] * (m[3]*m[8] - m[5]*m[6]) + m[2] * (m[3]*m[7] - m[4]*m[6])
print("|1..9| =", det3, "(expected: 0)")
m2 = [2,1,3, 0,1,2, 1,0,1]
det3b = m2[0]*(m2[4]*m2[8]-m2[5]*m2[7]) - m2[1]*(m2[3]*m2[8]-m2[5]*m2[6]) + m2[2]*(m2[3]*m2[7]-m2[4]*m2[6])
print("|2,1,3;0,1,2;1,0,1| =", det3b)
print("Determinant finished.")
