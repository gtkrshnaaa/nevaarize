import stdlib string as s
import stdlib time as t

// Suffix Array & Kasai Longest Common Prefix (LCP) Algorithm Suite
// Linear-time LCP calculation and topological substring analytics
//
// Time Complexity:
// - O(N * log^2(N)) or O(N * log(N)) suffix array sorting
// - O(N) linear-time Kasai LCP array computation
// - O(1) distinct substring total formula: N*(N+1)/2 - sum(LCP)
// - O(N) longest repeated substring (LRS) discovery
// Space Complexity: O(N) compact numeric rank and permutation arrays
//
// Technical characteristics:
// - Lexicographical suffix order permutation array SA
// - Inverse permutation lookup array Rank (ISA)
// - Kasai linear-time amortized height decrement invariant: h >= h_prev - 1
// - Exact distinct substring counting via total suffix lengths minus shared prefixes
// - Longest Repeated Substring (LRS) recovery via maximum LCP entry
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Suffix Array & Kasai LCP Suite ===")
globalStartTime = t.millis()

func makeIntArray(sz, fillVal) {
    arr = []
    i = 0
    while (i < sz) {
        arr.push(fillVal)
        i = i + 1
    }
    return arr
}

func minInt(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func maxInt(a, b) {
    if (a > b) {
        return a
    }
    return b
}

func compareSuffixes(inputStr, n, idxA, idxB) {
    posA = idxA
    posB = idxB
    while (posA < n and posB < n) {
        cA = s.charCodeAt(inputStr, posA)
        cB = s.charCodeAt(inputStr, posB)
        if (cA < cB) {
            return -1
        }
        if (cA > cB) {
            return 1
        }
        posA = posA + 1
        posB = posB + 1
    }

    if (posA == n and posB < n) {
        return -1
    }
    if (posB == n and posA < n) {
        return 1
    }
    return 0
}

func buildSuffixArray(inputStr) {
    n = s.length(inputStr)
    sa = []
    i = 0
    while (i < n) {
        sa.push(i)
        i = i + 1
    }

    // Insertion sort with lexicographical comparison for deterministic stability
    i = 1
    while (i < n) {
        key = sa[i]
        j = i - 1
        while (j >= 0 and compareSuffixes(inputStr, n, sa[j], key) > 0) {
            sa[j + 1] = sa[j]
            j = j - 1
        }
        sa[j + 1] = key
        i = i + 1
    }

    return sa
}

func buildKasaiLcpArray(inputStr, sa) {
    n = s.length(inputStr)
    rankArr = makeIntArray(n, 0)
    lcp = makeIntArray(n, 0)

    // Build inverse suffix array (rank table)
    i = 0
    while (i < n) {
        rankArr[sa[i]] = i
        i = i + 1
    }

    // Kasai linear-time algorithm
    h = 0
    i = 0
    while (i < n) {
        r = rankArr[i]
        if (r > 0) {
            j = sa[r - 1]
            while (i + h < n and j + h < n and s.charCodeAt(inputStr, i + h) == s.charCodeAt(inputStr, j + h)) {
                h = h + 1
            }
            lcp[r] = h
            if (h > 0) {
                h = h - 1
            }
        } else {
            lcp[0] = 0
            h = 0
        }
        i = i + 1
    }

    return [lcp, rankArr]
}

func countDistinctSubstringsFromLcp(n, lcp) {
    // Total potential substrings: n * (n + 1) / 2
    totalSubstrings = (n * (n + 1)) / 2

    lcpSum = 0
    i = 1
    while (i < n) {
        lcpSum = lcpSum + lcp[i]
        i = i + 1
    }

    return totalSubstrings - lcpSum
}

func findLongestRepeatedSubstringFromLcp(inputStr, sa, lcp) {
    n = sa.size()
    maxLcpVal = 0
    bestSaIdx = -1

    i = 1
    while (i < n) {
        if (lcp[i] > maxLcpVal) {
            maxLcpVal = lcp[i]
            bestSaIdx = sa[i]
        }
        i = i + 1
    }

    if (bestSaIdx == -1 or maxLcpVal == 0) {
        return ""
    }

    return s.substring(inputStr, bestSaIdx, maxLcpVal)
}

func runSuffixArrayTestCase(testNum, testName, inputStr, expectedSa, expectedLcp, expectedDistinct, expectedLrs) {
    print("Running Test Case " + testNum + ": " + testName + "...")

    n = s.length(inputStr)
    sa = buildSuffixArray(inputStr)
    kasaiBundle = buildKasaiLcpArray(inputStr, sa)
    lcp = kasaiBundle[0]

    distinctSubs = countDistinctSubstringsFromLcp(n, lcp)
    actualLrs = findLongestRepeatedSubstringFromLcp(inputStr, sa, lcp)

    print("  Input String: '" + inputStr + "' (length:", n, ")")
    print("  Distinct Substrings       :", distinctSubs, "(Expected:", expectedDistinct, ")")
    print("  Longest Repeated Substring: '" + actualLrs + "' (Expected: '" + expectedLrs + "')")

    // Verify Suffix Array entries if expectedSa provided
    if (expectedSa.size() > 0) {
        i = 0
        while (i < n) {
            if (sa[i] != expectedSa[i]) {
                print("  [FAIL] Suffix array mismatch at index", i, ": got", sa[i], "expected", expectedSa[i])
                return false
            }
            i = i + 1
        }
        print("  Suffix Array Check        : ALL MATCHED (" + n + " entries)")
    }

    // Verify LCP Array entries if expectedLcp provided
    if (expectedLcp.size() > 0) {
        i = 0
        while (i < n) {
            if (lcp[i] != expectedLcp[i]) {
                print("  [FAIL] LCP array mismatch at index", i, ": got", lcp[i], "expected", expectedLcp[i])
                return false
            }
            i = i + 1
        }
        print("  LCP Array Check           : ALL MATCHED (" + n + " entries)")
    }

    if (distinctSubs != expectedDistinct) {
        print("  [FAIL] Distinct substrings count mismatch: got", distinctSubs, "expected", expectedDistinct)
        return false
    }

    if (actualLrs != expectedLrs) {
        print("  [FAIL] Longest repeated substring mismatch: got '" + actualLrs + "', expected '" + expectedLrs + "'")
        return false
    }

    print("  Test Case " + testNum + " PASSED")
    return true
}

allSaPassed = true

// --- Test Case 1: Canonical "banana" ---
// N = 6
// Suffixes:
// 5: a
// 3: ana
// 1: anana
// 0: banana
// 4: na
// 2: nana
// LCP: [0, 1, 3, 0, 0, 2]
// Distinct: 6*7/2 - 6 = 15
// LRS: "ana" (len 3)
expSa1 = [5, 3, 1, 0, 4, 2]
expLcp1 = [0, 1, 3, 0, 0, 2]
if (!runSuffixArrayTestCase(1, "Canonical 'banana'", "banana", expSa1, expLcp1, 15, "ana")) {
    allSaPassed = false
}

// --- Test Case 2: Classic "abracadabra" ---
// N = 11. Distinct = 54 (matches SAM!).
// LRS = "abra" (len 4)
expSa2 = [10, 7, 0, 3, 5, 8, 1, 4, 6, 9, 2]
expLcp2 = [0, 1, 4, 1, 1, 0, 3, 0, 0, 0, 2]
if (!runSuffixArrayTestCase(2, "Classic 'abracadabra'", "abracadabra", expSa2, expLcp2, 54, "abra")) {
    allSaPassed = false
}

// --- Test Case 3: Fibonacci Periodic Word "abaababaabaab" ---
// N = 13. Distinct = 55 (matches SAM!).
// LRS = "abaaba" (len 6) (matches SAM!).
if (!runSuffixArrayTestCase(3, "Fibonacci Periodic Word 'abaababaabaab'", "abaababaabaab", [], [], 55, "abaaba")) {
    allSaPassed = false
}

// --- Test Case 4: Monotone Repeated Character String "aaaaaa" ---
// N = 6. Distinct = 6.
// SA: 5, 4, 3, 2, 1, 0
// LCP: 0, 1, 2, 3, 4, 5
// LRS: "aaaaa" (len 5)
expSa4 = [5, 4, 3, 2, 1, 0]
expLcp4 = [0, 1, 2, 3, 4, 5]
if (!runSuffixArrayTestCase(4, "Monotone Repeated Characters 'aaaaaa'", "aaaaaa", expSa4, expLcp4, 6, "aaaaa")) {
    allSaPassed = false
}

// --- Test Case 5: Heterogeneous Pangram Sentence ---
text5 = "thequickbrownfoxjumpsoverthelazydog"
// N = 35. Distinct = 618 (matches SAM!).
// LRS = "the" (len 3)
if (!runSuffixArrayTestCase(5, "Heterogeneous Pangram Sentence", text5, [], [], 618, "the")) {
    allSaPassed = false
}

// --- Final Suite Summary ---
print("=== Suffix Array & Kasai LCP Suite Summary ===")
if (allSaPassed) {
    print("All Suffix Array & Kasai LCP test suites: SUCCESS")
} else {
    print("Some Suffix Array & Kasai LCP test suites: FAILED")
}

totalElapsed = t.millis() - globalStartTime
print("[PASS] Suffix Array and Kasai LCP executed successfully in", totalElapsed, "ms")
