import stdlib math as m

// Expression Parser Demonstration
// Demonstrates numerical evaluation without struct access issues

// Manual expression evaluation using Reverse Polish Notation (RPN)
// Operand stack approach

function rpnEval(rpnTokens, rpnTypes) {
    // rpnTypes: 0=number, 1=add, 2=sub, 3=mul, 4=div
    stack = []
    i = 0
    while (i < rpnTokens.size()) {
        tp = rpnTypes[i]
        if (tp == 0) {
            stack.push(rpnTokens[i])
        } elif (tp == 1) {
            b = stack.pop()
            a = stack.pop()
            stack.push(a + b)
        } elif (tp == 2) {
            b = stack.pop()
            a = stack.pop()
            stack.push(a - b)
        } elif (tp == 3) {
            b = stack.pop()
            a = stack.pop()
            stack.push(a * b)
        } elif (tp == 4) {
            b = stack.pop()
            a = stack.pop()
            stack.push(a / b)
        }
        i = i + 1
    }
    return stack[0]
}

// Main Execution
print("=== Nevaarize Expression Parser Demo ===")

// Expression 1: (10 + 5) * 2 = 30
// RPN: 10 5 + 2 *
rpnVals1 = [10.0, 5.0, 0.0, 2.0, 0.0]
rpnOps1 = [0, 0, 1, 0, 3]

print("Expression: (10 + 5) * 2")
result1 = rpnEval(rpnVals1, rpnOps1)
print("Result:", result1, "(Expected: 30.0)")

// Expression 2: 3 + 4 * 2 / (1 - 5) = 1
// RPN: 3 4 2 * 1 5 - / +
rpnVals2 = [3.0, 4.0, 2.0, 0.0, 1.0, 5.0, 0.0, 0.0, 0.0]
rpnOps2 = [0, 0, 0, 3, 0, 0, 2, 4, 1]

print("Expression: 3 + 4 * 2 / (1 - 5)")
result2 = rpnEval(rpnVals2, rpnOps2)
print("Result:", result2, "(Expected: 1.0)")

// Expression 3: 100 / 4 + 50 * 2 = 125
// RPN: 100 4 / 50 2 * +
rpnVals3 = [100.0, 4.0, 0.0, 50.0, 2.0, 0.0, 0.0]
rpnOps3 = [0, 0, 4, 0, 0, 3, 1]

print("Expression: 100 / 4 + 50 * 2")
result3 = rpnEval(rpnVals3, rpnOps3)
print("Result:", result3, "(Expected: 125.0)")

print("Parser demonstration finished.")
