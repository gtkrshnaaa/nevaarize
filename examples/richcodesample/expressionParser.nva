import stdlib math as m

// Recursive Descent Expression Parser
// Demonstrates structural parsing and recursion using numeric token arrays

// Token types: 0=Number, 1=Plus, 2=Minus, 3=Mul, 4=Div, 5=LParen, 6=RParen
struct Token {
    kind,
    value
}

// Global parser state
tokens = []
pos = 0

func parseExpression() {
    result = parseTerm()

    shouldContinue = true
    while (pos < tokens.size() and shouldContinue) {
        tok = tokens[pos]
        if (tok.kind == 1) {
            pos = pos + 1
            term = parseTerm()
            result = result + term
        } elif (tok.kind == 2) {
            pos = pos + 1
            term = parseTerm()
            result = result - term
        } else {
            shouldContinue = false
        }
    }
    return result
}

func parseTerm() {
    result = parseFactor()

    shouldContinue = true
    while (pos < tokens.size() and shouldContinue) {
        tok = tokens[pos]
        if (tok.kind == 3) {
            pos = pos + 1
            factor = parseFactor()
            result = result * factor
        } elif (tok.kind == 4) {
            pos = pos + 1
            factor = parseFactor()
            result = result / factor
        } else {
            shouldContinue = false
        }
    }
    return result
}

func parseFactor() {
    tok = tokens[pos]
    pos = pos + 1

    if (tok.kind == 5) {
        result = parseExpression()
        pos = pos + 1
        return result
    }

    return tok.value
}

// Main Execution
print("=== Nevaarize Expression Parser Demo ===")

// Expression: (10 + 5) * 2 - 8 / 4 = 28
// Pre-tokenized as numeric token array
tokens.push(Token(5, 0))
tokens.push(Token(0, 10.0))
tokens.push(Token(1, 0))
tokens.push(Token(0, 5.0))
tokens.push(Token(6, 0))
tokens.push(Token(3, 0))
tokens.push(Token(0, 2.0))
tokens.push(Token(2, 0))
tokens.push(Token(0, 8.0))
tokens.push(Token(4, 0))
tokens.push(Token(0, 4.0))

print("Input Expression: (10 + 5) * 2 - 8 / 4")

pos = 0
result = parseExpression()

print("Parsed Result:", result)
print("Expected: 28.0")

print("Parser demonstration finished.")
