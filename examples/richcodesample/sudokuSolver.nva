import stdlib time as t

// Sudoku Solver
// Solves a 9x9 Sudoku puzzle using recursive backtracking.
// Uses a flat array for grid representation (81 elements).

func printGrid(grid) {
    row = 0
    while (row < 9) {
        line = ""
        col = 0
        while (col < 9) {
            val = grid[row * 9 + col]
            if (val == 0) {
                // Empty cell
            } else {
                // Value
            }
            col = col + 1
        }
        print("Row", row, ":", grid[row*9+0], grid[row*9+1], grid[row*9+2], "|", grid[row*9+3], grid[row*9+4], grid[row*9+5], "|", grid[row*9+6], grid[row*9+7], grid[row*9+8])
        row = row + 1
        if (row % 3 == 0 and row < 9) {
            print("-------------------------")
        }
    }
}

func isSafe(grid, row, col, num) {
    // Check row
    c = 0
    while (c < 9) {
        if (grid[row * 9 + c] == num) {
            return 0
        }
        c = c + 1
    }
    
    // Check column
    r = 0
    while (r < 9) {
        if (grid[r * 9 + col] == num) {
            return 0
        }
        r = r + 1
    }
    
    // Check 3x3 box
    boxRowStart = row - (row % 3)
    boxColStart = col - (col % 3)
    
    r = 0
    while (r < 3) {
        c = 0
        while (c < 3) {
            if (grid[(boxRowStart + r) * 9 + (boxColStart + c)] == num) {
                return 0
            }
            c = c + 1
        }
        r = r + 1
    }
    
    return 1
}

func solveSudoku(grid) {
    // Find unassigned location
    row = -1
    col = -1
    isEmpty = 0
    
    r = 0
    while (r < 9 and isEmpty == 0) {
        c = 0
        while (c < 9 and isEmpty == 0) {
            if (grid[r * 9 + c] == 0) {
                row = r
                col = c
                isEmpty = 1
            }
            c = c + 1
        }
        r = r + 1
    }
    
    // No empty cells left
    if (isEmpty == 0) {
        return 1
    }
    
    num = 1
    while (num <= 9) {
        if (isSafe(grid, row, col, num) == 1) {
            grid[row * 9 + col] = num
            
            if (solveSudoku(grid) == 1) {
                return 1
            }
            
            // Backtrack
            grid[row * 9 + col] = 0
        }
        num = num + 1
    }
    
    return 0
}

// Main Execution
print("=== Nevaarize Sudoku Solver Demo ===")

// 0 represents empty cells
grid = [
    5, 3, 0, 0, 7, 0, 0, 0, 0,
    6, 0, 0, 1, 9, 5, 0, 0, 0,
    0, 9, 8, 0, 0, 0, 0, 6, 0,
    8, 0, 0, 0, 6, 0, 0, 0, 3,
    4, 0, 0, 8, 0, 3, 0, 0, 1,
    7, 0, 0, 0, 2, 0, 0, 0, 6,
    0, 6, 0, 0, 0, 0, 2, 8, 0,
    0, 0, 0, 4, 1, 9, 0, 0, 5,
    0, 0, 0, 0, 8, 0, 0, 7, 9
]

print("Original Puzzle:")
printGrid(grid)

start = t.millis()
if (solveSudoku(grid) == 1) {
    elapsed = t.millis() - start
    print("\nPuzzle Solved in", elapsed, "ms:")
    printGrid(grid)
} else {
    print("\nNo solution exists.")
}

print("Sudoku simulator finished.")
