import stdlib time as t

// 4x4 Sudoku (Shidoku) Solver
// Solves a 4x4 puzzle using recursive backtracking.
// Demonstrates logic and recursion in a JIT-friendly way.

function printGrid(grid) {
    r = 0
    while (r < 4) {
        print("Row", r, ":", grid[r*4+0], grid[r*4+1], "|", grid[r*4+2], grid[r*4+3])
        r = r + 1
        if (r % 2 == 0 and r < 4) {
            print("-------------")
        }
    }
}

function isSafe(grid, row, col, num) {
    // Check row
    c = 0
    while (c < 4) {
        if (grid[row * 4 + c] == num) {
            return 0
        }
        c = c + 1
    }
    
    // Check column
    r = 0
    while (r < 4) {
        if (grid[r * 4 + col] == num) {
            return 0
        }
        r = r + 1
    }
    
    // Check 2x2 box
    boxRowStart = row - (row % 2)
    boxColStart = col - (col % 2)
    
    br = 0
    while (br < 2) {
        bc = 0
        while (bc < 2) {
            if (grid[(boxRowStart + br) * 4 + (boxColStart + bc)] == num) {
                return 0
            }
            bc = bc + 1
        }
        br = br + 1
    }
    
    return 1
}

function solveSudoku(grid) {
    row = -1
    col = -1
    found = 0
    
    r = 0
    while (r < 4 and found == 0) {
        c = 0
        while (c < 4 and found == 0) {
            if (grid[r * 4 + c] == 0) {
                row = r
                col = c
                found = 1
            }
            c = c + 1
        }
        r = r + 1
    }
    
    if (found == 0) { return 1 }
    
    num = 1
    while (num <= 4) {
        if (isSafe(grid, row, col, num) == 1) {
            grid[row * 4 + col] = num
            
            if (solveSudoku(grid) == 1) { return 1 }
            
            grid[row * 4 + col] = 0
        }
        num = num + 1
    }
    return 0
}

// Main Execution
print("=== Nevaarize 4x4 Sudoku Solver Demo ===")

grid = [
    1, 0, 3, 0,
    0, 0, 2, 1,
    0, 1, 0, 2,
    2, 4, 0, 0
]

print("Original Puzzle:")
printGrid(grid)

start = t.millis()
solved = solveSudoku(grid)
elapsed = t.millis() - start

if (solved == 1) {
    print("\nSolved in", elapsed, "ms:")
    printGrid(grid)
} else {
    print("\nNo solution exists.")
}

print("Sudoku simulator finished.")
