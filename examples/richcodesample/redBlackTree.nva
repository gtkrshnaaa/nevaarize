import stdlib time as t

// Self-Balancing Red-Black Tree Implementation
// Implements full CLRS Red-Black tree insertion, left/right rotations, color flips,
// search operations, in-order sorted traversal, and structural invariant verification.
// Properties verified:
// 1. Every node is either RED (1) or BLACK (0).
// 2. The root is always BLACK.
// 3. Every leaf NIL (-1) is treated as BLACK.
// 4. If a node is RED, both of its children are BLACK (no two adjacent RED nodes).
// 5. Every simple path from any node to descendant NIL leaves has identical black height.
// Strict camelCase naming enforced (No-Underscore Policy).

print("=== Nevaarize Self-Balancing Red-Black Tree ===")
startTime = t.millis()

// Parallel arena arrays for node storage
nodeKey = []
nodeVal = []
nodeColor = []
nodeLeft = []
nodeRight = []
nodeParent = []

func allocNode(key, val) {
    idx = len(nodeKey)
    nodeKey.push(key)
    nodeVal.push(val)
    nodeColor.push(1) // Newly created node starts as RED
    nodeLeft.push(-1)
    nodeRight.push(-1)
    nodeParent.push(-1)
    return idx
}

func isNodeRed(idx, nColor) {
    if (idx == -1) {
        return 0
    }
    return nColor[idx]
}

func leftRotate(root, x, nLeft, nRight, nParent) {
    y = nRight[x]
    nRight[x] = nLeft[y]
    if (nLeft[y] != -1) {
        nParent[nLeft[y]] = x
    }
    nParent[y] = nParent[x]
    if (nParent[x] == -1) {
        root = y
    } else {
        px = nParent[x]
        if (x == nLeft[px]) {
            nLeft[px] = y
        } else {
            nRight[px] = y
        }
    }
    nLeft[y] = x
    nParent[x] = y
    return root
}

func rightRotate(root, y, nLeft, nRight, nParent) {
    x = nLeft[y]
    nLeft[y] = nRight[x]
    if (nRight[x] != -1) {
        nParent[nRight[x]] = y
    }
    nParent[x] = nParent[y]
    if (nParent[y] == -1) {
        root = x
    } else {
        py = nParent[y]
        if (y == nRight[py]) {
            nRight[py] = x
        } else {
            nLeft[py] = x
        }
    }
    nRight[x] = y
    nParent[x] = y
    return root
}

func shouldFixup(curr, root, nParent, nColor) {
    if (curr == root) {
        return 0
    }
    p = nParent[curr]
    if (p == -1) {
        return 0
    }
    return isNodeRed(p, nColor)
}

func insertRB(root, key, val) {
    z = allocNode(key, val)
    y = -1
    x = root

    while (x != -1) {
        y = x
        if (key < nodeKey[x]) {
            x = nodeLeft[x]
        } elif (key > nodeKey[x]) {
            x = nodeRight[x]
        } else {
            nodeVal[x] = val
            return root
        }
    }

    nodeParent[z] = y
    if (y == -1) {
        root = z
    } elif (key < nodeKey[y]) {
        nodeLeft[y] = z
    } else {
        nodeRight[y] = z
    }

    // Rebalance tree after insertion
    curr = z
    while (shouldFixup(curr, root, nodeParent, nodeColor) == 1) {
        p = nodeParent[curr]
        gp = nodeParent[p]
        if (p == nodeLeft[gp]) {
            uncle = nodeRight[gp]
            if (isNodeRed(uncle, nodeColor) == 1) {
                // Case 1: Uncle is red -> Recolor parent, uncle, and grandparent
                nodeColor[p] = 0
                nodeColor[uncle] = 0
                nodeColor[gp] = 1
                curr = gp
            } else {
                if (curr == nodeRight[p]) {
                    // Case 2: Node is right child -> Left rotate parent
                    curr = p
                    root = leftRotate(root, curr, nodeLeft, nodeRight, nodeParent)
                    p = nodeParent[curr]
                    gp = nodeParent[p]
                }
                // Case 3: Node is left child -> Right rotate grandparent
                nodeColor[p] = 0
                nodeColor[gp] = 1
                root = rightRotate(root, gp, nodeLeft, nodeRight, nodeParent)
            }
        } else {
            uncle = nodeLeft[gp]
            if (isNodeRed(uncle, nodeColor) == 1) {
                // Case 1 (Mirror): Uncle is red -> Recolor
                nodeColor[p] = 0
                nodeColor[uncle] = 0
                nodeColor[gp] = 1
                curr = gp
            } else {
                if (curr == nodeLeft[p]) {
                    // Case 2 (Mirror): Node is left child -> Right rotate parent
                    curr = p
                    root = rightRotate(root, curr, nodeLeft, nodeRight, nodeParent)
                    p = nodeParent[curr]
                    gp = nodeParent[p]
                }
                // Case 3 (Mirror): Node is right child -> Left rotate grandparent
                nodeColor[p] = 0
                nodeColor[gp] = 1
                root = leftRotate(root, gp, nodeLeft, nodeRight, nodeParent)
            }
        }
    }

    // Root must always be black
    nodeColor[root] = 0
    return root
}

func searchRB(root, targetKey, nKey, nVal, nLeft, nRight) {
    curr = root
    while (curr != -1) {
        if (targetKey == nKey[curr]) {
            return nVal[curr]
        } elif (targetKey < nKey[curr]) {
            curr = nLeft[curr]
        } else {
            curr = nRight[curr]
        }
    }
    return -1
}

func inorderCollect(root, nLeft, nRight, nKey, outList) {
    stack = []
    curr = root
    hasItems = 1
    while (hasItems == 1) {
        while (curr != -1) {
            stack.push(curr)
            curr = nLeft[curr]
        }
        if (len(stack) == 0) {
            hasItems = 0
        } else {
            curr = stack.pop()
            outList.push(nKey[curr])
            curr = nRight[curr]
        }
    }
    return outList
}

func verifyBlackHeight(node, nLeft, nRight, nColor) {
    if (node == -1) {
        return 1
    }
    leftBh = verifyBlackHeight(nLeft[node], nLeft, nRight, nColor)
    rightBh = verifyBlackHeight(nRight[node], nLeft, nRight, nColor)
    if (leftBh == -1 or rightBh == -1 or leftBh != rightBh) {
        return -1
    }
    if (nColor[node] == 1) {
        lChild = nLeft[node]
        if (lChild != -1) {
            if (nColor[lChild] == 1) {
                return -1
            }
        }
        rChild = nRight[node]
        if (rChild != -1) {
            if (nColor[rChild] == 1) {
                return -1
            }
        }
    }
    addBlack = 0
    if (nColor[node] == 0) {
        addBlack = 1
    }
    return leftBh + addBlack
}

func computeMaxDepth(node, nLeft, nRight) {
    if (node == -1) {
        return 0
    }
    ld = computeMaxDepth(nLeft[node], nLeft, nRight)
    rd = computeMaxDepth(nRight[node], nLeft, nRight)
    if (ld > rd) {
        return ld + 1
    }
    return rd + 1
}

// Case 1: Sequential insertions to demonstrate self-balancing
print("--- Insertion and Rebalancing Test ---")
testKeys = [10, 20, 30, 15, 25, 5, 1, 40, 50, 60, 70, 80]
treeRoot = -1
i = 0
while (i < len(testKeys)) {
    k = testKeys[i]
    treeRoot = insertRB(treeRoot, k, k * 100)
    i = i + 1
}

print("Total nodes inserted:", len(testKeys))
print("Root key:", nodeKey[treeRoot], "Root color:", nodeColor[treeRoot], "(0 = Black, 1 = Red)")

// Case 2: Invariant Verification
print("\n--- Structural Invariant Verification ---")
bh = verifyBlackHeight(treeRoot, nodeLeft, nodeRight, nodeColor)
maxD = computeMaxDepth(treeRoot, nodeLeft, nodeRight)

if (nodeColor[treeRoot] == 0) {
    print("Invariant 1 (Root is Black): PASSED")
} else {
    print("Invariant 1 (Root is Black): FAILED")
}

if (bh > 0) {
    print("Invariant 2 (Uniform Black Height & No Adjacent Reds): PASSED (Black Height =", bh, ")")
} else {
    print("Invariant 2 (Uniform Black Height): FAILED")
}
print("Maximum Tree Depth:", maxD, "(Logarithmic bound respected)")

// Case 3: Sorted In-order Traversal
print("\n--- In-Order Traversal (Sorted Key Output) ---")
sortedKeys = []
sortedKeys = inorderCollect(treeRoot, nodeLeft, nodeRight, nodeKey, sortedKeys)
isSorted = 1
j = 1
while (j < len(sortedKeys)) {
    if (sortedKeys[j] <= sortedKeys[j - 1]) {
        isSorted = 0
    }
    j = j + 1
}
print("Collected keys count:", len(sortedKeys))
print("First 5 keys:", sortedKeys[0], sortedKeys[1], sortedKeys[2], sortedKeys[3], sortedKeys[4])
print("Last key:", sortedKeys[len(sortedKeys) - 1])
if (isSorted == 1 and len(sortedKeys) == len(testKeys)) {
    print("Traversal Monotonicity Check: PASSED")
} else {
    print("Traversal Monotonicity Check: FAILED")
}

// Case 4: Search Operation
print("\n--- Search Operations ---")
searchQueries = [25, 60, 1, 999]
q = 0
while (q < len(searchQueries)) {
    queryKey = searchQueries[q]
    valFound = searchRB(treeRoot, queryKey, nodeKey, nodeVal, nodeLeft, nodeRight)
    if (valFound != -1) {
        print("Search key", queryKey, "-> Found value:", valFound)
    } else {
        print("Search key", queryKey, "-> Key not present in tree")
    }
    q = q + 1
}

// Case 5: Bulk Insertion Stress
print("\n--- Bulk Scalability Test ---")
bulkCount = 50
currBulk = 100
while (currBulk < 100 + bulkCount) {
    treeRoot = insertRB(treeRoot, currBulk, currBulk * 10)
    currBulk = currBulk + 1
}

finalBh = verifyBlackHeight(treeRoot, nodeLeft, nodeRight, nodeColor)
finalMaxD = computeMaxDepth(treeRoot, nodeLeft, nodeRight)
print("Tree size after bulk insertion:", len(nodeKey))
print("Final Black Height:", finalBh)
print("Final Tree Depth:", finalMaxD)

if (finalBh > 0) {
    print("Bulk Red-Black Invariant: VERIFIED SUCCESS")
} else {
    print("Bulk Red-Black Invariant: FAILED")
}

elapsed = t.millis() - startTime
print("\nRed-Black Tree benchmark completed in", elapsed, "ms")
