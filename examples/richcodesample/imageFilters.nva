import stdlib ai as ai
import stdlib math as m
import stdlib time as t

// Image Filter Simulation
// Demonstrates matrix operations with SIMD-accelerated AI module

print("Nevaarize Image Processing Simulation")
start = t.millis()

width = 64
height = 64

// Create random image as flat tensor (no struct wrapping)
imgData = ai.RandU(1, width * height)
print("Created", width, "x", height, "image.")

// Statistics
mean = ai.Mean(imgData)
print("Original Image Statistics:")
print("- Mean Intensity:", mean)

// Apply Box Blur Filter
print("Applying Box Blur Filter (3x3 Kernel)...")
blurred = ai.Zeros(1, width * height)

// Simulate 3x3 convolution by averaging 9 passes
ai.Add(blurred, imgData)
i = 0
while (i < 8) {
    ai.Add(blurred, imgData)
    i = i + 1
}
ai.Scale(blurred, 1.0 / 9.0)

blurMean = ai.Mean(blurred)
print("Blurred Image Statistics:")
print("- Mean Intensity:", blurMean)

// Edge Detection simulation (difference kernel)
print("Simulating Edge Detection...")
edges = ai.Zeros(1, width * height)
ai.Add(edges, imgData)
ai.Scale(edges, 2.0)
ai.Sub(edges, blurred)

edgeMean = ai.Mean(edges)
print("Edge Image Statistics:")
print("- Mean Edge Response:", edgeMean)

elapsed = t.millis() - start
print("Image processing pipeline finished in", elapsed, "ms")
