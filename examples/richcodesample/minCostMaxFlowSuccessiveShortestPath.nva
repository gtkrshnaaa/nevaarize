import stdlib time as t

// Minimum-Cost Maximum Flow (MCMF) Successive Shortest Path & Cycle-Canceling Suite
// Time Complexity: O(F * (V * E)) with SPFA shortest path augmentations
// Space Complexity: O(V + E) compact forward-star residual representation
// Technical characteristics:
// - Primal-Dual Successive Shortest Path (SSP) with SPFA supporting negative residual costs
// - Reverse-edge skew symmetry and exact residual capacity tracking
// - Klein's Cycle-Canceling Theorem verification: optimality holds iff residual has no negative cycles
// - Active negative cycle detection via Bellman-Ford with cycle traversal and cancellation
// - Formal invariant assertions: flow conservation, capacity compliance, and zero negative residual cycles
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Min-Cost Max-Flow (SSP) & Cycle Canceling Suite ===")
globalStartTime = t.millis()

func makeIntArray(sz, fillVal) {
    arr = []
    i = 0
    while (i < sz) {
        arr.push(fillVal)
        i = i + 1
    }
    return arr
}

func minInt(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func createMCMFNetwork(numNodes) {
    head = makeIntArray(numNodes, -1)
    edgeTo = []
    edgeCap = []
    edgeFlow = []
    edgeCost = []
    edgeRev = []
    edgeNext = []
    return [numNodes, head, edgeTo, edgeCap, edgeFlow, edgeCost, edgeRev, edgeNext]
}

func addMCMFEdge(net, u, v, cap, cost) {
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeCost = net[5]
    edgeRev = net[6]
    edgeNext = net[7]

    forwardIdx = edgeTo.size()
    reverseIdx = forwardIdx + 1

    // Forward edge u -> v
    edgeTo.push(v)
    edgeCap.push(cap)
    edgeFlow.push(0)
    edgeCost.push(cost)
    edgeRev.push(reverseIdx)
    edgeNext.push(head[u])
    head[u] = forwardIdx

    // Residual backward edge v -> u
    edgeTo.push(u)
    edgeCap.push(0)
    edgeFlow.push(0)
    edgeCost.push(0 - cost)
    edgeRev.push(forwardIdx)
    edgeNext.push(head[v])
    head[v] = reverseIdx

    net[1] = head
    net[2] = edgeTo
    net[3] = edgeCap
    net[4] = edgeFlow
    net[5] = edgeCost
    net[6] = edgeRev
    net[7] = edgeNext
}

func executeSuccessiveShortestPath(net, src, snk) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeCost = net[5]
    edgeRev = net[6]
    edgeNext = net[7]

    if (src == snk or numNodes <= 1) {
        return [0, 0, 0]
    }

    infCost = 1000000000
    totalFlow = 0
    totalCost = 0
    augmentations = 0

    dist = makeIntArray(numNodes, infCost)
    parentEdge = makeIntArray(numNodes, -1)
    inQueue = makeIntArray(numNodes, 0)

    hasAugmentingPath = true
    while (hasAugmentingPath) {
        i = 0
        while (i < numNodes) {
            dist[i] = infCost
            parentEdge[i] = -1
            inQueue[i] = 0
            i = i + 1
        }

        queue = []
        qHead = 0

        dist[src] = 0
        queue.push(src)
        inQueue[src] = 1

        while (qHead < queue.size()) {
            u = queue[qHead]
            qHead = qHead + 1
            inQueue[u] = 0

            e = head[u]
            while (e != -1) {
                remCap = edgeCap[e] - edgeFlow[e]
                if (remCap > 0) {
                    v = edgeTo[e]
                    c = edgeCost[e]
                    if (dist[u] + c < dist[v]) {
                        dist[v] = dist[u] + c
                        parentEdge[v] = e
                        if (inQueue[v] == 0) {
                            queue.push(v)
                            inQueue[v] = 1
                        }
                    }
                }
                e = edgeNext[e]
            }
        }

        if (dist[snk] == infCost) {
            hasAugmentingPath = false
        } else {
            // Find bottleneck along shortest augmenting path
            bottleneck = infCost
            curr = snk
            while (curr != src) {
                e = parentEdge[curr]
                remCap = edgeCap[e] - edgeFlow[e]
                if (remCap < bottleneck) {
                    bottleneck = remCap
                }
                rev = edgeRev[e]
                curr = edgeTo[rev]
            }

            // Augment flow along shortest path
            curr = snk
            while (curr != src) {
                e = parentEdge[curr]
                edgeFlow[e] = edgeFlow[e] + bottleneck
                rev = edgeRev[e]
                edgeFlow[rev] = edgeFlow[rev] - bottleneck
                curr = edgeTo[rev]
            }

            totalFlow = totalFlow + bottleneck
            totalCost = totalCost + bottleneck * dist[snk]
            augmentations = augmentations + 1
        }
    }

    return [totalFlow, totalCost, augmentations]
}

func detectResidualNegativeCycle(net) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeCost = net[5]
    edgeRev = net[6]
    edgeNext = net[7]

    dist = makeIntArray(numNodes, 0)
    parent = makeIntArray(numNodes, -1)
    parentEdge = makeIntArray(numNodes, -1)

    cycleNode = -1
    iter = 0
    while (iter < numNodes) {
        cycleNode = -1
        u = 0
        while (u < numNodes) {
            e = head[u]
            while (e != -1) {
                remCap = edgeCap[e] - edgeFlow[e]
                if (remCap > 0) {
                    v = edgeTo[e]
                    c = edgeCost[e]
                    if (dist[u] + c < dist[v]) {
                        dist[v] = dist[u] + c
                        parent[v] = u
                        parentEdge[v] = e
                        cycleNode = v
                    }
                }
                e = edgeNext[e]
            }
            u = u + 1
        }
        iter = iter + 1
    }

    if (cycleNode == -1) {
        return [false, []]
    }

    // Step back numNodes steps to guarantee inside cycle
    i = 0
    while (i < numNodes) {
        cycleNode = parent[cycleNode]
        i = i + 1
    }

    cycleEdges = []
    curr = cycleNode
    tracing = true
    while (tracing) {
        e = parentEdge[curr]
        cycleEdges.push(e)
        curr = parent[curr]
        if (curr == cycleNode or cycleEdges.size() >= numNodes) {
            tracing = false
        }
    }

    return [true, cycleEdges]
}

func cancelResidualCycle(net, cycleEdges) {
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeCost = net[5]
    edgeRev = net[6]

    infCap = 1000000000
    bottleneck = infCap
    cycleCostSum = 0

    i = 0
    while (i < cycleEdges.size()) {
        e = cycleEdges[i]
        remCap = edgeCap[e] - edgeFlow[e]
        if (remCap < bottleneck) {
            bottleneck = remCap
        }
        cycleCostSum = cycleCostSum + edgeCost[e]
        i = i + 1
    }

    i = 0
    while (i < cycleEdges.size()) {
        e = cycleEdges[i]
        edgeFlow[e] = edgeFlow[e] + bottleneck
        rev = edgeRev[e]
        edgeFlow[rev] = edgeFlow[rev] - bottleneck
        i = i + 1
    }

    deltaCost = bottleneck * cycleCostSum
    return [bottleneck, cycleCostSum, deltaCost]
}

func verifyMCMFInvariants(net, src, snk, totalFlow, totalCost) {
    numNodes = net[0]
    head = net[1]
    edgeTo = net[2]
    edgeCap = net[3]
    edgeFlow = net[4]
    edgeCost = net[5]
    edgeRev = net[6]
    edgeNext = net[7]

    computedCost = 0

    // Check capacity constraints and skew symmetry
    e = 0
    while (e < edgeTo.size()) {
        if (e % 2 == 0) {
            cap = edgeCap[e]
            flw = edgeFlow[e]
            c = edgeCost[e]
            rev = edgeRev[e]
            revFlw = edgeFlow[rev]

            if (flw < 0 or flw > cap) {
                return false
            }
            if (flw != (0 - revFlw)) {
                return false
            }
            computedCost = computedCost + flw * c
        }
        e = e + 1
    }

    if (computedCost != totalCost) {
        return false
    }

    // Check node flow conservation
    u = 0
    while (u < numNodes) {
        netOutflow = 0
        e = head[u]
        while (e != -1) {
            netOutflow = netOutflow + edgeFlow[e]
            e = edgeNext[e]
        }

        if (u == src) {
            if (netOutflow != totalFlow) {
                return false
            }
        } elif (u == snk) {
            if (netOutflow != (0 - totalFlow)) {
                return false
            }
        } else {
            if (netOutflow != 0) {
                return false
            }
        }
        u = u + 1
    }

    return true
}

func runMCMFTestCase(caseId, description, numNodes, edgesList, src, snk, expectedFlow, expectedCost) {
    print("Running Test Case " + caseId + ": " + description + "...")
    edgeCount = edgesList.size() / 4
    print("  Nodes: " + numNodes + ", Directed Edges: " + edgeCount + ", Source: " + src + ", Sink: " + snk)

    net = createMCMFNetwork(numNodes)
    i = 0
    while (i < edgesList.size()) {
        u = edgesList[i]
        v = edgesList[i + 1]
        cap = edgesList[i + 2]
        c = edgesList[i + 3]
        addMCMFEdge(net, u, v, cap, c)
        i = i + 4
    }

    res = executeSuccessiveShortestPath(net, src, snk)
    computedFlow = res[0]
    computedCost = res[1]
    augs = res[2]

    invariantsHold = verifyMCMFInvariants(net, src, snk, computedFlow, computedCost)
    negCycleCheck = detectResidualNegativeCycle(net)
    hasNegCycle = negCycleCheck[0]

    print("  Max Flow Computed   : " + computedFlow + " (Expected: " + expectedFlow + ")")
    print("  Min Cost Computed   : " + computedCost + " (Expected: " + expectedCost + ")")
    print("  Augmentations       : " + augs)
    invariantsText = "INVALID"
    if (invariantsHold) {
        invariantsText = "VALID"
    }
    print("  Flow Invariants     : " + invariantsText)
    print("  Klein Neg-Cycle Free: " + (!hasNegCycle))

    if (computedFlow == expectedFlow and computedCost == expectedCost and invariantsHold and !hasNegCycle) {
        print("  Test Case " + caseId + " PASSED (MCMF optimality and cycle-free residual verified)")
        return true
    }

    print("[FAIL] Test Case " + caseId + " failed verification")
    return false
}

allMCMFPassed = true

// --- Test Case 1: Canonical 4-Node Competing Diamond Network ---
e1 = [
    0, 1, 4, 1,
    0, 2, 2, 5,
    1, 3, 2, 2,
    1, 2, 3, 1,
    2, 3, 5, 1
]
if (!runMCMFTestCase(1, "Canonical 4-Node Competing Diamond Network", 4, e1, 0, 3, 6, 24)) {
    allMCMFPassed = false
}

// --- Test Case 2: 6-Node Industrial Logistics Network ---
e2 = [
    0, 1, 10, 2,
    0, 2, 10, 4,
    1, 2, 5, 1,
    1, 3, 8, 5,
    2, 4, 7, 3,
    3, 5, 10, 2,
    4, 3, 4, 1,
    4, 5, 10, 3
]
if (!runMCMFTestCase(2, "6-Node Industrial Logistics Network", 6, e2, 0, 5, 15, 140)) {
    allMCMFPassed = false
}

// --- Test Case 3: 3x3 Worker-Job Assignment Problem (8 Nodes) ---
// Source 0, Workers 1,2,3, Jobs 4,5,6, Sink 7
// Cost matrix:
// W1: J1=9, J2=2, J3=7
// W2: J1=6, J2=4, J3=3
// W3: J1=5, J2=8, J3=1
// Optimal assignment: W1->J2 (2), W2->J1 (6), W3->J3 (1) -> Cost = 9
e3 = [
    0, 1, 1, 0,
    0, 2, 1, 0,
    0, 3, 1, 0,
    1, 4, 1, 9,  1, 5, 1, 2,  1, 6, 1, 7,
    2, 4, 1, 6,  2, 5, 1, 4,  2, 6, 1, 3,
    3, 4, 1, 5,  3, 5, 1, 8,  3, 6, 1, 1,
    4, 7, 1, 0,
    5, 7, 1, 0,
    6, 7, 1, 0
]
if (!runMCMFTestCase(3, "3x3 Worker-Job Bipartite Min-Cost Assignment", 8, e3, 0, 7, 3, 9)) {
    allMCMFPassed = false
}

// --- Test Case 4: Pipeline Network with Disconnected Sink ---
e4 = [
    0, 1, 10, 3,
    1, 2, 10, 2,
    3, 4, 10, 1
]
if (!runMCMFTestCase(4, "Disconnected Sink Zero Flow Boundary", 5, e4, 0, 4, 0, 0)) {
    allMCMFPassed = false
}

// --- Test Case 5: Direct Klein Negative Cycle Detection & Cancellation Demonstration ---
print("Running Test Case 5: Klein Negative Cycle Detection & Cancellation Demonstration...")
netCycle = createMCMFNetwork(4)
// Create a 4-node directed cycle 0 -> 1 -> 2 -> 3 -> 0 with negative total cost
addMCMFEdge(netCycle, 0, 1, 10, 3)
addMCMFEdge(netCycle, 1, 2, 10, -8)
addMCMFEdge(netCycle, 2, 3, 10, 2)
addMCMFEdge(netCycle, 3, 0, 10, 1)
// Total cycle cost = 3 - 8 + 2 + 1 = -2 per unit of flow!
// Initially flow is 0, so residual network contains this negative cycle
cycleCheck1 = detectResidualNegativeCycle(netCycle)
hasNegCycleInit = cycleCheck1[0]
cycleEdges = cycleCheck1[1]

print("  Initial Residual Negative Cycle Present: " + hasNegCycleInit)
if (!hasNegCycleInit) {
    print("[FAIL] Failed to detect initial negative cycle")
    allMCMFPassed = false
} else {
    print("  Cycle length: " + cycleEdges.size() + " edges")
    cancelRes = cancelResidualCycle(netCycle, cycleEdges)
    bottleneckPushed = cancelRes[0]
    cycleCost = cancelRes[1]
    deltaCost = cancelRes[2]

    print("  Pushed flow along cycle: " + bottleneckPushed)
    print("  Cycle unit cost        : " + cycleCost)
    print("  Total cost change      : " + deltaCost)

    // After canceling, residual edge (1 -> 2) is saturated, back-edge (2 -> 1) has cost +8
    // No more negative cycles should remain!
    cycleCheck2 = detectResidualNegativeCycle(netCycle)
    hasNegCycleAfter = cycleCheck2[0]
    print("  Post-cancellation Negative Cycle Present: " + hasNegCycleAfter)

    if (!hasNegCycleAfter and deltaCost < 0 and bottleneckPushed == 10) {
        print("  Test Case 5 PASSED (Klein cycle cancellation reduced cost and eliminated negative cycle)")
    } else {
        print("[FAIL] Test Case 5 failed post-cancellation verification")
        allMCMFPassed = false
    }
}

// --- Final Suite Summary ---
print("=== Min-Cost Max-Flow Suite Summary ===")
if (allMCMFPassed) {
    print("All MCMF and cycle cancellation test suites: SUCCESS")
} else {
    print("Some MCMF and cycle cancellation test suites: FAILED")
}

totalElapsed = t.millis() - globalStartTime
print("[PASS] Min-Cost Max-Flow Successive Shortest Path executed successfully in", totalElapsed, "ms")
