import stdlib time as t

// Persistent Leftist Heap Priority Queue Suite
// Technical characteristics:
// - Functional persistence via node path copying bounded by right spine null path length
// - Leftist property enforcement: dist(left) >= dist(right) with rank (s-value) recalculation
// - Logarithmic meld, insert, and deleteMin in O(log N) time and space
// - Historical immutability preservation across arbitrary branching timelines
// - Support for timeline forking, tree branching, multi-version meld, and state rollback
// - Parallel flat array arena allocation for cache locality and zero reference overhead
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Persistent Leftist Heap Suite ===")
suiteStartTime = t.millis()

func createPersistentLeftistHeap() {
    heapKey = []
    heapVal = []
    heapLeft = []
    heapRight = []
    heapDist = []
    heapSize = []
    versionRoots = []
    versionParents = []
    versionDescriptions = []
    return [heapKey, heapVal, heapLeft, heapRight, heapDist, heapSize, versionRoots, versionParents, versionDescriptions]
}

func allocHeapNode(heap, key, val, leftChild, rightChild) {
    hKey = heap[0]
    hVal = heap[1]
    hLeft = heap[2]
    hRight = heap[3]
    hDist = heap[4]
    hSize = heap[5]

    leftDist = 0
    leftSize = 0
    if (leftChild != -1) {
        leftDist = hDist[leftChild]
        leftSize = hSize[leftChild]
    }

    rightDist = 0
    rightSize = 0
    if (rightChild != -1) {
        rightDist = hDist[rightChild]
        rightSize = hSize[rightChild]
    }

    finalLeft = leftChild
    finalRight = rightChild
    if (leftDist < rightDist) {
        finalLeft = rightChild
        finalRight = leftChild
        tempDist = leftDist
        leftDist = rightDist
        rightDist = tempDist
        tempSize = leftSize
        leftSize = rightSize
        rightSize = tempSize
    }

    nodeDist = rightDist + 1
    nodeSize = leftSize + rightSize + 1
    nodeId = hKey.size()

    hKey.push(key)
    hVal.push(val)
    hLeft.push(finalLeft)
    hRight.push(finalRight)
    hDist.push(nodeDist)
    hSize.push(nodeSize)

    heap[0] = hKey
    heap[1] = hVal
    heap[2] = hLeft
    heap[3] = hRight
    heap[4] = hDist
    heap[5] = hSize
    return nodeId
}

func initPersistentLeftistHeap(heap, initialDesc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]

    vRoots.push(-1)
    vParents.push(-1)
    vDescs.push(initialDesc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return 0
}

func meldTrees(heap, h1, h2) {
    if (h1 == -1) {
        return h2
    }
    if (h2 == -1) {
        return h1
    }
    hKey = heap[0]
    hVal = heap[1]
    hLeft = heap[2]
    hRight = heap[3]

    rootA = h1
    rootB = h2
    if (hKey[rootA] > hKey[rootB]) {
        rootA = h2
        rootB = h1
    }

    keyA = hKey[rootA]
    valA = hVal[rootA]
    leftA = hLeft[rootA]
    rightA = hRight[rootA]

    mergedRight = meldTrees(heap, rightA, rootB)
    return allocHeapNode(heap, keyA, valA, leftA, mergedRight)
}

func insertElement(heap, baseVersion, key, val, desc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]
    if (baseVersion < 0 or baseVersion >= vRoots.size()) {
        return -1
    }
    baseRoot = vRoots[baseVersion]
    singleNode = allocHeapNode(heap, key, val, -1, -1)
    newRoot = meldTrees(heap, baseRoot, singleNode)

    newVersionId = vRoots.size()
    vRoots.push(newRoot)
    vParents.push(baseVersion)
    vDescs.push(desc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return newVersionId
}

func deleteMin(heap, baseVersion, desc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]
    if (baseVersion < 0 or baseVersion >= vRoots.size()) {
        return -1
    }
    baseRoot = vRoots[baseVersion]
    if (baseRoot == -1) {
        newVersionId = vRoots.size()
        vRoots.push(-1)
        vParents.push(baseVersion)
        vDescs.push(desc)
        heap[6] = vRoots
        heap[7] = vParents
        heap[8] = vDescs
        return newVersionId
    }
    hLeft = heap[2]
    hRight = heap[3]
    lc = hLeft[baseRoot]
    rc = hRight[baseRoot]
    newRoot = meldTrees(heap, lc, rc)

    newVersionId = vRoots.size()
    vRoots.push(newRoot)
    vParents.push(baseVersion)
    vDescs.push(desc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return newVersionId
}

func meldHeaps(heap, versionA, versionB, desc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]
    if (versionA < 0 or versionA >= vRoots.size() or versionB < 0 or versionB >= vRoots.size()) {
        return -1
    }
    rootA = vRoots[versionA]
    rootB = vRoots[versionB]
    newRoot = meldTrees(heap, rootA, rootB)

    newVersionId = vRoots.size()
    vRoots.push(newRoot)
    vParents.push(versionA)
    vDescs.push(desc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return newVersionId
}

func getMinKey(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return -1
    }
    root = vRoots[version]
    if (root == -1) {
        return -1
    }
    hKey = heap[0]
    return hKey[root]
}

func getMinVal(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return -1
    }
    root = vRoots[version]
    if (root == -1) {
        return -1
    }
    hVal = heap[1]
    return hVal[root]
}

func getHeapSize(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return 0
    }
    root = vRoots[version]
    if (root == -1) {
        return 0
    }
    hSize = heap[5]
    return hSize[root]
}

func getHeapDist(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return 0
    }
    root = vRoots[version]
    if (root == -1) {
        return 0
    }
    hDist = heap[4]
    return hDist[root]
}

func isHeapEmpty(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return 1
    }
    if (vRoots[version] == -1) {
        return 1
    }
    return 0
}

func forkTimeline(heap, baseVersion, desc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]
    if (baseVersion < 0 or baseVersion >= vRoots.size()) {
        return -1
    }
    targetRoot = vRoots[baseVersion]
    newVersionId = vRoots.size()
    vRoots.push(targetRoot)
    vParents.push(baseVersion)
    vDescs.push(desc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return newVersionId
}

func rollbackTo(heap, targetVersion, desc) {
    return forkTimeline(heap, targetVersion, desc)
}

func getVersionCount(heap) {
    vRoots = heap[6]
    return vRoots.size()
}

func getVersionParent(heap, version) {
    vParents = heap[7]
    if (version < 0 or version >= vParents.size()) {
        return -1
    }
    return vParents[version]
}

func getVersionDescription(heap, version) {
    vDescs = heap[8]
    if (version < 0 or version >= vDescs.size()) {
        return ""
    }
    return vDescs[version]
}

func getTotalArenaNodes(heap) {
    hKey = heap[0]
    return hKey.size()
}

func verifyLeftistInvariant(heap, root) {
    if (root == -1) {
        return 1
    }
    hKey = heap[0]
    hLeft = heap[2]
    hRight = heap[3]
    hDist = heap[4]
    hSize = heap[5]

    nodeStack = [root]
    while (nodeStack.size() > 0) {
        topIdx = nodeStack.size() - 1
        curr = nodeStack[topIdx]
        nodeStack.pop()

        curKey = hKey[curr]
        curDist = hDist[curr]
        curSize = hSize[curr]
        lc = hLeft[curr]
        rc = hRight[curr]

        leftDist = 0
        leftSize = 0
        if (lc != -1) {
            if (hKey[lc] < curKey) {
                return 0
            }
            leftDist = hDist[lc]
            leftSize = hSize[lc]
            nodeStack.push(lc)
        }

        rightDist = 0
        rightSize = 0
        if (rc != -1) {
            if (hKey[rc] < curKey) {
                return 0
            }
            rightDist = hDist[rc]
            rightSize = hSize[rc]
            nodeStack.push(rc)
        }

        if (leftDist < rightDist) {
            return 0
        }
        if (curDist != rightDist + 1) {
            return 0
        }
        if (curSize != leftSize + rightSize + 1) {
            return 0
        }
    }
    return 1
}

func collectSubtreeKeys(heap, root) {
    res = []
    if (root == -1) {
        return res
    }
    hKey = heap[0]
    hLeft = heap[2]
    hRight = heap[3]

    nodeStack = [root]
    while (nodeStack.size() > 0) {
        topIdx = nodeStack.size() - 1
        curr = nodeStack[topIdx]
        nodeStack.pop()

        res.push(hKey[curr])
        lc = hLeft[curr]
        rc = hRight[curr]
        if (lc != -1) {
            nodeStack.push(lc)
        }
        if (rc != -1) {
            nodeStack.push(rc)
        }
    }
    return res
}

func extractAllSortedKeys(heap, root) {
    res = []
    curr = root
    hKey = heap[0]
    hLeft = heap[2]
    hRight = heap[3]
    while (curr != -1) {
        res.push(hKey[curr])
        lc = hLeft[curr]
        rc = hRight[curr]
        curr = meldTrees(heap, lc, rc)
    }
    return res
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Version Updates & Priority Queue Invariants
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Version Updates and Priority Queue Invariants...")
tc1Heap = createPersistentLeftistHeap()
initPersistentLeftistHeap(tc1Heap, "v0: initial empty heap")

v0Empty = isHeapEmpty(tc1Heap, 0)
v0Size = getHeapSize(tc1Heap, 0)
v0Dist = getHeapDist(tc1Heap, 0)
v0MinKey = getMinKey(tc1Heap, 0)
v0Invariant = verifyLeftistInvariant(tc1Heap, tc1Heap[6][0])

if (v0Empty != 1 or v0Size != 0 or v0Dist != 0 or v0MinKey != -1 or v0Invariant != 1) {
    print("[FAIL] Test Case 1 Baseline v0 failed")
} else {
    print("  Version 0 baseline verified: empty heap with size 0, dist 0, and minKey -1")
}

// Sequential inserts with non-monotonic keys: [42, 15, 77, 8, 23, 64, 4, 91, 30, 12]
v1 = insertElement(tc1Heap, 0, 42, 101, "v1: insert 42")
v2 = insertElement(tc1Heap, v1, 15, 102, "v2: insert 15")
v3 = insertElement(tc1Heap, v2, 77, 103, "v3: insert 77")
v4 = insertElement(tc1Heap, v3, 8, 104, "v4: insert 8")
v5 = insertElement(tc1Heap, v4, 23, 105, "v5: insert 23")
v6 = insertElement(tc1Heap, v5, 64, 106, "v6: insert 64")
v7 = insertElement(tc1Heap, v6, 4, 107, "v7: insert 4")
v8 = insertElement(tc1Heap, v7, 91, 108, "v8: insert 91")
v9 = insertElement(tc1Heap, v8, 30, 109, "v9: insert 30")
v10 = insertElement(tc1Heap, v9, 12, 110, "v10: insert 12")

v10MinKey = getMinKey(tc1Heap, v10)
v10MinVal = getMinVal(tc1Heap, v10)
v10Size = getHeapSize(tc1Heap, v10)
v10Dist = getHeapDist(tc1Heap, v10)

if (v10MinKey != 4 or v10MinVal != 107 or v10Size != 10 or v10Dist <= 0) {
    print("[FAIL] Test Case 1 Version 10 insertion failed: minKey=", v10MinKey, ", size=", v10Size)
} else {
    print("  Version 10 verified: size 10, minKey 4 (payload 107), valid null path length")
}

// Invariant verification across all insertion versions
allInvariantsValid = 1
checkVer = 0
while (checkVer <= 10) {
    cRoot = tc1Heap[6][checkVer]
    if (verifyLeftistInvariant(tc1Heap, cRoot) == 0) {
        allInvariantsValid = 0
    }
    checkVer = checkVer + 1
}

if (allInvariantsValid != 1) {
    print("[FAIL] Leftist invariant violated during sequential insertions")
} else {
    print("  Leftist heap invariants verified across all historical insertion versions (0..10)")
}

// Historical immutability verification
v0RecheckEmpty = isHeapEmpty(tc1Heap, 0)
v1RecheckMin = getMinKey(tc1Heap, v1)
v1RecheckSize = getHeapSize(tc1Heap, v1)
v2RecheckMin = getMinKey(tc1Heap, v2)
v2RecheckSize = getHeapSize(tc1Heap, v2)
v4RecheckMin = getMinKey(tc1Heap, v4)
v4RecheckSize = getHeapSize(tc1Heap, v4)
v7RecheckMin = getMinKey(tc1Heap, v7)
v7RecheckSize = getHeapSize(tc1Heap, v7)

if (v0RecheckEmpty != 1 or v1RecheckMin != 42 or v1RecheckSize != 1 or v2RecheckMin != 15 or v2RecheckSize != 2 or v4RecheckMin != 8 or v4RecheckSize != 4 or v7RecheckMin != 4 or v7RecheckSize != 7) {
    print("[FAIL] Historical immutability violated across historical snapshots")
} else {
    print("  Historical immutability preserved across all previous versions")
}

// Sequential deleteMin operations starting from v10
// Expected extraction order: 4, 8, 12, 15, 23, 30, 42, 64, 77, 91
v11 = deleteMin(tc1Heap, v10, "v11: deleteMin (extracted 4)")
v12 = deleteMin(tc1Heap, v11, "v12: deleteMin (extracted 8)")
v13 = deleteMin(tc1Heap, v12, "v13: deleteMin (extracted 12)")
v14 = deleteMin(tc1Heap, v13, "v14: deleteMin (extracted 15)")
v15 = deleteMin(tc1Heap, v14, "v15: deleteMin (extracted 23)")
v16 = deleteMin(tc1Heap, v15, "v16: deleteMin (extracted 30)")
v17 = deleteMin(tc1Heap, v16, "v17: deleteMin (extracted 42)")
v18 = deleteMin(tc1Heap, v17, "v18: deleteMin (extracted 64)")
v19 = deleteMin(tc1Heap, v18, "v19: deleteMin (extracted 77)")
v20 = deleteMin(tc1Heap, v19, "v20: deleteMin (extracted 91)")

expectedExtractedMins = [8, 12, 15, 23, 30, 42, 64, 77, 91, -1]
expectedSizes = [9, 8, 7, 6, 5, 4, 3, 2, 1, 0]

deleteSuccess = 1
delVer = v11
expIdx = 0
while (delVer <= v20) {
    curMin = getMinKey(tc1Heap, delVer)
    curSz = getHeapSize(tc1Heap, delVer)
    if (curMin != expectedExtractedMins[expIdx] or curSz != expectedSizes[expIdx]) {
        deleteSuccess = 0
        print("[FAIL] Delete mismatch at version ", delVer, ": got min=", curMin, " (exp ", expectedExtractedMins[expIdx], "), sz=", curSz, " (exp ", expectedSizes[expIdx], ")")
    }
    delVer = delVer + 1
    expIdx = expIdx + 1
}

if (deleteSuccess != 1) {
    print("[FAIL] Sequential deleteMin verification failed")
} else {
    print("  Sequential deleteMin verified: exact sorted extraction [4, 8, 12, 15, 23, 30, 42, 64, 77, 91]")
}

// Re-verify that Version 10 remains completely intact after all deletions
v10FinalMin = getMinKey(tc1Heap, v10)
v10FinalSize = getHeapSize(tc1Heap, v10)
if (v10FinalMin != 4 or v10FinalSize != 10) {
    print("[FAIL] Version 10 mutated after subsequent deleteMin operations")
} else {
    print("  Version 10 remained pristine and unmodified throughout full extraction cycle")
    print("  Test Case 1 Passed sequential updates and immutability verification")
}
