import stdlib time as t

// Persistent Leftist Heap Priority Queue Suite
// Technical characteristics:
// - Functional persistence via node path copying bounded by right spine null path length
// - Leftist property enforcement: dist(left) >= dist(right) with rank (s-value) recalculation
// - Logarithmic meld, insert, and deleteMin in O(log N) time and space
// - Historical immutability preservation across arbitrary branching timelines
// - Support for timeline forking, tree branching, multi-version meld, and state rollback
// - Parallel flat array arena allocation for cache locality and zero reference overhead
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Persistent Leftist Heap Suite ===")
suiteStartTime = t.millis()

func createPersistentLeftistHeap() {
    heapKey = []
    heapVal = []
    heapLeft = []
    heapRight = []
    heapDist = []
    heapSize = []
    versionRoots = []
    versionParents = []
    versionDescriptions = []
    return [heapKey, heapVal, heapLeft, heapRight, heapDist, heapSize, versionRoots, versionParents, versionDescriptions]
}

func allocHeapNode(heap, key, val, leftChild, rightChild) {
    hKey = heap[0]
    hVal = heap[1]
    hLeft = heap[2]
    hRight = heap[3]
    hDist = heap[4]
    hSize = heap[5]

    leftDist = 0
    leftSize = 0
    if (leftChild != -1) {
        leftDist = hDist[leftChild]
        leftSize = hSize[leftChild]
    }

    rightDist = 0
    rightSize = 0
    if (rightChild != -1) {
        rightDist = hDist[rightChild]
        rightSize = hSize[rightChild]
    }

    finalLeft = leftChild
    finalRight = rightChild
    if (leftDist < rightDist) {
        finalLeft = rightChild
        finalRight = leftChild
        tempDist = leftDist
        leftDist = rightDist
        rightDist = tempDist
        tempSize = leftSize
        leftSize = rightSize
        rightSize = tempSize
    }

    nodeDist = rightDist + 1
    nodeSize = leftSize + rightSize + 1
    nodeId = hKey.size()

    hKey.push(key)
    hVal.push(val)
    hLeft.push(finalLeft)
    hRight.push(finalRight)
    hDist.push(nodeDist)
    hSize.push(nodeSize)

    heap[0] = hKey
    heap[1] = hVal
    heap[2] = hLeft
    heap[3] = hRight
    heap[4] = hDist
    heap[5] = hSize
    return nodeId
}

func initPersistentLeftistHeap(heap, initialDesc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]

    vRoots.push(-1)
    vParents.push(-1)
    vDescs.push(initialDesc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return 0
}

func meldTrees(heap, h1, h2) {
    if (h1 == -1) {
        return h2
    }
    if (h2 == -1) {
        return h1
    }
    hKey = heap[0]
    hVal = heap[1]
    hLeft = heap[2]
    hRight = heap[3]

    rootA = h1
    rootB = h2
    if (hKey[rootA] > hKey[rootB]) {
        rootA = h2
        rootB = h1
    }

    keyA = hKey[rootA]
    valA = hVal[rootA]
    leftA = hLeft[rootA]
    rightA = hRight[rootA]

    mergedRight = meldTrees(heap, rightA, rootB)
    return allocHeapNode(heap, keyA, valA, leftA, mergedRight)
}

func insertElement(heap, baseVersion, key, val, desc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]
    if (baseVersion < 0 or baseVersion >= vRoots.size()) {
        return -1
    }
    baseRoot = vRoots[baseVersion]
    singleNode = allocHeapNode(heap, key, val, -1, -1)
    newRoot = meldTrees(heap, baseRoot, singleNode)

    newVersionId = vRoots.size()
    vRoots.push(newRoot)
    vParents.push(baseVersion)
    vDescs.push(desc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return newVersionId
}

func deleteMin(heap, baseVersion, desc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]
    if (baseVersion < 0 or baseVersion >= vRoots.size()) {
        return -1
    }
    baseRoot = vRoots[baseVersion]
    if (baseRoot == -1) {
        newVersionId = vRoots.size()
        vRoots.push(-1)
        vParents.push(baseVersion)
        vDescs.push(desc)
        heap[6] = vRoots
        heap[7] = vParents
        heap[8] = vDescs
        return newVersionId
    }
    hLeft = heap[2]
    hRight = heap[3]
    lc = hLeft[baseRoot]
    rc = hRight[baseRoot]
    newRoot = meldTrees(heap, lc, rc)

    newVersionId = vRoots.size()
    vRoots.push(newRoot)
    vParents.push(baseVersion)
    vDescs.push(desc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return newVersionId
}

func meldHeaps(heap, versionA, versionB, desc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]
    if (versionA < 0 or versionA >= vRoots.size() or versionB < 0 or versionB >= vRoots.size()) {
        return -1
    }
    rootA = vRoots[versionA]
    rootB = vRoots[versionB]
    newRoot = meldTrees(heap, rootA, rootB)

    newVersionId = vRoots.size()
    vRoots.push(newRoot)
    vParents.push(versionA)
    vDescs.push(desc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return newVersionId
}

func getMinKey(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return -1
    }
    root = vRoots[version]
    if (root == -1) {
        return -1
    }
    hKey = heap[0]
    return hKey[root]
}

func getMinVal(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return -1
    }
    root = vRoots[version]
    if (root == -1) {
        return -1
    }
    hVal = heap[1]
    return hVal[root]
}

func getHeapSize(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return 0
    }
    root = vRoots[version]
    if (root == -1) {
        return 0
    }
    hSize = heap[5]
    return hSize[root]
}

func getHeapDist(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return 0
    }
    root = vRoots[version]
    if (root == -1) {
        return 0
    }
    hDist = heap[4]
    return hDist[root]
}

func isHeapEmpty(heap, version) {
    vRoots = heap[6]
    if (version < 0 or version >= vRoots.size()) {
        return 1
    }
    if (vRoots[version] == -1) {
        return 1
    }
    return 0
}

func forkTimeline(heap, baseVersion, desc) {
    vRoots = heap[6]
    vParents = heap[7]
    vDescs = heap[8]
    if (baseVersion < 0 or baseVersion >= vRoots.size()) {
        return -1
    }
    targetRoot = vRoots[baseVersion]
    newVersionId = vRoots.size()
    vRoots.push(targetRoot)
    vParents.push(baseVersion)
    vDescs.push(desc)

    heap[6] = vRoots
    heap[7] = vParents
    heap[8] = vDescs
    return newVersionId
}

func rollbackTo(heap, targetVersion, desc) {
    return forkTimeline(heap, targetVersion, desc)
}

func getVersionCount(heap) {
    vRoots = heap[6]
    return vRoots.size()
}

func getVersionParent(heap, version) {
    vParents = heap[7]
    if (version < 0 or version >= vParents.size()) {
        return -1
    }
    return vParents[version]
}

func getVersionDescription(heap, version) {
    vDescs = heap[8]
    if (version < 0 or version >= vDescs.size()) {
        return ""
    }
    return vDescs[version]
}

func getTotalArenaNodes(heap) {
    hKey = heap[0]
    return hKey.size()
}

func verifyLeftistInvariant(heap, root) {
    if (root == -1) {
        return 1
    }
    hKey = heap[0]
    hLeft = heap[2]
    hRight = heap[3]
    hDist = heap[4]
    hSize = heap[5]

    nodeStack = [root]
    while (nodeStack.size() > 0) {
        topIdx = nodeStack.size() - 1
        curr = nodeStack[topIdx]
        nodeStack.pop()

        curKey = hKey[curr]
        curDist = hDist[curr]
        curSize = hSize[curr]
        lc = hLeft[curr]
        rc = hRight[curr]

        leftDist = 0
        leftSize = 0
        if (lc != -1) {
            if (hKey[lc] < curKey) {
                return 0
            }
            leftDist = hDist[lc]
            leftSize = hSize[lc]
            nodeStack.push(lc)
        }

        rightDist = 0
        rightSize = 0
        if (rc != -1) {
            if (hKey[rc] < curKey) {
                return 0
            }
            rightDist = hDist[rc]
            rightSize = hSize[rc]
            nodeStack.push(rc)
        }

        if (leftDist < rightDist) {
            return 0
        }
        if (curDist != rightDist + 1) {
            return 0
        }
        if (curSize != leftSize + rightSize + 1) {
            return 0
        }
    }
    return 1
}

func collectSubtreeKeys(heap, root) {
    res = []
    if (root == -1) {
        return res
    }
    hKey = heap[0]
    hLeft = heap[2]
    hRight = heap[3]

    nodeStack = [root]
    while (nodeStack.size() > 0) {
        topIdx = nodeStack.size() - 1
        curr = nodeStack[topIdx]
        nodeStack.pop()

        res.push(hKey[curr])
        lc = hLeft[curr]
        rc = hRight[curr]
        if (lc != -1) {
            nodeStack.push(lc)
        }
        if (rc != -1) {
            nodeStack.push(rc)
        }
    }
    return res
}

func extractAllSortedKeys(heap, root) {
    res = []
    curr = root
    hKey = heap[0]
    hLeft = heap[2]
    hRight = heap[3]
    while (curr != -1) {
        res.push(hKey[curr])
        lc = hLeft[curr]
        rc = hRight[curr]
        curr = meldTrees(heap, lc, rc)
    }
    return res
}

func compareIntArrays(arr1, arr2) {
    if (arr1.size() != arr2.size()) {
        return 0
    }
    i = 0
    while (i < arr1.size()) {
        if (arr1[i] != arr2[i]) {
            return 0
        }
        i = i + 1
    }
    return 1
}

func nextPrng(rng) {
    val = rng[0]
    val = (val * 1103515245 + 12345) % 2147483648
    if (val < 0) {
        val = 0 - val
    }
    rng[0] = val
    return val
}

func copyArray(arr) {
    res = []
    i = 0
    sz = arr.size()
    while (i < sz) {
        res.push(arr[i])
        i = i + 1
    }
    return res
}

func insertIntoSortedArray(arr, val) {
    res = []
    inserted = 0
    i = 0
    sz = arr.size()
    while (i < sz) {
        elem = arr[i]
        if (inserted == 0 and val <= elem) {
            res.push(val)
            inserted = 1
        }
        res.push(elem)
        i = i + 1
    }
    if (inserted == 0) {
        res.push(val)
    }
    return res
}

func dropFirstElement(arr) {
    res = []
    sz = arr.size()
    if (sz <= 1) {
        return res
    }
    i = 1
    while (i < sz) {
        res.push(arr[i])
        i = i + 1
    }
    return res
}

func mergeSortedArrays(arr1, arr2) {
    res = []
    i = 0
    j = 0
    sz1 = arr1.size()
    sz2 = arr2.size()
    while (i < sz1 and j < sz2) {
        if (arr1[i] <= arr2[j]) {
            res.push(arr1[i])
            i = i + 1
        } else {
            res.push(arr2[j])
            j = j + 1
        }
    }
    while (i < sz1) {
        res.push(arr1[i])
        i = i + 1
    }
    while (j < sz2) {
        res.push(arr2[j])
        j = j + 1
    }
    return res
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Version Updates & Priority Queue Invariants
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Version Updates and Priority Queue Invariants...")
tc1Heap = createPersistentLeftistHeap()
initPersistentLeftistHeap(tc1Heap, "v0: initial empty heap")

v0Empty = isHeapEmpty(tc1Heap, 0)
v0Size = getHeapSize(tc1Heap, 0)
v0Dist = getHeapDist(tc1Heap, 0)
v0MinKey = getMinKey(tc1Heap, 0)
v0Invariant = verifyLeftistInvariant(tc1Heap, tc1Heap[6][0])

if (v0Empty != 1 or v0Size != 0 or v0Dist != 0 or v0MinKey != -1 or v0Invariant != 1) {
    print("[FAIL] Test Case 1 Baseline v0 failed")
} else {
    print("  Version 0 baseline verified: empty heap with size 0, dist 0, and minKey -1")
}

// Sequential inserts with non-monotonic keys: [42, 15, 77, 8, 23, 64, 4, 91, 30, 12]
v1 = insertElement(tc1Heap, 0, 42, 101, "v1: insert 42")
v2 = insertElement(tc1Heap, v1, 15, 102, "v2: insert 15")
v3 = insertElement(tc1Heap, v2, 77, 103, "v3: insert 77")
v4 = insertElement(tc1Heap, v3, 8, 104, "v4: insert 8")
v5 = insertElement(tc1Heap, v4, 23, 105, "v5: insert 23")
v6 = insertElement(tc1Heap, v5, 64, 106, "v6: insert 64")
v7 = insertElement(tc1Heap, v6, 4, 107, "v7: insert 4")
v8 = insertElement(tc1Heap, v7, 91, 108, "v8: insert 91")
v9 = insertElement(tc1Heap, v8, 30, 109, "v9: insert 30")
v10 = insertElement(tc1Heap, v9, 12, 110, "v10: insert 12")

v10MinKey = getMinKey(tc1Heap, v10)
v10MinVal = getMinVal(tc1Heap, v10)
v10Size = getHeapSize(tc1Heap, v10)
v10Dist = getHeapDist(tc1Heap, v10)

if (v10MinKey != 4 or v10MinVal != 107 or v10Size != 10 or v10Dist <= 0) {
    print("[FAIL] Test Case 1 Version 10 insertion failed: minKey=", v10MinKey, ", size=", v10Size)
} else {
    print("  Version 10 verified: size 10, minKey 4 (payload 107), valid null path length")
}

// Invariant verification across all insertion versions
allInvariantsValid = 1
checkVer = 0
while (checkVer <= 10) {
    cRoot = tc1Heap[6][checkVer]
    if (verifyLeftistInvariant(tc1Heap, cRoot) == 0) {
        allInvariantsValid = 0
    }
    checkVer = checkVer + 1
}

if (allInvariantsValid != 1) {
    print("[FAIL] Leftist invariant violated during sequential insertions")
} else {
    print("  Leftist heap invariants verified across all historical insertion versions (0..10)")
}

// Historical immutability verification
v0RecheckEmpty = isHeapEmpty(tc1Heap, 0)
v1RecheckMin = getMinKey(tc1Heap, v1)
v1RecheckSize = getHeapSize(tc1Heap, v1)
v2RecheckMin = getMinKey(tc1Heap, v2)
v2RecheckSize = getHeapSize(tc1Heap, v2)
v4RecheckMin = getMinKey(tc1Heap, v4)
v4RecheckSize = getHeapSize(tc1Heap, v4)
v7RecheckMin = getMinKey(tc1Heap, v7)
v7RecheckSize = getHeapSize(tc1Heap, v7)

if (v0RecheckEmpty != 1 or v1RecheckMin != 42 or v1RecheckSize != 1 or v2RecheckMin != 15 or v2RecheckSize != 2 or v4RecheckMin != 8 or v4RecheckSize != 4 or v7RecheckMin != 4 or v7RecheckSize != 7) {
    print("[FAIL] Historical immutability violated across historical snapshots")
} else {
    print("  Historical immutability preserved across all previous versions")
}

// Sequential deleteMin operations starting from v10
// Expected extraction order: 4, 8, 12, 15, 23, 30, 42, 64, 77, 91
v11 = deleteMin(tc1Heap, v10, "v11: deleteMin (extracted 4)")
v12 = deleteMin(tc1Heap, v11, "v12: deleteMin (extracted 8)")
v13 = deleteMin(tc1Heap, v12, "v13: deleteMin (extracted 12)")
v14 = deleteMin(tc1Heap, v13, "v14: deleteMin (extracted 15)")
v15 = deleteMin(tc1Heap, v14, "v15: deleteMin (extracted 23)")
v16 = deleteMin(tc1Heap, v15, "v16: deleteMin (extracted 30)")
v17 = deleteMin(tc1Heap, v16, "v17: deleteMin (extracted 42)")
v18 = deleteMin(tc1Heap, v17, "v18: deleteMin (extracted 64)")
v19 = deleteMin(tc1Heap, v18, "v19: deleteMin (extracted 77)")
v20 = deleteMin(tc1Heap, v19, "v20: deleteMin (extracted 91)")

expectedExtractedMins = [8, 12, 15, 23, 30, 42, 64, 77, 91, -1]
expectedSizes = [9, 8, 7, 6, 5, 4, 3, 2, 1, 0]

deleteSuccess = 1
delVer = v11
expIdx = 0
while (delVer <= v20) {
    curMin = getMinKey(tc1Heap, delVer)
    curSz = getHeapSize(tc1Heap, delVer)
    if (curMin != expectedExtractedMins[expIdx] or curSz != expectedSizes[expIdx]) {
        deleteSuccess = 0
        print("[FAIL] Delete mismatch at version ", delVer, ": got min=", curMin, " (exp ", expectedExtractedMins[expIdx], "), sz=", curSz, " (exp ", expectedSizes[expIdx], ")")
    }
    delVer = delVer + 1
    expIdx = expIdx + 1
}

if (deleteSuccess != 1) {
    print("[FAIL] Sequential deleteMin verification failed")
} else {
    print("  Sequential deleteMin verified: exact sorted extraction [4, 8, 12, 15, 23, 30, 42, 64, 77, 91]")
}

// Re-verify that Version 10 remains completely intact after all deletions
v10FinalMin = getMinKey(tc1Heap, v10)
v10FinalSize = getHeapSize(tc1Heap, v10)
if (v10FinalMin != 4 or v10FinalSize != 10) {
    print("[FAIL] Version 10 mutated after subsequent deleteMin operations")
} else {
    print("  Version 10 remained pristine and unmodified throughout full extraction cycle")
    print("  Test Case 1 Passed sequential updates and immutability verification")
}

// -----------------------------------------------------------------------------
// Test Case 2: Timeline Forking and Multi-Way Timeline Branching
// -----------------------------------------------------------------------------
print("Running Test Case 2: Timeline Forking and Tree Branching...")
tc2Heap = createPersistentLeftistHeap()
initPersistentLeftistHeap(tc2Heap, "v0: empty")

// Common ancestor tree with elements: 50, 30, 70, 20
vA1 = insertElement(tc2Heap, 0, 50, 500, "v1: insert 50")
vA2 = insertElement(tc2Heap, vA1, 30, 300, "v2: insert 30")
vA3 = insertElement(tc2Heap, vA2, 70, 700, "v3: insert 70")
vAncestor = insertElement(tc2Heap, vA3, 20, 200, "v4: insert 20 (ancestor)")

ancMin = getMinKey(tc2Heap, vAncestor)
ancSize = getHeapSize(tc2Heap, vAncestor)
if (ancMin != 20 or ancSize != 4) {
    print("[FAIL] Test Case 2 Ancestor creation failed")
} else {
    print("  Ancestor Version 4 verified: size 4, minKey 20")
}

// Branch A: fork from vAncestor and insert smaller elements [5, 15, 2]
vForkA0 = forkTimeline(tc2Heap, vAncestor, "fork Branch A from v4")
vForkA1 = insertElement(tc2Heap, vForkA0, 5, 50, "branch A: insert 5")
vForkA2 = insertElement(tc2Heap, vForkA1, 15, 150, "branch A: insert 15")
vForkA3 = insertElement(tc2Heap, vForkA2, 2, 20, "branch A: insert 2")

// Branch B: fork from vAncestor and insert larger elements [100, 80, 90]
vForkB0 = forkTimeline(tc2Heap, vAncestor, "fork Branch B from v4")
vForkB1 = insertElement(tc2Heap, vForkB0, 100, 1000, "branch B: insert 100")
vForkB2 = insertElement(tc2Heap, vForkB1, 80, 800, "branch B: insert 80")
vForkB3 = insertElement(tc2Heap, vForkB2, 90, 900, "branch B: insert 90")

// Branch C: fork from vAncestor and perform two deleteMin operations
vForkC0 = forkTimeline(tc2Heap, vAncestor, "fork Branch C from v4")
vForkC1 = deleteMin(tc2Heap, vForkC0, "branch C: deleteMin 20")
vForkC2 = deleteMin(tc2Heap, vForkC1, "branch C: deleteMin 30")

// Verification of Branch A
minA = getMinKey(tc2Heap, vForkA3)
sizeA = getHeapSize(tc2Heap, vForkA3)
extA = extractAllSortedKeys(tc2Heap, tc2Heap[6][vForkA3])
expA = [2, 5, 15, 20, 30, 50, 70]
matchA = compareIntArrays(extA, expA)

// Verification of Branch B
minB = getMinKey(tc2Heap, vForkB3)
sizeB = getHeapSize(tc2Heap, vForkB3)
extB = extractAllSortedKeys(tc2Heap, tc2Heap[6][vForkB3])
expB = [20, 30, 50, 70, 80, 90, 100]
matchB = compareIntArrays(extB, expB)

// Verification of Branch C
minC = getMinKey(tc2Heap, vForkC2)
sizeC = getHeapSize(tc2Heap, vForkC2)
extC = extractAllSortedKeys(tc2Heap, tc2Heap[6][vForkC2])
expC = [50, 70]
matchC = compareIntArrays(extC, expC)

if (minA != 2 or sizeA != 7 or matchA != 1 or minB != 20 or sizeB != 7 or matchB != 1 or minC != 50 or sizeC != 2 or matchC != 1) {
    print("[FAIL] Test Case 2 Divergent branches failed")
} else {
    print("  Branch A (min 2, size 7), Branch B (min 20, size 7), and Branch C (min 50, size 2) verified")
}

// Ancestor immutability check
ancFinalMin = getMinKey(tc2Heap, vAncestor)
ancFinalSize = getHeapSize(tc2Heap, vAncestor)
extAnc = extractAllSortedKeys(tc2Heap, tc2Heap[6][vAncestor])
expAnc = [20, 30, 50, 70]
matchAnc = compareIntArrays(extAnc, expAnc)

if (ancFinalMin != 20 or ancFinalSize != 4 or matchAnc != 1) {
    print("[FAIL] Ancestor Version 4 mutated across timeline branches")
} else {
    print("  Ancestor Version 4 remained pristine across timeline divergence")
}

// Lineage validation
parForkA = getVersionParent(tc2Heap, vForkA0)
parForkB = getVersionParent(tc2Heap, vForkB0)
parForkC = getVersionParent(tc2Heap, vForkC0)
if (parForkA != vAncestor or parForkB != vAncestor or parForkC != vAncestor) {
    print("[FAIL] Version lineage broken in timeline branches")
} else {
    print("  Version lineage verified: branches correctly reference parent Version 4")
    print("  Test Case 2 Passed timeline forking verification")
}

// -----------------------------------------------------------------------------
// Test Case 3: Logarithmic Heap Meld across Timelines & Boundary Edge Cases
// -----------------------------------------------------------------------------
print("Running Test Case 3: Boundary and Edge Cases...")
tc3Heap = createPersistentLeftistHeap()
initPersistentLeftistHeap(tc3Heap, "v0: empty")

// Sub-case 3.1: Logarithmic Heap Meld between two independent heaps
// Heap X elements: [10, 25, 40, 55, 70]
vX1 = insertElement(tc3Heap, 0, 10, 1, "hx: 10")
vX2 = insertElement(tc3Heap, vX1, 25, 2, "hx: 25")
vX3 = insertElement(tc3Heap, vX2, 40, 3, "hx: 40")
vX4 = insertElement(tc3Heap, vX3, 55, 4, "hx: 55")
vX5 = insertElement(tc3Heap, vX4, 70, 5, "hx: 70")

// Heap Y elements: [5, 18, 32, 60, 85]
vY1 = insertElement(tc3Heap, 0, 5, 10, "hy: 5")
vY2 = insertElement(tc3Heap, vY1, 18, 20, "hy: 18")
vY3 = insertElement(tc3Heap, vY2, 32, 30, "hy: 32")
vY4 = insertElement(tc3Heap, vY3, 60, 40, "hy: 60")
vY5 = insertElement(tc3Heap, vY4, 85, 50, "hy: 85")

vMeldXY = meldHeaps(tc3Heap, vX5, vY5, "meld X and Y")

meldMin = getMinKey(tc3Heap, vMeldXY)
meldSize = getHeapSize(tc3Heap, vMeldXY)
meldInvariant = verifyLeftistInvariant(tc3Heap, tc3Heap[6][vMeldXY])
meldExt = extractAllSortedKeys(tc3Heap, tc3Heap[6][vMeldXY])
expMeld = [5, 10, 18, 25, 32, 40, 55, 60, 70, 85]
matchMeld = compareIntArrays(meldExt, expMeld)

if (meldMin != 5 or meldSize != 10 or meldInvariant != 1 or matchMeld != 1) {
    print("[FAIL] Sub-case 3.1 Meld Heaps failed")
} else {
    print("  Two-way heap meld verified: size 10, min 5, sorted keys [5, 10, 18, 25, 32, 40, 55, 60, 70, 85]")
}

// Check input heaps X and Y remain untouched
sizeX = getHeapSize(tc3Heap, vX5)
sizeY = getHeapSize(tc3Heap, vY5)
minX = getMinKey(tc3Heap, vX5)
minY = getMinKey(tc3Heap, vY5)
if (sizeX != 5 or sizeY != 5 or minX != 10 or minY != 5) {
    print("[FAIL] Input heaps mutated during meld operation")
} else {
    print("  Input heaps X and Y preserved immutability during cross-timeline meld")
}

// Sub-case 3.2: Empty and Single-Element Heap Operations
vSingle = insertElement(tc3Heap, 0, 999, 1, "single 999")
singleSize = getHeapSize(tc3Heap, vSingle)
singleMin = getMinKey(tc3Heap, vSingle)
singleDist = getHeapDist(tc3Heap, vSingle)
vSingleDel = deleteMin(tc3Heap, vSingle, "delete single")
delSingleEmpty = isHeapEmpty(tc3Heap, vSingleDel)
delSingleSize = getHeapSize(tc3Heap, vSingleDel)

if (singleSize != 1 or singleMin != 999 or singleDist != 1 or delSingleEmpty != 1 or delSingleSize != 0) {
    print("[FAIL] Single-element heap lifecycle failed")
} else {
    print("  Single-element heap verified: [999] (dist 1) -> deleteMin yields empty heap (size 0)")
}

// Sub-case 3.3: Melding with empty heaps
vMeldEmptyRight = meldHeaps(tc3Heap, vX5, 0, "meld X with empty")
vMeldEmptyLeft = meldHeaps(tc3Heap, 0, vY5, "meld empty with Y")
vMeldBothEmpty = meldHeaps(tc3Heap, 0, 0, "meld empty with empty")

if (getHeapSize(tc3Heap, vMeldEmptyRight) != 5 or getMinKey(tc3Heap, vMeldEmptyRight) != 10 or getHeapSize(tc3Heap, vMeldEmptyLeft) != 5 or getMinKey(tc3Heap, vMeldEmptyLeft) != 5 or isHeapEmpty(tc3Heap, vMeldBothEmpty) != 1) {
    print("[FAIL] Melding with empty heaps failed")
} else {
    print("  Melding with empty heaps identity property verified")
}

// Sub-case 3.4: Duplicate / Identical keys
vDup0 = insertElement(tc3Heap, 0, 42, 1, "dup 1")
vDup1 = insertElement(tc3Heap, vDup0, 42, 2, "dup 2")
vDup2 = insertElement(tc3Heap, vDup1, 42, 3, "dup 3")
vDup3 = insertElement(tc3Heap, vDup2, 42, 4, "dup 4")

dupSize = getHeapSize(tc3Heap, vDup3)
dupMin = getMinKey(tc3Heap, vDup3)
dupExt = extractAllSortedKeys(tc3Heap, tc3Heap[6][vDup3])
expDup = [42, 42, 42, 42]
matchDup = compareIntArrays(dupExt, expDup)

if (dupSize != 4 or dupMin != 42 or matchDup != 1) {
    print("[FAIL] Duplicate keys handling failed")
} else {
    print("  Duplicate keys verified: 4 elements with identical key 42 extracted in order")
}

// Sub-case 3.5: Negative and Extreme Keys
vNeg0 = insertElement(tc3Heap, 0, -100, 1, "neg -100")
vNeg1 = insertElement(tc3Heap, vNeg0, 50, 2, "pos 50")
vNeg2 = insertElement(tc3Heap, vNeg1, -25, 3, "neg -25")
vNeg3 = insertElement(tc3Heap, vNeg2, 0, 4, "zero 0")

negMin = getMinKey(tc3Heap, vNeg3)
negExt = extractAllSortedKeys(tc3Heap, tc3Heap[6][vNeg3])
expNeg = [-100, -25, 0, 50]
matchNeg = compareIntArrays(negExt, expNeg)

if (negMin != -100 or matchNeg != 1) {
    print("[FAIL] Negative keys handling failed")
} else {
    print("  Negative and zero keys verified: sorted order [-100, -25, 0, 50]")
}

// Sub-case 3.6: Degenerate and Out-of-bounds Queries
oobMinKey = getMinKey(tc3Heap, 99999)
oobSize = getHeapSize(tc3Heap, -5)
oobDist = getHeapDist(tc3Heap, 88888)
oobPar = getVersionParent(tc3Heap, -1)
oobDesc = getVersionDescription(tc3Heap, 99999)

if (oobMinKey != -1 or oobSize != 0 or oobDist != 0 or oobPar != -1 or oobDesc != "") {
    print("[FAIL] Degenerate out-of-bounds query handling failed")
} else {
    print("  Degenerate and out-of-bounds queries gracefully returned default neutral values")
    print("  Test Case 3 Passed boundary and edge case verification")
}

// -----------------------------------------------------------------------------
// Test Case 4: Version Rollback & State Reconstruction
// -----------------------------------------------------------------------------
print("Running Test Case 4: Version Rollback and State Reconstruction...")
tc4Heap = createPersistentLeftistHeap()
initPersistentLeftistHeap(tc4Heap, "v0: empty")

// Initial timeline evolution:
v41 = insertElement(tc4Heap, 0, 50, 1, "v1: insert 50")
v42 = insertElement(tc4Heap, v41, 20, 2, "v2: insert 20")
v43 = insertElement(tc4Heap, v42, 80, 3, "v3: insert 80")
v44 = insertElement(tc4Heap, v43, 10, 4, "v4: insert 10 (checkpoint)")
v45 = insertElement(tc4Heap, v44, 60, 5, "v5: insert 60")
v46 = insertElement(tc4Heap, v45, 5, 6, "v6: insert 5")
v47 = deleteMin(tc4Heap, v46, "v7: deleteMin (pop 5)")
v48 = deleteMin(tc4Heap, v47, "v8: deleteMin (pop 10)")

v44Min = getMinKey(tc4Heap, v44)
v44Size = getHeapSize(tc4Heap, v44)
v48Min = getMinKey(tc4Heap, v48)
v48Size = getHeapSize(tc4Heap, v48)

if (v44Min != 10 or v44Size != 4 or v48Min != 20 or v48Size != 4) {
    print("[FAIL] Test Case 4 Initial timeline evolution failed")
} else {
    print("  Timeline evolved to v8: checkpoint v4 has min 10 (size 4), tip v8 has min 20 (size 4)")
}

// Rollback to checkpoint Version 4
v4Rollback = rollbackTo(tc4Heap, v44, "v9: rollback to v4")
rbMin = getMinKey(tc4Heap, v4Rollback)
rbSize = getHeapSize(tc4Heap, v4Rollback)
rbExt = extractAllSortedKeys(tc4Heap, tc4Heap[6][v4Rollback])
expRb = [10, 20, 50, 80]
matchRb = compareIntArrays(rbExt, expRb)

if (rbMin != 10 or rbSize != 4 or matchRb != 1) {
    print("[FAIL] Rollback to Version 4 failed")
} else {
    print("  Version rollback to Version 4 verified: restored size 4, minKey 10, keys [10, 20, 50, 80]")
}

// Post-rollback evolution from rollback version
v4New1 = insertElement(tc4Heap, v4Rollback, 15, 7, "v10: branch from rollback insert 15")
v4New2 = insertElement(tc4Heap, v4New1, 3, 8, "v11: branch from rollback insert 3")

newMin = getMinKey(tc4Heap, v4New2)
newSize = getHeapSize(tc4Heap, v4New2)
newExt = extractAllSortedKeys(tc4Heap, tc4Heap[6][v4New2])
expNew = [3, 10, 15, 20, 50, 80]
matchNew = compareIntArrays(newExt, expNew)

if (newMin != 3 or newSize != 6 or matchNew != 1) {
    print("[FAIL] Post-rollback evolution failed")
} else {
    print("  Post-rollback evolution verified: v11 formed size 6 with min 3, keys [3, 10, 15, 20, 50, 80]")
}

// Verify historical checkpoint v4 and former tip v8 remain pristine
v44FinalExt = extractAllSortedKeys(tc4Heap, tc4Heap[6][v44])
v48FinalExt = extractAllSortedKeys(tc4Heap, tc4Heap[6][v48])
exp44 = [10, 20, 50, 80]
exp48 = [20, 50, 60, 80]
match44 = compareIntArrays(v44FinalExt, exp44)
match48 = compareIntArrays(v48FinalExt, exp48)

if (match44 != 1 or match48 != 1) {
    print("[FAIL] Historical snapshots compromised during rollback evolution")
} else {
    print("  Historical snapshots v4 and v8 remained pristine and isolated throughout rollback")
    print("  Test Case 4 Passed rollback and state reconstruction verification")
}

// -----------------------------------------------------------------------------
// Test Case 5: Stress Benchmark against Naive Priority Queue Reference Oracle
// -----------------------------------------------------------------------------
print("Running Test Case 5: Stress Benchmark against Naive Priority Queue Reference Oracle...")
tc5Heap = createPersistentLeftistHeap()
initPersistentLeftistHeap(tc5Heap, "v0: empty baseline")

oracleVersions = [[]]
rngState = [1234567]

stressOpsCount = 60
opIdx = 0
mismatchCount = 0

while (opIdx < stressOpsCount) {
    numVersions = oracleVersions.size()
    randChoice = nextPrng(rngState) % 100
    baseVer = nextPrng(rngState) % numVersions

    if (randChoice < 55) {
        // Insert operation
        randKey = (nextPrng(rngState) % 500) + 1
        randVal = nextPrng(rngState) % 1000
        newVer = insertElement(tc5Heap, baseVer, randKey, randVal, "stress insert")
        baseList = oracleVersions[baseVer]
        newList = insertIntoSortedArray(baseList, randKey)
        oracleVersions.push(newList)
        actualNewSize = getHeapSize(tc5Heap, newVer)
        if (actualNewSize != newList.size()) {
            mismatchCount = mismatchCount + 1
        }
    } else {
        if (randChoice < 80) {
            // deleteMin operation
            baseList = oracleVersions[baseVer]
            if (baseList.size() > 0) {
                newVer = deleteMin(tc5Heap, baseVer, "stress deleteMin")
                newList = dropFirstElement(baseList)
                oracleVersions.push(newList)
                actualNewSize = getHeapSize(tc5Heap, newVer)
                if (actualNewSize != newList.size()) {
                    mismatchCount = mismatchCount + 1
                }
            } else {
                newVer = insertElement(tc5Heap, baseVer, 50, 1, "stress fallback insert")
                newList = insertIntoSortedArray(baseList, 50)
                oracleVersions.push(newList)
                actualNewSize = getHeapSize(tc5Heap, newVer)
                if (actualNewSize != newList.size()) {
                    mismatchCount = mismatchCount + 1
                }
            }
        } else {
            // Meld two historical versions
            otherVer = nextPrng(rngState) % numVersions
            newVer = meldHeaps(tc5Heap, baseVer, otherVer, "stress meld")
            listA = oracleVersions[baseVer]
            listB = oracleVersions[otherVer]
            mergedList = mergeSortedArrays(listA, listB)
            oracleVersions.push(mergedList)
            actualNewSize = getHeapSize(tc5Heap, newVer)
            if (actualNewSize != mergedList.size()) {
                mismatchCount = mismatchCount + 1
            }
        }
    }
    opIdx = opIdx + 1
}

// Randomized historical validation queries across generated versions
numGeneratedVersions = oracleVersions.size()
randomQueriesCount = 150
qIdx = 0

while (qIdx < randomQueriesCount) {
    qVer = nextPrng(rngState) % numGeneratedVersions
    expectedList = oracleVersions[qVer]
    actualSize = getHeapSize(tc5Heap, qVer)

    if (actualSize != expectedList.size()) {
        mismatchCount = mismatchCount + 1
    } else {
        if (actualSize > 0) {
            actualMin = getMinKey(tc5Heap, qVer)
            expectedMin = expectedList[0]
            if (actualMin != expectedMin) {
                mismatchCount = mismatchCount + 1
            }
        } else {
            if (isHeapEmpty(tc5Heap, qVer) != 1 or getMinKey(tc5Heap, qVer) != -1) {
                mismatchCount = mismatchCount + 1
            }
        }
    }

    // Comprehensive structural check on sampled versions
    if (qIdx % 15 == 0) {
        qRoot = tc5Heap[6][qVer]
        if (verifyLeftistInvariant(tc5Heap, qRoot) != 1) {
            mismatchCount = mismatchCount + 1
        }
        actualExt = extractAllSortedKeys(tc5Heap, qRoot)
        if (compareIntArrays(actualExt, expectedList) != 1) {
            mismatchCount = mismatchCount + 1
        }
    }

    qIdx = qIdx + 1
}

totalArenaNodes = getTotalArenaNodes(tc5Heap)

if (mismatchCount > 0) {
    print("[FAIL] Stress benchmark encountered ", mismatchCount, " mismatches")
} else {
    print("  Validated ", randomQueriesCount, " random historical queries across ", numGeneratedVersions, " versions: 0 mismatches")
    print("  Total allocated persistent leftist heap arena nodes: ", totalArenaNodes)
    print("  Test Case 5 Passed stress benchmark verification")
}

suiteEndTime = t.millis()
suiteDuration = suiteEndTime - suiteStartTime
print("[PASS] Persistent Leftist Heap Suite executed successfully in ", suiteDuration, " ms")


