import stdlib time as t

// Sequential Array Scan vs Random Pointer Jump Memory Latency Suite
// Technical characteristics:
// - Hardware memory access patterns & cache line prefetcher stress:
//   * Sequential Array Scan: Maximizes spatial & temporal locality with L1/L2 hardware prefetching
//   * Strided Scan: Strided access testing cache line alignment and boundary eviction
//   * Random Pointer Chasing: Hamiltonian single-cycle permutation forcing CPU cache & TLB misses
// - Mathematical cycle topologies:
//   * Sattolo's Algorithm: Uniformly distributed single Hamiltonian cycle over (N-1)! permutations
//   * Co-prime Strided Cycles: Deterministic modular arithmetic cycles via gcd(stride, N) == 1
//   * Sequential Linear Ring: Stride-1 cyclic ring buffer
//   * Inverse Permutation Chasing: Bidirectional dual-pointer topological validation
// - Deterministic checksum invariance: Sequential, Strided, and Random walks yield identical full-cycle sums
// - Cache hierarchy evaluation across multiple working set tiers (L1: 256, L2: 4096, L3/RAM: 32768)
// - High-throughput pointer-chasing throughput benchmark over 200,000 steps
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero external dependencies, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Sequential Array Scan vs Random Pointer Jump Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Helper Functions ---

func makeIntArray(sizeVal, defaultVal) {
    arr = []
    idx = 0
    while (idx < sizeVal) {
        arr.push(defaultVal)
        idx = idx + 1
    }
    return arr
}

func prngStep(stateArr) {
    nextVal = (stateArr[0] * 1103515245 + 12345) & 2147483647
    stateArr[0] = nextVal
    return nextVal
}

func prngBounded(stateArr, minVal, maxVal) {
    if (minVal == maxVal) {
        return minVal
    }
    span = (maxVal - minVal) + 1
    r = prngStep(stateArr)
    return minVal + (r % span)
}

// --- Chain Builders ---

func buildSequentialChain(sizeVal) {
    chain = []
    i = 0
    while (i < sizeVal) {
        chain.push((i + 1) % sizeVal)
        i = i + 1
    }
    return chain
}

func buildStridedChain(sizeVal, strideVal) {
    chain = []
    i = 0
    while (i < sizeVal) {
        chain.push((i + strideVal) % sizeVal)
        i = i + 1
    }
    return chain
}

// Sattolo's Algorithm generates a single cycle of length sizeVal visiting every node exactly once
func buildRandomHamiltonianCycle(sizeVal, seedVal) {
    chain = []
    i = 0
    while (i < sizeVal) {
        chain.push(i)
        i = i + 1
    }
    prngState = [seedVal & 2147483647]
    i = 0
    while (i < sizeVal - 1) {
        j = prngBounded(prngState, i + 1, sizeVal - 1)
        temp = chain[i]
        chain[i] = chain[j]
        chain[j] = temp
        i = i + 1
    }
    return chain
}

func buildInverseChain(chain) {
    n = chain.size()
    inv = makeIntArray(n, 0)
    i = 0
    while (i < n) {
        inv[chain[i]] = i
        i = i + 1
    }
    return inv
}

func validateHamiltonianCycle(chain) {
    n = chain.size()
    visited = makeIntArray(n, 0)
    curr = 0
    visitedCount = 0
    while (visitedCount < n) {
        if (visited[curr] == 1) {
            return 0
        }
        visited[curr] = 1
        visitedCount = visitedCount + 1
        curr = chain[curr]
    }
    if (curr == 0 and visitedCount == n) {
        return 1
    }
    return 0
}

// --- Test Case 1: Hamiltonian Single-Cycle Integrity & Node Coverage ---

print("--- Running Test Case 1: Hamiltonian Single-Cycle Integrity & Node Coverage ---")

testSizes = [16, 64, 256, 1024, 4096]
tIdx = 0
numSizes = testSizes.size()

while (tIdx < numSizes) {
    currSize = testSizes[tIdx]

    // 1.1 Sequential ring validation
    seqChain = buildSequentialChain(currSize)
    if (validateHamiltonianCycle(seqChain) != 1) {
        print("[FAIL] Test Case 1 Sequential chain invalid cycle for size ", currSize)
        testSuiteFailures = testSuiteFailures + 1
    }

    // 1.2 Co-prime Strided chain validation (stride 3 for 16, 64, 256, 1024, 4096)
    // gcd(3, 2^k) == 1, so stride 3 always generates a single Hamiltonian cycle
    strideChain = buildStridedChain(currSize, 3)
    if (validateHamiltonianCycle(strideChain) != 1) {
        print("[FAIL] Test Case 1 Strided chain (stride 3) invalid cycle for size ", currSize)
        testSuiteFailures = testSuiteFailures + 1
    }

    // 1.3 Random Hamiltonian cycle validation (Sattolo's Algorithm)
    seedVal = 13579 + currSize
    randChain = buildRandomHamiltonianCycle(currSize, seedVal)
    if (validateHamiltonianCycle(randChain) != 1) {
        print("[FAIL] Test Case 1 Random Hamiltonian chain invalid cycle for size ", currSize)
        testSuiteFailures = testSuiteFailures + 1
    }

    print("  Size ", currSize, ": Sequential, Strided(3), and Random Hamiltonian cycles verified 100% valid")
    tIdx = tIdx + 1
}

print("  Test Case 1 Passed Hamiltonian Single-Cycle Integrity & Node Coverage (5 working set sizes)")

// --- Test Case 2: Cross-Pattern Parity & Checksum Equivalence ---

print("--- Running Test Case 2: Cross-Pattern Parity & Checksum Equivalence ---")

paritySize = 4096
payloadData = []
directSum = 0
directXor = 0
pIdx = 0
while (pIdx < paritySize) {
    elem = (pIdx * 104729 + 17) % 1000000007
    payloadData.push(elem)
    directSum = (directSum + elem) % 1000000007
    directXor = directXor ^ elem
    pIdx = pIdx + 1
}

// 2.1 Sequential ring walk
seqChain4096 = buildSequentialChain(paritySize)
seqSum = 0
seqXor = 0
curr = 0
step = 0
while (step < paritySize) {
    val = payloadData[curr]
    seqSum = (seqSum + val) % 1000000007
    seqXor = seqXor ^ val
    curr = seqChain4096[curr]
    step = step + 1
}

if (curr != 0 or seqSum != directSum or seqXor != directXor) {
    print("[FAIL] Test Case 2 Sequential walk mismatch: sum=", seqSum, " xor=", seqXor, " finalNode=", curr)
    testSuiteFailures = testSuiteFailures + 1
}

// 2.2 Strided ring walk (stride 7, gcd(7, 4096) == 1)
stride7Chain4096 = buildStridedChain(paritySize, 7)
stride7Sum = 0
stride7Xor = 0
curr = 0
step = 0
while (step < paritySize) {
    val = payloadData[curr]
    stride7Sum = (stride7Sum + val) % 1000000007
    stride7Xor = stride7Xor ^ val
    curr = stride7Chain4096[curr]
    step = step + 1
}

if (curr != 0 or stride7Sum != directSum or stride7Xor != directXor) {
    print("[FAIL] Test Case 2 Strided (7) walk mismatch: sum=", stride7Sum, " xor=", stride7Xor, " finalNode=", curr)
    testSuiteFailures = testSuiteFailures + 1
}

// 2.3 Strided ring walk (stride 63, gcd(63, 4096) == 1)
stride63Chain4096 = buildStridedChain(paritySize, 63)
stride63Sum = 0
stride63Xor = 0
curr = 0
step = 0
while (step < paritySize) {
    val = payloadData[curr]
    stride63Sum = (stride63Sum + val) % 1000000007
    stride63Xor = stride63Xor ^ val
    curr = stride63Chain4096[curr]
    step = step + 1
}

if (curr != 0 or stride63Sum != directSum or stride63Xor != directXor) {
    print("[FAIL] Test Case 2 Strided (63) walk mismatch: sum=", stride63Sum, " xor=", stride63Xor, " finalNode=", curr)
    testSuiteFailures = testSuiteFailures + 1
}

// 2.4 Random Hamiltonian cycle walk
randChain4096 = buildRandomHamiltonianCycle(paritySize, 987654321)
randSum = 0
randXor = 0
curr = 0
step = 0
while (step < paritySize) {
    val = payloadData[curr]
    randSum = (randSum + val) % 1000000007
    randXor = randXor ^ val
    curr = randChain4096[curr]
    step = step + 1
}

if (curr != 0 or randSum != directSum or randXor != directXor) {
    print("[FAIL] Test Case 2 Random Hamiltonian walk mismatch: sum=", randSum, " xor=", randXor, " finalNode=", curr)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Direct Sum: ", directSum, " | XOR Checksum: ", directXor)
print("  Sequential, Strided(7), Strided(63), and Random walks match Direct Checksum 100%")
print("  Test Case 2 Passed Cross-Pattern Parity & Checksum Equivalence (4096 elements)")

// --- Test Case 3: Inverse Permutation & Bidirectional Pointer Chasing ---

print("--- Running Test Case 3: Inverse Permutation & Bidirectional Pointer Chasing ---")

invRandChain = buildInverseChain(randChain4096)

// 3.1 Verify inverse chain forms a valid Hamiltonian cycle
if (validateHamiltonianCycle(invRandChain) != 1) {
    print("[FAIL] Test Case 3 Inverse Hamiltonian chain failed cycle validation")
    testSuiteFailures = testSuiteFailures + 1
}

// 3.2 Verify inverse chain accumulates identical checksum
invSum = 0
invXor = 0
curr = 0
step = 0
while (step < paritySize) {
    val = payloadData[curr]
    invSum = (invSum + val) % 1000000007
    invXor = invXor ^ val
    curr = invRandChain[curr]
    step = step + 1
}

if (curr != 0 or invSum != directSum or invXor != directXor) {
    print("[FAIL] Test Case 3 Inverse walk mismatch: sum=", invSum, " xor=", invXor)
    testSuiteFailures = testSuiteFailures + 1
}

// 3.3 Bidirectional walk: Step forward K hops, then backward K hops in inverse chain
kHops = [1, 5, 27, 100, 512, 1024, 2048, 4095]
hIdx = 0
numHops = kHops.size()
while (hIdx < numHops) {
    hops = kHops[hIdx]
    startNode = (hops * 31) % paritySize
    pos = startNode

    // Walk forward
    h = 0
    while (h < hops) {
        pos = randChain4096[pos]
        h = h + 1
    }

    // Walk backward along inverse
    h = 0
    while (h < hops) {
        pos = invRandChain[pos]
        h = h + 1
    }

    if (pos != startNode) {
        print("[FAIL] Test Case 3 Bidirectional round-trip failed for ", hops, " hops: expected ", startNode, " got ", pos)
        testSuiteFailures = testSuiteFailures + 1
    }
    hIdx = hIdx + 1
}

print("  Bidirectional round-trips verified across all hop counts (1..4095)")
print("  Test Case 3 Passed Inverse Permutation & Bidirectional Pointer Chasing")

elapsedStage2 = t.millis() - suiteStartTime
if (testSuiteFailures != 0) {
    print("[FAIL] Stage 2 encountered failures: ", testSuiteFailures)
} else {
    print("  Stage 2 completed in ", elapsedStage2, " ms")
}
