import stdlib time as t

// Multi-Megabyte Numeric Array Sort Recursion Suite
// Technical characteristics:
// - High-performance numerical array sorting algorithms with recursion depth bounds:
//   * In-Place HeapSort: O(N log N) worst-case time with strictly O(1) auxiliary stack space
//   * Tail-Recursion-Bounded QuickSort: Median-of-3 pivot selection and smaller-partition recursion bounding stack depth to O(log N)
//   * Dijkstra 3-Way QuickSort: Dutch National Flag partitioning optimizing heavy-duplicate arrays to O(N)
//   * Stable Sorting Verification: Key-index pair tracking proving relative order preservation for identical keys
// - Adversarial input topologies:
//   * Pseudo-random uniform permutations
//   * Strictly ascending already sorted arrays (worst-case recursion trap)
//   * Strictly descending reversed arrays
//   * Pipe-organ bitonic arrays (ascending then descending)
//   * Heavy-duplicate arrays (few discrete unique values across tens of thousands of items)
//   * Constant single-value degenerate arrays
// - Exact invariant validation:
//   * Monotonic non-decreasing order: arr[i] <= arr[i+1]
//   * Conservation of elements: Sum and XOR parity match original input identically
//   * Recursion depth ceiling: Monitored max call depth strictly <= 2 * ceil(log2(N)) + 5
// - High-throughput sorting benchmark over 25,000+ element arrays
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero external dependencies, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Multi-Megabyte Numeric Array Sort Recursion Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Utility Functions ---

func makeIntArray(sz, defVal) {
    newArr = []
    mIdx = 0
    while (mIdx < sz) {
        newArr.push(defVal)
        mIdx = mIdx + 1
    }
    return newArr
}

func cloneArray(srcArr) {
    cloned = []
    cIdx = 0
    cLen = srcArr.size()
    while (cIdx < cLen) {
        cloned.push(srcArr[cIdx])
        cIdx = cIdx + 1
    }
    return cloned
}

func swapElements(targetArr, idx1, idx2) {
    tmp = targetArr[idx1]
    targetArr[idx1] = targetArr[idx2]
    targetArr[idx2] = tmp
}

func isSorted(arr) {
    n = arr.size()
    if (n <= 1) {
        return 1
    }
    chk = 0
    while (chk < n - 1) {
        if (arr[chk] > arr[chk + 1]) {
            return 0
        }
        chk = chk + 1
    }
    return 1
}

func computeArraySum(arr) {
    n = arr.size()
    sumVal = 0
    i = 0
    while (i < n) {
        sumVal = (sumVal + arr[i]) % 1000000007
        i = i + 1
    }
    return sumVal
}

func computeArrayXor(arr) {
    n = arr.size()
    xorVal = 0
    i = 0
    while (i < n) {
        xorVal = xorVal ^ arr[i]
        i = i + 1
    }
    return xorVal
}

func generatePseudoRandomArray(sz, seedVal) {
    arr = []
    gIdx = 0
    currSeed = seedVal & 2147483647
    while (gIdx < sz) {
        currSeed = (currSeed * 1103515245 + 12345) & 2147483647
        val = currSeed % 1000000
        arr.push(val)
        gIdx = gIdx + 1
    }
    return arr
}

// --- In-Place HeapSort Implementation ---

func siftDown(heapArr, rootIdx, maxLen) {
    root = rootIdx
    while (root * 2 + 1 < maxLen) {
        child = root * 2 + 1
        swp = root

        if (heapArr[swp] < heapArr[child]) {
            swp = child
        }

        if (child + 1 < maxLen) {
            if (heapArr[swp] < heapArr[child + 1]) {
                swp = child + 1
            }
        }

        if (swp == root) {
            return 0
        }

        tmpVal = heapArr[root]
        heapArr[root] = heapArr[swp]
        heapArr[swp] = tmpVal
        root = swp
    }
    return 0
}

func heapSort(targetArr) {
    hCount = targetArr.size()
    if (hCount <= 1) {
        return 0
    }

    // Phase 1: Build Max-Heap (Heapify)
    hStart = (hCount - 2) / 2
    while (hStart >= 0) {
        siftDown(targetArr, hStart, hCount)
        hStart = hStart - 1
    }

    // Phase 2: Extract elements from heap
    hEnd = hCount - 1
    while (hEnd > 0) {
        maxVal = targetArr[0]
        targetArr[0] = targetArr[hEnd]
        targetArr[hEnd] = maxVal
        siftDown(targetArr, 0, hEnd)
        hEnd = hEnd - 1
    }
    return 0
}

// --- Test Case 1: In-Place HeapSort Across Input Topologies ---

print("--- Running Test Case 1: In-Place HeapSort Across Input Topologies ---")

heapTestSize = 2000

// 1.1 Random Array
heapRandOrig = generatePseudoRandomArray(heapTestSize, 161803398)
heapRandArr = cloneArray(heapRandOrig)
expectedRandSum = computeArraySum(heapRandOrig)
expectedRandXor = computeArrayXor(heapRandOrig)

heapSort(heapRandArr)

if (isSorted(heapRandArr) != 1) {
    print("[FAIL] Test Case 1 HeapSort failed to sort random array")
    testSuiteFailures = testSuiteFailures + 1
}
if (computeArraySum(heapRandArr) != expectedRandSum or computeArrayXor(heapRandArr) != expectedRandXor) {
    print("[FAIL] Test Case 1 HeapSort random array parity mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
print("  HeapSort Random (2000 elements): Sorted=PASS, Parity=PASS")

// 1.2 Strictly Ascending Array (Already Sorted)
heapAscOrig = []
i = 0
while (i < heapTestSize) {
    heapAscOrig.push(i * 3 + 7)
    i = i + 1
}
heapAscArr = cloneArray(heapAscOrig)
heapSort(heapAscArr)
if (isSorted(heapAscArr) != 1 or computeArraySum(heapAscArr) != computeArraySum(heapAscOrig)) {
    print("[FAIL] Test Case 1 HeapSort failed on ascending array")
    testSuiteFailures = testSuiteFailures + 1
}
print("  HeapSort Ascending (2000 elements): Sorted=PASS, Parity=PASS")

// 1.3 Strictly Descending Array (Reversed)
heapDescOrig = []
i = 0
while (i < heapTestSize) {
    heapDescOrig.push((heapTestSize - i) * 5)
    i = i + 1
}
heapDescArr = cloneArray(heapDescOrig)
heapSort(heapDescArr)
if (isSorted(heapDescArr) != 1 or computeArraySum(heapDescArr) != computeArraySum(heapDescOrig)) {
    print("[FAIL] Test Case 1 HeapSort failed on descending array")
    testSuiteFailures = testSuiteFailures + 1
}
print("  HeapSort Descending (2000 elements): Sorted=PASS, Parity=PASS")

// 1.4 Heavy Duplicates Array (Only 3 unique values)
heapDupOrig = []
i = 0
while (i < heapTestSize) {
    heapDupOrig.push((i * 17) % 3)
    i = i + 1
}
heapDupArr = cloneArray(heapDupOrig)
heapSort(heapDupArr)
if (isSorted(heapDupArr) != 1 or computeArraySum(heapDupArr) != computeArraySum(heapDupOrig)) {
    print("[FAIL] Test Case 1 HeapSort failed on heavy duplicate array")
    testSuiteFailures = testSuiteFailures + 1
}
print("  HeapSort Heavy Duplicates (2000 elements): Sorted=PASS, Parity=PASS")

print("  Test Case 1 Passed In-Place HeapSort Across Input Topologies")

elapsedStage1 = t.millis() - suiteStartTime
if (testSuiteFailures != 0) {
    print("[FAIL] Stage 1 encountered failures: ", testSuiteFailures)
} else {
    print("  Stage 1 completed in ", elapsedStage1, " ms")
}
