import stdlib math as m
import stdlib time as t

// Vector 3D Engine Simulation
// Demonstrates geometric operations using flat arrays for JIT compatibility

// Vectors represented as [x, y, z] arrays

function vecAdd(v1, v2) {
    return [v1[0] + v2[0], v1[1] + v2[1], v1[2] + v2[2]]
}

function vecSub(v1, v2) {
    return [v1[0] - v2[0], v1[1] - v2[1], v1[2] - v2[2]]
}

function vecDot(v1, v2) {
    return (v1[0] * v2[0]) + (v1[1] * v2[1]) + (v1[2] * v2[2])
}

function vecCross(v1, v2) {
    nx = (v1[1] * v2[2]) - (v1[2] * v2[1])
    ny = (v1[2] * v2[0]) - (v1[0] * v2[2])
    nz = (v1[0] * v2[1]) - (v1[1] * v2[0])
    return [nx, ny, nz]
}

function vecLength(v) {
    return m.Sqrt((v[0] * v[0]) + (v[1] * v[1]) + (v[2] * v[2]))
}

function vecNormalize(v) {
    l = vecLength(v)
    if (l == 0.0) { return [0.0, 0.0, 0.0] }
    return [v[0] / l, v[1] / l, v[2] / l]
}

function printVec(label, v) {
    print(label, v[0], v[1], v[2])
}

// Main Execution
print("=== Nevaarize Vector3 Engine Demo ===")

vA = [1.0, 2.0, 3.0]
vB = [4.0, 5.0, 6.0]

printVec("Vector A:", vA)
printVec("Vector B:", vB)

vSum = vecAdd(vA, vB)
vDotVal = vecDot(vA, vB)
vCrossVal = vecCross(vA, vB)

print("Operations Results:")
printVec("- A + B =", vSum)
print("- A . B =", vDotVal)
printVec("- A x B =", vCrossVal)

print("Normalization Demo:")
vC = [10.0, 0.0, 0.0]
vNorm = vecNormalize(vC)
printVec("- Normalized (10,0,0) =", vNorm)

// Performance: batch dot products
print("Benchmarking 10000 dot products...")
start = t.millis()
i = 0
total = 0.0
while (i < 10000) {
    total = total + vecDot(vA, vB)
    i = i + 1
}
elapsed = t.millis() - start
print("Sum of 10000 dots:", total, "in", elapsed, "ms")

print("Vector engine demonstration finished.")
