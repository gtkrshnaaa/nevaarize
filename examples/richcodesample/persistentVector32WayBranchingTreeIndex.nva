import stdlib time as t

// Persistent Vector 32-Way Branching Tree Index Suite
// Technical characteristics:
// - Functional 32-way bitmapped vector trie index (branching factor B = 32 = 2^5)
// - O(log32 N) <= 6 steps deterministic index lookups and path copying
// - Structural sharing: immutable updates allocate only O(log32 N) path nodes
// - Dedicated tail buffer optimization: O(1) amortized push and pop operations
// - Full historical version immutability and timeline branching
// - Deterministic assertion suite verifying 32-boundary rollovers and node sharing
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero AI artifacts, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Persistent Vector 32-Way Branching Tree Index Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

globalVersionCounter = 0

func nextVersionId() {
    globalVersionCounter = globalVersionCounter + 1
    return globalVersionCounter
}

// --- 32-Way Node Allocation & Utilities ---

func createNode32() {
    node = []
    nodeIdx = 0
    while (nodeIdx < 32) {
        node.push(-1)
        nodeIdx = nodeIdx + 1
    }
    return node
}

func cloneNode32(origNode) {
    node = []
    cloneIdx = 0
    while (cloneIdx < 32) {
        node.push(origNode[cloneIdx])
        cloneIdx = cloneIdx + 1
    }
    return node
}

func cloneArray(srcArr) {
    res = []
    sz = srcArr.size()
    arrIdx = 0
    while (arrIdx < sz) {
        res.push(srcArr[arrIdx])
        arrIdx = arrIdx + 1
    }
    return res
}

func vectorTailOffset(cnt) {
    if (cnt < 32) {
        return 0
    }
    return ((cnt - 1) >> 5) << 5
}

// --- Vector Constructor ---
// Persistent Vector representation:
// [0]: count (integer)
// [1]: shift (depth offset: 5, 10, 15, ...)
// [2]: root (32-way node array or -1)
// [3]: tail (array of size up to 32)
// [4]: versionId (unique integer ID)

func createEmptyVector() {
    return [0, 5, -1, [], nextVersionId()]
}

func vectorSize(vec) {
    return vec[0]
}

func vectorVersion(vec) {
    return vec[4]
}

func newPath(level, tailNode) {
    if (level == 0) {
        return tailNode
    }
    ret = createNode32()
    ret[0] = newPath(level - 5, tailNode)
    return ret
}

func pushTail(level, parentNode, tailNode, cnt) {
    subIdx = ((cnt - 1) >> level) & 31
    newNode = cloneNode32(parentNode)
    if (level == 5) {
        newNode[subIdx] = tailNode
    } else {
        childNode = parentNode[subIdx]
        if (childNode == -1) {
            newNode[subIdx] = newPath(level - 5, tailNode)
        } else {
            newNode[subIdx] = pushTail(level - 5, childNode, tailNode, cnt)
        }
    }
    return newNode
}

// --- Vector Push ---

func vectorPush(vec, val) {
    cnt = vec[0]
    shift = vec[1]
    root = vec[2]
    tail = vec[3]

    // Room in tail? (tail size < 32)
    if (tail.size() < 32) {
        newTail = cloneArray(tail)
        newTail.push(val)
        return [cnt + 1, shift, root, newTail, nextVersionId()]
    }

    // Full tail needs to be pushed into tree
    newTail = [val]
    tailNode = cloneNode32(tail)

    // Check if root has overflowed
    if ((cnt >> 5) > (1 << shift)) {
        newRoot = createNode32()
        newRoot[0] = root
        newRoot[1] = newPath(shift, tailNode)
        return [cnt + 1, shift + 5, newRoot, newTail, nextVersionId()]
    }

    if (root == -1) {
        newRoot = createNode32()
        newRoot[0] = tailNode
        return [cnt + 1, shift, newRoot, newTail, nextVersionId()]
    }

    newRoot = pushTail(shift, root, tailNode, cnt)
    return [cnt + 1, shift, newRoot, newTail, nextVersionId()]
}

// --- Vector Get ---

func vectorGet(vec, index) {
    cnt = vec[0]
    if (index < 0 or index >= cnt) {
        return -1
    }
    tailOff = vectorTailOffset(cnt)
    if (index >= tailOff) {
        tail = vec[3]
        return tail[index - tailOff]
    }
    currNode = vec[2]
    level = vec[1]
    while (level > 0) {
        subIdx = (index >> level) & 31
        currNode = currNode[subIdx]
        level = level - 5
    }
    return currNode[index & 31]
}

// --- Vector Set (Path Copying) ---

func doAssoc(level, node, index, val) {
    newNode = cloneNode32(node)
    if (level == 0) {
        newNode[index & 31] = val
    } else {
        subIdx = (index >> level) & 31
        child = node[subIdx]
        newNode[subIdx] = doAssoc(level - 5, child, index, val)
    }
    return newNode
}

func vectorSet(vec, index, val) {
    cnt = vec[0]
    if (index < 0 or index >= cnt) {
        return vec
    }
    tailOff = vectorTailOffset(cnt)
    if (index >= tailOff) {
        newTail = cloneArray(vec[3])
        newTail[index - tailOff] = val
        return [cnt, vec[1], vec[2], newTail, nextVersionId()]
    }
    newRoot = doAssoc(vec[1], vec[2], index, val)
    return [cnt, vec[1], newRoot, vec[3], nextVersionId()]
}

// --- Vector Pop ---

func arrayFor(vec, index) {
    cnt = vec[0]
    if (index < 0 or index >= cnt) {
        return []
    }
    tailOff = vectorTailOffset(cnt)
    if (index >= tailOff) {
        return vec[3]
    }
    currNode = vec[2]
    level = vec[1]
    while (level > 0) {
        subIdx = (index >> level) & 31
        currNode = currNode[subIdx]
        level = level - 5
    }
    return currNode
}

func popTail(level, node, targetIdx) {
    subIdx = (targetIdx >> level) & 31
    if (level > 5) {
        child = node[subIdx]
        newChild = popTail(level - 5, child, targetIdx)
        if (newChild == -1 and subIdx == 0) {
            return -1
        }
        newNode = cloneNode32(node)
        newNode[subIdx] = newChild
        return newNode
    }
    if (level == 5) {
        if (subIdx == 0) {
            return -1
        }
        newNode = cloneNode32(node)
        newNode[subIdx] = -1
        return newNode
    }
    return -1
}

func vectorPop(vec) {
    cnt = vec[0]
    shift = vec[1]
    root = vec[2]
    tail = vec[3]

    if (cnt == 0) {
        return vec
    }
    if (cnt == 1) {
        return [0, 5, -1, [], nextVersionId()]
    }

    // Tail has more than 1 element: simple tail pop
    if (tail.size() > 1) {
        newTail = cloneArray(tail)
        newTail.pop()
        return [cnt - 1, shift, root, newTail, nextVersionId()]
    }

    // Tail has exactly 1 element: promote rightmost leaf from tree to tail
    targetIdx = cnt - 2
    newTailLeaf = arrayFor(vec, targetIdx)
    newTail = cloneArray(newTailLeaf)

    newRoot = popTail(shift, root, targetIdx)
    newShift = shift

    // Collapse root if top-level has only 1 child and shift > 5
    if (shift > 5 and newRoot != -1) {
        if (newRoot[1] == -1) {
            newRoot = newRoot[0]
            newShift = shift - 5
        }
    }

    return [cnt - 1, newShift, newRoot, newTail, nextVersionId()]
}

// --- Vector Conversion and Batch Utilities ---

func vectorToArray(vec) {
    arr = []
    cnt = vec[0]
    i = 0
    while (i < cnt) {
        arr.push(vectorGet(vec, i))
        i = i + 1
    }
    return arr
}

func vectorFromRange(startVal, countVal) {
    vec = createEmptyVector()
    i = 0
    while (i < countVal) {
        vec = vectorPush(vec, startVal + i)
        i = i + 1
    }
    return vec
}

// --- Test Case 1: Empty Vector Boundaries ---

print("--- Running Test Case 1: Empty Vector Boundaries ---")
vEmpty = createEmptyVector()
if (vectorSize(vEmpty) != 0) {
    print("[FAIL] Test Case 1 Empty vector size not 0: ", vectorSize(vEmpty))
    testSuiteFailures = testSuiteFailures + 1
}
if (vectorGet(vEmpty, 0) != -1 or vectorGet(vEmpty, -1) != -1 or vectorGet(vEmpty, 100) != -1) {
    print("[FAIL] Test Case 1 Out of bounds lookup did not return -1")
    testSuiteFailures = testSuiteFailures + 1
}

vEmptyPopped = vectorPop(vEmpty)
if (vectorSize(vEmptyPopped) != 0) {
    print("[FAIL] Test Case 1 Pop on empty vector altered size")
    testSuiteFailures = testSuiteFailures + 1
}

vEmptySet = vectorSet(vEmpty, 0, 42)
if (vectorSize(vEmptySet) != 0) {
    print("[FAIL] Test Case 1 Set on empty vector altered size")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 1 Passed empty vector boundary verification")

// --- Test Case 2: Tail-Only Mutations (1 to 31 elements) ---

print("--- Running Test Case 2: Tail-Only Mutations (1 to 31 elements) ---")
vTail = createEmptyVector()
elemIdx = 0
while (elemIdx < 31) {
    vTail = vectorPush(vTail, elemIdx * 10)
    elemIdx = elemIdx + 1
}

if (vectorSize(vTail) != 31) {
    print("[FAIL] Test Case 2 Expected size 31, got ", vectorSize(vTail))
    testSuiteFailures = testSuiteFailures + 1
}
// Root should still be -1 (pure tail optimization)
if (vTail[2] != -1) {
    print("[FAIL] Test Case 2 Expected empty root for tail-only vector")
    testSuiteFailures = testSuiteFailures + 1
}

// Verify lookups
lookupOk = true
elemIdx = 0
while (elemIdx < 31) {
    val = vectorGet(vTail, elemIdx)
    if (val != elemIdx * 10) {
        lookupOk = false
    }
    elemIdx = elemIdx + 1
}
if (!lookupOk) {
    print("[FAIL] Test Case 2 Tail lookup value mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

// Test immutability via set
vTailUpdated = vectorSet(vTail, 15, 9999)
if (vectorGet(vTailUpdated, 15) != 9999) {
    print("[FAIL] Test Case 2 Updated vector did not reflect new value at index 15")
    testSuiteFailures = testSuiteFailures + 1
}
if (vectorGet(vTail, 15) != 150) {
    print("[FAIL] Test Case 2 Original vector was mutated during set operation (Immutability violation)")
    testSuiteFailures = testSuiteFailures + 1
}

// Test tail pops
vTailPop1 = vectorPop(vTail)
if (vectorSize(vTailPop1) != 30 or vectorGet(vTailPop1, 29) != 290) {
    print("[FAIL] Test Case 2 Pop from size 31 to 30 failed")
    testSuiteFailures = testSuiteFailures + 1
}
if (vectorSize(vTail) != 31) {
    print("[FAIL] Test Case 2 Original vector size mutated during pop")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 2 Passed tail-only mutations and immutability verification")

// --- Test Case 3: Exact 32-Element Rollover Boundary ---

print("--- Running Test Case 3: Exact 32-Element Rollover Boundary ---")
v32 = vectorPush(vTail, 310) // Now size 32 (indices 0..31)
if (vectorSize(v32) != 32) {
    print("[FAIL] Test Case 3 Size 32 vector mismatch: ", vectorSize(v32))
    testSuiteFailures = testSuiteFailures + 1
}
if (v32[2] != -1 or v32[3].size() != 32) {
    print("[FAIL] Test Case 3 At exactly 32 elements, tail should hold all 32 and root should be -1")
    testSuiteFailures = testSuiteFailures + 1
}

// Push 33rd element (rollover to tree!)
v33 = vectorPush(v32, 3333)
if (vectorSize(v33) != 33) {
    print("[FAIL] Test Case 3 Size 33 vector mismatch: ", vectorSize(v33))
    testSuiteFailures = testSuiteFailures + 1
}
// Now root must NOT be -1: root[0] holds the old tail of 32 elements!
if (v33[2] == -1) {
    print("[FAIL] Test Case 3 Root must be allocated when 33rd element is pushed")
    testSuiteFailures = testSuiteFailures + 1
}
// New tail should contain exactly 1 element: [3333]
if (v33[3].size() != 1 or v33[3][0] != 3333) {
    print("[FAIL] Test Case 3 New tail should contain exactly 1 element [3333]")
    testSuiteFailures = testSuiteFailures + 1
}

// Verify all 33 elements lookups across tree/tail boundary
v33LookupsOk = true
i = 0
while (i < 32) {
    if (vectorGet(v33, i) != i * 10) {
        v33LookupsOk = false
    }
    i = i + 1
}
if (vectorGet(v33, 32) != 3333) {
    v33LookupsOk = false
}
if (!v33LookupsOk) {
    print("[FAIL] Test Case 3 Rollover 33-element lookups across tree/tail boundary failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Pop 33rd element: leaf root[0] should be promoted back to tail!
v33Popped = vectorPop(v33)
if (vectorSize(v33Popped) != 32) {
    print("[FAIL] Test Case 3 Popped 33rd element did not restore size 32: ", vectorSize(v33Popped))
    testSuiteFailures = testSuiteFailures + 1
}
if (v33Popped[2] != -1 or v33Popped[3].size() != 32) {
    print("[FAIL] Test Case 3 Popped 33rd element did not collapse root and restore full tail")
    testSuiteFailures = testSuiteFailures + 1
}
i = 0
popLookupsOk = true
while (i < 32) {
    if (vectorGet(v33Popped, i) != i * 10) {
        popLookupsOk = false
    }
    i = i + 1
}
if (!popLookupsOk) {
    print("[FAIL] Test Case 3 Popped 32-element lookups mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 3 Passed exact 32-element rollover and leaf promotion verification")

// --- Test Case 4: Level 1 Saturation (1,024 elements) & Structural Sharing ---

print("--- Running Test Case 4: Level 1 Saturation (1,024 elements) & Structural Sharing ---")
v1024 = vectorFromRange(0, 1024)
if (vectorSize(v1024) != 1024) {
    print("[FAIL] Test Case 4 Size 1024 mismatch: ", vectorSize(v1024))
    testSuiteFailures = testSuiteFailures + 1
}

// All 1024 elements must be exact
all1024Ok = true
scanIdx = 0
while (scanIdx < 1024) {
    if (vectorGet(v1024, scanIdx) != scanIdx) {
        all1024Ok = false
    }
    scanIdx = scanIdx + 1
}
if (!all1024Ok) {
    print("[FAIL] Test Case 4 1,024 element lookup value mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

// Update index 500 (in leaf 15 of tree)
v1024Mod = vectorSet(v1024, 500, 88888)
if (vectorGet(v1024Mod, 500) != 88888) {
    print("[FAIL] Test Case 4 Modified element not updated in new vector")
    testSuiteFailures = testSuiteFailures + 1
}
if (vectorGet(v1024, 500) != 500) {
    print("[FAIL] Test Case 4 Original vector mutated during set at index 500")
    testSuiteFailures = testSuiteFailures + 1
}

// Structural Sharing Verification:
rootOrig = v1024[2]
rootMod = v1024Mod[2]
if (rootOrig == rootMod) {
    print("[FAIL] Test Case 4 Root arrays must not be identical (path copy required)")
    testSuiteFailures = testSuiteFailures + 1
}

// Leaf 15 must be different
targetLeafIdx = (500 >> 5) & 31
if (rootOrig[targetLeafIdx] == rootMod[targetLeafIdx]) {
    print("[FAIL] Test Case 4 Target leaf 15 was not cloned during update")
    testSuiteFailures = testSuiteFailures + 1
}

// Sibling leaves must be identical (Structural Sharing)
sharedLeavesCount = 0
leafCheckIdx = 0
while (leafCheckIdx < 31) {
    if (leafCheckIdx != targetLeafIdx) {
        if (rootOrig[leafCheckIdx] == rootMod[leafCheckIdx]) {
            sharedLeavesCount = sharedLeavesCount + 1
        }
    }
    leafCheckIdx = leafCheckIdx + 1
}

if (sharedLeavesCount != 30) {
    print("[FAIL] Test Case 4 Structural sharing violation: expected 30 shared sibling leaves, got ", sharedLeavesCount)
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 4 Passed level 1 saturation (1,024 elements) and pointer structural sharing verification (", sharedLeavesCount, "/30 leaves shared)")

// --- Test Case 5: Multi-Level Trie Scaling (Level 2: 2,048 elements, shift = 10) ---

print("--- Running Test Case 5: Multi-Level Trie Scaling (Level 2: 2,048 elements) ---")
v2048 = vectorFromRange(0, 2048)
if (vectorSize(v2048) != 2048) {
    print("[FAIL] Test Case 5 Size 2048 mismatch: ", vectorSize(v2048))
    testSuiteFailures = testSuiteFailures + 1
}
if (v2048[1] != 10) {
    print("[FAIL] Test Case 5 Expected shift 10 for 2,048 elements, got: ", v2048[1])
    testSuiteFailures = testSuiteFailures + 1
}

all2048Ok = true
i2048 = 0
while (i2048 < 2048) {
    if (vectorGet(v2048, i2048) != i2048) {
        all2048Ok = false
    }
    i2048 = i2048 + 1
}
if (!all2048Ok) {
    print("[FAIL] Test Case 5 2,048-element lookup value mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

// Multi-branch immutable update in second internal branch (index 1500)
v2048Mod = vectorSet(v2048, 1500, 777777)
if (vectorGet(v2048Mod, 1500) != 777777) {
    print("[FAIL] Test Case 5 Modified element at index 1500 not reflected in updated vector")
    testSuiteFailures = testSuiteFailures + 1
}
if (vectorGet(v2048, 1500) != 1500) {
    print("[FAIL] Test Case 5 Original vector mutated during set at index 1500")
    testSuiteFailures = testSuiteFailures + 1
}

// Verify structural sharing across 2 levels of hierarchy:
root2048Orig = v2048[2]
root2048Mod = v2048Mod[2]
if (root2048Orig == root2048Mod) {
    print("[FAIL] Test Case 5 Multi-level root was not cloned")
    testSuiteFailures = testSuiteFailures + 1
}

if (root2048Orig[0] != root2048Mod[0]) {
    print("[FAIL] Test Case 5 Multi-level structural sharing failed: branch 0 was not shared")
    testSuiteFailures = testSuiteFailures + 1
}

if (root2048Orig[1] == root2048Mod[1]) {
    print("[FAIL] Test Case 5 Branch 1 should have been cloned along the mutation path")
    testSuiteFailures = testSuiteFailures + 1
}

subLeafIdx = (1500 >> 5) & 31
branch1Orig = root2048Orig[1]
branch1Mod = root2048Mod[1]
if (branch1Orig[subLeafIdx] == branch1Mod[subLeafIdx]) {
    print("[FAIL] Test Case 5 Target sub-leaf in branch 1 was not cloned")
    testSuiteFailures = testSuiteFailures + 1
}

branch1SharedLeaves = 0
chkIdx = 0
while (chkIdx < 32) {
    if (chkIdx != subLeafIdx) {
        if (branch1Orig[chkIdx] == branch1Mod[chkIdx]) {
            branch1SharedLeaves = branch1SharedLeaves + 1
        }
    }
    chkIdx = chkIdx + 1
}
if (branch1SharedLeaves < 30) {
    print("[FAIL] Test Case 5 Multi-level sibling leaves not structurally shared in branch 1: ", branch1SharedLeaves)
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 5 Passed multi-level trie scaling (2,048 elements) and 2-level structural sharing")

// --- Test Case 6: Historical Version Branching & Timeline Divergence ---

print("--- Running Test Case 6: Historical Version Branching & Timeline Divergence ---")
vBase = vectorFromRange(100, 50)

vBranchA = vBase
pushIdx = 0
while (pushIdx < 20) {
    vBranchA = vectorPush(vBranchA, 1000 + pushIdx)
    pushIdx = pushIdx + 1
}
vBranchA = vectorSet(vBranchA, 10, 8888)

vBranchB = vBase
popIdx = 0
while (popIdx < 20) {
    vBranchB = vectorPop(vBranchB)
    popIdx = popIdx + 1
}
vBranchB = vectorSet(vBranchB, 10, 9999)

vBranchC = vectorSet(vBase, 25, 55555)

if (vectorSize(vBase) != 50 or vectorGet(vBase, 10) != 110 or vectorGet(vBase, 25) != 125) {
    print("[FAIL] Test Case 6 Base vector corrupted by timeline branching")
    testSuiteFailures = testSuiteFailures + 1
}

if (vectorSize(vBranchA) != 70 or vectorGet(vBranchA, 10) != 8888 or vectorGet(vBranchA, 69) != 1019) {
    print("[FAIL] Test Case 6 Branch A invariants violated")
    testSuiteFailures = testSuiteFailures + 1
}

if (vectorSize(vBranchB) != 30 or vectorGet(vBranchB, 10) != 9999 or vectorGet(vBranchB, 29) != 129) {
    print("[FAIL] Test Case 6 Branch B invariants violated")
    testSuiteFailures = testSuiteFailures + 1
}

if (vectorSize(vBranchC) != 50 or vectorGet(vBranchC, 10) != 110 or vectorGet(vBranchC, 25) != 55555) {
    print("[FAIL] Test Case 6 Branch C invariants violated")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 6 Passed historical version branching and independent timeline divergence")

// --- Test Case 7: High-Volume Mutation & Stress Benchmark ---

print("--- Running Test Case 7: High-Volume Mutation & Stress Benchmark ---")
stressStart = t.millis()
vStress = createEmptyVector()
stressIdx = 0
while (stressIdx < 2000) {
    vStress = vectorPush(vStress, stressIdx * 3)
    stressIdx = stressIdx + 1
}

stressIdx = 0
while (stressIdx < 500) {
    targetIdx = stressIdx * 4
    vStress = vectorSet(vStress, targetIdx, targetIdx * 7)
    stressIdx = stressIdx + 1
}

stressIdx = 0
while (stressIdx < 300) {
    vStress = vectorPop(vStress)
    stressIdx = stressIdx + 1
}

expectedStressSize = 1700
if (vectorSize(vStress) != expectedStressSize) {
    print("[FAIL] Test Case 7 Stress size mismatch: expected 1700, got ", vectorSize(vStress))
    testSuiteFailures = testSuiteFailures + 1
}

if (vectorGet(vStress, 0) != 0 or vectorGet(vStress, 4) != 28 or vectorGet(vStress, 1) != 3 or vectorGet(vStress, 1699) != 1699 * 3) {
    print("[FAIL] Test Case 7 Stress spot check values mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
stressDuration = t.millis() - stressStart
print("  Test Case 7 Passed high-volume stress benchmark (2,800 operations in ", stressDuration, " ms)")

// --- Benchmark Timings and Final Assertion ---

suiteElapsedTime = t.millis() - suiteStartTime

if (testSuiteFailures == 0) {
    print("[PASS] Persistent Vector 32-Way Branching Tree Index Suite executed successfully in ", suiteElapsedTime, " ms")
} else {
    print("[FAIL] Persistent Vector Suite encountered ", testSuiteFailures, " failures")
}

