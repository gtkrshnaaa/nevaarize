import stdlib time as t
import stdlib math as m

// Producer-Consumer Pattern Simulation
// Demonstrates async/await coordination with numeric returns

async func produceItem(id) {
    procTime = m.RandomInt(10, 50)
    t.sleep(procTime)
    value = m.Random() * 100.0
    print("Producer - Item", id, "created (time:", procTime, "ms, value:", value, ")")
    return value
}

async func consumeItem(id, value) {
    procTime = m.RandomInt(10, 30)
    t.sleep(procTime)
    result = value * 2.0
    print("Consumer - Item", id, "processed. Result:", result)
    return result
}

// Main Execution
print("=== Nevaarize Async Architecture Demo ===")
start = t.millis()

// Phase 1: Produce items
print("Phase 1: Producing 5 items...")
prodTasks = []
i = 0
while (i < 5) {
    prodTasks.push(produceItem(i))
    i = i + 1
}

// Collect produced values
values = []
i = 0
while (i < 5) {
    val = await prodTasks[i]
    values.push(val)
    i = i + 1
}

print("All items produced.")

// Phase 2: Consume in parallel
print("Phase 2: Consuming items in parallel...")
consTasks = []
i = 0
while (i < 5) {
    consTasks.push(consumeItem(i, values[i]))
    i = i + 1
}

// Collect results
totalValue = 0.0
i = 0
while (i < 5) {
    result = await consTasks[i]
    totalValue = totalValue + result
    i = i + 1
}

elapsed = t.millis() - start
print("=== Simulation Complete ===")
print("Final Aggregate Result:", totalValue)
print("Total Execution Time:", elapsed, "ms")
