import stdlib time as t

// Monadic Either/Result Error Handling and Short-Circuit Pipeline Suite
// Technical characteristics:
// - Functional Either/Result sum type providing total error safety without exceptions
// - First-class monadic combinators: map, mapLeft, bimap, flatMap/bind, and fold
// - Formal verification of Monad Laws: Left Identity, Right Identity, and Associativity
// - Deterministic error short-circuit pipeline with non-execution proof for downstream stages
// - Multi-stage transactional e-commerce checkout simulation with 5 distinct failure barriers
// - Applicative sequenceEithers and partitionEithers aggregation primitives
// - High-throughput stress benchmark across 50,000 pipeline executions with zero memory bloat
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero external dependencies, zero emojis, and zero em dashes

print("=== Nevaarize Monadic Either/Result Short-Circuit Suite ===")
suiteStartTime = t.millis()

// --- Error Code Constants ---

errDivByZero = 101
errOutOfRange = 102
errOddParity = 103
errInsufficientBalance = 104
errLowCreditScore = 105

errInvalidOrder = 2001
errOutOfStock = 2002
errInvalidCoupon = 2003
errUnsupportedShippingRegion = 2004
errPaymentDeclined = 2005

// --- Core Either Constructors and Predicates ---
// Either representation:
// [0]: tag (1 = Right / Success, 0 = Left / Failure)
// [1]: payload (value if Right, error code if Left)

func createRight(val) {
    return [1, val]
}

func createLeft(err) {
    return [0, err]
}

func isRight(either) {
    if (either[0] == 1) {
        return true
    }
    return false
}

func isLeft(either) {
    if (either[0] == 0) {
        return true
    }
    return false
}

func unwrapRightOr(either, fallbackVal) {
    if (either[0] == 1) {
        return either[1]
    }
    return fallbackVal
}

func unwrapLeftOr(either, fallbackErr) {
    if (either[0] == 0) {
        return either[1]
    }
    return fallbackErr
}

func fromPredicate(val, predOpId, errCode) {
    if (applyPredicate(predOpId, val) == 1) {
        return createRight(val)
    }
    return createLeft(errCode)
}

// --- Operation Dispatch Registries ---

func applyRightTransform(opId, val) {
    if (opId == 1) {
        // Increment
        return val + 1
    } elif (opId == 2) {
        // Double
        return val * 2
    } elif (opId == 3) {
        // Square
        return val * val
    } elif (opId == 4) {
        // Add fee 50
        return val + 50
    } elif (opId == 5) {
        // Apply 15% discount
        return (val * 85) / 100
    } elif (opId == 6) {
        // Tax 8%
        return (val * 108) / 100
    } elif (opId == 7) {
        // Scale to cents
        return val * 100
    }
    return val
}

func applyLeftTransform(opId, err) {
    if (opId == 1) {
        // Offset error domain by 10,000
        return err + 10000
    } elif (opId == 2) {
        // Scale error code
        return err * 10
    } elif (opId == 3) {
        // Critical severity promotion
        return err + 50000
    }
    return err
}

func applyFlatTransform(opId, val) {
    if (opId == 1) {
        // Safe reciprocal 100,000 / val
        if (val == 0) {
            return createLeft(errDivByZero)
        }
        return createRight(100000 / val)
    } elif (opId == 2) {
        // Range validation: [10, 10000]
        if (val < 10 or val > 10000) {
            return createLeft(errOutOfRange)
        }
        return createRight(val)
    } elif (opId == 3) {
        // Even parity reduction
        if (val % 2 != 0) {
            return createLeft(errOddParity)
        }
        return createRight(val / 2)
    } elif (opId == 4) {
        // Account deduction of 50
        if (val < 50) {
            return createLeft(errInsufficientBalance)
        }
        return createRight(val - 50)
    } elif (opId == 5) {
        // Credit rating check: minimum 700
        if (val < 700) {
            return createLeft(errLowCreditScore)
        }
        return createRight(val)
    }
    return createLeft(0)
}

func applyPredicate(predId, val) {
    if (predId == 1) {
        // Strictly positive
        if (val > 0) {
            return 1
        }
        return 0
    } elif (predId == 2) {
        // Even number
        if (val % 2 == 0) {
            return 1
        }
        return 0
    } elif (predId == 3) {
        // Valid business range: [100, 5000]
        if (val >= 100 and val <= 5000) {
            return 1
        }
        return 0
    }
    return 0
}

// --- Monadic Combinators ---

func eitherMap(either, opId) {
    if (either[0] == 0) {
        return either
    }
    newVal = applyRightTransform(opId, either[1])
    return createRight(newVal)
}

func eitherMapLeft(either, opId) {
    if (either[0] == 1) {
        return either
    }
    newErr = applyLeftTransform(opId, either[1])
    return createLeft(newErr)
}

func eitherBimap(either, leftOpId, rightOpId) {
    if (either[0] == 0) {
        return createLeft(applyLeftTransform(leftOpId, either[1]))
    }
    return createRight(applyRightTransform(rightOpId, either[1]))
}

func eitherFlatMap(either, flatOpId) {
    if (either[0] == 0) {
        return either
    }
    return applyFlatTransform(flatOpId, either[1])
}

func eitherFold(either, leftOpId, rightOpId) {
    if (either[0] == 0) {
        return applyLeftTransform(leftOpId, either[1])
    }
    return applyRightTransform(rightOpId, either[1])
}

func eitherOrElse(eitherA, eitherB) {
    if (eitherA[0] == 1) {
        return eitherA
    }
    return eitherB
}

func eitherAnd(eitherA, eitherB) {
    if (eitherA[0] == 0) {
        return eitherA
    }
    return eitherB
}

func eitherZip(eitherA, eitherB) {
    if (eitherA[0] == 0) {
        return eitherA
    }
    if (eitherB[0] == 0) {
        return eitherB
    }
    return createRight([eitherA[1], eitherB[1]])
}

func sequenceEithers(eitherList) {
    resArr = []
    listLen = eitherList.size()
    idx = 0
    while (idx < listLen) {
        item = eitherList[idx]
        if (item[0] == 0) {
            // Short-circuit on first failure
            return item
        }
        resArr.push(item[1])
        idx = idx + 1
    }
    return createRight(resArr)
}

func partitionEithers(eitherList) {
    lefts = []
    rights = []
    listLen = eitherList.size()
    idx = 0
    while (idx < listLen) {
        item = eitherList[idx]
        if (item[0] == 0) {
            lefts.push(item[1])
        } else {
            rights.push(item[1])
        }
        idx = idx + 1
    }
    return [lefts, rights]
}

// --- Tracking Pipeline for Short-Circuit Verification ---

globalStageHits = [0, 0, 0, 0, 0]

func resetStageHits() {
    globalStageHits = [0, 0, 0, 0, 0]
}

func trackedStageOne(val) {
    globalStageHits[0] = globalStageHits[0] + 1
    if (val <= 0) {
        return createLeft(errInvalidOrder)
    }
    return createRight(val + 10)
}

func trackedStageTwo(val) {
    globalStageHits[1] = globalStageHits[1] + 1
    if (val > 1000) {
        return createLeft(errOutOfRange)
    }
    return createRight(val * 2)
}

func trackedStageThree(val) {
    globalStageHits[2] = globalStageHits[2] + 1
    if (val % 3 == 0) {
        return createLeft(errOddParity)
    }
    return createRight(val + 5)
}

func trackedStageFour(val) {
    globalStageHits[3] = globalStageHits[3] + 1
    if (val < 50) {
        return createLeft(errInsufficientBalance)
    }
    return createRight(val - 20)
}

func trackedStageFive(val) {
    globalStageHits[4] = globalStageHits[4] + 1
    return createRight(val * 3)
}

func runTrackedPipeline(initialVal) {
    stepOne = trackedStageOne(initialVal)
    if (stepOne[0] == 0) {
        return stepOne
    }
    stepTwo = trackedStageTwo(stepOne[1])
    if (stepTwo[0] == 0) {
        return stepTwo
    }
    stepThree = trackedStageThree(stepTwo[1])
    if (stepThree[0] == 0) {
        return stepThree
    }
    stepFour = trackedStageFour(stepThree[1])
    if (stepFour[0] == 0) {
        return stepFour
    }
    return trackedStageFive(stepFour[1])
}

// --- E-Commerce Checkout Domain Pipeline ---
// Order packet representation:
// [0]: itemCount
// [1]: unitPrice
// [2]: stockAvailable
// [3]: couponCode (0 = none, 1 = 10% off, 2 = 25% off min $100, 99 = invalid)
// [4]: shippingRegion (1 = domestic standard $10, 2 = express $25, 99 = unsupported)
// [5]: customerBalance

func checkoutStageOneValidateOrder(order) {
    itemCount = order[0]
    unitPrice = order[1]
    if (itemCount <= 0 or unitPrice <= 0) {
        return createLeft(errInvalidOrder)
    }
    rawTotal = itemCount * unitPrice
    return createRight(rawTotal)
}

func checkoutStageTwoCheckInventory(rawTotal, order) {
    itemCount = order[0]
    stockAvailable = order[2]
    if (itemCount > stockAvailable) {
        return createLeft(errOutOfStock)
    }
    return createRight(rawTotal)
}

func checkoutStageThreeApplyCoupon(subtotal, order) {
    couponCode = order[3]
    if (couponCode == 0) {
        return createRight(subtotal)
    } elif (couponCode == 1) {
        // 10% discount
        discounted = (subtotal * 90) / 100
        return createRight(discounted)
    } elif (couponCode == 2) {
        // 25% discount if subtotal >= 100
        if (subtotal < 100) {
            return createLeft(errInvalidCoupon)
        }
        discounted = (subtotal * 75) / 100
        return createRight(discounted)
    }
    return createLeft(errInvalidCoupon)
}

func checkoutStageFourCalculateShipping(discountedTotal, order) {
    region = order[4]
    if (region == 1) {
        return createRight(discountedTotal + 10)
    } elif (region == 2) {
        return createRight(discountedTotal + 25)
    }
    return createLeft(errUnsupportedShippingRegion)
}

func checkoutStageFiveChargePayment(finalAmount, order) {
    balance = order[5]
    if (balance < finalAmount) {
        return createLeft(errPaymentDeclined)
    }
    remainingBalance = balance - finalAmount
    return createRight(remainingBalance)
}

func runCheckoutPipeline(order) {
    s1 = checkoutStageOneValidateOrder(order)
    if (s1[0] == 0) {
        return s1
    }
    s2 = checkoutStageTwoCheckInventory(s1[1], order)
    if (s2[0] == 0) {
        return s2
    }
    s3 = checkoutStageThreeApplyCoupon(s2[1], order)
    if (s3[0] == 0) {
        return s3
    }
    s4 = checkoutStageFourCalculateShipping(s3[1], order)
    if (s4[0] == 0) {
        return s4
    }
    return checkoutStageFiveChargePayment(s4[1], order)
}

// --- Test Suites and Deterministic Assertions ---

testSuiteFailures = 0

// Test Case 1: Core Either Constructors and Invariants
print("Running Test Case 1: Core Constructors and Invariants...")

rightVal = createRight(42)
leftVal = createLeft(errOutOfRange)

if (!isRight(rightVal) or isLeft(rightVal)) {
    print("[FAIL] Test Case 1 Right predicate mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
if (!isLeft(leftVal) or isRight(leftVal)) {
    print("[FAIL] Test Case 1 Left predicate mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

if (unwrapRightOr(rightVal, 0) != 42) {
    print("[FAIL] Test Case 1 unwrapRightOr failed for Right")
    testSuiteFailures = testSuiteFailures + 1
}
if (unwrapRightOr(leftVal, 999) != 999) {
    print("[FAIL] Test Case 1 unwrapRightOr failed for Left fallback")
    testSuiteFailures = testSuiteFailures + 1
}
if (unwrapLeftOr(leftVal, 0) != errOutOfRange) {
    print("[FAIL] Test Case 1 unwrapLeftOr failed for Left")
    testSuiteFailures = testSuiteFailures + 1
}
if (unwrapLeftOr(rightVal, 777) != 777) {
    print("[FAIL] Test Case 1 unwrapLeftOr failed for Right fallback")
    testSuiteFailures = testSuiteFailures + 1
}

predRight = fromPredicate(50, 1, errOutOfRange)
predLeft = fromPredicate(-5, 1, errOutOfRange)
if (!isRight(predRight) or predRight[1] != 50) {
    print("[FAIL] Test Case 1 fromPredicate Right mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
if (!isLeft(predLeft) or predLeft[1] != errOutOfRange) {
    print("[FAIL] Test Case 1 fromPredicate Left mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 1 Passed core constructors and predicate invariants")

// Test Case 2: Functor and Bifunctor Transformations (map, mapLeft, bimap)
print("Running Test Case 2: Functor and Bifunctor Transformations...")

baseRight = createRight(10)
baseLeft = createLeft(500)

// Map transforms Right, passes Left untouched
mappedRight = eitherMap(baseRight, 2) // 10 * 2 = 20
mappedLeft = eitherMap(baseLeft, 2)
if (!isRight(mappedRight) or mappedRight[1] != 20) {
    print("[FAIL] Test Case 2 eitherMap on Right failed")
    testSuiteFailures = testSuiteFailures + 1
}
if (!isLeft(mappedLeft) or mappedLeft[1] != 500) {
    print("[FAIL] Test Case 2 eitherMap on Left must preserve error unchanged")
    testSuiteFailures = testSuiteFailures + 1
}

// MapLeft transforms Left, passes Right untouched
mapLeftRight = eitherMapLeft(baseRight, 1)
mapLeftLeft = eitherMapLeft(baseLeft, 1) // 500 + 10000 = 10500
if (!isRight(mapLeftRight) or mapLeftRight[1] != 10) {
    print("[FAIL] Test Case 2 eitherMapLeft on Right must preserve value unchanged")
    testSuiteFailures = testSuiteFailures + 1
}
if (!isLeft(mapLeftLeft) or mapLeftLeft[1] != 10500) {
    print("[FAIL] Test Case 2 eitherMapLeft on Left failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Bimap simultaneously specifies Left and Right handlers
bimapRight = eitherBimap(baseRight, 2, 3) // Right: 10^2 = 100
bimapLeft = eitherBimap(baseLeft, 2, 3)  // Left: 500 * 10 = 5000
if (!isRight(bimapRight) or bimapRight[1] != 100) {
    print("[FAIL] Test Case 2 eitherBimap on Right failed")
    testSuiteFailures = testSuiteFailures + 1
}
if (!isLeft(bimapLeft) or bimapLeft[1] != 5000) {
    print("[FAIL] Test Case 2 eitherBimap on Left failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Fold catamorphism
foldRightRes = eitherFold(baseRight, 1, 1) // Right: 10 + 1 = 11
foldLeftRes = eitherFold(baseLeft, 1, 1)  // Left: 500 + 10000 = 10500
if (foldRightRes != 11 or foldLeftRes != 10500) {
    print("[FAIL] Test Case 2 eitherFold resolution failed")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 2 Passed functor and bifunctor transformations")

// Test Case 3: Monadic Bind / FlatMap Chaining and Error Propagation
print("Running Test Case 3: Monadic Bind Chaining and Error Propagation...")

startVal = createRight(200)

// Chain 1: Success path: 200 -> range check (ok) -> even parity (ok: 100) -> balance ded (ok: 50)
stepA = eitherFlatMap(startVal, 2)
stepB = eitherFlatMap(stepA, 3)
stepC = eitherFlatMap(stepB, 4)

if (!isRight(stepC) or stepC[1] != 50) {
    print("[FAIL] Test Case 3 Multi-step flatMap success path failed: ", stepC[1])
    testSuiteFailures = testSuiteFailures + 1
}

// Chain 2: Short-circuit at step 1 (range violation with 5)
badStart = createRight(5)
failStepA = eitherFlatMap(badStart, 2) // returns Left(errOutOfRange)
failStepB = eitherFlatMap(failStepA, 3) // short-circuits
failStepC = eitherFlatMap(failStepB, 4) // short-circuits

if (!isLeft(failStepC) or failStepC[1] != errOutOfRange) {
    print("[FAIL] Test Case 3 Short-circuit at step 1 failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Chain 3: Short-circuit at step 2 (odd number 150 -> parity violation)
oddStart = createRight(150)
oddA = eitherFlatMap(oddStart, 2) // returns Right(150)
oddB = eitherFlatMap(oddA, 3)     // 150 / 2 = 75 (odd!), next flatMap fails
oddC = eitherFlatMap(oddB, 3)     // 75 is odd -> Left(errOddParity)
oddD = eitherFlatMap(oddC, 4)     // short-circuits

if (!isLeft(oddD) or oddD[1] != errOddParity) {
    print("[FAIL] Test Case 3 Short-circuit at step 2 parity failed")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 3 Passed monadic bind chaining and error propagation")

// Test Case 4: Deterministic Proof of Downstream Non-Execution
print("Running Test Case 4: Deterministic Proof of Downstream Non-Execution...")

// Subcase 4A: Full success path executes all 5 stages
resetStageHits()
resFull = runTrackedPipeline(15)
if (!isRight(resFull) or resFull[1] != 105) {
    print("[FAIL] Test Case 4A Full pipeline result mismatch: ", resFull[1])
