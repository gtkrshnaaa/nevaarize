// Test Case 6: Rigorous Mathematical Verification of Monad Laws
print("Running Test Case 6: Verification of Monad Laws...")

// Monad Law 1: Left Identity
// flatMap(createRight(a), f) == f(a)
law1Ok = true
testA = 100
law1Left = eitherFlatMap(createRight(testA), 1) // 100000 / 100 = 1000
law1Right = applyFlatTransform(1, testA)
if (law1Left[0] != law1Right[0] or law1Left[1] != law1Right[1]) {
    law1Ok = false
}

testA2 = 0 // division by zero
law1LeftZ = eitherFlatMap(createRight(testA2), 1)
law1RightZ = applyFlatTransform(1, testA2)
if (law1LeftZ[0] != law1RightZ[0] or law1LeftZ[1] != law1RightZ[1]) {
    law1Ok = false
}

if (!law1Ok) {
    print("[FAIL] Test Case 6 Monad Law 1 (Left Identity) violated")
    testSuiteFailures = testSuiteFailures + 1
}

// Monad Law 2: Right Identity
// flatMap(m, createRight) == m
// In our dispatch system, identity flatMap is opId 2 with a wide valid range
law2Ok = true
mRight = createRight(500)
mLeft = createLeft(errOutOfRange)

mRightRes = eitherFlatMap(mRight, 2) // returns Right(500)
mLeftRes = eitherFlatMap(mLeft, 2)   // returns Left(errOutOfRange)

if (mRightRes[0] != mRight[0] or mRightRes[1] != mRight[1]) {
    law2Ok = false
}
if (mLeftRes[0] != mLeft[0] or mLeftRes[1] != mLeft[1]) {
    law2Ok = false
}
if (!law2Ok) {
    print("[FAIL] Test Case 6 Monad Law 2 (Right Identity) violated")
    testSuiteFailures = testSuiteFailures + 1
}

// Monad Law 3: Associativity
// m.flatMap(f).flatMap(g) == m.flatMap(x => f(x).flatMap(g))
// Let f = opId 2 (range check [10, 10000]), g = opId 3 (even parity reduction)
law3Ok = true
testM1 = createRight(400)
assocInner1 = eitherFlatMap(testM1, 2)
assocL1 = eitherFlatMap(assocInner1, 3)

fRes = eitherFlatMap(testM1, 2)
assocR1 = eitherFlatMap(fRes, 3)

if (assocL1[0] != assocR1[0] or assocL1[1] != assocR1[1]) {
    print("[FAIL] Law 3 assoc1 mismatch: L=", assocL1[0], ":", assocL1[1], " R=", assocR1[0], ":", assocR1[1])
    law3Ok = false
}

// Associativity under early Left failure: testM2 = 5 (fails at f)
testM2 = createRight(5)
assocInner2 = eitherFlatMap(testM2, 2)
assocL2 = eitherFlatMap(assocInner2, 3)

fRes2 = eitherFlatMap(testM2, 2)
assocR2 = eitherFlatMap(fRes2, 3)

if (assocL2[0] != assocR2[0] or assocL2[1] != assocR2[1]) {
    print("[FAIL] Law 3 assoc2 mismatch: L=", assocL2[0], ":", assocL2[1], " R=", assocR2[0], ":", assocR2[1])
    law3Ok = false
}

if (!law3Ok) {
    print("[FAIL] Test Case 6 Monad Law 3 (Associativity) violated")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 6 Passed Monad Laws (Left Identity, Right Identity, Associativity)")

// Test Case 7: Applicative Sequence and Partitioning
print("Running Test Case 7: Applicative Sequence and Partitioning...")

// Sequence with all Rights
listAllRight = [createRight(10), createRight(20), createRight(30), createRight(40)]
seqAllRes = sequenceEithers(listAllRight)
if (!isRight(seqAllRes) or seqAllRes[1].size() != 4 or seqAllRes[1][2] != 30) {
    print("[FAIL] Test Case 7 sequenceEithers on all Rights failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Sequence with a Left at index 2
listWithLeft = [createRight(10), createRight(20), createLeft(errOutOfStock), createRight(40)]
seqLeftRes = sequenceEithers(listWithLeft)
if (!isLeft(seqLeftRes) or seqLeftRes[1] != errOutOfStock) {
    print("[FAIL] Test Case 7 sequenceEithers short-circuit on Left failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Partition mixed list
mixedList = [createRight(1), createLeft(101), createRight(2), createLeft(102), createRight(3)]
partitioned = partitionEithers(mixedList)
lefts = partitioned[0]
rights = partitioned[1]

if (lefts.size() != 2 or lefts[0] != 101 or lefts[1] != 102) {
    print("[FAIL] Test Case 7 partitionEithers Lefts mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
if (rights.size() != 3 or rights[0] != 1 or rights[1] != 2 or rights[2] != 3) {
    print("[FAIL] Test Case 7 partitionEithers Rights mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

// Fallback combinators (eitherOrElse, eitherAnd, eitherZip)
r1 = createRight(100)
r2 = createRight(200)
l1 = createLeft(errOutOfRange)
l2 = createLeft(errDivByZero)

if (eitherOrElse(r1, r2)[1] != 100 or eitherOrElse(l1, r2)[1] != 200 or eitherOrElse(l1, l2)[1] != errDivByZero) {
    print("[FAIL] Test Case 7 eitherOrElse mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
if (eitherAnd(r1, r2)[1] != 200 or eitherAnd(l1, r2)[1] != errOutOfRange) {
    print("[FAIL] Test Case 7 eitherAnd mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

zipped = eitherZip(r1, r2)
if (!isRight(zipped) or zipped[1][0] != 100 or zipped[1][1] != 200) {
    print("[FAIL] Test Case 7 eitherZip mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 7 Passed applicative sequence, partition, and recovery combinators")

// Test Case 8: High-Throughput Stress Benchmark (50,000 Iterations)
print("Running Test Case 8: High-Throughput Stress Benchmark (50,000 iterations)...")

benchStart = t.millis()
iter = 0
successCount = 0
errorCount = 0

while (iter < 50000) {
    // Generate order based on iteration index
    // Every 7th order has quantity 0 (fails at stage 1: errInvalidOrder)
    // Every 13th order has coupon 99 (fails at stage 3: errInvalidCoupon)
    // Every 23rd order has region 99 (fails at stage 4: errUnsupportedShippingRegion)
    // Others are completely valid orders
    qty = 2
    if (iter % 7 == 0) {
        qty = 0
    }
    coupon = 1
    if (iter % 13 == 0) {
        coupon = 99
    }
    region = 1
    if (iter % 23 == 0) {
        region = 99
    }

    testOrder = [qty, 50, 10, coupon, region, 200]
    checkoutRes = runCheckoutPipeline(testOrder)

    if (checkoutRes[0] == 1) {
        successCount = successCount + 1
    } else {
        errorCount = errorCount + 1
    }
    iter = iter + 1
}

benchDuration = t.millis() - benchStart

if (successCount + errorCount != 50000) {
    print("[FAIL] Test Case 8 Total iteration count mismatch: ", successCount + errorCount)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 8 Benchmark completed: 50,000 iterations in ", benchDuration, " ms")
print("  Successes: ", successCount, " | Short-circuits: ", errorCount)

// --- Final Suite Summary ---

suiteElapsedTime = t.millis() - suiteStartTime

if (testSuiteFailures == 0) {
    print("[PASS] Monadic Either/Result Suite executed successfully in ", suiteElapsedTime, " ms")
} else {
    print("[FAIL] Monadic Either/Result Suite encountered ", testSuiteFailures, " failures")
}
