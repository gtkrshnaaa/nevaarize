}
if (globalStageHits[0] != 1 or globalStageHits[1] != 0 or globalStageHits[2] != 0 or globalStageHits[3] != 0 or globalStageHits[4] != 0) {
    print("[FAIL] Test Case 4B Non-execution proof failed for Stage 1 short-circuit")
    testSuiteFailures = testSuiteFailures + 1
}

// Subcase 4C: Fail at stage 2 (val + 10 > 1000)
// initialVal = 1000 -> stage 1 produces 1010 -> stage 2 fails!
// Stages 3, 4, 5 must have 0 executions!
resetStageHits()
resFail2 = runTrackedPipeline(1000)
if (!isLeft(resFail2) or resFail2[1] != errOutOfRange) {
    print("[FAIL] Test Case 4C Stage 2 failure mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
if (globalStageHits[0] != 1 or globalStageHits[1] != 1 or globalStageHits[2] != 0 or globalStageHits[3] != 0 or globalStageHits[4] != 0) {
    print("[FAIL] Test Case 4C Non-execution proof failed for Stage 2 short-circuit")
    testSuiteFailures = testSuiteFailures + 1
}

// Subcase 4D: Fail at stage 3 (val % 3 == 0)
// initialVal = 5 -> stage 1: 15 -> stage 2: 30 -> stage 3 sees 30 % 3 == 0 -> fails!
// Stages 4, 5 must have 0 executions!
resetStageHits()
resFail3 = runTrackedPipeline(5)
if (!isLeft(resFail3) or resFail3[1] != errOddParity) {
    print("[FAIL] Test Case 4D Stage 3 failure mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
if (globalStageHits[0] != 1 or globalStageHits[1] != 1 or globalStageHits[2] != 1 or globalStageHits[3] != 0 or globalStageHits[4] != 0) {
    print("[FAIL] Test Case 4D Non-execution proof failed for Stage 3 short-circuit")
    testSuiteFailures = testSuiteFailures + 1
}

// Subcase 4E: Fail at stage 4 (val < 50)
// initialVal = 1 -> stage 1: 11 -> stage 2: 22 -> stage 3: 27 (fails at 3!)
// initialVal = 2 -> stage 1: 12 -> stage 2: 24 (fails at 3!)
// initialVal = 3 -> stage 1: 13 -> stage 2: 26 -> stage 3: 31 -> stage 4: 31 < 50 -> fails!
// Stage 5 must have 0 executions!
resetStageHits()
resFail4 = runTrackedPipeline(3)
if (!isLeft(resFail4) or resFail4[1] != errInsufficientBalance) {
    print("[FAIL] Test Case 4E Stage 4 failure mismatch")
    testSuiteFailures = testSuiteFailures + 1
}
if (globalStageHits[0] != 1 or globalStageHits[1] != 1 or globalStageHits[2] != 1 or globalStageHits[3] != 1 or globalStageHits[4] != 0) {
    print("[FAIL] Test Case 4E Non-execution proof failed for Stage 4 short-circuit")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 4 Passed deterministic proof of downstream non-execution")

