import stdlib time as t

// Persistent Binary Indexed Tree (Fenwick Tree) Suite
// Technical characteristics:
// - Functional persistence via node path copying in logarithmic time and space
// - Historical point updates, range sum, point queries, and prefix sum queries
// - Immutability preservation across historical versions and timeline rollbacks
// - Support for timeline forking, tree branching, and state restoration
// - Parallel arena allocation for cache locality and zero reference overhead
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Persistent Fenwick Tree Suite ===")
suiteStartTime = t.millis()

func lowbit(xVal) {
    return xVal & (0 - xVal)
}

func createPersistentFenwickTree() {
    treeLeft = []
    treeRight = []
    treeVal = []
    versionRoots = []
    versionParents = []
    versionDescriptions = []
    return [treeLeft, treeRight, treeVal, versionRoots, versionParents, versionDescriptions]
}

func allocNode(tree, leftChild, rightChild, val) {
    tLeft = tree[0]
    tRight = tree[1]
    tVal = tree[2]

    nodeId = tLeft.size()
    tLeft.push(leftChild)
    tRight.push(rightChild)
    tVal.push(val)

    tree[0] = tLeft
    tree[1] = tRight
    tree[2] = tVal
    return nodeId
}

func buildTreeFromBit(tree, bitValues, l, r) {
    if (l == r) {
        val = bitValues[l - 1]
        return allocNode(tree, -1, -1, val)
    }
    mid = (l + r) / 2
    lc = buildTreeFromBit(tree, bitValues, l, mid)
    rc = buildTreeFromBit(tree, bitValues, mid + 1, r)
    tVal = tree[2]
    nodeSum = tVal[lc] + tVal[rc]
    return allocNode(tree, lc, rc, nodeSum)
}

func initPersistentFenwickTree(tree, initialArray, treeSize, initialDesc) {
    pref = [0]
    i = 0
    while (i < treeSize) {
        nextSum = pref[i] + initialArray[i]
        pref.push(nextSum)
        i = i + 1
    }

    bitValues = []
    idx = 1
    while (idx <= treeSize) {
        lb = lowbit(idx)
        startIdx = idx - lb
        bVal = pref[idx] - pref[startIdx]
        bitValues.push(bVal)
        idx = idx + 1
    }

    rootId = buildTreeFromBit(tree, bitValues, 1, treeSize)

    vRoots = tree[3]
    vParents = tree[4]
    vDescs = tree[5]

    vRoots.push(rootId)
    vParents.push(-1)
    vDescs.push(initialDesc)

    tree[3] = vRoots
    tree[4] = vParents
    tree[5] = vDescs
    return 0
}

func getBucketVal(tree, node, l, r, targetIdx) {
    if (l == r) {
        tVal = tree[2]
        return tVal[node]
    }
    mid = (l + r) / 2
    tLeft = tree[0]
    tRight = tree[1]
    if (targetIdx <= mid) {
        return getBucketVal(tree, tLeft[node], l, mid, targetIdx)
    }
    return getBucketVal(tree, tRight[node], mid + 1, r, targetIdx)
}

func addBucketVal(tree, prevNode, l, r, targetIdx, delta) {
    if (l == r) {
        tVal = tree[2]
        newVal = tVal[prevNode] + delta
        return allocNode(tree, -1, -1, newVal)
    }
    mid = (l + r) / 2
    tLeft = tree[0]
    tRight = tree[1]
    if (targetIdx <= mid) {
        newLc = addBucketVal(tree, tLeft[prevNode], l, mid, targetIdx, delta)
        newRc = tRight[prevNode]
    } else {
        newLc = tLeft[prevNode]
        newRc = addBucketVal(tree, tRight[prevNode], mid + 1, r, targetIdx, delta)
    }
    tVal = tree[2]
    nodeSum = tVal[newLc] + tVal[newRc]
    return allocNode(tree, newLc, newRc, nodeSum)
}

func pointAdd(tree, baseVersion, idx, delta, desc, treeSize) {
    vRoots = tree[3]
    vParents = tree[4]
    vDescs = tree[5]

    currRoot = vRoots[baseVersion]
    curr = idx
    while (curr <= treeSize) {
        currRoot = addBucketVal(tree, currRoot, 1, treeSize, curr, delta)
        curr = curr + lowbit(curr)
    }

    newVersionId = vRoots.size()
    vRoots.push(currRoot)
    vParents.push(baseVersion)
    vDescs.push(desc)

    tree[3] = vRoots
    tree[4] = vParents
    tree[5] = vDescs
    return newVersionId
}

func queryPrefixSum(tree, version, idx, treeSize) {
    if (idx <= 0) {
        return 0
    }
    lim = idx
    if (lim > treeSize) {
        lim = treeSize
    }
    vRoots = tree[3]
    root = vRoots[version]
    totalSum = 0
    curr = lim
    while (curr > 0) {
        bucketVal = getBucketVal(tree, root, 1, treeSize, curr)
        totalSum = totalSum + bucketVal
        curr = curr - lowbit(curr)
    }
    return totalSum
}

func queryRangeSum(tree, version, l, r, treeSize) {
    if (l > r) {
        return 0
    }
    return queryPrefixSum(tree, version, r, treeSize) - queryPrefixSum(tree, version, l - 1, treeSize)
}

func queryPoint(tree, version, idx, treeSize) {
    if (idx <= 0 or idx > treeSize) {
        return 0
    }
    return queryRangeSum(tree, version, idx, idx, treeSize)
}

func pointSet(tree, baseVersion, idx, newVal, desc, treeSize) {
    currentVal = queryPoint(tree, baseVersion, idx, treeSize)
    delta = newVal - currentVal
    return pointAdd(tree, baseVersion, idx, delta, desc, treeSize)
}

func rollbackTo(tree, targetVersion, desc) {
    vRoots = tree[3]
    vParents = tree[4]
    vDescs = tree[5]

    targetRoot = vRoots[targetVersion]
    newVersionId = vRoots.size()
    vRoots.push(targetRoot)
    vParents.push(targetVersion)
    vDescs.push(desc)

    tree[3] = vRoots
    tree[4] = vParents
    tree[5] = vDescs
    return newVersionId
}

func lowerBound(tree, version, targetSum, treeSize) {
    low = 1
    high = treeSize
    ans = -1
    while (low <= high) {
        mid = (low + high) / 2
        pSum = queryPrefixSum(tree, version, mid, treeSize)
        if (pSum >= targetSum) {
            ans = mid
            high = mid - 1
        } else {
            low = mid + 1
        }
    }
    return ans
}

func getVersionCount(tree) {
    vRoots = tree[3]
    return vRoots.size()
}

func getVersionParent(tree, version) {
    vParents = tree[4]
    return vParents[version]
}

func getVersionDescription(tree, version) {
    vDescs = tree[5]
    return vDescs[version]
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Version Updates & Historical Prefix Sum Queries
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Version Updates and Range Queries...")
tc1Size = 8
tc1Init = [3, 2, -1, 6, 5, 4, -3, 3]
tc1Tree = createPersistentFenwickTree()
initPersistentFenwickTree(tc1Tree, tc1Init, tc1Size, "v0: baseline initialization")

v0Sum4 = queryPrefixSum(tc1Tree, 0, 4, tc1Size)
v0Sum8 = queryPrefixSum(tc1Tree, 0, 8, tc1Size)
v0Range3to6 = queryRangeSum(tc1Tree, 0, 3, 6, tc1Size)
v0Point3 = queryPoint(tc1Tree, 0, 3, tc1Size)

if (v0Sum4 != 10 or v0Sum8 != 19 or v0Range3to6 != 14 or v0Point3 != -1) {
    print("[FAIL] Test Case 1 Baseline v0 failed: sum4=", v0Sum4, ", sum8=", v0Sum8, ", range3to6=", v0Range3to6)
} else {
    print("  Version 0 baseline verified: prefix(4) = 10, prefix(8) = 19, range(3..6) = 14, point(3) = -1")
}

// Version 1: Add +5 to index 3 (was -1, now 4)
v1 = pointAdd(tc1Tree, 0, 3, 5, "v1: point add 5 to index 3", tc1Size)
v1Sum4 = queryPrefixSum(tc1Tree, 1, 4, tc1Size)
v1Sum8 = queryPrefixSum(tc1Tree, 1, 8, tc1Size)
v1Range3to6 = queryRangeSum(tc1Tree, 1, 3, 6, tc1Size)
v1Point3 = queryPoint(tc1Tree, 1, 3, tc1Size)

if (v1Sum4 != 15 or v1Sum8 != 24 or v1Range3to6 != 19 or v1Point3 != 4) {
    print("[FAIL] Test Case 1 Version 1 failed: sum4=", v1Sum4, ", range3to6=", v1Range3to6)
} else {
    print("  Version 1 verified: prefix(4) = 15, prefix(8) = 24, range(3..6) = 19, point(3) = 4")
}

// Verify v0 immutability after v1 creation
v0CheckSum4 = queryPrefixSum(tc1Tree, 0, 4, tc1Size)
v0CheckRange3to6 = queryRangeSum(tc1Tree, 0, 3, 6, tc1Size)
if (v0CheckSum4 != 10 or v0CheckRange3to6 != 14) {
    print("[FAIL] Version 0 immutability violated after Version 1 creation")
} else {
    print("  Version 0 immutability preserved after subsequent updates")
}

// Version 2: Add +10 to index 7 (was -3, now 7)
v2 = pointAdd(tc1Tree, 1, 7, 10, "v2: point add 10 to index 7", tc1Size)
v2Sum7 = queryPrefixSum(tc1Tree, 2, 7, tc1Size)
v2Sum8 = queryPrefixSum(tc1Tree, 2, 8, tc1Size)
v2Point7 = queryPoint(tc1Tree, 2, 7, tc1Size)

if (v2Sum7 != 31 or v2Sum8 != 34 or v2Point7 != 7) {
    print("[FAIL] Test Case 1 Version 2 failed: sum7=", v2Sum7, ", sum8=", v2Sum8)
} else {
    print("  Version 2 verified: prefix(7) = 31, prefix(8) = 34, point(7) = 7")
}

// Version 3: Point set index 1 to 10 (was 3, delta +7)
v3 = pointSet(tc1Tree, 2, 1, 10, "v3: point set index 1 to 10", tc1Size)
v3Sum1 = queryPrefixSum(tc1Tree, 3, 1, tc1Size)
v3Sum4 = queryPrefixSum(tc1Tree, 3, 4, tc1Size)
v3Sum8 = queryPrefixSum(tc1Tree, 3, 8, tc1Size)
v3Point1 = queryPoint(tc1Tree, 3, 1, tc1Size)

if (v3Sum1 != 10 or v3Sum4 != 22 or v3Sum8 != 41 or v3Point1 != 10) {
    print("[FAIL] Test Case 1 Version 3 failed: sum1=", v3Sum1, ", sum4=", v3Sum4, ", sum8=", v3Sum8)
} else {
    print("  Version 3 verified: prefix(1) = 10, prefix(4) = 22, prefix(8) = 41, point(1) = 10")
}

print("  Test Case 1 Passed sequential updates and immutability verification")


// -----------------------------------------------------------------------------
// Test Case 2: Timeline Forking and Tree Branching
// -----------------------------------------------------------------------------
print("Running Test Case 2: Timeline Forking and Tree Branching...")
// Fork Branch A from Version 1 (v1 has: [3, 2, 4, 6, 5, 4, -3, 3])
v4BranchA = pointAdd(tc1Tree, 1, 5, 20, "v4: Branch A add 20 to index 5", tc1Size)
// Fork Branch B from Version 1
v5BranchB = pointAdd(tc1Tree, 1, 2, -10, "v5: Branch B add -10 to index 2", tc1Size)
// Fork Branch C from Branch A (v4)
v6BranchC = pointAdd(tc1Tree, v4BranchA, 8, 100, "v6: Branch C add 100 to index 8", tc1Size)

// Verify Branch A: index 5 is 5 + 20 = 25. prefix(5) = 3 + 2 + 4 + 6 + 25 = 40. prefix(8) = 24 + 20 = 44.
v4Sum5 = queryPrefixSum(tc1Tree, v4BranchA, 5, tc1Size)
v4Sum8 = queryPrefixSum(tc1Tree, v4BranchA, 8, tc1Size)
v4Point5 = queryPoint(tc1Tree, v4BranchA, 5, tc1Size)

// Verify Branch B: index 2 is 2 - 10 = -8. prefix(4) = 3 - 8 + 4 + 6 = 5. prefix(8) = 24 - 10 = 14.
v5Sum4 = queryPrefixSum(tc1Tree, v5BranchB, 4, tc1Size)
v5Sum8 = queryPrefixSum(tc1Tree, v5BranchB, 8, tc1Size)
v5Point2 = queryPoint(tc1Tree, v5BranchB, 2, tc1Size)

// Verify Branch C: inherits Branch A (index 5 = 25) plus index 8 has +100 (was 3, now 103). prefix(8) = 44 + 100 = 144.
v6Sum5 = queryPrefixSum(tc1Tree, v6BranchC, 5, tc1Size)
v6Sum8 = queryPrefixSum(tc1Tree, v6BranchC, 8, tc1Size)
v6Point8 = queryPoint(tc1Tree, v6BranchC, 8, tc1Size)

// Verify Version 1 is still pristine: prefix(5) = 20, prefix(8) = 24.
v1CheckSum5 = queryPrefixSum(tc1Tree, 1, 5, tc1Size)
v1CheckSum8 = queryPrefixSum(tc1Tree, 1, 8, tc1Size)

if (v4Sum5 != 40 or v4Sum8 != 44 or v4Point5 != 25) {
    print("[FAIL] Test Case 2 Branch A failed: sum5=", v4Sum5, ", sum8=", v4Sum8)
}
if (v5Sum4 != 5 or v5Sum8 != 14 or v5Point2 != -8) {
    print("[FAIL] Test Case 2 Branch B failed: sum4=", v5Sum4, ", sum8=", v5Sum8)
}
if (v6Sum5 != 40 or v6Sum8 != 144 or v6Point8 != 103) {
    print("[FAIL] Test Case 2 Branch C failed: sum5=", v6Sum5, ", sum8=", v6Sum8)
}
if (v1CheckSum5 != 20 or v1CheckSum8 != 24) {
    print("[FAIL] Test Case 2 Parent Version 1 was corrupted during branching")
}
print("  Branch A (sum8: 44), Branch B (sum8: 14), and Branch C (sum8: 144) verified independently")
print("  Parent Version 1 remained pristine across timeline divergence")
print("  Test Case 2 Passed timeline forking verification")

// -----------------------------------------------------------------------------
// Test Case 3: Boundary and Edge Cases
// -----------------------------------------------------------------------------
print("Running Test Case 3: Boundary and Edge Cases...")

// 1. Single-element Fenwick Tree (size = 1)
singleSize = 1
singleTree = createPersistentFenwickTree()
initPersistentFenwickTree(singleTree, [42], singleSize, "single: baseline")
sV0Sum = queryPrefixSum(singleTree, 0, 1, singleSize)
sV0Point = queryPoint(singleTree, 0, 1, singleSize)
if (sV0Sum != 42 or sV0Point != 42) {
    print("[FAIL] Single-element tree v0 mismatch: sum=", sV0Sum)
}

sV1 = pointAdd(singleTree, 0, 1, 58, "single: add 58", singleSize)
sV1Sum = queryPrefixSum(singleTree, sV1, 1, singleSize)
sV1Point = queryPoint(singleTree, sV1, 1, singleSize)
sV0AfterSum = queryPrefixSum(singleTree, 0, 1, singleSize)
if (sV1Sum != 100 or sV1Point != 100 or sV0AfterSum != 42) {
    print("[FAIL] Single-element tree update failed: sV1Sum=", sV1Sum, ", sV0AfterSum=", sV0AfterSum)
} else {
    print("  Single-element tree update verified (42 -> 100, v0 preserved at 42)")
}

// 2. Two-element Fenwick Tree (size = 2)
twoSize = 2
twoTree = createPersistentFenwickTree()
initPersistentFenwickTree(twoTree, [15, 25], twoSize, "two: baseline")
tV0Sum1 = queryPrefixSum(twoTree, 0, 1, twoSize)
tV0Sum2 = queryPrefixSum(twoTree, 0, 2, twoSize)
tV1 = pointAdd(twoTree, 0, 2, -10, "two: add -10 to idx 2", twoSize)
tV1Sum2 = queryPrefixSum(twoTree, tV1, 2, twoSize)
if (tV0Sum1 != 15 or tV0Sum2 != 40 or tV1Sum2 != 30) {
    print("[FAIL] Two-element tree test failed")
} else {
    print("  Two-element tree verified: [15, 25] -> sum2 was 40, updated to 30")
}

// 3. Repeated updates to identical index across versions
repSize = 4
repTree = createPersistentFenwickTree()
initPersistentFenwickTree(repTree, [0, 0, 0, 0], repSize, "rep: zeros")
rV1 = pointAdd(repTree, 0, 3, 5, "rep: add 5 to idx 3", repSize)
rV2 = pointAdd(repTree, rV1, 3, 10, "rep: add 10 to idx 3", repSize)
rV3 = pointAdd(repTree, rV2, 3, -2, "rep: add -2 to idx 3", repSize)
rV4 = pointAdd(repTree, rV3, 3, 7, "rep: add 7 to idx 3", repSize)

rSumV1 = queryPoint(repTree, rV1, 3, repSize)
rSumV2 = queryPoint(repTree, rV2, 3, repSize)
rSumV3 = queryPoint(repTree, rV3, 3, repSize)
rSumV4 = queryPoint(repTree, rV4, 3, repSize)

if (rSumV1 != 5 or rSumV2 != 15 or rSumV3 != 13 or rSumV4 != 20) {
    print("[FAIL] Repeated updates to identical index failed: ", rSumV1, rSumV2, rSumV3, rSumV4)
} else {
    print("  Repeated updates to identical index verified across 4 versions (5 -> 15 -> 13 -> 20)")
}

// 4. Out-of-bounds and degenerate queries
oobSumZero = queryPrefixSum(tc1Tree, 0, 0, tc1Size)
oobSumNeg = queryPrefixSum(tc1Tree, 0, -5, tc1Size)
oobRangeInverted = queryRangeSum(tc1Tree, 0, 6, 2, tc1Size)
oobPointZero = queryPoint(tc1Tree, 0, 0, tc1Size)
oobPointOver = queryPoint(tc1Tree, 0, 99, tc1Size)

if (oobSumZero != 0 or oobSumNeg != 0 or oobRangeInverted != 0 or oobPointZero != 0 or oobPointOver != 0) {
    print("[FAIL] Degenerate/out-of-bounds queries did not return neutral zero")
} else {
    print("  Degenerate and out-of-bounds queries gracefully returned default neutral values")
}

// 5. Zero delta point addition
zeroDeltaVer = pointAdd(tc1Tree, 0, 4, 0, "zero delta update", tc1Size)
zeroSum4 = queryPrefixSum(tc1Tree, zeroDeltaVer, 4, tc1Size)
zeroSum8 = queryPrefixSum(tc1Tree, zeroDeltaVer, 8, tc1Size)
if (zeroSum4 != 10 or zeroSum8 != 19) {
    print("[FAIL] Zero delta update corrupted values")
} else {
    print("  Zero delta update verified without state mutation")
}

print("  Test Case 3 Passed boundary and edge case verification")

elapsed = t.millis() - suiteStartTime
print("[PASS] Persistent Fenwick Tree Milestone 2 executed in", elapsed, "ms")

