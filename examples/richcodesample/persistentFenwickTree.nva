// -----------------------------------------------------------------------------
// Test Case 5: Stress Benchmark against Naive Historical Matrix
// -----------------------------------------------------------------------------
print("Running Test Case 5: Stress Benchmark against Naive Historical Matrix...")
stressLen = 32
stressTree = createPersistentFenwickTree()
lSeed = 987654321

stressInit = []
initI = 0
while (initI < stressLen) {
    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    elemVal = (lSeed % 50) - 15
    stressInit.push(elemVal)
    initI = initI + 1
}

initPersistentFenwickTree(stressTree, stressInit, stressLen, "stress: root initialization")

naiveHistory = []
v0Clone = []
cI = 0
while (cI < stressLen) {
    v0Clone.push(stressInit[cI])
    cI = cI + 1
}
naiveHistory.push(v0Clone)

numStressVersions = 45
verIdx = 1
while (verIdx <= numStressVersions) {
    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    baseVer = lSeed % verIdx

    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    targetIdx = 1 + (lSeed % stressLen)

    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    deltaVal = (lSeed % 41) - 20

    newVer = pointAdd(stressTree, baseVer, targetIdx, deltaVal, "stress update", stressLen)

    baseClone = naiveHistory[baseVer]
    newClone = []
    copyIdx = 0
    while (copyIdx < stressLen) {
        valCur = baseClone[copyIdx]
        if (copyIdx == targetIdx - 1) {
            valCur = valCur + deltaVal
        }
        newClone.push(valCur)
        copyIdx = copyIdx + 1
    }
    naiveHistory.push(newClone)
    verIdx = verIdx + 1
}

numQueries = 150
qIdx = 0
stressErrors = 0

while (qIdx < numQueries) {
    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    chosenVer = lSeed % (numStressVersions + 1)

    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    qLeft = 1 + (lSeed % stressLen)

    lSeed = (lSeed * 1103515245 + 12345) % 2147483648
    qRight = 1 + (lSeed % stressLen)

    if (qLeft > qRight) {
        temp = qLeft
        qLeft = qRight
        qRight = temp
    }

    expectedPrefix = 0
    expectedRange = 0
    verArr = naiveHistory[chosenVer]

    scanI = 0
    while (scanI < qRight) {
        expectedPrefix = expectedPrefix + verArr[scanI]
        if (scanI >= qLeft - 1) {
            expectedRange = expectedRange + verArr[scanI]
        }
        scanI = scanI + 1
    }

    actPrefix = queryPrefixSum(stressTree, chosenVer, qRight, stressLen)
    actRange = queryRangeSum(stressTree, chosenVer, qLeft, qRight, stressLen)

    if (actPrefix != expectedPrefix or actRange != expectedRange) {
        stressErrors = stressErrors + 1
    }
    qIdx = qIdx + 1
}

if (stressErrors > 0) {
    print("[FAIL] Stress queries had", stressErrors, "mismatches against naive oracle")
} else {
    print("  Validated", numQueries, "random historical queries across", numStressVersions, "versions: 0 mismatches")
    tAlloc = stressTree[0]
    print("  Total allocated persistent tree arena nodes:", tAlloc.size())
    print("  Test Case 5 Passed stress benchmark verification")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] Persistent Fenwick Tree Suite executed successfully in", elapsed, "ms")


