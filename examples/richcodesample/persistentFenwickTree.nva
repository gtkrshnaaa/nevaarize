}

if (ans1 != 1 or ans2 != 2 or ans3 != 3 or ans4 != 4 or ans5 != 5 or ans6 != -1) {
    print("[FAIL] lower bound query on monotonic BIT failed: ", ans1, ans2, ans3, ans4, ans5, ans6)
} else {
    print("  Lower bound search verified across prefix thresholds: 1->idx 1, 6->idx 2, 7->idx 3, 20->idx 4, 25->idx 5, 31->none")
}

