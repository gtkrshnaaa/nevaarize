print("=== Sparse Array ===")
sparseIdx = [5, 20, 50, 99]
sparseVal = [42, 99, 7, 1]
sLen = 4
func sparseGet(sIdx, sVal, sL, index) {
    i = 0
    while (i < sL) {
        if (sIdx[i] == index) { return sVal[i] }
        i = i + 1
    }
    return 0
}
print("arr[5]:", sparseGet(sparseIdx, sparseVal, sLen, 5), "(expected: 42)")
print("arr[20]:", sparseGet(sparseIdx, sparseVal, sLen, 20), "(expected: 99)")
print("arr[0]:", sparseGet(sparseIdx, sparseVal, sLen, 0), "(expected: 0)")
total = 0
i = 0
while (i < sLen) { total = total + sparseVal[i]
i = i + 1 }
print("Sum:", total, "(expected: 149)")
aIdx = [1, 3, 5]
aVal = [2, 4, 6]
bIdx = [2, 3, 5]
bVal = [3, 5, 7]
dot = 0
ai = 0
while (ai < 3) {
    bi = 0
    while (bi < 3) {
        if (aIdx[ai] == bIdx[bi]) { dot = dot + aVal[ai] * bVal[bi] }
        bi = bi + 1
    }
    ai = ai + 1
}
print("Dot:", dot, "(expected: 62)")
print("Sparse array finished.")
