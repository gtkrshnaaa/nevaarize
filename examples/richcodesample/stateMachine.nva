import stdlib time as t

// Finite State Machine (FSM)
// Simple string pattern validator to demonstrate state-based logic.
// Validates a simplified identifier format: starts with letter, then letters/digits.

print("=== Nevaarize Finite State Machine ===")
print("Identifier Validator\n")

start = t.millis()

// Character encoding: letters = 65-90 (A-Z), 97-122 (a-z), digits = 48-57 (0-9)

// Test 1: "abc" (97,98,99) -> valid identifier
chars1 = [97, 98, 99]
st = 0
idx = 0
while (idx < 3) {
    code = chars1[idx]
    if (st == 0) {
        if (code >= 65 and code <= 90) { st = 1 }
        if (code >= 97 and code <= 122) { st = 1 }
        if (st == 0) { st = 9 }
    }
    if (st == 1) {
        if (code >= 65 and code <= 90) { st = 1 }
        if (code >= 97 and code <= 122) { st = 1 }
        if (code >= 48 and code <= 57) { st = 1 }
    }
    idx = idx + 1
}
v1 = 0
if (st == 1) { v1 = 1 }
print("abc -> valid:", v1, "(expected: 1)")

// Test 2: "x1y" (120,49,121) -> valid
chars2 = [120, 49, 121]
st = 0
idx = 0
while (idx < 3) {
    code = chars2[idx]
    if (st == 0) {
        if (code >= 65 and code <= 90) { st = 1 }
        if (code >= 97 and code <= 122) { st = 1 }
        if (st == 0) { st = 9 }
    }
    if (st == 1) {
        if (code >= 65 and code <= 90) { st = 1 }
        if (code >= 97 and code <= 122) { st = 1 }
        if (code >= 48 and code <= 57) { st = 1 }
    }
    idx = idx + 1
}
v2 = 0
if (st == 1) { v2 = 1 }
print("x1y -> valid:", v2, "(expected: 1)")

// Test 3: "123" (49,50,51) -> invalid (starts with digit)
chars3 = [49, 50, 51]
st = 0
idx = 0
while (idx < 3) {
    code = chars3[idx]
    if (st == 0) {
        if (code >= 65 and code <= 90) { st = 1 }
        if (code >= 97 and code <= 122) { st = 1 }
        if (st == 0) { st = 9 }
    }
    idx = idx + 1
}
v3 = 0
if (st == 1) { v3 = 1 }
print("123 -> valid:", v3, "(expected: 0)")

// Test 4: "A" (65) -> valid (single letter)
chars4 = [65]
st = 0
code = chars4[0]
if (code >= 65 and code <= 90) { st = 1 }
if (code >= 97 and code <= 122) { st = 1 }
v4 = 0
if (st == 1) { v4 = 1 }
print("A -> valid:", v4, "(expected: 1)")

// Test 5: " " (32) -> invalid (space)
chars5 = [32]
st = 0
code = chars5[0]
if (code >= 65 and code <= 90) { st = 1 }
if (code >= 97 and code <= 122) { st = 1 }
if (st == 0) { st = 9 }
v5 = 0
if (st == 1) { v5 = 1 }
print("(space) -> valid:", v5, "(expected: 0)")

// Test 6: "camelCase" -> valid
chars6 = [99, 97, 109, 101, 108, 67, 97, 115, 101]
st = 0
idx = 0
while (idx < 9) {
    code = chars6[idx]
    if (st == 0) {
        if (code >= 65 and code <= 90) { st = 1 }
        if (code >= 97 and code <= 122) { st = 1 }
        if (st == 0) { st = 9 }
    }
    if (st == 1) {
        if (code >= 65 and code <= 90) { st = 1 }
        if (code >= 97 and code <= 122) { st = 1 }
        if (code >= 48 and code <= 57) { st = 1 }
    }
    idx = idx + 1
}
v6 = 0
if (st == 1) { v6 = 1 }
print("camelCase -> valid:", v6, "(expected: 1)")

elapsed = t.millis() - start
print("\nAll 6 tests completed in", elapsed, "ms")
print("State machine demo finished.")
