import stdlib time as t

// Finite State Machine (FSM) - Identifier Validator
// Validates identifier format: must start with letter, then letters or digits.
// Uses nested if blocks instead of `and` operator for JIT compatibility.

func isLetter(c) {
    if (c >= 65) {
        if (c <= 90) { return 1 }
    }
    if (c >= 97) {
        if (c <= 122) { return 1 }
    }
    return 0
}

func isDigit(c) {
    if (c >= 48) {
        if (c <= 57) { return 1 }
    }
    return 0
}

print("=== Nevaarize Finite State Machine ===")
print("Identifier Validator\n")

start = t.millis()

// Test 1: "abc" (97,98,99) -> valid
chars1 = [97, 98, 99]
v1 = isLetter(chars1[0])
if (v1 == 1) {
    ci = 1
    while (ci < 3) {
        ch = chars1[ci]
        ok = isLetter(ch)
        if (ok == 0) {
            ok = isDigit(ch)
        }
        if (ok == 0) { v1 = 0 }
        ci = ci + 1
    }
}
print("abc -> valid:", v1, "(expected: 1)")

// Test 2: "x1y" (120,49,121) -> valid
chars2 = [120, 49, 121]
v2 = isLetter(chars2[0])
if (v2 == 1) {
    ci = 1
    while (ci < 3) {
        ch = chars2[ci]
        ok = isLetter(ch)
        if (ok == 0) { ok = isDigit(ch) }
        if (ok == 0) { v2 = 0 }
        ci = ci + 1
    }
}
print("x1y -> valid:", v2, "(expected: 1)")

// Test 3: "123" (49,50,51) -> invalid
chars3 = [49, 50, 51]
v3 = isLetter(chars3[0])
print("123 -> valid:", v3, "(expected: 0)")

// Test 4: "A" (65) -> valid
chars4 = [65]
v4 = isLetter(chars4[0])
print("A -> valid:", v4, "(expected: 1)")

// Test 5: " " (32) -> invalid
chars5 = [32]
v5 = isLetter(chars5[0])
print("(space) -> valid:", v5, "(expected: 0)")

// Test 6: "camelCase"
chars6 = [99, 97, 109, 101, 108, 67, 97, 115, 101]
v6 = isLetter(chars6[0])
if (v6 == 1) {
    ci = 1
    while (ci < 9) {
        ch = chars6[ci]
        ok = isLetter(ch)
        if (ok == 0) { ok = isDigit(ch) }
        if (ok == 0) { v6 = 0 }
        ci = ci + 1
    }
}
print("camelCase -> valid:", v6, "(expected: 1)")

// Test 7: "a b" (97,32,98) -> invalid (space in middle)
chars7 = [97, 32, 98]
v7 = isLetter(chars7[0])
if (v7 == 1) {
    ci = 1
    while (ci < 3) {
        ch = chars7[ci]
        ok = isLetter(ch)
        if (ok == 0) { ok = isDigit(ch) }
        if (ok == 0) { v7 = 0 }
        ci = ci + 1
    }
}
print("a b -> valid:", v7, "(expected: 0)")

// Test 8: "Z9" (90,57) -> valid
chars8 = [90, 57]
v8 = isLetter(chars8[0])
if (v8 == 1) {
    ci = 1
    while (ci < 2) {
        ch = chars8[ci]
        ok = isLetter(ch)
        if (ok == 0) { ok = isDigit(ch) }
        if (ok == 0) { v8 = 0 }
        ci = ci + 1
    }
}
print("Z9 -> valid:", v8, "(expected: 1)")

elapsed = t.millis() - start
print("\nAll 8 tests completed in", elapsed, "ms")
print("State machine demo finished.")
