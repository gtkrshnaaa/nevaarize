import stdlib time as t

// Matrix Multiplication Column-Major Cache Miss Suite
// Technical characteristics:
// - Hardware memory access patterns & cache line prefetcher stress:
//   * IKJ Loop Order: Cache-optimal row-major vector accumulation with stride-1 prefetching
//   * IJK Loop Order: Dot-product loop with column-major strided cache line misses on matrix B
//   * JIK / KJI Loop Orders: Column-major write thrashing testing cache eviction penalty
//   * Transposed Cache Optimization: Transposing B to convert column reads into contiguous stride-1 reads
//   * Tiled / Blocked Matmul: Cache blocking (B x B sub-matrices) fitting inside CPU L1 cache
// - Algebraic property validation:
//   * Mathematical equivalence: C_IJK == C_IKJ == C_KIJ == C_Transposed == C_Blocked
//   * Identity matrix invariance: A x I == A and I x A == A
//   * Transpose of product isomorphism: (A x B)^T == B^T x A^T
//   * Associativity: (A x B) x C == A x (B x C)
// - Dimension flexibility: Square (N x N), Rectangular (M x K by K x N), and Degenerate (1 x N, N x 1)
// - High-throughput comparative benchmark on large matrices measuring execution time and cache penalties
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero external dependencies, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Matrix Multiplication Column-Major Cache Miss Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Core Matrix Primitives ---

func createMatrix(numRows, numCols, defaultVal) {
    totalElements = numRows * numCols
    createdData = []
    cIdx = 0
    while (cIdx < totalElements) {
        createdData.push(defaultVal)
        cIdx = cIdx + 1
    }
    return [numRows, numCols, createdData]
}

func getMat(mat, r, c) {
    cols = mat[1]
    data = mat[2]
    return data[r * cols + c]
}

func setMat(mat, r, c, val) {
    cols = mat[1]
    data = mat[2]
    data[r * cols + c] = val
}

func fillFormulaMatrix(fRows, fCols, seedMultiplier) {
    fMat = createMatrix(fRows, fCols, 0)
    fData = fMat[2]
    fr = 0
    while (fr < fRows) {
        fc = 0
        while (fc < fCols) {
            fVal = ((fr + 1) * seedMultiplier + (fc + 1) * 31) % 1009
            fData[fr * fCols + fc] = fVal
            fc = fc + 1
        }
        fr = fr + 1
    }
    return fMat
}

func computeMatrixChecksum(mat) {
    data = mat[2]
    n = data.size()
    chk = 0
    i = 0
    while (i < n) {
        chk = (chk + data[i] * (i + 1)) % 1000000007
        i = i + 1
    }
    return chk
}

func areMatricesEqual(matA, matB) {
    if (matA[0] != matB[0] or matA[1] != matB[1]) {
        return 0
    }
    dataA = matA[2]
    dataB = matB[2]
    n = dataA.size()
    i = 0
    while (i < n) {
        if (dataA[i] != dataB[i]) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// --- Matrix Multiplication Implementations Across Loop Orderings ---

// 1. IJK Loop Order: Dot Product (Column-major strided reads on B)
func matmulIJK(matA, matB) {
    rowsA = matA[0]
    colsA = matA[1]
    dataA = matA[2]
    rowsB = matB[0]
    colsB = matB[1]
    dataB = matB[2]

    outMat = createMatrix(rowsA, colsB, 0)
    dataOut = outMat[2]

    i = 0
    while (i < rowsA) {
        rowAOffset = i * colsA
        rowOutOffset = i * colsB
        j = 0
        while (j < colsB) {
            sum = 0
            k = 0
            while (k < colsA) {
                sum = (sum + dataA[rowAOffset + k] * dataB[k * colsB + j]) % 1000000007
                k = k + 1
            }
            dataOut[rowOutOffset + j] = sum
            j = j + 1
        }
        i = i + 1
    }
    return outMat
}

// 2. IKJ Loop Order: Row-major vector accumulation (Stride-1 access on B and Out)
func matmulIKJ(matA, matB) {
    rowsA = matA[0]
    colsA = matA[1]
    dataA = matA[2]
    rowsB = matB[0]
    colsB = matB[1]
    dataB = matB[2]

    outMat = createMatrix(rowsA, colsB, 0)
    dataOut = outMat[2]

    i = 0
    while (i < rowsA) {
        rowAOffset = i * colsA
        rowOutOffset = i * colsB
        k = 0
        while (k < colsA) {
            aElem = dataA[rowAOffset + k]
            if (aElem != 0) {
                rowBOffset = k * colsB
                j = 0
                while (j < colsB) {
                    currOut = dataOut[rowOutOffset + j]
                    dataOut[rowOutOffset + j] = (currOut + aElem * dataB[rowBOffset + j]) % 1000000007
                    j = j + 1
                }
            }
            k = k + 1
        }
        i = i + 1
    }
    return outMat
}

// 3. KIJ Loop Order: Outer K loop (Contiguous inner stride-1 access)
func matmulKIJ(matA, matB) {
    rowsA = matA[0]
    colsA = matA[1]
    dataA = matA[2]
    rowsB = matB[0]
    colsB = matB[1]
    dataB = matB[2]

    outMat = createMatrix(rowsA, colsB, 0)
    dataOut = outMat[2]

    k = 0
    while (k < colsA) {
        rowBOffset = k * colsB
        i = 0
        while (i < rowsA) {
            aElem = dataA[i * colsA + k]
            if (aElem != 0) {
                rowOutOffset = i * colsB
                j = 0
                while (j < colsB) {
                    currOut = dataOut[rowOutOffset + j]
                    dataOut[rowOutOffset + j] = (currOut + aElem * dataB[rowBOffset + j]) % 1000000007
                    j = j + 1
                }
            }
            i = i + 1
        }
        k = k + 1
    }
    return outMat
}

func transposeMatrix(sourceMat) {
    srcRows = sourceMat[0]
    srcCols = sourceMat[1]
    srcData = sourceMat[2]

    transMat = createMatrix(srcCols, srcRows, 0)
    transData = transMat[2]

    tr = 0
    while (tr < srcRows) {
        tc = 0
        while (tc < srcCols) {
            transData[tc * srcRows + tr] = srcData[tr * srcCols + tc]
            tc = tc + 1
        }
        tr = tr + 1
    }
    return transMat
}

// 4. Transposed B matmul (Both A and B^T read with contiguous stride-1 access)
func matmulTransposed(firstMat, secondMat) {
    firstRows = firstMat[0]
    firstCols = firstMat[1]
    firstData = firstMat[2]
    secondRows = secondMat[0]
    secondCols = secondMat[1]

    secondTrans = transposeMatrix(secondMat)
    secondTransData = secondTrans[2]

    resultMat = createMatrix(firstRows, secondCols, 0)
    resultData = resultMat[2]

    mti = 0
    while (mti < firstRows) {
        firstRowOffset = mti * firstCols
        resRowOffset = mti * secondCols
        mtj = 0
        while (mtj < secondCols) {
            secRowOffset = mtj * firstCols
            sumVal = 0
            mtk = 0
            while (mtk < firstCols) {
                sumVal = (sumVal + firstData[firstRowOffset + mtk] * secondTransData[secRowOffset + mtk]) % 1000000007
                mtk = mtk + 1
            }
            resultData[resRowOffset + mtj] = sumVal
            mtj = mtj + 1
        }
        mti = mti + 1
    }
    return resultMat
}

// 5. Blocked / Tiled Matmul (Sub-matrix tiles fitting inside cache)
func matmulBlocked(bMatA, bMatB, blockSize) {
    bRowsA = bMatA[0]
    bColsA = bMatA[1]
    bDataA = bMatA[2]
    bRowsB = bMatB[0]
    bColsB = bMatB[1]
    bDataB = bMatB[2]

    bOutMat = createMatrix(bRowsA, bColsB, 0)
    bDataOut = bOutMat[2]

    bi0 = 0
    while (bi0 < bRowsA) {
        biMax = bi0 + blockSize
        if (biMax > bRowsA) {
            biMax = bRowsA
        }

        bk0 = 0
        while (bk0 < bColsA) {
            bkMax = bk0 + blockSize
            if (bkMax > bColsA) {
                bkMax = bColsA
            }

            bj0 = 0
            while (bj0 < bColsB) {
                bjMax = bj0 + blockSize
                if (bjMax > bColsB) {
                    bjMax = bColsB
                }

                // Inner tile IKJ traversal
                bi = bi0
                while (bi < biMax) {
                    bRowAOff = bi * bColsA
                    bRowOutOff = bi * bColsB
                    bk = bk0
                    while (bk < bkMax) {
                        baElem = bDataA[bRowAOff + bk]
                        if (baElem != 0) {
                            bRowBOff = bk * bColsB
                            bj = bj0
                            while (bj < bjMax) {
                                bCurrOut = bDataOut[bRowOutOff + bj]
                                bDataOut[bRowOutOff + bj] = (bCurrOut + baElem * bDataB[bRowBOff + bj]) % 1000000007
                                bj = bj + 1
                            }
                        }
                        bk = bk + 1
                    }
                    bi = bi + 1
                }

                bj0 = bj0 + blockSize
            }
            bk0 = bk0 + blockSize
        }
        bi0 = bi0 + blockSize
    }
    return bOutMat
}

// --- Test Case 1: Mathematical Parity Across Loop Orderings (IJK vs IKJ vs KIJ) ---

print("--- Running Test Case 1: Mathematical Parity Across Loop Orderings ---")

testDim = 24
matrixA24 = fillFormulaMatrix(testDim, testDim, 17)
matrixB24 = fillFormulaMatrix(testDim, testDim, 43)

resIJK = matmulIJK(matrixA24, matrixB24)
resIKJ = matmulIKJ(matrixA24, matrixB24)
resKIJ = matmulKIJ(matrixA24, matrixB24)

chkIJK = computeMatrixChecksum(resIJK)
chkIKJ = computeMatrixChecksum(resIKJ)
chkKIJ = computeMatrixChecksum(resKIJ)

if (chkIJK != chkIKJ or chkIKJ != chkKIJ) {
    print("[FAIL] Test Case 1 Checksum mismatch: IJK=", chkIJK, " IKJ=", chkIKJ, " KIJ=", chkKIJ)
    testSuiteFailures = testSuiteFailures + 1
}

if (areMatricesEqual(resIJK, resIKJ) != 1 or areMatricesEqual(resIKJ, resKIJ) != 1) {
    print("[FAIL] Test Case 1 Element-by-element matrix parity mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

print("  24x24 Square Matrices Checksum: ", chkIKJ, " (IJK == IKJ == KIJ parity: 100%)")
print("  Test Case 1 Passed Mathematical Parity Across Loop Orderings")

// --- Test Case 2: Transposed & Blocked Cache Optimization Equivalence ---

print("--- Running Test Case 2: Transposed & Blocked Cache Optimization Equivalence ---")

testDim32 = 32
matrixA32 = fillFormulaMatrix(testDim32, testDim32, 29)
matrixB32 = fillFormulaMatrix(testDim32, testDim32, 53)

resIKJ32 = matmulIKJ(matrixA32, matrixB32)
resTransposed32 = matmulTransposed(matrixA32, matrixB32)
resBlocked4 = matmulBlocked(matrixA32, matrixB32, 4)
resBlocked8 = matmulBlocked(matrixA32, matrixB32, 8)

chkIKJ32 = computeMatrixChecksum(resIKJ32)
chkTransposed32 = computeMatrixChecksum(resTransposed32)
chkBlocked4 = computeMatrixChecksum(resBlocked4)
chkBlocked8 = computeMatrixChecksum(resBlocked8)

if (chkIKJ32 != chkTransposed32 or chkIKJ32 != chkBlocked4 or chkIKJ32 != chkBlocked8) {
    print("[FAIL] Test Case 2 Checksum mismatch: IKJ=", chkIKJ32, " Transposed=", chkTransposed32, " Block4=", chkBlocked4, " Block8=", chkBlocked8)
    testSuiteFailures = testSuiteFailures + 1
}

if (areMatricesEqual(resIKJ32, resTransposed32) != 1 or areMatricesEqual(resIKJ32, resBlocked4) != 1 or areMatricesEqual(resIKJ32, resBlocked8) != 1) {
    print("[FAIL] Test Case 2 Matrix parity mismatch among Transposed and Blocked algorithms")
    testSuiteFailures = testSuiteFailures + 1
}

print("  32x32 Square Matrices Checksum: ", chkIKJ32, " (Transposed and Blocked parity: 100%)")
print("  Test Case 2 Passed Transposed & Blocked Cache Optimization Equivalence")

// --- Test Case 3: Non-Square Rectangular & Degenerate Dimensions ---

print("--- Running Test Case 3: Non-Square Rectangular & Degenerate Dimensions ---")

// 3.1 Rectangular: 12 x 20 multiplied by 20 x 16 -> 12 x 16
rectA = fillFormulaMatrix(12, 20, 11)
rectB = fillFormulaMatrix(20, 16, 23)
rectOutIKJ = matmulIKJ(rectA, rectB)
rectOutTrans = matmulTransposed(rectA, rectB)
if (rectOutIKJ[0] != 12 or rectOutIKJ[1] != 16 or areMatricesEqual(rectOutIKJ, rectOutTrans) != 1) {
    print("[FAIL] Test Case 3 Rectangular 12x20 by 20x16 failed")
    testSuiteFailures = testSuiteFailures + 1
}

// 3.2 Row Vector x Column Vector (Dot Product): 1 x 32 by 32 x 1 -> 1 x 1
rowVec = fillFormulaMatrix(1, 32, 7)
colVec = fillFormulaMatrix(32, 1, 13)
dotOutIKJ = matmulIKJ(rowVec, colVec)
dotOutTrans = matmulTransposed(rowVec, colVec)
if (dotOutIKJ[0] != 1 or dotOutIKJ[1] != 1 or areMatricesEqual(dotOutIKJ, dotOutTrans) != 1) {
    print("[FAIL] Test Case 3 Dot Product 1x32 by 32x1 failed")
    testSuiteFailures = testSuiteFailures + 1
}

// 3.3 Column Vector x Row Vector (Outer Product): 16 x 1 by 1 x 16 -> 16 x 16
outerCol = fillFormulaMatrix(16, 1, 19)
outerRow = fillFormulaMatrix(1, 16, 37)
outerOutIKJ = matmulIKJ(outerCol, outerRow)
outerOutTrans = matmulTransposed(outerCol, outerRow)
if (outerOutIKJ[0] != 16 or outerOutIKJ[1] != 16 or areMatricesEqual(outerOutIKJ, outerOutTrans) != 1) {
    print("[FAIL] Test Case 3 Outer Product 16x1 by 1x16 failed")
    testSuiteFailures = testSuiteFailures + 1
}

print("  Non-square dimensions verified (Rectangular 12x16, Dot Product 1x1, Outer Product 16x16)")
print("  Test Case 3 Passed Non-Square Rectangular & Degenerate Dimensions")

elapsedStage2 = t.millis() - suiteStartTime
if (testSuiteFailures != 0) {
    print("[FAIL] Stage 2 encountered failures: ", testSuiteFailures)
} else {
    print("  Stage 2 completed in ", elapsedStage2, " ms")
}
