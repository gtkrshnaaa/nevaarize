import stdlib time as t

// Ephemeral Meldable Leftist Heap Priority Queue Suite
// Technical characteristics:
// - Leftist tree property: dist(left) >= dist(right) at every node
// - Null Path Length (NPL / dist / s-value): shortest distance from node to null descendant
// - Logarithmic right spine length: rightSpine <= floor(log2(size + 1))
// - In-place O(log N) meld operation by right-spine merging and child swapping
// - Priority queue operations: insert O(log N), extractMin O(log N), findMin O(1)
// - Subtree size tracking and multi-heap tournament meld support
// - Flat parallel array arena allocation for high cache locality
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Leftist Heap Meldable Priority Queue Suite ===")
suiteStartTime = t.millis()

func createLeftistHeapArena() {
    hKey = []
    hVal = []
    hLeft = []
    hRight = []
    hDist = []
    hSize = []
    return [hKey, hVal, hLeft, hRight, hDist, hSize]
}

func allocHeapNode(arena, key, val) {
    aKey = arena[0]
    aVal = arena[1]
    aLeft = arena[2]
    aRight = arena[3]
    aDist = arena[4]
    aSize = arena[5]

    nodeId = aKey.size()
    aKey.push(key)
    aVal.push(val)
    aLeft.push(-1)
    aRight.push(-1)
    aDist.push(1)
    aSize.push(1)

    arena[0] = aKey
    arena[1] = aVal
    arena[2] = aLeft
    arena[3] = aRight
    arena[4] = aDist
    arena[5] = aSize
    return nodeId
}

func getHeapSize(arena, root) {
    if (root == -1) {
        return 0
    }
    aSize = arena[5]
    return aSize[root]
}

func getHeapDist(arena, root) {
    if (root == -1) {
        return 0
    }
    aDist = arena[4]
    return aDist[root]
}

func isEmptyHeap(root) {
    return root == -1
}

func meldHeaps(arena, h1, h2) {
    if (h1 == -1) {
        return h2
    }
    if (h2 == -1) {
        return h1
    }

    mhKey = arena[0]
    mhLeft = arena[2]
    mhRight = arena[3]
    mhDist = arena[4]
    mhSize = arena[5]

    // Phase 1: Merge right spines of h1 and h2
    mhPath = []
    mhP1 = h1
    mhP2 = h2
    while (mhP1 != -1 and mhP2 != -1) {
        if (mhKey[mhP1] <= mhKey[mhP2]) {
            mhPath.push(mhP1)
            mhP1 = mhRight[mhP1]
        } else {
            mhPath.push(mhP2)
            mhP2 = mhRight[mhP2]
        }
    }

    mhLast = mhP1
    if (mhP1 == -1) {
        mhLast = mhP2
    }

    // Phase 2: Walk backwards up mhPath, enforcing leftist invariant and updating sizes
    mhIdx = mhPath.size() - 1
    while (mhIdx >= 0) {
        mhCur = mhPath[mhIdx]
        mhRight[mhCur] = mhLast

        mhL = mhLeft[mhCur]
        mhR = mhRight[mhCur]

        mhLDist = 0
        mhLSize = 0
        if (mhL != -1) {
            mhLDist = mhDist[mhL]
            mhLSize = mhSize[mhL]
        }

        mhRDist = 0
        mhRSize = 0
        if (mhR != -1) {
            mhRDist = mhDist[mhR]
            mhRSize = mhSize[mhR]
        }

        if (mhLDist < mhRDist) {
            // Swap left and right children
            mhLeft[mhCur] = mhR
            mhRight[mhCur] = mhL
            mhTmpDist = mhLDist
            mhLDist = mhRDist
            mhRDist = mhTmpDist
            mhTmpSize = mhLSize
            mhLSize = mhRSize
            mhRSize = mhTmpSize
        }

        mhDist[mhCur] = mhRDist + 1
        mhSize[mhCur] = mhLSize + mhRSize + 1
        mhLast = mhCur
        mhIdx = mhIdx - 1
    }
    return mhLast
}

func insertElement(arena, root, key, val) {
    newNode = allocHeapNode(arena, key, val)
    return meldHeaps(arena, root, newNode)
}

func findMin(arena, root) {
    if (root == -1) {
        return [-1, -1]
    }
    fKey = arena[0]
    fVal = arena[1]
    return [fKey[root], fVal[root]]
}

func extractMin(arena, root) {
    if (root == -1) {
        return [-1, -1, -1]
    }
    eKey = arena[0]
    eVal = arena[1]
    eLeft = arena[2]
    eRight = arena[3]

    minKey = eKey[root]
    minVal = eVal[root]
    leftChild = eLeft[root]
    rightChild = eRight[root]

    newRoot = meldHeaps(arena, leftChild, rightChild)
    return [minKey, minVal, newRoot]
}

func verifyLeftistInvariants(arena, root) {
    if (root == -1) {
        return 1
    }

    vKey = arena[0]
    vLeft = arena[2]
    vRight = arena[3]
    vDist = arena[4]
    vSize = arena[5]

    vStack = [root]
    while (vStack.size() > 0) {
        curr = vStack.pop()
        cKey = vKey[curr]
        cL = vLeft[curr]
        cR = vRight[curr]
        cD = vDist[curr]
        cS = vSize[curr]

        cLDist = 0
        cLSize = 0
        if (cL != -1) {
            if (vKey[cL] < cKey) {
                print("[FAIL] Min-heap property violated: parent=", cKey, ", leftChild=", vKey[cL])
                return 0
            }
            cLDist = vDist[cL]
            cLSize = vSize[cL]
            vStack.push(cL)
        }

        cRDist = 0
        cRSize = 0
        if (cR != -1) {
            if (vKey[cR] < cKey) {
                print("[FAIL] Min-heap property violated: parent=", cKey, ", rightChild=", vKey[cR])
                return 0
            }
            cRDist = vDist[cR]
            cRSize = vSize[cR]
            vStack.push(cR)
        }

        // Leftist invariant: dist(left) >= dist(right)
        if (cLDist < cRDist) {
            print("[FAIL] Leftist property violated at node=", curr, ": leftDist=", cLDist, ", rightDist=", cRDist)
            return 0
        }

        // Dist invariant: dist(curr) == 1 + dist(right)
        if (cD != cRDist + 1) {
            print("[FAIL] Dist invariant violated at node=", curr, ": dist=", cD, ", expected=", cRDist + 1)
            return 0
        }

        // Size invariant: size(curr) == 1 + size(left) + size(right)
        if (cS != cLSize + cRSize + 1) {
            print("[FAIL] Subtree size invariant violated at node=", curr, ": size=", cS, ", expected=", cLSize + cRSize + 1)
            return 0
        }
    }
    return 1
}

func getRightSpineLength(arena, root) {
    spineLen = 0
    curr = root
    rRight = arena[3]
    while (curr != -1) {
        spineLen = spineLen + 1
        curr = rRight[curr]
    }
    return spineLen
}

// -----------------------------------------------------------------------------
// Test Case 1: Core Priority Queue Operations & Invariant Validation
// -----------------------------------------------------------------------------
print("Running Test Case 1: Core Priority Queue Operations and Invariant Validation...")
arena1 = createLeftistHeapArena()
root1 = -1

if (isEmptyHeap(root1) == 0 or getHeapSize(arena1, root1) != 0 or getHeapDist(arena1, root1) != 0) {
    print("[FAIL] Initial empty heap checks failed")
} else {
    print("  Empty heap verified: size 0, dist 0, isEmpty true")
}

// Insert sequence of elements
testKeys1 = [42, 17, 89, 5, 23, 71, 12, 64, 38, 9, 55, 3, 91, 28, 47]
tc1I = 0
while (tc1I < testKeys1.size()) {
    k = testKeys1[tc1I]
    payload = k * 10
    root1 = insertElement(arena1, root1, k, payload)
    if (verifyLeftistInvariants(arena1, root1) != 1) {
        print("[FAIL] Leftist invariants violated after inserting key=", k)
    }
    tc1I = tc1I + 1
}

expectedTotal1 = testKeys1.size()
if (getHeapSize(arena1, root1) != expectedTotal1) {
    print("[FAIL] Heap size mismatch after insertions: expected=", expectedTotal1, ", got=", getHeapSize(arena1, root1))
} else {
    print("  Inserted 15 elements: heap size confirmed at 15 with valid leftist invariants")
}

minPair1 = findMin(arena1, root1)
if (minPair1[0] != 3 or minPair1[1] != 30) {
    print("[FAIL] findMin returned incorrect min: expected [3, 30], got=", minPair1)
} else {
    print("  findMin correctly identified global minimum [key: 3, val: 30]")
}

// Sequentially extract minimums and verify sorted order
extracted1 = []
prevKey1 = -999999
tc1ExtractFail = 0

while (root1 != -1) {
    minInfo = extractMin(arena1, root1)
    extractedKey = minInfo[0]
    extractedVal = minInfo[1]
    root1 = minInfo[2]

    if (extractedKey < prevKey1) {
        print("[FAIL] Inversion detected in extractMin: prev=", prevKey1, ", cur=", extractedKey)
        tc1ExtractFail = 1
    }
    prevKey1 = extractedKey
    extracted1.push(extractedKey)

    if (root1 != -1) {
        if (verifyLeftistInvariants(arena1, root1) != 1) {
            print("[FAIL] Invariant violated during extractMin cycle")
            tc1ExtractFail = 1
        }
    }
}

if (tc1ExtractFail == 0 and extracted1.size() == expectedTotal1) {
    print("  Sequential extractMin successfully yielded 15 keys in strictly ascending sorted order")
    print("  Sorted sequence verified: [3, 5, 9, 12, 17, 23, 28, 38, 42, 47, 55, 64, 71, 89, 91]")
    print("  Test Case 1 Passed core priority queue operations and invariant validation")
} else {
    print("[FAIL] Test Case 1 extraction validation failed")
}

// -----------------------------------------------------------------------------
// Test Case 2: Logarithmic Meld Operation on Distinct Priority Queues
// -----------------------------------------------------------------------------
print("Running Test Case 2: Logarithmic Meld Operation on Distinct Priority Queues...")
arena2 = createLeftistHeapArena()
tc2RootA = -1
tc2RootB = -1

// Even keys for Heap A
evenKeys = [2, 6, 10, 14, 18, 22, 26, 30]
tc2I = 0
while (tc2I < evenKeys.size()) {
    k = evenKeys[tc2I]
    tc2RootA = insertElement(arena2, tc2RootA, k, 1000 + k)
    tc2I = tc2I + 1
}

// Odd keys for Heap B
oddKeys = [1, 5, 9, 13, 17, 21, 25, 29]
tc2J = 0
while (tc2J < oddKeys.size()) {
    k = oddKeys[tc2J]
    tc2RootB = insertElement(arena2, tc2RootB, k, 2000 + k)
    tc2J = tc2J + 1
}

if (getHeapSize(arena2, tc2RootA) != 8 or getHeapSize(arena2, tc2RootB) != 8) {
    print("[FAIL] Heap A or Heap B size mismatch before meld")
} else {
    print("  Heap A (size 8, min 2) and Heap B (size 8, min 1) constructed successfully")
}

invA = verifyLeftistInvariants(arena2, tc2RootA)
invB = verifyLeftistInvariants(arena2, tc2RootB)
if (invA != 1 or invB != 1) {
    print("[FAIL] Pre-meld invariants check failed: invA=", invA, ", invB=", invB)
}

// Perform logarithmic meld of Heap A and Heap B
tc2RootC = meldHeaps(arena2, tc2RootA, tc2RootB)
invC = verifyLeftistInvariants(arena2, tc2RootC)
sizeC = getHeapSize(arena2, tc2RootC)
spineC = getRightSpineLength(arena2, tc2RootC)

if (invC != 1 or sizeC != 16 or spineC > 4) {
    print("[FAIL] Merged Heap C invariant check failed: invC=", invC, ", size=", sizeC, ", spine=", spineC)
} else {
    print("  Merged Heap C verified: size 16, right spine length", spineC, "<= 4, leftist invariants intact")
}

// Extract all 16 elements and assert strictly interleaved sorted order
expectedMeldSequence = [1, 2, 5, 6, 9, 10, 13, 14, 17, 18, 21, 22, 25, 26, 29, 30]
extractedMeldKeys = []
tc2MeldFail = 0

while (tc2RootC != -1) {
    minInfoC = extractMin(arena2, tc2RootC)
    extractedKeyC = minInfoC[0]
    extractedValC = minInfoC[1]
    tc2RootC = minInfoC[2]
    extractedMeldKeys.push(extractedKeyC)

    if (tc2RootC != -1) {
        if (verifyLeftistInvariants(arena2, tc2RootC) != 1) {
            print("[FAIL] Merged heap invariant violated during sequential extraction")
            tc2MeldFail = 1
        }
    }
}

if (extractedMeldKeys.size() != 16) {
    print("[FAIL] Extracted count mismatch from merged heap: got=", extractedMeldKeys.size(), ", expected=16")
    tc2MeldFail = 1
}

tc2K = 0
while (tc2K < 16) {
    if (extractedMeldKeys[tc2K] != expectedMeldSequence[tc2K]) {
        print("[FAIL] Mismatch at index", tc2K, ": got=", extractedMeldKeys[tc2K], ", expected=", expectedMeldSequence[tc2K])
        tc2MeldFail = 1
    }
    tc2K = tc2K + 1
}

if (tc2MeldFail == 0) {
    print("  Extracted 16 keys in exact sorted interleaved order: [1, 2, 5, 6, ..., 29, 30]")
    print("  Test Case 2 Passed logarithmic meld operation verification")
} else {
    print("[FAIL] Test Case 2 logarithmic meld validation failed")
}

// -----------------------------------------------------------------------------
// Test Case 3: Boundary Edge Cases, Duplicates, and Extreme Keys
// -----------------------------------------------------------------------------
print("Running Test Case 3: Boundary Edge Cases, Duplicates, and Extreme Keys...")
arena3 = createLeftistHeapArena()

// 1. Meld identity with empty heaps
dummyRoot = insertElement(arena3, -1, 42, 420)
m1 = meldHeaps(arena3, dummyRoot, -1)
m2 = meldHeaps(arena3, -1, dummyRoot)
m3 = meldHeaps(arena3, -1, -1)
if (m1 != dummyRoot or m2 != dummyRoot or m3 != -1) {
    print("[FAIL] Empty heap meld identity properties failed")
} else {
    print("  Empty heap meld identity verified: meld(H, -1) == H, meld(-1, H) == H, meld(-1, -1) == -1")
}

// 2. Single-element heap
singleRoot = insertElement(arena3, -1, 777, 7770)
if (getHeapSize(arena3, singleRoot) != 1 or getHeapDist(arena3, singleRoot) != 1) {
    print("[FAIL] Single-element heap initialization failed")
}
singleExtracted = extractMin(arena3, singleRoot)
if (singleExtracted[0] != 777 or singleExtracted[1] != 7770 or singleExtracted[2] != -1) {
    print("[FAIL] Single-element heap extractMin failed: ", singleExtracted)
} else {
    print("  Single-element heap verified: key 777 extracted, clean transition to empty root -1")
}

// 3. Degenerate empty extraction
emptyExtracted = extractMin(arena3, -1)
if (emptyExtracted[0] != -1 or emptyExtracted[1] != -1 or emptyExtracted[2] != -1) {
    print("[FAIL] Empty heap extraction failed to return graceful default [-1, -1, -1]")
} else {
    print("  Empty heap extractMin gracefully returned [-1, -1, -1]")
}

// 4. Duplicate keys
dupKeys = [42, 10, 42, 99, 10, 42, 10, 99, 42]
dupRoot = -1
tc3DI = 0
while (tc3DI < dupKeys.size()) {
    dupRoot = insertElement(arena3, dupRoot, dupKeys[tc3DI], tc3DI)
    tc3DI = tc3DI + 1
}

if (getHeapSize(arena3, dupRoot) != 9) {
    print("[FAIL] Duplicate keys heap size mismatch: ", getHeapSize(arena3, dupRoot))
}

dupExtracted = []
while (dupRoot != -1) {
    dInfo = extractMin(arena3, dupRoot)
    dupExtracted.push(dInfo[0])
    dupRoot = dInfo[2]
}

expectedDupSequence = [10, 10, 10, 42, 42, 42, 42, 99, 99]
dupMatch = 1
tc3DJ = 0
while (tc3DJ < 9) {
    if (dupExtracted[tc3DJ] != expectedDupSequence[tc3DJ]) {
        dupMatch = 0
    }
    tc3DJ = tc3DJ + 1
}

if (dupMatch == 1 and dupExtracted.size() == 9) {
    print("  Duplicate keys verified: 9 elements extracted in non-decreasing order [10, 10, 10, 42, 42, 42, 42, 99, 99]")
} else {
    print("[FAIL] Duplicate keys extraction mismatch: ", dupExtracted)
}

// 5. Negative and zero keys
negKeys = [-100, 15, -45, 0, 80, -3]
negRoot = -1
tc3NI = 0
while (tc3NI < negKeys.size()) {
    negRoot = insertElement(arena3, negRoot, negKeys[tc3NI], tc3NI)
    tc3NI = tc3NI + 1
}

negExtracted = []
while (negRoot != -1) {
    nInfo = extractMin(arena3, negRoot)
    negExtracted.push(nInfo[0])
    negRoot = nInfo[2]
}

expectedNegSequence = [-100, -45, -3, 0, 15, 80]
negMatch = 1
tc3NJ = 0
while (tc3NJ < 6) {
    if (negExtracted[tc3NJ] != expectedNegSequence[tc3NJ]) {
        negMatch = 0
    }
    tc3NJ = tc3NJ + 1
}

if (negMatch == 1 and negExtracted.size() == 6) {
    print("  Negative and zero keys verified: extracted in sorted order [-100, -45, -3, 0, 15, 80]")
    print("  Test Case 3 Passed boundary edge cases, duplicates, and extreme keys verification")
} else {
    print("[FAIL] Negative keys extraction mismatch: ", negExtracted)
}

// -----------------------------------------------------------------------------
// Multi-Heap Tournament Meld Function
// -----------------------------------------------------------------------------
func multiMeld(arena, heapRoots) {
    if (heapRoots.size() == 0) {
        return -1
    }
    mmQueue = []
    mmI = 0
    while (mmI < heapRoots.size()) {
        if (heapRoots[mmI] != -1) {
            mmQueue.push(heapRoots[mmI])
        }
        mmI = mmI + 1
    }
    if (mmQueue.size() == 0) {
        return -1
    }

    // Pairwise reduction (tournament reduction)
    while (mmQueue.size() > 1) {
        nextQueue = []
        mmPairIdx = 0
        while (mmPairIdx < mmQueue.size()) {
            if (mmPairIdx + 1 < mmQueue.size()) {
                mergedPair = meldHeaps(arena, mmQueue[mmPairIdx], mmQueue[mmPairIdx + 1])
                nextQueue.push(mergedPair)
                mmPairIdx = mmPairIdx + 2
            } else {
                nextQueue.push(mmQueue[mmPairIdx])
                mmPairIdx = mmPairIdx + 1
            }
        }
        mmQueue = nextQueue
    }
    return mmQueue[0]
}

// -----------------------------------------------------------------------------
// Test Case 4: Multi-Heap Meld (Tournament Reduction)
// -----------------------------------------------------------------------------
print("Running Test Case 4: Multi-Heap Tournament Meld across Multiple Channels...")
arena4 = createLeftistHeapArena()
channelCount = 8
channelRoots = []
elementsPerChannel = 5
totalExpectedTasks = channelCount * elementsPerChannel

chIdx = 0
while (chIdx < channelCount) {
    curChanRoot = -1
    eIdx = 0
    while (eIdx < elementsPerChannel) {
        taskKey = (chIdx * 10) + ((eIdx * 7 + 3) % 10)
        taskPayload = (chIdx * 100) + eIdx
        curChanRoot = insertElement(arena4, curChanRoot, taskKey, taskPayload)
        eIdx = eIdx + 1
    }
    if (getHeapSize(arena4, curChanRoot) != elementsPerChannel or verifyLeftistInvariants(arena4, curChanRoot) != 1) {
        print("[FAIL] Channel heap initialization failed for channel=", chIdx)
    }
    channelRoots.push(curChanRoot)
    chIdx = chIdx + 1
}

print("  Initialized 8 independent priority queue channels with 5 elements each")

unifiedRoot = multiMeld(arena4, channelRoots)
unifiedSize = getHeapSize(arena4, unifiedRoot)
unifiedInv = verifyLeftistInvariants(arena4, unifiedRoot)
unifiedSpine = getRightSpineLength(arena4, unifiedRoot)

if (unifiedSize != totalExpectedTasks or unifiedInv != 1 or unifiedSpine > 5) {
    print("[FAIL] Tournament multiMeld failed: size=", unifiedSize, ", inv=", unifiedInv, ", spine=", unifiedSpine)
} else {
    print("  Unified heap verified: size 40, right spine length", unifiedSpine, "<= 5, leftist invariants intact")
}

// Drain the unified queue and verify monotonically non-decreasing sorted order
tc4ExtractedCount = 0
tc4PrevKey = -999999
tc4SortFail = 0

while (unifiedRoot != -1) {
    uInfo = extractMin(arena4, unifiedRoot)
    uKey = uInfo[0]
    unifiedRoot = uInfo[2]

    if (uKey < tc4PrevKey) {
        print("[FAIL] Priority inversion in unified multiMeld queue: prev=", tc4PrevKey, ", cur=", uKey)
        tc4SortFail = 1
    }
    tc4PrevKey = uKey
    tc4ExtractedCount = tc4ExtractedCount + 1
}

if (tc4SortFail == 0 and tc4ExtractedCount == totalExpectedTasks) {
    print("  Extracted all 40 elements from unified tournament queue in verified sorted priority order")
    print("  Test Case 4 Passed multi-heap tournament meld verification")
} else {
    print("[FAIL] Test Case 4 tournament extraction validation failed: count=", tc4ExtractedCount)
}

// -----------------------------------------------------------------------------
// Test Case 5: Randomized Stress Benchmark against Naive Priority Queue Oracle
// -----------------------------------------------------------------------------
print("Running Test Case 5: Randomized Stress Benchmark against Naive Priority Queue Oracle...")
arena5 = createLeftistHeapArena()

// 3 active heaps and corresponding naive oracle arrays
activeHeaps = [-1, -1, -1]
oracleLists = [[], [], []]

stressSeed = 987654321
stressOps = 250
stressOpI = 0
stressMismatches = 0
totalInserts = 0
totalExtracts = 0
totalMelds = 0

while (stressOpI < stressOps) {
    stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
    opType = stressSeed % 3

    if (opType == 0) {
        // Operation 0: Insert random key into random active heap
        stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
        targetQueue = stressSeed % 3
        stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
        randKey = (stressSeed % 2000) - 500
        randVal = randKey * 3

        activeHeaps[targetQueue] = insertElement(arena5, activeHeaps[targetQueue], randKey, randVal)
        oracleLists[targetQueue].push(randKey)
        totalInserts = totalInserts + 1
    }

    if (opType == 1) {
        // Operation 1: ExtractMin from random active heap
        stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
        targetQueue = stressSeed % 3
        curH = activeHeaps[targetQueue]

        if (curH != -1) {
            hMinInfo = extractMin(arena5, curH)
            hMinKey = hMinInfo[0]
            activeHeaps[targetQueue] = hMinInfo[2]

            // Naive oracle extractMin: find min in oracleLists[targetQueue]
            oList = oracleLists[targetQueue]
            minIdx = 0
            bestMin = oList[0]
            scanI = 1
            while (scanI < oList.size()) {
                if (oList[scanI] < bestMin) {
                    bestMin = oList[scanI]
                    minIdx = scanI
                }
                scanI = scanI + 1
            }

            // Remove bestMin from oracle list by shift
            newOList = []
            scanJ = 0
            while (scanJ < oList.size()) {
                if (scanJ != minIdx) {
                    newOList.push(oList[scanJ])
                }
                scanJ = scanJ + 1
            }
            oracleLists[targetQueue] = newOList

            if (hMinKey != bestMin) {
                print("[FAIL] Stress mismatch: heapMin=", hMinKey, ", oracleMin=", bestMin)
                stressMismatches = stressMismatches + 1
            }
            totalExtracts = totalExtracts + 1
        }
    }

    if (opType == 2) {
        // Operation 2: Meld two distinct active heaps
        stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
        hIdxA = stressSeed % 3
        hIdxB = (hIdxA + 1 + (stressSeed % 2)) % 3

        if (activeHeaps[hIdxB] != -1) {
            activeHeaps[hIdxA] = meldHeaps(arena5, activeHeaps[hIdxA], activeHeaps[hIdxB])
            activeHeaps[hIdxB] = -1

            // Merge oracle lists
            listA = oracleLists[hIdxA]
            listB = oracleLists[hIdxB]
            copyI = 0
            while (copyI < listB.size()) {
                listA.push(listB[copyI])
                copyI = copyI + 1
            }
            oracleLists[hIdxA] = listA
            oracleLists[hIdxB] = []
            totalMelds = totalMelds + 1
        }
    }

    stressOpI = stressOpI + 1
}

// Drain remaining elements from all active queues and verify complete oracle consistency
qScan = 0
while (qScan < 3) {
    remH = activeHeaps[qScan]
    remO = oracleLists[qScan]
    if (remH != -1) {
        if (verifyLeftistInvariants(arena5, remH) != 1) {
            print("[FAIL] Final active heap invariant check failed on queue=", qScan)
            stressMismatches = stressMismatches + 1
        }
    }

    while (remH != -1) {
        finInfo = extractMin(arena5, remH)
        finKey = finInfo[0]
        remH = finInfo[2]

        // Find min in remO
        minIdx = 0
        bestMin = remO[0]
        scanI = 1
        while (scanI < remO.size()) {
            if (remO[scanI] < bestMin) {
                bestMin = remO[scanI]
                minIdx = scanI
            }
            scanI = scanI + 1
        }

        newRemO = []
        scanJ = 0
        while (scanJ < remO.size()) {
            if (scanJ != minIdx) {
                newRemO.push(remO[scanJ])
            }
            scanJ = scanJ + 1
        }
        remO = newRemO

        if (finKey != bestMin) {
            print("[FAIL] Final drain mismatch on queue", qScan, ": heap=", finKey, ", oracle=", bestMin)
            stressMismatches = stressMismatches + 1
        }
    }

    if (remO.size() != 0) {
        print("[FAIL] Oracle list was not completely drained on queue=", qScan)
        stressMismatches = stressMismatches + 1
    }

    qScan = qScan + 1
}

if (stressMismatches == 0) {
    print("  Executed", stressOps, "randomized operations (", totalInserts, "inserts,", totalExtracts, "extracts,", totalMelds, "melds): 0 mismatches")
    print("  All active priority queues matched naive reference oracle with 100% precision")
    print("  Test Case 5 Passed randomized stress benchmark verification")
} else {
    print("[FAIL] Stress benchmark encountered", stressMismatches, "mismatches")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] Leftist Heap Meldable Priority Queue Suite executed successfully in", elapsed, "ms")
