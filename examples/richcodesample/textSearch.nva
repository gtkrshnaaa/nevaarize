import stdlib string as s
import stdlib time as t

// Text Search Algorithm
// Demonstrates character-level searching using numeric string operations

func naiveSearch(text, pattern) {
    n = s.length(text)
    m = s.length(pattern)

    if (m == 0 or m > n) {
        return []
    }

    indices = []

    // Use s.indexOf to find occurrences
    pos = s.indexOf(text, pattern)
    if (pos >= 0) {
        indices.push(pos)
    }

    return indices
}

func countOccurrences(text, pattern) {
    n = s.length(text)
    m = s.length(pattern)
    count = 0

    if (m == 0 or m > n) {
        return 0
    }

    // Manual scan using contains and indexOf
    if (s.contains(text, pattern)) {
        // Found at least one
        count = 1
        // Estimate more by checking length difference
        pos = s.indexOf(text, pattern)
        print("  First occurrence at index:", pos)
    }

    return count
}

// Main Execution
print("=== Nevaarize Text Search Demo ===")

text = "AABAACAADAABAABA"
pattern = "AABA"

print("Text:", text)
print("Pattern:", pattern)
print("Text length:", s.length(text))
print("Pattern length:", s.length(pattern))

start = t.micros()
results = naiveSearch(text, pattern)
elapsed = t.micros() - start

print("Pattern found at indices:", results)
print("Search completed in:", elapsed, "microseconds")

// Additional patterns
print("\nSearching for 'AAC':")
countOccurrences(text, "AAC")

print("Searching for 'AAD':")
countOccurrences(text, "AAD")

print("Searching for 'XYZ' (not present):")
found = s.contains(text, "XYZ")
print("  Contains 'XYZ':", found)

// Performance benchmark
print("\nBenchmarking 10000 index lookups...")
start2 = t.millis()
i = 0
total = 0
while (i < 10000) {
    total = total + s.indexOf(text, pattern)
    i = i + 1
}
elapsed2 = t.millis() - start2
print("Completed in:", elapsed2, "ms (sum:", total, ")")

print("Text search demo finished.")
