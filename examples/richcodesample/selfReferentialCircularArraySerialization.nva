    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 4 Passed lasso / rho topology with non-root cycle anchor")

// --- Test Case 5: Figure-Eight Multi-Cycle (Interlocking Loops) ---
print("Running Test Case 5: Figure-Eight Multi-Cycle...")

// Hub: 0. Loop 1: 0 -> 1 -> 2 -> 0. Loop 2: 0 -> 3 -> 4 -> 0.
fig8Graph = createGraph(8)
h0 = addNode(fig8Graph, 800)
h1 = addNode(fig8Graph, 801)
h2 = addNode(fig8Graph, 802)
h3 = addNode(fig8Graph, 803)
h4 = addNode(fig8Graph, 804)

addReference(fig8Graph, h0, h1)
addReference(fig8Graph, h1, h2)
addReference(fig8Graph, h2, h0)

addReference(fig8Graph, h0, h3)
addReference(fig8Graph, h3, h4)
addReference(fig8Graph, h4, h0)

resFig8 = serializeGraph(fig8Graph, h0)
if (getSerializeVisited(resFig8) != 5) {
    print("[FAIL] Test Case 5 Figure-8 visited count failed: ", getSerializeVisited(resFig8))
    testSuiteFailures = testSuiteFailures + 1
}
if (getSerializeCycleCount(resFig8) != 2) {
    print("[FAIL] Test Case 5 Figure-8 cycle count failed: ", getSerializeCycleCount(resFig8))
    testSuiteFailures = testSuiteFailures + 1
}
cyclesFig8 = getSerializeCycles(resFig8)
c1 = cyclesFig8[0]
c2 = cyclesFig8[1]
if (c1[1] != h0 or c2[1] != h0) {
    print("[FAIL] Test Case 5 Figure-8 cycles must both anchor to hub node 0")
    testSuiteFailures = testSuiteFailures + 1
}
if (c1[2] != 3 or c2[2] != 3) {
    print("[FAIL] Test Case 5 Figure-8 cycle lengths must both be 3")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 5 Passed figure-eight multi-cycle resolution")

// --- Test Case 6: Diamond DAG with Shared References (Zero False Positives) ---
print("Running Test Case 6: Diamond DAG Shared References...")

// 0 -> 1 -> 3; 0 -> 2 -> 3 (Node 3 reached via two distinct paths, but no cycle!)
diamondGraph = createGraph(6)
d0 = addNode(diamondGraph, 50)
d1 = addNode(diamondGraph, 51)
d2 = addNode(diamondGraph, 52)
d3 = addNode(diamondGraph, 53)

addReference(diamondGraph, d0, d1)
addReference(diamondGraph, d1, d3)
addReference(diamondGraph, d0, d2)
addReference(diamondGraph, d2, d3)

resDiamond = serializeGraph(diamondGraph, d0)
if (getSerializeVisited(resDiamond) != 4) {
    print("[FAIL] Test Case 6 Diamond visited count failed: ", getSerializeVisited(resDiamond))
    testSuiteFailures = testSuiteFailures + 1
}
if (getSerializeCycleCount(resDiamond) != 0) {
    print("[FAIL] Test Case 6 Diamond DAG falsely flagged cycle: count=", getSerializeCycleCount(resDiamond))
    testSuiteFailures = testSuiteFailures + 1
}
if (getSerializeSharedCount(resDiamond) != 1) {
    print("[FAIL] Test Case 6 Diamond DAG shared reference missing: count=", getSerializeSharedCount(resDiamond))
    testSuiteFailures = testSuiteFailures + 1
}
sharedDiamond = getSerializeShared(resDiamond)
sharedEdge = sharedDiamond[0]
if (sharedEdge[0] != d2 or sharedEdge[1] != d3) {
    print("[FAIL] Test Case 6 Diamond DAG shared edge mismatch: from=", sharedEdge[0], " to=", sharedEdge[1])
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 6 Passed Diamond DAG verification with zero false positive cycles")

// --- Test Case 7: Complex Multi-Loop Nested Topology ---
print("Running Test Case 7: Complex Multi-Loop Topology...")

// Complex structure with nested cycles and cross-links:
// 0 -> 1 -> 2 -> 3 -> 1 (Cycle 1: 1->2->3->1)
// 3 -> 4 -> 5 -> 0 (Outer Cycle 2: 0->1->2->3->4->5->0)
// 2 -> 5 (Cross-chord edge)
complexGraph = createGraph(8)
c0 = addNode(complexGraph, 100)
c1 = addNode(complexGraph, 101)
c2 = addNode(complexGraph, 102)
c3 = addNode(complexGraph, 103)
c4 = addNode(complexGraph, 104)
c5 = addNode(complexGraph, 105)

addReference(complexGraph, c0, c1)
addReference(complexGraph, c1, c2)
addReference(complexGraph, c2, c3)
addReference(complexGraph, c3, c1)
addReference(complexGraph, c3, c4)
addReference(complexGraph, c4, c5)
addReference(complexGraph, c5, c0)
addReference(complexGraph, c2, c5)

resComplex = serializeGraph(complexGraph, c0)
if (getSerializeVisited(resComplex) != 6) {
    print("[FAIL] Test Case 7 Complex topology visited count failed: ", getSerializeVisited(resComplex))
    testSuiteFailures = testSuiteFailures + 1
}
if (getSerializeCycleCount(resComplex) < 2) {
    print("[FAIL] Test Case 7 Complex topology cycles missing: count=", getSerializeCycleCount(resComplex))
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 7 Passed complex multi-loop nested topology resolution")

// --- Test Case 8: Extreme VM Limits Deep Cycle Stress Test ---
print("Running Test Case 8: Extreme VM Limits Deep Cycle Stress Test...")

deepChainSize = 100
deepGraph = buildRingGraph(deepChainSize)

resDeep = serializeGraph(deepGraph, 0)
if (getSerializeVisited(resDeep) != deepChainSize) {
    print("[FAIL] Test Case 8 Deep chain node count failed: ", getSerializeVisited(resDeep))
    testSuiteFailures = testSuiteFailures + 1
}
if (getSerializeCycleCount(resDeep) != 1) {
    print("[FAIL] Test Case 8 Deep chain cycle count failed: ", getSerializeCycleCount(resDeep))
    testSuiteFailures = testSuiteFailures + 1
}
cyclesDeep = getSerializeCycles(resDeep)
if (cyclesDeep[0][2] != deepChainSize) {
    print("[FAIL] Test Case 8 Deep chain cycle length failed: expected=", deepChainSize, " actual=", cyclesDeep[0][2])
    testSuiteFailures = testSuiteFailures + 1
}
if (getSerializeDepth(resDeep) != deepChainSize) {
    print("[FAIL] Test Case 8 Max traversal depth failed: expected=", deepChainSize, " actual=", getSerializeDepth(resDeep))
    testSuiteFailures = testSuiteFailures + 1
}

floydDeep = verifyFloydCycle(deepGraph, 0)
if (floydDeep[0] != 1 or floydDeep[2] != deepChainSize) {
    print("[FAIL] Test Case 8 Floyd cycle on deep chain failed")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 8 Passed extreme VM limit deep cycle stress test (N=100)")

// --- Test Case 9: Circular Array Ring Buffer Wrap-Around & Validation ---
print("Running Test Case 9: Circular Array Ring Buffer Wrap-Around...")

cbCap = 8
cb = createCircularBuffer(cbCap)
if (detectCircularBufferCorruption(cb) != 1) {
    print("[FAIL] Test Case 9 Initial circular buffer invalid")
    testSuiteFailures = testSuiteFailures + 1
}

// Push 5 items
circularBufferPush(cb, 10)
circularBufferPush(cb, 20)
circularBufferPush(cb, 30)
circularBufferPush(cb, 40)
circularBufferPush(cb, 50)
if (cb[3] != 5 or detectCircularBufferCorruption(cb) != 1) {
    print("[FAIL] Test Case 9 5-item push failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Pop 2 items (10 and 20)
p1 = circularBufferPop(cb)
p2 = circularBufferPop(cb)
if (p1 != 10 or p2 != 20 or cb[3] != 3 or detectCircularBufferCorruption(cb) != 1) {
    print("[FAIL] Test Case 9 Pop items failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Push 7 more items causing wrap-around and overwrite
k = 1
while (k <= 7) {
    circularBufferPush(cb, 100 + k)
    k = k + 1
}
if (cb[3] != cbCap or detectCircularBufferCorruption(cb) != 1) {
    print("[FAIL] Test Case 9 Wrap-around fill failed: count=", cb[3])
    testSuiteFailures = testSuiteFailures + 1
}

resCb = serializeCircularBuffer(cb)
serializedCbArr = resCb[1]
if (serializedCbArr.size() != cbCap) {
    print("[FAIL] Test Case 9 Serialized buffer length failed: ", serializedCbArr.size())
    testSuiteFailures = testSuiteFailures + 1
}
// Validate exact FIFO logical elements
if (serializedCbArr[0] != 50 or serializedCbArr[1] != 101 or serializedCbArr[7] != 107) {
    print("[FAIL] Test Case 9 Serialized circular buffer contents mismatch: first=", serializedCbArr[0], " last=", serializedCbArr[7])
    testSuiteFailures = testSuiteFailures + 1
}

// Test corruption detection
cb[3] = cbCap + 5 // Corrupt count
if (detectCircularBufferCorruption(cb) != 0) {
    print("[FAIL] Test Case 9 Corruption detector failed to catch count > capacity")
    testSuiteFailures = testSuiteFailures + 1
}
cb[3] = cbCap // Restore count
cb[2] = (cb[2] + 1) % cbCap // Corrupt tail
if (detectCircularBufferCorruption(cb) != 0) {
    print("[FAIL] Test Case 9 Corruption detector failed to catch mismatched tail")
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 9 Passed circular array ring buffer wrap-around and corruption validation")

// --- Test Case 10: Deserialization Round-Trip & Structural Invariant Verification ---
print("Running Test Case 10: Deserialization Round-Trip & Structural Invariants...")

roundTripGraph = createGraph(8)
r0 = addNode(roundTripGraph, 700)
r1 = addNode(roundTripGraph, 701)
r2 = addNode(roundTripGraph, 702)
r3 = addNode(roundTripGraph, 703)

addReference(roundTripGraph, r0, r1)
addReference(roundTripGraph, r1, r2)
addReference(roundTripGraph, r2, r0) // Cycle 1: 0->1->2->0
addReference(roundTripGraph, r1, r3)
addReference(roundTripGraph, r3, r1) // Cycle 2: 1->3->1

resRt = serializeGraph(roundTripGraph, r0)
reconRt = deserializeGraph(getSerializeTokens(resRt))

if (validateGraphIsomorphism(roundTripGraph, r0, reconRt, 0) != 1) {
    print("[FAIL] Test Case 10 Round-trip graph isomorphism validation failed")
    testSuiteFailures = testSuiteFailures + 1
}

resRtSecond = serializeGraph(reconRt, 0)
if (getSerializeCycleCount(resRtSecond) != getSerializeCycleCount(resRt)) {
    print("[FAIL] Test Case 10 Reserialization of reconstructed graph cycle count mismatch: orig=", getSerializeCycleCount(resRt), " recon=", getSerializeCycleCount(resRtSecond))
    testSuiteFailures = testSuiteFailures + 1
}
print("  Test Case 10 Passed deserialization round-trip and structural isomorphism verification")

// --- Benchmark Timings and Final Assertion ---

suiteElapsedTime = t.millis() - suiteStartTime

if (testSuiteFailures == 0) {
    print("[PASS] Self-Referential Circular Array Serialization Suite executed successfully in ", suiteElapsedTime, " ms")
} else {
    print("[FAIL] Self-Referential Circular Array Serialization Suite encountered ", testSuiteFailures, " failures")
}
