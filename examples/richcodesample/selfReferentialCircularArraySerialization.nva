addReference(lassoGraph, l0, l1)
addReference(lassoGraph, l1, l2)
addReference(lassoGraph, l2, l3)
addReference(lassoGraph, l3, l4)
addReference(lassoGraph, l4, l5)
addReference(lassoGraph, l5, l2)

resLasso = serializeGraph(lassoGraph, l0)
if (getSerializeVisited(resLasso) != 6) {
    print("[FAIL] Test Case 4 Lasso visited count failed: ", getSerializeVisited(resLasso))
