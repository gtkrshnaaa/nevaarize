if (lassoCycle[0] != l5 or lassoCycle[1] != l2 or lassoCycle[2] != 4) {
    print("[FAIL] Test Case 4 Lasso cycle target or length failed: from=", lassoCycle[0], " to=", lassoCycle[1], " len=", lassoCycle[2])
