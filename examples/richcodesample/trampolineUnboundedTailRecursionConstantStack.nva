import stdlib time as t

// Trampoline Execution Pattern for Unbounded Tail Recursion Suite
// Technical characteristics:
// - Functional trampoline execution engine eliminating call stack growth
// - Constant O(1) stack frame footprint independent of recursion depth
// - Tagged algebraic bounce sum type: Done (terminal), More (thunk), FlatMap (continuation)
// - Monadic composition supporting pure, map, and flatMap monadic laws
// - Mutual tail-recursion ping-pong co-routines (isEven / isOdd) without call stack growth
// - Resilient to extreme recursion depths (100,000+ steps) where native recursion fails with stack overflow
// - Deterministic assertion suite verifying mathematical invariants, step counts, and telemetry
// - Strict camelCase naming conventions enforced across all symbols (No-Underscore Policy)
// - Zero external dependencies, zero emojis, and zero em dashes in code and output

print("=== Nevaarize Trampoline Unbounded Tail Recursion Suite ===")
suiteStartTime = t.millis()
testSuiteFailures = 0

// --- Algebraic Tag Constants ---

tagDone = 0
tagMore = 1
tagFlatMap = 2

// --- Function Registry Identifier Constants ---

fnIdSumTail = 1
fnIdEvenTail = 2
fnIdOddTail = 3
fnIdFibonacciTail = 4
fnIdCollatzTail = 5
fnIdFactorialModTail = 6
fnIdListFoldTail = 7
fnIdDoubleCont = 8
fnIdSquareCont = 9
fnIdAddCont = 10

// --- Bounce Constructors and Inspection Primitives ---
// Bounce representation:
// [0]: tag (0 = Done, 1 = More, 2 = FlatMap)
// [1]: fnId (function registry ID or continuation fnId)
// [2]: a0 (first argument, result if Done, or subBounce if FlatMap)
// [3]: a1 (second argument or continuation extra argument)
// [4]: a2 (third argument)

func createDone(result) {
    return [tagDone, 0, result, 0, 0]
}

func createMore(fnId, a0, a1, a2) {
    return [tagMore, fnId, a0, a1, a2]
}

func createFlatMap(subBounce, contFnId, extraArg) {
    return [tagFlatMap, contFnId, subBounce, extraArg, 0]
}

func isDone(bounce) {
    if (bounce[0] == tagDone) {
        return true
    }
    return false
}

func isMore(bounce) {
    if (bounce[0] == tagMore) {
        return true
    }
    return false
}

func isFlatMap(bounce) {
    if (bounce[0] == tagFlatMap) {
        return true
    }
    return false
}

func getDoneResult(bounce) {
    return bounce[2]
}

// --- Thunk Dispatch Registry ---

func dispatchThunk(fnId, a0, a1, a2) {
    if (fnId == 1) {
        // fnIdSumTail: a0 = n, a1 = acc
        if (a0 <= 0) {
            return createDone(a1)
        }
        nextAcc = a1 + a0
        nextN = a0 - 1
        return createMore(1, nextN, nextAcc, 0)
    } elif (fnId == 2) {
        // fnIdEvenTail: a0 = n
        if (a0 == 0) {
            return createDone(1)
        }
        nextN = a0 - 1
        return createMore(3, nextN, 0, 0)
    } elif (fnId == 3) {
        // fnIdOddTail: a0 = n
        if (a0 == 0) {
            return createDone(0)
        }
        nextN = a0 - 1
        return createMore(2, nextN, 0, 0)
    } elif (fnId == 4) {
        // fnIdFibonacciTail: a0 = n, a1 = a, a2 = b
        if (a0 <= 0) {
            return createDone(a1)
        }
        nextN = a0 - 1
        nextFib = (a1 + a2) % 1000000007
        return createMore(4, nextN, a2, nextFib)
    } elif (fnId == 5) {
        // fnIdCollatzTail: a0 = n, a1 = steps, a2 = peakVal
        newPeak = a2
        if (a0 > newPeak) {
            newPeak = a0
        }
        if (a0 <= 1) {
            return createDone([a1, newPeak])
        }
        if (a0 % 2 == 0) {
            nextN = a0 / 2
        } else {
            nextN = (a0 * 3) + 1
        }
        nextSteps = a1 + 1
        return createMore(5, nextN, nextSteps, newPeak)
    } elif (fnId == 6) {
        // fnIdFactorialModTail: a0 = n, a1 = acc, a2 = mod
        if (a0 <= 1) {
            return createDone(a1)
        }
        nextAcc = (a1 * a0) % a2
        nextN = a0 - 1
        return createMore(6, nextN, nextAcc, a2)
    } elif (fnId == 7) {
        // fnIdListFoldTail: a0 = list, a1 = idx, a2 = acc
        if (a1 >= a0.size()) {
            return createDone(a2)
        }
        nextAcc = a2 + a0[a1]
        nextIdx = a1 + 1
        return createMore(7, a0, nextIdx, nextAcc)
    } elif (fnId == 8) {
        // fnIdDoubleCont: a0 = val, a1 = extra
        doubledVal = (a0 * 2) + a1
        return createDone(doubledVal)
    } elif (fnId == 9) {
        // fnIdSquareCont: a0 = val, a1 = extra
        squaredVal = a0 * a0
        return createDone(squaredVal)
    } elif (fnId == 10) {
        // fnIdAddCont: a0 = val, a1 = extra
        addedVal = a0 + a1
        return createDone(addedVal)
    }
    return createDone(0)
}

// --- Trampoline Driver Engine ---

func runTrampoline(initialBounce) {
    curr = initialBounce
    contStack = []
    
    while (curr[0] != tagDone or contStack.size() > 0) {
        tag = curr[0]
        if (tag == tagMore) {
            // More: dispatch thunk and pop call frame immediately
            curr = dispatchThunk(curr[1], curr[2], curr[3], curr[4])
        } elif (tag == tagFlatMap) {
            // FlatMap: push continuation descriptor onto heap stack, descend into subBounce
            contFnId = curr[1]
            subBounce = curr[2]
            extraArg = curr[3]
            contStack.push([contFnId, extraArg])
            curr = subBounce
        } elif (tag == tagDone) {
            // Done: resume top continuation with completed result
            topCont = contStack.pop()
            contFnId = topCont[0]
            extraArg = topCont[1]
            currVal = curr[2]
            curr = dispatchThunk(contFnId, currVal, extraArg, 0)
        }
    }
    return curr[2]
}

func runTrampolineWithTelemetry(initialBounce) {
    curr = initialBounce
    contStack = []
    totalBounces = 0
    maxStackDepth = 1
    
    while (curr[0] != tagDone or contStack.size() > 0) {
        totalBounces = totalBounces + 1
        tag = curr[0]
        if (tag == tagMore) {
            curr = dispatchThunk(curr[1], curr[2], curr[3], curr[4])
        } elif (tag == tagFlatMap) {
            contFnId = curr[1]
            subBounce = curr[2]
            extraArg = curr[3]
            contStack.push([contFnId, extraArg])
            currDepth = contStack.size() + 1
            if (currDepth > maxStackDepth) {
                maxStackDepth = currDepth
            }
            curr = subBounce
        } elif (tag == tagDone) {
            topCont = contStack.pop()
            contFnId = topCont[0]
            extraArg = topCont[1]
            currVal = curr[2]
            curr = dispatchThunk(contFnId, currVal, extraArg, 0)
        }
    }
    // Returns [result, totalBounces, maxStackDepth]
    return [curr[2], totalBounces, maxStackDepth]
}

// --- Test Case 1: Core Bounce Primitives & Linear Tail Recursion ---

print("--- Running Test Case 1: Core Bounce Primitives & Linear Tail Recursion ---")

doneBounce = createDone(42)
if (isDone(doneBounce) == false or isMore(doneBounce) == true or getDoneResult(doneBounce) != 42) {
    print("[FAIL] Test Case 1 Done bounce inspection failed")
    testSuiteFailures = testSuiteFailures + 1
}

moreBounce = createMore(fnIdSumTail, 10, 0, 0)
if (isMore(moreBounce) == false or isDone(moreBounce) == true) {
    print("[FAIL] Test Case 1 More bounce inspection failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Base case boundary: sum(0) == 0
sumZeroResult = runTrampoline(createMore(fnIdSumTail, 0, 0, 0))
if (sumZeroResult != 0) {
    print("[FAIL] Test Case 1 sum(0) expected 0, got ", sumZeroResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Small linear summation: sum(10) == 55
sumTenResult = runTrampoline(createMore(fnIdSumTail, 10, 0, 0))
if (sumTenResult != 55) {
    print("[FAIL] Test Case 1 sum(10) expected 55, got ", sumTenResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Unbounded tail recursion: sum(50,000) == 1,250,025,000
// Note: native recursion crashes with SIGSEGV at N = 100,000
telemetry50k = runTrampolineWithTelemetry(createMore(fnIdSumTail, 50000, 0, 0))
sum50kResult = telemetry50k[0]
sum50kBounces = telemetry50k[1]
sum50kMaxDepth = telemetry50k[2]

expectedSum50k = 1250025000
if (sum50kResult != expectedSum50k) {
    print("[FAIL] Test Case 1 sum(50000) expected 1250025000, got ", sum50kResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Telemetry verification: exactly 50,001 bounces and constant O(1) stack frame depth
if (sum50kBounces != 50001) {
    print("[FAIL] Test Case 1 sum(50000) expected 50001 bounces, got ", sum50kBounces)
    testSuiteFailures = testSuiteFailures + 1
}

if (sum50kMaxDepth != 1) {
    print("[FAIL] Test Case 1 sum(50000) constant stack depth violated: expected 1, got ", sum50kMaxDepth)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 1 Passed core bounce primitives and linear tail recursion (50,000 steps in O(1) stack)")

// --- Test Case 2: Mutual Tail Recursion (Even / Odd Co-routines) ---

print("--- Running Test Case 2: Mutual Tail Recursion (Even / Odd Co-routines) ---")

// Base case boundaries
evenZero = runTrampoline(createMore(fnIdEvenTail, 0, 0, 0))
oddZero = runTrampoline(createMore(fnIdOddTail, 0, 0, 0))

if (evenZero != 1 or oddZero != 0) {
    print("[FAIL] Test Case 2 Base case parity failed: evenZero=", evenZero, " oddZero=", oddZero)
    testSuiteFailures = testSuiteFailures + 1
}

// Small values parity verification
if (runTrampoline(createMore(fnIdEvenTail, 1, 0, 0)) != 0 or runTrampoline(createMore(fnIdOddTail, 1, 0, 0)) != 1) {
    print("[FAIL] Test Case 2 Parity for n=1 failed")
    testSuiteFailures = testSuiteFailures + 1
}

if (runTrampoline(createMore(fnIdEvenTail, 42, 0, 0)) != 1 or runTrampoline(createMore(fnIdOddTail, 42, 0, 0)) != 0) {
    print("[FAIL] Test Case 2 Parity for n=42 failed")
    testSuiteFailures = testSuiteFailures + 1
}

if (runTrampoline(createMore(fnIdEvenTail, 99, 0, 0)) != 0 or runTrampoline(createMore(fnIdOddTail, 99, 0, 0)) != 1) {
    print("[FAIL] Test Case 2 Parity for n=99 failed")
    testSuiteFailures = testSuiteFailures + 1
}

// Unbounded mutual tail recursion: N = 40,000 co-routine handoffs
telemetryEven40k = runTrampolineWithTelemetry(createMore(fnIdEvenTail, 40000, 0, 0))
even40kResult = telemetryEven40k[0]
even40kBounces = telemetryEven40k[1]
even40kMaxDepth = telemetryEven40k[2]

if (even40kResult != 1) {
    print("[FAIL] Test Case 2 isEven(40000) expected 1, got ", even40kResult)
    testSuiteFailures = testSuiteFailures + 1
}

if (even40kBounces != 40001) {
    print("[FAIL] Test Case 2 isEven(40000) expected 40001 bounces, got ", even40kBounces)
    testSuiteFailures = testSuiteFailures + 1
}

if (even40kMaxDepth != 1) {
    print("[FAIL] Test Case 2 isEven(40000) stack depth violated: expected 1, got ", even40kMaxDepth)
    testSuiteFailures = testSuiteFailures + 1
}

odd40kResult = runTrampoline(createMore(fnIdOddTail, 40001, 0, 0))
if (odd40kResult != 1) {
    print("[FAIL] Test Case 2 isOdd(40001) expected 1, got ", odd40kResult)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 2 Passed mutual tail recursion ping-pong (40,000 co-routine handoffs in O(1) stack)")

// --- Test Case 3: Fibonacci & Modular Arithmetic with Accumulator Tuples ---

print("--- Running Test Case 3: Fibonacci & Modular Arithmetic with Accumulator Tuples ---")

fibZero = runTrampoline(createMore(fnIdFibonacciTail, 0, 0, 1))
fibOne = runTrampoline(createMore(fnIdFibonacciTail, 1, 0, 1))
fibTwo = runTrampoline(createMore(fnIdFibonacciTail, 2, 0, 1))
fibTen = runTrampoline(createMore(fnIdFibonacciTail, 10, 0, 1))
fibTwenty = runTrampoline(createMore(fnIdFibonacciTail, 20, 0, 1))
fibThirty = runTrampoline(createMore(fnIdFibonacciTail, 30, 0, 1))

if (fibZero != 0 or fibOne != 1 or fibTwo != 1) {
    print("[FAIL] Test Case 3 Small Fibonacci values mismatch: 0=", fibZero, " 1=", fibOne, " 2=", fibTwo)
    testSuiteFailures = testSuiteFailures + 1
}

if (fibTen != 55) {
    print("[FAIL] Test Case 3 Fib(10) expected 55, got ", fibTen)
    testSuiteFailures = testSuiteFailures + 1
}

if (fibTwenty != 6765) {
    print("[FAIL] Test Case 3 Fib(20) expected 6765, got ", fibTwenty)
    testSuiteFailures = testSuiteFailures + 1
}

if (fibThirty != 832040) {
    print("[FAIL] Test Case 3 Fib(30) expected 832040, got ", fibThirty)
    testSuiteFailures = testSuiteFailures + 1
}

// Unbounded scale: F(30,000) mod 1,000,000,007
fib30kResult = runTrampoline(createMore(fnIdFibonacciTail, 30000, 0, 1))
fib30kPlus1Result = runTrampoline(createMore(fnIdFibonacciTail, 30001, 0, 1))
fib30kPlus2Result = runTrampoline(createMore(fnIdFibonacciTail, 30002, 0, 1))

// Invariant verification: F(n+2) == (F(n+1) + F(n)) % 1000000007
expectedSumModulo = (fib30kResult + fib30kPlus1Result) % 1000000007
if (fib30kPlus2Result != expectedSumModulo) {
    print("[FAIL] Test Case 3 Fibonacci recurrence invariant violated at n=30,000")
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 3 Passed Fibonacci modular recurrence (30,000 steps with tuple state preservation)")

// --- Test Case 4: Collatz Conjecture Hailstone Trajectory ---

print("--- Running Test Case 4: Collatz Conjecture Hailstone Trajectory ---")

collatzOne = runTrampoline(createMore(fnIdCollatzTail, 1, 0, 1))
if (collatzOne[0] != 0 or collatzOne[1] != 1) {
    print("[FAIL] Test Case 4 Collatz(1) mismatch: steps=", collatzOne[0], " peak=", collatzOne[1])
    testSuiteFailures = testSuiteFailures + 1
}

collatzTwo = runTrampoline(createMore(fnIdCollatzTail, 2, 0, 2))
if (collatzTwo[0] != 1 or collatzTwo[1] != 2) {
    print("[FAIL] Test Case 4 Collatz(2) mismatch: steps=", collatzTwo[0], " peak=", collatzTwo[1])
    testSuiteFailures = testSuiteFailures + 1
}

collatzThree = runTrampoline(createMore(fnIdCollatzTail, 3, 0, 3))
if (collatzThree[0] != 7 or collatzThree[1] != 16) {
    print("[FAIL] Test Case 4 Collatz(3) mismatch: steps=", collatzThree[0], " peak=", collatzThree[1])
    testSuiteFailures = testSuiteFailures + 1
}

// Classical hailstone benchmark: n = 27 takes exactly 111 steps with peak 9232
collatz27 = runTrampoline(createMore(fnIdCollatzTail, 27, 0, 27))
if (collatz27[0] != 111 or collatz27[1] != 9232) {
    print("[FAIL] Test Case 4 Collatz(27) mismatch: steps=", collatz27[0], " peak=", collatz27[1])
    testSuiteFailures = testSuiteFailures + 1
}

// Higher benchmark: n = 871 takes 178 steps with peak 190996
collatz871 = runTrampoline(createMore(fnIdCollatzTail, 871, 0, 871))
if (collatz871[0] != 178 or collatz871[1] != 190996) {
    print("[FAIL] Test Case 4 Collatz(871) mismatch: steps=", collatz871[0], " peak=", collatz871[1])
    testSuiteFailures = testSuiteFailures + 1
}

// Deep trajectory benchmark: n = 6171 takes 261 steps with peak 975400
collatz6171 = runTrampoline(createMore(fnIdCollatzTail, 6171, 0, 6171))
if (collatz6171[0] != 261 or collatz6171[1] != 975400) {
    print("[FAIL] Test Case 4 Collatz(6171) mismatch: steps=", collatz6171[0], " peak=", collatz6171[1])
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 4 Passed Collatz conjecture hailstone trajectories (deterministic steps and peak values)")

// --- Test Case 5: Deep Collection Linearization & Modular Factorial ---

print("--- Running Test Case 5: Deep Collection Linearization & Modular Factorial ---")

// Empty list boundary
emptyList = []
emptyFoldResult = runTrampoline(createMore(fnIdListFoldTail, emptyList, 0, 999))
if (emptyFoldResult != 999) {
    print("[FAIL] Test Case 5 Empty list fold failed: expected 999, got ", emptyFoldResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Array reduction across 10,000 elements
listTenThousand = []
elemIdx = 0
expectedTotalSum = 0
while (elemIdx < 10000) {
    elementVal = (elemIdx * 3) % 100
    listTenThousand.push(elementVal)
    expectedTotalSum = expectedTotalSum + elementVal
    elemIdx = elemIdx + 1
}

foldTenThousandResult = runTrampoline(createMore(fnIdListFoldTail, listTenThousand, 0, 0))
if (foldTenThousandResult != expectedTotalSum) {
    print("[FAIL] Test Case 5 List fold 10k mismatch: expected ", expectedTotalSum, " got ", foldTenThousandResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Modular factorial verification: 10! == 3,628,800
factTenResult = runTrampoline(createMore(fnIdFactorialModTail, 10, 1, 1000000007))
if (factTenResult != 3628800) {
    print("[FAIL] Test Case 5 Factorial(10) expected 3628800, got ", factTenResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Deep modular factorial across 15,000 steps without call stack growth
fact15kResult = runTrampoline(createMore(fnIdFactorialModTail, 15000, 1, 1000000007))
if (fact15kResult <= 0 or fact15kResult >= 1000000007) {
    print("[FAIL] Test Case 5 Factorial(15000) out of modular bounds: ", fact15kResult)
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 5 Passed deep collection foldLeft and modular factorial (10,000+ elements)")

// --- Test Case 6: Monadic Trampoline Chaining & Monad Laws ---

print("--- Running Test Case 6: Monadic Trampoline Chaining & Monad Laws ---")

// Monad Law 1: Left Identity -> pure(x).flatMap(f) == f(x)
// pure(15).flatMap(fnIdDoubleCont, 10) == (15 * 2) + 10 == 40
leftIdentityInput = 15
leftIdentityExtra = 10
leftIdentityBounce = createFlatMap(createDone(leftIdentityInput), fnIdDoubleCont, leftIdentityExtra)
leftIdentityResult = runTrampoline(leftIdentityBounce)
directFunctionResult = (leftIdentityInput * 2) + leftIdentityExtra

if (leftIdentityResult != directFunctionResult or leftIdentityResult != 40) {
    print("[FAIL] Test Case 6 Monad Law 1 (Left Identity) failed: expected 40, got ", leftIdentityResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Monad Law 2: Right Identity -> m.flatMap(pure) == m
// sum(20) == 210. 210 + 0 == 210
rightIdentityInitial = createMore(fnIdSumTail, 20, 0, 0)
rightIdentityChained = createFlatMap(rightIdentityInitial, fnIdAddCont, 0)
rightIdentityResult = runTrampoline(rightIdentityChained)

if (rightIdentityResult != 210) {
    print("[FAIL] Test Case 6 Monad Law 2 (Right Identity) failed: expected 210, got ", rightIdentityResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Monad Law 3: Associativity -> m.flatMap(f).flatMap(g) pipeline
// Stage 1: sum(50) = 1275
// Stage 2: flatMap(fnIdDoubleCont, 50) -> (1275 * 2) + 50 = 2600
// Stage 3: flatMap(fnIdSquareCont, 0) -> 2600 * 2600 = 6,760,000
pipelineStageOne = createMore(fnIdSumTail, 50, 0, 0)
pipelineStageTwo = createFlatMap(pipelineStageOne, fnIdDoubleCont, 50)
pipelineStageThree = createFlatMap(pipelineStageTwo, fnIdSquareCont, 0)

associativityResult = runTrampoline(pipelineStageThree)
expectedPipelineValue = 6760000

if (associativityResult != expectedPipelineValue) {
    print("[FAIL] Test Case 6 Monad Law 3 (Associativity) pipeline failed: expected 6760000, got ", associativityResult)
    testSuiteFailures = testSuiteFailures + 1
}

// Deep monadic recursion chaining telemetry verification
telemetryMonadic = runTrampolineWithTelemetry(pipelineStageThree)
monadicResult = telemetryMonadic[0]
monadicBounces = telemetryMonadic[1]
monadicMaxDepth = telemetryMonadic[2]

if (monadicResult != expectedPipelineValue) {
    print("[FAIL] Test Case 6 Monadic telemetry result mismatch")
    testSuiteFailures = testSuiteFailures + 1
}

// Max stack depth for 2 chained flatMaps should equal 3
if (monadicMaxDepth != 3) {
    print("[FAIL] Test Case 6 Monadic max stack depth expected 3, got ", monadicMaxDepth)
    testSuiteFailures = testSuiteFailures + 1
}

if (monadicBounces <= 0) {
    print("[FAIL] Test Case 6 Monadic bounces non-positive")
    testSuiteFailures = testSuiteFailures + 1
}

print("  Test Case 6 Passed monadic trampoline chaining and Monad Laws (Left, Right, Associativity)")

// --- Test Case 7: Extreme VM Limit Stress Benchmark (100,000+ Steps) ---

print("--- Running Test Case 7: Extreme VM Limit Stress Benchmark (100,000+ Steps) ---")

stressBenchmarkStart = t.millis()

// 100,000 steps of tail-recursive summation
// While native recursion causes Segmentation Fault (Stack Overflow) at 100,000,
// the trampoline executes in strictly bounded O(1) stack space.
stressStepLimit = 100000
stressInitialBounce = createMore(fnIdSumTail, stressStepLimit, 0, 0)
stressTelemetry = runTrampolineWithTelemetry(stressInitialBounce)

stressResult = stressTelemetry[0]
stressBounces = stressTelemetry[1]
stressMaxStack = stressTelemetry[2]

expectedStressSum = 5000050000

if (stressResult != expectedStressSum) {
    print("[FAIL] Test Case 7 Extreme stress sum mismatch: expected 5000050000, got ", stressResult)
    testSuiteFailures = testSuiteFailures + 1
}

if (stressBounces != 100001) {
    print("[FAIL] Test Case 7 Extreme stress bounces expected 100001, got ", stressBounces)
    testSuiteFailures = testSuiteFailures + 1
}

if (stressMaxStack != 1) {
    print("[FAIL] Test Case 7 Constant stack depth violated under 100,000 steps: expected 1, got ", stressMaxStack)
    testSuiteFailures = testSuiteFailures + 1
}

stressBenchmarkDuration = t.millis() - stressBenchmarkStart
print("  Test Case 7 Passed extreme VM limit benchmark (100,000 steps in ", stressBenchmarkDuration, " ms with O(1) stack frames)")

// --- Benchmark Timings and Final Assertion ---

suiteElapsedTime = t.millis() - suiteStartTime

if (testSuiteFailures == 0) {
    print("[PASS] Trampoline Unbounded Tail Recursion Suite executed successfully in ", suiteElapsedTime, " ms")
} else {
    print("[FAIL] Trampoline Suite encountered ", testSuiteFailures, " failures")
}
