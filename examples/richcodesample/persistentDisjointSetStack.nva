import stdlib time as t

// Persistent Disjoint Set Union with History Stack (Rollback DSU) Suite
// Technical characteristics:
// - State-preserving rollbacks via explicit mutation history stack in O(1) time per undo step
// - Union by rank bounding tree height strictly to O(log N) without destructive path compression
// - O(log N) worst-case find and union operations with O(N) auxiliary space
// - Checkpoint snapshots supporting arbitrary multi-step rollback and timeline forking
// - Parallel flat array representation for cache locality and zero reference overhead
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Persistent Disjoint Set Stack Suite ===")
suiteStartTime = t.millis()

func createDisjointSetStack(numElements) {
    pArr = []
    rArr = []
    sArr = []
    i = 0
    while (i < numElements) {
        pArr.push(i)
        rArr.push(0)
        sArr.push(1)
        i = i + 1
    }

    histChild = []
    histParent = []
    histRankDelta = []
    histSizeChild = []
    histMerged = []

    checkpointList = [0]
    checkpointDescs = ["base initialization"]

    meta = [numElements, numElements]

    return [pArr, rArr, sArr, histChild, histParent, histRankDelta, histSizeChild, histMerged, checkpointList, checkpointDescs, meta]
}

func findRoot(dsu, u) {
    meta = dsu[10]
    total = meta[0]
    if (u < 0 or u >= total) {
        return -1
    }
    pArr = dsu[0]
    curr = u
    while (curr != pArr[curr]) {
        curr = pArr[curr]
    }
    return curr
}

func connected(dsu, u, v) {
    ru = findRoot(dsu, u)
    rv = findRoot(dsu, v)
    if (ru == -1 or rv == -1) {
        return 0
    }
    if (ru == rv) {
        return 1
    }
    return 0
}

func unionSets(dsu, u, v) {
    ru = findRoot(dsu, u)
    rv = findRoot(dsu, v)

    histChild = dsu[3]
    histParent = dsu[4]
    histRankDelta = dsu[5]
    histSizeChild = dsu[6]
    histMerged = dsu[7]

    if (ru == -1 or rv == -1 or ru == rv) {
        histChild.push(-1)
        histParent.push(-1)
        histRankDelta.push(0)
        histSizeChild.push(0)
        histMerged.push(0)

        dsu[3] = histChild
        dsu[4] = histParent
        dsu[5] = histRankDelta
        dsu[6] = histSizeChild
        dsu[7] = histMerged
        return 0
    }

    pArr = dsu[0]
    rArr = dsu[1]
    sArr = dsu[2]
    meta = dsu[10]

    childNode = ru
    parentNode = rv
    rankInc = 0

    if (rArr[ru] > rArr[rv]) {
        childNode = rv
        parentNode = ru
    } else {
        if (rArr[ru] == rArr[rv]) {
            rankInc = 1
        }
    }

    pArr[childNode] = parentNode
    sArr[parentNode] = sArr[parentNode] + sArr[childNode]
    rArr[parentNode] = rArr[parentNode] + rankInc

    curComp = meta[1] - 1
    meta[1] = curComp

    histChild.push(childNode)
    histParent.push(parentNode)
    histRankDelta.push(rankInc)
    histSizeChild.push(sArr[childNode])
    histMerged.push(1)

    dsu[0] = pArr
    dsu[1] = rArr
    dsu[2] = sArr
    dsu[3] = histChild
    dsu[4] = histParent
    dsu[5] = histRankDelta
    dsu[6] = histSizeChild
    dsu[7] = histMerged
    dsu[10] = meta

    return 1
}

func rollbackStep(dsu) {
    histChild = dsu[3]
    if (histChild.size() == 0) {
        return 0
    }

    histParent = dsu[4]
    histRankDelta = dsu[5]
    histSizeChild = dsu[6]
    histMerged = dsu[7]

    lastIdx = histChild.size() - 1
    childNode = histChild[lastIdx]
    parentNode = histParent[lastIdx]
    rankInc = histRankDelta[lastIdx]
    szChild = histSizeChild[lastIdx]
    merged = histMerged[lastIdx]

    histChild.pop()
    histParent.pop()
    histRankDelta.pop()
    histSizeChild.pop()
    histMerged.pop()

    if (merged == 1) {
        pArr = dsu[0]
        rArr = dsu[1]
        sArr = dsu[2]
        meta = dsu[10]

        pArr[childNode] = childNode
        sArr[parentNode] = sArr[parentNode] - szChild
        rArr[parentNode] = rArr[parentNode] - rankInc

        curComp = meta[1] + 1
        meta[1] = curComp

        dsu[0] = pArr
        dsu[1] = rArr
        dsu[2] = sArr
        dsu[10] = meta
    }

    dsu[3] = histChild
    dsu[4] = histParent
    dsu[5] = histRankDelta
    dsu[6] = histSizeChild
    dsu[7] = histMerged

    return 1
}

func saveCheckpoint(dsu, desc) {
    histChild = dsu[3]
    cpList = dsu[8]
    cpDescs = dsu[9]

    cpId = cpList.size()
    cpList.push(histChild.size())
    cpDescs.push(desc)

    dsu[8] = cpList
    dsu[9] = cpDescs
    return cpId
}

func rollbackToCheckpoint(dsu, checkpointId) {
    cpList = dsu[8]
    if (checkpointId < 0 or checkpointId >= cpList.size()) {
        return 0
    }

    targetDepth = cpList[checkpointId]
    histChild = dsu[3]

    stepsRolled = 0
    while (histChild.size() > targetDepth) {
        rollbackStep(dsu)
        histChild = dsu[3]
        stepsRolled = stepsRolled + 1
    }
    return stepsRolled
}

func getComponentSize(dsu, u) {
    ru = findRoot(dsu, u)
    if (ru == -1) {
        return 0
    }
    sArr = dsu[2]
    return sArr[ru]
}

func getRank(dsu, u) {
    ru = findRoot(dsu, u)
    if (ru == -1) {
        return 0
    }
    rArr = dsu[1]
    return rArr[ru]
}

func getComponentCount(dsu) {
    meta = dsu[10]
    return meta[1]
}

func getHistoryDepth(dsu) {
    histChild = dsu[3]
    return histChild.size()
}

func getCheckpointCount(dsu) {
    cpList = dsu[8]
    return cpList.size()
}

func getCheckpointDescription(dsu, checkpointId) {
    cpDescs = dsu[9]
    return cpDescs[checkpointId]
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Unions, Connectivity Queries, and Single-Step Rollbacks
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Unions and Single-Step Rollbacks...")
tc1Size = 10
tc1Dsu = createDisjointSetStack(tc1Size)

if (getComponentCount(tc1Dsu) != 10 or getComponentSize(tc1Dsu, 0) != 1) {
    print("[FAIL] Initial state mismatch in Test Case 1")
} else {
    print("  Initial state verified: 10 isolated components, sizes all 1")
}

// Merge (0, 1), (2, 3), (0, 2) -> Component {0, 1, 2, 3}
res01 = unionSets(tc1Dsu, 0, 1)
res23 = unionSets(tc1Dsu, 2, 3)
res02 = unionSets(tc1Dsu, 0, 2)

// Merge (4, 5), (6, 7), (4, 6) -> Component {4, 5, 6, 7}
res45 = unionSets(tc1Dsu, 4, 5)
res67 = unionSets(tc1Dsu, 6, 7)
res46 = unionSets(tc1Dsu, 4, 6)

compAfterUnions = getComponentCount(tc1Dsu)
c03 = connected(tc1Dsu, 0, 3)
c12 = connected(tc1Dsu, 1, 2)
c57 = connected(tc1Dsu, 5, 7)
c05 = connected(tc1Dsu, 0, 5)
sz0 = getComponentSize(tc1Dsu, 0)
sz5 = getComponentSize(tc1Dsu, 5)

if (compAfterUnions != 4 or c03 != 1 or c12 != 1 or c57 != 1 or c05 != 0 or sz0 != 4 or sz5 != 4) {
    print("[FAIL] Union results mismatch: comp=", compAfterUnions, ", c03=", c03, ", c57=", c57, ", c05=", c05)
} else {
    print("  Sequential unions verified: 4 components, {0,1,2,3} and {4,5,6,7} size 4, cross-connected = 0")
}

// Single-step rollback: undo union(4, 6)
rollbackStep(tc1Dsu)
compAfterUndo1 = getComponentCount(tc1Dsu)
c46AfterUndo = connected(tc1Dsu, 4, 6)
c45AfterUndo = connected(tc1Dsu, 4, 5)
c67AfterUndo = connected(tc1Dsu, 6, 7)
sz4AfterUndo = getComponentSize(tc1Dsu, 4)
sz6AfterUndo = getComponentSize(tc1Dsu, 6)

if (compAfterUndo1 != 5 or c46AfterUndo != 0 or c45AfterUndo != 1 or c67AfterUndo != 1 or sz4AfterUndo != 2 or sz6AfterUndo != 2) {
    print("[FAIL] Single-step rollback (undo 4,6) failed: comp=", compAfterUndo1, ", c46=", c46AfterUndo)
} else {
    print("  Single-step rollback verified: undo union(4,6) split into {4,5} and {6,7} of size 2")
}

// Single-step rollback: undo union(6, 7)
rollbackStep(tc1Dsu)
compAfterUndo2 = getComponentCount(tc1Dsu)
c67AfterUndo2 = connected(tc1Dsu, 6, 7)
sz6AfterUndo2 = getComponentSize(tc1Dsu, 6)
sz7AfterUndo2 = getComponentSize(tc1Dsu, 7)

if (compAfterUndo2 != 6 or c67AfterUndo2 != 0 or sz6AfterUndo2 != 1 or sz7AfterUndo2 != 1) {
    print("[FAIL] Single-step rollback (undo 6,7) failed: comp=", compAfterUndo2)
} else {
    print("  Single-step rollback verified: undo union(6,7) restored isolated elements 6 and 7")
}

print("  Test Case 1 Passed sequential unions and single-step rollbacks")

// -----------------------------------------------------------------------------
// Test Case 2: Multi-Checkpoint Workflow and Timeline Forking
// -----------------------------------------------------------------------------
print("Running Test Case 2: Multi-Checkpoint Workflow and Timeline Forking...")
tc2Size = 8
tc2Dsu = createDisjointSetStack(tc2Size)
cp0 = 0 // Base state

// Step 1: Union (0, 1) and (2, 3)
unionSets(tc2Dsu, 0, 1)
unionSets(tc2Dsu, 2, 3)
cp1 = saveCheckpoint(tc2Dsu, "cp1: pairs 0-1 and 2-3")

// Step 2: Union (0, 2) and (4, 5) -> Component {0,1,2,3} and {4,5}
unionSets(tc2Dsu, 0, 2)
unionSets(tc2Dsu, 4, 5)
cp2 = saveCheckpoint(tc2Dsu, "cp2: quad 0-3 and pair 4-5")

// Branch A: Merge {0,1,2,3} with {4,5} and merge (6, 7)
unionSets(tc2Dsu, 0, 4)
unionSets(tc2Dsu, 6, 7)
cp3BranchA = saveCheckpoint(tc2Dsu, "cp3: Branch A merged 0-4 and 6-7")

c35BranchA = connected(tc2Dsu, 3, 5)
c67BranchA = connected(tc2Dsu, 6, 7)
compBranchA = getComponentCount(tc2Dsu)

if (c35BranchA != 1 or c67BranchA != 1 or compBranchA != 2) {
    print("[FAIL] Branch A verification failed: c35=", c35BranchA, ", c67=", c67BranchA, ", comp=", compBranchA)
} else {
    print("  Branch A verified: 2 components ({0,1,2,3,4,5} and {6,7})")
}

// Rollback to Checkpoint 2: should restore {0,1,2,3} and {4,5}, isolating 6 and 7
rolledStepsA = rollbackToCheckpoint(tc2Dsu, cp2)
c35AfterRoll = connected(tc2Dsu, 3, 5)
c67AfterRoll = connected(tc2Dsu, 6, 7)
c03AfterRoll = connected(tc2Dsu, 0, 3)
c45AfterRoll = connected(tc2Dsu, 4, 5)
compAfterRoll2 = getComponentCount(tc2Dsu)

if (rolledStepsA != 2 or c35AfterRoll != 0 or c67AfterRoll != 0 or c03AfterRoll != 1 or c45AfterRoll != 1 or compAfterRoll2 != 4) {
    print("[FAIL] Rollback to cp2 failed: rolled=", rolledStepsA, ", c35=", c35AfterRoll, ", comp=", compAfterRoll2)
} else {
    print("  Rollback to Checkpoint 2 verified: Branch A mutations undone, restored 4 components")
}

// Branch B: Merge {0,1,2,3} with 6 and merge {4,5} with 7
unionSets(tc2Dsu, 0, 6)
unionSets(tc2Dsu, 4, 7)
cp4BranchB = saveCheckpoint(tc2Dsu, "cp4: Branch B merged 0-6 and 4-7")

c36BranchB = connected(tc2Dsu, 3, 6)
c57BranchB = connected(tc2Dsu, 5, 7)
c35BranchB = connected(tc2Dsu, 3, 5)
compBranchB = getComponentCount(tc2Dsu)

if (c36BranchB != 1 or c57BranchB != 1 or c35BranchB != 0 or compBranchB != 2) {
    print("[FAIL] Branch B verification failed: c36=", c36BranchB, ", c57=", c57BranchB, ", c35=", c35BranchB)
} else {
    print("  Branch B verified independently: {0,1,2,3,6} and {4,5,7}, cross-connected = 0")
}

// Rollback all the way to Checkpoint 0 (Base state)
rolledStepsBase = rollbackToCheckpoint(tc2Dsu, cp0)
compAtBase = getComponentCount(tc2Dsu)
c01AtBase = connected(tc2Dsu, 0, 1)
c23AtBase = connected(tc2Dsu, 2, 3)

if (compAtBase != 8 or c01AtBase != 0 or c23AtBase != 0) {
    print("[FAIL] Rollback to Base Checkpoint 0 failed: comp=", compAtBase)
} else {
    print("  Full rollback to Base Checkpoint 0 verified: all 8 elements completely restored to isolated state")
}

print("  Test Case 2 Passed multi-checkpoint workflow and timeline forking")

// -----------------------------------------------------------------------------
// Test Case 3: Boundary and Edge Cases
// -----------------------------------------------------------------------------
print("Running Test Case 3: Boundary and Edge Cases...")

// 1. Single-element DSU (size = 1)
singleDsu = createDisjointSetStack(1)
sRoot0 = findRoot(singleDsu, 0)
sComp0 = getComponentCount(singleDsu)
sSelfUnion = unionSets(singleDsu, 0, 0)
sCompAfter = getComponentCount(singleDsu)
rollbackStep(singleDsu)
sCompFinal = getComponentCount(singleDsu)

if (sRoot0 != 0 or sComp0 != 1 or sSelfUnion != 0 or sCompAfter != 1 or sCompFinal != 1) {
    print("[FAIL] Single-element DSU failed")
} else {
    print("  Single-element DSU verified: find, self-loop union, and rollback preserved component count 1")
}

// 2. Redundant unions and cycle detection
tc3Dsu = createDisjointSetStack(4)
unionSets(tc3Dsu, 0, 1)
unionSets(tc3Dsu, 1, 2)
redUnion = unionSets(tc3Dsu, 0, 2)
compBeforeUndo = getComponentCount(tc3Dsu)
depthBeforeUndo = getHistoryDepth(tc3Dsu)

if (redUnion != 0 or compBeforeUndo != 2 or depthBeforeUndo != 3) {
    print("[FAIL] Redundant union tracking failed: redUnion=", redUnion, ", depth=", depthBeforeUndo)
} else {
    print("  Redundant union detected and tracked in history as no-op")
}

// Undo redundant union
rollbackStep(tc3Dsu)
compAfterUndoRed = getComponentCount(tc3Dsu)
c02StillConnected = connected(tc3Dsu, 0, 2)

if (compAfterUndoRed != 2 or c02StillConnected != 1) {
    print("[FAIL] Undo redundant union failed: comp=", compAfterUndoRed, ", c02=", c02StillConnected)
} else {
    print("  Rollback of redundant union verified without altering active connectivity")
}

// 3. Out-of-bounds queries and operations
oobFindNeg = findRoot(tc3Dsu, -1)
oobFindHigh = findRoot(tc3Dsu, 100)
oobConn = connected(tc3Dsu, -1, 0)
oobUnion = unionSets(tc3Dsu, -1, 2)
oobSize = getComponentSize(tc3Dsu, 999)
oobRank = getRank(tc3Dsu, -5)

if (oobFindNeg != -1 or oobFindHigh != -1 or oobConn != 0 or oobUnion != 0 or oobSize != 0 or oobRank != 0) {
    print("[FAIL] Out-of-bounds guards failed")
} else {
    print("  Out-of-bounds indices gracefully rejected with safe default values")
}

// 4. Rollback on empty stack & rollback to current checkpoint
emptyDsu = createDisjointSetStack(3)
emptyUndoRes = rollbackStep(emptyDsu)
currCp = saveCheckpoint(emptyDsu, "current cp")
sameCpRoll = rollbackToCheckpoint(emptyDsu, currCp)
invalidCpRoll = rollbackToCheckpoint(emptyDsu, 99)

if (emptyUndoRes != 0 or sameCpRoll != 0 or invalidCpRoll != 0) {
    print("[FAIL] Empty or no-op rollback checks failed")
} else {
    print("  Empty stack rollback and invalid checkpoint requests handled gracefully")
}

print("  Test Case 3 Passed boundary and edge case verification")

elapsed = t.millis() - suiteStartTime
print("[PASS] Persistent Disjoint Set Stack Milestone 2 executed in", elapsed, "ms")
