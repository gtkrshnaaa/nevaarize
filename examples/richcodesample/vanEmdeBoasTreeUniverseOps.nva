import stdlib time as t

// Van Emde Boas (vEB) Tree Integer Universe Suite
// Technical characteristics:
// - Dynamic integer set maintaining order over universe U = 2^(2^k)
// - O(log log U) lookup, successor, predecessor, insertion, and deletion
// - Recursive cluster and summary decomposition
// - Min element stored at root without cluster duplication
// - Flat parallel array arena for cache efficiency
// - Deterministic boundary assertions and randomized oracle benchmark
// - Strict camelCase naming conventions without underscores
// - Zero AI artifacts, zero emojis, zero em dashes

print("=== Nevaarize Van Emde Boas Tree Suite ===")
suiteStartTime = t.millis()

func getLowerSqrt(u) {
    if (u == 256) {
        return 16
    }
    if (u == 16) {
        return 4
    }
    if (u == 4) {
        return 2
    }
    // Generic fallback for power of 2
    root = 1
    while (root * root < u) {
        root = root * 2
    }
    return root
}

func getUpperSqrt(u) {
    low = getLowerSqrt(u)
    return u / low
}

func createVebArena() {
    vU = []
    vMin = []
    vMax = []
    vSummary = []
    vClusters = []
    return [vU, vMin, vMax, vSummary, vClusters]
}

func allocVebNode(arena, u) {
    nodeId = arena[0].size()
    arena[0].push(u)
    arena[1].push(-1)
    arena[2].push(-1)
    arena[3].push(-1)
    arena[4].push([])

    if (u > 2) {
        upSqrt = getUpperSqrt(u)
        lowSqrt = getLowerSqrt(u)

        sumNode = allocVebNode(arena, upSqrt)
        arena[3][nodeId] = sumNode

        clusterArr = []
        cIdx = 0
        while (cIdx < upSqrt) {
            cNode = allocVebNode(arena, lowSqrt)
            clusterArr.push(cNode)
            cIdx = cIdx + 1
        }
        arena[4][nodeId] = clusterArr
    }

    return nodeId
}

func vebMin(arena, node) {
    return arena[1][node]
}

func vebMax(arena, node) {
    return arena[2][node]
}

func vebMember(arena, node, x) {
    u = arena[0][node]
    minVal = arena[1][node]
    maxVal = arena[2][node]

    if (minVal == -1) {
        return 0
    }
    if (x == minVal or x == maxVal) {
        return 1
    }
    if (u == 2) {
        return 0
    }
    if (x < minVal or x > maxVal) {
        return 0
    }

    lowSqrt = getLowerSqrt(u)
    h = x / lowSqrt
    l = x % lowSqrt

    cNode = arena[4][node][h]
    return vebMember(arena, cNode, l)
}

func vebInsert(arena, node, x) {
    minVal = arena[1][node]

    if (minVal == -1) {
        arena[1][node] = x
        arena[2][node] = x
        return 1
    }

    if (x == minVal or x == arena[2][node]) {
        return 0
    }

    itemToInsert = x
    if (itemToInsert < minVal) {
        temp = minVal
        minVal = itemToInsert
        itemToInsert = temp
        arena[1][node] = minVal
    }

    u = arena[0][node]
    if (u > 2) {
        lowSqrt = getLowerSqrt(u)
        h = itemToInsert / lowSqrt
        l = itemToInsert % lowSqrt

        cNode = arena[4][node][h]
        if (arena[1][cNode] == -1) {
            sumNode = arena[3][node]
            vebInsert(arena, sumNode, h)
            vebInsert(arena, cNode, l)
        } else {
            vebInsert(arena, cNode, l)
        }
    }

    if (itemToInsert > arena[2][node]) {
        arena[2][node] = itemToInsert
    }

    return 1
}

func vebSuccessor(arena, node, x) {
    u = arena[0][node]
    minVal = arena[1][node]
    maxVal = arena[2][node]

    if (minVal == -1 or x >= maxVal) {
        return -1
    }
    if (u == 2) {
        if (x == 0 and maxVal == 1) {
            return 1
        }
        return -1
    }
    if (x < minVal) {
        return minVal
    }

    lowSqrt = getLowerSqrt(u)
    h = x / lowSqrt
    l = x % lowSqrt

    cNode = arena[4][node][h]
    maxInCluster = arena[2][cNode]

    if (maxInCluster != -1 and l < maxInCluster) {
        offset = vebSuccessor(arena, cNode, l)
        return h * lowSqrt + offset
    }

    sumNode = arena[3][node]
    succCluster = vebSuccessor(arena, sumNode, h)
    if (succCluster == -1) {
        return -1
    }

    targetCluster = arena[4][node][succCluster]
    offset = arena[1][targetCluster]
    return succCluster * lowSqrt + offset
}

func vebPredecessor(arena, node, x) {
    u = arena[0][node]
    minVal = arena[1][node]
    maxVal = arena[2][node]

    if (minVal == -1 or x <= minVal) {
        return -1
    }
    if (u == 2) {
        if (x == 1 and minVal == 0) {
            return 0
        }
        return -1
    }
    if (x > maxVal) {
        return maxVal
    }

    lowSqrt = getLowerSqrt(u)
    h = x / lowSqrt
    l = x % lowSqrt

    cNode = arena[4][node][h]
    minInCluster = arena[1][cNode]

    if (minInCluster != -1 and l > minInCluster) {
        offset = vebPredecessor(arena, cNode, l)
        return h * lowSqrt + offset
    }

    sumNode = arena[3][node]
    predCluster = vebPredecessor(arena, sumNode, h)
    if (predCluster == -1) {
        if (minVal != -1 and x > minVal) {
            return minVal
        }
        return -1
    }

    targetCluster = arena[4][node][predCluster]
    offset = arena[2][targetCluster]
    return predCluster * lowSqrt + offset
}

func vebDelete(arena, node, x) {
    minVal = arena[1][node]
    maxVal = arena[2][node]

    if (minVal == -1) {
        return 0
    }
    if (minVal == maxVal) {
        if (x == minVal) {
            arena[1][node] = -1
            arena[2][node] = -1
            return 1
        }
        return 0
    }

    u = arena[0][node]
    if (u == 2) {
        if (x == 0) {
            arena[1][node] = 1
        } else {
            arena[2][node] = 0
        }
        return 1
    }

    delVal = x
    lowSqrt = getLowerSqrt(u)

    if (delVal == minVal) {
        sumNode = arena[3][node]
        firstCluster = arena[1][sumNode]
        targetCluster = arena[4][node][firstCluster]
        newMinOffset = arena[1][targetCluster]
        delVal = firstCluster * lowSqrt + newMinOffset
        arena[1][node] = delVal
    }

    h = delVal / lowSqrt
    l = delVal % lowSqrt
    cNode = arena[4][node][h]

    vebDelete(arena, cNode, l)

    if (arena[1][cNode] == -1) {
        sumNode = arena[3][node]
        vebDelete(arena, sumNode, h)

        if (delVal == arena[2][node]) {
            sumMax = arena[2][sumNode]
            if (sumMax == -1) {
                arena[2][node] = arena[1][node]
            } else {
                lastCNode = arena[4][node][sumMax]
                arena[2][node] = sumMax * lowSqrt + arena[2][lastCNode]
            }
        }
    } else {
        if (delVal == arena[2][node]) {
            arena[2][node] = h * lowSqrt + arena[2][cNode]
        }
    }

    return 1
}

// -----------------------------------------------------------------------------
// Test Case 1: Sequential Operations on Universe U = 256
// -----------------------------------------------------------------------------
print("Running Test Case 1: Sequential Operations on Universe U = 256...")
tc1Pass = 1
ar1 = createVebArena()
root1 = allocVebNode(ar1, 256)

// Empty tree assertions
if (vebMin(ar1, root1) != -1 or vebMax(ar1, root1) != -1) {
    tc1Pass = 0
}
if (vebMember(ar1, root1, 42) != 0) {
    tc1Pass = 0
}
if (vebSuccessor(ar1, root1, 0) != -1 or vebPredecessor(ar1, root1, 100) != -1) {
    tc1Pass = 0
}

sampleElements = [7, 42, 19, 105, 200, 3, 255, 0, 88, 128]
sIdx = 0
while (sIdx < sampleElements.size()) {
    vebInsert(ar1, root1, sampleElements[sIdx])
    sIdx = sIdx + 1
}

// Min and Max
if (vebMin(ar1, root1) != 0 or vebMax(ar1, root1) != 255) {
    tc1Pass = 0
}

// Membership
sIdx = 0
while (sIdx < sampleElements.size()) {
    if (vebMember(ar1, root1, sampleElements[sIdx]) != 1) {
        tc1Pass = 0
    }
    sIdx = sIdx + 1
}

// Non-members
if (vebMember(ar1, root1, 1) != 0 or vebMember(ar1, root1, 50) != 0 or vebMember(ar1, root1, 254) != 0) {
    tc1Pass = 0
}

// Sorted elements: [0, 3, 7, 19, 42, 88, 105, 128, 200, 255]
expectedSorted = [0, 3, 7, 19, 42, 88, 105, 128, 200, 255]

// Successor chain starting from min
curr = vebMin(ar1, root1)
cIdx = 0
while (cIdx < expectedSorted.size()) {
    if (curr != expectedSorted[cIdx]) {
        tc1Pass = 0
    }
    curr = vebSuccessor(ar1, root1, curr)
    cIdx = cIdx + 1
}
if (curr != -1) {
    tc1Pass = 0
}

// Predecessor chain starting from max
curr = vebMax(ar1, root1)
cIdx = expectedSorted.size() - 1
while (cIdx >= 0) {
    if (curr != expectedSorted[cIdx]) {
        tc1Pass = 0
    }
    curr = vebPredecessor(ar1, root1, curr)
    cIdx = cIdx - 1
}
if (curr != -1) {
    tc1Pass = 0
}

if (tc1Pass == 1) {
    print("  Empty universe boundaries validated safely")
    print("  10 elements inserted into U=256 tree")
    print("  Min (0) and Max (255) retrieved accurately")
    print("  Successor and predecessor chains verified across all elements")
    print("  Test Case 1 Passed successfully")
} else {
    print("[FAIL] Test Case 1 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 2: Deletions, Predecessor Shifting, and Dynamic Membership
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 2: Deletions and Predecessor Shifting...")
tc2Pass = 1

// Delete min (0)
vebDelete(ar1, root1, 0)
if (vebMember(ar1, root1, 0) != 0 or vebMin(ar1, root1) != 3) {
    tc2Pass = 0
}

// Delete max (255)
vebDelete(ar1, root1, 255)
if (vebMember(ar1, root1, 255) != 0 or vebMax(ar1, root1) != 200) {
    tc2Pass = 0
}

// Delete internal node (42)
vebDelete(ar1, root1, 42)
if (vebMember(ar1, root1, 42) != 0) {
    tc2Pass = 0
}

// Predecessor of 50 should now be 19 (was 42 before deletion)
if (vebPredecessor(ar1, root1, 50) != 19) {
    tc2Pass = 0
}

// Successor of 19 should now be 88 (was 42 before deletion)
if (vebSuccessor(ar1, root1, 19) != 88) {
    tc2Pass = 0
}

if (tc2Pass == 1) {
    print("  Deletion of min, max, and internal nodes executed cleanly")
    print("  Successor and predecessor links updated dynamically after deletions")
    print("  Test Case 2 Passed successfully")
} else {
    print("[FAIL] Test Case 2 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 3: Small Universe Base Case U = 16 & U = 4
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 3: Small Universe Base Case U = 16 & U = 4...")
tc3Pass = 1
ar3 = createVebArena()
rootU16 = allocVebNode(ar3, 16)

vebInsert(ar3, rootU16, 2)
vebInsert(ar3, rootU16, 5)
vebInsert(ar3, rootU16, 9)
vebInsert(ar3, rootU16, 14)

if (vebMin(ar3, rootU16) != 2 or vebMax(ar3, rootU16) != 14) {
    tc3Pass = 0
}
if (vebSuccessor(ar3, rootU16, 5) != 9) {
    tc3Pass = 0
}
if (vebPredecessor(ar3, rootU16, 9) != 5) {
    tc3Pass = 0
}

vebDelete(ar3, rootU16, 5)
if (vebSuccessor(ar3, rootU16, 2) != 9) {
    tc3Pass = 0
}

if (tc3Pass == 1) {
    print("  Base case U=16 verified with accurate two-level cluster recursion")
    print("  Test Case 3 Passed successfully")
} else {
    print("[FAIL] Test Case 3 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 4: Randomized Stress Simulation against Sorted Set Oracle
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 4: Randomized Stress Simulation against Sorted Set Oracle...")
arStress = createVebArena()
rootStress = allocVebNode(arStress, 256)
oracleSet = [] // Array of unique sorted values in [0, 255]

stressSeed = 314159265
stressOps = 250
stressOpI = 0
stressMismatches = 0
totalIns = 0
totalDels = 0
totalQueries = 0

while (stressOpI < stressOps) {
    stressSeed = (stressSeed * 1103515245 + 12345) % 2147483648
    opType = (stressSeed / 65536) % 4
    val = (stressSeed / 256) % 256

    if (opType == 0) {
        // Insert
        vRes = vebInsert(arStress, rootStress, val)

        // Check if in oracle
        inOracle = 0
        oIdx = 0
        while (oIdx < oracleSet.size()) {
            if (oracleSet[oIdx] == val) {
                inOracle = 1
            }
            oIdx = oIdx + 1
        }

        if (inOracle == 0) {
            // Insert and sort
            oracleSet.push(val)
            // Insertion sort
            sortI = oracleSet.size() - 1
            while (sortI > 0 and oracleSet[sortI] < oracleSet[sortI - 1]) {
                tmp = oracleSet[sortI]
                oracleSet[sortI] = oracleSet[sortI - 1]
                oracleSet[sortI - 1] = tmp
                sortI = sortI - 1
            }
        }
        totalIns = totalIns + 1
    }

    if (opType == 1) {
        // Delete
        vebDelete(arStress, rootStress, val)

        newOracle = []
        oIdx = 0
        while (oIdx < oracleSet.size()) {
            if (oracleSet[oIdx] != val) {
                newOracle.push(oracleSet[oIdx])
            }
            oIdx = oIdx + 1
        }
        oracleSet = newOracle
        totalDels = totalDels + 1
    }

    if (opType == 2) {
        // Membership check
        vMem = vebMember(arStress, rootStress, val)
        oMem = 0
        oIdx = 0
        while (oIdx < oracleSet.size()) {
            if (oracleSet[oIdx] == val) {
                oMem = 1
            }
            oIdx = oIdx + 1
        }

        if (vMem != oMem) {
            print("[FAIL] Membership mismatch for val=", val, ": vEB=", vMem, ", oracle=", oMem)
            stressMismatches = stressMismatches + 1
        }
        totalQueries = totalQueries + 1
    }

    if (opType == 3) {
        // Successor check
        vSucc = vebSuccessor(arStress, rootStress, val)

        oSucc = -1
        oIdx = 0
        while (oIdx < oracleSet.size()) {
            if (oracleSet[oIdx] > val) {
                oSucc = oracleSet[oIdx]
                oIdx = oracleSet.size() // break
            }
            oIdx = oIdx + 1
        }

        if (vSucc != oSucc) {
            print("[FAIL] Successor mismatch for val=", val, ": vEB=", vSucc, ", oracle=", oSucc)
            stressMismatches = stressMismatches + 1
        }
        totalQueries = totalQueries + 1
    }

    stressOpI = stressOpI + 1
}

// Drain verify
dScan = 0
while (dScan < oracleSet.size()) {
    vMem = vebMember(arStress, rootStress, oracleSet[dScan])
    if (vMem != 1) {
        print("[FAIL] Drain membership mismatch for val=", oracleSet[dScan])
        stressMismatches = stressMismatches + 1
    }
    dScan = dScan + 1
}

if (stressMismatches == 0) {
    print("  Executed", stressOps, "randomized operations (", totalIns, "ins,", totalDels, "dels,", totalQueries, "queries): 0 mismatches")
    print("  100% agreement with sorted set reference oracle")
    print("  Test Case 4 Passed successfully")
} else {
    print("[FAIL] Stress simulation encountered", stressMismatches, "mismatches")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] Van Emde Boas Tree Suite executed successfully in", elapsed, "ms")
