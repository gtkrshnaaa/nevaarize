import stdlib time as t

// Centroid Decomposition on Trees for Divide-and-Conquer Path Counting
// Technical characteristics:
// - Forward-star adjacency representation for optimal cache locality and zero GC overhead
// - Iterative subtree size computation and centroid identification
// - Divide-and-conquer path counting for exact distance K and at-most distance K
// - Centroid tree decomposition with logarithmic depth bound O(log N)
// - Comprehensive assertion suites and randomized stress testing
// - Strict camelCase naming conventions enforced (No-Underscore Policy)

print("=== Nevaarize Centroid Decomposition Suite ===")
suiteStartTime = t.millis()

func createTree(numVertices) {
    trHead = []
    trI = 0
    while (trI < numVertices) {
        trHead.push(-1)
        trI = trI + 1
    }
    trTo = []
    trWeight = []
    trNextEdge = []
    return [numVertices, trHead, trTo, trWeight, trNextEdge]
}

func addEdge(tree, u, v, w) {
    aeHead = tree[1]
    aeTo = tree[2]
    aeWeight = tree[3]
    aeNextEdge = tree[4]

    aeId1 = aeTo.size()
    aeTo.push(v)
    aeWeight.push(w)
    aeNextEdge.push(aeHead[u])
    aeHead[u] = aeId1

    aeId2 = aeTo.size()
    aeTo.push(u)
    aeWeight.push(w)
    aeNextEdge.push(aeHead[v])
    aeHead[v] = aeId2

    tree[1] = aeHead
    tree[2] = aeTo
    tree[3] = aeWeight
    tree[4] = aeNextEdge
}

func findCentroid(tree, startNode, isDecomposed) {
    fcHead = tree[1]
    fcTo = tree[2]
    fcNextEdge = tree[4]
    fcNumVertices = tree[0]

    fcOrder = [startNode]
    fcPar = []
    fcVisited = []
    fcI = 0
    while (fcI < fcNumVertices) {
        fcPar.push(-1)
        fcVisited.push(0)
        fcI = fcI + 1
    }

    fcVisited[startNode] = 1
    fcHeadIdx = 0
    while (fcHeadIdx < fcOrder.size()) {
        fcU = fcOrder[fcHeadIdx]
        fcHeadIdx = fcHeadIdx + 1

        fcE = fcHead[fcU]
        while (fcE != -1) {
            fcV = fcTo[fcE]
            if (isDecomposed[fcV] == 0 and fcVisited[fcV] == 0) {
                fcVisited[fcV] = 1
                fcPar[fcV] = fcU
                fcOrder.push(fcV)
            }
            fcE = fcNextEdge[fcE]
        }
    }

    fcCompSize = fcOrder.size()
    if (fcCompSize == 1) {
        return startNode
    }

    fcSubSize = []
    fcI = 0
    while (fcI < fcNumVertices) {
        fcSubSize.push(1)
        fcI = fcI + 1
    }

    fcRevIdx = fcCompSize - 1
    while (fcRevIdx > 0) {
        fcU = fcOrder[fcRevIdx]
        fcP = fcPar[fcU]
        fcSubSize[fcP] = fcSubSize[fcP] + fcSubSize[fcU]
        fcRevIdx = fcRevIdx - 1
    }

    fcHalf = fcCompSize / 2
    fcCurr = startNode
    fcFinding = 1
    while (fcFinding == 1) {
        fcNextStep = -1
        fcE = fcHead[fcCurr]
        while (fcE != -1) {
            fcV = fcTo[fcE]
            if (isDecomposed[fcV] == 0 and fcPar[fcV] == fcCurr and fcSubSize[fcV] > fcHalf) {
                fcNextStep = fcV
            }
            fcE = fcNextEdge[fcE]
        }
        if (fcNextStep != -1) {
            fcCurr = fcNextStep
        } else {
            fcFinding = 0
        }
    }

    return fcCurr
}

func collectDistances(tree, startNbr, centroid, isDecomposed, maxDistLimit) {
    cdHead = tree[1]
    cdTo = tree[2]
    cdWeight = tree[3]
    cdNextEdge = tree[4]
    cdNumVertices = tree[0]

    cdInitWeight = 1
    cdE = cdHead[centroid]
    while (cdE != -1) {
        if (cdTo[cdE] == startNbr) {
            cdInitWeight = cdWeight[cdE]
        }
        cdE = cdNextEdge[cdE]
    }

    cdNodes = [startNbr]
    cdDists = [cdInitWeight]

    cdVisited = []
    cdI = 0
    while (cdI < cdNumVertices) {
        cdVisited.push(0)
        cdI = cdI + 1
    }
    cdVisited[centroid] = 1
    cdVisited[startNbr] = 1

    cdHeadIdx = 0
    while (cdHeadIdx < cdNodes.size()) {
        cdU = cdNodes[cdHeadIdx]
        cdD = cdDists[cdHeadIdx]
        cdHeadIdx = cdHeadIdx + 1

        cdE = cdHead[cdU]
        while (cdE != -1) {
            cdV = cdTo[cdE]
            cdW = cdWeight[cdE]
            if (isDecomposed[cdV] == 0 and cdVisited[cdV] == 0) {
                cdVisited[cdV] = 1
                cdNewD = cdD + cdW
                if (cdNewD <= maxDistLimit) {
                    cdNodes.push(cdV)
                    cdDists.push(cdNewD)
                }
            }
            cdE = cdNextEdge[cdE]
        }
    }

    return cdDists
}

func countPathsExactLength(tree, targetLen) {
    cpNumVertices = tree[0]
    if (cpNumVertices <= 1 or targetLen <= 0) {
        return 0
    }

    cpDecomposed = []
    cpI = 0
    while (cpI < cpNumVertices) {
        cpDecomposed.push(0)
        cpI = cpI + 1
    }

    cpTotal = 0
    cpQueue = [0]
    cpQHead = 0

    cpFreq = []
    cpFIdx = 0
    while (cpFIdx <= targetLen + 1) {
        cpFreq.push(0)
        cpFIdx = cpFIdx + 1
    }

    cpHead = tree[1]
    cpTo = tree[2]
    cpNextEdge = tree[4]

    while (cpQHead < cpQueue.size()) {
        cpEntry = cpQueue[cpQHead]
        cpQHead = cpQHead + 1

        if (cpDecomposed[cpEntry] == 0) {
            cpC = findCentroid(tree, cpEntry, cpDecomposed)

            cpFreq[0] = 1
            cpTouched = [0]

            cpEdge = cpHead[cpC]
            while (cpEdge != -1) {
                cpNbr = cpTo[cpEdge]
                if (cpDecomposed[cpNbr] == 0) {
                    cpSubDists = collectDistances(tree, cpNbr, cpC, cpDecomposed, targetLen)

                    cpDIdx = 0
                    while (cpDIdx < cpSubDists.size()) {
                        cpDVal = cpSubDists[cpDIdx]
                        if (cpDVal <= targetLen) {
                            cpNeed = targetLen - cpDVal
                            if (cpNeed <= targetLen) {
                                cpTotal = cpTotal + cpFreq[cpNeed]
                            }
                        }
                        cpDIdx = cpDIdx + 1
                    }

                    cpDIdx2 = 0
                    while (cpDIdx2 < cpSubDists.size()) {
                        cpDVal2 = cpSubDists[cpDIdx2]
                        if (cpDVal2 <= targetLen) {
                            cpFreq[cpDVal2] = cpFreq[cpDVal2] + 1
                            cpTouched.push(cpDVal2)
                        }
                        cpDIdx2 = cpDIdx2 + 1
                    }
                }
                cpEdge = cpNextEdge[cpEdge]
            }

            cpTIdx = 0
            while (cpTIdx < cpTouched.size()) {
                cpTVal = cpTouched[cpTIdx]
                cpFreq[cpTVal] = 0
                cpTIdx = cpTIdx + 1
            }

            cpDecomposed[cpC] = 1

            cpEdge2 = cpHead[cpC]
            while (cpEdge2 != -1) {
                cpNbr2 = cpTo[cpEdge2]
                if (cpDecomposed[cpNbr2] == 0) {
                    cpQueue.push(cpNbr2)
                }
                cpEdge2 = cpNextEdge[cpEdge2]
            }
        }
    }

    return cpTotal
}

func countPathsAtMostLength(tree, maxLen) {
    if (maxLen <= 0) {
        return 0
    }
    cpmAns = 0
    cpmLen = 1
    while (cpmLen <= maxLen) {
        cpmAns = cpmAns + countPathsExactLength(tree, cpmLen)
        cpmLen = cpmLen + 1
    }
    return cpmAns
}

func buildCentroidTree(tree) {
    bctNum = tree[0]
    bctDec = []
    bctPar = []
    bctDepth = []
    bctI = 0
    while (bctI < bctNum) {
        bctDec.push(0)
        bctPar.push(-1)
        bctDepth.push(0)
        bctI = bctI + 1
    }

    bctHead = tree[1]
    bctTo = tree[2]
    bctNextEdge = tree[4]

    bctQueue = [0]
    bctParQueue = [-1]
    bctDepthQueue = [1]
    bctQHead = 0
    rootCentroid = -1

    while (bctQHead < bctQueue.size()) {
        bctEntry = bctQueue[bctQHead]
        bctParentC = bctParQueue[bctQHead]
        bctCurDepth = bctDepthQueue[bctQHead]
        bctQHead = bctQHead + 1

        if (bctDec[bctEntry] == 0) {
            bctC = findCentroid(tree, bctEntry, bctDec)
            bctPar[bctC] = bctParentC
            bctDepth[bctC] = bctCurDepth
            if (bctParentC == -1) {
                rootCentroid = bctC
            }
            bctDec[bctC] = 1

            bctE = bctHead[bctC]
            while (bctE != -1) {
                bctNbr = bctTo[bctE]
                if (bctDec[bctNbr] == 0) {
                    bctQueue.push(bctNbr)
                    bctParQueue.push(bctC)
                    bctDepthQueue.push(bctCurDepth + 1)
                }
                bctE = bctNextEdge[bctE]
            }
        }
    }

    return [rootCentroid, bctPar, bctDepth]
}

// -----------------------------------------------------------------------------
// Test Case 1: Canonical Line Graph (Path Graph) Path Counting
// -----------------------------------------------------------------------------
print("Running Test Case 1: Line Graph Path Counting and Centroid Tree...")
tc1Size = 7
tc1Tree = createTree(tc1Size)
// Line: 0 - 1 - 2 - 3 - 4 - 5 - 6
tc1I = 0
while (tc1I < 6) {
    addEdge(tc1Tree, tc1I, tc1I + 1, 1)
    tc1I = tc1I + 1
}

cTreeData1 = buildCentroidTree(tc1Tree)
cRoot1 = cTreeData1[0]
cPar1 = cTreeData1[1]
cDepth1 = cTreeData1[2]

// Maximum depth in centroid tree must be <= 3 (log2(7) + 1)
maxDepth1 = 0
nodeI = 0
while (nodeI < tc1Size) {
    if (cDepth1[nodeI] > maxDepth1) {
        maxDepth1 = cDepth1[nodeI]
    }
    nodeI = nodeI + 1
}

if (cRoot1 != 3 or maxDepth1 > 3) {
    print("[FAIL] Test Case 1 Centroid tree shape failed: root=", cRoot1, ", maxDepth=", maxDepth1)
} else {
    print("  Centroid tree verified: root is vertex 3, max depth is", maxDepth1, "<= 3")
}

// Path counts of exact length 1..6
p1 = countPathsExactLength(tc1Tree, 1)
p2 = countPathsExactLength(tc1Tree, 2)
p3 = countPathsExactLength(tc1Tree, 3)
p4 = countPathsExactLength(tc1Tree, 4)
p5 = countPathsExactLength(tc1Tree, 5)
p6 = countPathsExactLength(tc1Tree, 6)

if (p1 != 6 or p2 != 5 or p3 != 4 or p4 != 3 or p5 != 2 or p6 != 1) {
    print("[FAIL] Line graph exact path counts failed:", p1, p2, p3, p4, p5, p6)
} else {
    print("  Exact path counts verified: k=1:6, k=2:5, k=3:4, k=4:3, k=5:2, k=6:1")
}

totalPairs1 = p1 + p2 + p3 + p4 + p5 + p6
atMost3 = countPathsAtMostLength(tc1Tree, 3)

if (totalPairs1 != 21 or atMost3 != 15) {
    print("[FAIL] Path aggregations failed: total=", totalPairs1, ", atMost3=", atMost3)
} else {
    print("  Path aggregations verified: total pairs = 21 (7 choose 2), paths <= 3 = 15")
}

print("  Test Case 1 Passed line graph path counting and centroid tree verification")

func computeAllPairsDistanceFrequencies(tree, maxDist) {
    cadfNum = tree[0]
    cadfHead = tree[1]
    cadfTo = tree[2]
    cadfWeight = tree[3]
    cadfNextEdge = tree[4]

    cadfFreq = []
    cadfFI = 0
    while (cadfFI <= maxDist) {
        cadfFreq.push(0)
        cadfFI = cadfFI + 1
    }

    cadfStartU = 0
    while (cadfStartU < cadfNum) {
        cadfVisited = []
        cadfDists = []
        cadfVI = 0
        while (cadfVI < cadfNum) {
            cadfVisited.push(0)
            cadfDists.push(-1)
            cadfVI = cadfVI + 1
        }

        cadfQueue = [cadfStartU]
        cadfVisited[cadfStartU] = 1
        cadfDists[cadfStartU] = 0
        cadfQH = 0

        while (cadfQH < cadfQueue.size()) {
            cadfCurV = cadfQueue[cadfQH]
            cadfCurD = cadfDists[cadfCurV]
            cadfQH = cadfQH + 1

            if (cadfCurV > cadfStartU and cadfCurD <= maxDist) {
                cadfFreq[cadfCurD] = cadfFreq[cadfCurD] + 1
            }

            cadfEdge = cadfHead[cadfCurV]
            while (cadfEdge != -1) {
                cadfNbr = cadfTo[cadfEdge]
                cadfW = cadfWeight[cadfEdge]
                if (cadfVisited[cadfNbr] == 0) {
                    cadfVisited[cadfNbr] = 1
                    cadfDists[cadfNbr] = cadfCurD + cadfW
                    cadfQueue.push(cadfNbr)
                }
                cadfEdge = cadfNextEdge[cadfEdge]
            }
        }
        cadfStartU = cadfStartU + 1
    }
    return cadfFreq
}

func countPathsNaiveAllPairs(tree, targetLen) {
    if (targetLen <= 0) {
        return 0
    }
    tcFreqs = computeAllPairsDistanceFrequencies(tree, targetLen)
    return tcFreqs[targetLen]
}

// -----------------------------------------------------------------------------
// Test Case 2: Star Graph Topology
// -----------------------------------------------------------------------------
print("Running Test Case 2: Star Graph Topology...")
tc2Size = 8
tc2Tree = createTree(tc2Size)
// Center 0 connected to 1..7
tc2I = 1
while (tc2I < tc2Size) {
    addEdge(tc2Tree, 0, tc2I, 1)
    tc2I = tc2I + 1
}

cTreeData2 = buildCentroidTree(tc2Tree)
cRoot2 = cTreeData2[0]
cPar2 = cTreeData2[1]
cDepth2 = cTreeData2[2]

maxDepth2 = 0
tc2Node = 0
while (tc2Node < tc2Size) {
    if (cDepth2[tc2Node] > maxDepth2) {
        maxDepth2 = cDepth2[tc2Node]
    }
    tc2Node = tc2Node + 1
}

starP1 = countPathsExactLength(tc2Tree, 1)
starP2 = countPathsExactLength(tc2Tree, 2)
starP3 = countPathsExactLength(tc2Tree, 3)

if (cRoot2 != 0 or maxDepth2 != 2) {
    print("[FAIL] Star graph centroid tree failed: root=", cRoot2, ", maxDepth=", maxDepth2)
} else {
    print("  Star graph centroid tree verified: center 0 is root, max depth is 2")
}

if (starP1 != 7 or starP2 != 21 or starP3 != 0) {
    print("[FAIL] Star graph path counts failed: p1=", starP1, ", p2=", starP2, ", p3=", starP3)
} else {
    print("  Star graph path counts verified: k=1: 7 paths (leaves to center), k=2: 21 paths (leaf pairs), k=3: 0")
}

print("  Test Case 2 Passed star graph topology verification")

// -----------------------------------------------------------------------------
// Test Case 3: Complete Binary Tree Structure
// -----------------------------------------------------------------------------
print("Running Test Case 3: Complete Binary Tree Structure...")
tc3Size = 15
tc3Tree = createTree(tc3Size)
// Binary tree edges: parent i -> children 2*i + 1, 2*i + 2
tc3Parent = 0
while (tc3Parent < 7) {
    lc = 2 * tc3Parent + 1
    rc = 2 * tc3Parent + 2
    addEdge(tc3Tree, tc3Parent, lc, 1)
    addEdge(tc3Tree, tc3Parent, rc, 1)
    tc3Parent = tc3Parent + 1
}

cTreeData3 = buildCentroidTree(tc3Tree)
cRoot3 = cTreeData3[0]
cDepth3 = cTreeData3[2]

maxDepth3 = 0
tc3Node = 0
while (tc3Node < tc3Size) {
    if (cDepth3[tc3Node] > maxDepth3) {
        maxDepth3 = cDepth3[tc3Node]
    }
    tc3Node = tc3Node + 1
}

if (maxDepth3 > 4) {
    print("[FAIL] Complete binary tree centroid tree depth exceeded 4: ", maxDepth3)
} else {
    print("  Complete binary tree centroid depth verified: max depth is", maxDepth3, "<= 4")
}

// Compare exact path counts k=1..6 against BFS oracle
tc3OracleFreqs = computeAllPairsDistanceFrequencies(tc3Tree, 6)
tc3K = 1
tc3Mismatches = 0
tc3Total = 0
while (tc3K <= 6) {
    cdCount = countPathsExactLength(tc3Tree, tc3K)
    oracleCount = tc3OracleFreqs[tc3K]
    if (cdCount != oracleCount) {
        tc3Mismatches = tc3Mismatches + 1
        print("[FAIL] Mismatch at k=", tc3K, ": cd=", cdCount, ", oracle=", oracleCount)
    }
    tc3Total = tc3Total + cdCount
    tc3K = tc3K + 1
}

if (tc3Mismatches == 0 and tc3Total == 105) {
    print("  All path lengths k=1..6 matched oracle: total paths = 105 (15 choose 2)")
    print("  Test Case 3 Passed complete binary tree verification")
} else {
    print("[FAIL] Test Case 3 binary tree validation failed: mismatches=", tc3Mismatches, ", total=", tc3Total)
}

// -----------------------------------------------------------------------------
// Test Case 4: Weighted Tree & Boundary Edge Cases
// -----------------------------------------------------------------------------
print("Running Test Case 4: Weighted Tree and Boundary Edge Cases...")
tc4Size = 6
tc4Tree = createTree(tc4Size)
// Edges with non-unit weights
addEdge(tc4Tree, 0, 1, 2)
addEdge(tc4Tree, 0, 2, 5)
addEdge(tc4Tree, 1, 3, 3)
addEdge(tc4Tree, 1, 4, 1)
addEdge(tc4Tree, 2, 5, 4)

// Check path counts for several target distances
tc4Weights = [1, 2, 3, 4, 5, 7, 8, 9, 10, 11, 12, 14]
tc4OracleFreqs = computeAllPairsDistanceFrequencies(tc4Tree, 14)
tc4WI = 0
tc4Mismatches = 0
while (tc4WI < tc4Weights.size()) {
    tLen = tc4Weights[tc4WI]
    cdWCount = countPathsExactLength(tc4Tree, tLen)
    oraWCount = tc4OracleFreqs[tLen]
    if (cdWCount != oraWCount) {
        tc4Mismatches = tc4Mismatches + 1
        print("[FAIL] Weighted tree mismatch at len=", tLen, ": cd=", cdWCount, ", oracle=", oraWCount)
    }
    tc4WI = tc4WI + 1
}

if (tc4Mismatches == 0) {
    print("  Weighted tree path counting matched oracle across all evaluated distances")
} else {
    print("[FAIL] Weighted tree mismatches detected: ", tc4Mismatches)
}

// Boundary Case 1: Single-vertex tree (N = 1)
singleTree = createTree(1)
sP1 = countPathsExactLength(singleTree, 1)
sTreeData = buildCentroidTree(singleTree)
sRoot = sTreeData[0]
sDepth = sTreeData[2]
if (sP1 != 0 or sRoot != 0 or sDepth[0] != 1) {
    print("[FAIL] Single-vertex boundary case failed")
} else {
    print("  Single-vertex tree verified: 0 paths of length 1, centroid is vertex 0")
}

// Boundary Case 2: Two-vertex tree (N = 2)
twoTree = createTree(2)
addEdge(twoTree, 0, 1, 1)
twoP1 = countPathsExactLength(twoTree, 1)
twoP2 = countPathsExactLength(twoTree, 2)
if (twoP1 != 1 or twoP2 != 0) {
    print("[FAIL] Two-vertex boundary case failed: p1=", twoP1, ", p2=", twoP2)
} else {
    print("  Two-vertex tree verified: exactly 1 path of length 1, 0 paths of length >= 2")
}

// Boundary Case 3: Invalid or extreme distances
zeroDistPaths = countPathsExactLength(tc4Tree, 0)
negDistPaths = countPathsExactLength(tc4Tree, -5)
hugeDistPaths = countPathsExactLength(tc4Tree, 9999)
if (zeroDistPaths != 0 or negDistPaths != 0 or hugeDistPaths != 0) {
    print("[FAIL] Degenerate path queries failed")
} else {
    print("  Degenerate distance queries (k=0, k<0, k=9999) gracefully returned 0")
}

print("  Test Case 4 Passed weighted tree and boundary edge case verification")

// -----------------------------------------------------------------------------
// Test Case 5: Stress Benchmark against Naive All-Pairs Shortest Path BFS Oracle
// -----------------------------------------------------------------------------
print("Running Test Case 5: Stress Benchmark against Naive BFS Oracle...")
stressN = 25
stressTree = createTree(stressN)

sSeed = 123456789
sNodeI = 1
while (sNodeI < stressN) {
    sSeed = (sSeed * 1103515245 + 12345) % 2147483648
    sParent = sSeed % sNodeI
    sSeed = (sSeed * 1103515245 + 12345) % 2147483648
    sEdgeWeight = 1 + (sSeed % 3)
    addEdge(stressTree, sParent, sNodeI, sEdgeWeight)
    sNodeI = sNodeI + 1
}

sCentroidData = buildCentroidTree(stressTree)
sMaxDepth = 0
sScanI = 0
sDepths = sCentroidData[2]
while (sScanI < stressN) {
    if (sDepths[sScanI] > sMaxDepth) {
        sMaxDepth = sDepths[sScanI]
    }
    sScanI = sScanI + 1
}
print("  Generated 25-node random tree: centroid tree max depth is", sMaxDepth, "<= 6")

stressOracleFreqs = computeAllPairsDistanceFrequencies(stressTree, 12)
stressMismatches = 0
stressTotalPaths = 0
evalK = 1
while (evalK <= 12) {
    cdResult = countPathsExactLength(stressTree, evalK)
    oracleResult = stressOracleFreqs[evalK]
    if (cdResult != oracleResult) {
        stressMismatches = stressMismatches + 1
        print("[FAIL] Stress mismatch at k=", evalK, ": cd=", cdResult, ", oracle=", oracleResult)
    }
    stressTotalPaths = stressTotalPaths + cdResult
    evalK = evalK + 1
}

if (stressMismatches > 0) {
    print("[FAIL] Stress benchmark encountered", stressMismatches, "mismatches against BFS oracle")
} else {
    print("  Validated paths for lengths k=1..12 across 25 vertices: 0 mismatches against oracle")
    print("  Total validated paths across sampled distances:", stressTotalPaths)
    print("  Test Case 5 Passed stress benchmark verification")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] Centroid Decomposition Suite executed successfully in", elapsed, "ms")
