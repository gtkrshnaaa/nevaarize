import stdlib time as t

// Utility Logger
// Demonstrates low-level logging utility in a nested structure

func logInfo(tag, message) {
    currentTime = t.format("%Y-%m-%d %H:%M:%S")
    print("[" + currentTime + "] [INFO] [" + tag + "] " + message)
}

func logWarning(tag, message) {
    currentTime = t.format("%Y-%m-%d %H:%M:%S")
    print("[" + currentTime + "] [WARN] [" + tag + "] " + message)
}
