import stdlib time as t
import stdlib math as m

// Recursive Computation Demonstration
// Showcases Nevaarize's performance in recursive calls

// 1. Iterative Fibonacci
function fibIterative(n) {
    if (n <= 1) { return n }

    prev = 0
    curr = 1
    i = 2
    while (i <= n) {
        next = prev + curr
        prev = curr
        curr = next
        i = i + 1
    }
    return curr
}

// 2. Recursive Factorial
function factorial(n) {
    if (n <= 1) { return 1 }
    return n * factorial(n - 1)
}

// 3. Recursive Power
function power(base, exp) {
    if (exp == 0) { return 1.0 }
    if (exp == 1) { return base }
    half = power(base, exp / 2)
    if (exp % 2 == 0) {
        return half * half
    }
    return half * half * base
}

// 4. Tower of Hanoi counter
function hanoiMoves(n) {
    result = 1
    i = 0
    while (i < n) {
        result = result * 2
        i = i + 1
    }
    return result - 1
}

// Main Execution
print("--- Fibonacci Demo ---")
start = t.millis()
nFib = 40
val = fibIterative(nFib)
print("Fib(", nFib, ") =", val)
print("Time taken:", t.millis() - start, "ms")

print("\n--- Factorial Demo ---")
start = t.millis()
nFact = 20
factVal = factorial(nFact)
print("Factorial(", nFact, ") =", factVal)
print("Time taken:", t.millis() - start, "ms")

print("\n--- Fast Exponentiation Demo ---")
start = t.millis()
base = 2.0
exp = 30
powVal = power(base, exp)
print("Power(", base, ",", exp, ") =", powVal)
print("Expected:", 1073741824.0)
print("Time taken:", t.millis() - start, "ms")

print("\n--- Tower of Hanoi Demo ---")
disks = 25
moves = hanoiMoves(disks)
print("Hanoi(", disks, "disks ) =", moves, "moves")

print("\nRecursive computation demo finished.")
