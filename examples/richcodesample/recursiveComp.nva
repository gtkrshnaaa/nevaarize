import stdlib time as t
import stdlib math as m

// Recursive Computation & Memoization
// Demonstrates Nevaarize's performance in recursive calls and Map usage

// 1. Fibonacci with Memoization
memo = {}

func fib(n) {
    if (n <= 1) { return n }
    if (memo.has(n)) { return memo[n] }
    
    result = fib(n - 1) + fib(n - 2)
    memo[n] = result
    return result
}

// 2. Simple Backtracking: Permutations (Subset)
func generateBinaryStrings(n, current) {
    if (current.size() == n) {
        // print(current) // Printing would be too much for high n
        return 1
    }
    
    count = 0
    // Try adding 0
    current.push(0)
    count = count + generateBinaryStrings(n, current)
    current.pop()
    
    // Try adding 1
    current.push(1)
    count = count + generateBinaryStrings(n, current)
    current.pop()
    
    return count
}

// Main Execution
print("--- Memoization Demo ---")
start = t.millis()
nFib = 40
print("Calculating Fib(", nFib, ")...")
val = fib(nFib)
print("Fib(", nFib, ") =", val)
print("Time taken with memoization:", t.millis() - start, "ms")

print("\n--- Backtracking Demo ---")
start = t.millis()
nBits = 10
print("Generating all binary strings of length", nBits, "...")
total = generateBinaryStrings(nBits, [])
print("Total strings generated:", total)
print("Time taken:", t.millis() - start, "ms")

// Performance Verify: Map stats
print("\nMemo Map Size:", memo.keys().size())
