import stdlib math as m
import stdlib time as t

// Gravitational N-Body Orbital Simulation
// Calculates pairwise gravitational forces and integrates positions using symplectic Euler

print("=== Nevaarize N-Body Gravitational Dynamics ===")
startTime = t.millis()

numBodies = 4
gravConst = 1.0
softening = 0.01 // Softening factor to prevent infinite singularity

// Planetary state: mass, posX, posY, velX, velY
mass = [100.0, 1.0, 2.0, 0.5]
posX = [0.0, 10.0, 0.0, -15.0]
posY = [0.0, 0.0, 12.0, 0.0]
velX = [0.0, 0.0, -2.5, 0.0]
velY = [0.0, 3.1, 0.0, -2.2]

// Temporary acceleration buffers
accX = [0.0, 0.0, 0.0, 0.0]
accY = [0.0, 0.0, 0.0, 0.0]

timeStep = 0.1
numSteps = 10

step = 0
while (step < numSteps) {
    // 1. Reset accelerations
    i = 0
    while (i < numBodies) {
        accX[i] = 0.0
        accY[i] = 0.0
        i = i + 1
    }

    // 2. Compute pairwise forces
    p = 0
    while (p < numBodies) {
        q = p + 1
        while (q < numBodies) {
            dx = posX[q] - posX[p]
            dy = posY[q] - posY[p]
            distSq = dx * dx + dy * dy + softening
            dist = m.Sqrt(distSq)
            invDist3 = 1.0 / (dist * distSq)

            fPtoQ = gravConst * invDist3
            accX[p] = accX[p] + fPtoQ * mass[q] * dx
            accY[p] = accY[p] + fPtoQ * mass[q] * dy
            accX[q] = accX[q] - fPtoQ * mass[p] * dx
            accY[q] = accY[q] - fPtoQ * mass[p] * dy

            q = q + 1
        }
        p = p + 1
    }

    // 3. Symplectic integration: update velocities then positions
    k = 0
    while (k < numBodies) {
        velX[k] = velX[k] + accX[k] * timeStep
        velY[k] = velY[k] + accY[k] * timeStep
        posX[k] = posX[k] + velX[k] * timeStep
        posY[k] = posY[k] + velY[k] * timeStep
        k = k + 1
    }

    step = step + 1
}

// Compute total kinetic energy
kineticEnergy = 0.0
idx = 0
while (idx < numBodies) {
    vSq = velX[idx] * velX[idx] + velY[idx] * velY[idx]
    kineticEnergy = kineticEnergy + 0.5 * mass[idx] * vSq
    idx = idx + 1
}

print("Simulation finished across", numSteps, "time steps.")
print("Final Planet 1 Position: (", posX[1], ",", posY[1], ")")
print("Total Kinetic Energy:", kineticEnergy)

elapsed = t.millis() - startTime
print("N-Body orbital integration completed in", elapsed, "ms")
