import stdlib time as t

// 2D Range Tree with Fractional Cascading Suite
// Technical characteristics:
// - Canonical orthogonal 2D range reporting and counting: [x1, x2] x [y1, y2]
// - Primary 1D balanced search tree partitioned over X coordinates
// - Secondary fractional cascading arrays linked over Y coordinates
// - Time complexity: O(log N + K) range reporting, O(N log N) construction
// - Space complexity: O(N log N) canonical decomposition
// - Self-contained flat arena node storage and iterative BFS/bottom-up builder
// - Zero AI artifacts, zero emojis, zero em dashes
// - Strict camelCase naming conventions without underscores

print("=== Nevaarize 2D Range Tree Suite ===")
suiteStartTime = t.millis()

func sortPointsByX(pts) {
    sxN = len(pts)
    sxI = 1
    while (sxI < sxN) {
        sxKey = pts[sxI]
        sxJ = sxI - 1
        while (sxJ >= 0 and (pts[sxJ][0] > sxKey[0] or (pts[sxJ][0] == sxKey[0] and pts[sxJ][1] > sxKey[1]))) {
            pts[sxJ + 1] = pts[sxJ]
            sxJ = sxJ - 1
        }
        pts[sxJ + 1] = sxKey
        sxI = sxI + 1
    }
    return pts
}

func createRangeTree2D(inputPoints) {
    ptCount = len(inputPoints)
    if (ptCount == 0) {
        return [[], -1]
    }

    // Sort points by X coordinate
    sortedPts = []
    cpI = 0
    while (cpI < ptCount) {
        sortedPts.push(inputPoints[cpI])
        cpI = cpI + 1
    }
    sortPointsByX(sortedPts)

    // Arena node structure:
    // 0: minX, 1: maxX, 2: leftIdx, 3: rightIdx, 4: ySortedPts, 5: fcLeft, 6: fcRight, 7: startIdx, 8: endIdx
    rtArena = []
    rtArena.push([0, 0, -1, -1, [], [], [], 0, ptCount])

    // Breadth-First Search top-down hierarchy partitioning
    bfsQueue = [0]
    bfsHead = 0
    while (bfsHead < len(bfsQueue)) {
        currU = bfsQueue[bfsHead]
        bfsHead = bfsHead + 1

        uStart = rtArena[currU][7]
        uEnd = rtArena[currU][8]

        if ((uEnd - uStart) > 1) {
            uMid = uStart + (uEnd - uStart) / 2

            newLeftIdx = len(rtArena)
            rtArena.push([0, 0, -1, -1, [], [], [], uStart, uMid])

            newRightIdx = len(rtArena)
            rtArena.push([0, 0, -1, -1, [], [], [], uMid, uEnd])

            rtArena[currU][2] = newLeftIdx
            rtArena[currU][3] = newRightIdx

            bfsQueue.push(newLeftIdx)
            bfsQueue.push(newRightIdx)
        }
    }

    // Bottom-up synthesis of Y-sorted canonical arrays and Fractional Cascading pointers
    buIdx = len(rtArena) - 1
    while (buIdx >= 0) {
        buStart = rtArena[buIdx][7]
        buEnd = rtArena[buIdx][8]

        rtArena[buIdx][0] = sortedPts[buStart][0]
        rtArena[buIdx][1] = sortedPts[buEnd - 1][0]

        childLeft = rtArena[buIdx][2]
        childRight = rtArena[buIdx][3]

        if (childLeft == -1 and childRight == -1) {
            // Leaf node: single point
            leafPt = sortedPts[buStart]
            rtArena[buIdx][4] = [leafPt]
            rtArena[buIdx][5] = []
            rtArena[buIdx][6] = []
        } else {
            // Internal node: merge left and right Y-sorted arrays in O(len)
            lPts = rtArena[childLeft][4]
            rPts = rtArena[childRight][4]
            lCount = len(lPts)
            rCount = len(rPts)

            mergedY = []
            mI = 0
            mJ = 0
            while (mI < lCount and mJ < rCount) {
                if (lPts[mI][1] <= rPts[mJ][1]) {
                    mergedY.push(lPts[mI])
                    mI = mI + 1
                } else {
                    mergedY.push(rPts[mJ])
                    mJ = mJ + 1
                }
            }
            while (mI < lCount) {
                mergedY.push(lPts[mI])
                mI = mI + 1
            }
            while (mJ < rCount) {
                mergedY.push(rPts[mJ])
                mJ = mJ + 1
            }
            rtArena[buIdx][4] = mergedY

            // Build fractional cascading pointers
            fcL = []
            fcR = []
            ptrL = 0
            ptrR = 0
            totalMerged = len(mergedY)
            fcK = 0
            while (fcK < totalMerged) {
                targetY = mergedY[fcK][1]

                while (ptrL < lCount and lPts[ptrL][1] < targetY) {
                    ptrL = ptrL + 1
                }
                fcL.push(ptrL)

                while (ptrR < rCount and rPts[ptrR][1] < targetY) {
                    ptrR = ptrR + 1
                }
                fcR.push(ptrR)

                fcK = fcK + 1
            }
            rtArena[buIdx][5] = fcL
            rtArena[buIdx][6] = fcR
        }

        buIdx = buIdx - 1
    }

    return [rtArena, 0]
}

func rangeTreeQuery2D(tree, qx1, qx2, qy1, qy2) {
    qArena = tree[0]
    qRoot = tree[1]
    if (qRoot == -1 or qx1 > qx2 or qy1 > qy2) {
        return []
    }

    rootY = qArena[qRoot][4]
    rootLen = len(rootY)

    // Binary search for lowest index where Y >= qy1 at root
    bsLow = 0
    bsHigh = rootLen
    while (bsLow < bsHigh) {
        bsMid = (bsLow + bsHigh) / 2
        if (rootY[bsMid][1] < qy1) {
            bsLow = bsMid + 1
        } else {
            bsHigh = bsMid
        }
    }
    initYPtr = bsLow

    qResults = []
    qStack = [[qRoot, initYPtr]]

    while (len(qStack) > 0) {
        currFrame = qStack.pop()
        uNodeIdx = currFrame[0]
        yPtr = currFrame[1]

        uMinX = qArena[uNodeIdx][0]
        uMaxX = qArena[uNodeIdx][1]

        if (uMinX > qx2 or uMaxX < qx1) {
            // Disjoint range: prune branch
        } else {
            uYList = qArena[uNodeIdx][4]
            uYLen = len(uYList)

            // Check if canonical subtree is completely contained within [qx1, qx2]
            if (qx1 <= uMinX and uMaxX <= qx2) {
                reportIdx = yPtr
                while (reportIdx < uYLen and uYList[reportIdx][1] <= qy2) {
                    qResults.push(uYList[reportIdx])
                    reportIdx = reportIdx + 1
                }
            } else {
                cLeft = qArena[uNodeIdx][2]
                cRight = qArena[uNodeIdx][3]

                if (cLeft == -1 and cRight == -1) {
                    // Leaf node with single point
                    leafX = uMinX
                    leafY = uYList[0][1]
                    if (qx1 <= leafX and leafX <= qx2 and qy1 <= leafY and leafY <= qy2) {
                        qResults.push(uYList[0])
                    }
                } else {
                    uFcLeft = qArena[uNodeIdx][5]
                    uFcRight = qArena[uNodeIdx][6]

                    nextL = 0
                    if (yPtr < len(uFcLeft)) {
                        nextL = uFcLeft[yPtr]
                    } else {
                        nextL = len(qArena[cLeft][4])
                    }

                    nextR = 0
                    if (yPtr < len(uFcRight)) {
                        nextR = uFcRight[yPtr]
                    } else {
                        nextR = len(qArena[cRight][4])
                    }

                    // Push right child then left child so left child is processed first
                    qStack.push([cRight, nextR])
                    qStack.push([cLeft, nextL])
                }
            }
        }
    }

    return qResults
}

// -----------------------------------------------------------------------------
// Test Case 1: Deterministic 2D Point Cloud Assertions
// -----------------------------------------------------------------------------
print("Running Test Case 1: Deterministic 2D Point Cloud Assertions...")
tc1Pass = 1

// 12 distinct points: [x, y, id]
samplePoints = [
    [2, 18, 1],
    [5, 42, 2],
    [7, 8, 3],
    [11, 65, 4],
    [14, 21, 5],
    [18, 93, 6],
    [22, 14, 7],
    [25, 30, 8],
    [31, 55, 9],
    [37, 72, 10],
    [40, 11, 11],
    [48, 88, 12]
]

rt1 = createRangeTree2D(samplePoints)

// Query 1: Full bounding box covering all points [0, 50] x [0, 100]
resFull = rangeTreeQuery2D(rt1, 0, 50, 0, 100)
if (len(resFull) != 12) {
    tc1Pass = 0
}

// Query 2: Box [10, 30] x [10, 50]
// Expected points:
// - [14, 21, 5] (x=14, y=21)
// - [22, 14, 7] (x=22, y=14)
// - [25, 30, 8] (x=25, y=30)
// Total 3 points
resBox1 = rangeTreeQuery2D(rt1, 10, 30, 10, 50)
if (len(resBox1) != 3) {
    tc1Pass = 0
}

// Query 3: Empty disjoint box [50, 100] x [0, 50]
resEmpty = rangeTreeQuery2D(rt1, 50, 100, 0, 50)
if (len(resEmpty) != 0) {
    tc1Pass = 0
}

// Query 4: Exact single point query [18, 18] x [93, 93] -> point 6
resSingle = rangeTreeQuery2D(rt1, 18, 18, 93, 93)
if (len(resSingle) != 1 or resSingle[0][2] != 6) {
    tc1Pass = 0
}

if (tc1Pass == 1) {
    print("  12-point canonical range tree constructed")
    print("  Full box, sub-cluster, disjoint, and point-exact queries verified")
    print("  Test Case 1 Passed successfully")
} else {
    print("[FAIL] Test Case 1 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 2: Collinear Alignments and Boundary Edge Cases
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 2: Collinear Alignments and Boundary Cases...")
tc2Pass = 1

// Collinear horizontal and vertical points
collinearPoints = [
    [10, 50, 101],
    [20, 50, 102],
    [30, 50, 103],
    [40, 50, 104],
    [50, 10, 105],
    [50, 20, 106],
    [50, 30, 107],
    [50, 40, 108],
    [50, 50, 109] // intersection
]

rt2 = createRangeTree2D(collinearPoints)

// Query horizontal slice [15, 35] x [49, 51]
// Contains [20, 50, 102] and [30, 50, 103] = 2 points
resH = rangeTreeQuery2D(rt2, 15, 35, 49, 51)
if (len(resH) != 2) {
    tc2Pass = 0
}

// Query vertical slice [49, 51] x [15, 35]
// Contains [50, 20, 106] and [50, 30, 107] = 2 points
resV = rangeTreeQuery2D(rt2, 49, 51, 15, 35)
if (len(resV) != 2) {
    tc2Pass = 0
}

// Query intersection boundary [50, 50] x [50, 50]
resInt = rangeTreeQuery2D(rt2, 50, 50, 50, 50)
if (len(resInt) != 1 or resInt[0][2] != 109) {
    tc2Pass = 0
}

// Inverted interval query [40, 20] x [10, 50]
resInv = rangeTreeQuery2D(rt2, 40, 20, 10, 50)
if (len(resInv) != 0) {
    tc2Pass = 0
}

if (tc2Pass == 1) {
    print("  Collinear horizontal and vertical coordinate axes verified")
    print("  Shared intersection boundary point isolated accurately")
    print("  Test Case 2 Passed successfully")
} else {
    print("[FAIL] Test Case 2 assertion failure")
}

// -----------------------------------------------------------------------------
// Test Case 3: Randomized Stress Simulation against Linear Scan Oracle
// -----------------------------------------------------------------------------
print("")
print("Running Test Case 3: Randomized Stress Simulation against Linear Oracle...")
numRandPoints = 40
randPoints = []
rSeed = 77112233
rpI = 0

while (rpI < numRandPoints) {
    rSeed = (rSeed * 1103515245 + 12345) % 2147483648
    randX = (rSeed % 100) + 1
    rSeed = (rSeed * 1103515245 + 12345) % 2147483648
    randY = (rSeed % 100) + 1
    randPoints.push([randX, randY, rpI])
    rpI = rpI + 1
}

rtStress = createRangeTree2D(randPoints)

numQueries = 150
qI = 0
stressMismatches = 0

while (qI < numQueries) {
    rSeed = (rSeed * 1103515245 + 12345) % 2147483648
    xa = (rSeed % 100) + 1
    rSeed = (rSeed * 1103515245 + 12345) % 2147483648
    xb = (rSeed % 100) + 1
    rSeed = (rSeed * 1103515245 + 12345) % 2147483648
    ya = (rSeed % 100) + 1
    rSeed = (rSeed * 1103515245 + 12345) % 2147483648
    yb = (rSeed % 100) + 1

    qxMin = xa
    qxMax = xb
    if (qxMin > qxMax) {
        qxMin = xb
        qxMax = xa
    }

    qyMin = ya
    qyMax = yb
    if (qyMin > qyMax) {
        qyMin = yb
        qyMax = ya
    }

    treeReport = rangeTreeQuery2D(rtStress, qxMin, qxMax, qyMin, qyMax)

    // Linear Oracle scan
    oracleCount = 0
    scI = 0
    while (scI < numRandPoints) {
        px = randPoints[scI][0]
        py = randPoints[scI][1]
        if (qxMin <= px and px <= qxMax and qyMin <= py and py <= qyMax) {
            oracleCount = oracleCount + 1
        }
        scI = scI + 1
    }

    if (len(treeReport) != oracleCount) {
        print("[FAIL] Query", qI, "mismatch: tree=", len(treeReport), "oracle=", oracleCount)
        stressMismatches = stressMismatches + 1
        qI = numQueries // break
    }

    qI = qI + 1
}

if (stressMismatches == 0) {
    print("  Executed", numQueries, "randomized orthogonal range queries: 0 mismatches")
    print("  100% agreement with linear scan oracle")
    print("  Test Case 3 Passed successfully")
} else {
    print("[FAIL] Stress simulation encountered", stressMismatches, "mismatches")
}

elapsed = t.millis() - suiteStartTime
print("[PASS] 2D Range Tree Suite executed successfully in", elapsed, "ms")
