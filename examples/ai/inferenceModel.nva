// inferenceModel.nva - Load and run inference on a saved model
// Demonstrates loading .nmod files and running predictions

import stdlib ai as ai

print("=== Model Inference Demo ===")
print("")

// Load the trained model (path relative to this script)
model = ai.loadModel("demo.nmod")

if (model < 0) {
    print("Error: Could not load model. Train first with trainModel.nva")
} else {
    print("Model loaded with ID:", model)
    
    // Get model info
    info = ai.getModelInfo(model)
    print("")
    print("Model Info:")
    print("  Input size:", info[0])
    print("  Output size:", info[1])
    print("  Epochs trained:", info[2])
    print("  Final loss:", info[3])
    
    // Run inference
    print("")
    print("=== Running Inference ===")
    
    testInputs = [
        [0.0, 0.0, 0.0, 0.0],
        [0.5, 0.5, 0.5, 0.5],
        [1.0, 1.0, 1.0, 1.0],
        [0.0, 1.0, 1.0, 0.0]
    ]
    
    for (i in Range(0, 4)) {
        output = ai.predict(model, testInputs[i])
        predicted = ai.Argmax(output)
        confidence = ai.Max(output)
        
        print("Input:", testInputs[i])
        print("  Output probabilities:", output)
        print("  Predicted class:", predicted, "with confidence:", confidence)
        print("")
    }
}

print("=== Inference Complete! ===")
