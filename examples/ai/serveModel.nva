// serveModel.nva - Serve a trained model as HTTP API
// Demonstrates model loading with HTTP serving

import stdlib ai as ai
import stdlib http as http

print("=== Model API Server ===")
print("")

// Load the trained model
model = ai.loadModel("models/demo.nmod")

if (model < 0) {
    print("Error: Could not load model.")
    print("Train first: nevaarize examples/ai/trainModel.nva")
} else {
    info = ai.getModelInfo(model)
    print("Model loaded successfully")
    print("  Input size:", info[0])
    print("  Output size:", info[1])
    print("")
    
    // Define prediction handler
    func handlePredict(req) {
        input = req["body"]["input"]
        
        if (input == nil) {
            return {
                "error": "Missing 'input' field in request body"
            }
        }
        
        output = ai.predict(model, input)
        predicted = ai.Argmax(output)
        
        return {
            "prediction": predicted,
            "probabilities": output
        }
    }
    
    // Define health check handler
    func handleHealth(req) {
        return {
            "status": "ok",
            "model": "loaded",
            "inputSize": info[0],
            "outputSize": info[1]
        }
    }
    
    // Register routes
    http.route("POST", "/predict", handlePredict)
    http.route("GET", "/health", handleHealth)
    
    print("Starting server on http://localhost:8080")
    print("")
    print("Endpoints:")
    print("  GET  /health  - Health check")
    print("  POST /predict - Run inference")
    print("")
    print("Example:")
    print("  curl -X POST http://localhost:8080/predict \\")
    print("       -H 'Content-Type: application/json' \\")
    print("       -d '{\"input\": [0.5, 0.5, 0.5, 0.5]}'")
    print("")
    
    // Start server
    http.serve(8080)
}
