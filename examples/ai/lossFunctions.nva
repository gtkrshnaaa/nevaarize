// loss_functions.nva - Loss function demonstrations
// Demonstrates all loss functions in stdlib ai

import stdlib ai as ai

print("=== Loss Functions Demo ===")
print("")

// Regression losses
print("--- Regression Losses ---")

pred = [2.5, 0.0, 2.0, 8.0]
target = [3.0, -0.5, 2.0, 7.0]

print("Predictions:", pred)
print("Targets:", target)

mse = ai.MSELoss(pred, target)
print("MSE Loss:", mse)

l1 = ai.L1Loss(pred, target)
print("L1 Loss:", l1)

huber = ai.HuberLoss(pred, target, 1.0)
print("Huber Loss (delta=1):", huber)

print("")

// Binary classification loss
print("--- Binary Classification ---")

predBin = [0.9, 0.2, 0.8, 0.1]
targetBin = [1.0, 0.0, 1.0, 0.0]

print("Predictions:", predBin)
print("Targets:", targetBin)

bce = ai.BCELoss(predBin, targetBin)
print("BCE Loss:", bce)

print("")

// Multi-class classification
print("--- Multi-class Classification ---")

logits = [2.0, 1.0, 0.1]
trueClass = 0

print("Logits:", logits)
print("True class index:", trueClass)

ce = ai.CrossEntropyLoss(logits, trueClass)
print("CrossEntropy Loss:", ce)

print("")
print("=== Loss functions complete! ===")
