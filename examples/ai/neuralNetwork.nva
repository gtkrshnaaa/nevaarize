// neural_network.nva - Simple neural network forward pass
// Demonstrates building a basic neural network with stdlib ai

import stdlib ai as ai

print("=== Simple Neural Network ===")
print("")

// Network architecture: 4 inputs -> 3 hidden -> 2 outputs

// Initialize weights with He initialization (for ReLU)
w1 = ai.HeInit(4, 3)  // 4x3 = 12 weights
b1 = ai.Zeros(3)

w2 = ai.HeInit(3, 2)  // 3x2 = 6 weights
b2 = ai.Zeros(2)

print("Network initialized:")
print("  Layer 1: 4 -> 3 neurons")
print("  Layer 2: 3 -> 2 neurons")
print("")

// Input data (batch of 1)
input = [1.0, 0.5, -0.5, 0.2]
print("Input:", input)

// Forward pass
// Hidden layer
hidden = ai.Linear(input, w1, b1, 3)
print("Hidden (before activation):", hidden)

hidden = ai.ReLU(hidden)
print("Hidden (after ReLU):", hidden)

// Output layer
output = ai.Linear(hidden, w2, b2, 2)
print("Output (logits):", output)

// Apply softmax for classification
probs = ai.Softmax(output)
print("Output (probabilities):", probs)

// Get prediction
pred = ai.Argmax(probs)
print("Predicted class:", pred)

print("")
print("=== Neural network forward pass complete! ===")
