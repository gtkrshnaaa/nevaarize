level = simd.level()
name = simd.detect()
print("SIMD Level: " + level + " (" + name + ")")

if (level < 0) {
    print("SIMD level invalid")
}

a = [1, 2, 3, 4]
b = [5, 6, 7, 8]

c = simd.add(a, b)
if (c[0] != 6 or c[1] != 8 or c[2] != 10 or c[3] != 12) {
    print("simd.add failed")
}

d = a.add(b)
if (d[0] != 6 or d[1] != 8 or d[2] != 10 or d[3] != 12) {
    print("arr.add failed")
}

sub = simd.sub(b, a)
if (sub[0] != 4 or sub[1] != 4 or sub[2] != 4 or sub[3] != 4) {
    print("simd.sub failed")
}

mul = a.mul(b)
if (mul[0] != 5 or mul[1] != 12 or mul[2] != 21 or mul[3] != 32) {
    print("arr.mul failed")
}

scaled = a.scale(3)
if (scaled[0] != 3 or scaled[1] != 6 or scaled[2] != 9 or scaled[3] != 12) {
    print("arr.scale failed")
}

s = a.sum()
if (s != 10) {
    print("arr.sum failed")
}

dot = a.dot(b)
// 1*5 + 2*6 + 3*7 + 4*8 = 5 + 12 + 21 + 32 = 70
if (dot != 70) {
    print("arr.dot failed")
}

sLoop = simd.sumLoop(10)
if (sLoop != 55) {
    print("simd.sumLoop failed")
}

print("SIMD Test: PASSED")
