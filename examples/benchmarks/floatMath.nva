// Benchmark: Float Math
// Tests JIT performance for floating point operations

import stdlib time as t
import stdlib math as m

iterations = 1000000

print("=== Float Math Benchmark ===")
print("Iterations:", iterations)

start = t.clock()

result = 0.0
for (i in Range(0, iterations)) {
    x = float(i) * 0.5
    result = result + m.Sqrt(x + 1.0)
}

end = t.clock()
elapsed = end - start

print("Result:", result)
print("Time:", elapsed, "seconds")
print("Operations per second:", int(iterations / elapsed))
