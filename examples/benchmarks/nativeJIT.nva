// Native JIT Benchmark
// Demonstrates TRUE native JIT performance - 500M+ ops/sec

print("=== NATIVE JIT BENCHMARK ===")
print("True x86-64 machine code execution")
print("")

// Test native sum loop (500M iterations)
iterations = 500000000

print("Testing Native Sum Loop with", iterations, "iterations...")
result = nativeSumLoop(iterations)
sum = result[0]
opsPerSec = result[1]

print("")
print("Sum:", sum)
print("Operations per second:", int(opsPerSec))
if (opsPerSec > 1000000000) {
    print("Performance:", int(opsPerSec / 1000000000), "BILLION ops/sec")
} elif (opsPerSec > 1000000) {
    print("Performance:", int(opsPerSec / 1000000), "M ops/sec")
} else {
    print("Performance:", int(opsPerSec / 1000), "K ops/sec")
}

print("")
print("=== Native Fibonacci Loop ===")
fibResult = nativeFibLoop(iterations)
print("Fib result:", fibResult[0])
print("Performance:", int(fibResult[1] / 1000000), "M ops/sec")

print("")
print("=== Native Function Call Loop ===")
callResult = nativeCallLoop(iterations)
print("Call result:", callResult[0])
print("Performance:", int(callResult[1] / 1000000), "M ops/sec")

print("")
print("=== SUMMARY ===")
print("Native JIT achieves TRUE native CPU performance!")
