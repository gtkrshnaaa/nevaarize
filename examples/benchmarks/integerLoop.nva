// Benchmark: Integer Loop
// Tests JIT performance for integer arithmetic

import stdlib time as t

iterations = 10000000

print("=== Integer Loop Benchmark ===")
print("Iterations:", iterations)

start = t.clock()

sum = 0
for (i in Range(0, iterations)) {
    sum = sum + i
}

end = t.clock()
elapsed = end - start

print("Sum:", sum)
print("Time:", elapsed, "seconds")
print("Operations per second:", int(iterations / elapsed))
