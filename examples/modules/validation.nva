// Validation Module Example
// Common validation functions for real projects

// Check if string is empty
func isEmpty(value) {
    return len(str(value)) == 0
}

// Check if number is in range
func isInRange(value, minVal, maxVal) {
    return value >= minVal and value <= maxVal
}

// Check if string has minimum length
func hasMinLength(value, minLen) {
    return len(str(value)) >= minLen
}

// Check if string has maximum length
func hasMaxLength(value, maxLen) {
    return len(str(value)) <= maxLen
}

// Check if value is positive
func isPositive(value) {
    return value > 0
}

// Check if value is non-negative
func isNonNegative(value) {
    return value >= 0
}

// Validate username length (3-20 chars)
func isValidUsername(username) {
    length = len(username)
    return length >= 3 and length <= 20
}

// Validate password strength (min 8 chars)
func isStrongPassword(password) {
    return len(password) >= 8
}

// Simple email check (contains @)
func looksLikeEmail(email) {
    return len(email) > 5
}
