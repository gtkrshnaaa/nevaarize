function sum(arr, length) {
    total = 0
    i = 0
    while (i < length) {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

function average(arr, length) {
    if (length == 0) {
        return 0
    }
    return sum(arr, length) / length
}

function findMax(arr, length) {
    if (length == 0) {
        return 0
    }
    
    maximum = arr[0]
    i = 1
    while (i < length) {
        if (arr[i] > maximum) {
            maximum = arr[i]
        }
        i = i + 1
    }
    return maximum
}

function findMin(arr, length) {
    if (length == 0) {
        return 0
    }
    
    minimum = arr[0]
    i = 1
    while (i < length) {
        if (arr[i] < minimum) {
            minimum = arr[i]
        }
        i = i + 1
    }
    return minimum
}

function reverse(arr, length) {
    i = 0
    while (i < length / 2) {
        temp = arr[i]
        arr[i] = arr[length - 1 - i]
        arr[length - 1 - i] = temp
        i = i + 1
    }
    return arr
}
