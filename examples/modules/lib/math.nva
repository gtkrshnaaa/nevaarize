// Module: Math Operations
// Basic mathematical utilities

func square(x) {
    return x * x
}

func cube(x) {
    return x * x * x
}

func power(base, exp) {
    if (exp == 0) {
        return 1
    }
    result = 1
    i = 0
    while (i < exp) {
        result = result * base
        i = i + 1
    }
    return result
}
