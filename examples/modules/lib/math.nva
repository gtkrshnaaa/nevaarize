function square(x) {
    return x * x
}

function cube(x) {
    return x * x * x
}

function abs(x) {
    if (x < 0) {
        return -x
    }
    return x
}

function max(a, b) {
    if (a > b) {
        return a
    }
    return b
}

function min(a, b) {
    if (a < b) {
        return a
    }
    return b
}

function clamp(value, minVal, maxVal) {
    if (value < minVal) {
        return minVal
    }
    if (value > maxVal) {
        return maxVal
    }
    return value
}
