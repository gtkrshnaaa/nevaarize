func square(x) {
    return x * x
}

func cube(x) {
    return x * x * x
}

func abs(x) {
    if (x < 0) {
        return -x
    }
    return x
}

func max(a, b) {
    if (a > b) {
        return a
    }
    return b
}

func min(a, b) {
    if (a < b) {
        return a
    }
    return b
}

func clamp(value, minVal, maxVal) {
    if (value < minVal) {
        return minVal
    }
    if (value > maxVal) {
        return maxVal
    }
    return value
}
