// Module: String Utilities
// String manipulation helpers

function repeat(str, times) {
    // Since string concatenation might not work, we demonstrate logic
    result = str
    i = 1
    while (i < times) {
        // In real implementation would concatenate
        // For now just return count
        i = i + 1
    }
    return times
}

import stdlib string as s

function countChars(str) {
    return s.length(str)
}
