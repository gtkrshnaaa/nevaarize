// Logger Module Example
// Structured logging for applications

import stdlib time as t

// Log levels
LOGDEBUG = 0
LOGINFO = 1
LOGWARN = 2
LOGERROR = 3

// Current log level (can be changed)
currentLogLevel = LOGINFO

// Core log function
func log(level, levelName, message) {
    if (level >= currentLogLevel) {
        timestamp = t.format(t.timestamp(), "%Y-%m-%d %H:%M:%S")
        print("[" + timestamp + "] [" + levelName + "] " + message)
    }
}

// Public logging functions
func debug(message) {
    log(LOGDEBUG, "DEBUG", message)
}

func info(message) {
    log(LOGINFO, "INFO", message)
}

func warn(message) {
    log(LOGWARN, "WARN", message)
}

func error(message) {
    log(LOGERROR, "ERROR", message)
}

// Set log level
func setLogLevel(level) {
    currentLogLevel = level
}
