// Config Module Example
// Demonstrates how to create reusable configuration modules

// Database configuration
dbHost = "localhost"
dbPort = 5432
dbName = "nevaarize"

// API configuration
apiUrl = "https://api.example.com"
apiVersion = "v1"
apiTimeout = 30000

// Feature flags
enableCache = true
enableLogging = true
debugMode = false

// Helper function to get full API URL
func getApiEndpoint(path) {
    return apiUrl + "/" + apiVersion + "/" + path
}

// Helper function to get connection string
func getDbConnection() {
    return "host=" + dbHost + " port=" + str(dbPort) + " dbname=" + dbName
}

// Print configuration
func printConfig() {
    print("=== Application Configuration ===")
    print("Database:", dbHost + ":" + str(dbPort) + "/" + dbName)
    print("API:", apiUrl + "/" + apiVersion)
    print("Cache:", enableCache)
    print("Debug:", debugMode)
}
