import "config/settings.nva" as config
import "lib/math.nva" as math
import "lib/arrays.nva" as arrays
import "lib/utils/logger.nva" as log


print("╔════════════════════════════════════════╗")
print("║  Modular Application Demonstration    ║")
print("╚════════════════════════════════════════╝")
print("")

log.info("Initializing application")
print("Application:", config.appName)
print("Version:", config.version)
print("Max Iterations:", config.maxIterations)
print("")


print("SECTION 1: Mathematical Operations")
print("===================================")

numbers = [3, 7, 2, 9, 4, 1, 8, 5]
n = 8

log.info("Processing dataset")
print("Dataset:", numbers)
print("")

print("Basic Statistics:")
print("  Sum:", arrays.sum(numbers, n))
print("  Average:", arrays.average(numbers, n))
print("  Maximum:", arrays.findMax(numbers, n))
print("  Minimum:", arrays.findMin(numbers, n))
print("")


print("SECTION 2: Mathematical Transformations")
print("========================================")

base = 5
squared = math.square(base)
cubed = math.cube(base)

print("Base value:", base)
print("  Squared:", squared)
print("  Cubed:", cubed)
print("")

testValue = -15
absValue = math.abs(testValue)
print("Absolute value of", testValue, ":", absValue)
print("")

a = 42
b = 17
print("Comparison of", a, "and", b)
print("  Maximum:", math.max(a, b))
print("  Minimum:", math.min(a, b))
print("")


print("SECTION 3: Data Processing Pipeline")
print("====================================")

rawData = [100, 25, 75, 50, 90, 10, 85, 60]
dataSize = 8

log.info("Running data pipeline")

step1 = arrays.sum(rawData, dataSize)
log.debug("Step 1 (sum)", step1)

step2 = arrays.average(rawData, dataSize)
log.debug("Step 2 (average)", step2)

step3 = math.square(step2)
log.debug("Step 3 (squared avg)", step3)

normalizedValue = math.clamp(step3, 0, 10000)
log.debug("Step 4 (clamped)", normalizedValue)

log.success("Pipeline completed successfully")
print("Pipeline result:", normalizedValue)
print("")


print("SECTION 4: Array Manipulation")
print("==============================")

original = [10, 20, 30, 40, 50]
size = 5

print("Original array:", original)

reversed = arrays.reverse(original, size)
print("Reversed array:", reversed)
print("")


print("SECTION 5: Configuration-Driven Loop")
print("=====================================")

iterations = 0
threshold = 100
current = 0

log.info("Starting iterative computation")

while (iterations < config.maxIterations and current < threshold) {
    current = current + math.square(iterations % 10)
    iterations = iterations + 1
}

print("Iterations performed:", iterations)
print("Final value:", current)
print("")

if (iterations >= config.maxIterations) {
    log.warn("Reached maximum iterations limit")
} else {
    log.success("Computation converged")
}
print("")


print("SECTION 6: Complex Calculation")
print("===============================")

dataset = [12, 45, 23, 67, 34, 89, 56, 78]
numPoints = 8

log.info("Performing statistical analysis")

mean = arrays.average(dataset, numPoints)
maximum = arrays.findMax(dataset, numPoints)
minimum = arrays.findMin(dataset, numPoints)
range = maximum - minimum

variance = 0
i = 0
while (i < numPoints) {
    diff = dataset[i] - mean
    variance = variance + math.square(diff)
    i = i + 1
}
variance = variance / numPoints

print("Statistical Analysis:")
print("  Mean:", mean)
print("  Range:", range)
print("  Variance:", variance)
print("")

log.success("Analysis complete")


print("╔════════════════════════════════════════╗")
print("║     Application Complete               ║")
print("╚════════════════════════════════════════╝")
