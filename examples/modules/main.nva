// Main Program
// Demonstrates module import system

import "utils.nva" as utils

print("=== Module System Demo ===")

// Use imported functions
x = 5
print("Square of", x, "=", utils.square(x))
print("Cube of", x, "=", utils.cube(x))

// Use greet function
message = utils.greet("Nevaarize")
print(message)

// Use sum function
numbers = [1, 2, 3, 4, 5]
total = utils.sum(numbers)
print("Sum of", numbers, "=", total)

// Combine with stdlib
import stdlib math as m

result = m.Sqrt(utils.square(10))
print("sqrt(square(10)) =", result)
