func square(x) {
    return x * x
}

func cube(x) {
    return x * x * x
}

func abs(x) {
    if (x < 0) {
        return -x
    }
    return x
}

func max(a, b) {
    if (a > b) {
        return a
    }
    return b
}

func min(a, b) {
    if (a < b) {
        return a
    }
    return b
}


func arraySum(arr, length) {
    total = 0
    i = 0
    while (i < length) {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

func arrayAverage(arr, length) {
    if (length == 0) {
        return 0
    }
    return arraySum(arr, length) / length
}


print("=== Modular Programming Demo ===")
print("")

print("Math Functions:")
print("square(7):", square(7))
print("cube(4):", cube(4))
print("abs(-15):", abs(-15))
print("max(42, 17):", max(42, 17))
print("min(42, 17):", min(42, 17))
print("")

print("Array Functions:")
data = [10, 20, 30, 40, 50]
length = 5

print("Data:", data)
print("Sum:", arraySum(data, length))
print("Average:", arrayAverage(data, length))
print("")

print("=== Demo Complete ===")
