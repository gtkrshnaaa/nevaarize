// Nested Importer Module
// Imports from nested directory

import "helper.nva" as helper

func processData(data) {
    print("Processing data:", data)
    
    result = helper.add(data[0], data[1])
    print("Add result:", result)
    
    result = helper.multiply(data[0], data[1])
    print("Multiply result:", result)
    
    avg = helper.average(data)
    print("Average:", avg)
    
    return avg
}
