// Nested Helper Module
// Demonstrates nested module structure

func add(a, b) {
    return a + b
}

func multiply(a, b) {
    return a * b
}

func average(arr) {
    if (arr.length == 0) {
        return 0
    }
    
    sum = 0
    for (val in arr) {
        sum = sum + val
    }
    
    return sum / arr.length
}
